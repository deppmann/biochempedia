# Cloudflare Pages response headers.
#
# Deliberately NOT setting Content-Security-Policy here. The site pulls from
# several third parties at runtime — RCSB PDB and PubChem (structure data and
# 2D depictions), Google Fonts, YouTube, Spotify, and PhET — and a CSP that is
# wrong in a way nobody notices until a student opens a molecule is worse than
# no CSP at all. Add one in Report-Only first, watch the reports for a week,
# then enforce.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()

# Astro fingerprints everything under /_astro, so it can be cached forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Slides, narration, and the vendored Mol* bundle are content-addressed by path
# rather than by hash. A day of caching with a week of stale-while-revalidate
# keeps them fast without stranding a corrected figure for a year.
/slides/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/vendor/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/scientists/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# HTML stays short so a correction reaches students the same day it ships.
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/
  Cache-Control: public, max-age=0, must-revalidate
