---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { discreteItems, CATEGORY, SETS, BEYOND_COURSES, BEYOND_LABEL, beyondTopic } from '../../lib/mcat';
import { courseOf } from '../../data/courses';

// Which lessons hold MCAT-style questions on each topic; the questions themselves are
// fetched from each lesson's /quiz/<slug>.json when a practice round starts.
const items = await discreteItems();
const index: Record<string, string[]> = {};
for (const d of items) (index[d.topic] ??= []).includes(d.slug) || index[d.topic].push(d.slug);
// The graduate courses sit under their own "beyond:<course>" topics (src/lib/mcat.ts). They are
// offered only when the reader turns on "Beyond the exam"; the choice is kept in this browser.
const beyondTopics = BEYOND_COURSES.map(beyondTopic).filter((t) => index[t]);
const topics = Object.keys(index).filter((t) => !beyondTopics.includes(t)).sort();
const names = Object.fromEntries([
  ...topics.map((t) => [t, CATEGORY[t] ?? t]),
  ...BEYOND_COURSES.map((c) => [beyondTopic(c), courseOf(c).title]),
]);
const beyondCount = items.filter((d) => d.beyond).length;
// A round is ten questions, but some topics hold fewer. Count them here, at build time, so the
// list can say "Short set: N questions" and point to the lessons that teach the topic.
const ROUND = 10;
const counts: Record<string, number> = {};
for (const d of items) counts[d.topic] = (counts[d.topic] ?? 0) + 1;
const isShort = (t: string) => counts[t] < ROUND;
const shortTag = (t: string) => `Short set: ${counts[t]} ${counts[t] === 1 ? 'question' : 'questions'}`;
const topicLessons = (t: string) => index[t]
  .map((slug) => ({ slug, title: items.find((d) => d.slug === slug)!.lessonTitle }))
  .sort((a, b) => a.title.localeCompare(b.title));
const shortTopics = topics.filter(isShort);
const beyondNames = BEYOND_COURSES.map((c) => courseOf(c).title).join(' and ');
// ?lesson=<slug> (linked from the end of each lesson): that lesson's own questions, and the
// passage sets with questions on it. Built here at deploy time; no model, nothing to run.
const lessons: Record<string, { title: string; topic: string; n: number; sets: { id: string; title: string; n: number }[] }> = {};
for (const d of items) { const l = (lessons[d.slug] ??= { title: d.lessonTitle, topic: d.topic, n: 0, sets: [] }); l.n++; }
for (const st of SETS) {
  const by: Record<string, number> = {};
  for (const q of st.questions) by[q.lesson.slug] = (by[q.lesson.slug] ?? 0) + 1;
  for (const [slug, n] of Object.entries(by)) {
    const l = (lessons[slug] ??= { title: slug, topic: '', n: 0, sets: [] });
    l.sets.push({ id: st.id, title: st.title, n });
  }
}
---

<BaseLayout title="MCAT topic practice — STEMhop" description="Ten original MCAT-style questions at a time from one topic, each linked to the lesson that teaches it.">
  <article class="wrap tc mpr" data-mpr data-index={JSON.stringify(index)} data-names={JSON.stringify(names)} data-beyond={JSON.stringify(beyondTopics)} data-beyond-label={BEYOND_LABEL} data-lessons={JSON.stringify(lessons)} data-counts={JSON.stringify(counts)}>
    <p class="tc-eyebrow"><a href="/mcat/">MCAT practice</a> · Topic practice</p>
    <h1>Topic practice</h1>
    <p class="tc-lede">Pick a topic for ten questions. A topic with fewer than ten is marked as a short set. These are the stand-alone kind; for passages with data, use the <a href="/mcat/">passage sets</a>.</p>
    <p class="mpr-stats-link"><a href="/mcat/stats/">View your practice stats →</a></p>
    <p class="tc-row" style="margin-top: var(--ddp-space-4)">
      <label>Topic <select data-topic>{topics.map((t) => <option value={t}>{t} · {names[t]}{isShort(t) ? ` (${shortTag(t)})` : ''}</option>)}</select></label>
      <button type="button" class="tc-btn" data-start>Start ten questions</button>
    </p>
    <p class="mpr-beyond" id="mpr-beyond-id">
      <label><input type="checkbox" data-beyond-toggle /> <span><strong>{BEYOND_LABEL}</strong> (off by default)</span></label>
      <span class="tc-muted">
        Adds {beyondCount} questions from the graduate courses {beyondNames}. They go past what the MCAT asks, so they are
        not counted as MCAT practice. Turn this on to see them as their own topics.
      </span>
    </p>
    {shortTopics.length > 0 && (
      <section class="mpr-short" aria-labelledby="mpr-short-h">
        <h2 id="mpr-short-h">Short sets</h2>
        <p class="tc-muted">These topics have fewer than ten questions so far. When you finish one, these lessons teach the topic.</p>
        <ul>
          {shortTopics.map((t) => (
            <li>
              <a href={`/mcat/practice/?topic=${t}`}><strong>{t} · {names[t]}</strong></a>
              <span class="tc-pill">{shortTag(t)}</span>
              <span class="mpr-short-lessons">Lessons: {topicLessons(t).map((l, i) => <>{i > 0 && ' · '}<a href={`/lessons/${l.slug}/`}>{l.title}</a></>)}</span>
            </li>
          ))}
        </ul>
      </section>
    )}
    <div class="mpr-lesson" data-lesson-box hidden></div>
    <p class="tc-muted" data-status role="status"></p>
    <div data-round></div>
  </article>

  <script>
    import { recordFirstTry } from '../../lib/progress';
    import { recordMcatAnswer } from '../../lib/mcat-stats';

    interface Item { id: string; mcat: boolean; stem: string; choices: string[]; answer: number; rationale: string; anchor: { id: string; text: string } | null }
    const root = document.querySelector<HTMLElement>('[data-mpr]')!;
    const index: Record<string, string[]> = JSON.parse(root.dataset.index!);
    const sel = root.querySelector<HTMLSelectElement>('[data-topic]')!;
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const round = root.querySelector<HTMLElement>('[data-round]')!;
    const params = new URLSearchParams(location.search);
    const want = params.get('topic');

    // "Beyond the exam": graduate-course questions, as extra topics at the end of the list. Off by
    // default. The choice is remembered in this browser; if storage is blocked it lasts for the page.
    const BEYOND_KEY = 'bcp:mcat-beyond';
    const beyond: string[] = JSON.parse(root.dataset.beyond || '[]');
    const names: Record<string, string> = JSON.parse(root.dataset.names || '{}');
    const counts: Record<string, number> = JSON.parse(root.dataset.counts || '{}');
    const ROUND = 10;
    const shortNote = (t: string) => (counts[t] < ROUND ? ` (Short set: ${counts[t]} ${counts[t] === 1 ? 'question' : 'questions'})` : '');
    const startBtn = root.querySelector<HTMLButtonElement>('[data-start]')!;
    // The button says how many questions the chosen topic will give.
    const labelStart = () => { const n = counts[sel.value] ?? ROUND; startBtn.textContent = n < ROUND ? `Start ${n} ${n === 1 ? 'question' : 'questions'}` : 'Start ten questions'; };
    const toggle = root.querySelector<HTMLInputElement>('[data-beyond-toggle]')!;
    const readBeyond = () => { try { return localStorage.getItem(BEYOND_KEY) === '1'; } catch { return false; } };
    const writeBeyond = (on: boolean) => { try { if (on) localStorage.setItem(BEYOND_KEY, '1'); else localStorage.removeItem(BEYOND_KEY); } catch { /* storage blocked: the choice lasts for this page */ } };
    function showBeyond(on: boolean) {
      let group = sel.querySelector('optgroup');
      if (on && !group && beyond.length) {
        group = document.createElement('optgroup');
        group.label = root.dataset.beyondLabel || 'Beyond the exam';
        for (const t of beyond) { const o = document.createElement('option'); o.value = t; o.textContent = (names[t] ?? t) + shortNote(t); group.append(o); }
        sel.append(group);
      } else if (!on && group) {
        if (beyond.includes(sel.value)) sel.selectedIndex = 0;
        group.remove();
      }
    }
    toggle.checked = readBeyond();
    showBeyond(toggle.checked);
    toggle.addEventListener('change', () => { writeBeyond(toggle.checked); showBeyond(toggle.checked); labelStart(); });
    sel.addEventListener('change', labelStart);
    const offered = (t: string | null): t is string => !!t && !!index[t] && (!beyond.includes(t) || toggle.checked);
    if (offered(want)) sel.value = want;
    labelStart();
    type LessonInfo = { title: string; topic: string; n: number; sets: { id: string; title: string; n: number }[] };
    const lessonsIdx: Record<string, LessonInfo> = JSON.parse(root.dataset.lessons || '{}');
    const wantLesson = params.get('lesson');
    const only = wantLesson && lessonsIdx[wantLesson] ? wantLesson : null;
    const shuffle = <T,>(a: T[]) => { for (let i = a.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [a[i], a[j]] = [a[j], a[i]]; } return a; };
    const el = <K extends keyof HTMLElementTagNameMap>(tag: K, cls = '', text = '') => { const e = document.createElement(tag); if (cls) e.className = cls; if (text) e.textContent = text; return e; };

    async function start() {
      round.textContent = '';
      status.textContent = 'Loading…';
      // A short set uses every lesson in the topic, so the round has all of its questions.
      const slugs = lessonMode ? [only!] : shuffle([...index[sel.value]]).slice(0, (counts[sel.value] ?? ROUND) < ROUND ? undefined : 8);
      const files = await Promise.all(slugs.map((s) => fetch(`/quiz/${s}.json`).then((r) => r.json()).catch(() => null)));
      const pool = files.flatMap((f) => (f ? f.items.filter((i: Item) => i.mcat).map((i: Item) => ({ ...i, slug: f.slug, title: f.title })) : []));
      const picked = shuffle(pool).slice(0, 10);
      status.textContent = ``

      //Remove "Beyond exam" toggler if not selected when answering questions
      const beyondGroup = document.getElementById("mpr-beyond-id");
      if (beyondGroup && !toggle.checked) {
        beyondGroup.remove();
      }

      if (!picked.length) {
        status.textContent = 'No questions could be loaded. Please try again.';
        return;
      }
      const picks: (number | null)[] = picked.map(() => null);
      const crossedOut = picked.map(() => new Set<number>());
      let current = 0;
      let finished = false;
      const progress = el('p', 'tc-muted');
      progress.setAttribute('aria-live', 'polite');
      const modeLabel = el('label', 'mpr-crossout-toggle');
      const crossout = el('input');
      crossout.type = 'checkbox';
      modeLabel.append(crossout, 'Cross out choices mode');
      const question = el('div');
      const nav = el('nav', 'mpr-question-nav');
      nav.setAttribute('aria-label', 'Practice questions');
      const back = el('button', 'tc-btn', 'Back');
      const next = el('button', 'tc-btn', 'Next');
      const finish = el('button', 'tc-btn', 'Submit / see my results');
      const unanswered = el('span', 'tc-muted');
      unanswered.setAttribute('aria-live', 'polite');
      [back, next, finish].forEach((button) => { button.type = 'button'; });
      nav.append(back, unanswered, next, finish);
      round.append(progress, modeLabel, question, nav);

      function render(focusChoice?: number) {
        const q = picked[current];
        const n = current;
        question.replaceChildren();
        progress.textContent = `Question ${n + 1} of ${picked.length}`;
        const missing = picks.filter((p) => p === null).length;
        unanswered.textContent = missing ? `${missing} unanswered` : 'All answered.';
        back.hidden = n === 0;
        next.hidden = n === picked.length - 1;
        finish.hidden = finished || n !== picked.length - 1;
        const box = el('div', 'mq');
        const stem = el('p', 'mq-stem', q.stem);
        stem.tabIndex = -1;
        box.append(stem);
        const ul = el('ul', 'mq-choices');
        q.choices.forEach((c: string, ci: number) => {
          const li = el('li');
          const button = el('button', 'mq-choice');
          button.type = 'button';
          button.disabled = finished;
          button.setAttribute('aria-pressed', String(crossout.checked ? crossedOut[n].has(ci) : picks[n] === ci));
          button.classList.toggle('is-picked', picks[n] === ci);
          button.classList.toggle('is-eliminated', crossedOut[n].has(ci));
          button.classList.toggle('is-correct', finished && ci === q.answer);
          button.classList.toggle('is-wrong', finished && picks[n] === ci && ci !== q.answer);
          button.append(el('span', 'mq-letter', 'ABCD'[ci]), el('span', '', c));
          button.addEventListener('click', () => {
            if (finished) return;
            if (crossout.checked) {
              if (crossedOut[n].has(ci)) crossedOut[n].delete(ci);
              else {
                crossedOut[n].add(ci);
                if (picks[n] === ci) picks[n] = null;
              }
            } else {
              picks[n] = picks[n] === ci ? null : ci;
              crossedOut[n].delete(ci);
            }
            render(ci);
          });
          li.append(button);
          ul.append(li);
        });
        box.append(ul);
        if (finished) {
          const ok = picks[n] === q.answer;
          const fb = el('div', 'mq-feedback');
          fb.append(el('p', `mq-verdict ${ok ? 'is-correct' : 'is-wrong'}`, ok ? '✓ Correct' : `✗ The answer is ${'ABCD'[q.answer]}.`), el('p', '', q.rationale));
          const link = el('a', '', q.anchor ? `Review: ${q.anchor.text} →` : `Review: ${q.title} →`);
          link.href = `/lessons/${q.slug}/${q.anchor ? `#${q.anchor.id}` : ''}`;
          const meta = el('p', 'mq-meta');
          meta.append(link);
          fb.append(meta);
          box.append(fb);
        }
        question.append(box);
        if (focusChoice !== undefined) question.querySelectorAll<HTMLButtonElement>('.mq-choice')[focusChoice]?.focus({ preventScroll: true });
      }
      function navigate(delta: number) {
        current = Math.max(0, Math.min(picked.length - 1, current + delta));
        render();
        question.querySelector<HTMLElement>('.mq-stem')?.focus();
      }
      crossout.addEventListener('change', () => render());
      back.addEventListener('click', () => navigate(-1));
      next.addEventListener('click', () => navigate(1));
      finish.addEventListener('click', () => {
        if (finished) return;
        if (picks.some((p) => p === null) && !confirm('Some questions are unanswered and will count as wrong. See results anyway?')) return;
        finished = true;
        crossout.disabled = true;
        let right = 0;
        picked.forEach((q, i) => {
          const ok = picks[i] === q.answer;
          if (ok) right++;
          recordFirstTry(q.id, q.slug, ok);
          const topic = lessonsIdx[q.slug]?.topic;
          if (topic && !beyond.includes(topic)) recordMcatAnswer(topic, ok);
        });
        status.textContent = `${right} of ${picked.length} right. Misses are in your review queue. Use Back and Next to review the explanations.`;
        render();
        status.scrollIntoView({ behavior: 'smooth' });
      });
      render();
    }
    // Lesson mode: the first round is this lesson's questions; picking a topic and pressing Start
    // goes back to ordinary topic practice.
    let lessonMode = false;
    root.querySelector('[data-start]')!.addEventListener('click', () => { lessonMode = false; start(); });
    if (only) {
      const info = lessonsIdx[only];
      if (offered(info.topic)) { sel.value = info.topic; labelStart(); }
      const box = root.querySelector<HTMLElement>('[data-lesson-box]')!;
      box.hidden = false;
      const h = el('p', 'mpr-lesson-h');
      const a = el('a', '', info.title) as HTMLAnchorElement;
      a.href = `/lessons/${only}/`;
      h.append('Questions on ', a);
      box.append(h);
      if (beyond.includes(info.topic)) box.append(el('p', 'tc-muted', 'This lesson is from a graduate course. Its questions go past what the MCAT asks.'));
      if (info.sets.length) {
        const p = el('p', 'tc-muted', 'Passage sets with questions on this lesson: ');
        info.sets.forEach((st, i) => { if (i) p.append(' · '); const l = el('a', '', `${st.title} (${st.n})`) as HTMLAnchorElement; l.href = `/mcat/${st.id}/`; p.append(l); });
        box.append(p);
      }
      if (info.n > 0) { lessonMode = true; start(); }
      else status.textContent = 'This lesson\'s questions are in the passage sets above.';
    } else if (offered(want)) start();
  </script>

  <style is:global>
    @import '../../styles/teach.css';
    .mpr .mpr-lesson { margin-top: var(--ddp-space-4); padding: var(--ddp-space-3) var(--ddp-space-4); border: 1px solid var(--ddp-color-line); border-radius: var(--ddp-radius-sm, 8px); max-width: 760px; }
    .mpr .mpr-beyond { display: flex; flex-direction: column; gap: var(--ddp-space-1); max-width: 760px; margin-top: var(--ddp-space-4); padding: var(--ddp-space-3) var(--ddp-space-4); border: 1px dashed var(--ddp-color-line); border-radius: var(--ddp-radius-sm, 8px); }
    .mpr .mpr-beyond label { display: inline-flex; align-items: center; gap: 0.6rem; min-height: 44px; cursor: pointer; }
    .mpr .mpr-beyond input { width: 1.15rem; height: 1.15rem; accent-color: var(--ddp-color-accent); }
    .mpr .mpr-short { max-width: 760px; margin-top: var(--ddp-space-6); }
    .mpr .mpr-short h2 { margin-top: 0; }
    .mpr .mpr-short ul { list-style: none; margin: 0; padding: 0; }
    .mpr .mpr-short li { padding: var(--ddp-space-2) 0; border-top: 1px solid var(--ddp-color-line); }
    .mpr .mpr-short li > a { display: inline-flex; align-items: center; min-height: 44px; margin-right: var(--ddp-space-2); }
    .mpr .mpr-short-lessons { display: block; font-size: var(--ddp-text-sm); color: var(--ddp-color-ink-soft); line-height: 2; }
    .mpr .mpr-short a { color: var(--ddp-color-accent); }
    .mpr .mpr-lesson-h { margin: 0; font-weight: 600; }
    .mpr .mpr-stats-link { margin: var(--ddp-space-3) 0 0; font-size: var(--ddp-text-sm); }
    .mpr .mpr-stats-link a { color: var(--ddp-color-accent); font-weight: 600; }
    .mpr .mpr-lesson a { color: var(--ddp-color-accent); }
    .mpr .mpr-crossout-toggle { display: flex; align-items: center; gap: var(--ddp-space-2); min-height: 44px; cursor: pointer; }
    .mpr .mpr-crossout-toggle input { width: 1.15rem; height: 1.15rem; accent-color: var(--ddp-color-primary); }
    .mpr .mpr-question-nav { display: flex; flex-wrap: wrap; align-items: center; gap: var(--ddp-space-3); margin-block: var(--ddp-space-4); }
    .mpr .mpr-question-nav [hidden] { display: none; }
    .mpr .mpr-question-nav span { margin-inline: auto; }
    .mpr .mq-choice.is-picked { border-color: var(--ddp-color-primary); box-shadow: inset 0 0 0 1px var(--ddp-color-primary); }
    .mpr .mq-choice.is-eliminated { text-decoration: line-through; opacity: 0.68; }
    .mpr .mq { margin: var(--ddp-space-6) 0; max-width: 760px; }
    .mpr .mq-stem { line-height: 1.55; margin: 0 0 var(--ddp-space-3); }
    .mpr .mq-choices { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--ddp-space-2); }
    .mpr .mq-choice { width: 100%; display: flex; gap: var(--ddp-space-3); text-align: left; padding: var(--ddp-space-3) var(--ddp-space-4); border: 1px solid var(--ddp-color-line); border-radius: var(--ddp-radius-sm, 8px); background: var(--ddp-color-surface); color: var(--ddp-color-ink); font: inherit; font-size: var(--ddp-text-sm); cursor: pointer; }
    .mpr .mq-choice:hover:not(:disabled) { border-color: var(--ddp-color-accent); }
    .mpr .mq-letter { font-family: var(--ddp-font-mono); font-weight: 700; color: var(--ddp-color-muted); }
    .mpr .mq-choice.is-correct { border-color: var(--ddp-color-verified); background: var(--ddp-color-verified-soft); color: #6b6b6b; }
    .mpr .mq-choice.is-wrong { border-color: #c0392b; background: #fcebe9; color: #6b6b6b; }
    .mpr .mq-feedback { margin-top: var(--ddp-space-3); padding-top: var(--ddp-space-3); border-top: 1px dashed var(--ddp-color-line); font-size: var(--ddp-text-sm); color: var(--ddp-color-ink-soft); }
    .mpr .mq-verdict { font-weight: 700; }
    .mpr .mq-verdict.is-correct { color: var(--ddp-color-verified-ink); }
    .mpr .mq-verdict.is-wrong { color: #c0392b; }
    .mpr .mq-meta a { color: var(--ddp-color-accent); font-weight: 600; }
  </style>
</BaseLayout>
