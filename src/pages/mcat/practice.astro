---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { discreteItems, CATEGORY, SETS, BEYOND_COURSES, BEYOND_LABEL, beyondTopic } from '../../lib/mcat';
import { courseOf } from '../../data/courses';

// Which lessons hold MCAT-style questions on each topic; the questions themselves are
// fetched from each lesson's /quiz/<slug>.json when a practice round starts.
const items = await discreteItems();
const index: Record<string, string[]> = {};
for (const d of items) (index[d.topic] ??= []).includes(d.slug) || index[d.topic].push(d.slug);
// The graduate courses sit under their own "beyond:<course>" topics (src/lib/mcat.ts). They are
// offered only when the reader turns on "Beyond the exam"; the choice is kept in this browser.
const beyondTopics = BEYOND_COURSES.map(beyondTopic).filter((t) => index[t]);
const topics = Object.keys(index).filter((t) => !beyondTopics.includes(t)).sort();
const names = Object.fromEntries([
  ...topics.map((t) => [t, CATEGORY[t] ?? t]),
  ...BEYOND_COURSES.map((c) => [beyondTopic(c), courseOf(c).title]),
]);
const beyondCount = items.filter((d) => d.beyond).length;
const beyondNames = BEYOND_COURSES.map((c) => courseOf(c).title).join(' and ');
// ?lesson=<slug> (linked from the end of each lesson): that lesson's own questions, and the
// passage sets with questions on it. Built here at deploy time; no model, nothing to run.
const lessons: Record<string, { title: string; topic: string; n: number; sets: { id: string; title: string; n: number }[] }> = {};
for (const d of items) { const l = (lessons[d.slug] ??= { title: d.lessonTitle, topic: d.topic, n: 0, sets: [] }); l.n++; }
for (const st of SETS) {
  const by: Record<string, number> = {};
  for (const q of st.questions) by[q.lesson.slug] = (by[q.lesson.slug] ?? 0) + 1;
  for (const [slug, n] of Object.entries(by)) {
    const l = (lessons[slug] ??= { title: slug, topic: '', n: 0, sets: [] });
    l.sets.push({ id: st.id, title: st.title, n });
  }
}
---

<BaseLayout title="MCAT topic practice — Biochemistrypedia" description="Ten original MCAT-style questions at a time from one topic, each linked to the lesson that teaches it.">
  <article class="wrap tc mpr" data-mpr data-index={JSON.stringify(index)} data-names={JSON.stringify(names)} data-beyond={JSON.stringify(beyondTopics)} data-beyond-label={BEYOND_LABEL} data-lessons={JSON.stringify(lessons)}>
    <p class="tc-eyebrow"><a href="/mcat/">MCAT practice</a> · Topic practice</p>
    <h1>Topic practice</h1>
    <p class="tc-lede">Pick a topic for ten questions. These are the stand-alone kind; for passages with data, use the <a href="/mcat/">passage sets</a>.</p>
    <p class="tc-row" style="margin-top: var(--ddp-space-4)">
      <label>Topic <select data-topic>{topics.map((t) => <option value={t}>{t} · {names[t]}</option>)}</select></label>
      <button type="button" class="tc-btn" data-start>Start ten questions</button>
    </p>
    <p class="mpr-beyond" id="mpr-beyond-id">
      <label><input type="checkbox" data-beyond-toggle /> <span><strong>{BEYOND_LABEL}</strong> (off by default)</span></label>
      <span class="tc-muted">
        Adds {beyondCount} questions from the graduate courses {beyondNames}. They go past what the MCAT asks, so they are
        not counted as MCAT practice. Turn this on to see them as their own topics.
      </span>
    </p>
    <div class="mpr-lesson" data-lesson-box hidden></div>
    <p class="tc-muted" data-status role="status"></p>
    <div data-round></div>
  </article>

  <script>
    import { recordFirstTry } from '../../lib/progress';

    interface Item { id: string; mcat: boolean; stem: string; choices: string[]; answer: number; rationale: string; anchor: { id: string; text: string } | null }
    const root = document.querySelector<HTMLElement>('[data-mpr]')!;
    const index: Record<string, string[]> = JSON.parse(root.dataset.index!);
    const sel = root.querySelector<HTMLSelectElement>('[data-topic]')!;
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const round = root.querySelector<HTMLElement>('[data-round]')!;
    const params = new URLSearchParams(location.search);
    const want = params.get('topic');

    // "Beyond the exam": graduate-course questions, as extra topics at the end of the list. Off by
    // default. The choice is remembered in this browser; if storage is blocked it lasts for the page.
    const BEYOND_KEY = 'bcp:mcat-beyond';
    const beyond: string[] = JSON.parse(root.dataset.beyond || '[]');
    const names: Record<string, string> = JSON.parse(root.dataset.names || '{}');
    const toggle = root.querySelector<HTMLInputElement>('[data-beyond-toggle]')!;
    const readBeyond = () => { try { return localStorage.getItem(BEYOND_KEY) === '1'; } catch { return false; } };
    const writeBeyond = (on: boolean) => { try { if (on) localStorage.setItem(BEYOND_KEY, '1'); else localStorage.removeItem(BEYOND_KEY); } catch { /* storage blocked: the choice lasts for this page */ } };
    function showBeyond(on: boolean) {
      let group = sel.querySelector('optgroup');
      if (on && !group && beyond.length) {
        group = document.createElement('optgroup');
        group.label = root.dataset.beyondLabel || 'Beyond the exam';
        for (const t of beyond) { const o = document.createElement('option'); o.value = t; o.textContent = names[t] ?? t; group.append(o); }
        sel.append(group);
      } else if (!on && group) {
        if (beyond.includes(sel.value)) sel.selectedIndex = 0;
        group.remove();
      }
    }
    toggle.checked = readBeyond();
    showBeyond(toggle.checked);
    toggle.addEventListener('change', () => { writeBeyond(toggle.checked); showBeyond(toggle.checked); });
    const offered = (t: string | null): t is string => !!t && !!index[t] && (!beyond.includes(t) || toggle.checked);
    if (offered(want)) sel.value = want;
    type LessonInfo = { title: string; topic: string; n: number; sets: { id: string; title: string; n: number }[] };
    const lessonsIdx: Record<string, LessonInfo> = JSON.parse(root.dataset.lessons || '{}');
    const wantLesson = params.get('lesson');
    const only = wantLesson && lessonsIdx[wantLesson] ? wantLesson : null;
    const shuffle = <T,>(a: T[]) => { for (let i = a.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [a[i], a[j]] = [a[j], a[i]]; } return a; };
    const el = <K extends keyof HTMLElementTagNameMap>(tag: K, cls = '', text = '') => { const e = document.createElement(tag); if (cls) e.className = cls; if (text) e.textContent = text; return e; };

    async function start() {
      round.textContent = '';
      status.textContent = 'Loading…';
      const slugs = lessonMode ? [only!] : shuffle([...index[sel.value]]).slice(0, 8);
      const files = await Promise.all(slugs.map((s) => fetch(`/quiz/${s}.json`).then((r) => r.json()).catch(() => null)));
      const pool = files.flatMap((f) => (f ? f.items.filter((i: Item) => i.mcat).map((i: Item) => ({ ...i, slug: f.slug, title: f.title })) : []));
      const picked = shuffle(pool).slice(0, 10);
      status.textContent = ``

      //Remove "Beyond exam" toggler if not selected when answering questions
      const beyondGroup = document.getElementById("mpr-beyond-id");
      if (beyondGroup && !toggle.checked) {
        beyondGroup.remove();
      }

      let right = 0, done = 0;
      picked.forEach((q, n) => {
        const box = el('div', 'mq');
        box.append(el('p', 'mq-stem', `${n + 1}. ${q.stem}`));
        const ul = el('ul', 'mq-choices');
        const fb = el('div', 'mq-feedback');
        fb.hidden = true;
        q.choices.forEach((c: string, ci: number) => {
          const li = el('li');
          const b = el('button', 'mq-choice');
          b.type = 'button';
          b.append(el('span', 'mq-letter', 'ABCD'[ci]), el('span', '', c));
          b.addEventListener('click', () => {
            if (box.dataset.locked) return;
            box.dataset.locked = '1';
            const ok = ci === q.answer;
            ul.querySelectorAll('button').forEach((x, xi) => { (x as HTMLButtonElement).disabled = true; if (xi === q.answer) x.classList.add('is-correct'); if (xi === ci && !ok) x.classList.add('is-wrong'); });
            recordFirstTry(q.id, q.slug, ok);
            fb.hidden = false;
            fb.append(el('p', `mq-verdict ${ok ? 'is-correct' : 'is-wrong'}`, ok ? '✓ Correct' : `✗ Not quite. The answer is ${'ABCD'[q.answer]}.`), el('p', '', q.rationale));
            const a = el('a', '', q.anchor ? `Review: ${q.anchor.text} →` : `Review: ${q.title} →`) as HTMLAnchorElement;
            a.href = `/lessons/${q.slug}/${q.anchor ? `#${q.anchor.id}` : ''}`;
            fb.append(el('p', 'mq-meta'));
            fb.lastElementChild!.append(a);
            done++; if (ok) right++;
            if (done === picked.length) status.textContent = `${right} of ${picked.length} right. Misses are in your review queue.`;
          });
          li.append(b);
          ul.append(li);
        });
        box.append(ul, fb);
        round.append(box);
      });
    }
    // Lesson mode: the first round is this lesson's questions; picking a topic and pressing Start
    // goes back to ordinary topic practice.
    let lessonMode = false;
    root.querySelector('[data-start]')!.addEventListener('click', () => { lessonMode = false; start(); });
    if (only) {
      const info = lessonsIdx[only];
      if (offered(info.topic)) sel.value = info.topic;
      const box = root.querySelector<HTMLElement>('[data-lesson-box]')!;
      box.hidden = false;
      const h = el('p', 'mpr-lesson-h');
      const a = el('a', '', info.title) as HTMLAnchorElement;
      a.href = `/lessons/${only}/`;
      h.append('Questions on ', a);
      box.append(h);
      if (beyond.includes(info.topic)) box.append(el('p', 'tc-muted', 'This lesson is from a graduate course. Its questions go past what the MCAT asks.'));
      if (info.sets.length) {
        const p = el('p', 'tc-muted', 'Passage sets with questions on this lesson: ');
        info.sets.forEach((st, i) => { if (i) p.append(' · '); const l = el('a', '', `${st.title} (${st.n})`) as HTMLAnchorElement; l.href = `/mcat/${st.id}/`; p.append(l); });
        box.append(p);
      }
      if (info.n > 0) { lessonMode = true; start(); }
      else status.textContent = 'This lesson\'s questions are in the passage sets above.';
    } else if (offered(want)) start();
  </script>

  <style is:global>
    @import '../../styles/teach.css';
    .mpr .mpr-lesson { margin-top: var(--ddp-space-4); padding: var(--ddp-space-3) var(--ddp-space-4); border: 1px solid var(--ddp-color-line); border-radius: var(--ddp-radius-sm, 8px); max-width: 760px; }
    .mpr .mpr-beyond { display: flex; flex-direction: column; gap: var(--ddp-space-1); max-width: 760px; margin-top: var(--ddp-space-4); padding: var(--ddp-space-3) var(--ddp-space-4); border: 1px dashed var(--ddp-color-line); border-radius: var(--ddp-radius-sm, 8px); }
    .mpr .mpr-beyond label { display: inline-flex; align-items: center; gap: 0.6rem; min-height: 44px; cursor: pointer; }
    .mpr .mpr-beyond input { width: 1.15rem; height: 1.15rem; accent-color: var(--ddp-color-accent); }
    .mpr .mpr-lesson-h { margin: 0; font-weight: 600; }
    .mpr .mpr-lesson a { color: var(--ddp-color-accent); }
    .mpr .mq { margin: var(--ddp-space-6) 0; max-width: 760px; }
    .mpr .mq-stem { line-height: 1.55; margin: 0 0 var(--ddp-space-3); }
    .mpr .mq-choices { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--ddp-space-2); }
    .mpr .mq-choice { width: 100%; display: flex; gap: var(--ddp-space-3); text-align: left; padding: var(--ddp-space-3) var(--ddp-space-4); border: 1px solid var(--ddp-color-line); border-radius: var(--ddp-radius-sm, 8px); background: var(--ddp-color-surface); color: var(--ddp-color-ink); font: inherit; font-size: var(--ddp-text-sm); cursor: pointer; }
    .mpr .mq-choice:hover:not(:disabled) { border-color: var(--ddp-color-accent); }
    .mpr .mq-letter { font-family: var(--ddp-font-mono); font-weight: 700; color: var(--ddp-color-muted); }
    .mpr .mq-choice.is-correct { border-color: var(--ddp-color-verified); background: var(--ddp-color-verified-soft); color: #6b6b6b; }
    .mpr .mq-choice.is-wrong { border-color: #c0392b; background: #fcebe9; color: #6b6b6b; }
    .mpr .mq-feedback { margin-top: var(--ddp-space-3); padding-top: var(--ddp-space-3); border-top: 1px dashed var(--ddp-color-line); font-size: var(--ddp-text-sm); color: var(--ddp-color-ink-soft); }
    .mpr .mq-verdict { font-weight: 700; }
    .mpr .mq-verdict.is-correct { color: var(--ddp-color-verified-ink); }
    .mpr .mq-verdict.is-wrong { color: #c0392b; }
    .mpr .mq-meta a { color: var(--ddp-color-accent); font-weight: 600; }
  </style>
</BaseLayout>
