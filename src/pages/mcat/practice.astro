---
import ChoicePicker from '../../components/ChoicePicker.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { discreteItems, CATEGORY, SETS, BEYOND_COURSES, BEYOND_LABEL, beyondTopic } from '../../lib/mcat';
import Hex from '../../components/Hex.astro';
import { hexFor } from '../../data/hex';
import { courseOf } from '../../data/courses';

// Which lessons hold MCAT-style questions on each topic; the questions themselves are
// fetched from each lesson's /quiz/<slug>.json when a practice round starts.
const hex = hexFor('mcat');
const items = await discreteItems();
const index: Record<string, string[]> = {};
for (const d of items) (index[d.topic] ??= []).includes(d.slug) || index[d.topic].push(d.slug);
// The graduate courses sit under their own "beyond:<course>" topics (src/lib/mcat.ts). They are
// offered only when the reader turns on "Beyond the exam"; the choice is kept in this browser.
const beyondTopics = BEYOND_COURSES.map(beyondTopic).filter((t) => index[t]);
const topics = Object.keys(index).filter((t) => !beyondTopics.includes(t)).sort();
const names = Object.fromEntries([
  ...topics.map((t) => [t, CATEGORY[t] ?? t]),
  ...BEYOND_COURSES.map((c) => [beyondTopic(c), courseOf(c).title]),
]);
const beyondCount = items.filter((d) => d.beyond).length;
const beyondNames = BEYOND_COURSES.map((c) => courseOf(c).title).join(' and ');
// ?lesson=<slug> (linked from the end of each lesson): that lesson's own questions, and the
// passage sets with questions on it. Built here at deploy time; no model, nothing to run.
const lessons: Record<string, { title: string; topic: string; n: number; sets: { id: string; title: string; n: number }[] }> = {};
for (const d of items) { const l = (lessons[d.slug] ??= { title: d.lessonTitle, topic: d.topic, n: 0, sets: [] }); l.n++; }
for (const st of SETS) {
  const by: Record<string, number> = {};
  for (const q of st.questions) by[q.lesson.slug] = (by[q.lesson.slug] ?? 0) + 1;
  for (const [slug, n] of Object.entries(by)) {
    const l = (lessons[slug] ??= { title: slug, topic: '', n: 0, sets: [] });
    l.sets.push({ id: st.id, title: st.title, n });
  }
}
---

<BaseLayout title="MCAT topic practice — STEMhop" description="Choose your topic and round length for original MCAT-style questions linked to the lessons that teach them.">
  <article class="wrap tc mpr" data-mpr data-index={JSON.stringify(index)} data-names={JSON.stringify(names)} data-beyond={JSON.stringify(beyondTopics)} data-lessons={JSON.stringify(lessons)}>
    <div class="mpr-setup">
      <header>
        <p class="tc-eyebrow"><a href="/mcat/">MCAT practice</a> / Topics</p>
        <h1>Topic practice</h1>
        <p class="tc-lede">Choose how many stand-alone questions to practice on one topic. After you submit, review each explanation and revisit the lesson behind it.</p>
        <nav class="mpr-links" aria-label="Related practice">
          <a href="/mcat/#passages">Browse passages →</a>
          <a href="/mcat/stats/">Practice stats →</a>
        </nav>
      </header>
      <section class="mpr-picker" aria-label="Round setup">
        <div class="mpr-picker-title"><h2>Choose a topic</h2><Hex pose={hex.pose} prop={hex.prop} size={52} title={hex.label} /></div>
        <ChoicePicker label={`${topics[0]} · ${names[topics[0]]}`} groupLabel="Choose a topic" fullWidth>
          {topics.map((t, i) => <button type="button" data-topic={t} aria-pressed={i === 0}>{t} · {names[t]}</button>)}
          {beyondTopics.length > 0 && <p class="mpr-extra-label" data-extra hidden>{BEYOND_LABEL}</p>}
          {beyondTopics.map(t => <button type="button" data-topic={t} data-extra hidden aria-pressed="false">{names[t]}</button>)}
        </ChoicePicker>
        <label class="mpr-count">Number of questions
          <input type="number" data-count min="1" max="59" step="1" value="10" required aria-describedby="count-help" />
        </label>
        <p class="tc-muted" id="count-help">Choose 1–59. Smaller topics use all available questions.</p>
        <button type="button" class="tc-btn" data-start>Start practice <span aria-hidden="true">→</span></button>
        <div class="mpr-beyond">
          <label><input type="checkbox" data-beyond-toggle aria-describedby="graduate-note" /> {BEYOND_LABEL}</label>
          <p id="graduate-note" class="tc-muted">Include {beyondCount} graduate questions from {beyondNames}. These topics count separately from MCAT practice.</p>
        </div>
      </section>
    </div>
    <button class="tc-btn ghost" type="button" data-change hidden>Choose another topic</button>
    <div class="mpr-lesson" data-lesson-box hidden></div>
    <p class="tc-muted" data-status role="status" tabindex="-1"></p>
    <div data-round></div>
  </article>

  <script>
    import { recordFirstTry } from '../../lib/progress';
    import { recordMcatAnswer } from '../../lib/mcat-stats';

    interface Item { id: string; mcat: boolean; stem: string; choices: string[]; answer: number; rationale: string; anchor: { id: string; text: string } | null }
    const root = document.querySelector<HTMLElement>('[data-mpr]')!;
    const index: Record<string, string[]> = JSON.parse(root.dataset.index!);
    const picker = root.querySelector<HTMLDetailsElement>('.stem-picker')!;
    const summary = picker.querySelector('summary')!;
    const choices = Array.from(picker.querySelectorAll<HTMLButtonElement>('[data-topic]'));
    let selectedTopic = choices[0].dataset.topic!;
    function selectTopic(topic: string) {
      const choice = choices.find(button => button.dataset.topic === topic);
      if (!choice || choice.hidden) return;
      selectedTopic = topic;
      summary.querySelector('[data-choice-label]')!.textContent = choice.textContent;
      choices.forEach(button => button.setAttribute('aria-pressed', String(button === choice)));
    }
    choices.forEach(button => button.addEventListener('click', () => {
      selectTopic(button.dataset.topic!);
      picker.open = false;
      summary.focus();
    }));
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const round = root.querySelector<HTMLElement>('[data-round]')!;
    const params = new URLSearchParams(location.search);
    const want = params.get('topic');

    // "Beyond the exam": graduate-course questions, as extra topics at the end of the list. Off by
    // default. The choice is remembered in this browser; if storage is blocked it lasts for the page.
    const BEYOND_KEY = 'bcp:mcat-beyond';
    const beyond: string[] = JSON.parse(root.dataset.beyond || '[]');
    const names: Record<string, string> = JSON.parse(root.dataset.names || '{}');
    const toggle = root.querySelector<HTMLInputElement>('[data-beyond-toggle]')!;
    const readBeyond = () => { try { return localStorage.getItem(BEYOND_KEY) === '1'; } catch { return false; } };
    const writeBeyond = (on: boolean) => { try { if (on) localStorage.setItem(BEYOND_KEY, '1'); else localStorage.removeItem(BEYOND_KEY); } catch { /* storage blocked: the choice lasts for this page */ } };
    function showBeyond(on: boolean) {
      picker.querySelectorAll<HTMLElement>('[data-extra]').forEach(option => { option.hidden = !on; });
      if (!on && beyond.includes(selectedTopic)) selectTopic(choices[0].dataset.topic!);
    }
    toggle.checked = readBeyond();
    showBeyond(toggle.checked);
    toggle.addEventListener('change', () => { writeBeyond(toggle.checked); showBeyond(toggle.checked); });
    const offered = (t: string | null): t is string => !!t && !!index[t] && (!beyond.includes(t) || toggle.checked);
    if (offered(want)) selectTopic(want);
    type LessonInfo = { title: string; topic: string; n: number; sets: { id: string; title: string; n: number }[] };
    const lessonsIdx: Record<string, LessonInfo> = JSON.parse(root.dataset.lessons || '{}');
    const wantLesson = params.get('lesson');
    const only = wantLesson && lessonsIdx[wantLesson] ? wantLesson : null;
    const shuffle = <T,>(a: T[]) => { for (let i = a.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [a[i], a[j]] = [a[j], a[i]]; } return a; };
    const el = <K extends keyof HTMLElementTagNameMap>(tag: K, cls = '', text = '') => { const e = document.createElement(tag); if (cls) e.className = cls; if (text) e.textContent = text; return e; };

    const countInput = root.querySelector<HTMLInputElement>('[data-count]')!;
    const startButton = root.querySelector<HTMLButtonElement>('[data-start]')!;
    const changeButton = root.querySelector<HTMLButtonElement>('[data-change]')!;
    changeButton.addEventListener('click', () => {
      root.classList.remove('in-round');
      changeButton.hidden = true;
      summary.focus();
    });

    async function start() {
      if (startButton.disabled || !countInput.reportValidity()) return;
      const requested = countInput.valueAsNumber;
      startButton.disabled = true;
      const roundTitle = lessonMode ? lessonsIdx[only!].title : names[selectedTopic];
      round.textContent = '';
      status.textContent = 'Loading…';
      const slugs = lessonMode ? [only!] : shuffle([...index[selectedTopic]]);
      const pool: (Item & { slug: string; title: string })[] = [];
      for (let offset = 0; offset < slugs.length && pool.length < requested; offset += 8) {
        const batch = slugs.slice(offset, offset + 8);
        const files = await Promise.all(batch.map(slug => fetch(`/quiz/${slug}.json`).then(r => r.json()).catch(() => null)));
        for (const file of files) {
          if (!file) continue;
          for (const item of file.items) {
            if (item.mcat) pool.push({ ...item, slug: file.slug, title: file.title });
          }
        }
      }
      const picked = shuffle(pool).slice(0, requested);
      startButton.disabled = false;
      status.textContent = '';
      if (!picked.length) {
        status.textContent = 'No questions could be loaded. Please try again.';
        return;
      }
      root.classList.add('in-round');
      changeButton.hidden = false;
      const picks: (number | null)[] = picked.map(() => null);
      const crossedOut = picked.map(() => new Set<number>());
      let current = 0;
      let finished = false;
      const toolbar = el('div', 'mpr-round-head');
      const heading = el('div');
      const progress = el('p', 'tc-eyebrow');
      heading.append(progress, el('h2', '', roundTitle));
      progress.setAttribute('aria-live', 'polite');
      const modeLabel = el('label', 'mpr-crossout-toggle');
      const crossout = el('input');
      crossout.type = 'checkbox';
      modeLabel.append(crossout, 'Cross out choices');
      const question = el('div');
      const nav = el('nav', 'mpr-question-nav');
      nav.setAttribute('aria-label', 'Practice questions');
      const back = el('button', 'tc-btn ghost', 'Back');
      const next = el('button', 'tc-btn', 'Next');
      const finish = el('button', 'tc-btn', 'See results');
      const unanswered = el('span', 'tc-muted');
      unanswered.setAttribute('aria-live', 'polite');
      [back, next, finish].forEach((button) => { button.type = 'button'; });
      nav.append(back, unanswered, next, finish);
      toolbar.append(heading, modeLabel);
      round.append(toolbar, question, nav);

      function render(focusChoice?: number) {
        const q = picked[current];
        const n = current;
        question.replaceChildren();
        progress.textContent = `Question ${n + 1} of ${picked.length}`;
        const missing = picks.filter((p) => p === null).length;
        unanswered.textContent = missing ? `${missing} unanswered` : 'All answered.';
        back.hidden = n === 0;
        next.hidden = n === picked.length - 1;
        finish.hidden = finished || n !== picked.length - 1;
        const box = el('div', 'mq');
        const stem = el('p', 'mq-stem', q.stem);
        stem.tabIndex = -1;
        box.append(stem);
        const ul = el('ul', 'mq-choices');
        q.choices.forEach((c: string, ci: number) => {
          const li = el('li');
          const button = el('button', 'mq-choice');
          button.type = 'button';
          button.disabled = finished;
          button.setAttribute('aria-pressed', String(crossout.checked ? crossedOut[n].has(ci) : picks[n] === ci));
          button.classList.toggle('is-picked', picks[n] === ci);
          button.classList.toggle('is-eliminated', crossedOut[n].has(ci));
          button.classList.toggle('is-correct', finished && ci === q.answer);
          button.classList.toggle('is-wrong', finished && picks[n] === ci && ci !== q.answer);
          button.append(el('span', 'mq-letter', 'ABCD'[ci]), el('span', '', c));
          button.addEventListener('click', () => {
            if (finished) return;
            if (crossout.checked) {
              if (crossedOut[n].has(ci)) crossedOut[n].delete(ci);
              else {
                crossedOut[n].add(ci);
                if (picks[n] === ci) picks[n] = null;
              }
            } else {
              picks[n] = picks[n] === ci ? null : ci;
              crossedOut[n].delete(ci);
            }
            render(ci);
          });
          li.append(button);
          ul.append(li);
        });
        box.append(ul);
        if (finished) {
          const ok = picks[n] === q.answer;
          const fb = el('div', 'mq-feedback');
          fb.append(el('p', `mq-verdict ${ok ? 'is-correct' : 'is-wrong'}`, ok ? '✓ Correct' : `✗ The answer is ${'ABCD'[q.answer]}.`), el('p', '', q.rationale));
          const link = el('a', '', q.anchor ? `Review: ${q.anchor.text} →` : `Review: ${q.title} →`);
          link.href = `/lessons/${q.slug}/${q.anchor ? `#${q.anchor.id}` : ''}`;
          const meta = el('p', 'mq-meta');
          meta.append(link);
          fb.append(meta);
          box.append(fb);
        }
        question.append(box);
        if (focusChoice !== undefined) question.querySelectorAll<HTMLButtonElement>('.mq-choice')[focusChoice]?.focus({ preventScroll: true });
      }
      function navigate(delta: number) {
        current = Math.max(0, Math.min(picked.length - 1, current + delta));
        render();
        question.querySelector<HTMLElement>('.mq-stem')?.focus();
      }
      crossout.addEventListener('change', () => render());
      back.addEventListener('click', () => navigate(-1));
      next.addEventListener('click', () => navigate(1));
      finish.addEventListener('click', () => {
        if (finished) return;
        if (picks.some((p) => p === null) && !confirm('Some questions are unanswered and will count as wrong. See results anyway?')) return;
        finished = true;
        crossout.disabled = true;
        let right = 0;
        picked.forEach((q, i) => {
          const ok = picks[i] === q.answer;
          if (ok) right++;
          recordFirstTry(q.id, q.slug, ok);
          const topic = lessonsIdx[q.slug]?.topic;
          if (topic && !beyond.includes(topic)) recordMcatAnswer(topic, ok);
        });
        const score = el('strong', 'mpr-score', `${right} of ${picked.length} correct`);
        const review = el('a', '', 'Open review queue →');
        review.href = '/review/';
        status.replaceChildren(score, 'Use Back and Next to review each explanation. ', review);
        render();
        status.focus();
      });
      render();
      question.querySelector<HTMLElement>('.mq-stem')?.focus();
    }
    // Lesson mode: the first round is this lesson's questions; picking a topic and pressing Start
    // goes back to ordinary topic practice.
    let lessonMode = false;
    startButton.addEventListener('click', () => { lessonMode = false; start(); });
    if (only) {
      const info = lessonsIdx[only];
      if (offered(info.topic)) selectTopic(info.topic);
      const box = root.querySelector<HTMLElement>('[data-lesson-box]')!;
      box.hidden = false;
      const h = el('p', 'mpr-lesson-h');
      const a = el('a', '', info.title) as HTMLAnchorElement;
      a.href = `/lessons/${only}/`;
      h.append('Questions on ', a);
      box.append(h);
      if (beyond.includes(info.topic)) box.append(el('p', 'tc-muted', 'This lesson is from a graduate course. Its questions go past what the MCAT asks.'));
      if (info.sets.length) {
        const p = el('p', 'tc-muted', 'Passage sets with questions on this lesson: ');
        info.sets.forEach((st, i) => { if (i) p.append(' · '); const l = el('a', '', `${st.title} (${st.n})`) as HTMLAnchorElement; l.href = `/mcat/${st.id}/`; p.append(l); });
        box.append(p);
      }
      if (info.n > 0) { lessonMode = true; start(); }
      else status.textContent = 'This lesson\'s questions are in the passage sets above.';
    } else if (offered(want)) start();
  </script>

  <style is:global>
    @import '../../styles/teach.css';
    .mpr { max-width: 1040px; padding-block: clamp(1.75rem, 4vw, 3.5rem); }
    .mpr .mpr-setup { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); align-items: center; gap: clamp(1.5rem, 5vw, 4rem); }
    .mpr h1 { font-size: clamp(3rem, 6vw, 5rem); letter-spacing: -.045em; }
    .mpr .tc-lede { max-width: 45ch; }
    .mpr .mpr-links { display: flex; flex-wrap: wrap; gap: 1.25rem; margin-top: 1.25rem; font: .85rem var(--ddp-font-mono); }
    .mpr .mpr-links a { padding-block: .3rem; border-bottom: 1px solid currentColor; }
    .mpr .mpr-picker, .mpr [data-round]:not(:empty) { padding: clamp(1rem, 3vw, 1.75rem); border: 1px solid var(--ddp-color-line); border-top: 3px solid var(--ddp-color-secondary); border-radius: var(--ddp-radius); background: var(--ddp-color-surface); }
    .mpr .mpr-picker-title, .mpr .mpr-round-head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
    .mpr h2 { margin: 0; font-size: clamp(1.45rem, 2.5vw, 2rem); }
    .mpr .mpr-count { display: flex; align-items: center; justify-content: space-between; gap: .75rem; font-weight: 600; }
    .mpr .mpr-count input { width: 5rem; }
    .mpr #count-help { margin: .35rem 0 1rem; }
    .mpr .mpr-extra-label { padding: .65rem .75rem .25rem; font: var(--ddp-text-xs) var(--ddp-font-mono); color: var(--ddp-color-muted); }
    .mpr .tc-btn { border-radius: var(--ddp-radius-sm); }
    .mpr .tc-btn:not(.ghost) { background: var(--ddp-color-secondary); color: var(--color-navy); border-color: transparent; }
    .mpr .tc-btn:not(.ghost):hover { text-decoration: underline; }
    .mpr [data-start] { width: 100%; justify-content: space-between; }
    .mpr .mpr-beyond { margin-top: 1.25rem; border-top: 1px solid var(--ddp-color-line); padding-top: .5rem; }
    .mpr .mpr-beyond label { display: flex; align-items: center; gap: .6rem; min-height: 44px; font-weight: 600; cursor: pointer; }
    .mpr .mpr-beyond input { width: 1.1rem; height: 1.1rem; accent-color: var(--ddp-color-accent); }
    .mpr .mpr-lesson, .mpr [data-status]:not(:empty) { margin-top: 1.25rem; padding: 1rem; border-left: 3px solid var(--ddp-color-accent); background: var(--ddp-color-accent-soft); }
    .mpr .mpr-score { display: block; font: 500 var(--ddp-text-xl) var(--ddp-font-serif); color: var(--ddp-color-primary); }
    .mpr [data-status] a { text-decoration: underline; }
    .mpr .mpr-lesson-h { font-weight: 600; }
    .mpr.in-round { max-width: 850px; }
    .mpr.in-round .mpr-setup { display: block; }
    .mpr.in-round :is(.mpr-picker, .tc-lede, .mpr-links) { display: none; }
    .mpr.in-round h1 { font-size: clamp(2.25rem, 4vw, 3.25rem); }
    .mpr [data-change] { margin-top: 1rem; }
    .mpr [data-round]:not(:empty) { margin-top: 1.5rem; }
    .mpr .mpr-round-head { flex-wrap: wrap; border-bottom: 1px solid var(--ddp-color-line); padding-bottom: 1rem; }
    .mpr .mq-stem { font-size: var(--ddp-text-lg); color: var(--ddp-color-ink); scroll-margin-top: 6rem; }
    .mpr [data-status] { scroll-margin-top: 6rem; }
    @media (max-width: 720px) {
      .mpr .mpr-setup { grid-template-columns: 1fr; }
    }
    .mpr .mpr-crossout-toggle { display: flex; align-items: center; gap: var(--ddp-space-2); min-height: 44px; cursor: pointer; }
    .mpr .mpr-crossout-toggle input { width: 1.15rem; height: 1.15rem; accent-color: var(--ddp-color-primary); }
    .mpr .mpr-question-nav { display: flex; flex-wrap: wrap; align-items: center; gap: var(--ddp-space-3); border-top: 1px solid var(--ddp-color-line); padding-top: 1rem; }
    .mpr .mpr-question-nav [hidden] { display: none; }
    .mpr .mpr-question-nav span { margin-inline: auto; }
    .mpr .mq-choice.is-picked { border-color: var(--ddp-color-primary); box-shadow: inset 0 0 0 1px var(--ddp-color-primary); }
    .mpr .mq-choice.is-eliminated { text-decoration: line-through; opacity: 0.68; }
    .mpr .mq { margin: var(--ddp-space-6) 0; max-width: 760px; }
    .mpr .mq-stem { line-height: 1.55; margin: 0 0 var(--ddp-space-3); }
    .mpr .mq-choices { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--ddp-space-2); }
    .mpr .mq-choice { width: 100%; display: flex; gap: var(--ddp-space-3); text-align: left; padding: var(--ddp-space-3) var(--ddp-space-4); border: 1px solid var(--ddp-color-line); border-radius: var(--ddp-radius-sm, 8px); background: var(--ddp-color-surface); color: var(--ddp-color-ink); font: inherit; font-size: var(--ddp-text-sm); cursor: pointer; }
    .mpr .mq-choice:hover:not(:disabled) { border-color: var(--ddp-color-accent); }
    .mpr .mq-letter { font-family: var(--ddp-font-mono); font-weight: 700; color: var(--ddp-color-muted); }
    .mpr .mq-choice.is-correct { border-color: var(--ddp-color-verified); background: color-mix(in srgb, var(--ddp-color-verified) 12%, var(--ddp-color-surface)); color: var(--ddp-color-ink); }
    .mpr .mq-choice.is-wrong { border-color: #c0392b; background: color-mix(in srgb, #c0392b 12%, var(--ddp-color-surface)); color: var(--ddp-color-ink); }
    .mpr .mq-feedback { margin-top: var(--ddp-space-3); padding-top: var(--ddp-space-3); border-top: 1px dashed var(--ddp-color-line); font-size: var(--ddp-text-sm); color: var(--ddp-color-ink-soft); }
    .mpr .mq-verdict { font-weight: 700; }
    .mpr .mq-verdict.is-correct { color: var(--ddp-color-verified-ink); }
    .mpr .mq-verdict.is-wrong { color: var(--ddp-color-ink); }
    .mpr .mq-meta a { color: var(--ddp-color-accent); font-weight: 600; }
  </style>
</BaseLayout>
