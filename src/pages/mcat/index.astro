---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hex from '../../components/Hex.astro';
import { hexFor } from '../../data/hex';
const hex = hexFor('mcat');
import { SETS, SECTION, CATEGORY, discreteItems, BEYOND_COURSES, BEYOND_LABEL, DIAGNOSTIC_LENGTH } from '../../lib/mcat';
import { courseOf } from '../../data/courses';
import { MCAT_SCOPE_NOTE } from '../../data/paths';

// Every number on this page is counted here. Questions from the graduate courses do not count as
// MCAT practice: they are left out of the totals and the topic list, and reported on their own line.
const everything = await discreteItems();
const discrete = everything.filter((d) => !d.beyond);
const beyondCount = everything.length - discrete.length;
const examCourses = new Set(discrete.map((d) => d.course)).size;
const beyondNames = BEYOND_COURSES.map((c) => courseOf(c).title).join(' and ');
const byTopic = new Map<string, number>();
for (const d of discrete) byTopic.set(d.topic, (byTopic.get(d.topic) ?? 0) + 1);
const topics = [...byTopic.entries()].sort((a, b) => a[0].localeCompare(b[0]));
const sections = ['bb', 'cp'].map((s) => ({ s, sets: SETS.filter((x) => x.section === s) })).filter((x) => x.sets.length);
---

<BaseLayout title="MCAT practice — STEMhop" description="Free, original MCAT-style practice: research passages with data, a diagnostic, and topic practice that sends every miss back to the lesson that teaches it.">
  <article class="wrap mhub" data-mhub>
    <header class="hero">
      <div>
        <p class="eyebrow"><a href="/paths/mcat/">MCAT path</a> / Practice</p>
        <h1>MCAT practice</h1>
        <p class="lede">Build your biology and biochemistry skills with research passages and focused question sets. Each miss points you back to the lesson and comes up again for review.</p>
        <nav class="jump" aria-label="Browse practice">
          <a href="#passages">{SETS.length} passages ↓</a>
          <a href="#topics">{topics.length} topics ↓</a>
        </nav>
      </div>
      <section class="diagnostic">
        <div class="diag-heading"><h2>Diagnostic</h2><Hex pose={hex.pose} prop={hex.prop} size={64} alive title={hex.label} /></div>
        <p>Find out which topics to study first.</p>
        <small>{DIAGNOSTIC_LENGTH} questions · About 30 minutes</small>
        <a class="start" href="/mcat/diagnostic/">Start diagnostic <span aria-hidden="true">→</span></a>
      </section>
    </header>

    <nav class="tools" aria-label="Study tools">
      <a href="/mcat/practice/"><strong>Topic practice</strong><span>{discrete.length} questions across {examCourses} courses</span></a>
      <a href="/mcat/stats/"><strong>Practice stats</strong><span>Accuracy by subject and over time</span></a>
      <a href="/review/"><strong>Review queue</strong><span>Spaced review <b data-due></b></span></a>
    </nav>

    <div class="library">
      <section id="passages">
        <h2>Practice passages</h2>
        <p class="intro">Read a study, interpret its data, then answer the questions.</p>
        {sections.length === 0 && <p>The first passages are on their way.</p>}
        {sections.map(({ s, sets }) => (
          <section class="group">
            <h3>{SECTION[s]}</h3>
            <ul>
              {sets.map((set) => (
                <li data-set={`mcat-${set.id}`}>
                  <a class="passage" href={`/mcat/${set.id}/`}>
                    <strong>{set.title}</strong>
                    <small>{set.categories.map((c) => CATEGORY[c] ?? c).join(', ')} · {set.questions.length} questions <b class="done" data-done hidden>✓ Done</b></small>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </section>
      <section id="topics">
        <h2>Browse topics</h2>
        <p class="intro">Choose a topic for up to 59 questions.</p>
        <ul class="topic-list">
          {topics.map(([t, n]) => <li><a href={`/mcat/practice/?topic=${t}`}><small>{t}</small><strong>{CATEGORY[t] ?? t}</strong><span>{n}<span class="sr-only"> questions available</span></span></a></li>)}
        </ul>
      </section>
    </div>
    <details>
      <summary>About this question bank and official MCAT resources</summary>
      <p>This bank focuses on biology and biochemistry. {MCAT_SCOPE_NOTE}</p>
      {beyondCount > 0 && <p>For {beyondCount} additional questions from {beyondNames}, enable “{BEYOND_LABEL}” in <a href="/mcat/practice/">topic practice</a>. These graduate questions are counted separately.</p>}
      <p>STEMhop writes its own practice materials. Each passage goes through a format check, two independent AI solvers from different companies who must agree on the answer, and a separate review of its fit with the exam.</p>
      <p>For official practice and scaled scores, visit <a href="https://students-residents.aamc.org/prepare-mcat-exam/prepare-mcat-exam">AAMC MCAT prep</a> or explore the <a href="https://students-residents.aamc.org/fee-assistance-program/fee-assistance-program">Fee Assistance Program</a>.</p>
    </details>
  </article>

  <script>
    import { load, dueNow, onChange } from '../../lib/progress';
    onChange(() => {
      const p = load();
      const due = dueNow(p).length;
      const d = document.querySelector('[data-due]');
      if (d) d.textContent = due ? `${due} due now.` : '';
      document.querySelectorAll<HTMLElement>('[data-set]').forEach((li) => {
        const tag = li.querySelector<HTMLElement>('[data-done]');
        if (tag) tag.hidden = !p.lessons[li.dataset.set!]?.d;
      });
    });
  </script>

  <style>
    .mhub { padding-block: clamp(1.75rem, 4vw, 3.5rem); color: var(--ddp-color-ink-soft); }
    .hero, .library { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: clamp(1.5rem, 5vw, 4rem); }
    .hero { align-items: center; }
    h1, h2, h3 { font-weight: 500; margin: 0; }
    h1 { font-size: clamp(3rem, 6vw, 5rem); letter-spacing: -.045em; }
    h2 { font-size: clamp(1.8rem, 3vw, 2.4rem); letter-spacing: -.035em; }
    .eyebrow, small, .jump, .topic-list a > span { font-family: var(--ddp-font-mono); }
    .eyebrow { font-size: .78rem; letter-spacing: .09em; text-transform: uppercase; color: var(--ddp-color-caution-ink); }
    .eyebrow a { color: inherit; }
    .lede { max-width: 51ch; margin: .75rem 0 1.25rem; font-size: var(--ddp-text-lg); line-height: 1.55; }
    .jump { display: flex; flex-wrap: wrap; gap: 1.5rem; font-size: .85rem; }
    .jump a { padding-block: .3rem; border-bottom: 1px solid currentColor; }
    .diagnostic { padding: 1.25rem 1.5rem 1.5rem; border-radius: var(--ddp-radius); border: 1px solid var(--ddp-color-line); border-top: 3px solid var(--ddp-color-secondary); background: var(--ddp-color-surface); }
    .diag-heading { display: flex; align-items: center; justify-content: space-between; gap: .5rem; }
    .diagnostic small { display: block; margin-block: .5rem 1rem; }
    small { color: var(--ddp-color-muted); font-size: .78rem; }
    .start { display: flex; align-items: center; justify-content: space-between; background: var(--ddp-color-secondary); color: var(--color-navy); font-weight: 700; border-radius: var(--ddp-radius-sm); padding: .7rem 1rem; }
    .tools { display: grid; grid-template-columns: repeat(3, 1fr); border-block: 1px solid var(--ddp-color-line); padding-block: 1rem; margin-block: 2rem clamp(2rem, 5vw, 4rem); }
    .tools a { display: grid; align-content: start; gap: .25rem; padding: .4rem 1.1rem; }
    .tools a:first-child { padding-left: 0; }
    .tools a + a { border-left: 1px solid var(--ddp-color-line); }
    .tools strong { font-size: 1.05rem; }
    .tools strong::after { content: ' →' / ''; }
    .tools span, .intro { color: var(--ddp-color-ink-soft); font-size: .9rem; }
    [data-due]:not(:empty)::before { content: ' · '; }
    .intro { margin-top: .4rem; }
    ul { list-style: none; padding: 0; margin: 0; }
    .group, .topic-list { margin-top: 1.5rem; }
    .group h3 { font-size: 1.2rem; border-bottom: 2px solid var(--ddp-color-line); padding-bottom: .65rem; }
    .passage { display: grid; gap: .3rem; padding: .85rem .25rem; }
    .passage small { font-family: var(--ddp-font-sans); font-size: .84rem; }
    .passage strong, .topic-list strong { font-weight: 550; }
    li { border-bottom: 1px solid var(--ddp-color-line); }
    .done { color: var(--ddp-color-verified-ink); margin-left: .4rem; }
    .topic-list { border-top: 2px solid var(--ddp-color-line); }
    .topic-list a { display: grid; grid-template-columns: 2ch 1fr auto; align-items: baseline; gap: .75rem; padding: .8rem .25rem; line-height: 1.4; }
    .topic-list a > span { color: var(--ddp-color-muted); font-size: .8rem; }
    .passage:hover, .topic-list a:hover, .tools a:hover { background: var(--ddp-color-surface); text-decoration: none; }
    a:hover strong { text-decoration: underline; }
    details { margin-top: 3rem; border-block: 1px solid var(--ddp-color-line); padding-block: 1rem; }
    summary { cursor: pointer; font-weight: 600; color: var(--ddp-color-primary); }
    details p { max-width: 72ch; margin-top: 1rem; }
    details a { text-decoration: underline; }
    @media (max-width: 720px) {
      .hero, .library { grid-template-columns: 1fr; }
      .tools { grid-template-columns: 1fr; padding: 0; }
      .tools a, .tools a:first-child { padding: .75rem 0; }
      .tools a + a { border-left: 0; border-top: 1px solid var(--ddp-color-line); }
    }
  </style>
</BaseLayout>
