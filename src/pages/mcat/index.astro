---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SETS, SECTION, CATEGORY, discreteItems } from '../../lib/mcat';

const discrete = await discreteItems();
const byTopic = new Map<string, number>();
for (const d of discrete) byTopic.set(d.topic, (byTopic.get(d.topic) ?? 0) + 1);
const topics = [...byTopic.entries()].sort((a, b) => a[0].localeCompare(b[0]));
const sections = ['bb', 'cp'].map((s) => ({ s, sets: SETS.filter((x) => x.section === s) })).filter((x) => x.sets.length);
---

<BaseLayout title="MCAT practice — Biochemistrypedia" description="Free, original MCAT-style practice: research passages with data, a diagnostic, and topic practice that sends every miss back to the lesson that teaches it.">
  <article class="wrap mhub" data-mhub>
    <p class="mh-eyebrow"><a href="/paths/mcat/">MCAT path</a> · Practice</p>
    <h1>MCAT practice</h1>
    <p class="mh-lede">
      Most science questions on the MCAT come in sets after a short research passage with data. These are
      written the same way: a study, a figure or table, then questions that ask you to read the data, judge the
      design and reason from what you know. Every miss links to the lesson section that teaches it and comes back
      for review.
    </p>
    <p class="mh-honest">
      Everything here is original and written for this site; none of it comes from the AAMC or any prep company.
      Each passage passes a format check, two independent AI solvers from different companies who must agree on
      the answer, and a separate reviewer who checks it against how the real exam is written.
      For official practice and a real scaled score, use the AAMC's own materials:
      <a href="https://students-residents.aamc.org/prepare-mcat-exam/prepare-mcat-exam" rel="noopener">AAMC MCAT prep</a> ·
      <a href="https://students-residents.aamc.org/fee-assistance-program/fee-assistance-program" rel="noopener">Fee Assistance Program</a>.
    </p>

    <div class="mh-cards">
      <a class="mh-card" href="/mcat/diagnostic/">
        <span class="mh-k">Start here · about 30 minutes</span>
        <span class="mh-t">Diagnostic</span>
        <span class="mh-d">20 questions across the biology and biochemistry topics, then a topic-by-topic picture of where to focus.</span>
      </a>
      <a class="mh-card" href="/mcat/practice/">
        <span class="mh-k">{discrete.length} questions</span>
        <span class="mh-t">Topic practice</span>
        <span class="mh-d">Ten questions at a time from one topic, each linked to its lesson.</span>
      </a>
      <a class="mh-card" href="/review/">
        <span class="mh-k">Spaced review</span>
        <span class="mh-t">Your review queue</span>
        <span class="mh-d">Misses come back after 1, 3, 7 and 21 days until they stick. <span data-due></span></span>
      </a>
    </div>

    <h2>Passages</h2>
    {sections.length === 0 && <p class="mh-muted">The first passages are on their way.</p>}
    {sections.map(({ s, sets }) => (
      <section>
        <h3 class="mh-sec">{SECTION[s]}</h3>
        <ul class="mh-sets">
          {sets.map((set) => (
            <li data-set={`mcat-${set.id}`}>
              <a href={`/mcat/${set.id}/`}>{set.title}</a>
              <span class="mh-muted"> · {set.categories.map((c) => CATEGORY[c] ?? c).join(', ')} · {set.questions.length} questions</span>
              <span class="mh-done" data-done hidden>✓ done</span>
            </li>
          ))}
        </ul>
      </section>
    ))}

    <h2>Topics</h2>
    <ul class="mh-topics">
      {topics.map(([t, n]) => <li><a href={`/mcat/practice/?topic=${t}`}>{t} · {CATEGORY[t] ?? t}</a> <span class="mh-muted">{n}</span></li>)}
    </ul>
  </article>

  <script>
    import { load, dueNow, onChange } from '../../lib/progress';
    onChange(() => {
      const p = load();
      const due = dueNow(p).length;
      const d = document.querySelector('[data-due]');
      if (d) d.textContent = due ? `${due} due now.` : '';
      document.querySelectorAll<HTMLElement>('[data-set]').forEach((li) => {
        const tag = li.querySelector<HTMLElement>('[data-done]');
        if (tag) tag.hidden = !p.lessons[li.dataset.set!]?.d;
      });
    });
  </script>

  <style>
    .mhub { padding-block: var(--ddp-space-10, 2.5rem) var(--ddp-space-12); max-width: 980px; }
    .mh-eyebrow { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); letter-spacing: 0.12em; text-transform: uppercase; color: var(--ddp-color-caution); margin: 0 0 var(--ddp-space-2); }
    .mh-eyebrow a { color: inherit; }
    h1 { font-family: var(--ddp-font-serif); font-weight: 500; color: var(--ddp-color-primary); font-size: var(--ddp-text-3xl); margin: 0; }
    h2 { font-family: var(--ddp-font-serif); font-weight: 500; color: var(--ddp-color-primary); margin: var(--ddp-space-8) 0 var(--ddp-space-3); }
    .mh-lede { font-size: var(--ddp-text-lg); line-height: 1.6; color: var(--ddp-color-ink-soft); max-width: 66ch; }
    .mh-honest { font-size: var(--ddp-text-sm); color: var(--ddp-color-ink-soft); max-width: 70ch; padding: var(--ddp-space-3) var(--ddp-space-4); border-left: 4px solid var(--ddp-color-caution); background: var(--ddp-color-caution-soft); border-radius: 6px; }
    .mh-honest a, .mh-sets a, .mh-topics a { color: var(--ddp-color-accent); }
    .mh-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr)); gap: var(--ddp-space-4); margin-top: var(--ddp-space-6); }
    .mh-card { display: flex; flex-direction: column; gap: var(--ddp-space-2); padding: var(--ddp-space-5); border: 1px solid var(--ddp-color-line); border-radius: var(--ddp-radius-sm, 8px); background: var(--ddp-color-surface); color: var(--ddp-color-ink); text-decoration: none; }
    .mh-card:hover { border-color: var(--ddp-color-accent); text-decoration: none; }
    .mh-k { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); letter-spacing: 0.06em; text-transform: uppercase; color: var(--ddp-color-muted); }
    .mh-t { font-family: var(--ddp-font-serif); font-size: var(--ddp-text-xl, 1.4rem); color: var(--ddp-color-primary); }
    .mh-d { font-size: var(--ddp-text-sm); color: var(--ddp-color-ink-soft); line-height: 1.5; }
    .mh-sec { font-size: var(--ddp-text-base); margin: var(--ddp-space-4) 0 var(--ddp-space-2); }
    .mh-sets, .mh-topics { padding-left: 1.1rem; line-height: 1.8; }
    .mh-muted { color: var(--ddp-color-muted); font-size: var(--ddp-text-sm); }
    .mh-done { color: var(--ddp-color-verified); font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); margin-left: var(--ddp-space-2); }
    .mh-done[hidden] { display: none; }
  </style>
</BaseLayout>
