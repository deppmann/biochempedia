---
import BaseLayout from '../../layouts/BaseLayout.astro';
// One source of truth: the same file is kept in the repo at docs/teachers/HOW_ITS_BUILT.md.
import { Content } from '../../../docs/teachers/HOW_ITS_BUILT.md';
---

<BaseLayout
  title="How it's built — Biochemistrypedia"
  description="Plain-language supplement: the write, check, fix, install pipeline, which AI models and tools are used for what, and what it cost."
>
  <article class="wrap prose-col hib" style="padding-top: var(--ddp-space-12)">
    <p class="hib-eyebrow"><a href="/teachers">Resources for teachers</a> / supplement</p>
    <h1>How it&rsquo;s built</h1>
    <Content />
    <p><a href="/teachers">&larr; Back to resources for teachers</a></p>
  </article>

  <style is:global>
    .hib .hib-eyebrow { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ddp-color-muted); }
    .hib table { display: block; max-width: 100%; overflow-x: auto; border-collapse: collapse; margin: var(--ddp-space-5) 0; font-size: var(--ddp-text-sm); }
    .hib th, .hib td { text-align: left; vertical-align: top; padding: var(--ddp-space-2) var(--ddp-space-3); border-bottom: 1px solid var(--ddp-color-line); min-width: 8rem; }
    .hib th { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); letter-spacing: 0.06em; text-transform: uppercase; color: var(--ddp-color-muted); }
    .hib > ul, .hib > ol { padding-left: 1.3rem; }
    .hib > ul { list-style: disc; }
    .hib > ol { list-style: decimal; }
    .hib li { margin-bottom: var(--ddp-space-2); }
  </style>
</BaseLayout>
