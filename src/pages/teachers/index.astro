---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { feedbackUrl } from '../../lib/feedback';
import { COURSES, courseHref } from '../../data/courses';
import { stageOf } from '../../data/stages';
import { readingRange } from '../../lib/readability';

// Lesson counts come from the lesson collection, so they can never go stale.
const lessons = await getCollection('lessons', (l) => !l.data.draft);
const n = (slug: string) => lessons.filter((l) => l.data.course === slug).length;
const courseCount = new Set(lessons.map((l) => l.data.course)).size;

// "How hard each course reads": who each course was written for, and a reading-grade range
// worked out from the lesson text at build (src/lib/readability.ts), so it follows every rewrite.
const WRITTEN_FOR: Record<string, string> = {
  'ages-5-10': 'Parents and teachers of children aged 5 to 10. The adult reads the page.',
  'grade-7': 'Grade 7 students',
  'high-school': 'High school students, grades 9 and 10',
  'starting-college': 'First- and second-year college students',
  'college-core': 'College biology majors',
  'college-further': 'College students who have taken the core courses',
  'graduate': 'Advanced undergraduates and graduate students',
};
const grade = (g: number) => g.toFixed(1);
const reading = COURSES.map((c) => ({
  c,
  writtenFor: WRITTEN_FOR[stageOf(c)],
  range: readingRange(lessons.filter((l) => l.data.course === c.slug).map((l) => l.body)),
})).filter((r) => r.range);
---

<BaseLayout
  title="For teachers — Biochemistrypedia"
  description="Free biology courses for grade 7 and high school classes, with a standards map for each course and free classes for assigning lessons. No ads, and students need no account."
>
  <article class="wrap tl" style="padding-top: var(--ddp-space-12)">
    <header class="prose-col">
      <p class="tl-eyebrow">For teachers</p>
      <h1>Free to use with your classes</h1>
      <p>
        Biochemistrypedia is a set of free biology courses: short readings, films of the
        experiments, simulations you can change, and questions with checked answers. Two courses
        follow Virginia&rsquo;s standards for grade 7 and high school. Students need no account,
        and there are no ads.
      </p>
    </header>

    <ul class="tl-cards">
      <li class="tl-card">
        <p class="tl-kicker">Courses for schools</p>
        <h2>Two courses written for school classes</h2>
        <p>
          Life Science has {n('life-science')} lessons for grade 7. Biology has {n('high-school-biology')} lessons
          for high school. Each page says what is in a lesson and how the course was made.
        </p>
        <p class="tl-links">
          <a href="/teachers/life-science">Grade 7 Life Science &rarr;</a>
          <a href="/teachers/biology">High school Biology &rarr;</a>
        </p>
      </li>
      <li class="tl-card">
        <p class="tl-kicker">Standards maps</p>
        <h2>Find the lesson for a standard</h2>
        <p>
          Each course has a table that lists every Virginia standard with the lessons that teach it:
          LS.1 to LS.11 for Life Science, and BIO.1 to BIO.8 for Biology.
        </p>
        <p class="tl-links">
          <a href="/teachers/life-science#standards-map">Life Science map &rarr;</a>
          <a href="/teachers/biology#standards-map">Biology map &rarr;</a>
        </p>
      </li>
      <li class="tl-card">
        <p class="tl-kicker">Classes</p>
        <h2>Make a class</h2>
        <p>
          Give students a code and assign lessons. Each morning, read how they reasoned before
          class. Students use nicknames only. It is free and uses no AI.
        </p>
        <p class="tl-links">
          <a href="/teach/">Make a class &rarr;</a>
        </p>
      </li>
    </ul>

    <div class="prose-col">
      <h2>More for teachers</h2>
      <ul class="tl-more">
        <li>
          <a href="/teachers/talk-notes">Talk notes: Fast Tools, Slow Thinking</a>.
          The slides, the prompts and the text of my October 2026 talk on AI in the classroom.
        </li>
        <li>
          <a href="/teachers/do-it-yourself">Do it yourself</a>.
          Ten things you can try, step by step.
        </li>
        <li>
          <a href="/teachers/checklist">A one-page checklist</a>.
          Five questions to ask of any AI tool for a classroom. It prints on one page.
        </li>
        <li>
          <a href="/teachers/demo">The five-minute demo</a>.
          Try a lesson the way a student would.
        </li>
        <li>
          <a href="/teachers/how-its-built">How it&rsquo;s built</a> and
          <a href="/teachers/sources">the sources</a> for every number in the talk.
        </li>
        <li>
          <a href="/license/">The licence</a>.
          You may copy, share and adapt the lessons for teaching, with credit. You may not sell them.
        </li>
        <li>
          <a href="/courses/">All {courseCount} courses</a>.
          The courses after Biology were written for college students, so read ahead before assigning.
          The table below shows <a href="#reading-level">how hard each course reads</a>.
        </li>
      </ul>

      <h2 id="reading-level">How hard each course reads</h2>
      <p>
        Each course is listed with the readers it was written for and the reading grade of its
        lessons. The grade is a range: half of the course&rsquo;s lessons fall inside it.
      </p>
      <table class="tl-read">
        <thead><tr><th scope="col">Course</th><th scope="col">Written for</th><th scope="col">Reading grade</th></tr></thead>
        <tbody>
          {reading.map(({ c, writtenFor, range }) => (
            <tr>
              <th scope="row"><a href={courseHref(c.slug)}>{c.title}</a></th>
              <td>{writtenFor}</td>
              <td class="tl-read-n">{grade(range!.low) === grade(range!.high) ? grade(range!.low) : `${grade(range!.low)} to ${grade(range!.high)}`}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="tl-read-note">
        Reading grade is the Flesch-Kincaid grade level, worked out from the text of each lesson
        every time the site is built. It measures sentence length and word length, not how hard
        the ideas are. The college courses use short sentences too, so their grades are not far
        above Biology&rsquo;s, but they assume background that a school course teaches from the start.
      </p>

      <h2>Tell us</h2>
      <p>
        Found a mistake, or want a lesson that is not here? The form is anonymous; no sign-in, and
        email is optional.
      </p>
      <p><a class="tl-btn" href={feedbackUrl('Teachers page')}>Report an error or request a lesson</a></p>
    </div>
  </article>

  <style>
    .tl-eyebrow, .tl-kicker { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ddp-color-accent); }
    .tl-cards { list-style: none; padding: 0; margin: var(--ddp-space-8) 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--ddp-space-4); }
    .tl-card { display: flex; flex-direction: column; gap: var(--ddp-space-2); padding: var(--ddp-space-4) var(--ddp-space-5); border: 1px solid var(--ddp-color-line); border-radius: var(--ddp-radius); background: var(--ddp-color-surface); }
    .tl-card h2 { margin: 0; font-family: var(--ddp-font-serif); font-size: var(--ddp-text-xl); color: var(--ddp-color-ink); }
    .tl-card p { margin: 0; color: var(--ddp-color-ink-soft); }
    .tl-card .tl-kicker { color: var(--ddp-color-accent); }
    .tl-links { margin-top: auto !important; padding-top: var(--ddp-space-2); display: flex; flex-direction: column; }
    .tl-links a { display: inline-flex; align-items: center; min-height: 44px; font-weight: 600; }
    .tl-more { padding-left: 1.3rem; list-style: disc; }
    .tl-more li { margin-bottom: var(--ddp-space-2); }
    .tl-read { width: 100%; border-collapse: collapse; margin: var(--ddp-space-3) 0; }
    .tl-read th, .tl-read td { text-align: left; vertical-align: top; padding: var(--ddp-space-2) var(--ddp-space-3) var(--ddp-space-2) 0; border-top: 1px solid var(--ddp-color-line); line-height: 1.45; font-size: var(--ddp-text-sm); }
    .tl-read thead th { border-top: 0; font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 400; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ddp-color-muted); }
    .tl-read tbody th { font-weight: 600; }
    .tl-read th:last-child, .tl-read td:last-child { padding-right: 0; }
    .tl-read-n { white-space: nowrap; font-variant-numeric: tabular-nums; }
    .tl-read-note { font-size: var(--ddp-text-sm) !important; color: var(--ddp-color-muted); }
    .tl-btn { display: inline-flex; align-items: center; min-height: 44px; padding: 0.4em 1.1em; border-radius: 999px; border: 1px solid var(--ddp-color-accent); background: var(--ddp-color-accent); color: #fff; font-weight: 600; text-decoration: none; }
    .tl-btn:hover { filter: brightness(1.1); color: #fff; text-decoration: none; }
    .tl :focus-visible { outline: 2px solid var(--ddp-color-accent); outline-offset: 2px; }
    @media (max-width: 860px) {
      .tl-cards { grid-template-columns: 1fr; }
    }
  </style>
</BaseLayout>
