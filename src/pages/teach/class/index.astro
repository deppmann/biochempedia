---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { COURSES, unitsFor } from '../../../data/courses';
import PRICES from '../../../data/model-prices.json';
import '../../../styles/teach.css';

// Every published lesson, grouped by course and unit, for the lesson picker and for
// titles in the brief. The class id comes from the query string (?id=), read in the browser.
const lessons = await getCollection('lessons', ({ data }) => !data.draft);
const catalog = COURSES
  .map((c) => ({ c, mine: lessons.filter((l) => l.data.course === c.slug) }))
  .filter((x) => x.mine.length > 0)
  .map(({ c, mine }) => ({
    slug: c.slug,
    title: c.title,
    units: unitsFor(c, mine).map((u) => ({ name: u.name, lessons: u.entries.map(({ l, n }) => ({ slug: l.data.slug, title: l.data.title, n })) })),
  }));
const MODES = [
  ['open', 'Open: anyone with the code joins with a nickname'],
  ['approve', 'Approve: students wait until you let them in'],
  ['roster', 'Roster: you make the list and hand out student codes'],
  ['locked', 'Locked: nobody new can join'],
];
---

<BaseLayout title="Class — Biochemistrypedia" description="Your class." noindex>
  <article class="wrap tc" data-class data-catalog={JSON.stringify(catalog)} data-prices={JSON.stringify(PRICES)}>
    <p class="tc-eyebrow"><a href="/teach/classes/">My classes</a></p>
    <h1 data-name>Class</h1>
    <p class="tc-row" style="margin-top: var(--ddp-space-3)">
      <span>Class code <span class="tc-code" data-code></span></span>
      <span class="tc-muted">Students go to <strong data-join-url></strong></span>
    </p>
    <p class="tc-note" data-pending-note hidden></p>
    <p class="tc-note good" data-viewer-note hidden>Shared with your group. You can read this class's brief; only its teacher can change anything.</p>

    <div class="tc-tabs tc-noprint" role="tablist">
      <button class="tc-tab" role="tab" data-tab="brief" aria-selected="true">Morning brief</button>
      <button class="tc-tab" role="tab" data-tab="assign" aria-selected="false">Assign lessons</button>
      <button class="tc-tab" role="tab" data-tab="students" aria-selected="false">Students</button>
      <button class="tc-tab" role="tab" data-tab="settings" aria-selected="false">Settings</button>
    </div>

    <!-- Brief -->
    <section data-pane="brief">
      <p class="tc-muted" data-brief-when></p>
      <section class="tc-card" data-review hidden style="margin-top: var(--ddp-space-4); border-color: var(--ddp-color-accent)">
        <h2 style="margin-top:0">AI feedback waiting for you</h2>
        <p class="tc-muted">Students don't see these until you release them. Edit anything you like first.</p>
        <div data-review-list></div>
      </section>
      <h2 style="margin-top: var(--ddp-space-4)">Who needs you</h2>
      <ul data-needs></ul>
      <p class="tc-muted" data-needs-none hidden>Nobody is flagged: no overdue lessons, no low first-try scores, no stuck notes.</p>
      <div data-lessons></div>
      <p class="tc-muted" data-brief-empty hidden>Nothing to show yet. Assign a lesson, give students the class code, and their work shows up here.</p>
    </section>

    <!-- Assign -->
    <section data-pane="assign" hidden>
      <p class="tc-muted">Tick the lessons you want students to do. A due date is optional; it's how the brief knows who is behind.</p>
      <label class="tc-row" style="font-weight:600">Show lessons from
        <select data-course-pick></select>
      </label>
      <p class="tc-muted" data-assigned-elsewhere hidden></p>
      <div class="tc-units" data-units style="margin-top: var(--ddp-space-4)"></div>
      <div class="tc-sticky tc-row">
        <button class="tc-btn" type="button" data-save-assign>Save assignments</button>
        <span class="tc-muted" data-assign-count></span>
        <span class="tc-ok" data-assign-msg role="status"></span>
      </div>
    </section>

    <!-- Students -->
    <section data-pane="students" hidden>
      <div class="tc-scroll"><table class="tc-table">
        <thead><tr><th>Nickname</th><th>Status</th><th>Joined</th><th>Last seen</th><th></th></tr></thead>
        <tbody data-roster></tbody>
      </table></div>
      <p class="tc-muted" data-roster-empty hidden>No students yet. Give them the class code.</p>
      <div class="tc-card tc-noprint" data-code-show hidden style="margin-top: var(--ddp-space-4)"></div>
      <h2>Add students yourself</h2>
      <p class="tc-muted">One nickname per line. Each student gets a code to join with; print the list and hand them out. This works in any join mode, and is the best choice for younger students.</p>
      <form class="tc-form" data-roster-form>
        <textarea name="names" rows="6" placeholder={'Ava R\nBen\nCarlos M'}></textarea>
        <button class="tc-btn" type="submit">Make codes</button>
        <p class="tc-error" data-roster-err role="alert"></p>
      </form>
      <div data-made hidden style="margin-top: var(--ddp-space-4)">
        <p class="tc-note good">Codes are shown only now. Print or copy them before you leave this page.</p>
        <div class="tc-scroll"><table class="tc-table"><thead><tr><th>Nickname</th><th>Student code</th></tr></thead><tbody data-made-rows></tbody></table></div>
        <p class="tc-muted" data-made-how></p>
        <button class="tc-btn ghost tc-noprint" type="button" onclick="window.print()">Print</button>
      </div>
    </section>

    <!-- Settings -->
    <section data-pane="settings" hidden>
      <form class="tc-form" data-settings>
        <label>Class name<input type="text" name="name" maxlength="60" required /></label>
        <label>How students join<select name="joinMode">{MODES.map(([v, l]) => <option value={v}>{l}</option>)}</select></label>
        <label>Group<select name="groupId"><option value="">No group</option></select></label>
        <label class="tc-check"><input type="checkbox" name="shared" />
          <span>Share this class's brief with the group's admins (read only). Otherwise they see only its name and counts.</span></label>
        <button class="tc-btn" type="submit">Save</button>
        <p class="tc-ok" data-set-msg role="status"></p>
      </form>
      <h2>AI feedback</h2>
      <p class="tc-muted" style="max-width:68ch">Optional. When it's on, a student who sends a written answer gets short feedback that points to a strength, the biggest gap, and a question to think about, without giving the answer away. It runs on your own API key, so your provider bills you directly.</p>
      <p class="tc-note" data-ai-unavailable hidden></p>
      <form class="tc-form" data-ai-form>
        <label class="tc-check"><input type="checkbox" name="aiEnabled" /> <span>Turn on AI feedback for this class</span></label>
        <label>Provider (from your saved keys)<select name="aiProvider"></select></label>
        <label>Model<select name="aiModelPick"></select></label>
        <label data-ai-other hidden>Model name, exactly as the provider writes it<input type="text" name="aiModelOther" maxlength="80" /></label>
        <fieldset style="border:0;padding:0;margin:0">
          <legend style="font-size:var(--ddp-text-sm);font-weight:600;margin-bottom:.3rem">When students see AI feedback</legend>
          <label class="tc-check"><input type="radio" name="aiMode" value="hold" /> <span>After I review it (I can edit or discard it first)</span></label>
          <label class="tc-check"><input type="radio" name="aiMode" value="show" /> <span>Right away (I can still read every exchange)</span></label>
        </fieldset>
        <label>Monthly spending limit for this class, in US dollars<input type="number" name="aiCap" min="0" max="1000" step="0.5" /></label>
        <p class="tc-note good" data-ai-estimate style="margin:0"></p>
        <p class="tc-muted" data-ai-spent style="margin:0"></p>
        <button class="tc-btn" type="submit">Save AI settings</button>
        <p class="tc-ok" data-ai-msg role="status"></p>
        <p class="tc-error" data-ai-err role="alert"></p>
      </form>

      <h2>Class code</h2>
      <p class="tc-muted">Make a new code if the old one got shared too widely. Students already in the class stay in.</p>
      <button class="tc-btn ghost" type="button" data-new-code>Make a new class code</button>
      <h2>Delete this class</h2>
      <p class="tc-muted">Deletes the class, its students and all their answers, for good.</p>
      <button class="tc-btn danger" type="button" data-delete>Delete class</button>
    </section>
  </article>

  <script>
    import { api } from '../../../lib/classroom';

    type Catalog = { slug: string; title: string; units: { name: string; lessons: { slug: string; title: string; n: number }[] }[] }[];
    interface Brief {
      class: { id: string; name: string; code: string; course: string; joinMode: string; groupId: string | null; shared: boolean };
      viewer: 'owner' | 'group-admin';
      ai?: { available: boolean; enabled: boolean; provider: string | null; model: string | null; mode: string; capCents: number; spentMicro: number; hasKey: boolean };
      feedback?: { id: number; lesson: string; kind: string; item: string; answer: string; draft: string | null; final: string | null; status: string; source: string; at: number; studentId: number; student: string; seenAt: number | null }[];
      students: { id: number; nickname: string; status: string; joined: number; lastSeen: number | null }[];
      assignments: { slug: string; due: string | null }[];
      lessons: Record<string, { started: number; done: number; notStarted: string[]; ideas: { item: string; idea: string; answer: string; agree: number; disagree: number }[]; quiz: { item: string; n: number; correct: number }[]; cers: { student: string; studentId: number; item: string; task: string; claim: string; evidence: string; reasoning: string; text: string; at: number }[]; stuck: { student: string; studentId: number; text: string; at: number }[] }>;
      needs: { student: string; reasons: string[] }[];
    }
    interface QuizFile { items: { id: string; stem: string; choices: string[]; answer: number; anchor: { id: string; text: string } | null }[] }

    const root = document.querySelector<HTMLElement>('[data-class]')!;
    const catalog: Catalog = JSON.parse(root.dataset.catalog!);
    const lessonInfo = new Map<string, { title: string; course: string }>();
    for (const c of catalog) for (const u of c.units) for (const l of u.lessons) lessonInfo.set(l.slug, { title: l.title, course: c.title });
    const id = new URLSearchParams(location.search).get('id') || '';
    const $ = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    // Tiny element builder. `style` may be a CSS string; everything else is set as a property.
    const el = <K extends keyof HTMLElementTagNameMap>(tag: K, props: Record<string, unknown> = {}, ...kids: (Node | string)[]): HTMLElementTagNameMap[K] => {
      const { style, ...rest } = props;
      const e = Object.assign(document.createElement(tag), rest);
      if (typeof style === 'string') e.setAttribute('style', style);
      e.append(...kids);
      return e;
    };
    const fmtDate = (t: number | null) => (t ? new Date(t).toLocaleDateString(undefined, { month: 'short', day: 'numeric' }) : '—');
    const fmtDue = (d: string | null) => (d ? new Date(d + 'T12:00').toLocaleDateString(undefined, { weekday: 'short', month: 'short', day: 'numeric' }) : 'no due date');
    let brief: Brief;

    // ---- tabs ----
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-tab]'));
    const show = (k: string) => {
      tabs.forEach((t) => t.setAttribute('aria-selected', String(t.dataset.tab === k)));
      root.querySelectorAll<HTMLElement>('[data-pane]').forEach((p) => (p.hidden = p.dataset.pane !== k));
      history.replaceState(null, '', `?id=${id}&tab=${k}`);
    };
    tabs.forEach((t) => t.addEventListener('click', () => show(t.dataset.tab!)));

    async function load() {
      const r = await api<Brief>(`/api/classes/${encodeURIComponent(id)}/brief`);
      if (r.status === 401) { location.replace('/teach/'); return; }
      if (!r.ok) { $('[data-name]').textContent = r.data.error || 'Could not load this class.'; return; }
      brief = r.data;
      const c = brief.class;
      document.title = `${c.name} — Biochemistrypedia`;
      $('[data-name]').textContent = c.name;
      $('[data-code]').textContent = c.code;
      $('[data-join-url]').textContent = `${location.host}/join/?code=${c.code}`;
      const pending = brief.students.filter((s) => s.status === 'pending').length;
      $('[data-pending-note]').hidden = !pending;
      $('[data-pending-note]').textContent = `${pending} ${pending === 1 ? 'student is' : 'students are'} waiting to join. See the Students tab.`;
      renderBrief();
      renderReview();
      // A group admin reading a shared class: brief only, nothing to change.
      const viewer = brief.viewer === 'group-admin';
      $('[data-viewer-note]').hidden = !viewer;
      tabs.forEach((t) => { if (t.dataset.tab !== 'brief') t.hidden = viewer; });
      if (viewer) { show('brief'); return; }
      renderAssign();
      renderRoster();
      renderAi();
      const f = $<HTMLFormElement>('[data-settings]');
      (f.elements.namedItem('name') as HTMLInputElement).value = c.name;
      (f.elements.namedItem('joinMode') as HTMLSelectElement).value = c.joinMode;
      const gsel = f.elements.namedItem('groupId') as HTMLSelectElement;
      const gr = await api<{ groups: { id: string; name: string; status: string }[] }>('/api/groups/mine');
      gsel.querySelectorAll('option:not([value=""])').forEach((o) => o.remove());
      for (const g of (gr.ok ? gr.data.groups : []).filter((x) => x.status === 'active')) gsel.append(el('option', { value: g.id, textContent: g.name }));
      gsel.value = c.groupId ?? '';
      (f.elements.namedItem('shared') as HTMLInputElement).checked = c.shared;
    }

    // ---- brief ----
    const quizCache = new Map<string, Promise<QuizFile | null>>();
    const quizFor = (slug: string) => {
      if (!quizCache.has(slug)) quizCache.set(slug, fetch(`/quiz/${slug}.json`).then((r) => (r.ok ? r.json() : null)).catch(() => null));
      return quizCache.get(slug)!;
    };

    function renderBrief() {
      $('[data-brief-when]').textContent = `As of ${new Date().toLocaleString(undefined, { weekday: 'long', hour: 'numeric', minute: '2-digit' })}. Reload for the latest.`;
      const needs = $('[data-needs]');
      needs.textContent = '';
      for (const n of brief.needs) needs.append(el('li', {}, el('strong', { textContent: n.student }), ` · ${n.reasons.join('; ')}`));
      $('[data-needs-none]').hidden = brief.needs.length > 0;

      const box = $('[data-lessons]');
      box.textContent = '';
      const active = brief.students.filter((s) => s.status === 'active').length;
      const order = [...brief.assignments.map((a) => a.slug), ...Object.keys(brief.lessons).filter((s) => !brief.assignments.some((a) => a.slug === s))];
      $('[data-brief-empty]').hidden = order.length > 0;
      const today = new Date().toISOString().slice(0, 10);
      // Open the lesson due next; failing that, the first one students have started.
      const openSlug = brief.assignments.find((a) => a.due && a.due >= today)?.slug
        ?? order.find((s) => (brief.lessons[s]?.started ?? 0) > 0) ?? order[0];
      for (const slug of order) {
        const L = brief.lessons[slug] ?? { started: 0, done: 0, notStarted: [], ideas: [], quiz: [], cers: [], stuck: [] };
        const a = brief.assignments.find((x) => x.slug === slug);
        const info = lessonInfo.get(slug);
        const det = el('details', { className: 'tc-lesson tc-card', open: slug === openSlug });
        const sum = el('summary', {}, `${info?.title ?? slug}`);
        sum.append(el('span', { className: 'tc-muted', textContent: ` · ${a ? fmtDue(a.due) : 'not assigned'} · ${L.done} of ${active} done, ${L.started} started` }));
        det.append(sum);
        const links = el('p', { className: 'tc-row tc-noprint' },
          el('a', { href: `/lessons/${slug}/`, textContent: 'Open the lesson', target: '_blank' }),
          el('a', { href: `/teach/room/?id=${id}&lesson=${slug}`, textContent: 'Room view for class →', target: '_blank' }));
        det.append(links);
        if (L.notStarted.length && a) det.append(el('p', { className: 'tc-muted', textContent: `Not started: ${L.notStarted.join(', ')}` }));

        if (L.ideas.length) {
          det.append(el('h3', { textContent: 'Opening question: where the class split' }));
          for (const it of L.ideas) {
            const n = it.agree + it.disagree;
            const wrong = it.answer === 'agree' ? it.disagree : it.agree;
            const bar = el('div', { className: 'tc-bar' });
            bar.append(el('span', { className: 'agree' }), el('span', { className: 'disagree' }));
            (bar.children[0] as HTMLElement).style.width = `${(it.agree / Math.max(n, 1)) * 100}%`;
            (bar.children[1] as HTMLElement).style.width = `${(it.disagree / Math.max(n, 1)) * 100}%`;
            det.append(el('div', { style: 'margin: .6rem 0' },
              el('p', { style: 'margin:0 0 .25rem' }, it.idea || `Statement ${it.item}`),
              bar,
              el('p', { className: 'tc-legend', style: 'margin:.2rem 0 0' },
                `${it.agree} agree · ${it.disagree} disagree · scientists ${it.answer} · ${wrong} of ${n} held the common idea`)));
          }
        }

        if (L.quiz.length) {
          det.append(el('h3', { textContent: 'Quiz: most missed on the first try' }));
          const list = el('ol', { style: 'padding-left:1.2rem' });
          det.append(list);
          quizFor(slug).then((qf) => {
            // Questions whose wording changed since students answered no longer match; skip them.
            for (const q of L.quiz.filter((x) => qf?.items.some((i) => i.id === x.item)).slice(0, 5)) {
              const item = qf?.items.find((x) => x.id === q.item);
              const li = el('li', { style: 'margin-bottom:.5rem' });
              const pct = Math.round((q.correct / q.n) * 100);
              li.append(el('span', { className: `tc-pill ${pct < 50 ? 'warn' : pct >= 80 ? 'good' : ''}`, textContent: `${q.correct}/${q.n} right` }), ' ', item?.stem ?? '');
              if (item?.anchor) li.append(' ', el('a', { href: `/lessons/${slug}/#${item.anchor.id}`, target: '_blank', textContent: `Reteach: ${item.anchor.text}` }));
              list.append(li);
            }
          });
        }

        if (L.cers.length) {
          det.append(el('h3', { textContent: `Written answers sent to you (${L.cers.length})` }));
          // One group per task (each claim-evidence-reasoning box or design problem).
          const items = [...new Set(L.cers.map((c) => c.item))];
          for (const it of items) {
            const group = L.cers.filter((c) => c.item === it);
            const label = it.startsWith('design-') ? `Design problem ${it.slice(7)}` : 'Claim, evidence, reasoning';
            const head = el('p', { className: 'tc-row', style: 'margin:.8rem 0 .2rem' }, el('strong', { textContent: `${label} · ${group.length}` }));
            if (aiReady() && owner() && group.length >= 2) head.append(summaryButton(slug, it, det));
            det.append(head);
            for (const c of group) {
              const q = el('div', { className: 'tc-quote' });
              q.append(el('b', { textContent: c.student }));
              for (const [k, v] of [['Claim', c.claim], ['Evidence', c.evidence], ['Reasoning', c.reasoning], ['Answer', c.text]]) if (v) q.append(el('p', { style: 'margin:.3rem 0 0' }, el('em', { textContent: `${k}: ` }), v));
              const f = (brief.feedback ?? []).find((x) => x.studentId === c.studentId && x.lesson === slug && x.item === it);
              if (f) q.append(el('p', { className: 'tc-legend', style: 'margin:.4rem 0 0' },
                `AI feedback: ${f.status === 'held' ? 'waiting for your review (above)' : `released${f.seenAt ? ', seen' : ''}`} · `, el('span', { textContent: (f.final ?? f.draft ?? '').slice(0, 220) })));
              det.append(q);
            }
          }
        }

        if (L.stuck.length) {
          det.append(el('h3', { textContent: `Stuck notes (${L.stuck.length})` }));
          for (const s of L.stuck) {
            const q = el('div', { className: 'tc-quote' }, el('b', { textContent: s.student }), el('p', { style: 'margin:.3rem 0 0', textContent: s.text }));
            const sentNotes = (brief.feedback ?? []).filter((x) => x.studentId === s.studentId && x.lesson === slug && x.source === 'teacher');
            for (const n of sentNotes) q.append(el('p', { className: 'tc-legend', style: 'margin:.3rem 0 0', textContent: `You replied: ${n.final}` }));
            if (owner()) q.append(replyForm(slug, s.studentId));
            det.append(q);
          }
        }
        if (!L.ideas.length && !L.quiz.length && !L.cers.length && !L.stuck.length) det.append(el('p', { className: 'tc-muted', textContent: 'No answers yet.' }));
        box.append(det);
      }
    }

    // ---- AI helpers (brief) ----
    const owner = () => brief.viewer === 'owner';
    const aiReady = () => !!brief.ai?.available && !!brief.ai?.enabled && !!brief.ai?.hasKey;
    function summaryButton(slug: string, item: string, det: HTMLElement) {
      const b = el('button', { type: 'button', className: 'tc-btn small ghost', textContent: 'Summarize with AI' });
      b.addEventListener('click', async () => {
        b.disabled = true; b.textContent = 'Summarizing…';
        const r = await api<{ text: string }>(`/api/classes/${id}/ai/summary`, { lesson: slug, item });
        b.disabled = false; b.textContent = 'Summarize with AI';
        const out = el('div', { className: 'tc-note good', style: 'white-space:pre-wrap;margin:.4rem 0' });
        out.textContent = r.ok ? r.data.text : r.data.error || 'Could not summarize.';
        b.closest('p')!.after(out);
      });
      return b;
    }
    function replyForm(slug: string, studentId: number) {
      const wrap = el('details', { style: 'margin-top:.4rem' });
      wrap.append(el('summary', { textContent: 'Reply' }));
      const ta = el('textarea', { rows: 3, style: 'width:100%;margin-top:.4rem' });
      const row = el('p', { className: 'tc-row', style: 'margin:.4rem 0 0' });
      const send = el('button', { type: 'button', className: 'tc-btn small', textContent: 'Send to student' });
      const msg = el('span', { className: 'tc-ok' });
      if (aiReady()) {
        const draft = el('button', { type: 'button', className: 'tc-btn small ghost', textContent: 'Draft with AI' });
        draft.addEventListener('click', async () => {
          draft.disabled = true; msg.textContent = 'Drafting…';
          const r = await api<{ text: string }>(`/api/classes/${id}/ai/reply`, { lesson: slug, studentId });
          draft.disabled = false;
          msg.textContent = r.ok ? 'Draft ready: edit it, then send.' : r.data.error || 'Could not draft.';
          if (r.ok) ta.value = r.data.text;
        });
        row.append(draft);
      }
      send.addEventListener('click', async () => {
        if (!ta.value.trim()) { msg.textContent = 'Write a reply first.'; return; }
        const r = await api(`/api/classes/${id}/notes`, { studentId, lesson: slug, text: ta.value, kind: 'stuck' });
        msg.textContent = r.ok ? 'Sent. The student sees it in the lesson.' : r.data.error || 'Could not send.';
        if (r.ok) load();
      });
      row.append(send, msg);
      wrap.append(ta, row);
      return wrap;
    }
    function renderReview() {
      const held = (brief.feedback ?? []).filter((f) => f.status === 'held');
      $('[data-review]').hidden = !held.length || !owner();
      const list = $('[data-review-list]');
      list.textContent = '';
      for (const f of held) {
        const card = el('div', { className: 'tc-quote' });
        card.append(el('p', { style: 'margin:0' }, el('b', { textContent: f.student }), ` · ${lessonInfo.get(f.lesson)?.title ?? f.lesson} · ${f.item.startsWith('design-') ? 'design problem' : 'claim, evidence, reasoning'}`));
        const ans = el('details', { style: 'margin:.3rem 0' }, el('summary', { textContent: 'Their answer' }));
        ans.append(el('p', { style: 'white-space:pre-wrap;margin:.3rem 0 0', textContent: f.answer }));
        const ta = el('textarea', { rows: 5, style: 'width:100%' });
        ta.value = f.draft ?? '';
        const row = el('p', { className: 'tc-row', style: 'margin:.4rem 0 0' });
        const rel = el('button', { type: 'button', className: 'tc-btn small', textContent: 'Release to student' });
        const dis = el('button', { type: 'button', className: 'tc-btn small danger', textContent: 'Discard' });
        rel.addEventListener('click', async () => { const r = await api(`/api/classes/${id}/feedback/${f.id}`, { action: 'release', text: ta.value }); if (r.ok) load(); });
        dis.addEventListener('click', async () => { const r = await api(`/api/classes/${id}/feedback/${f.id}`, { action: 'discard' }); if (r.ok) load(); });
        row.append(rel, dis);
        card.append(ans, ta, row);
        list.append(card);
      }
    }

    // ---- AI settings ----
    const prices: { models: { provider: string; model: string; label: string; in: number; out: number; note?: string }[]; estimate: { feedback_in: number; feedback_out: number } } = JSON.parse(root.dataset.prices!);
    let keys: string[] = [];
    async function renderAi() {
      const ai = brief.ai!;
      const st = await api<{ available: boolean; keys: { provider: string }[] }>('/api/ai/status');
      keys = st.ok ? st.data.keys.map((k) => k.provider) : [];
      const un = $('[data-ai-unavailable]');
      const form = $<HTMLFormElement>('[data-ai-form]');
      un.hidden = ai.available && keys.length > 0;
      un.textContent = '';
      if (!ai.available) un.textContent = "AI feedback isn't switched on for the site yet.";
      else if (!keys.length) { un.append('Add an API key first, under '); un.append(el('a', { href: '/teach/classes/#ai', textContent: 'AI feedback keys on My classes' }), '.'); }
      form.hidden = !ai.available || !keys.length;
      const NAMES: Record<string, string> = { gemini: 'Google (Gemini)', anthropic: 'Anthropic (Claude)', openai: 'OpenAI (GPT)' };
      const ps = form.elements.namedItem('aiProvider') as HTMLSelectElement;
      ps.textContent = '';
      for (const k of keys) ps.append(el('option', { value: k, textContent: NAMES[k] ?? k }));
      ps.value = ai.provider && keys.includes(ai.provider) ? ai.provider : keys[0] ?? '';
      fillModels(ai.model);
      (form.elements.namedItem('aiEnabled') as HTMLInputElement).checked = ai.enabled;
      form.querySelectorAll<HTMLInputElement>('[name=aiMode]').forEach((r) => (r.checked = r.value === (ai.mode || 'hold')));
      (form.elements.namedItem('aiCap') as HTMLInputElement).value = String((ai.capCents ?? 500) / 100);
      $('[data-ai-spent]').textContent = `Spent this month in this class: $${(ai.spentMicro / 1e6).toFixed(2)} of $${((ai.capCents ?? 500) / 100).toFixed(2)}.`;
      estimate();
    }
    function fillModels(current: string | null) {
      const form = $<HTMLFormElement>('[data-ai-form]');
      const provider = (form.elements.namedItem('aiProvider') as HTMLSelectElement).value;
      const ms = form.elements.namedItem('aiModelPick') as HTMLSelectElement;
      ms.textContent = '';
      for (const m of prices.models.filter((x) => x.provider === provider)) ms.append(el('option', { value: m.model, textContent: m.label }));
      ms.append(el('option', { value: '__other', textContent: 'Another model…' }));
      const known = prices.models.some((x) => x.provider === provider && x.model === current);
      ms.value = current ? (known ? current : '__other') : ms.options[0]?.value ?? '';
      (form.elements.namedItem('aiModelOther') as HTMLInputElement).value = current && !known ? current : '';
      $('[data-ai-other]').hidden = ms.value !== '__other';
    }
    function estimate() {
      const form = $<HTMLFormElement>('[data-ai-form]');
      const provider = (form.elements.namedItem('aiProvider') as HTMLSelectElement).value;
      const model = (form.elements.namedItem('aiModelPick') as HTMLSelectElement).value;
      const m = prices.models.find((x) => x.provider === provider && x.model === model);
      const out = $('[data-ai-estimate]');
      if (!m) { out.textContent = 'No estimate for a model that is not on our price list: check its price with the provider. It counts against your limit at a high rate to be safe.'; return; }
      const per = (prices.estimate.feedback_in * m.in + prices.estimate.feedback_out * m.out) / 1e6;
      const students = Math.max(brief.students.filter((s) => s.status === 'active').length, 25);
      const perLesson = per * students * 2;
      out.textContent = `About $${per < 0.01 ? per.toFixed(4) : per.toFixed(3)} per feedback reply. For ${students} students sending two answers per lesson: about $${perLesson.toFixed(2)} per lesson, or $${(perLesson * 8).toFixed(2)} for eight lessons a month. Estimates; your provider's bill is what counts.${m.note ? ` ${m.note}` : ''}`;
    }
    {
      const form = $<HTMLFormElement>('[data-ai-form]');
      (form.elements.namedItem('aiProvider') as HTMLSelectElement).addEventListener('change', () => { fillModels(null); estimate(); });
      (form.elements.namedItem('aiModelPick') as HTMLSelectElement).addEventListener('change', () => { $('[data-ai-other]').hidden = (form.elements.namedItem('aiModelPick') as HTMLSelectElement).value !== '__other'; estimate(); });
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const pick = (form.elements.namedItem('aiModelPick') as HTMLSelectElement).value;
        const model = pick === '__other' ? (form.elements.namedItem('aiModelOther') as HTMLInputElement).value.trim() : pick;
        const mode = form.querySelector<HTMLInputElement>('[name=aiMode]:checked')?.value ?? 'hold';
        const r = await api(`/api/classes/${id}`, {
          aiEnabled: (form.elements.namedItem('aiEnabled') as HTMLInputElement).checked,
          aiProvider: (form.elements.namedItem('aiProvider') as HTMLSelectElement).value,
          aiModel: model, aiMode: mode,
          aiCapCents: Math.round(Number((form.elements.namedItem('aiCap') as HTMLInputElement).value) * 100),
        }, 'PATCH');
        $('[data-ai-msg]').textContent = r.ok ? 'Saved.' : '';
        $('[data-ai-err]').textContent = r.ok ? '' : r.data.error || 'Could not save.';
        if (r.ok) load();
      });
    }

    // ---- assign ----
    const chosen = new Map<string, string | null>();
    let pickCourse = '';
    function renderAssign() {
      chosen.clear();
      for (const a of brief.assignments) chosen.set(a.slug, a.due);
      const sel = $<HTMLSelectElement>('[data-course-pick]');
      if (!sel.options.length) {
        for (const c of catalog) sel.append(el('option', { value: c.slug, textContent: c.title }));
        sel.addEventListener('change', () => { pickCourse = sel.value; drawUnits(); });
      }
      pickCourse = pickCourse || brief.class.course;
      sel.value = pickCourse;
      drawUnits();
    }
    function drawUnits() {
      const c = catalog.find((x) => x.slug === pickCourse) ?? catalog[0];
      const box = $('[data-units]');
      box.textContent = '';
      for (const u of c.units) {
        const div = el('div', { className: 'tc-unit' }, el('h3', { textContent: u.name }));
        for (const l of u.lessons) {
          const row = el('div', { className: 'tc-assign-row' });
          const cb = el('input', { type: 'checkbox', checked: chosen.has(l.slug), id: `as-${l.slug}` });
          const lab = el('label', { htmlFor: `as-${l.slug}`, textContent: `${l.n}. ${l.title}` });
          const due = el('input', { type: 'date', value: chosen.get(l.slug) ?? '', disabled: !chosen.has(l.slug), title: 'Due date (optional)' });
          cb.addEventListener('change', () => { if (cb.checked) chosen.set(l.slug, due.value || null); else chosen.delete(l.slug); due.disabled = !cb.checked; count(); });
          due.addEventListener('change', () => { if (cb.checked) chosen.set(l.slug, due.value || null); });
          row.append(cb, lab, due);
          div.append(row);
        }
        box.append(div);
      }
      count();
    }
    function count() {
      $('[data-assign-count]').textContent = `${chosen.size} ${chosen.size === 1 ? 'lesson' : 'lessons'} assigned`;
      const here = new Set(catalog.find((x) => x.slug === pickCourse)?.units.flatMap((u) => u.lessons.map((l) => l.slug)));
      const other = [...chosen.keys()].filter((s) => !here.has(s));
      $('[data-assigned-elsewhere]').hidden = !other.length;
      $('[data-assigned-elsewhere]').textContent = `Also assigned from other courses: ${other.map((s) => lessonInfo.get(s)?.title ?? s).join(', ')}`;
    }
    $('[data-save-assign]').addEventListener('click', async () => {
      const r = await api(`/api/classes/${id}/assignments`, { assignments: [...chosen].map(([slug, due]) => ({ slug, due })) }, 'PUT');
      $('[data-assign-msg]').textContent = r.ok ? 'Saved.' : r.data.error || 'Could not save.';
      if (r.ok) load();
    });

    // ---- students ----
    function renderRoster() {
      const tb = $('[data-roster]');
      tb.textContent = '';
      $('[data-roster-empty]').hidden = brief.students.length > 0;
      for (const s of brief.students) {
        const tr = el('tr');
        const status = s.status === 'pending' ? el('span', { className: 'tc-pill warn', textContent: 'waiting' }) : el('span', { className: 'tc-pill good', textContent: 'in' });
        const actions = el('td', { className: 'tc-row tc-noprint' });
        if (s.status === 'pending') {
          const ok = el('button', { type: 'button', className: 'tc-btn small', textContent: 'Let in' });
          ok.addEventListener('click', async () => { await api(`/api/classes/${id}/students/${s.id}/approve`, {}); load(); });
          actions.append(ok);
        }
        const code = el('button', { type: 'button', className: 'tc-btn small ghost', textContent: 'New code' });
        code.addEventListener('click', async () => {
          if (!confirm(`Make a new student code for ${s.nickname}? Their old code stops working and they are signed out on their devices.`)) return;
          const r = await api<{ code: string }>(`/api/classes/${id}/students/${s.id}/code`, {});
          if (!r.ok) return;
          const box = $('[data-code-show]');
          box.hidden = false;
          box.textContent = '';
          box.append(`New student code for ${s.nickname}: `, el('span', { className: 'tc-code small', textContent: r.data.code }), ` (they join at ${location.host}/join/ with class code ${brief.class.code}, then "I have a student code").`);
        });
        const rm = el('button', { type: 'button', className: 'tc-btn small danger', textContent: 'Remove' });
        rm.addEventListener('click', async () => {
          if (!confirm(`Remove ${s.nickname} and delete their answers?`)) return;
          await api(`/api/classes/${id}/students/${s.id}`, undefined, 'DELETE');
          load();
        });
        actions.append(code, rm);
        tr.append(el('td', { textContent: s.nickname }), el('td', {}, status), el('td', { textContent: fmtDate(s.joined) }), el('td', { textContent: fmtDate(s.lastSeen) }), actions);
        tb.append(tr);
      }
    }
    $('[data-roster-form]').addEventListener('submit', async (e) => {
      e.preventDefault();
      const names = ((e.target as HTMLFormElement).names.value as string).split('\n').map((s) => s.trim()).filter(Boolean);
      if (!names.length) return;
      const r = await api<{ made: { nickname: string; code: string }[]; skipped: string[] }>(`/api/classes/${id}/roster`, { nicknames: names });
      $('[data-roster-err]').textContent = r.ok ? (r.data.skipped.length ? `Already in the class, skipped: ${r.data.skipped.join(', ')}` : '') : r.data.error || 'Could not add.';
      if (!r.ok) return;
      const rows = $('[data-made-rows]');
      rows.textContent = '';
      for (const m of r.data.made) rows.append(el('tr', {}, el('td', { textContent: m.nickname }), el('td', {}, el('span', { className: 'tc-code small', textContent: m.code }))));
      $('[data-made-how]').textContent = `Students go to ${location.host}/join/, type class code ${brief.class.code}, then choose "I have a student code".`;
      $('[data-made]').hidden = r.data.made.length === 0;
      (e.target as HTMLFormElement).reset();
      load();
    });

    // ---- settings ----
    $('[data-settings]').addEventListener('submit', async (e) => {
      e.preventDefault();
      const f = e.target as HTMLFormElement;
      const v = { ...Object.fromEntries(new FormData(f).entries()), shared: (f.elements.namedItem('shared') as HTMLInputElement).checked };
      const r = await api(`/api/classes/${id}`, v, 'PATCH');
      $('[data-set-msg]').textContent = r.ok ? 'Saved.' : r.data.error || 'Could not save.';
      if (r.ok) load();
    });
    $('[data-new-code]').addEventListener('click', async () => {
      if (!confirm('Make a new class code? The old one stops working for new students.')) return;
      await api(`/api/classes/${id}/new-code`, {});
      load();
    });
    $('[data-delete]').addEventListener('click', async () => {
      if (!confirm('Delete this class, its students and all their answers for good?')) return;
      const r = await api(`/api/classes/${id}`, undefined, 'DELETE');
      if (r.ok) location.href = '/teach/classes/';
    });

    show(new URLSearchParams(location.search).get('tab') || 'brief');
    load();
  </script>
</BaseLayout>
