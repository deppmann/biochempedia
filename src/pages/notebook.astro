---
/* The notebook: every highlight and note this browser holds, grouped by lesson.
   Read from src/lib/notebook.ts; the lesson pages write it (HighlightLayer.astro). */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { courseOf } from '../data/courses';

const lessons = await getCollection('lessons', ({ data }) => !data.draft);
const titles = Object.fromEntries(lessons.map((l) => {
  let course = '';
  try { course = courseOf(l.data.course)?.title ?? ''; } catch { /* unknown course */ }
  return [l.data.slug, { t: l.data.title, c: course }];
}));
---

<BaseLayout
  title="Your notebook — Biochemistrypedia"
  description="Your highlights and notes from the lessons, in one place. Saved in this browser."
>
  <article class="wrap nb" data-titles={JSON.stringify(titles)}>
    <p class="eyebrow">Your notebook</p>
    <h1>Highlights and notes</h1>
    <p class="lede">
      Saved in this browser. <a data-account-link>Sign in to keep them on all your devices.</a>
    </p>

    <noscript><p class="warn">This page needs JavaScript to read your saved highlights and notes.</p></noscript>
    <p class="warn" data-blocked hidden>
      This browser is not letting the site save anything (a private window or strict privacy
      settings), so nothing can be kept here.
    </p>

    <div class="tools" data-tools hidden>
      <label class="search">
        <span>Search</span>
        <input type="search" placeholder="Words in a highlight, note or lesson" data-q />
      </label>
      <label>
        <span>Show</span>
        <select data-color>
          <option value="">Everything</option>
          <option value="yellow">Yellow highlights</option>
          <option value="green">Green highlights</option>
          <option value="blue">Blue highlights</option>
          <option value="note">Notes on a lesson</option>
          <option value="has-note">Anything with a note</option>
        </select>
      </label>
      <label>
        <span>Order</span>
        <select data-sort>
          <option value="new">Newest first</option>
          <option value="lesson">By lesson (A to Z)</option>
        </select>
      </label>
      <button type="button" class="btn-ghost" data-export>Export as Markdown</button>
    </div>

    <p class="count" data-count aria-live="polite"></p>
    <div data-list></div>

    <section class="empty" data-empty hidden>
      <h2>Nothing here yet</h2>
      <p>To highlight a passage, open any lesson and select some text with your mouse or finger.
        A small bar appears. Pick a colour, or choose <strong>Add note</strong> to write a note about that passage.</p>
      <p>Using a keyboard? Turn on caret browsing (F7 in most browsers), select text with Shift and the arrow keys, then press Tab to reach the bar.</p>
      <p>To write a note about a whole lesson, use <strong>Add a note on this lesson</strong> in the
        “Your notes” box at the end of the lesson.</p>
      <p>Everything you save shows up here. <a href="/courses/">Find a lesson →</a></p>
    </section>
    <p class="none" data-none hidden>Nothing matches. Try other words or show everything.</p>
  </article>

  <script>
    import { allItems, upsertItem, deleteItem, loadNotebook, storageWorks, NOTEBOOK_EVENT, NOTEBOOK_KEY, type NotebookItem } from '../lib/notebook';

    const root = document.querySelector<HTMLElement>('.nb')!;
    const titles: Record<string, { t: string; c: string }> = JSON.parse(root.dataset.titles || '{}');
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const list = $<HTMLElement>('[data-list]');
    const q = $<HTMLInputElement>('[data-q]');
    const colorSel = $<HTMLSelectElement>('[data-color]');
    const sortSel = $<HTMLSelectElement>('[data-sort]');
    const countEl = $<HTMLElement>('[data-count]');
    const MISSING_KEY = 'biochempedia:notebook-missing:v1';

    // Set here rather than in the HTML: /account/ comes with the accounts work, and the
    // build's link check would flag it until then. Once /account/ exists, a plain href is fine.
    $<HTMLAnchorElement>('[data-account-link]').href = '/account/';
    if (!storageWorks()) $<HTMLElement>('[data-blocked]').hidden = false;

    function missing(): Record<string, string> {
      try { return JSON.parse(window.localStorage.getItem(MISSING_KEY) || '{}') || {}; } catch { return {}; }
    }
    const lessonTitle = (it: NotebookItem) => titles[it.slug]?.t || it.title || it.slug;
    const day = (t: number) => new Date(t).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' });
    const href = (it: NotebookItem) => `/lessons/${it.slug}/#hl-${it.id}`;

    function el<K extends keyof HTMLElementTagNameMap>(tag: K, cls?: string, text?: string) {
      const e = document.createElement(tag);
      if (cls) e.className = cls;
      if (text !== undefined) e.textContent = text;
      return e;
    }

    let editing: string | null = null;
    let lastDeleted: NotebookItem | null = null;
    let muted = false;

    function filtered(items: NotebookItem[]) {
      const words = q.value.toLowerCase().split(/\s+/).filter(Boolean);
      const c = colorSel.value;
      return items.filter((it) => {
        if (c === 'note' && it.kind !== 'note') return false;
        if (c === 'has-note' && !it.note.trim()) return false;
        if ((c === 'yellow' || c === 'green' || c === 'blue') && (it.kind !== 'highlight' || it.color !== c)) return false;
        if (!words.length) return true;
        const hay = `${it.quote} ${it.note} ${it.section} ${lessonTitle(it)}`.toLowerCase();
        return words.every((w) => hay.includes(w));
      });
    }

    function render() {
      const items = allItems();
      const empty = items.length === 0;
      $<HTMLElement>('[data-empty]').hidden = !empty;
      $<HTMLElement>('[data-tools]').hidden = empty;
      list.replaceChildren();
      countEl.textContent = '';
      if (empty) { $<HTMLElement>('[data-none]').hidden = true; return; }

      const shown = filtered(items);
      $<HTMLElement>('[data-none]').hidden = shown.length > 0;
      const nH = shown.filter((i) => i.kind === 'highlight').length;
      const nN = shown.length - nH;
      countEl.textContent = `${nH} ${nH === 1 ? 'highlight' : 'highlights'} and ${nN} ${nN === 1 ? 'lesson note' : 'lesson notes'}`
        + (shown.length < items.length ? ` (of ${items.length} saved)` : '') + '.';

      const groups = new Map<string, NotebookItem[]>();
      for (const it of shown) {
        if (!groups.has(it.slug)) groups.set(it.slug, []);
        groups.get(it.slug)!.push(it);
      }
      const byLesson = sortSel.value === 'lesson';
      const entries = Array.from(groups.entries());
      for (const [, g] of entries) g.sort((a, b) => (byLesson ? a.created - b.created : b.updated - a.updated));
      entries.sort((a, b) => byLesson
        ? lessonTitle(a[1][0]).localeCompare(lessonTitle(b[1][0]))
        : Math.max(...b[1].map((i) => i.updated)) - Math.max(...a[1].map((i) => i.updated)));

      const miss = missing();
      for (const [slug, g] of entries) {
        const sec = el('section', 'lesson');
        const h = el('h2');
        const a = el('a', undefined, lessonTitle(g[0]));
        a.href = `/lessons/${slug}/`;
        h.append(a);
        sec.append(h);
        if (titles[slug]?.c) sec.append(el('p', 'course', titles[slug].c));
        const ul = el('ul', 'items');
        for (const it of g) ul.append(row(it, !!miss[it.id]));
        sec.append(ul);
        list.append(sec);
      }
    }

    function row(it: NotebookItem, changed: boolean) {
      const li = el('li', `item item-${it.kind === 'note' ? 'note' : it.color}`);
      li.dataset.id = it.id;
      const metaBits = [it.kind === 'note' ? 'Note on the lesson' : (it.section || 'Highlight'), day(it.updated)];
      li.append(el('p', 'meta', metaBits.join(' · ')));
      if (it.kind === 'highlight') {
        const a = el('a', `quote quote-${it.color}`);
        a.href = href(it);
        a.append(el('span', undefined, it.quote));
        a.setAttribute('aria-label', `Go to this passage in the lesson: ${it.quote.slice(0, 100)}`);
        li.append(a);
        if (changed) li.append(el('p', 'changed', 'This passage changed, so the highlight could not be found in the lesson.'));
      }
      if (editing === it.id) {
        const box = el('div', 'edit');
        const lab = el('label', undefined, 'Note');
        const ta = el('textarea');
        ta.rows = 3;
        ta.value = it.note;
        ta.id = `nb-edit-${it.id}`;
        lab.htmlFor = ta.id;
        const save = el('button', 'btn-ghost', 'Save');
        save.type = 'button';
        const cancel = el('button', 'btn-ghost', 'Cancel');
        cancel.type = 'button';
        save.addEventListener('click', () => {
          const text = ta.value.trim();
          if (it.kind === 'note' && !text) { ta.focus(); return; }
          muted = true; upsertItem({ ...it, note: text }); muted = false;
          editing = null; render(); focusRow(it.id, '[data-edit]');
        });
        cancel.addEventListener('click', () => { editing = null; render(); focusRow(it.id, '[data-edit]'); });
        ta.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') { e.preventDefault(); cancel.click(); }
          if (e.key === 'Enter' && (e.metaKey || e.ctrlKey)) { e.preventDefault(); save.click(); }
        });
        const r = el('div', 'actions');
        r.append(save, cancel);
        box.append(lab, ta, r);
        li.append(box);
        window.setTimeout(() => ta.focus(), 0);
      } else {
        if (it.note) li.append(el('p', 'note', it.note));
        const r = el('div', 'actions');
        const go = el('a', 'act', it.kind === 'note' ? 'Open the lesson' : 'Go to passage');
        go.href = href(it);
        const edit = el('button', 'act', it.note ? 'Edit note' : 'Add note');
        edit.type = 'button';
        edit.dataset.edit = '';
        edit.addEventListener('click', () => { editing = it.id; render(); });
        const del = el('button', 'act danger', 'Delete');
        del.type = 'button';
        del.addEventListener('click', () => {
          lastDeleted = it;
          muted = true; deleteItem(it.id); muted = false;
          render();
          showUndo();
        });
        r.append(go, edit, del);
        li.append(r);
      }
      return li;
    }

    function focusRow(id: string, sel: string) {
      list.querySelector<HTMLElement>(`[data-id="${CSS.escape(id)}"] ${sel}`)?.focus();
    }

    function showUndo() {
      const it = lastDeleted;
      if (!it) return;
      const p = el('p', 'undo');
      p.append(document.createTextNode('Deleted. '));
      const b = el('button', 'act', 'Undo');
      b.type = 'button';
      b.addEventListener('click', () => {
        muted = true; upsertItem({ ...it, deleted: false }); muted = false;
        lastDeleted = null; render();
      });
      p.append(b);
      countEl.after(p);
      b.focus();
      window.setTimeout(() => p.remove(), 10000);
    }

    /* ---------- Markdown export ---------- */
    function markdown(): string {
      const items = allItems();
      const groups = new Map<string, NotebookItem[]>();
      for (const it of items) { if (!groups.has(it.slug)) groups.set(it.slug, []); groups.get(it.slug)!.push(it); }
      const origin = window.location.origin;
      const out = [`# My Biochemistrypedia notebook`, '', `Exported ${new Date().toLocaleString()}.`, ''];
      const sorted = Array.from(groups.entries()).sort((a, b) => lessonTitle(a[1][0]).localeCompare(lessonTitle(b[1][0])));
      for (const [slug, g] of sorted) {
        out.push(`## [${lessonTitle(g[0])}](${origin}/lessons/${slug}/)`, '');
        for (const it of g.sort((a, b) => a.created - b.created)) {
          if (it.kind === 'note') {
            out.push(`**Note on the lesson** (${day(it.updated)})`, '', it.note, '');
          } else {
            const where = it.section ? `${it.section}, ` : '';
            out.push(`> ${it.quote.replace(/\n+/g, ' ')}`, '', `*${where}${it.color}, ${day(it.created)}* · [go to passage](${origin}${href(it)})`, '');
            if (it.note) out.push(it.note, '');
          }
        }
      }
      return out.join('\n');
    }
    (window as unknown as { bpNotebookMarkdown: () => string }).bpNotebookMarkdown = markdown;

    $<HTMLButtonElement>('[data-export]').addEventListener('click', () => {
      const blob = new Blob([markdown()], { type: 'text/markdown;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `biochempedia-notebook-${new Date().toISOString().slice(0, 10)}.md`;
      document.body.append(a);
      a.click();
      a.remove();
      window.setTimeout(() => URL.revokeObjectURL(url), 1000);
    });

    q.addEventListener('input', render);
    colorSel.addEventListener('change', render);
    sortSel.addEventListener('change', render);
    window.addEventListener(NOTEBOOK_EVENT, () => { if (!muted && !editing) render(); });
    window.addEventListener('storage', (e) => { if (e.key === NOTEBOOK_KEY && !editing) render(); });
    void loadNotebook;
    render();
  </script>

  <style>
    .nb { padding-block: var(--ddp-space-12); max-width: 820px; }
    .eyebrow { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); letter-spacing: 0.14em; text-transform: uppercase; color: var(--ddp-color-caution); margin: 0 0 var(--ddp-space-2); }
    h1 { font-family: var(--ddp-font-serif); font-weight: 500; color: var(--ddp-color-primary); font-size: var(--ddp-text-3xl); line-height: 1.1; margin: 0; }
    .lede { font-size: var(--ddp-text-lg); line-height: 1.6; color: var(--ddp-color-ink-soft); margin: var(--ddp-space-3) 0 0; }
    .warn { margin: var(--ddp-space-4) 0 0; padding: var(--ddp-space-3) var(--ddp-space-4); border-left: 4px solid var(--ddp-color-caution); background: var(--ddp-color-caution-soft); color: #2d2d2d; border-radius: 6px; }
    .warn[hidden], [hidden] { display: none !important; }

    .tools { display: flex; flex-wrap: wrap; gap: var(--ddp-space-3); align-items: flex-end; margin: var(--ddp-space-8) 0 var(--ddp-space-4); }
    .tools label { display: grid; gap: 0.2rem; font-size: var(--ddp-text-sm); color: var(--ddp-color-muted); }
    .tools .search { flex: 1 1 240px; }
    .tools input, .tools select {
      font: inherit; font-size: 1rem; min-height: 44px; padding: 0.35rem 0.6rem; box-sizing: border-box; width: 100%;
      border: 1.5px solid var(--ddp-color-line); border-radius: 8px; background: var(--ddp-color-surface); color: var(--ddp-color-ink);
    }
    .btn-ghost { display: inline-flex; align-items: center; min-height: 44px; padding: 0.4em 1.1em; font: inherit; font-size: var(--ddp-text-sm); cursor: pointer; border-radius: 999px; border: 1.5px solid var(--ddp-color-line); background: var(--ddp-color-surface); color: var(--ddp-color-ink); }
    .btn-ghost:hover { border-color: var(--ddp-color-accent); }
    .count { color: var(--ddp-color-muted); font-size: var(--ddp-text-sm); margin: 0 0 var(--ddp-space-4); }
    .count:empty { display: none; }
    :global(.undo) { font-size: var(--ddp-text-sm); margin: 0 0 var(--ddp-space-4); }

    :global(.nb .lesson) { margin: 0 0 var(--ddp-space-8); }
    :global(.nb .lesson h2) { font-size: var(--ddp-text-xl); margin: 0; }
    :global(.nb .lesson .course) { margin: 0.1rem 0 0; color: var(--ddp-color-muted); font-size: var(--ddp-text-sm); }
    :global(.nb .items) { list-style: none; margin: var(--ddp-space-3) 0 0; padding: 0; display: grid; gap: var(--ddp-space-3); }
    :global(.nb .item) { padding: var(--ddp-space-3) var(--ddp-space-4); border: 1px solid var(--ddp-color-line); border-left-width: 5px; border-radius: 8px; background: var(--ddp-color-surface); }
    :global(.nb .item-yellow) { border-left-color: #e8c400; }
    :global(.nb .item-green) { border-left-color: #4caf50; }
    :global(.nb .item-blue) { border-left-color: #4a90e2; }
    :global(.nb .item-note) { border-left-color: var(--ddp-color-accent); }
    :global(.nb .meta) { margin: 0 0 0.35rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
    :global(.nb .quote) { display: block; color: var(--ddp-color-ink); text-decoration: none; line-height: 1.55; }
    :global(.nb .quote span) { padding: 0.05em 0.1em; border-radius: 2px; box-decoration-break: clone; -webkit-box-decoration-break: clone; }
    :global(.nb .quote-yellow span) { background: #fff09a; }
    :global(.nb .quote-green span) { background: #c9efc2; }
    :global(.nb .quote-blue span) { background: #cfe3ff; }
    :global(.nb .quote:hover span), :global(.nb .quote:focus-visible span) { text-decoration: underline; }
    :global(.nb .changed) { margin: 0.35rem 0 0; font-size: var(--ddp-text-sm); color: var(--ddp-color-caution); }
    :global(.nb .note) { margin: 0.5rem 0 0; white-space: pre-wrap; }
    :global(.nb .actions) { display: flex; flex-wrap: wrap; gap: 0.35rem 1rem; margin-top: 0.5rem; align-items: center; }
    :global(.nb .act) { font: inherit; font-size: var(--ddp-text-sm); background: none; border: 0; padding: 0.35rem 0; min-height: 36px; color: var(--ddp-color-accent); cursor: pointer; text-decoration: underline; text-underline-offset: 2px; }
    :global(.nb .act.danger) { color: #b3261e; }
    :global(.nb .edit) { display: grid; gap: 0.35rem; margin-top: 0.5rem; }
    :global(.nb .edit label) { font-size: var(--ddp-text-sm); font-weight: 600; }
    :global(.nb .edit textarea) { font: inherit; width: 100%; box-sizing: border-box; padding: 0.45rem; border: 1.5px solid var(--ddp-color-line); border-radius: 8px; background: var(--ddp-color-bg); color: var(--ddp-color-ink); }
    .empty { margin-top: var(--ddp-space-8); padding: var(--ddp-space-4) var(--ddp-space-6); border: 1px dashed var(--ddp-color-line); border-radius: 10px; }
    .empty p { margin: 0 0 0.6rem; }
    .empty h2 { margin-top: 0; font-size: var(--ddp-text-xl); }
    .none { color: var(--ddp-color-muted); }
    @media (prefers-color-scheme: dark) {
      :global(:root:not([data-theme="light"]) .nb .quote-yellow span) { background: rgba(240, 205, 70, 0.38); }
      :global(:root:not([data-theme="light"]) .nb .quote-green span) { background: rgba(110, 200, 110, 0.32); }
      :global(:root:not([data-theme="light"]) .nb .quote-blue span) { background: rgba(100, 160, 255, 0.36); }
      :global(:root:not([data-theme="light"]) .nb .act.danger) { color: #ff8a80; }
    }
  </style>
</BaseLayout>
