    .goal { position: relative; display: flex; flex-direction: column; gap: var(--ddp-space-2); padding: var(--ddp-space-5); background: var(--ddp-color-surface); border: 1px solid var(--ddp-color-line); border-radius: var(--ddp-radius-sm); transition: transform 0.14s ease, border-color 0.14s ease, box-shadow 0.14s ease; }
