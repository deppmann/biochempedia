    .try { display: flex; flex-direction: column; gap: var(--ddp-space-1); height: 100%; box-sizing: border-box; min-height: 44px; padding: var(--ddp-space-4); background: color-mix(in srgb, var(--ddp-color-secondary) 8%, var(--ddp-color-surface)); border: 1px solid var(--ddp-color-line); border-radius: var(--ddp-radius-sm); color: inherit; text-decoration: none; transition: transform 0.14s ease, box-shadow 0.14s ease; }
