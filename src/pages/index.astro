---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import LessonIcon from '../components/LessonIcon.astro';
import { COURSE_ICONS } from '../data/course-icons';
import SiteSearch from '../components/SiteSearch.astro';
import { COURSES, courseHref, unitsFor } from '../data/courses';

/* The homepage is the catalog: one card per course, core courses first and
   electives below. Each course's lessons live on its own page, /courses/<slug>/. */
const allLessons = (await getCollection('lessons')).filter((l) => !l.data.draft);
// An empty homepage must never ship quietly. It happened once in development: a
// stale content cache served lessons parsed before `course` existed, the course
// filter matched nothing, and the page rendered with no chapters and no error.
if (!allLessons.some((l) => l.data.course === 'biochemistry')) {
  throw new Error('Homepage: no biochemistry lessons found. If you just changed src/schema.ts, delete node_modules/.astro/data-store.json and rebuild.');
}

/* A course appears only once it has a published lesson. */
const cards = COURSES.map((c) => {
  const mine = allLessons.filter((l) => l.data.course === c.slug);
  const units = unitsFor(c, mine);
  return {
    c,
    lessons: mine.length,
    units: units.length,
    films: mine.reduce((n, l) => n + (l.data.explainer ? 1 : 0) + l.data.films.length, 0),
    sims: mine.reduce((n, l) => n + l.data.simulations.length, 0),
    questions: mine.reduce((n, l) => n + l.data.practiceQuestions.length + l.data.mcatQuestions.length, 0),
    /* A course's own icon if it has one, else its first lesson's icon. */
    icon: COURSE_ICONS[`course:${c.slug}`] ? `course:${c.slug}` : (units[0]?.entries[0]?.l.data.slug ?? c.slug),
    unitNames: units.map((u) => u.name),
  };
}).filter((k) => k.lessons > 0);
const tiers = [
  { key: 'foundation', title: 'Foundations', note: 'Intro courses for the first two years: biology, chemistry, statistics and physics.' },
  { key: 'core', title: 'Core courses', note: 'The three subjects every biology degree requires. The numbers are a suggested order; each course also stands on its own.' },
  { key: 'elective', title: 'Electives', note: 'One subject taken further, for students who have the core behind them.' },
  { key: 'advanced', title: 'Advanced electives', note: 'Upper-level courses that go all the way to current research.' },
].map((t) => ({ ...t, cards: cards.filter((k) => k.c.tier === t.key) })).filter((t) => t.cards.length > 0);
const plural = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;
---

<BaseLayout
  title="Biochemistrypedia — free biology courses, from molecules to ecosystems"
  description="Free biology courses from molecules to ecosystems. Each lesson pairs a short reading with a film of the experiment behind it, a simulation you can change, and questions with checked answers."
>
  <section class="hero wrap">

    <h1>Biology from molecules to ecosystems. <em>Free, for anyone.</em></h1>

    <div class="goldrule" aria-hidden="true"></div>

    <p class="lede">
      Each lesson pairs a short reading with a film of the experiment behind it,
      a simulation you can change, and questions with checked answers. Start at
      the beginning or wherever you're stuck.
    </p>

    {/* The primary action is the catalog one anchor away; the first course
        on the suggested path and the arcade sit beside it. */}
    <p class="hero-cta">
      <a class="cta" href="#courses">Browse the courses ↓</a>
      <a class="cta-play" href="/play">▶ Play the Metabolism Arcade</a>
      <a class="cta-ghost" href={courseHref('cell-biology')}>Start with Cell Biology →</a>
    </p>
  </section>

  <section class="wrap home-search">
    <SiteSearch label="Search every course" />
  </section>

  {/* `lessons` stays as an anchor here: older links point at /#lessons. */}
  <section class="wrap catalog" id="courses">
    <span id="lessons"></span>
    {tiers.map((t) => (
      <section class="tier" aria-labelledby={`tier-${t.key}`}>
        <h2 class="tier-h" id={`tier-${t.key}`}>{t.title}</h2>
        <p class="tier-note">{t.note}</p>
        <ul class="course-list">
          {t.cards.map((k, i) => (
            <li>
              <a href={courseHref(k.c.slug)} class="course-card">
                <span class="cc-ico"><LessonIcon slug={k.icon} size={56} /></span>
                <span class="cc-body">
                  <span class="cc-kicker">{t.key === 'core' && <span class="cc-step">Step {i + 1} · </span>}{plural(k.units, 'unit', 'units')} · {plural(k.lessons, 'lesson', 'lessons')}{k.c.mcat && <span class="cc-mcat" title="Covers material the MCAT tests">MCAT</span>}</span>
                  <span class="cc-title">{k.c.title}</span>
                  <span class="cc-tag">{k.c.tagline}</span>
                  <span class="cc-units">{k.unitNames.join(' · ')}</span>
                  <span class="cc-meta">
                    {[
                      k.films > 0 && plural(k.films, 'film', 'films'),
                      k.sims > 0 && plural(k.sims, 'simulation', 'simulations'),
                      plural(k.questions, 'question', 'questions'),
                    ].filter(Boolean).map((m, i) => <>{i > 0 && ' · '}<span>{m}</span></>)}
                  </span>
                  <span class="cc-go">Open the course →</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </section>

  {/* The feature register explains the site to someone already sold — it sits
      below the chapters now instead of in front of them. */}
  <section class="wrap register-band">
    <div class="register">
      <div class="chip">
        <span class="chip-ico">
          <svg viewBox="0 0 48 48" width="38" height="38" fill="none" aria-hidden="true">
            <g stroke="currentColor" stroke-width="1.5">
              <ellipse cx="24" cy="24" rx="19" ry="6.5" />
              <ellipse cx="24" cy="24" rx="19" ry="6.5" transform="rotate(60 24 24)" />
              <ellipse cx="24" cy="24" rx="19" ry="6.5" transform="rotate(120 24 24)" />
              <circle cx="24" cy="24" r="4.5" />
            </g>
            <circle cx="24" cy="24" r="2.4" style="fill:var(--ddp-color-secondary)" />
          </svg>
        </span>
        <p class="chip-lab">Real molecules</p>
        <p class="chip-sub">Loaded live from a public database, never drawn by an AI.</p>
      </div>

      <div class="chip">
        <span class="chip-ico">
          <svg viewBox="0 0 48 48" width="38" height="38" fill="none" aria-hidden="true">
            <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M11 38 V11 M11 38 H39" />
              <path d="M11 36 Q24 16 39 14" />
              <path d="M27 26 V31 M24.5 28.7 L27 31 L29.5 28.7" />
            </g>
            <circle cx="27" cy="18.6" r="3.4" stroke="currentColor" stroke-width="1.5" style="fill:var(--ddp-color-bg)" />
          </svg>
        </span>
        <p class="chip-lab">Sliders you move</p>
        <p class="chip-sub">Change one condition and watch the curve respond.</p>
      </div>

      <div class="chip">
        <span class="chip-ico">
          <svg viewBox="0 0 48 48" width="38" height="38" fill="none" aria-hidden="true">
            <g stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
              <path d="M24 9 L37 13 V25 C37 33 31 37 24 40 C17 37 11 33 11 25 V13 Z" stroke-width="1.5" />
              <path d="M18 24 L22.5 28.5 L31 19" stroke-width="2" />
            </g>
          </svg>
        </span>
        <p class="chip-lab">Answers explained</p>
        <p class="chip-sub">Every self-test question shows the answer and explains why.</p>
      </div>

      <div class="chip">
        <span class="chip-ico">
          <svg viewBox="0 0 48 48" width="38" height="38" fill="none" aria-hidden="true">
            <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M24 14 C20 11 14.5 11 9 13 V36 C14.5 34 20 34 24 37" />
              <path d="M24 14 C28 11 33.5 11 39 13 V36 C33.5 34 28 34 24 37" />
              <line x1="24" y1="14" x2="24" y2="37" />
              <line x1="12.5" y1="19.5" x2="20" y2="19.5" />
              <line x1="12.5" y1="23.5" x2="19" y2="23.5" />
              <circle cx="32" cy="22" r="3" />
              <path d="M28.5 30 C28.5 26.4 35.5 26.4 35.5 30" />
            </g>
          </svg>
        </span>
        <p class="chip-lab">Scientist stories</p>
        <p class="chip-sub">The people behind the molecules, from The Molecule Hunters.</p>
      </div>
    </div>
  </section>

  <section class="wrap funbar playbar">
    <a href="/play" class="funbar-link playbar-link">
      <span class="funbar-text">
        <strong>Metabolism Arcade</strong>
        <span>Play the pathways: wire the cell, diagnose a broken enzyme, run the regulators through a fast and a sprint, and drill for the MCAT.</span>
      </span>
      <span class="funbar-arrow" aria-hidden="true">→</span>
    </a>
  </section>

  <section class="wrap funbar">
    <a href="/fun" class="funbar-link">
      <span class="funbar-text">
        <strong>The Fun Stuff</strong>
        <span>Trading cards, memes, songs, and a podcast — made by BIOL 3030 students.</span>
      </span>
      <span class="funbar-arrow" aria-hidden="true">→</span>
    </a>
  </section>

  <style>
    .funbar { padding: 0 var(--ddp-space-6) var(--ddp-space-16); }
    .playbar { padding-bottom: var(--ddp-space-4); }
    .funbar-link {
      display: flex;
      align-items: center;
      gap: var(--ddp-space-4);
      justify-content: space-between;
      padding: var(--ddp-space-6);
      border: 1px solid var(--ddp-color-line);
      border-radius: var(--ddp-radius);
      background: color-mix(in srgb, var(--ddp-color-secondary) 8%, var(--ddp-color-surface));
      text-decoration: none;
      color: inherit;
      transition: transform 0.14s ease, box-shadow 0.14s ease;
    }
    .funbar-link:hover { transform: translateY(-2px); box-shadow: var(--ddp-shadow); text-decoration: none; }
    .funbar-text { display: flex; flex-direction: column; gap: 0.15rem; }
    .funbar-text strong { font-family: var(--ddp-font-serif); font-size: var(--ddp-text-lg); color: var(--ddp-color-primary); }
    .funbar-text span { color: var(--ddp-color-ink-soft); font-size: var(--ddp-text-sm); }
    .funbar-arrow { font-size: 1.5rem; color: var(--ddp-color-secondary); flex: none; }

    /* ---- Hero: a left-aligned editorial column, "quiet authority" ---- */
    .hero {
      padding: var(--ddp-space-16) var(--ddp-space-6) var(--ddp-space-8);
    }
    /* Phone: same content, less air, so "Start with Chapter 1" clears the fold. */
    @media (max-width: 720px) {
      .hero { padding-top: var(--ddp-space-8); }
      .goldrule { margin: var(--ddp-space-4) 0; }
      .hero-cta { margin-top: var(--ddp-space-4); }
    }
    .hero h1 {
      font-family: var(--ddp-font-serif);
      font-weight: 500;
      font-size: var(--ddp-text-3xl);
      line-height: 1.1;
      color: var(--ddp-color-primary);
      max-width: 20ch;
      margin: 0;
    }
    .hero h1 em {
      font-style: italic;
      color: var(--ddp-color-accent);
    }
    .goldrule {
      width: 64px;
      height: 3px;
      background: var(--ddp-color-secondary);
      margin: var(--ddp-space-6) 0;
      transform-origin: left center;
    }
    .lede {
      max-width: 60ch;
      font-size: var(--ddp-text-lg);
      line-height: 1.6;
      color: var(--ddp-color-ink-soft);
      margin: 0;
    }
    .lede em {
      font-style: italic;
      color: var(--ddp-color-ink);
    }
    .hero-cta {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--ddp-space-4);
      margin: var(--ddp-space-6) 0 0;
    }
    .cta {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      padding: 0.55em 1.3em;
      background: var(--ddp-color-primary);
      color: var(--ddp-color-surface);
      font-weight: 700;
      text-decoration: none;
      border-radius: 999px;
      transition: transform 0.14s ease, box-shadow 0.14s ease;
    }
    .cta:hover { transform: translateY(-2px); box-shadow: var(--ddp-shadow); text-decoration: none; color: var(--ddp-color-surface); }
    .cta-ghost {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      color: var(--ddp-color-accent);
      font-weight: 600;
      text-decoration: none;
    }
    .cta-ghost:hover { text-decoration: underline; }
    .cta-play {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      padding: 0.55em 1.3em;
      border-radius: 999px;
      font-weight: 700;
      text-decoration: none;
      color: var(--ddp-color-ink);
      background: color-mix(in srgb, var(--ddp-color-secondary, #e0b452) 28%, var(--ddp-color-surface));
      border: 1.5px solid color-mix(in srgb, var(--ddp-color-secondary, #e0b452) 70%, transparent);
      transition: transform 0.14s ease, box-shadow 0.14s ease;
    }
    .cta-play:hover { transform: translateY(-2px); box-shadow: var(--ddp-shadow); text-decoration: none; }
    .register-band { padding: 0 var(--ddp-space-6) var(--ddp-space-8); }

    /* ---- Feature register: four engraving chips on a single ruled grid.
       gap:1px over a line-colored background paints the hairline dividers, so
       it stays clean when it wraps to 2 / 1 columns. ---- */
    .register {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1px;
      background: var(--ddp-color-line);
      border-top: 1px solid var(--ddp-color-line);
      border-bottom: 1px solid var(--ddp-color-line);
      margin-top: var(--ddp-space-8);
    }
    .chip {
      background: var(--ddp-color-bg);
      padding: var(--ddp-space-6) var(--ddp-space-4);
    }
    .chip-ico {
      display: block;
      line-height: 0;
      color: var(--ddp-color-accent);
    }
    .chip-ico svg {
      transition: transform 0.18s ease, color 0.18s ease;
    }
    .chip:hover .chip-ico {
      color: var(--ddp-color-primary);
    }
    .chip:hover .chip-ico svg {
      transform: rotate(-6deg) scale(1.06);
    }
    .chip-lab {
      font-family: var(--ddp-font-serif);
      font-weight: 600;
      font-size: var(--ddp-text-base);
      color: var(--ddp-color-primary);
      margin: var(--ddp-space-3) 0 var(--ddp-space-1);
    }
    .chip-sub {
      font-size: var(--ddp-text-xs);
      line-height: 1.45;
      color: var(--ddp-color-muted);
      margin: 0;
    }
    @media (max-width: 720px) {
      .register { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 480px) {
      .register { grid-template-columns: 1fr; }
    }

    /* ---- Catalog: one card per course, in two tiers ---- */
    .home-search { padding-block: var(--ddp-space-2) 0; }
    .catalog { padding-bottom: var(--ddp-space-8); scroll-margin-top: var(--ddp-space-4); }
    .tier { margin-top: var(--ddp-space-8); }
    .tier-h {
      display: flex;
      align-items: center;
      gap: var(--ddp-space-3);
      font-family: var(--ddp-font-mono);
      font-size: var(--ddp-text-xs);
      font-weight: 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--ddp-color-muted);
      margin: 0 0 var(--ddp-space-2);
    }
    .tier-h::after { content: ''; flex: 1; height: 1px; background: var(--ddp-color-line); }
    .tier-note { margin: 0 0 var(--ddp-space-4); max-width: 60ch; color: var(--ddp-color-ink-soft); font-size: var(--ddp-text-sm); }
    .course-list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(min(100%, 420px), 1fr));
      gap: var(--ddp-space-4);
    }
    .course-card {
      position: relative;
      overflow: hidden;
      height: 100%;
      box-sizing: border-box;
      display: flex;
      gap: var(--ddp-space-5);
      align-items: flex-start;
      padding: var(--ddp-space-6);
      background: var(--ddp-color-surface);
      border: 1px solid var(--ddp-color-line);
      border-radius: var(--ddp-radius);
      text-decoration: none;
      color: inherit;
      transition: transform 0.14s ease, box-shadow 0.14s ease;
    }
    .course-card::before {
      content: "";
      position: absolute;
      left: 0;
      top: 0;
      bottom: 0;
      width: 3px;
      background: var(--ddp-color-secondary);
      transform: scaleY(0);
      transform-origin: top;
      transition: transform 0.22s ease;
    }
    .cc-step { color: var(--ddp-color-caution); font-weight: 600; }
    .cc-mcat {
      margin-left: var(--ddp-space-2);
      padding: 0.05em 0.5em;
      border: 1px solid var(--ddp-color-line);
      border-radius: 999px;
      color: var(--ddp-color-ink-soft);
      letter-spacing: 0.08em;
    }
    .course-card:hover { transform: translateY(-3px); box-shadow: var(--ddp-shadow); text-decoration: none; }
    .course-card:hover::before { transform: scaleY(1); }
    .cc-ico { flex: none; line-height: 0; margin-top: 2px; }
    .cc-body { display: flex; flex-direction: column; gap: var(--ddp-space-2); min-width: 0; }
    .cc-kicker { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); text-transform: uppercase; letter-spacing: 0.07em; color: var(--ddp-color-accent); }
    .cc-title { font-family: var(--ddp-font-serif); font-weight: 600; font-size: var(--ddp-text-2xl, 1.6rem); line-height: 1.15; color: var(--ddp-color-primary); }
    .cc-tag { color: var(--ddp-color-ink-soft); }
    .cc-units { font-size: var(--ddp-text-sm); line-height: 1.5; color: var(--ddp-color-muted); }
    .cc-meta { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
    .cc-meta span { white-space: nowrap; }
    .cc-go { font-weight: 700; color: var(--ddp-color-accent); margin-top: var(--ddp-space-1); }
    .course-card:hover .cc-go { text-decoration: underline; text-underline-offset: 3px; }
    @media (max-width: 480px) {
      .course-card { flex-direction: column; gap: var(--ddp-space-3); padding: var(--ddp-space-5); }
    }

    /* ---- Entrance: one calm staggered rise; gold rule draws after the
       headline lands. All motion is disabled under reduced-motion. ---- */
    @keyframes riseIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: none; }
    }
    @keyframes drawRule {
      from { transform: scaleX(0); }
      to { transform: scaleX(1); }
    }
    .hero h1,
    .hero .lede,
    .register {
      animation: riseIn 0.5s ease both;
    }
    .hero h1 { animation-delay: 0.05s; }
    .hero .lede { animation-delay: 0.12s; }
    .register { animation-delay: 0.24s; }
    .goldrule { animation: drawRule 0.5s ease 0.1s both; }

    @media (prefers-reduced-motion: reduce) {
      .hero h1,
      .hero .lede,
      .register,
      .goldrule { animation: none !important; }
      .goldrule { transform: none; }
      .chip-ico svg,
      .course-card,
      .course-card::before { transition: none; }
    }
  
</style>
</BaseLayout>
