    .wip-btn-ghost:hover { color: var(--ddp-color-accent); }
    .wip p.wip-sig { margin: 0; font-family: var(--ddp-font-serif); font-style: italic; color: var(--ddp-color-ink); }

    /* ---- Entrance: one calm rise. Disabled under reduced motion. ---- */
    @keyframes riseIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
    @keyframes drawRule { from { transform: scaleX(0); } to { transform: scaleX(1); } }
    .hero h1, .hero .lede { animation: riseIn 0.5s ease both; }
    .hero .lede { animation-delay: 0.1s; }
    .goldrule { animation: drawRule 0.5s ease 0.1s both; }
    @media (prefers-reduced-motion: reduce) {
      .hero h1, .hero .lede, .goldrule { animation: none !important; }
      .door, .bc, .goal, .try, .chip-ico svg { transition: none; }
      .door:hover, .bc:hover, .goal-stretch:hover, .try:hover, .chip:hover .chip-ico svg { transform: none; }
    }
