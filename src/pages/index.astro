---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteSearch from '../components/SiteSearch.astro';
import HomeFilm from '../components/HomeFilm.astro';
import Drifters from '../components/Drifters.astro';
import Sprout from '../components/Sprout.astro';
import { courseHref } from '../data/courses';
import { PATHS } from '../data/paths';
import { STAGES, stageOf } from '../data/stages';
import { courseCards, plural } from '../lib/catalog';
import { feedbackUrl } from '../lib/feedback';
import { getCollection } from 'astro:content';
import { courseOf } from '../data/courses';
import rewritten from '../data/recently-rewritten.json';

/* The homepage is a front door, not the catalog (rearranged 2026-11-08 for user flow: Chris, "people
   have to scroll a bit before they get to the lesson"). Top to bottom: the hero with search and
   "continue"; where are you starting (courses by level); what do you want to do (goals); recently
   rewritten; things to try; one line about the work in progress. The six-level demo and the full
   "built in public" note moved to /about/. The full catalog lives at /courses/. */
const { cards, lessonCount } = await courseCards();
const courseCount = cards.length;

/* The live counter under the hero film. Counted at build time from the content
   collection (the same sums the /courses/ cards show), so it moves with every deploy. */
const sum = (k: 'films' | 'sims' | 'questions') => cards.reduce((n, c) => n + c[k], 0);
const fmt = (n: number) => n.toLocaleString('en-US');
const COUNTS = [
  plural(lessonCount, 'lesson', 'lessons'),
  plural(sum('films'), 'film', 'films'),
  plural(sum('sims'), 'simulation', 'simulations'),
  plural(sum('questions'), 'practice question', 'practice questions'),
].map((t) => t.replace(/^\d+/, (d) => fmt(Number(d))));

/* "Recently rewritten": the last ten lessons through the level-up pass (new text, figures and
   simulation fixes), from src/data/recently-rewritten.json, which scripts/rewritten-shelf.mjs writes
   from the level-up notes. Static: works with JavaScript off. */
const live = new Map((await getCollection('lessons', ({ data }) => !data.draft)).map((l) => [l.data.slug, l.data]));
const MON = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const day = (d: string) => `${MON[Number(d.slice(5, 7)) - 1]} ${Number(d.slice(8, 10))}`;
const rewrittenAll = (rewritten as { slug: string; date: string }[]).filter((r) => live.has(r.slug));
const shelf = rewrittenAll.slice(0, 20).map((r) => {
  const l = live.get(r.slug)!;
  return { slug: r.slug, title: l.title, course: courseOf(l.course).title, date: day(r.date) };
});

/* ---- Films. The files live under /explainers/home/ like every lesson film
   (poster.jpg, explainer.mp4, explainer.vtt) and are served the same way. ---- */
const heroFilm = {
  src: '/explainers/home/sizzle/explainer.mp4',
  captions: '/explainers/home/sizzle/explainer.vtt',
  poster: '/explainers/home/sizzle/poster.jpg',
  title: 'What is here, in about a minute',
  durationSec: 62.10,
};

/* ---- Door 2: stage chooser. Bands come from src/data/stages.ts; each links to
   its course page(s). ---- */
const bands = STAGES.map((s) => ({ ...s, cards: cards.filter((k) => stageOf(k.c) === s.key) })).filter((s) => s.cards.length > 0);

/* ---- Door 3: goals. Each goal points at /paths/<id>/. A missing id fails the
   build instead of shipping a dead card. ---- */
interface Goal { label: string; line: string; links: { text: string; href: string; primary?: boolean }[]; ids: string[] }
const GOALS: Goal[] = [
  { label: 'Get ready for the MCAT', line: 'The biology and biochemistry the exam leans on, with original MCAT-style questions and a review queue.', ids: ['mcat'], links: [{ text: 'See the MCAT path', href: '/paths/mcat/', primary: true }, { text: 'MCAT practice', href: '/mcat/' }] },
  { label: 'Keep up with a class I’m taking', line: 'Grades 7–12, or a college biology class. Find your course and work through it in order.', ids: ['school', 'major'], links: [{ text: 'Grades 7–12', href: '/paths/school/' }, { text: 'College', href: '/paths/major/' }] },
  { label: 'Teach with it', line: 'Free for your classes. Make a class with one link, set the level of help, and see the standards map.', ids: ['teach'], links: [{ text: 'See the teaching path', href: '/paths/teach/', primary: true }, { text: 'Resources for teachers', href: '/teachers/' }] },
  { label: 'Learn for the love of it', line: 'No exam and no set order. Start with whatever you’ve wondered about.', ids: ['curious'], links: [{ text: 'Start wondering', href: '/paths/curious/', primary: true }] },
  { label: 'Reach the edge of research', line: 'Climb to the courses that end at the open questions, with the papers behind them.', ids: ['edge'], links: [{ text: 'Climb to the edge', href: '/paths/edge/', primary: true }] },
];
for (const g of GOALS) for (const id of g.ids) {
  if (!PATHS.some((p) => p.id === id)) throw new Error(`Homepage: goal "${g.label}" points at path "${id}", which is not in src/data/paths.ts.`);
}

const TRY = [
  { title: 'Metabolism Arcade', line: 'Six games from the Biochemistry course: wire the cell, fix a broken enzyme, and drill for the MCAT.', href: '/play' },
  { title: 'MCAT practice', line: 'Passages with data, a diagnostic and topic practice.', href: '/mcat/' },
  { title: 'The methods library', line: 'How scientists find things out.', href: '/methods/' },
  { title: 'The Fun Stuff', line: 'Trading cards, memes, songs and a podcast, made by students in my biochemistry course (BIOL 3030).', href: '/fun' },
];
---

<BaseLayout
  title="Biochemistrypedia — free science, from a first question to current research"
  description="Free lessons, films and simulations, starting with biology. Ages 5 to graduate school. No account needed, no ads."
>
  {/* Hero: what this is, search, and (for a returning visitor) where they left off. On a wide
      screen the film sits beside it; on a phone it is a compact row under it. */}
  <Drifters />
  <div class="wrap top">
    <section class="hero" aria-labelledby="home-h1">
      <h1 id="home-h1">From a first question <em>to current research.</em></h1>
      <div class="goldrule" aria-hidden="true"></div>
      <p class="lede">Free lessons, films and simulations in science, starting with biology. Ages 5 to graduate school. No account needed, no ads.</p>
      <div class="home-search"><SiteSearch label="Search every course" /></div>
      {/* Filled from this device's saved progress (src/lib/progress.ts); stays
          hidden for a first visit, without JavaScript, or when storage is blocked. */}
      <p class="resume" data-resume hidden>
        <span data-resume-text></span>
        <a href="/progress/" class="resume-link">Your progress →</a>
      </p>
      <p class="tally"><span class="tally-row">
        {COUNTS.map((t) => <span class="tally-i">{t}</span>)}<span class="tally-i tally-more">and counting</span>
      </span></p>
      <p class="byline">Made by <a href="/about/">Chris Deppmann</a>, professor of biology at the University of Virginia.</p>
    </section>

    <div class="hero-film">
      <HomeFilm film={heroFilm} id="hero-film" eager>
        <strong>{heroFilm.title}.</strong> From planting a seed at five to questions nobody has answered yet. Captions are available.
      </HomeFilm>
    </div>
  </div>

  {/* Where are you starting: one row per level, its courses as links. `courses` and `lessons`
      stay as anchors: older links point at /#courses and /#lessons. */}
  <section class="wrap stage" id="stage" aria-labelledby="stage-h">
    <span class="anchor" id="courses"></span><span class="anchor" id="lessons"></span>
    <h2 class="sec-h" id="stage-h">Where are you starting?</h2>
    <ul class="bands">
      {bands.map((b) => (
        <li class="band">
          <div class="band-head">
            <h3 class="band-t"><Sprout step={STAGES.findIndex((s) => s.key === b.key)} total={STAGES.length} size={38} />{b.title}</h3>
            <p class="band-d">{b.here}</p>
          </div>
          <ul class="band-courses">
            {b.cards.map((k) => (
              <li>
                <a class="bc" href={courseHref(k.c.slug)}>
                  <span class="bc-t">{k.c.title}</span>
                  <span class="bc-n">{k.lessons}</span>
                </a>
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ul>
    <p class="stage-foot">
      Anyone can start on any rung, and every lesson has a simpler version of its idea.
      <a href="/courses/">All {courseCount} courses in full →</a>
    </p>
  </section>

  {/* What do you want to do: each goal is one chip to its path. */}
  <section class="wrap goals" id="goals" aria-labelledby="goals-h">
    <h2 class="sec-h" id="goals-h">What do you want to do?</h2>
    <ul class="goal-row">
      {GOALS.map((g) => {
        const primary = g.links.find((l) => l.primary);
        const rest = g.links.filter((l) => !l.primary);
        return (
          <li class="goal" title={g.line}>
            {primary ? <a class="goal-main" href={primary.href}>{g.label} →</a> : <span class="goal-main goal-plain">{g.label}:</span>}
            {rest.map((l) => <a class="goal-sub" href={l.href}>{l.text}</a>)}
          </li>
        );
      })}
    </ul>
  </section>

  {shelf.length > 0 && (
    <section class="wrap rewritten" aria-labelledby="rewritten-h">
      <h2 id="rewritten-h" class="sec-h-quiet">Recently rewritten <span>· new text, figures and fixed simulations · {rewrittenAll.length} lessons so far</span></h2>
      <ul class="rewritten-list">
        {shelf.slice(0, 5).map((r) => (
          <li><a href={`/lessons/${r.slug}/`}><span class="rw-t">{r.title}</span> <span class="rw-m">{r.course} · {r.date}</span></a></li>
        ))}
      </ul>
      {shelf.length > 5 && (
        <details class="rw-more">
          <summary>{shelf.length - 5} more</summary>
          <ul class="rewritten-list">
            {shelf.slice(5).map((r) => (
              <li><a href={`/lessons/${r.slug}/`}><span class="rw-t">{r.title}</span> <span class="rw-m">{r.course} · {r.date}</span></a></li>
            ))}
          </ul>
        </details>
      )}
    </section>
  )}

  <section class="wrap tryrow" aria-labelledby="try-h">
    <h2 class="sec-h-quiet" id="try-h">Things to try</h2>
    <ul class="try-grid">
      {TRY.map((t) => (
        <li>
          <a class="try" href={t.href}>
            <span class="try-t">{t.title}</span>
            <span class="try-d">{t.line}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  {/* The full note is on /about/ ("A work in progress"); old /#wip links land here. */}
  <section class="wrap wip-band" id="wip" aria-label="Built in public">
    <p class="wip-line">
      <strong>Built in public.</strong> Lessons still being checked carry an <em>Under review</em> tag, and
      chemistry, physics, math and under-fives aren’t built yet.
      <a href={feedbackUrl()} target="_blank" rel="noopener">Report an error</a> ·
      <a href="/about/">How it’s made and checked →</a>
    </p>
  </section>

  <script>
    import { load, dueNow, onChange } from '../lib/progress';
    import { PATHS } from '../data/paths';

    /* The old homepage had #tier-* anchors. The catalog moved to /courses/, so send
       those hashes to the matching band there. */
    const OLD_TIERS: Record<string, string> = {
      'tier-families': 'stage-ages-5-10',
      'tier-highschool': 'stage-grade-7',
      'tier-foundation': 'stage-starting-college',
      'tier-core': 'stage-college-core',
      'tier-elective': 'stage-college-further',
      'tier-advanced': 'research',
    };
    const oldTier = OLD_TIERS[location.hash.slice(1)];
    if (oldTier) location.replace(`/courses/#${oldTier}`);

    const box = document.querySelector<HTMLElement>('[data-resume]');
    const text = document.querySelector<HTMLElement>('[data-resume-text]');
    onChange(() => {
      if (!box || !text) return;
      const p = load();
      const due = dueNow(p).length;
      const path = PATHS.find((x) => x.id === p.path);
      text.textContent = '';
      if (!p.last && !path && !due) { box.hidden = true; return; }
      box.hidden = false;
      let links = 0;
      const add = (label: string, href: string) => {
        const a = document.createElement('a');
        a.href = href; a.textContent = label;
        if (links++) text.append(' · ');
        text.append(a);
      };
      text.append('Welcome back. ');
      if (p.last) add('Continue your last lesson', `/lessons/${p.last}/`);
      if (due) add(`${due} ${due === 1 ? 'question' : 'questions'} to review`, '/review/');
      if (path) add(`Your path: ${path.label}`, `/paths/${path.id}/`);
    });
  </script>

  <style>
    /* ---- Top: hero text (with search and continue) beside the film ---- */
    .top {
      display: grid;
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      grid-template-areas: "hero film";
      gap: var(--ddp-space-8) var(--ddp-space-12);
      align-items: center;
      padding: var(--ddp-space-10, 2.5rem) var(--ddp-space-6) var(--ddp-space-4);
    }
    .hero { grid-area: hero; }
    .hero-film { grid-area: film; min-width: 0; }
    /* Live counter: quiet on purpose. Mono, small, muted; items wrap whole. */
    .tally { margin: var(--ddp-space-2) 0 0; font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); letter-spacing: 0.03em; line-height: 1.7; color: var(--ddp-color-muted); }
    /* Each item carries its own dot; the row is pulled left by one dot's width and
       clipped, so a dot that starts a wrapped line is hidden. */
    .tally { overflow: hidden; }
    .tally-row { display: flex; flex-wrap: wrap; margin-left: -1.6em; }
    .tally-i { white-space: nowrap; }
    .tally-i::before { content: '·'; display: inline-block; width: 1.6em; text-align: center; opacity: 0.7; }
    .tally-more { font-style: italic; }
    .byline { margin: var(--ddp-space-2) 0 0; font-size: var(--ddp-text-sm); color: var(--ddp-color-muted); }
    /* Recently rewritten: a quiet strip under the totals; wraps on phones. */
    .rewritten { margin-top: var(--ddp-space-6); }
    .rewritten-h { margin: 0 0 var(--ddp-space-2); font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); letter-spacing: 0.06em; text-transform: uppercase; font-weight: 600; color: var(--ddp-color-primary); }
    .rewritten-h span { text-transform: none; letter-spacing: 0.02em; font-weight: 400; color: var(--ddp-color-muted); }
    .rewritten-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr)); gap: var(--ddp-space-2); }
    .rewritten-list a { display: flex; flex-direction: column; gap: 0.1rem; padding: 0.5rem 0.75rem; border: 1px solid var(--ddp-color-line); border-radius: 10px; background: var(--ddp-color-surface); text-decoration: none; height: 100%; }
    .rewritten-list a:hover { border-color: var(--ddp-color-accent); }
    .rw-t { font-size: var(--ddp-text-sm); font-weight: 600; color: var(--ddp-color-ink); line-height: 1.35; }
    .rw-m { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
    @media (max-width: 640px) {
      .rewritten-list { display: block; border-top: 1px solid var(--ddp-color-line); }
      .rewritten-list a { flex-direction: row; justify-content: space-between; align-items: baseline; gap: 0.75rem; padding: 0.45rem 0; border: 0; border-bottom: 1px solid var(--ddp-color-line); border-radius: 0; background: none; }
      .rw-t { font-weight: 500; }
      .rw-m { flex: none; }
    }
    @media (max-width: 900px) {
      .top { grid-template-columns: minmax(0, 1fr); grid-template-areas: "hero" "film"; padding-top: var(--ddp-space-4); gap: var(--ddp-space-3); }
      .home-search { margin-top: var(--ddp-space-4); }
      .stage { padding-top: var(--ddp-space-4); }
    }
    .hero h1 {
      font-family: var(--ddp-font-serif);
      font-weight: 500;
      font-size: var(--ddp-text-3xl);
      line-height: 1.1;
      color: var(--ddp-color-primary);
      max-width: 17ch;
      margin: 0;
    }
    .hero h1 em { font-style: italic; color: var(--ddp-color-accent); }
    .goldrule {
      width: 64px;
      height: 3px;
      background: var(--ddp-color-secondary);
      margin: var(--ddp-space-6) 0;
      transform-origin: left center;
    }
    @media (max-width: 720px) { .goldrule { margin: var(--ddp-space-4) 0; } }
    .lede { max-width: 52ch; font-size: var(--ddp-text-lg); line-height: 1.6; color: var(--ddp-color-ink-soft); margin: 0; }
    .resume { margin: var(--ddp-space-4) 0 0; font-size: var(--ddp-text-sm); color: var(--ddp-color-ink-soft); display: flex; flex-wrap: wrap; gap: var(--ddp-space-3); align-items: baseline; }
    .resume[hidden] { display: none; }
    .resume :global(a) { color: var(--ddp-color-accent); font-weight: 600; }

    .home-search { margin-top: var(--ddp-space-5); max-width: 36rem; }
    .tally { margin-top: var(--ddp-space-3); }

    /* ---- Sections ---- */
    .stage, .goals, .rewritten, .tryrow, .wip-band { padding-inline: var(--ddp-space-6); }
    .stage { padding-top: var(--ddp-space-6); }
    .goals, .rewritten, .tryrow { padding-top: var(--ddp-space-8); }
    .anchor { display: block; height: 0; scroll-margin-top: 5.5rem; }
    #stage, #goals, #wip { scroll-margin-top: 5.5rem; }
    .sec-h { font-family: var(--ddp-font-serif); font-weight: 500; font-size: var(--ddp-text-2xl); line-height: 1.15; color: var(--ddp-color-primary); margin: 0 0 var(--ddp-space-3); }
    .sec-h-quiet { margin: 0 0 var(--ddp-space-2); font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ddp-color-primary); }
    .sec-h-quiet span { text-transform: none; letter-spacing: 0.02em; font-weight: 400; color: var(--ddp-color-muted); }

    /* ---- Where are you starting: one compact row per level ---- */
    .bands { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--ddp-color-line); }
    .band { display: grid; grid-template-columns: minmax(12rem, 0.9fr) minmax(0, 2fr); gap: var(--ddp-space-2) var(--ddp-space-6); padding: var(--ddp-space-3) 0; border-bottom: 1px solid var(--ddp-color-line); align-items: center; }
    .band-t { display: flex; align-items: flex-end; gap: 0.5rem; font-family: var(--ddp-font-serif); font-weight: 600; font-size: var(--ddp-text-lg); line-height: 1.2; color: var(--ddp-color-primary); margin: 0; }
    .band-d { padding-left: calc(27px + 0.5rem); }
    .band-d { margin: 0.15rem 0 0; font-size: var(--ddp-text-xs); line-height: 1.45; color: var(--ddp-color-muted); max-width: 40ch; }
    .band-courses { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--ddp-space-2); }
    .bc { display: inline-flex; align-items: baseline; gap: 0.45em; min-height: 40px; box-sizing: border-box; padding: 0.45rem 0.8rem; background: var(--ddp-color-surface); border: 1px solid var(--ddp-color-line); border-radius: 999px; text-decoration: none; color: inherit; transition: border-color 0.14s ease, box-shadow 0.14s ease, transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1); }
    .bc:hover, .bc:focus-visible { border-color: var(--ddp-color-accent); box-shadow: var(--ddp-shadow); text-decoration: none; transform: translateY(-2px) rotate(-1.2deg); }
    .band-courses li:nth-child(even) .bc:hover, .band-courses li:nth-child(even) .bc:focus-visible { transform: translateY(-2px) rotate(1.2deg); }
    .bc-t { font-weight: 700; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); line-height: 1.25; }
    .bc-n { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
    @media (max-width: 720px) {
      .band { display: flex; flex-wrap: wrap; align-items: center; gap: var(--ddp-space-2) var(--ddp-space-3); padding: var(--ddp-space-2) 0; }
      .band-head { flex: 0 1 auto; }
      .band-d { display: none; }
      .band-t { font-size: var(--ddp-text-base); }
    }
    .stage-foot { margin: var(--ddp-space-3) 0 0; font-size: var(--ddp-text-sm); color: var(--ddp-color-ink-soft); }
    .stage-foot a { color: var(--ddp-color-accent); font-weight: 600; }

    /* ---- Goals: one row of chips ---- */
    .goal-row { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--ddp-space-2); }
    .goal { display: inline-flex; flex-wrap: wrap; align-items: center; gap: 0.2rem 0.7rem; padding: 0.35rem 0.9rem; min-height: 44px; box-sizing: border-box; background: var(--ddp-color-surface); border: 1px solid var(--ddp-color-line); border-radius: 999px; }
    .goal:hover { border-color: var(--ddp-color-accent); }
    .goal-main { font-family: var(--ddp-font-serif); font-weight: 600; color: var(--ddp-color-primary); text-decoration: none; }
    .goal-main:hover { text-decoration: underline; }
    .goal-plain { color: var(--ddp-color-ink); }
    .goal-sub { font-size: var(--ddp-text-sm); font-weight: 600; color: var(--ddp-color-accent); }

    /* ---- Recently rewritten ---- */
    .rewritten-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr)); gap: var(--ddp-space-2); }
    .rewritten-list a { display: flex; flex-direction: column; gap: 0.1rem; padding: 0.5rem 0.75rem; border: 1px solid var(--ddp-color-line); border-radius: 10px; background: var(--ddp-color-surface); text-decoration: none; height: 100%; box-sizing: border-box; }
    .rewritten-list a:hover { border-color: var(--ddp-color-accent); }
    .rw-t { font-size: var(--ddp-text-sm); font-weight: 600; color: var(--ddp-color-ink); line-height: 1.35; }
    .rw-m { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
    .rw-more { margin-top: var(--ddp-space-2); }
    .rw-more > summary { cursor: pointer; font-size: var(--ddp-text-sm); font-weight: 600; color: var(--ddp-color-accent); padding: 0.3rem 0; }
    .rw-more[open] > summary { margin-bottom: var(--ddp-space-2); }
    @media (max-width: 640px) {
      .rewritten-list { display: block; border-top: 1px solid var(--ddp-color-line); }
      .rewritten-list a { flex-direction: row; justify-content: space-between; align-items: baseline; gap: 0.75rem; padding: 0.45rem 0; border: 0; border-bottom: 1px solid var(--ddp-color-line); border-radius: 0; background: none; }
      .rw-t { font-weight: 500; }
