---
/* The STEMhop front door: three doors under one hero (2026-11-20).

   Chris asked for less redundancy ("we have the same paths in too many places") and for Students /
   Parents / Teachers tabs, "each with its own story". So the hero is the same for everyone (the
   wordmark, the tagline, what this is, search, and "Welcome back"), and one choice
   under it re-forms the rest of the page for that reader. Students is the page a first visit sees;
   nothing asks. Each door opens with something usable: an idea at every level it is taught, one
   activity with what to gather, the standards maps.

   The choice is three native radios, so it works with JavaScript off (the stylesheet switches
   doors), takes arrow keys, and reads as "1 of 3" to a screen reader. Each door has an address
   (/#students, /#parents, /#teachers; /?role=parent also works with JavaScript on). The visitor's
   own choice is kept on the device (src/lib/prefs.ts); a link never sets it.

   Kept from version A1 (Chris, 2026-11-15): the hero, one open row per level with a first-lesson
   link, no hero film. Old links to /#stage, /#courses, /#lessons and /#goals open the students'
   door; /#wip lands under every door; /#tier-* still redirects to the catalog. Every number and
   lesson name is counted or read from the data (src/components/home/data.ts), never typed. */
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteSearch from '../components/SiteSearch.astro';
import Wordmark from '../components/Wordmark.astro';
import Hex from '../components/Hex.astro';
import StudentsDoor from '../components/home/StudentsDoor.astro';
import ParentsDoor from '../components/home/ParentsDoor.astro';
import TeachersDoor from '../components/home/TeachersDoor.astro';
import { fmt, homeData } from '../components/home/data';
import { COMING_SUBJECTS } from '../data/subjects';
import { feedbackUrl } from '../lib/feedback';
import '../components/home/home.css';

const d = await homeData();
/* The Biology tile's numbers: facts about the library, counted here and shown once on the page. */
const STATS = [
  [d.lessonCount, d.lessonCount === 1 ? 'lesson' : 'lessons'],
  [d.courseCount, d.courseCount === 1 ? 'course' : 'courses'],
  [d.films, 'short films'],
  [d.sims, 'simulations'],
  [d.questions, 'practice questions'],
] as const;
/* Things to try: the playful corners of the site (kept from the page before this one). */
const TRY = [
  { title: 'Metabolism Arcade', line: 'Six games from the Biochemistry course: wire the cell, fix a broken enzyme, and drill for the MCAT.', href: '/play/' },
  { title: 'The methods library', line: 'How scientists find things out.', href: '/methods/' },
  { title: 'The Fun Stuff', line: 'Trading cards, memes, songs and a podcast, made by students in my biochemistry course (BIOL 3030).', href: '/fun/' },
];
---

<BaseLayout
  title="STEMhop — STEM, one short lesson at a time"
  description="Free biology lessons, films and simulations, from age 5 to graduate school, with more sciences on the way. No account needed, no ads."
>
  <div class="wrap home">
    {/* The hero, the same for every reader. */}
    <section class="home-hero" aria-labelledby="home-h1">
      <div class="home-mark">
        <h1 id="home-h1" class="home-wm"><Wordmark hop size="min(clamp(2.5rem, 1.4rem + 5vw, 5.4rem), 17vw)" /></h1>
        <p class="home-tagline">STEM, one short lesson at a time.</p>
      </div>
      <div class="home-side">
        <p class="home-lede">
          <strong>Free</strong> biology lessons, films and simulations, from age 5 to graduate school, with more
          sciences on the way. No account, no ads.
        </p>
        <div class="home-search"><SiteSearch label="Search every lesson" placeholder="Search: try “osmosis” or “vaccines”" /></div>
        {/* Filled from this device's own records; hidden on a first visit, without JavaScript, or
            when storage is blocked. */}
        <p class="home-resume" data-resume hidden>
          <span data-resume-text></span>
          <a href="/progress/">Your progress →</a>
        </p>
      </div>
    </section>

    {/* The one choice on the page. Student is checked when nothing is known; nothing asks. */}
    <fieldset class="home-roles">
      <legend>I’m a</legend>
      <div class="home-role-row">
        <label class="home-role"><input type="radio" name="home-role" id="home-role-student" value="student" checked /><span>Student</span></label>
        <label class="home-role"><input type="radio" name="home-role" id="home-role-parent" value="parent" /><span>Parent</span></label>
        <label class="home-role"><input type="radio" name="home-role" id="home-role-teacher" value="teacher" /><span>Teacher</span></label>
      </div>
      <p class="home-said" role="status"><span class="visually-hidden" data-home-said></span><span aria-hidden="true" data-home-kept hidden>Saved on this device.</span></p>
    </fieldset>
    {/* Runs before the doors are drawn, so a returning parent never sees the students' door flash by.
        A door's own address wins, then an old link to an anchor inside the students' door, then
        ?role=, then the choice kept on this device (the same order as in home/client.ts). */}
    <script is:inline>
      (function () {
        var ROLES = ['student', 'parent', 'teacher'], DOOR = { students: 'student', parents: 'parent', teachers: 'teacher' };
        var h = location.hash.slice(1), role = DOOR[h] || null;
        if (!role && ['stage', 'courses', 'lessons', 'goals'].indexOf(h) >= 0) role = 'student';
        if (!role) { try { var q = new URLSearchParams(location.search).get('role'); if (ROLES.indexOf(q) >= 0) role = q; } catch (e) {} }
        if (!role) { try { var p = JSON.parse(localStorage.getItem('stemhop:prefs:v1') || '{}'); if (p && ROLES.indexOf(p.role) >= 0) role = p.role; } catch (e) {} }
        var el = role && document.getElementById('home-role-' + role);
        if (el) el.checked = true;
        document.documentElement.setAttribute('data-home-js', '');
      })();
    </script>

    <StudentsDoor d={d} />
    <ParentsDoor d={d} />
    <TeachersDoor d={d} />

    {/* Under every door: pick a subject. Biology is open, with its counted numbers (the one place on
        the page that counts, and what it counts is the library, never the reader). The coming
        subjects are named and marked "Coming", never links; on a phone they fold into one row.
        Hex leaps from Biology toward them: drawn still, like the arc in the wordmark. */}
    <section class="home-subjects" aria-labelledby="home-subj-h">
      <h2 class="home-sec-h" id="home-subj-h">Pick a subject</h2>
      <div class="home-subj-grid">
        <div class="home-leap" aria-hidden="true">
          <svg class="home-arc" viewBox="0 0 200 60" preserveAspectRatio="none"><path class="hop-arc" vector-effect="non-scaling-stroke" d="M4 58 Q100 -22 196 58" /></svg>
          <Hex pose="cheer" size={61} class="home-leap-hex" />
        </div>
        <div class="home-bio">
          <div class="home-bio-top"><h3>Biology</h3><span class="home-pill-live">Open now</span></div>
          <ul class="home-stats">
            {STATS.map(([n, label]) => <li><b>{fmt(n)}</b><span>{label}</span></li>)}
          </ul>
          <a class="home-go home-go-arc" href="/courses/">Start with biology <svg viewBox="0 0 26 12" aria-hidden="true"><path class="hop-arc" d="M1 11 Q13 -4 25 11" /></svg></a>
        </div>
        {COMING_SUBJECTS.map((s) => (
          <div class="home-soon">
            <div class="home-soon-top"><h3>{s.name}</h3><span class="home-pill-soon">Coming</span></div>
            <p>{s.note}{s.link && <>{' '}{s.link.before}<a href={s.link.href}>{s.link.text}</a>{s.link.after}</>}</p>
          </div>
        ))}
      </div>
      <p class="home-soon-row"><span class="home-soon-lbl">Coming</span>{COMING_SUBJECTS.map((s) => <span class="home-sc">{s.name}</span>)}</p>
    </section>

    <section class="home-try-sec" aria-labelledby="home-try-h">
      <h2 class="home-sec-h" id="home-try-h">Things to try</h2>
      <ul class="home-try">
        {TRY.map((t) => <li><a href={t.href}><b>{t.title}</b><span>{t.line}</span></a></li>)}
      </ul>
    </section>

    {/* The full note is on /about/ ("A work in progress"); old /#wip links land here. */}
    <section class="home-wip" id="wip" aria-label="Built in public">
      <p>
        <strong>Built in public.</strong> I choose what goes in and direct the AI that makes it. AI models from more
        than one company check the lessons; a person has not yet read every one, and those waiting for my check
        carry an <a href="/under-review/">Under review</a> tag.
        <a href={feedbackUrl()} target="_blank" rel="noopener">See something wrong? Tell me</a> ·
        <a href="/about/#work-in-progress">How it’s made and checked</a> ·
        <a href="/updates/">What’s new, including {fmt(d.rewrittenCount)} rewritten lessons</a> ·
        <a href="/contributors/">Who made it</a>
      </p>
    </section>
  </div>

  <script>
    import '../components/home/client';
  </script>
</BaseLayout>
