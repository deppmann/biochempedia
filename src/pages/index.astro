---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteSearch from '../components/SiteSearch.astro';
import HomeFilm from '../components/HomeFilm.astro';
import { courseHref } from '../data/courses';
import { PATHS } from '../data/paths';
import { STAGES, stageOf } from '../data/stages';
import { courseCards, plural } from '../lib/catalog';
import { feedbackUrl } from '../lib/feedback';

/* The homepage is a front door, not the catalog. It offers three ways in (see
   everything, my age or stage, what I want to do), two films, and a compact course
   chooser. The full catalog lives at /courses/. */
const { cards, lessonCount } = await courseCards();
const courseCount = cards.length;

/* The live counter under the hero film. Counted at build time from the content
   collection (the same sums the /courses/ cards show), so it moves with every deploy. */
const sum = (k: 'films' | 'sims' | 'questions') => cards.reduce((n, c) => n + c[k], 0);
const fmt = (n: number) => n.toLocaleString('en-US');
const COUNTS = [
  plural(lessonCount, 'lesson', 'lessons'),
  plural(sum('films'), 'film', 'films'),
  plural(sum('sims'), 'simulation', 'simulations'),
  plural(sum('questions'), 'practice question', 'practice questions'),
].map((t) => t.replace(/^\d+/, (d) => fmt(Number(d))));

/* ---- Films. The files live under /explainers/home/ like every lesson film
   (poster.jpg, explainer.mp4, explainer.vtt) and are served the same way. ---- */
const FILMS = {
  ladder: {
    src: '/explainers/home/one-idea/explainer.mp4',
    captions: '/explainers/home/one-idea/explainer.vtt',
    poster: '/explainers/home/one-idea/poster.jpg',
    title: 'One idea, six levels',
    durationSec: 54.57,
  },
  /* The homepage film v2 (2026-10-30): new script, no counts or fact-checking claims.
     HELD until the Gemini narration replaces the draft voice: one command,
     ~/biochempedia-qa/2026-10-30/sizzle-v2-src/make.sh gemini, installs the files below and
     sets durationSec. Then point HERO at it. See HANDOFF_SPLASH.md. */
  sizzle: {
    src: '/explainers/home/sizzle/explainer.mp4',
    captions: '/explainers/home/sizzle/explainer.vtt',
    poster: '/explainers/home/sizzle/poster.jpg',
    title: 'What is here, in about a minute',
    durationSec: 62.10,
  },
};
const HERO = 'sizzle' as keyof typeof FILMS;
const heroFilm = FILMS[HERO];
/* While the ladder film is the hero it plays at the top, so the "one idea" band
   shows the same six levels as text and points back up. Once the hero is the
   re-voiced sizzle, the band plays the ladder film itself. */
const bandPlaysFilm = HERO !== 'ladder';

const LEVELS = [
  { who: 'A small child', line: 'Plants need sun and water to grow.' },
  { who: 'Elementary school', line: 'Plants make their own food from sunlight.' },
  { who: 'Middle school', line: 'Leaves use light to turn carbon dioxide and water into sugar, and give off oxygen.' },
  { who: 'High school', line: 'In chloroplasts, photosynthesis stores light energy as chemical energy in glucose.' },
  { who: 'College', line: 'The light reactions make ATP and NADPH, and the Calvin cycle uses them to turn carbon dioxide into sugar.' },
  { who: 'A research lab', line: 'Why does Rubisco so often grab oxygen by mistake?' },
];

/* ---- Door 2: stage chooser. Bands come from src/data/stages.ts; each links to
   its course page(s). ---- */
const bands = STAGES.map((s) => ({ ...s, cards: cards.filter((k) => stageOf(k.c) === s.key) })).filter((s) => s.cards.length > 0);

/* ---- Door 3: goals. Each goal points at /paths/<id>/. A missing id fails the
   build instead of shipping a dead card. ---- */
interface Goal { label: string; line: string; links: { text: string; href: string; primary?: boolean }[]; ids: string[] }
const GOALS: Goal[] = [
  { label: 'Get ready for the MCAT', line: 'The biology and biochemistry the exam leans on, with original MCAT-style questions and a review queue.', ids: ['mcat'], links: [{ text: 'See the MCAT path', href: '/paths/mcat/', primary: true }, { text: 'MCAT practice', href: '/mcat/' }] },
  { label: 'Keep up with a class I’m taking', line: 'Grades 7–12, or a college biology class. Find your course and work through it in order.', ids: ['school', 'major'], links: [{ text: 'Grades 7–12', href: '/paths/school/' }, { text: 'College', href: '/paths/major/' }] },
  { label: 'Teach with it', line: 'Free for your classes. Make a class with one link, set the level of help, and see the standards map.', ids: ['teach'], links: [{ text: 'See the teaching path', href: '/paths/teach/', primary: true }, { text: 'Resources for teachers', href: '/teachers/' }] },
  { label: 'Learn for the love of it', line: 'No exam and no set order. Start with whatever you’ve wondered about.', ids: ['curious'], links: [{ text: 'Start wondering', href: '/paths/curious/', primary: true }] },
  { label: 'Reach the edge of research', line: 'Climb to the courses that end at the open questions, with the papers behind them.', ids: ['edge'], links: [{ text: 'Climb to the edge', href: '/paths/edge/', primary: true }] },
];
/* Five cards in a three-column grid leave a hole. The last row's cards get wider
   so it fills: two left over span half the row each, one left over spans it all. */
const goalTail = GOALS.length % 3;
for (const g of GOALS) for (const id of g.ids) {
  if (!PATHS.some((p) => p.id === id)) throw new Error(`Homepage: goal "${g.label}" points at path "${id}", which is not in src/data/paths.ts.`);
}

const TRY = [
  { title: 'Metabolism Arcade', line: 'Six games from the Biochemistry course: wire the cell, fix a broken enzyme, and drill for the MCAT.', href: '/play' },
  { title: 'MCAT practice', line: 'Passages with data, a diagnostic and topic practice.', href: '/mcat/' },
  { title: 'The methods library', line: 'How scientists find things out.', href: '/methods/' },
  { title: 'The Fun Stuff', line: 'Trading cards, memes, songs and a podcast, made by students in my biochemistry course (BIOL 3030).', href: '/fun' },
];
---

<BaseLayout
  title="Biochemistrypedia — free science, from a first question to current research"
  description="Free lessons, films and simulations, starting with biology. Ages 5 to graduate school. No account, no ads."
>
  {/* One grid, three children. On a phone the order is text, doors, film, so a
      first-time visitor sees an action before the film. On a wide screen the film
      sits beside the text and the doors run underneath. */}
  <div class="wrap top">
    <section class="hero" aria-labelledby="home-h1">
      <h1 id="home-h1">Start where you are. <em>Climb as far as anyone knows.</em></h1>
      <div class="goldrule" aria-hidden="true"></div>
      <p class="lede">Free lessons, films and simulations in science, starting with biology. Ages 5 to graduate school. No account, no ads.</p>

      {/* Filled from this device's saved progress (src/lib/progress.ts); stays
          hidden for a first visit, without JavaScript, or when storage is blocked. */}
      <p class="resume" data-resume hidden>
        <span data-resume-text></span>
        <a href="/progress/" class="resume-link">Your progress →</a>
      </p>
    </section>

    <nav class="doors" aria-label="Three ways in">
      <a class="door" href="/courses/">
        <span class="door-t">See everything</span>
        <span class="door-d">All {courseCount} courses and {lessonCount} lessons, in order from first steps to research.</span>
        <span class="door-go" aria-hidden="true">→</span>
      </a>
      <a class="door" href="#stage">
        <span class="door-t">My age or stage</span>
        <span class="door-d">Tell me where you are, and I’ll show you where to start.</span>
        <span class="door-go" aria-hidden="true">↓</span>
      </a>
      <a class="door" href="#goals">
        <span class="door-t">What I want to do</span>
        <span class="door-d">The MCAT, a class, teaching, or just curiosity. Pick a goal and get an order to follow.</span>
        <span class="door-go" aria-hidden="true">↓</span>
      </a>
    </nav>

    <div class="hero-film">
      <HomeFilm film={heroFilm} id="hero-film" eager>
        <strong>{heroFilm.title}.</strong>
        {HERO === 'ladder'
          ? ' Photosynthesis, from a small child’s version to a question researchers are still working on. Captions are on.'
          : ' From planting a seed at five to questions nobody has answered yet, in about a minute. Captions are on.'}
      </HomeFilm>
      <p class="tally"><span class="tally-row">
        {COUNTS.map((t) => <span class="tally-i">{t}</span>)}<span class="tally-i tally-more">and counting</span>
      </span></p>
    </div>
  </div>

  <section class="wrap home-search">
    <SiteSearch label="Search every course" />
  </section>

  {/* The ladder film's idea, and the three things that hold for every lesson. */}
  <section class="wrap ladder" aria-labelledby="ladder-h">
    <h2 class="sec-h" id="ladder-h">{bandPlaysFilm ? 'One idea, six levels.' : 'Every lesson works like this.'}</h2>
    <p class="sec-lede">
      {bandPlaysFilm
        ? 'Here is photosynthesis, from a small child’s version to a question researchers are still working on. '
        : 'The film’s photosynthesis, written out. '}
      Every lesson explains its idea at more than one level, so you can step down when you need to and
      up when you’re ready.
    </p>
    {bandPlaysFilm
      ? <div class="ladder-film"><HomeFilm film={FILMS.ladder}>A small child, elementary school, middle school, high school, college, research lab. The idea stays the same.</HomeFilm></div>
      : <p class="ladder-watch"><a href="#hero-film">▶ Watch the film above</a></p>}
    <ol class="levels">
      {LEVELS.map((l, i) => (
        <li class="level" style={`--n:${i}`}>
          <span class="level-n" aria-hidden="true">{i + 1}</span>
          <span class="level-body"><span class="level-who">{l.who}</span><span class="level-line">{l.line}</span></span>
        </li>
      ))}
    </ol>

    <div class="register">
      <div class="chip">
        <span class="chip-ico">
          <svg viewBox="0 0 48 48" width="38" height="38" fill="none" aria-hidden="true">
            <g stroke="currentColor" stroke-width="1.5" stroke-linejoin="round">
              <rect x="9" y="30" width="6" height="9" /><rect x="17.5" y="24" width="6" height="15" /><rect x="26" y="18" width="6" height="21" /><rect x="34.5" y="11" width="6" height="28" />
            </g>
            <rect x="34.5" y="11" width="6" height="28" style="fill:var(--ddp-color-secondary)" fill-opacity="0.55" />
          </svg>
        </span>
        <p class="chip-lab">Every level</p>
        <p class="chip-sub">Every lesson explains its idea at more than one level. Most run from a child’s version up to a graduate student’s.</p>
      </div>
      <div class="chip">
        <span class="chip-ico">
          <svg viewBox="0 0 48 48" width="38" height="38" fill="none" aria-hidden="true">
            <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="7" y="11" width="34" height="22" rx="3" />
              <path d="M21 17.5 L29 22 L21 26.5 Z" />
              <path d="M12 39 H36" /><circle cx="26" cy="39" r="2.4" style="fill:var(--ddp-color-bg)" />
            </g>
          </svg>
        </span>
        <p class="chip-lab">Films and simulations</p>
        <p class="chip-sub">Nearly every lesson has a short film, and most have a simulation you can change.</p>
      </div>
      <div class="chip">
        <span class="chip-ico">
          <svg viewBox="0 0 48 48" width="38" height="38" fill="none" aria-hidden="true">
            <g stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
              <path d="M24 9 L37 13 V25 C37 33 31 37 24 40 C17 37 11 33 11 25 V13 Z" stroke-width="1.5" />
              <path d="M18 24 L22.5 28.5 L31 19" stroke-width="2" />
            </g>
          </svg>
        </span>
        <p class="chip-lab">Answers explained</p>
        <p class="chip-sub">Every practice question shows the answer and why.</p>
      </div>
    </div>
  </section>

  {/* Door 2. `courses` and `lessons` stay as anchors here: older links point at
      /#courses and /#lessons and should still land on a course list. */}
  <section class="wrap stage" id="stage" aria-labelledby="stage-h">
    <span class="anchor" id="courses"></span><span class="anchor" id="lessons"></span>
    <h2 class="sec-h" id="stage-h">Where are you starting?</h2>
    <p class="sec-lede">
      Pick the line closest to you. Anyone can start on any rung. If a lesson moves too fast, every
      one has a simpler version of its idea.
    </p>
    <ul class="bands">
      {bands.map((b) => (
        <li class="band">
          <div class="band-head">
            <h3 class="band-t">{b.title}</h3>
            <p class="band-d">{b.here}</p>
          </div>
          <ul class="band-courses">
            {b.cards.map((k) => (
              <li>
                <a class="bc" href={courseHref(k.c.slug)}>
                  <span class="bc-t">{k.c.title}</span>
                  <span class="bc-n">{k.c.tier === 'families' ? plural(k.lessons, 'activity', 'activities') : plural(k.lessons, 'lesson', 'lessons')}</span>
                </a>
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ul>
    <p class="stage-foot">
      Under five, or ready for chemistry, physics or math? Those rungs aren’t built yet.
      <a href="#wip">See what’s coming →</a>
      <span class="stage-all"><a href="/courses/">See every course in full →</a></span>
    </p>
  </section>

  {/* Door 3. */}
  <section class="wrap goals" id="goals" aria-labelledby="goals-h">
    <h2 class="sec-h" id="goals-h">What do you want to do?</h2>
    <p class="sec-lede">
      Each goal puts the free courses in an order that suits it. Your choice is saved on this device
      only, and you can change it any time.
    </p>
    <ul class={`goal-grid${goalTail === 2 ? ' tail-2' : goalTail === 1 ? ' tail-1' : ''}`}>
      {GOALS.map((g) => (
        <li class={`goal${g.links.some((l) => l.primary) ? ' goal-stretch' : ''}`}>
          <h3 class="goal-t">
            {g.links.find((l) => l.primary) ? <a href={g.links.find((l) => l.primary)!.href}>{g.label}</a> : g.label}
          </h3>
          <p class="goal-d">{g.line}</p>
          <p class="goal-links">
            {g.links.map((l) => (l.primary
              ? <span class="goal-go" aria-hidden="true">{l.text} →</span>
              : <a href={l.href}>{l.text} →</a>))}
          </p>
        </li>
      ))}
    </ul>
  </section>

  <section class="wrap tryrow" aria-labelledby="try-h">
    <h2 class="sec-h sec-h-quiet" id="try-h">Things to try</h2>
    <ul class="try-grid">
      {TRY.map((t) => (
        <li>
          <a class="try" href={t.href}>
            <span class="try-t">{t.title}</span>
            <span class="try-d">{t.line}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="wrap wip-band" id="wip" aria-labelledby="wip-h">
    <div class="wip">
      <h2 class="wip-h" id="wip-h">Work in progress, built in public.</h2>
      <p>
        I put this up rough on purpose, and I fix it in the open. Lessons still being checked carry an
        <em>Under review</em> tag. Chemistry, physics, math and anything for under-fives aren’t built yet.
        If you find an error, tell me and I’ll fix it.
      </p>
      <p class="wip-links">
        <a class="wip-btn" href={feedbackUrl()} target="_blank" rel="noopener">Report an error →</a>
        <a class="wip-btn wip-btn-ghost" href="/about/">How it’s made and checked →</a>
      </p>
      <p class="wip-sig">Chris Deppmann</p>
    </div>
  </section>

  <script>
    import { load, dueNow, onChange } from '../lib/progress';
    import { PATHS } from '../data/paths';

    /* The old homepage had #tier-* anchors. The catalog moved to /courses/, so send
       those hashes to the matching band there. */
    const OLD_TIERS: Record<string, string> = {
      'tier-families': 'stage-ages-5-10',
      'tier-highschool': 'stage-grade-7',
      'tier-foundation': 'stage-starting-college',
      'tier-core': 'stage-college-core',
      'tier-elective': 'stage-college-further',
      'tier-advanced': 'research',
    };
    const oldTier = OLD_TIERS[location.hash.slice(1)];
    if (oldTier) location.replace(`/courses/#${oldTier}`);

    const box = document.querySelector<HTMLElement>('[data-resume]');
    const text = document.querySelector<HTMLElement>('[data-resume-text]');
    onChange(() => {
      if (!box || !text) return;
      const p = load();
      const due = dueNow(p).length;
      const path = PATHS.find((x) => x.id === p.path);
      text.textContent = '';
      if (!p.last && !path && !due) { box.hidden = true; return; }
      box.hidden = false;
      let links = 0;
      const add = (label: string, href: string) => {
        const a = document.createElement('a');
        a.href = href; a.textContent = label;
        if (links++) text.append(' · ');
        text.append(a);
      };
      text.append('Welcome back. ');
      if (p.last) add('Continue your last lesson', `/lessons/${p.last}/`);
      if (due) add(`${due} ${due === 1 ? 'question' : 'questions'} to review`, '/review/');
      if (path) add(`Your path: ${path.label}`, `/paths/${path.id}/`);
    });
  </script>

  <style>
    /* ---- Top: hero text, three doors, hero film ---- */
    .top {
      display: grid;
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      grid-template-areas: "hero film" "doors doors";
      gap: var(--ddp-space-8) var(--ddp-space-12);
      align-items: center;
      padding: var(--ddp-space-12) var(--ddp-space-6) var(--ddp-space-6);
    }
    .hero { grid-area: hero; }
    .hero-film { grid-area: film; min-width: 0; }
    /* Live counter: quiet on purpose. Mono, small, muted; items wrap whole. */
    .tally { margin: var(--ddp-space-2) 0 0; font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); letter-spacing: 0.03em; line-height: 1.7; color: var(--ddp-color-muted); }
    /* Each item carries its own dot; the row is pulled left by one dot's width and
       clipped, so a dot that starts a wrapped line is hidden. */
    .tally { overflow: hidden; }
    .tally-row { display: flex; flex-wrap: wrap; margin-left: -1.6em; }
    .tally-i { white-space: nowrap; }
    .tally-i::before { content: '·'; display: inline-block; width: 1.6em; text-align: center; opacity: 0.7; }
    .tally-more { font-style: italic; }
    .doors { grid-area: doors; }
    @media (max-width: 900px) {
      .top { grid-template-columns: minmax(0, 1fr); grid-template-areas: "hero" "doors" "film"; padding-top: var(--ddp-space-8); gap: var(--ddp-space-6); }
    }
    .hero h1 {
      font-family: var(--ddp-font-serif);
      font-weight: 500;
      font-size: var(--ddp-text-3xl);
      line-height: 1.1;
      color: var(--ddp-color-primary);
      max-width: 17ch;
      margin: 0;
    }
    .hero h1 em { font-style: italic; color: var(--ddp-color-accent); }
    .goldrule {
      width: 64px;
      height: 3px;
      background: var(--ddp-color-secondary);
      margin: var(--ddp-space-6) 0;
      transform-origin: left center;
    }
    @media (max-width: 720px) { .goldrule { margin: var(--ddp-space-4) 0; } }
    .lede { max-width: 52ch; font-size: var(--ddp-text-lg); line-height: 1.6; color: var(--ddp-color-ink-soft); margin: 0; }
    .resume { margin: var(--ddp-space-4) 0 0; font-size: var(--ddp-text-sm); color: var(--ddp-color-ink-soft); display: flex; flex-wrap: wrap; gap: var(--ddp-space-3); align-items: baseline; }
    .resume[hidden] { display: none; }
    .resume :global(a) { color: var(--ddp-color-accent); font-weight: 600; }

    /* ---- The three doors: equal cards ---- */
    .doors { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--ddp-space-4); }
    @media (max-width: 720px) { .doors { grid-template-columns: minmax(0, 1fr); gap: var(--ddp-space-3); } }
    .door {
      position: relative;
      display: grid;
      grid-template-columns: 1fr auto;
      grid-template-areas: "t go" "d d";
      align-content: start;
      align-items: baseline;
      column-gap: var(--ddp-space-3);
      row-gap: var(--ddp-space-2);
      min-height: 44px;
      padding: var(--ddp-space-5) var(--ddp-space-6);
      background: var(--ddp-color-surface);
      border: 1px solid var(--ddp-color-line);
      border-radius: var(--ddp-radius);
      color: var(--ddp-color-ink);
      text-decoration: none;
      overflow: hidden;
      transition: transform 0.14s ease, box-shadow 0.14s ease, border-color 0.14s ease;
    }
    .door::before { content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 3px; background: var(--ddp-color-secondary); }
    .door:hover, .door:focus-visible { transform: translateY(-3px); box-shadow: var(--ddp-shadow); border-color: var(--ddp-color-accent); text-decoration: none; }
    .door-t { grid-area: t; font-family: var(--ddp-font-serif); font-weight: 600; font-size: var(--ddp-text-xl); line-height: 1.15; color: var(--ddp-color-primary); text-wrap: balance; }
    .door-go { grid-area: go; font-size: 1.4rem; color: var(--ddp-color-accent); line-height: 1; }
    .door-d { grid-area: d; font-size: var(--ddp-text-sm); line-height: 1.5; color: var(--ddp-color-ink-soft); }

    /* ---- Sections ---- */
    .home-search { padding-block: var(--ddp-space-4) var(--ddp-space-2); }
    .ladder, .stage, .goals, .tryrow, .wip-band { padding-inline: var(--ddp-space-6); }
    .ladder { padding-top: var(--ddp-space-12); }
    .stage, .goals { padding-top: var(--ddp-space-12); }
    .anchor { display: block; height: 0; scroll-margin-top: 5.5rem; }
    .goals, .tryrow { scroll-margin-top: 5.5rem; }
    .sec-h { font-family: var(--ddp-font-serif); font-weight: 500; font-size: var(--ddp-text-2xl); line-height: 1.15; color: var(--ddp-color-primary); margin: 0 0 var(--ddp-space-3); }
    .sec-h-quiet { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ddp-color-muted); }
    .sec-lede { max-width: 62ch; margin: 0 0 var(--ddp-space-6); color: var(--ddp-color-ink-soft); line-height: 1.6; }
    #stage, #goals { scroll-margin-top: 5.5rem; }

    /* ---- The six levels, as text: the ladder from the film ---- */
    .ladder-film { max-width: 640px; margin: 0 0 var(--ddp-space-6); }
    .ladder-watch { margin: 0 0 var(--ddp-space-4); }
    .ladder-watch a { display: inline-flex; align-items: center; min-height: 44px; color: var(--ddp-color-accent); font-weight: 700; }
    .levels { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--ddp-space-2); max-width: 62rem; }
