---
/* The film library (2026-11-13; lighter with featured rows 2026-11-14; rebuilt 2026-11-20).

   Every film on the site, from src/lib/film-catalog.ts. Top to bottom on a phone: the title and one
   honest line; one film to start with (or where you stopped); a strip that draws the whole library
   at true size; the level keys; search, order and a fold for course and kind; what the view holds
   and how long it runs; "Play them in order" or for 10, 20 or 30 minutes; then the gallery.

   The gallery opens on one stack per course (2026-11-21), not on the first course's films: a pile of
   posters with the course's name, level and film count. Opening a stack deals its films out of it;
   "All courses" gathers them back. A level key keeps only that level's stacks. A search, another
   order or a kind of film lists films, as before.

   With scripts off: the film to start with, the level keys as links to /films/<level>/ (every film
   of a level, plain HTML), and the course stacks as links to the course's films on its level page.
   With scripts: a change of level is instant (the strip and the count need no download); opening a
   stack, or the first search, sort, course or kind choice, fetches /films/list.json once and the
   list is drawn from it. The view lives in the query string, with the names it has always had
   (?q=&sort=&level=&course=&kind=), so a view can be shared and Back steps through changes.

   Motion: the strip re-lays and the cards slide to their new places when the visitor changes the
   view; a stack's films fly out of it; and the stacks deal themselves out once, the first time the
   gallery scrolls into view. None of it under reduced motion.
   Nothing here counts what is left. "3 films watched on this device." appears after the first.

   Client: src/lib/film-library.ts (with film-view.ts and film-strip.ts). */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hex from '../../components/Hex.astro';
import { filmCatalog, filmLevelHref, KIND_LABELS, KIND_ORDER, type CatalogFilm } from '../../lib/film-catalog';
import { filmClock } from '../../lib/films';
import { STAGES } from '../../data/stages';
import { filmLadders, type FilmLadder } from '../../lib/film-ladders';
import { LEVEL_SHORT } from '../../lib/hop-words.mjs';
import '../../styles/film-lib.css';
import '../../styles/hop.css';

/* "Play a ladder" (2026-11-22): every idea with films at two or more levels, grouped by area. */
const ladders = await filmLadders();
const ladderAreas: { name: string; items: FilmLadder[] }[] = [];
for (const l of ladders) {
  let a = ladderAreas.find((x) => x.name === l.area);
  if (!a) ladderAreas.push((a = { name: l.area, items: [] }));
  a.items.push(l);
}
const ladderMin = (l: FilmLadder) => Math.max(1, Math.round(l.films.reduce((t, f) => t + f[4], 0) / 60));

const films = await filmCatalog();
const usedStages = STAGES.filter((s) => films.some((f) => f.stage === s.key));
const usedKinds = KIND_ORDER.filter((k) => films.some((f) => f.kind === k));
const fmt = (n: number) => n.toLocaleString('en-US');
const plural = (n: number, w: string) => `${fmt(n)} ${w}${n === 1 ? '' : 's'}`;
const seconds = (list: CatalogFilm[]) => list.reduce((n, f) => n + f.durationSec, 0);
const median = [...films].sort((a, b) => a.durationSec - b.durationSec)[Math.floor(films.length / 2)].durationSec;
/* "about 48 hours 30 minutes": the same rounding the script uses (film-view.ts, about()). */
const allMinutes = Math.round(seconds(films) / 60);
const hours = `${Math.floor(allMinutes / 60)} hours${Math.round((allMinutes % 60) / 5) * 5 ? ` ${Math.round((allMinutes % 60) / 5) * 5} minutes` : ''}`;
const levelCount = (key: string) => films.filter((f) => f.stage === key).length;

const courses: { key: string; title: string; stage: string; stageTitle: string; films: CatalogFilm[] }[] = [];
for (const f of films) {
  if (!f.course) continue;
  let c = courses.find((x) => x.key === f.course);
  if (!c) courses.push((c = { key: f.course, title: f.courseTitle, stage: f.stage!, stageTitle: f.stageTitle, films: [] }));
  c.films.push(f);
}

/* A film to start with: for each level, a few opening films in course order, the first of them the
   level's first film. */
const today = new Date().toISOString().slice(0, 10);
const seed = [...today].reduce((h, ch) => Math.imul(h ^ ch.charCodeAt(0), 16777619), 2166136261) >>> 0;
const starts = usedStages.flatMap((s) => {
  const firsts = films.filter((f) => f.stage === s.key && (f.kind === 'first' || (f.kind === 'activity' && f.lessonHref?.endsWith('#explainer'))));
  const step = Math.max(1, Math.floor(firsts.length / 4));
  return [0, 1, 2, 3].map((k) => firsts[k * step]).filter((f, i, a) => f && a.indexOf(f) === i).map((f) => ({
    s: s.key, t: f.title, h: f.href, o: f.poster, d: filmClock(f.durationSec), m: `${f.stageTitle} · ${f.courseTitle}`, x: f.description,
  }));
});
/* A first visitor is offered a grade 7 film, where biology starts from its first page (ruling,
   2026-11-20); which of the four changes with the build. A level chosen on the page, or set on this
   device, replaces it in the browser. */
const g7 = starts.filter((x) => x.s === 'grade-7');
const start = g7[seed % Math.max(1, g7.length)] ?? starts[0];

/* The strip's data: every film's level and length, in catalog order (3 characters a film). */
const stageIndex = (k: string | null) => { const i = usedStages.findIndex((s) => s.key === k); return i === -1 ? usedStages.length : i; };
const strip = films.map((f) => `${stageIndex(f.stage)}${Math.min(1295, Math.round(f.durationSec)).toString(36).padStart(2, '0')}`).join('');

/* The gallery as served: one stack per course, in course order, and one for the methods library. */
const about = (list: CatalogFilm[]) => { const m = Math.round(seconds(list) / 60); return m < 90 ? `${m} min` : `${Math.round(m / 6) / 10} hours`; };
const methodFilms = films.filter((f) => !f.course);
const stacks = [
  ...courses.map((c) => ({ key: c.key, title: c.title, level: c.stage, levelTitle: c.stageTitle, films: c.films, href: `${filmLevelHref(c.stage)}#${c.key}` })),
  ...(methodFilms.length ? [{ key: 'methods', title: 'Methods library', level: '', levelTitle: 'Every level', films: methodFilms, href: '/methods/' }] : []),
];
---

<BaseLayout title="Films — STEMhop" description={`${fmt(films.length)} short narrated films, most about ${Math.round(median / 60)} minutes, from every lesson on the site. Find one by level, length or idea, or play a set in order. Each has captions, a transcript and its lesson one tap away.`}>
<div class="film-lib fl" data-fl data-total={films.length} data-pagefind-ignore>
  <header class="wrap fl-top">
    <h1>Films</h1>
    <p class="fl-lede">{fmt(films.length)} short films, most about {Math.round(median / 60)} minutes. Each has captions, a transcript and its lesson one tap away.</p>
  </header>

  <section class="wrap fl-start" aria-labelledby="fl-start-h" data-fl-start data-pool={JSON.stringify(starts)}>
    <a class="fl-start-pic" href={start.h} tabindex="-1" aria-hidden="true" data-fl-start-link>
      <img src={start.o} alt="" width="320" height="180" decoding="async" data-fl-start-img />
    </a>
    <div class="fl-start-txt">
      <h2 id="fl-start-h" data-fl-start-k>A film to start with</h2>
      <p class="fl-start-t"><a href={start.h} data-fl-start-link data-fl-start-t>{start.t}</a></p>
      <p class="fl-start-m"><span data-fl-start-m>{start.m}</span> · <span data-fl-start-d>{start.d}</span></p>
      <p class="fl-start-x" data-fl-start-x>{start.x}</p>
      <p class="fl-start-go">
        <a class="fl-btn primary" href={start.h} data-fl-start-link data-fl-start-watch>Watch</a>
        <button type="button" class="fl-link" data-fl-surprise hidden>Surprise me</button>
      </p>
      <p class="visually-hidden" role="status" data-fl-say></p>
    </div>
  </section>

  {/* Play a ladder: one idea at every level it is taught, its films on the shared ladder drawing.
      Client: src/lib/film-ladder.ts. Without scripts the picker opens the run page for the idea. */}
  <section class="wrap flx" aria-labelledby="flx-h" data-flx>
    <div class="flx-head">
      <span class="flx-hex" aria-hidden="true"><Hex pose="stand" size={40} /></span>
      <div>
        <h2 id="flx-h">Play a ladder</h2>
        <p class="flx-lede">One idea, every level it is taught at. Pick one and its films climb onto the ladder, simplest at the foot. Tap any film, or play the whole ladder from wherever you like.</p>
      </div>
    </div>
    <form class="flx-pick" action="/films/run/" method="get" data-flx-pick>
      <label class="fl-field">
        <span>Ladder</span>
        <select name="idea" autocomplete="off">
          <option value="">Choose an idea ({ladders.length} ladders)</option>
          {ladderAreas.map((a) => (
            <optgroup label={a.name}>
              {a.items.map((l) => {
                const ranks = [...new Set(l.films.map((f) => f[3]))].sort((x, y) => x - y);
                return <option value={l.id}>{l.name} · {l.films.length} films, {ladderMin(l)} min, {LEVEL_SHORT[ranks[0]]} to {LEVEL_SHORT[ranks[ranks.length - 1]]}</option>;
              })}
            </optgroup>
          ))}
        </select>
      </label>
      <button type="submit" class="fl-btn primary" data-flx-go>Open the ladder</button>
    </form>
    <p class="flx-sum" data-flx-sum role="status"></p>

    <div class="flx-stage" data-flx-stage hidden>
      <div class="flx-player">
        <div class="flx-screen">
          <video controls preload="none" playsinline width="1920" height="1080" data-listen-film="">
            <track kind="captions" srclang="en" label="English" />
          </video>
        </div>
        <h3 class="flx-now" data-flx-title></h3>
        <p class="flx-meta"><span data-flx-meta></span> · <a href="/films/" data-flx-page>Film page and transcript</a></p>
        <p class="flx-btns">
          <button type="button" class="fl-btn primary" data-flx-all>▶ Play the ladder</button>
          <button type="button" class="fl-btn soft" data-flx-here hidden>Play on from here</button>
          <button type="button" class="fl-btn" data-flx-prev>Previous</button>
          <button type="button" class="fl-btn" data-flx-next>Next</button>
          <button type="button" class="fl-btn" data-flx-stop hidden>Stop</button>
        </p>
        <p class="flx-say" data-flx-say role="status"></p>
      </div>
      <div class="flx-rail" data-flx-ladder></div>
    </div>
  </section>

  <section class="wrap fl-deck" aria-label="Choose films">
    <div class="fl-strip" data-fl-strip data-d={strip} aria-hidden="true">
      {/* Before the script draws every film: the levels, each as wide as its films are long. */}
      <div class="fl-strip-plain">
        {usedStages.map((s) => <span class={`lv-${s.key}`} style={`flex-grow:${Math.round(seconds(films.filter((f) => f.stage === s.key)))}`}></span>)}
        <span class="lv-methods" style={`flex-grow:${Math.round(seconds(films.filter((f) => !f.stage)))}`}></span>
      </div>
      <canvas hidden></canvas>
    </div>
    <p class="fl-strip-cap" data-fl-strip-cap>All {fmt(films.length)} films, each drawn as long as it runs.</p>

    <nav class="fl-keys" aria-label="Level" data-fl-keys>
      <a class="fl-key is-on" href="/films/" data-level=""><span class="fl-key-hex" data-fl-hex><Hex pose="stand" size={26} /></span><span class="fl-key-t">Every level</span><span class="fl-key-n">{plural(films.length, 'film')}</span></a>
      {usedStages.map((s) => (
        <a class={`fl-key lv-${s.key}`} href={filmLevelHref(s.key)} data-level={s.key}><span class="fl-key-t"><span class="fl-chip"></span>{s.title}</span><span class="fl-key-n">{plural(levelCount(s.key), 'film')}</span></a>
      ))}
    </nav>
    <p class="fl-keys-note">A level is a place to start, not a rank. If a film loses you, the level below teaches the same idea, told more simply.</p>

    <form class="fl-controls" data-fl-controls hidden role="search" aria-label="Search and sort the films">
      <input type="hidden" name="level" value="" />
      <div class="fl-row">
        <label class="fl-field fl-q">
          <span>Search</span>
          <input type="search" name="q" placeholder="A title or a question" autocomplete="off" spellcheck="false" enterkeyhint="search" />
        </label>
        <label class="fl-field">
          <span>Order</span>
          <select name="sort">
            <option value="course">Course order</option>
            <option value="short">Shortest first</option>
            <option value="long">Longest first</option>
            <option value="new">Newest first</option>
            <option value="az">A to Z</option>
          </select>
        </label>
      </div>
      <details class="fl-fold" data-fl-fold>
        <summary>Course and kind of film</summary>
        <div class="fl-row">
          <label class="fl-field">
            <span>Course</span>
            <select name="course">
              <option value="">Every course</option>
              {usedStages.map((s) => (
                <optgroup label={s.title}>
                  {courses.filter((c) => c.stage === s.key).map((c) => <option value={c.key}>{c.title}</option>)}
                </optgroup>
              ))}
            </select>
          </label>
          <label class="fl-field">
            <span>Kind of film</span>
            <select name="kind">
              <option value="">Every kind</option>
              {usedKinds.map((k) => <option value={k}>{KIND_LABELS[k]}</option>)}
            </select>
          </label>
        </div>
      </details>
    </form>

    <div class="fl-count">
      <p class="fl-status" data-fl-status role="status">{plural(films.length, 'film')}, about {hours}.</p>
      <p class="fl-seen" data-fl-seen hidden></p>
    </div>

    <div class="fl-run" data-fl-run hidden>
      <a class="fl-btn" href="/films/run/" data-fl-play>Play them in order</a>
      <fieldset class="fl-budget">
        <legend>Play for a set time</legend>
        {[10, 20, 30].map((m) => <label><input type="radio" name="fl-t" value={m} autocomplete="off" /><span>{m} minutes</span></label>)}
      </fieldset>
      <div class="fl-run-sum" data-fl-run-sum hidden>
        <p data-fl-run-text role="status"></p>
        <ol class="fl-run-list" data-fl-run-list hidden></ol>
        <p class="fl-run-go"><a class="fl-btn primary" href="/films/run/" data-fl-run-start>Start</a> <button type="button" class="fl-link" data-fl-run-clear>Not now</button></p>
      </div>
    </div>
  </section>

  <section class="wrap fl-all" aria-label="Films">
    <div class="fl-none" data-fl-none hidden>
      <p>Try fewer words, or <button type="button" class="fl-link" data-fl-clear>show every film</button>.</p>
    </div>

    <p class="fl-wait" data-fl-wait hidden>Bringing up these films…</p>
    <div data-fl-list>
      <div class="fl-shelf" data-fl-shelf>
        <h2 class="fl-shelf-h">Courses</h2>
        <p class="fl-shelf-note">Open a course to see its films.</p>
        <ul class="fl-stacks" data-fl-stacks>
          {stacks.map((k) => (
            <li class={`fs lv-${k.level || 'methods'}`} data-stack={k.key} data-level={k.level}>
              <a href={k.href}>
                <span class="fs-pile" aria-hidden="true">
                  <span class="fs-sheet"></span>
                  <span class="fs-sheet"></span>
                  <span class="fs-top"><img src={k.films[0].poster} alt="" width="320" height="180" loading="lazy" decoding="async" /></span>
                </span>
                <span class="fs-t">{k.title}</span>
                <span class="fs-m"><span class="fl-chip"></span>{k.levelTitle}</span>
                <span class="fs-n">{plural(k.films.length, 'film')} · {about(k.films)}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <p class="fl-more-row" data-fl-more-row hidden>
      <button type="button" class="fl-btn" data-fl-more>Show 60 more</button>
    </p>

    <div class="fl-rest" data-fl-rest>
      <p>Every film is also listed on its level’s page. Choose a level:</p>
      <ul>
        {usedStages.map((s) => <li><a href={filmLevelHref(s.key)}>{s.title}</a></li>)}
        <li><a href="/methods/">Methods library</a></li>
      </ul>
    </div>

    <p class="fl-foot">
      The animations and narration are AI-generated, as each film’s page says, and every film has captions and a transcript.
      What you have watched is kept on this device only; nobody else can see it.
    </p>
  </section>

</div>

<script>
  import { library } from '../../lib/film-library';
  import { filmLadder } from '../../lib/film-ladder';
  library();
  filmLadder();
</script>
</BaseLayout>
