---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteSearch from '../components/SiteSearch.astro';
---

<BaseLayout title="Search — Biochemistrypedia" description="Search every lesson in every Biochemistrypedia course by topic, section, technique or scientist.">
  <section class="wrap search-page">
    <p class="eyebrow"><a href="/#courses">All courses</a> · search</p>
    <h1>Search the lessons</h1>
    <p class="lede">Every course at once, or one at a time. The search reads lesson titles, section headings, objectives, and the scientists, techniques and structures each lesson names.</p>
    <SiteSearch autofocus label="Search all courses" />
  </section>

  <style>
    .search-page { padding-block: var(--ddp-space-8) var(--ddp-space-16); display: flex; flex-direction: column; gap: var(--ddp-space-3); min-height: 50vh; }
    .eyebrow { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); letter-spacing: 0.14em; text-transform: uppercase; color: var(--ddp-color-caution); margin: 0; }
    .eyebrow a { color: inherit; text-underline-offset: 3px; }
    h1 { font-family: var(--ddp-font-serif); font-weight: 500; color: var(--ddp-color-primary); font-size: var(--ddp-text-3xl); line-height: 1.1; margin: 0; }
    .lede { font-size: var(--ddp-text-lg); line-height: 1.6; color: var(--ddp-color-ink-soft); max-width: 60ch; margin: 0 0 var(--ddp-space-4); }
  </style>
</BaseLayout>
