---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteSearch from '../components/SiteSearch.astro';
---

<BaseLayout title="Search — Biochemistrypedia" description="Search every lesson in every Biochemistrypedia course by topic, section, technique, scientist, or any sentence in the lesson text, stories, self-tests and film transcripts.">
  <section class="wrap search-page">
    <p class="eyebrow"><a href="/courses/">All courses</a> · search</p>
    <h1>Search the lessons</h1>
    <p class="lede">Type a word, a phrase or a question. The search reads the titles, the section headings and all the text of every lesson. That includes the “Explain at my level” texts, the stories, the self-test questions, the “How we measure it” notes and the film transcripts. The best match comes first, and each result links to where your words appear. Pick a course below the box to narrow it.</p>
    <SiteSearch autofocus label="Search all courses" />
  </section>

  <style>
    .search-page { padding-block: var(--ddp-space-8) var(--ddp-space-16); display: flex; flex-direction: column; gap: var(--ddp-space-3); min-height: 50vh; }
    .eyebrow { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); letter-spacing: 0.14em; text-transform: uppercase; color: var(--ddp-color-caution); margin: 0; }
    .eyebrow a { color: inherit; text-underline-offset: 3px; }
    h1 { font-family: var(--ddp-font-serif); font-weight: 500; color: var(--ddp-color-primary); font-size: var(--ddp-text-3xl); line-height: 1.1; margin: 0; }
    .lede { font-size: var(--ddp-text-lg); line-height: 1.6; color: var(--ddp-color-ink-soft); max-width: 60ch; margin: 0 0 var(--ddp-space-4); }
  </style>
</BaseLayout>
