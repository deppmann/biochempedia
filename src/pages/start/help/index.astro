---
/* Where the help line on /start/ leads: ways to get help.
   The words are in src/lib/start-help.mjs (approved 2026-11-22, calmer form). This page is
   noindex and only /start/ points here. No script, no form, no
   analytics: nothing on this page reads or sends anything. */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import '../../../styles/start.css';
import { HELP, withNumbers } from '../../../lib/start-help.mjs';
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const p = HELP.page;
---
<BaseLayout title={`${p.title} — STEMhop`} description="Who to tell, and who to call, when you need help." noindex noAnalytics>
  <article class="wrap st">
    <div class="st-col st-helppage">
      <h1>{p.title}</h1>
      <p class="st-lede">{p.intro}</p>
      {p.steps.map(([h, t]) => (
        <section>
          <h2>{h}</h2>
          <p set:html={withNumbers(t, esc)} />
        </section>
      ))}
      <p class="st-helpfoot">{p.foot}</p>
      <p class="st-foot"><a href="/start/">Back to the question box</a></p>
    </div>
  </article>
</BaseLayout>
