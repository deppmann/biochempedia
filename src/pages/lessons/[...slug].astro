---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import MolViewer from '../../components/MolViewer.astro';
import PhetEmbed from '../../components/PhetEmbed.astro';
import YouTubeEmbed from '../../components/YouTubeEmbed.astro';
import SpotifyEmbed from '../../components/SpotifyEmbed.astro';
import LectureSlides from '../../components/LectureSlides.astro';
import QuizBlock from '../../components/QuizBlock.astro';
import SourcesFooter from '../../components/SourcesFooter.astro';
import AnecdoteAnimation from '../../components/AnecdoteAnimation.astro';
import { feedbackUrl } from '../../lib/feedback';

export async function getStaticPaths() {
  // Drafts must not generate a route. The homepage and sitemap already filter
  // them; without the same filter here, a draft stays reachable by direct URL
  // even though nothing links to it.
  const lessons = await getCollection('lessons', ({ data }) => !data.draft);
  return lessons.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const lesson = entry.data;

const phetSims = lesson.simulations.filter((s) => s.type === 'phet');
const localSims = lesson.simulations.filter((s) => s.type === 'local');
// The in-text island name (strip any parenthetical), used for the rail caption.
const localSimNames = localSims.map((s) => s.title.split('(')[0].trim());
const hasQuiz = lesson.practiceQuestions.length > 0 || lesson.mcatQuestions.length > 0;
const qCount = lesson.practiceQuestions.length + lesson.mcatQuestions.length;
const narratedSlides = lesson.lectureSlides.filter((s) => s.audio).length;
// Slides without a recording, counted separately so no count calls a silent
// slide "narrated".
const slidesSilent = lesson.lectureSlides.length - narratedSlides;
const slidesTag =
  narratedSlides === 0 ? '' : narratedSlides === lesson.lectureSlides.length ? ' · narrated' : ` · ${narratedSlides} narrated`;
const ex = lesson.explainer;
const exLen = ex ? `${Math.floor(ex.durationSec / 60)}:${String(Math.round(ex.durationSec % 60)).padStart(2, '0')}` : '';
const hasStats = (ex ? 1 : 0) + lesson.structures.length + lesson.lectureSlides.length + qCount + lesson.scientists.length > 0;

// Thumbnail helpers for the rail.
const rcsbThumb = (id: string) => `https://cdn.rcsb.org/images/structures/${id.toLowerCase()}_assembly-1.jpeg`;
const pubchemThumb = (id: string) => `https://pubchem.ncbi.nlm.nih.gov/rest/pug/compound/cid/${id}/PNG`;
const ytThumb = (id: string) => `https://i.ytimg.com/vi/${id}/hqdefault.jpg`;
const structId = (s: { source: string; id: string }) => `lb-struct-${s.source}-${s.id}`.replace(/[^a-zA-Z0-9-]/g, '');
const LEVEL_ICONS: Record<string, string> = { eli5: '🧸', highschool: '🎒', college: '🎓', grad: '🔬' };
const paras = (t: string) => t.split(/\n\n+/).map((p) => p.trim()).filter(Boolean);
const lessonLd = {
  '@context': 'https://schema.org',
  '@type': 'LearningResource',
  name: lesson.title,
  description: lesson.summary,
  educationalLevel: 'undergraduate',
  learningResourceType: 'interactive lesson',
  inLanguage: 'en',
  about: lesson.courseChapter,
  isPartOf: { '@type': 'Course', name: 'Biochemistrypedia', provider: { '@type': 'Person', name: 'Christopher Deppmann' } },
};
---

<BaseLayout title={`${lesson.title} — Biochemistrypedia`} description={lesson.summary} ogType="article" jsonLd={lessonLd}>
  <article id="top">
    <header class="lesson-hero wrap">
      <p class="eyebrow">{lesson.courseChapter}</p>
      <h1>{lesson.title}</h1>
      <p class="summary">{lesson.summary}</p>
    </header>

    {lesson.objectives.length > 0 && (
      <aside class="wrap orient" aria-label="Lesson overview">
        <div class="orient-obj card">
          {/* Time lives in the heading so hiding the meta row on mobile loses nothing. */}
          <h2 class="orient-pad-left" >What you'll learn{lesson.estMinutes ? ` · ~${lesson.estMinutes} min` : ''}</h2>
          <ul>{lesson.objectives.map((o) => <li>{o}</li>)}</ul>
        </div>
        {/* The reading time is already in the card's heading, so the stats
            column lists only what the lesson contains. */}
        {hasStats && (
          <div class="orient-meta">
            <p class="orient-meta-h">In this lesson</p>
            <ul>
              {ex && <li><span aria-hidden="true">🎬</span> <b>{exLen}</b> animated explainer</li>}
              {lesson.structures.length > 0 && <li><span aria-hidden="true">🧬</span> <b>{lesson.structures.length}</b> live 3D {lesson.structures.length === 1 ? 'structure' : 'structures'}</li>}
              {narratedSlides > 0 && <li><span aria-hidden="true">🎧</span> <b>{narratedSlides}</b> narrated {narratedSlides === 1 ? 'slide' : 'slides'}</li>}
              {slidesSilent > 0 && <li><span aria-hidden="true">🖼</span> <b>{slidesSilent}</b> lecture {slidesSilent === 1 ? 'slide' : 'slides'}</li>}
              {qCount > 0 && <li><span aria-hidden="true">📝</span> <b>{qCount}</b> self-test {qCount === 1 ? 'question' : 'questions'}</li>}
              {lesson.scientists.length > 0 && <li><span aria-hidden="true">👤</span> <b>{lesson.scientists.length}</b> scientist {lesson.scientists.length === 1 ? 'profile' : 'profiles'}</li>}
            </ul>
          </div>
        )}
      </aside>
    )}

    {ex && (
      <section class="wrap explainer" id="explainer" aria-labelledby="explainer-h">
        <figure class="explainer-fig">
          <video controls preload="none" playsinline poster={ex.poster} width="1920" height="1080">
            <source src={ex.src} type="video/mp4" />
            <track kind="captions" src={ex.captions} srclang="en" label="English" />
            Your browser cannot play this video. <a href={ex.src}>Download the explainer (MP4)</a>.
          </video>
          <figcaption>
            <p class="explainer-h" id="explainer-h"><span class="explainer-kicker">Watch first</span> {ex.title} <span class="explainer-len">· {exLen}</span></p>
            <p class="explainer-note">
              Narration: {ex.narration}. The animation is a schematic drawn in code by an AI
              (Claude): boxes, arrows and plots, never a molecular structure. {ex.factCheckedBy ? `Checked by ${ex.factCheckedBy}.` : 'No person has reviewed the animation yet.'} Captions: press CC.
            </p>
          </figcaption>
        </figure>
      </section>
    )}

    {/* Mobile-only shortcut. On a phone the two-column grid collapses and the
        resource rail lands after the whole narrative — on a long lesson that is
        thousands of pixels down, which effectively hides the best part of the
        page. These chips reuse the same [data-open] dialogs as the rail, so a
        reader reaches the slides, the self-test, and the sources from the first
        screen. The desktop rail is untouched. */}
    <nav class="wrap mobile-explore" aria-label="Explore this lesson">
      <p class="me-title">Explore this lesson</p>
      <ul class="me-chips">
        {ex && (
          <li><a href="#explainer">▶ Explainer <em>{exLen}</em></a></li>
        )}
        {lesson.lectureSlides.length > 0 && (
          <li><button type="button" data-open="lb-slides">🖼 Slides <em>{lesson.lectureSlides.length}</em></button></li>
        )}
        {lesson.structures.length > 0 && (
          <li><a href="#rail">🧬 3D molecules <em>{lesson.structures.length}</em></a></li>
        )}
        {hasQuiz && (
          <li><button type="button" data-open="lb-quiz">📝 Self-test <em>{qCount}</em></button></li>
        )}
        {lesson.explainLevels.length > 0 && (
          <li><button type="button" data-open={`lb-level-${lesson.explainLevels[0].level}`}>🧸 Explain it simply</button></li>
        )}
        <li><button type="button" data-open="lb-sources">📚 Sources</button></li>
        <li><a href="#rail">All resources →</a></li>
      </ul>
    </nav>

    {/* Two-column: reading column + sticky resource rail. */}
    <div class="wrap lesson-layout">
      {/* A <div>, not a <main>: BaseLayout already owns the page's single
          <main id="main"> landmark, and nesting a second one is invalid HTML
          that makes landmark navigation ambiguous for screen readers. */}
      <div class="lesson-main">
        <div class="prose-col"><Content /></div>

        {lesson.techniques.length > 0 && (
          <section class="tech-panel">
            <h2>How we measure it</h2>
            <div class="tech-grid">
              {lesson.techniques.map((t) => (
                <div class="tech card orient-pad"><h3>{t.name}</h3><p>{t.blurb}</p></div>
              ))}
            </div>
          </section>
        )}
      </div>

      <aside class="rail" id="rail" aria-label="Explore — open any resource">
        <p class="rail-title">Explore <span>· tap to open</span></p>

        {lesson.explainLevels.length > 0 && (
          <div class="rail-group">
            <h3>
              <button type="button" class="rail-toggle rail-btn" aria-expanded="false" aria-controls="levels-list">
                Explain at my level
                <span aria-hidden="true">⌄</span>
              </button>
            </h3>
            <div id="levels-list" class="rail-items" hidden>
              {lesson.explainLevels.map((lv) => (
                <button type="button" class="rail-thumb" data-open={`lb-level-${lv.level}`}>
                  <span class="rail-ico" aria-hidden="true">{LEVEL_ICONS[lv.level]}</span>
                  <span class="rail-label">{lv.label} <em>explain it →</em></span>
                </button>
              ))}
            </div>
          </div>
        )}

        {lesson.lectureSlides.length > 0 && (
          <div class="rail-group">
            <h3>Lecture slides</h3>
            <button type="button" class="rail-slidepreview" data-open="lb-slides">
              <img src={lesson.lectureSlides[0].src.replace(/\.png$/, '.thumb.webp')} alt={`Preview: ${lesson.lectureSlides[0].title}`} loading="lazy" decoding="async" />
              <span class="rail-label">Lecture slides <em>{lesson.lectureSlides.length}{slidesTag} · tap to open</em></span>
            </button>
          </div>
        )}

        {lesson.structures.length > 0 && (
          <div class="rail-group">
            <h3>
              <button type="button" class="rail-toggle rail-btn" aria-expanded="false" aria-controls="molecule-list">
                3D molecules ({ lesson.structures.length })
                <span aria-hidden="true">⌄</span>
              </button>
            </h3>
            <div id="molecule-list" class="rail-items" hidden>
              {lesson.structures.map((s) => (
              <button type="button" class="rail-thumb" data-open={structId(s)}>
                <img src={s.source === 'rcsb' ? rcsbThumb(s.id) : pubchemThumb(s.id)} alt="" loading="lazy" />
                <span class="rail-label">{s.label.split('—')[0].trim()} <em>{s.source === 'rcsb' ? `PDB ${s.id}` : `CID ${s.id}`} · rotate</em></span>
              </button>
              ))}
            </div>
          </div>
        )}

        {(phetSims.length > 0 || localSimNames.length > 0) && (
          <div class="rail-group">
            <h3>Simulations</h3>
            {localSimNames.length === 1 && (
              <p class="rail-note">This lesson's interactive — <strong>{localSimNames[0]}</strong> — is built into the text above; try it as you read.</p>
            )}
            {localSimNames.length > 1 && (
              <p class="rail-note">This lesson's interactives — {localSimNames.map((n, i) => (<>{i > 0 ? ', ' : ''}<strong>{n}</strong></>))} — are built into the text above; try them as you read.</p>
            )}
            {phetSims.map((s, i) => (
              <button type="button" class="rail-thumb" data-open={`lb-phet-${i}`}>
                <span class="rail-ico" aria-hidden="true">▶</span>
                <span class="rail-label">{s.title} <em>PhET</em></span>
              </button>
            ))}
          </div>
        )}

        {lesson.scientists.length > 0 && (
          <div class="rail-group">
            <h3>
              <button type="button" class="rail-toggle rail-btn" aria-expanded="false" aria-controls="people-list">
                The people ({ lesson.scientists.length })
                <span aria-hidden="true">⌄</span>
              </button>
            </h3>
            <div id="people-list" class="rail-items" hidden>
              {lesson.scientists.map((s, i) => (
                <button type="button" class="rail-thumb" data-open={`lb-sci-${i}`}>
                  {s.photo
                    ? <img src={s.photo} alt="" loading="lazy" />
                    : <span class="rail-ico" aria-hidden="true">👤</span>}
                  <span class="rail-label">{s.name} {s.dates && <em>{s.dates}</em>}</span>
                </button>
              ))}
            </div>
          </div>
        )}

        {lesson.anecdotes.length > 0 && (
          <div class="rail-group">
            <h3>
              <button type="button" class="rail-toggle rail-btn" aria-expanded="false" aria-controls="story-list">
                Stories &amp; asides ({ lesson.anecdotes.length })
                <span aria-hidden="true">⌄</span>
              </button>
            </h3>
            <div id="story-list" class="rail-items" hidden>
              {lesson.anecdotes.map((a, i) => (
                <button type="button" class="rail-thumb" data-open={`lb-anec-${i}`}>
                  <span class="rail-ico" aria-hidden="true">💡</span>
                  <span class="rail-label">{a.title} <em>story</em></span>
                </button>
              ))}
            </div>
          </div>
        )}

        {(lesson.videos.length > 0 || lesson.podcast) && (
          <div class="rail-group">
            <h3>
              <button type="button" class="rail-toggle rail-btn" aria-expanded="false" aria-controls="video-list">
                Watch &amp; listen ({lesson.videos.length + (lesson.podcast ? 1 : 0)})
                <span aria-hidden="true">⌄</span>
              </button>
            </h3>
            <div id="video-list" class="rail-items" hidden>
            {lesson.videos.map((v, i) => (
              <button type="button" class="rail-thumb" data-open={`lb-video-${i}`}>
                <img src={ytThumb(v.youtubeId)} alt="" loading="lazy" />
                <span class="rail-label">{v.title} <em>video</em></span>
              </button>
            ))}
            {lesson.podcast && (
              <details class="rail-player">
                <summary>
                  <span class="rail-ico" aria-hidden="true">🎧</span>
                  <span class="rail-label">{lesson.podcast.title ?? 'Podcast'} <em>listen here ▾</em></span>
                </summary>
                <div class="rail-player-body">
                  <SpotifyEmbed url={lesson.podcast.url} title={lesson.podcast.title} note={lesson.podcast.note} compact />
                  {lesson.podcast.note && <p class="rail-note">{lesson.podcast.note}</p>}
                </div>
              </details>
            )}
            </div>
          </div>
        )}

        {hasQuiz && (
          <div class="rail-group">
            <h3>Test yourself</h3>
            <button type="button" class="rail-thumb" data-open="lb-quiz">
              <span class="rail-ico" aria-hidden="true">📝</span>
              <span class="rail-label">Self-test <em>{qCount} questions</em></span>
            </button>
          </div>
        )}

        <div class="rail-group">
          <h3>Reference</h3>
          <button type="button" class="rail-thumb" data-open="lb-sources">
            <span class="rail-ico" aria-hidden="true">📚</span>
            <span class="rail-label">Sources &amp; Integrity <em>every ID &amp; source</em></span>
          </button>
          {/* Prefilled with this lesson, so a report arrives tagged. */}
          <a class="rail-thumb" href={feedbackUrl(lesson.title)} target="_blank" rel="noopener">
            <span class="rail-ico" aria-hidden="true">✎</span>
            <span class="rail-label">Report an error <em>or request something ↗</em></span>
          </a>
        </div>
      </aside>
    </div>

    {/* ---- Lightboxes (one per resource; hidden until opened) ---- */}
    {lesson.lectureSlides.length > 0 && (
      <dialog id="lb-slides" class="lightbox lock-scroll">
        <div class="lightbox-head"><span>From the lecture</span><button type="button" class="lightbox-close" data-close aria-label="Close">✕</button></div>
        <div class="lightbox-body"><LectureSlides slides={lesson.lectureSlides} /></div>
      </dialog>
    )}

    {lesson.structures.map((s) => (
      <dialog id={structId(s)} class="lightbox lock-scroll">
        <div class="lightbox-head"><span>{s.label}</span><button type="button" class="lightbox-close" data-close aria-label="Close">✕</button></div>
        <div class="lightbox-body"><MolViewer source={s.source} id={s.id} label={s.label} caption={s.caption} height={520} /></div>
      </dialog>
    ))}

    {phetSims.map((s, i) => (
      <dialog id={`lb-phet-${i}`} class="lightbox lock-scroll">
        <div class="lightbox-head"><span>{s.title}</span><button type="button" class="lightbox-close" data-close aria-label="Close">✕</button></div>
        <div class="lightbox-body"><PhetEmbed url={s.ref} title={s.title} attribution={s.attribution} caption={s.caption} /></div>
      </dialog>
    ))}

    {lesson.scientists.map((s, i) => (
      <dialog id={`lb-sci-${i}`} class="lightbox lock-scroll">
        <div class="lightbox-head"><span>{s.name}</span><button type="button" class="lightbox-close" data-close aria-label="Close">✕</button></div>
        <div class="lightbox-body">
          <div class={`profile${s.photo ? '' : ' no-photo'}`}>
            {s.photo && <img class="profile-photo" src={s.photo} alt={`AI-generated illustrated portrait of ${s.name}`} />}
            <div class="profile-text">
              <h3>{s.name} {s.dates && <span class="profile-dates">{s.dates}</span>}</h3>
              <p class="profile-contribution">{s.contribution}</p>
              {s.story && <p class="profile-story">{s.story}</p>}
              {s.quotes.length > 0 && (
                <ul class="profile-quotes">{s.quotes.map((q) => <li><blockquote>“{q}”</blockquote></li>)}</ul>
              )}
              <p class="profile-source"><span class="verified-chip">✓ verbatim</span> {s.profileSourceAnchor}</p>
            </div>
          </div>
        </div>
      </dialog>
    ))}

    {lesson.videos.map((v, i) => (
      <dialog id={`lb-video-${i}`} class="lightbox lcok-scroll">
        <div class="lightbox-head"><span>{v.title}</span><button type="button" class="lightbox-close" data-close aria-label="Close">✕</button></div>
        <div class="lightbox-body"><YouTubeEmbed youtubeId={v.youtubeId} title={v.title} sourceNote={v.sourceNote} /></div>
      </dialog>
    ))}

    {hasQuiz && (
      <dialog id="lb-quiz" class="lightbox lock-scroll">
        <div class="lightbox-head"><span>Test yourself</span><button type="button" class="lightbox-close" data-close aria-label="Close">✕</button></div>
        <div class="lightbox-body"><QuizBlock practice={lesson.practiceQuestions} mcat={lesson.mcatQuestions} /></div>
      </dialog>
    )}

    <dialog id="lb-sources" class="lightbox lock-scroll">
      <div class="lightbox-head"><span>Sources &amp; Integrity</span><button type="button" class="lightbox-close" data-close aria-label="Close">✕</button></div>
      <div class="lightbox-body"><SourcesFooter lesson={lesson} /></div>
    </dialog>

    {lesson.explainLevels.map((lv) => (
      <dialog id={`lb-level-${lv.level}`} class="lightbox lock-scroll">
        <div class="lightbox-head"><span>{lv.label}</span><button type="button" class="lightbox-close" data-close aria-label="Close">✕</button></div>
        <div class="lightbox-body"><div class="prose-col level-body">{paras(lv.text).map((p) => <p>{p}</p>)}</div></div>
      </dialog>
    ))}

    {lesson.anecdotes.map((a, i) => (
      <dialog id={`lb-anec-${i}`} class="lightbox lock-scroll">
        <div class="lightbox-head"><span>{a.title}</span><button type="button" class="lightbox-close" data-close aria-label="Close">✕</button></div>
        <div class="lightbox-body">
          {a.animation && <AnecdoteAnimation anim={a.animation} />}
          <div class="prose-col level-body">{paras(a.text).map((p) => <p>{p}</p>)}<p class="anec-source">— {a.source}</p></div>
        </div>
      </dialog>
    ))}

    <a href="#top" class="to-top" aria-label="Back to top">↑ Top</a>
  </article>

  <script>
    function animateCounter(el: HTMLElement) {
      const to = parseInt(el.getAttribute('data-to') || '0', 10);
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        el.textContent = to.toLocaleString();
        return;
      }
      const dur = 1500;
      const start = performance.now();
      function step(now: number) {
        const t = Math.min(1, (now - start) / dur);
        const eased = 1 - Math.pow(1 - t, 3); // ease-out cubic
        el.textContent = Math.round(to * eased).toLocaleString();
        if (t < 1) requestAnimationFrame(step);
      }
      requestAnimationFrame(step);
    }

    // Lightbox: open on rail-thumb click, close on ✕ / backdrop / Esc.
    document.querySelectorAll<HTMLElement>('[data-open]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const d = document.getElementById(btn.getAttribute('data-open')!) as HTMLDialogElement | null;
        if (!d?.showModal) return;
        d.showModal();
        // Auto-play the visible slide's narration when the slideshow opens
        // (within this click gesture, so the browser allows it).
        const slideAudio = d.querySelector<HTMLAudioElement>('.deck-slide:not([hidden]) audio');
        if (slideAudio) slideAudio.play().catch(() => {});
        // A PhET sim opened from the rail: the reader already asked for it, so
        // start loading it rather than asking for a second "Launch" click.
        d.querySelector<HTMLButtonElement>('.phet-launch')?.click();
        // Play the anecdote's little animation (and run its counter) on open.
        const anim = d.querySelector('.anec-anim');
        if (anim) {
          anim.classList.add('is-playing');
          const counter = anim.querySelector<HTMLElement>('[data-counter]');
          if (counter) animateCounter(counter);
        }
        // Nudge lazy viewers (Mol*) now that they're visible + sized.
        requestAnimationFrame(() => {
          window.dispatchEvent(new Event('resize'));
          window.dispatchEvent(new Event('scroll'));
        });
      });
    });
    // Rail thumbnails come straight from RCSB and PubChem. PubChem throttles
    // bursts (about five requests a second), so a lesson with a dozen small
    // molecules loses some thumbnails to 503s and showed broken-image icons.
    // Retry each failure once after a staggered pause; if it fails again, show
    // a neutral hexagon so the row still looks deliberate. The viewer itself
    // loads by ID when opened, so nothing is lost but the preview.
    const THUMB_FALLBACK =
      'data:image/svg+xml,' +
      encodeURIComponent(
        '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 46 46"><rect width="46" height="46" fill="#f4f2ed"/>' +
          '<path d="M23 12l9.5 5.5v11L23 34l-9.5-5.5v-11z" fill="none" stroke="#8a93a6" stroke-width="1.6"/></svg>'
      );
    document.querySelectorAll<HTMLImageElement>('.rail-thumb img').forEach((img, i) => {
      let tries = 0;
      const onFail = () => {
        if (img.src.startsWith('data:')) return;
        if (tries++ === 0) {
          const src = img.src;
          setTimeout(() => { img.src = src + (src.includes('?') ? '&' : '?') + 'r=1'; }, 1200 + i * 250);
        } else {
          img.src = THUMB_FALLBACK;
        }
      };
      img.addEventListener('error', onFail);
      // An image that already failed before this script ran fires no event.
      if (img.complete && img.naturalWidth === 0 && img.currentSrc) onFail();
    });

    // Reveal the "↑ Top" pill only once the reader has scrolled past the hero, so
    // it can never cover the title or the objectives card on a small screen. A
    // scroll listener rather than an IntersectionObserver: IO callbacks don't fire
    // while the document is hidden, which makes the behaviour untestable in a
    // background tab and flaky on restore.
    const toTop = document.querySelector<HTMLElement>('.to-top');
    const hero = document.querySelector<HTMLElement>('.lesson-hero');
    if (toTop && hero) {
      const syncToTop = () => {
        const past = window.scrollY > hero.offsetTop + hero.offsetHeight;
        toTop.classList.toggle('is-visible', past);
      };
      syncToTop();
      window.addEventListener('scroll', syncToTop, { passive: true });
      window.addEventListener('resize', syncToTop, { passive: true });
    }

    // The mobile Explore chips stay sticky for the first ~2 screens of
    // narrative, then release so they never shadow the whole read. Same
    // scroll-listener pattern as .to-top (IO doesn't fire in hidden tabs).
    const explore = document.querySelector<HTMLElement>('.mobile-explore');
    if (explore) {
      const releaseAt = () => explore.offsetTop + 2 * (window.innerHeight || 800);
      let limit = releaseAt();
      const syncExplore = () => {
        explore.classList.toggle('me-released', window.scrollY > limit);
        explore.classList.toggle(
          'is-stuck',
          window.scrollY > explore.offsetTop && window.scrollY <= limit
        );
      };
      syncExplore();
      window.addEventListener('scroll', syncExplore, { passive: true });
      window.addEventListener('resize', () => { limit = releaseAt(); syncExplore(); }, { passive: true });
    }

    document.querySelectorAll<HTMLDialogElement>('dialog.lightbox').forEach((d) => {
      d.addEventListener('click', (e) => { if (e.target === d) d.close(); });
      d.querySelector('[data-close]')?.addEventListener('click', () => d.close());
      d.addEventListener('close', () => {
        d.querySelectorAll<HTMLMediaElement>('audio, video').forEach((m) => m.pause());
        // Reset the anecdote animation so it replays next time the story opens.
        const anim = d.querySelector('.anec-anim');
        if (anim) {
          anim.classList.remove('is-playing');
          const counter = anim.querySelector<HTMLElement>('[data-counter]');
          if (counter) counter.textContent = '0';
        }
      });
    });
  </script>

  <style>
    .lesson-hero { padding: var(--ddp-space-12) var(--ddp-space-6) var(--ddp-space-6); }
    .eyebrow {
      font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs);
      letter-spacing: 0.08em; text-transform: uppercase; color: var(--ddp-color-accent);
      margin: 0 0 var(--ddp-space-2);
    }
    .lesson-hero h1 { font-size: var(--ddp-text-3xl); max-width: 20ch; margin-bottom: var(--ddp-space-3); }
    .summary { max-width: 60ch; font-size: var(--ddp-text-lg); color: var(--ddp-color-ink-soft); }

    .orient {
      display: grid; grid-template-columns: 1.6fr 1fr; gap: var(--ddp-space-6);
      margin-bottom: var(--ddp-space-6); align-items: start;
    }
    @media (max-width: 760px) { .orient { grid-template-columns: 1fr; } }
    .orient-obj { padding: var(--ddp-space-5) var(--ddp-space-6); }
    .orient-obj h2 { font-size: var(--ddp-text-lg); margin: 0 0 var(--ddp-space-3); }
    /* list-style is restated because Tailwind's preflight removes it. */
    .orient-obj ul { margin: 0; padding-left: 1.2rem; list-style: disc; display: flex; flex-direction: column; gap: var(--ddp-space-2); }
    .orient-obj li { font-size: var(--ddp-text-sm); line-height: 1.55; color: var(--ddp-color-ink-soft); padding-left: 0.15em; }
    .orient-obj li::marker { color: var(--ddp-color-muted); }
    /* Stats column: anchored to the card's top edge by a hairline rule and a
       small label, one stat per row, so it reads as the card's companion
       instead of a loose cluster floating beside it. */
    .orient-meta {
      padding: var(--ddp-space-2) 0 var(--ddp-space-2) var(--ddp-space-5);
      border-left: 1px solid var(--ddp-color-line);
    }
    .orient-meta-h {
      margin: 0 0 var(--ddp-space-3);
      font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs);
      letter-spacing: 0.06em; text-transform: uppercase; color: var(--ddp-color-muted);
    }
    .orient-meta ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--ddp-space-3); }
    .orient-meta li { font-size: var(--ddp-text-sm); color: var(--ddp-color-ink-soft); display: flex; align-items: baseline; gap: 0.55em; }
    .orient-meta li span { width: 1.3em; text-align: center; flex: none; }
    .orient-meta b { font-weight: 700; color: var(--ddp-color-primary); font-variant-numeric: tabular-nums; }
    /* Animated explainer: the video gets the reading column's width plus a
       little, sits under the orientation card, and loads nothing until play. */
    .explainer { margin-bottom: var(--ddp-space-8); }
    .explainer-fig { margin: 0; max-width: 880px; }
    .explainer-fig video {
      display: block; width: 100%; height: auto; aspect-ratio: 16 / 9;
      background: #0f1117; border-radius: var(--ddp-radius); box-shadow: var(--ddp-shadow);
    }
    .explainer-fig figcaption { margin-top: var(--ddp-space-3); display: grid; gap: var(--ddp-space-1); }
    .explainer-h { margin: 0; font-family: var(--ddp-font-serif); font-size: var(--ddp-text-lg); color: var(--ddp-color-primary); }
    .explainer-kicker {
      font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); letter-spacing: 0.08em;
      text-transform: uppercase; color: var(--ddp-color-accent); margin-right: 0.4em; vertical-align: 0.15em;
    }
    .explainer-len { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-sm); color: var(--ddp-color-muted); }
    .explainer-note { margin: 0; max-width: 72ch; font-size: var(--ddp-text-xs); line-height: 1.55; color: var(--ddp-color-muted); }

    /* Mobile-only Explore chips (see the note at the markup). Hidden entirely at
       the width where the sticky rail is visible and does the same job. */
    .mobile-explore { display: none; }
    @media (max-width: 900px) {
      .mobile-explore {
        display: block;
        padding: var(--ddp-space-2) var(--ddp-space-6);
        margin-bottom: var(--ddp-space-4);
        /* Sticky through the first stretch of narrative (JS releases it after
           ~2 screens), so the shortcuts are in hand at the first "rotate this
           molecule" reference. */
        position: sticky;
        top: 0;
        z-index: 30;
        background: var(--ddp-color-bg);
        border-bottom: 1px solid transparent;
      }
      .mobile-explore.is-stuck { border-bottom-color: var(--ddp-color-line); }
      .mobile-explore.me-released { position: static; }
      .me-title {
        margin: 0 0 var(--ddp-space-2);
        font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs);
        letter-spacing: 0.06em; text-transform: uppercase; color: var(--ddp-color-primary);
      }
      .me-chips {
        list-style: none; margin: 0; padding: 0;
        display: flex; flex-wrap: wrap; gap: var(--ddp-space-2);
      }
      .me-chips button, .me-chips a {
        display: inline-flex; align-items: center; gap: 0.4em;
        /* 44px min target: these are the primary mobile affordance. */
        min-height: 44px; padding: 0.5em 0.85em;
        font: inherit; font-size: var(--ddp-text-sm); font-weight: 600;
        color: var(--ddp-color-ink); text-decoration: none;
        background: var(--ddp-color-surface);
        border: 1px solid var(--ddp-color-line); border-radius: 999px;
        cursor: pointer;
      }
      .me-chips button:hover, .me-chips a:hover { border-color: var(--ddp-color-accent); }
      .me-chips em { font-style: normal; font-weight: 400; color: var(--ddp-color-muted); }
    }

    /* Two-column layout */
    .lesson-layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 300px;
      gap: var(--ddp-space-8);
      align-items: start;
      padding-top: var(--ddp-space-4);
    }
    @media (max-width: 900px) { .lesson-layout { grid-template-columns: 1fr; } }
    .lesson-main { min-width: 0; }
    .lesson-main h2 { font-size: var(--ddp-text-2xl); }

    .tech-panel { margin-top: var(--ddp-space-12); }
    .tech-grid { display: grid; grid-template-columns: 1fr; gap: var(--ddp-space-3); margin-top: var(--ddp-space-4); }
    .tech { padding: var(--ddp-space-4) var(--ddp-space-5); }
    .tech h3 { margin: 0 0 var(--ddp-space-1); font-size: var(--ddp-text-base); }
    .tech p { margin: 0; font-size: var(--ddp-text-sm); color: var(--ddp-color-ink-soft); }

    /* Sticky resource rail */
    .rail {
      position: sticky;
      top: 84px;
      max-height: calc(100vh - 100px);
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: var(--ddp-space-4);
      padding-right: 2px;
    }
    @media (max-width: 900px) {
      .rail { position: static; max-height: none; margin-top: var(--ddp-space-8); }
    }
    .rail-title {
      margin: 0; font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs);
      letter-spacing: 0.06em; text-transform: uppercase; color: var(--ddp-color-primary);
    }
    .rail-title span { color: var(--ddp-color-muted); }
    .rail-group { display: flex; flex-direction: column; gap: var(--ddp-space-2); }
    .rail-group h3 {
      margin: 0; font-size: var(--ddp-text-xs); text-transform: uppercase;
      letter-spacing: 0.04em; color: var(--ddp-color-muted); font-family: var(--ddp-font-sans);
    }
    .rail-thumb {
      display: flex; align-items: center; gap: var(--ddp-space-3);
      text-decoration: none; color: inherit;
      width: 100%; text-align: left; padding: var(--ddp-space-2); margin: var(--ddp-space-2) 0;
      border: 1px solid var(--ddp-color-line); border-radius: var(--ddp-radius-sm);
      background: var(--ddp-color-surface); cursor: pointer; transition: border-color 0.12s, transform 0.12s, box-shadow 0.12s;
    }
    .rail-thumb:hover { border-color: var(--ddp-color-accent); transform: translateY(-1px); box-shadow: var(--ddp-shadow); }
    .rail-thumb img, .rail-ico {
      width: 46px; height: 46px; flex: none; border-radius: 6px; object-fit: cover;
      background: var(--ddp-color-bg-alt, #f0ede7); border: 1px solid var(--ddp-color-line);
    }
    .rail-ico { display: grid; place-items: center; font-size: 1.2rem; }
    .rail-label {
      display: flex; flex-direction: column; min-width: 0;
      font-size: var(--ddp-text-sm); font-weight: 600; color: var(--ddp-color-ink); line-height: 1.25;
    }
    .rail-label em { font-style: normal; font-weight: 400; font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
    .rail-note { margin: 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); line-height: 1.4; }

    /* Podcast: a small player that lives IN the rail and expands in place, so the
       main reading column keeps scrolling past it while it plays (no modal). */
    .rail-player {
      border: 1px solid var(--ddp-color-line); border-radius: var(--ddp-radius-sm);
      background: var(--ddp-color-surface); overflow: hidden;
      transition: border-color 0.12s, box-shadow 0.12s;
    }
    .rail-player[open] { border-color: var(--ddp-color-accent); box-shadow: var(--ddp-shadow); }
    .rail-player > summary {
      display: flex; align-items: center; gap: var(--ddp-space-3);
      padding: var(--ddp-space-2); cursor: pointer; list-style: none;
    }
    .rail-player > summary::-webkit-details-marker { display: none; }
    .rail-player:not([open]) > summary:hover { border-color: var(--ddp-color-accent); }
    .rail-player-body { padding: 0 var(--ddp-space-2) var(--ddp-space-2); }
    .rail-player-body .rail-note { margin-top: var(--ddp-space-2); }

    /* Lecture-slides rail item: an actual mini slide viewer (preview the slide). */
    .rail-slidepreview {
      display: block; width: 100%; text-align: left; padding: 0; cursor: pointer; overflow: hidden;
      border: 1px solid var(--ddp-color-line); border-radius: var(--ddp-radius-sm);
      background: var(--ddp-color-surface); transition: border-color 0.12s, transform 0.12s, box-shadow 0.12s;
    }
    .rail-slidepreview:hover { border-color: var(--ddp-color-accent); transform: translateY(-1px); box-shadow: var(--ddp-shadow); }
    .rail-slidepreview img { display: block; width: 100%; aspect-ratio: 22 / 17; object-fit: cover; background: #fff; }
    .rail-slidepreview .rail-label { padding: var(--ddp-space-2) var(--ddp-space-3); }

    /* Styling for collapsible rail elements */
    .rail-group h3 { margin: 0; }
    .rail-toggle {
      appearance: none;
      width: 100%;
      padding: 14px 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      font: inherit;
      font-size: 16px;
      color: var(--text);
      border: 1px solid var(--ddp-color-line); border-radius: var(--ddp-radius-sm);
      border-radius: 10px;
      cursor: pointer;
      text-align: left;
      transition:
        background 120ms ease,
        border-color 120ms ease;
    }
    .rail-toggle:hover { background: var(--surface-hover); border-color: var(--border-hover); }
    .rail-toggle:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
    .rail-toggle span[aria-hidden] { transition: transform 160ms ease; }
    .rail-toggle[aria-expanded="true"] span[aria-hidden] { transform: rotate(180deg); }
    .rail-btn { font-family: var(--ddp-font-mono),serif; font-size: var(--ddp-text-sm);}

    /* Lightbox dialog */
    .lightbox {
      border: none;
      padding: 0;
      border-radius: var(--ddp-radius);
      width: min(1000px, 94vw);
      max-width: 94vw;
      max-height: 92vh;
      overflow: auto;
      margin: auto;
      background: var(--ddp-color-surface);
      box-shadow: 0 24px 70px rgba(20, 22, 30, 0.35);
    }
    .lightbox::backdrop { background: rgba(20, 22, 30, 0.62); backdrop-filter: blur(2px); }
    .lightbox-head {
      position: sticky; top: 0; z-index: 2;
      display: flex; align-items: center; justify-content: space-between;
      padding:
        clamp(0.75rem, 1.5vw, 1rem)
        clamp(1rem, 2vw, 1.5rem);
      border-bottom: 1px solid var(--ddp-color-line);
      background: var(--ddp-color-surface);
      font-family: var(--ddp-font-serif); font-weight: 600; color: var(--ddp-color-primary);
    }
    .lightbox-close {
      border: 1px solid var(--ddp-color-line); background: var(--ddp-color-surface);
      width: 32px; height: 32px; border-radius: 50%; cursor: pointer; font-size: 0.9rem;
      color: var(--ddp-color-ink-soft); flex: none;
    }
    .lightbox-close:hover { border-color: var(--ddp-color-accent); color: var(--ddp-color-accent); }
    .lightbox-body { padding: var(--ddp-space-3); }
    .level-body p { font-size: var(--ddp-text-base); line-height: 1.65; margin: 0 0 var(--ddp-space-4); }
    .level-body p:last-child { margin-bottom: 0; }
    .anec-source { font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); font-style: italic; }

    /* Scientist profile (inside lightbox) */
    .profile { display: grid; grid-template-columns: 160px 1fr; gap: var(--ddp-space-6); align-items: start; }
    .profile.no-photo { grid-template-columns: 1fr; }
    /* On a phone the stacked portrait used to fill the dialog's full width and
       push the text a whole screen down; a small portrait keeps it in view. */
    @media (max-width: 600px) {
      .profile { grid-template-columns: 1fr; gap: var(--ddp-space-4); }
      .profile-photo { max-width: 150px; }
    }
    .profile-photo { width: 100%; border-radius: var(--ddp-radius); border: 1px solid var(--ddp-color-line); }
    .profile-text h3 { margin: 0; font-size: var(--ddp-text-xl); }
    .profile-dates { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-sm); color: var(--ddp-color-muted); font-weight: 400; }
    .profile-contribution { margin: var(--ddp-space-2) 0 0; color: var(--ddp-color-ink-soft); }
    .profile-story { margin: var(--ddp-space-4) 0 0; line-height: 1.65; }
    .profile-quotes { list-style: none; padding: 0; margin: var(--ddp-space-4) 0 0; display: flex; flex-direction: column; gap: var(--ddp-space-3); }
    .profile-quotes blockquote {
      margin: 0; padding: 0 0 0 var(--ddp-space-4); border-left: 3px solid var(--ddp-color-accent);
      font-family: var(--ddp-font-serif); font-style: italic; font-size: var(--ddp-text-base);
    }
    .profile-source { margin: var(--ddp-space-4) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); display: flex; gap: 0.5em; align-items: center; flex-wrap: wrap; }

    /* Hidden until the reader has actually left the top of the page. It used to
       render immediately and, on a phone, sat on top of the objectives card. */
    .to-top {
      position: fixed; right: var(--ddp-space-6); bottom: var(--ddp-space-6); z-index: 40;
      font-size: var(--ddp-text-sm); font-weight: 600; text-decoration: none;
      color: var(--ddp-color-surface); background: var(--ddp-color-primary);
      border-radius: 999px; padding: 0.5em 0.9em; box-shadow: var(--ddp-shadow);
      opacity: 0; visibility: hidden; transition: opacity 0.18s ease, visibility 0.18s;
    }
    .to-top.is-visible { opacity: 0.85; visibility: visible; }
    .to-top:hover { opacity: 1; text-decoration: none; }
    /* Keep the pill clear of the last line of content on narrow screens. */
    @media (max-width: 900px) { .lesson-layout { padding-bottom: var(--ddp-space-12); } }
    @media (prefers-reduced-motion: reduce) { .to-top { transition: none; } }

    /* Approved layout (2026-08-13): on a phone the opening burned 1.5 screens
       before the first sentence. The objectives stay; their treatment shrinks,
       and the meta row goes — the Explore chips just below repeat it exactly.
       This block sits LAST in the stylesheet: media queries add no specificity,
       so placed earlier the base .orient-meta { display:flex } would win. */
    @media (max-width: 900px) {
      .lesson-hero { padding-top: var(--ddp-space-8); }
      .orient { margin-bottom: var(--ddp-space-4); grid-template-columns: 1fr; }
      .orient-meta { display: none; }
      .orient-obj { padding: var(--ddp-space-3) var(--ddp-space-4); }
      .orient-obj h2 {
        font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs);
        letter-spacing: 0.06em; text-transform: uppercase;
        color: var(--ddp-color-primary); margin: 0 0 var(--ddp-space-2);
      }
      .orient-obj ul { gap: var(--ddp-space-1); }
      .orient-obj li { font-size: var(--ddp-text-xs); line-height: 1.5; }
    }

    /* Fixing padding issues on elements */
    .orient-pad-left { padding-inline-start: var(--ddp-space-3); }
    .orient-pad { padding-inline: var(--ddp-space-3); }

    /* Toggle class to lock scrolling on outer window while lightbox active */
    body.scroll-locked {
      overflow: hidden;
    }
    .lock-scroll {
      overflow-y: auto;
      overscroll-behavior: contain;
    }
  </style>
  <script>
    /*
    Lock scroll on outside window while elements with "lock-scroll" class are active
        - Currently present on all lightbox elements
    */
    document.querySelectorAll('.lock-scroll').forEach((element) => {
      element.addEventListener('mouseenter', () => {
        document.body.classList.add('scroll-locked');
      });
      element.addEventListener('mouseleave', () => {
        document.body.classList.remove('scroll-locked');
      });
    });

    /*
    Hide sub-elements for categories in the "Explore" nav bar
    */
    document.querySelectorAll('.rail-toggle').forEach((toggle) => {
      toggle.addEventListener('click', () => {
        const targetId = toggle.getAttribute('aria-controls');
        if (!targetId) return;

        const items = document.getElementById(targetId);
        if (!items) return;

        const expanded = toggle.getAttribute('aria-expanded') === 'true';

        toggle.setAttribute('aria-expanded', String(!expanded));
        items.hidden = expanded;
      });
    });
  </script>
</BaseLayout>
