---
import { SITE_ORIGIN } from '../../lib/site-host.mjs';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import MolViewer from '../../components/MolViewer.astro';
import PhetEmbed from '../../components/PhetEmbed.astro';
import YouTubeEmbed from '../../components/YouTubeEmbed.astro';
import SpotifyEmbed from '../../components/SpotifyEmbed.astro';
import QuizBlock from '../../components/QuizBlock.astro';
import ClassBar from '../../components/ClassBar.astro';
import DesignAnswer from '../../components/DesignAnswer.astro';
import { anchorsFor } from '../../lib/quiz-anchors';
import SourcesFooter from '../../components/SourcesFooter.astro';
import AnecdoteAnimation from '../../components/AnecdoteAnimation.astro';
import FinishLine from '../../components/FinishLine.astro';
import MethodPopout from '../../components/MethodPopout.astro';
import AbbrNote from '../../components/AbbrNote.astro';
import LessonLadder from '../../components/LessonLadder.astro';
import SupportsSwitch from '../../components/SupportsSwitch.astro';
import SubSupEnhancer from '../../components/SubSupEnhancer.astro';
import ListenPlayer from '../../components/ListenPlayer.astro';
import LessonShare from '../../components/LessonShare.astro';
import FilmTranscript from '../../components/FilmTranscript.astro';
import LessonPlayAll from '../../components/LessonPlayAll.astro';
import LessonFilmNav from '../../components/LessonFilmNav.astro';
import FlashcardDeck from '../../components/FlashcardDeck.astro';
import CardsPrompt from '../../components/CardsPrompt.astro';
import HighlightLayer from '../../components/HighlightLayer.astro';
import LessonHelpers from '../../components/LessonHelpers.astro';
import { helperAllowed } from '../../lib/helper-lesson.mjs';
import LessonLinks from '../../components/LessonLinks.astro';
import BuildsOn from '../../components/BuildsOn.astro';
import HopSentence from '../../components/hop/HopSentence.astro';
import HopStandards from '../../components/hop/HopStandards.astro';
import { lessonHop } from '../../lib/hop';
import LessonTime from '../../components/LessonTime.astro';
import LessonParts from '../../components/LessonParts.astro';
import LessonStories from '../../components/LessonStories.astro';
import ActivityCard from '../../components/ActivityCard.astro';
import type { Deck } from '../../lib/flashcards';
import { feedbackUrl } from '../../lib/feedback';
import { COURSES, courseOf, courseHref } from '../../data/courses';
import { methodsFor, methodHref, filmLength } from '../../data/methods';
import { LESSON_GAMES, gameHref, unitReviewFor, unitReviewHref } from '../../data/lesson-games';
import { SETS as MCAT_SETS } from '../../lib/mcat';
import { filmDescription, metaDescription } from '../../lib/meta';
import { filmIsoDuration } from '../../lib/films';
import { recordFor } from '../../lib/production-record';
import { lessonTime } from '../../lib/lesson-time';
import { linesFor, endingsFor, say, plural } from '../../lib/lesson-copy';
import { skimOf, mainIdeaOf, filmTakeawaysOf, wordsIn } from '../../lib/skim';
import { rewrittenFor } from '../../lib/rewritten';
import { sideHopsFor } from '../../lib/side-hops';
import PredictAgain from '../../components/PredictAgain.astro';
import { predictsOf } from '../../lib/predicts';

export async function getStaticPaths() {
  // Drafts must not generate a route. The homepage and sitemap already filter
  // them; without the same filter here, a draft stays reachable by direct URL
  // even though nothing links to it.
  // Exception: `astro dev` renders drafts so an author can read one before it is
  // published. A production build never does, and scripts/check-drafts.mjs still
  // fails the build if a draft reaches dist/.
  const lessons = await getCollection('lessons', ({ data }) => import.meta.env.DEV || !data.draft);
  return lessons.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
// Lesson order within this lesson's own course, same sort and numbering as its course
// page (the homepage, for biochemistry). Previous and next never cross into another
// course. Drafts count only in `astro dev`, where they are the pages being previewed.
const allLessons = (await getCollection('lessons', ({ data }) =>
  data.course === entry.data.course && (import.meta.env.DEV || !data.draft))).sort(
  (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99),
);
const hookFor = (l: (typeof allLessons)[number]) =>
  (l.data as { hook?: string }).hook ?? l.data.summary.split(/(?<=[.?!])\s+/)[0];
const hook = hookFor(entry);
const lastHookSentence = entry.data.hook?.trimEnd().endsWith('?')
  ? [...new Intl.Segmenter('en', { granularity: 'sentence' }).segment(hook)].at(-1)
  : undefined;
const question = lastHookSentence?.segment.trim();
const finding = lastHookSentence ? hook.slice(0, lastHookSentence.index).trim() : '';
const navOf = (l: (typeof allLessons)[number] | undefined) =>
  l ? { slug: l.data.slug, title: l.data.title, hook: hookFor(l), n: allLessons.indexOf(l) + 1 } : undefined;
const lessonIdx = allLessons.findIndex((l) => l.data.slug === entry.data.slug);
const prevNav = navOf(allLessons[lessonIdx - 1]);
const nextNav = navOf(allLessons[lessonIdx + 1]);
// "Next lesson's film" under this lesson's last film (LessonFilmNav.astro, 2026-11-24): the first later
// lesson in this course with an opening film, in the same order as previous and next.
const nextFilmLesson = allLessons.slice(lessonIdx + 1).find((l) => l.data.explainer);
const nextFilm = nextFilmLesson
  ? { href: `/lessons/${nextFilmLesson.data.slug}/#explainer`, lesson: nextFilmLesson.data.title, film: nextFilmLesson.data.explainer!.title }
  : undefined;
// After a course's last lesson, hand off to the next course in COURSES (its order is the
// suggested path). Only a course with a published lesson counts, and Biology Together does
// not hand off: its pages are for the grown-up, and the next course is written for students.
let nextCourse: { title: string; tagline: string; href: string } | undefined;
if (!nextNav && courseOf(entry.data.course).tier !== 'families') {
  const live = new Set((await getCollection('lessons', ({ data }) => !data.draft)).map((l) => l.data.course));
  const after = COURSES.slice(COURSES.findIndex((c) => c.slug === entry.data.course) + 1).find((c) => live.has(c.slug));
  if (after && COURSES.some((c) => c.slug === entry.data.course)) nextCourse = { title: after.title, tagline: after.tagline, href: courseHref(after.slug) };
}
const games = LESSON_GAMES[entry.data.slug] ?? [];
const unitReview = unitReviewFor(entry.data.slug);
const GAME_CODES: Record<string, string> = { ledger: 'LR', autopsy: 'MA', wire: 'WC', foundry: 'FF', mixing: 'MB', gauntlet: 'MG' };
const { Content, headings } = await render(entry);
const lesson = entry.data;
// Flashcards: a static deck per lesson, written ahead of time by scripts/flashcards/ (no model at runtime).
const DECKS = import.meta.glob<{ default: Deck }>('../../data/flashcards/*.json', { eager: true });
const deck = Object.values(DECKS).map((m) => m.default).find((d) => d.slug === entry.data.slug && d.cards?.length);
const lessonFigures = [...(entry.body ?? '').matchAll(/<(?:LessonFigure|ScaffoldFigure)\s[^>]*?src="([^"]+)"[^>]*?alt="([^"]+)"/g)].map((m) => ({ src: m[1], alt: m[2] }));
const course = courseOf(lesson.course);
// Skim version (2026-11-11): /lessons/<slug>/skim/ shows the headings, figures with their take-home
// captions and the guiding idea. Since 2026-11-20 the same skim is also a stop on this page (the
// "Skim" stop of LessonTime); the separate page stays for print, for scripts off (it is linked from
// a <noscript> line) and for the course skim pages.
const skim = skimOf(entry.body ?? '', headings);
const hasSkim = skim.figureCount > 0 || [lesson.explainer, ...lesson.films].some((f) => f?.takeaways?.length);
// "Rewritten on …" under the title, from src/data/recently-rewritten.json (scripts/rewritten-shelf.mjs).
const rewritten = rewrittenFor(lesson.slug);
// Side Hops (2026-11-18): stories and audio beside the lesson, for lessons with a file in src/data/side-hops/.
const sideHops = sideHopsFor(lesson.slug);
// The lesson's Predict questions, listed once more after the text (2026-11-23). Not on the hands-on
// guides, whose Predict is a step for the grown-up to read out.
const predicts = course.tier === 'families' ? [] : await predictsOf(entry.body ?? '', headings);
// Method films from the shared library that this lesson teaches or relies on.
const methods = methodsFor(entry.data.slug);
const isHighSchool = course.tier === 'highschool';
// The hop sentence (2026-11-20): which idea this lesson teaches and at what level, with a simpler
// and a deeper version, from the hop graph. It takes over from the "Where this lesson sits" card
// and from the reverse "review it at high school level" line; a school lesson the graph has no
// record for keeps the old card.
const hasHop = ((await lessonHop(lesson.slug))?.ideas.length ?? 0) > 0;

const phetSims = lesson.simulations.filter((s) => s.type === 'phet');
const localSims = lesson.simulations.filter((s) => s.type === 'local');
// The in-text island name (strip any parenthetical), used for the rail caption.
const localSimNames = localSims.map((s) => s.title.split('(')[0].trim());
const hasQuiz = lesson.practiceQuestions.length > 0 || lesson.mcatQuestions.length > 0;
const qCount = lesson.practiceQuestions.length + lesson.mcatQuestions.length;
const quizAnchors = hasQuiz ? anchorsFor(entry.body ?? '', headings, [...lesson.practiceQuestions, ...lesson.mcatQuestions]) : [];
// The main (##) section headings, as plain links built at deploy time (the Contents pill).
const sections = headings.filter((h) => h.depth === 2 && h.slug && h.text.trim());
// How long the lesson takes, and the stops of "How long have you got?" (src/lib/lesson-time.ts:
// reading, films and Side Hops audio, summed once; the same whole-lesson figure is on course cards,
// in /catalog.json and in JSON-LD below).
// The main idea a skim leads with: the summary's first sentence that states something (a few
// summaries open with a question).
const { text: idea, question: ideaIsQuestion, describes: ideaDescribes } = mainIdeaOf(lesson);
const ideaLabel = ideaIsQuestion ? 'The question.' : ideaDescribes ? `In this ${course.tier === 'families' ? 'activity' : 'lesson'}.` : 'The main idea.';
const skimWords = skim.words + wordsIn(idea) + filmTakeawaysOf(lesson).reduce((n, f) => n + wordsIn(f.takeaways.join(' ')), 0);
// Figures a skim shows: worksheet figures (ScaffoldFigure, blank labels to fill in) are left out.
const skimFigures = [...(entry.body ?? '').matchAll(/<LessonFigure\b/g)].length;
const time = lessonTime({
  tier: course.tier, body: entry.body ?? '', estMinutes: lesson.estMinutes, simulations: lesson.simulations.length,
  explainer: lesson.explainer, films: lesson.films, questions: qCount,
  h2: headings.filter((h) => h.depth === 2), skimWords, skimFigures,
  stories: sideHops ? { audioSec: sideHops.audio.durationSec, hops: sideHops.hops } : undefined,
});
const lines = linesFor(time, { figures: skimFigures, laterLooks: !!lesson.activity?.followUp });
const endings = endingsFor(time);
const stopOf = (id: string) => time.stops.find((s) => s.id === id);
const isGuide = course.tier === 'families';
/* THE SWITCH FOR CHRIS. Take-homes under the opening film in the Lesson stop:
     true   always open (his earlier rule, 2026-11-10: the text leans on them)
     false  folded to one line until the film has been watched, or closed after playing
            (chosen 2026-11-22)
   They are open in the Skim and Films stops either way. */
const TAKE_HOMES_OPEN = false;
// MCAT practice, linked forward: the practice page links every question back to its lesson; this
// inverts that at deploy time. The lesson's own MCAT-style questions (college lessons only, as on
// /mcat/practice/) plus passage-set questions whose lesson link names this lesson.
const mcatDiscrete = course.tier !== 'highschool' && course.tier !== 'families' ? lesson.mcatQuestions.length : 0;
const mcatPassage = MCAT_SETS.reduce((n, st) => n + st.questions.filter((q) => q.lesson.slug === lesson.slug).length, 0);
const mcatCount = mcatDiscrete + mcatPassage;
const ex = lesson.explainer;
const exLen = ex ? `${Math.floor(ex.durationSec / 60)}:${String(Math.round(ex.durationSec % 60)).padStart(2, '0')}` : '';

// Thumbnail helpers for the rail.
const rcsbThumb = (id: string) => `https://cdn.rcsb.org/images/structures/${id.toLowerCase()}_assembly-1.jpeg`;
const pubchemThumb = (id: string) => `https://pubchem.ncbi.nlm.nih.gov/rest/pug/compound/cid/${id}/PNG`;
const ytThumb = (id: string) => `https://i.ytimg.com/vi/${id}/hqdefault.jpg`;
const structId = (s: { source: string; id: string }) => `lb-struct-${s.source}-${s.id}`.replace(/[^a-zA-Z0-9-]/g, '');
const LEVEL_ICONS: Record<string, string> = { eli5: '🧸', highschool: '🎒', college: '🎓', grad: '🔬', grade7: '🌱', bio2: '🧪' };
const paras = (t: string) => t.split(/\n\n+/).map((p) => p.trim()).filter(Boolean);
const lessonLd = {
  '@context': 'https://schema.org',
  '@type': 'LearningResource',
  name: lesson.title,
  description: lesson.summary,
  educationalLevel: course.tier === 'families' ? 'primary school (ages 5 to 10), for parents and teachers' : isHighSchool ? (course.ladderStep === 1 ? 'middle school' : 'high school') : 'undergraduate',
  learningResourceType: course.tier === 'families' ? 'hands-on activity guide' : 'interactive lesson',
  inLanguage: 'en',
  about: lesson.courseChapter,
  isPartOf: { '@type': 'Course', name: course.title, provider: { '@type': 'Person', name: 'Christopher Deppmann' } },
  // For search engines and AI agents (2026-11-09): where it lives, that it is free, what it teaches, and its plain-text copy.
  url: `${SITE_ORIGIN}/lessons/${lesson.slug}/`,
  isAccessibleForFree: true,
  author: { '@type': 'Person', name: 'Christopher Deppmann' },
  copyrightHolder: { '@type': 'Person', name: 'Christopher Deppmann' },
  // The site's licence page: CC BY-NC-SA 4.0 for the text, figures and films, with what it leaves out (scientist profiles).
  license: `${SITE_ORIGIN}/license/`,
  ...(lesson.objectives.length ? { teaches: lesson.objectives } : {}),
  // The whole lesson: reading, films and Side Hops audio, the figure the page itself prints.
  timeRequired: `PT${time.whole}M`,
  encoding: { '@type': 'MediaObject', encodingFormat: 'text/markdown', contentUrl: `${SITE_ORIGIN}/lessons/${lesson.slug}.md` },
};
const breadcrumbsLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { name: 'Home', item: `${SITE_ORIGIN}/` },
    { name: course.title, item: `${SITE_ORIGIN}${courseHref(course.slug)}` },
    { name: lesson.title, item: lessonLd.url },
  ].map((step, i) => ({ '@type': 'ListItem', position: i + 1, ...step })),
};
const record = recordFor(lesson.slug);
const videoLd = (film: { src: string; poster: string; durationSec: number }, name: string, description: string, id?: string) => ({
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name,
  description,
  thumbnailUrl: new URL(film.poster, SITE_ORIGIN).href,
  contentUrl: new URL(film.src, SITE_ORIGIN).href,
  // The record dates the level-up, and records the length of the opening and chapter films.
  // Profile films have their lengths in the scientist card's frontmatter.
  uploadDate: record?.levelUp?.shipped,
  duration: filmIsoDuration(record?.films.find((f) => f.id === id)?.durationSec ?? film.durationSec),
});
const videosLd = [
  ...(ex ? [videoLd(ex, ex.title, filmDescription(ex, lesson.summary), 'explainer')] : []),
  ...lesson.films.map((f) => videoLd(f, f.title, filmDescription(f, lesson.summary), f.id)),
  ...lesson.scientists.flatMap((s) => s.film ? [videoLd(s.film, s.name, s.contribution)] : []),
];
---

<BaseLayout title={`${lesson.title} — STEMhop`} description={metaDescription(lesson.summary, lesson.hook)} ogType="article" jsonLd={[lessonLd, breadcrumbsLd, ...videosLd]}
  ogImage={ex?.poster ?? lesson.films[0]?.poster}
  alternates={[{ type: 'text/markdown', href: `/lessons/${lesson.slug}.md`, title: 'This lesson as plain Markdown' }]}>
  <article id="top" data-course-title={course.title} data-cards-lesson={deck ? lesson.slug : undefined}>
    <header class="lesson-hero wrap">
      <ClassBar slug={lesson.slug} />
      <DesignAnswer />
      <SubSupEnhancer />
      {lesson.draft && (
        <p class="draft-banner" role="note">
          Draft. Visible only in local preview, and not yet reviewed by a person.
        </p>
      )}
      <p class="eyebrow"><a class="eyebrow-course" href={courseHref(course.slug)}>{course.title}</a> · {lesson.courseChapter.replace(`${course.title} · `, '')}</p>
      <h1>{lesson.title}</h1>
      {/* "Rewritten on" (2026-11-20): in the first screen only for a device that has notes or highlights
          on this lesson, the readers it warns. The page script shows it. Everyone has it in "About this
          lesson" and at the foot. */}
      {rewritten && (
        <p class="rewritten-note" data-lt-rewritten hidden>Rewritten on <time datetime={rewritten.date}>{rewritten.label}</time>: {rewritten.note}. Your notes and highlights stay, but the text around them may have moved.</p>
      )}
      {lesson.underReview.length > 0 && (
        <div class="under-review" role="note">
          {/* Folded (2026-11-23): the tag and one line stay in view at every stop; what is being
              checked, the report link and the full list open in a plain <details>, no script. */}
          <p><span class="under-review-tag">Under review</span> {lesson.underReview.length === 1 ? 'One part' : `${say(lesson.underReview.length).replace(/^./, (c) => c.toUpperCase())} parts`} of this {time.noun} {lesson.underReview.length === 1 ? 'is' : 'are'} still being checked.</p>
          <details class="under-review-more">
            <summary>What is being checked</summary>
            <ul>{lesson.underReview.map((r) => <li>{r}</li>)}</ul>
            <p>The text stays up while the check is done. If you spot a problem, <a href={feedbackUrl(lesson.title)} target="_blank" rel="noopener">report it</a>. <a href="/under-review/">All lessons under review</a>.</p>
          </details>
        </div>
      )}
      {/* Only the hook shows here (2026-11-08, "get to the material quicker"). */}
      <p class="summary">
        {question ? <><strong>{question}</strong>{finding && <span class="hook-finding">{finding}</span>}</> : hook}
      </p>

      {/* One question, one row (2026-11-20). Listen and "Play all films" are unchanged components;
          each sits on the line of the stop it plays. */}
      <LessonTime slug={lesson.slug} time={time} lines={lines} skimHref={hasSkim && !isGuide ? `/lessons/${lesson.slug}/skim/` : undefined}>
        <ListenPlayer slot="play-lesson" slug={lesson.slug} />
        {time.filmCount > 1 && <LessonPlayAll slot="play-films" minutes={time.filmMin} />}
      </LessonTime>

      {/* "Continue at…": filled in by the script at the foot of the page from this device's storage,
          when the reader left this lesson part-way. Hidden, and simply absent, without JavaScript. */}
      <p class="resume" data-resume={lesson.slug} data-lt-only="lesson" hidden><a data-resume-link href="#top">Continue at: <span data-resume-title></span> →</a></p>

      {/* The hop sentence: the same idea one level simpler (a short version opens in place) and one
          level deeper, at every stop. Plain HTML and two native folds; see HopSentence.astro. */}
      <HopSentence slug={lesson.slug} />

      {/* One closed fold for everything that is about the lesson rather than the lesson itself. It
          replaces the Overview fold and gathers what used to stand between the hook and the text:
          the parts with their minutes, goals, help with the tasks, standards and where the lesson
          sits, what it builds on, and the class code. A plain <details>, so it works with scripts off. */}
      <details class="about" data-lt-about data-lt-only="lesson">
        <summary>About this {time.noun} <span class="about-has">{isGuide ? 'what is in it' : [lesson.objectives.length > 0 && 'goals', lesson.supports && 'help with the tasks', lesson.ladder && 'standards', 'parts'].filter(Boolean).join(', ')}</span></summary>
        <div class="about-body">
          <nav aria-labelledby="about-parts-h" data-lesson-toc>
            <h2 class="about-h" id="about-parts-h">Parts of this {time.noun}</h2>
            <LessonParts time={time} openingFilm={ex} />
          </nav>
          {lesson.objectives.length > 0 && (
            <>
              <h2 class="about-h">What you'll learn</h2>
              <ul class="about-goals">{lesson.objectives.map((o) => <li>{o}</li>)}</ul>
            </>
          )}
          {lesson.supports && (
            <>
              <h2 class="about-h">Help with the tasks</h2>
              <SupportsSwitch />
            </>
          )}
          <BuildsOn slug={lesson.slug} />
          {/* Standards and the essential question, in plain type, on the school lessons teachers plan
              by. The levels themselves are the hop sentence under the control row. */}
          {lesson.ladder && (hasHop ? <HopStandards ladder={lesson.ladder} /> : <LessonLadder ladder={lesson.ladder} explainLevels={lesson.explainLevels} step={course.ladderStep ?? 2} />)}
          {/* Drafts have no public address, so they get no code. */}
          {!lesson.draft && <div class="about-share"><LessonShare slug={lesson.slug} activity={isGuide} /></div>}
          {rewritten && (
            <p class="about-rewritten">Rewritten on <time datetime={rewritten.date}>{rewritten.label}</time>: {rewritten.note}. Notes and highlights stay, but the text around them may have moved.</p>
          )}
        </div>
      </details>
    </header>

    {/* Ages 5 to 10 guides: what to gather, how long and where come before the film, at every stop.
        The same card is in the lesson body (for the Markdown copy); that one is hidden on the page. */}
    {isGuide && lesson.activity && (
      <div class="wrap act-top"><div class="prose-col"><ActivityCard activity={lesson.activity} headingId="act-card-top-h" /></div></div>
    )}

    {/* The Skim stop leads with the lesson's main idea (the first sentence of its summary). */}
    <div class="wrap" data-lt-only="skim"><p class="lt-idea"><span class="lt-idea-k">{ideaLabel}</span> {idea}</p></div>

    {/* The Films stop folds the section headings away, so it gets a heading of its own; each film's
        title is a level 3 heading to a screen reader. */}
    {time.filmCount > 0 && <h2 class="visually-hidden" data-lt-only="films">{time.filmCount === 1 ? 'The film' : 'The films'}</h2>}

    {ex && (
      <section class="wrap explainer" id="explainer" aria-labelledby="explainer-h" data-lt-only="lesson films skim">
        {/* A compact row (2026-11-08): poster thumbnail, title and length; the player opens in place on
            a tap and starts playing. A plain <details>, so it opens without JavaScript too. In the
            Films stop the row is open and its summary hidden: the same player, not a copy. */}
        <details class="ex-row" data-ex-row>
          <summary>
            <img class="ex-thumb" src={ex.poster} alt="" width="160" height="90" loading="lazy" decoding="async" />
            <span class="ex-txt"><span class="explainer-kicker">▶ Watch</span> <span class="explainer-h" id="explainer-h">{ex.title}</span> <span class="explainer-len">· {exLen}</span></span>
          </summary>
        <figure class="explainer-fig">
          <video controls preload="none" playsinline poster={ex.poster} width="1920" height="1080" data-listen-film={ex.title} data-listen-film-sec={ex.durationSec}>
            <source src={ex.src} type="video/mp4" />
            <track kind="captions" src={ex.captions} srclang="en" label="English" />
            Your browser cannot play this video. <a href={ex.src}>Download the explainer (MP4)</a>.
          </video>
          <figcaption class="explainer-cap" data-lt-only="films"><span role="heading" aria-level="3">{ex.title}</span> <span class="explainer-len">· {exLen}</span></figcaption>
          {ex.predatesCorrection && (
            <p class="film-predates"><strong>This film was made before a correction to the lesson text.</strong> {ex.predatesCorrection}</p>
          )}
        </figure>
        {/* The film's words as text, closed until asked for. Its own search region: see the note at the prose column. */}
        <div data-pagefind-body><FilmTranscript captions={ex.captions} title={ex.title} id="explainer" /></div>
        </details>
        {/* Take-homes stay visible with the player closed: the lesson text leans on them instead of
            re-telling the film. The other setting of TAKE_HOMES_OPEN folds them to one line until the
            film has been watched, or closed after playing. */}
        {ex.takeaways && ex.takeaways.length > 0 && (TAKE_HOMES_OPEN ? (
          <div class="film-takeaways" aria-label="Key points from the film">
            <p class="film-takeaways-h">From the film</p>
            <ul>{ex.takeaways.map((t) => <li>{t}</li>)}</ul>
          </div>
        ) : (
