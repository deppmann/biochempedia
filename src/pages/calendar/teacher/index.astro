---
/* /calendar/teacher/ (high school Biology) and /calendar/teacher/<course>/: a SAMPLE class plan
   by date. Nothing here touches a real class. The real plan belongs inside /teach/class/ as a
   "By date" tab and is not built yet. Drawn here as the course in order with its standards;
   the browser lays it on the days the teacher sets. */
import CalendarShell from '../../../components/CalendarShell.astro';
import { courses } from '../../../lib/calendar/data';
import type { CourseData } from '../../../lib/calendar/engine';
import { renderTeacher } from '../../../lib/calendar/render';

const HOME = 'high-school-biology';
const all = await courses();
const choices = all.map((c) => ({ s: c.s, t: c.t, level: c.level }));
const course: CourseData = all.find((c) => c.s === HOME)!;
const isDefault = true;
const html = renderTeacher(course, choices, undefined, {});
---
<CalendarShell title={`A sample class plan by date: ${course.t}`} role="teacher" html={html} data={{ course, choices }} isDefault={isDefault} known={choices.map((c) => c.s)} current={HOME}
  description={`A sample class plan for ${course.t}: the lessons laid on the days your class meets, with breaks and the standard each lesson serves. It prints. Nothing is saved to a class.`} />
