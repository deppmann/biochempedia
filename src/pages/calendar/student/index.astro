---
/* /calendar/student/: for myself, before a course is chosen. A device with a saved plan, or one
   that was last reading a course, is taken to that course's page; otherwise this list. */
import CalendarShell from '../../../components/CalendarShell.astro';
import { learnerCourses, lessonCourse } from '../../../lib/calendar/data';
import { roleRow } from '../../../lib/calendar/render';

const courses = await learnerCourses();
const choices = courses.map((c) => ({ s: c.s, t: c.t, level: c.level }));
const levels = [...new Set(choices.map((c) => c.level))];
---
<CalendarShell title="Keep up with a course" role="student" data={{ choices, lessonCourse: await lessonCourse() }}
  description="Pick a course and keep your next lesson in front of you, with its true length. No dates unless you ask for them, no account, and a lesson you don't get to simply waits.">
  <div class="cal-page">
    <header class="cal-top">
      <Fragment set:html={roleRow('student')} />
      <h1>What do you want to keep up with?</h1>
      <p class="cal-lede">Pick a course and this page keeps your next lesson in front of you. Nothing has a date unless you ask for one, and a lesson you don’t get to simply waits.</p>
    </header>
    <div class="cal-pick">
      {levels.map((lv) => (
        <section>
          <h2>{lv}</h2>
          <ul>{choices.filter((c) => c.level === lv).map((c) => <li><a href={`/calendar/student/${c.s}/`}>{c.t}</a></li>)}</ul>
        </section>
      ))}
      <section>
        <h2>A path</h2>
        <ul><li><a href="/calendar/student/mcat/">The MCAT path: biology and biochemistry</a></li></ul>
      </section>
    </div>
    <p class="cal-foot">Free, with no account. The plan stays on this device.</p>
  </div>
</CalendarShell>
