---
/* A printable tree diary for the Biology Together activity Adopt a Tree: twelve month boxes on
   one US Letter page. Plain HTML; the Print button is the only script, and the page says how to
   print without it. The sheet itself is src/components/PrintDiary.astro, which other
   repeat-over-time activities can reuse with their own title, labels and prompts. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PrintDiary from '../../components/PrintDiary.astro';

const MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
---

<BaseLayout
  title="My tree diary: a printable sheet — STEMhop"
  description="A one-page printable diary for the Adopt a Tree activity: twelve month boxes to draw one tree and write what its leaves or buds are doing and one thing that changed."
>
  <article class="wrap pd-page" style="padding-top: var(--ddp-space-8); max-width: 860px">
    <p class="pd-screen pd-eyebrow"><a href="/lessons/adopt-a-tree/">Adopt a Tree</a> / tree diary</p>
    <div class="pd-screen pd-actions">
      <button type="button" class="pd-btn" id="pd-print" hidden>Print this page</button>
      <span>It fits on one letter-size page. To print, use your browser's Print command (Ctrl+P, or ⌘P on a Mac). Start with this month's box; a missed month can stay empty.</span>
    </div>

    <PrintDiary
      title="My tree diary"
      kicker="Adopt a Tree · one tree, every month for a year"
      fields={['Name', "My tree's name", 'Year']}
      intro="Visit your tree about once a month. Each time, fill in that month's box."
      labels={MONTHS}
      columns={3}
      draw="Draw my tree"
      prompts={['Leaves or buds are:', 'One thing that changed:']}
      foot="Biology Together · Adopt a Tree"
    />
  </article>

  <style is:global>
    .pd-page .pd-eyebrow { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ddp-color-muted); }
    .pd-page .pd-eyebrow a { display: inline-flex; align-items: center; min-height: 44px; }
    .pd-page .pd-actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--ddp-space-3); margin: 0 0 var(--ddp-space-5); font-size: var(--ddp-text-sm); color: var(--ddp-color-muted); }
    .pd-page .pd-actions span { flex: 1 1 16rem; }
    .pd-page .pd-btn { display: inline-flex; align-items: center; min-height: 44px; padding: 0.4em 1.1em; border-radius: 999px; border: 1px solid var(--ddp-color-accent); background: var(--ddp-color-accent); color: #fff; font: inherit; font-weight: 600; cursor: pointer; }
    .pd-page .pd-btn[hidden] { display: none; }
    .pd-page :focus-visible { outline: 2px solid var(--ddp-color-accent); outline-offset: 2px; }
  </style>

  <script>
    // The button is shown only when it can work.
    const b = document.getElementById('pd-print');
    if (b) { b.hidden = false; b.addEventListener('click', () => window.print()); }
  </script>
</BaseLayout>
