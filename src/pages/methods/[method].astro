---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { COURSES, courseHref } from '../../data/courses';
import { CATEGORY_LABELS, filmLength, listedMethods, methodHref } from '../../data/methods';

/* One page per method in the library: the film, what the method unlocked, and every
   lesson that teaches or relies on it, grouped by course. Only methods with a film
   get a page. Drafts are linked only in `astro dev`, like everywhere else. */
export function getStaticPaths() {
  return listedMethods().map((m) => ({ params: { method: m.slug }, props: { m } }));
}

const { m } = Astro.props;
const film = m.film!;
const lessons = await getCollection('lessons', ({ data }) => (import.meta.env.DEV || !data.draft) && m.lessons.includes(data.slug));
const bySlug = new Map(lessons.map((l) => [l.data.slug, l]));
const byCourse = COURSES.map((c) => ({
  c,
  ls: lessons.filter((l) => l.data.course === c.slug).sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999)),
})).filter((g) => g.ls.length > 0);
const origin = film.from ? bySlug.get(film.from) : undefined;
const related = listedMethods().filter((o) => o.slug !== m.slug && o.category === m.category).slice(0, 6);
---

<BaseLayout title={`${m.name} — Methods — Biochemistrypedia`} description={m.summary}>
  <section class="wrap method-hero">
    <p class="eyebrow"><a href="/methods/">Methods library</a> · {CATEGORY_LABELS[m.category]}</p>
    <h1>{m.name}</h1>
    {m.aka && m.aka.length > 0 && <p class="aka">Also called {m.aka.join(', ')}</p>}
    <p class="lede">{m.summary}</p>
  </section>

  <section class="wrap" aria-labelledby="film-h">
    <figure class="mfilm">
      <video controls preload="none" playsinline poster={film.poster} width="1920" height="1080">
        <source src={film.src} type="video/mp4" />
        <track kind="captions" src={film.captions} srclang="en" label="English" />
        Your browser cannot play this video. <a href={film.src}>Download the film (MP4)</a>.
      </video>
      <figcaption>
        <p class="mfilm-h" id="film-h"><span class="kicker">Watch</span> {film.title} <span class="len">· {filmLength(film.durationSec)}</span></p>
        <p class="note">
          A schematic drawn in code, narrated by {film.narration}.
          {origin && <> First made for the lesson <a href={`/lessons/${origin.data.slug}/`}>{origin.data.title}</a>.</>}
        </p>
      </figcaption>
    </figure>
  </section>

  <div class="wrap method-body">
    {m.unlocked && m.unlocked.length > 0 && (
      <section aria-labelledby="unlocked-h">
        <h2 id="unlocked-h">What it unlocked</h2>
        <ul class="unlocked">
          {m.unlocked.map((u) => {
            const l = u.lesson ? bySlug.get(u.lesson) : undefined;
            return <li>{u.text}{l && <> <a href={`/lessons/${l.data.slug}/`}>{l.data.title} →</a></>}</li>;
          })}
        </ul>
      </section>
    )}

    <section aria-labelledby="where-h">
      <h2 id="where-h">Where it is taught</h2>
      <p class="sub">{lessons.length === 1 ? 'One lesson uses' : `${lessons.length} lessons use`} this method.</p>
      {byCourse.map(({ c, ls }) => (
        <div class="course-group">
          <h3><a href={courseHref(c.slug)}>{c.title}</a></h3>
          <ul class="lesson-list">
            {ls.map((l) => <li><a href={`/lessons/${l.data.slug}/`}>{l.data.title}</a></li>)}
          </ul>
        </div>
      ))}
    </section>

    {m.sources && m.sources.length > 0 && (
      <section aria-labelledby="sources-h">
        <h2 id="sources-h">Sources</h2>
        <ul class="sources">
          {m.sources.map((s) => <li>{s.url ? <a href={s.url} rel="noopener">{s.label}</a> : s.label}</li>)}
        </ul>
      </section>
    )}

    {related.length > 0 && (
      <section aria-labelledby="related-h">
        <h2 id="related-h">More {CATEGORY_LABELS[m.category].toLowerCase()} methods</h2>
        <ul class="chips">
          {related.map((o) => <li><a href={methodHref(o.slug)}>{o.name}</a></li>)}
        </ul>
      </section>
    )}
  </div>

  <style>
    .method-hero { padding-block: var(--ddp-space-8) var(--ddp-space-4); display: flex; flex-direction: column; gap: var(--ddp-space-2); }
    .eyebrow { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); letter-spacing: 0.14em; text-transform: uppercase; color: var(--ddp-color-caution); margin: 0; }
    .eyebrow a { color: inherit; text-underline-offset: 3px; }
    h1 { font-family: var(--ddp-font-serif); font-weight: 500; color: var(--ddp-color-primary); font-size: var(--ddp-text-3xl); line-height: 1.1; margin: 0; }
    .aka { margin: 0; font-size: var(--ddp-text-sm); color: var(--ddp-color-muted); }
    .lede { font-size: var(--ddp-text-lg); line-height: 1.6; color: var(--ddp-color-ink-soft); max-width: 60ch; margin: var(--ddp-space-2) 0 0; }
    .mfilm { margin: var(--ddp-space-4) 0 var(--ddp-space-8); max-width: 880px; }
    .mfilm video { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; background: #0f1117; border-radius: 10px; }
    .mfilm figcaption { margin-top: var(--ddp-space-3); display: grid; gap: var(--ddp-space-1); }
    .mfilm-h { margin: 0; font-family: var(--ddp-font-serif); font-size: var(--ddp-text-lg); color: var(--ddp-color-primary); }
    .kicker { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ddp-color-accent); margin-right: 0.4rem; }
    .len { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-sm); color: var(--ddp-color-muted); }
    .note { margin: 0; max-width: 72ch; font-size: var(--ddp-text-xs); line-height: 1.55; color: var(--ddp-color-muted); }
    .method-body { display: grid; gap: var(--ddp-space-8); padding-bottom: var(--ddp-space-12); max-width: 880px; }
    h2 { font-family: var(--ddp-font-serif); font-weight: 500; color: var(--ddp-color-primary); font-size: var(--ddp-text-xl); margin: 0 0 var(--ddp-space-3); }
    h3 { font-size: var(--ddp-text-base); margin: var(--ddp-space-4) 0 var(--ddp-space-2); }
    h3 a { color: var(--ddp-color-ink); }
    .sub { margin: 0; color: var(--ddp-color-muted); font-size: var(--ddp-text-sm); }
    .unlocked, .lesson-list, .sources { margin: 0; padding-left: 1.2rem; display: grid; gap: var(--ddp-space-2); line-height: 1.55; }
    .sources { font-size: var(--ddp-text-sm); color: var(--ddp-color-ink-soft); }
    .chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--ddp-space-2); }
    .chips a { display: inline-block; padding: 0.3rem 0.8rem; border-radius: 999px; border: 1px solid var(--ddp-color-border, #d6d3cc); text-decoration: none; font-size: var(--ddp-text-sm); color: var(--ddp-color-ink); }
    .chips a:hover { border-color: var(--ddp-color-accent); }
  </style>
</BaseLayout>
