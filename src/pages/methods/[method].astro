---
import { getCollection } from 'astro:content';
import MethodDetail from '../../components/MethodDetail.astro';
import MethodsLibrary from '../../components/MethodsLibrary.astro';
import { METHODS, type Method } from '../../data/methods';
import type { Course } from '../../data/courses';
import { methodCourses } from '../../lib/method-courses';

type Props = { method: Method } | { course: Course };

export async function getStaticPaths() {
  const lessons = await getCollection('lessons', ({ data }) => import.meta.env.DEV || !data.draft);
  const methodSlugs = new Set(METHODS.map((method) => method.slug));
  const courses = methodCourses(lessons);
  for (const course of courses) {
    if (methodSlugs.has(course.slug)) throw new Error(`Method and course share the slug "${course.slug}"`);
  }
  return [
    ...METHODS.map((method) => ({ params: { method: method.slug }, props: { method } })),
    ...courses.map((course) => ({ params: { method: course.slug }, props: { course } })),
  ];
}

const props: Props = Astro.props;
---

{'course' in props ? <MethodsLibrary course={props.course} /> : <MethodDetail m={props.method} />}
