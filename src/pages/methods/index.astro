---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CATEGORY_LABELS, METHODS, filmLength, listedMethods, methodHref, type MethodCategory } from '../../data/methods';

/* The methods library: every experimental method taught on the site, one film each,
   grouped by what it works on. A card counts only the published lessons that use it. */
const published = new Set((await getCollection('lessons', ({ data }) => import.meta.env.DEV || !data.draft)).map((l) => l.data.slug));
const methods = listedMethods().map((m) => ({ m, n: m.lessons.filter((s) => published.has(s)).length }));
const groups = (Object.keys(CATEGORY_LABELS) as MethodCategory[])
  .map((cat) => ({ cat, items: methods.filter(({ m }) => m.category === cat).sort((a, b) => a.m.name.localeCompare(b.m.name)) }))
  .filter((g) => g.items.length > 0);
const coming = METHODS.filter((m) => !m.film).sort((a, b) => a.name.localeCompare(b.name));
---

<BaseLayout title="Methods library — Biochemistrypedia" description="One short narrated film for every experimental method the courses teach: what it solves, how it works, how to read the result, and what it made possible.">
  <section class="wrap methods-hero">
    <p class="eyebrow"><a href="/courses/">All courses</a> · methods</p>
    <h1>Methods library</h1>
    <p class="lede">
      Every claim in these courses rests on a measurement. Each film here explains one method once:
      the problem it solves, how it works, how to read what it gives you, what can go wrong, and what it
      made possible. The same film appears in every lesson that uses the method.
    </p>
    <p class="count">{methods.length} films{coming.length > 0 && ` · ${coming.length} more in production`}</p>
  </section>

  <nav class="wrap cat-nav" aria-label="Jump to a group">
    {groups.map((g) => <a href={`#${g.cat}`}>{CATEGORY_LABELS[g.cat]}</a>)}
  </nav>

  {groups.map((g) => (
    <section class="wrap cat" id={g.cat} aria-labelledby={`${g.cat}-h`}>
      <h2 id={`${g.cat}-h`}>{CATEGORY_LABELS[g.cat]}</h2>
      <ul class="grid">
        {g.items.map(({ m, n }) => (
          <li class="card mcard">
            <a href={methodHref(m.slug)}>
              <img src={m.film!.poster} alt="" loading="lazy" decoding="async" width="480" height="270" />
              <span class="mname">{m.name}</span>
              <span class="msum">{m.summary}</span>
              <span class="mmeta">▶ {filmLength(m.film!.durationSec)} · {n === 1 ? 'one lesson' : `${n} lessons`}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}

  {coming.length > 0 && (
    <section class="wrap cat" id="coming" aria-labelledby="coming-h">
      <h2 id="coming-h">Films in production</h2>
      <p class="coming-note">These methods have a page with the lessons that use them; each gets its film soon.</p>
      <ul class="coming">
        {coming.map((m) => <li><a href={methodHref(m.slug)}>{m.name}</a></li>)}
      </ul>
    </section>
  )}

  <style>
    .coming-note { margin: 0 0 var(--ddp-space-3); color: var(--ddp-color-muted); font-size: var(--ddp-text-sm); }
    .coming { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--ddp-space-2); }
    .coming a { display: inline-block; padding: 0.3rem 0.8rem; border-radius: 999px; border: 1px dashed var(--ddp-color-border, #d6d3cc); text-decoration: none; font-size: var(--ddp-text-sm); color: var(--ddp-color-ink); }
    .coming a:hover { border-color: var(--ddp-color-accent); }
    .methods-hero { padding-block: var(--ddp-space-8) var(--ddp-space-4); display: flex; flex-direction: column; gap: var(--ddp-space-3); }
    .eyebrow { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); letter-spacing: 0.14em; text-transform: uppercase; color: var(--ddp-color-caution); margin: 0; }
    .eyebrow a { color: inherit; text-underline-offset: 3px; }
    h1 { font-family: var(--ddp-font-serif); font-weight: 500; color: var(--ddp-color-primary); font-size: var(--ddp-text-3xl); line-height: 1.1; margin: 0; }
    .lede { font-size: var(--ddp-text-lg); line-height: 1.6; color: var(--ddp-color-ink-soft); max-width: 62ch; margin: 0; }
    .count { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); letter-spacing: 0.12em; text-transform: uppercase; color: var(--ddp-color-muted); margin: 0; }
    .cat-nav { display: flex; flex-wrap: wrap; gap: var(--ddp-space-2); padding-block: var(--ddp-space-2) var(--ddp-space-4); }
    .cat-nav a { padding: 0.3rem 0.8rem; border-radius: 999px; border: 1px solid var(--ddp-color-border, #d6d3cc); text-decoration: none; font-size: var(--ddp-text-sm); color: var(--ddp-color-ink); }
    .cat-nav a:hover { border-color: var(--ddp-color-accent); }
    .cat { padding-bottom: var(--ddp-space-8); }
    h2 { font-family: var(--ddp-font-serif); font-weight: 500; color: var(--ddp-color-primary); font-size: var(--ddp-text-xl); margin: var(--ddp-space-4) 0; }
    .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr)); gap: var(--ddp-space-4); }
    .mcard { padding: 0; overflow: hidden; }
    .mcard a { display: flex; flex-direction: column; gap: var(--ddp-space-1); height: 100%; text-decoration: none; color: var(--ddp-color-ink); padding-bottom: var(--ddp-space-4); }
    .mcard img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; background: #0f1117; margin-bottom: var(--ddp-space-2); }
    .mname, .msum, .mmeta { padding-inline: var(--ddp-space-4); }
    .mname { font-family: var(--ddp-font-serif); font-size: var(--ddp-text-lg); color: var(--ddp-color-primary); }
    .msum { font-size: var(--ddp-text-sm); line-height: 1.5; color: var(--ddp-color-ink-soft); }
    .mmeta { margin-top: auto; padding-top: var(--ddp-space-2); font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
    .mcard a:hover .mname { text-decoration: underline; }
  </style>
</BaseLayout>
