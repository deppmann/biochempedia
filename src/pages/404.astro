---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found — Biochemistrypedia" description="The page you're looking for doesn't exist.">
  <article class="wrap prose-col" style="padding-top: var(--ddp-space-12)">
    <p class="eyebrow">404</p>
    <h1>This page does not exist.</h1>

    <p>
      The link you followed is broken, or the page has moved. Here is how to
      find what you were looking for.
    </p>

    <ul>
      <li><a href="/">Browse the lesson catalog</a></li>
      <li><a href="/about">Learn about Biochemistrypedia</a></li>
      <li><a href="/contact">Report the broken link</a></li>
    </ul>

    <p><a href="/">← Back to lessons</a></p>
  </article>

  <style>
    .eyebrow {
      font-family: var(--ddp-font-mono);
      font-size: var(--ddp-text-xs);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--ddp-color-accent);
    }
  </style>
</BaseLayout>
