---
import '../styles/global.css';
import SiteMenu from '../components/SiteMenu.astro';
import AccountLink from '../components/AccountLink.astro';
import Footer from '../../brand/Footer.astro';
import { feedbackUrl } from '../lib/feedback';

interface Props {
  title: string;
  description?: string;
  /** og:type — 'website' for hubs, 'article' for lessons. */
  ogType?: string;
  /** Optional page-specific JSON-LD (e.g. a LearningResource for a lesson). */
  jsonLd?: Record<string, unknown>;
  /** Keep the page out of search results (account and class pages). */
  noindex?: boolean;
  /** Other forms of this page, e.g. a lesson's plain Markdown copy for AI agents. */
  alternates?: { type: string; href: string; title?: string }[];
  /** Share-preview image, as a site path ("/explainers/x/poster.jpg") or a full URL. Defaults to /og.png. */
  ogImage?: string;
  /** Extra <head> tags as [attribute, name, content] triples, e.g. ['property', 'og:video', url]. */
  extraMeta?: [('name' | 'property'), string, string][];
}
const { title, description, ogType = 'website', jsonLd, noindex = false, alternates = [], ogImage: ogImageProp, extraMeta = [] } = Astro.props;
const SITE_NAME = 'Biochemistrypedia';
const DEFAULT_DESC =
  'Free lessons, films and simulations, starting with biology. Ages 5 to graduate school. No account needed, no ads.';
const desc = description ?? DEFAULT_DESC;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;
const ogImage = Astro.site ? new URL(ogImageProp ?? '/og.png', Astro.site).href : (ogImageProp ?? '/og.png');
const siteUrl = Astro.site ? Astro.site.href.replace(/\/$/, '') : '';
const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_NAME,
  url: siteUrl || undefined,
  description: DEFAULT_DESC,
  // The publisher is the person, not the university — this is the same claim
  // the footer's copyright line makes, in the form search engines read.
  publisher: { '@type': 'Person', name: 'Christopher Deppmann' },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {/* Playfair Display + Inter, loaded here rather than via an @import inside the
        brand tokens. A <link> in <head> starts the request immediately; the @import
        sat three CSS hops deep. Same URL and same placement the lab site uses, and
        the brand package expects each consumer to own this line. If you remove it,
        scripts/check-assets.mjs fails the build rather than shipping system fonts. */}
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap"
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {/* The stated size is og.png's; a page that passes its own image leaves it to the crawler. */}
    {!ogImageProp && <meta property="og:image:width" content="1200" />}
    {!ogImageProp && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />
    {extraMeta.map(([attr, key, content]) => (attr === 'property' ? <meta property={key} content={content} /> : <meta name={key} content={content} />))}
    <meta name="generator" content={Astro.generator} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteLd)} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    {/* Plausible analytics. Cookieless and collects no personal data, which is why
        this site can carry it without putting a consent banner in front of students.

        `is:inline` on both tags is load-bearing. Astro bundles and hoists script tags
        by default, which would rewrite this snippet into a module and break the
        contract it depends on: the queue shim has to exist before plausible.init()
        runs, and the remote file has to stay a plain async tag.

        Production only, so `astro dev` sessions do not report as traffic. */}
    {import.meta.env.PROD && (
      <Fragment>
        <script is:inline async src="https://plausible.io/js/pa-jxoRZ4lv7R_mVBfemACiu.js"></script>
        <script is:inline>
          window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
          plausible.init()
        </script>
      </Fragment>
    )}
    <link rel="alternate" type="application/atom+xml" title="Biochemistrypedia: what’s new" href="/updates.xml" />
    {alternates.map((a) => <link rel="alternate" type={a.type} href={a.href} title={a.title} />)}
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <header class="site-header">
      <nav class="wrap">
        <a href="/" class="brand" aria-label="Biochemistrypedia home">
          <span class="brand-mark">⬡</span>
          <span class="brand-name">Biochemistrypedia</span>
        </a>
        {/* The five main links sit in the bar on wide screens; on a phone they are in
            the Menu button (SiteMenu.astro), which has the same five. */}
        <div class="nav-main">
          <a href="/courses/" class="nav-link-main">Courses</a>
          <a href="/paths/" class="nav-link-main">Paths</a>
          <a href="/mcat/" class="nav-link-main">MCAT</a>
          <a href="/teachers/" class="nav-link-main">Teachers</a>
          <a href="/about/" class="nav-link-main">About</a>
        </div>
        <a href="/search/" class="nav-search" aria-label="Search the lessons">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="M15.5 15.5 L21 21" /></svg>
        </a>
        <a href="/progress/" class="nav-progress" aria-label="Your progress" title="Your progress">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="8.5" /><path d="M8.2 12.3 L11 15 L16 9.5" /></svg>
          <span class="nav-progress-dot" data-nav-due hidden></span>
        </a>
        <AccountLink />
        <SiteMenu />
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    {/* The shared deppmann-brand footer — this is the SEAM the old hand-rolled
        block was holding open. Columns carry the ecosystem links so the two
        sites read as one place; the slot carries what this surface owes and the
        others do not (third-party licences, the figure caveat). */}
    {/* This site is Chris's own work — not university work, and not the
        deliverable of a funded grant — so it names him as the rights holder
        and claims no institutional sponsorship. `copyright` overrides the
        brand default of "<brand>, University of Virginia"; tagline="" is
        deliberate, since omitting it would inherit the lab's department line. */}
    <Footer
      brand="Biochemistrypedia"
      address={[
        'Free science courses, from age 5 to graduate school.',
        'Started in the Deppmann Lab at UVA.',
      ]}
      copyright="Christopher Deppmann"
      tagline=""
      columns={[
        {
          heading: 'Learn',
          links: [
            { label: 'Courses', href: '/courses/' },
            { label: 'Paths', href: '/paths/' },
            { label: 'MCAT practice', href: '/mcat/' },
            { label: 'Films', href: '/films/' },
            { label: 'Methods library', href: '/methods/' },
            { label: 'Math toolkit', href: '/math-toolkit' },
            { label: 'Metabolism Arcade', href: '/play' },
            { label: 'The Fun Stuff', href: '/fun' },
          ],
        },
        {
          heading: 'Teach',
          links: [
            { label: 'For teachers', href: '/teachers' },
            { label: 'Run a class', href: '/teach/' },
            { label: 'Join a class', href: '/join/' },
          ],
        },
        {
          heading: 'This site',
          links: [
            { label: 'About', href: '/about/' },
            { label: 'What’s new', href: '/updates/' },
            { label: 'Privacy', href: '/privacy/' },
            { label: 'Report an error', href: feedbackUrl(), external: true },
            { label: 'Contact', href: '/contact' },
          ],
        },
        {
          heading: 'From the lab',
          links: [
            { label: 'Deppmann Lab', href: 'https://deppmannlab.com', external: true },
            { label: 'Graduate expedition', href: 'https://grad.biochemistrypedia.com', external: true },
            { label: 'We Are Biochemistry', href: 'https://deppmannlab.com/podcast', external: true },
            { label: 'The Molecule Hunters', href: 'https://deppmannlab.com/book', external: true },
          ],
        },
      ]}
    >
      {/* Fine print, kept to what a reader needs: how the lessons are made (the detail is on About),
          where the structures come from, and the licences. 2026-11-09: cut from two long paragraphs. */}
      <p>
        Lessons are written and illustrated with AI under Chris Deppmann&rsquo;s direction, then checked by a
        second model and against the research literature: <a href="/about/">how it&rsquo;s made and checked</a>.
        For anything you intend to memorize, use the live 3D structures in a lesson&rsquo;s Explore panel, which
        load from RCSB&nbsp;PDB and PubChem.
      </p>
      <p>
        Code: MIT licence. Lesson narrative and scientist profiles: the authors&rsquo; own
        (<a href="https://github.com/deppmann/biochempedia/blob/main/NOTICE">NOTICE</a>). Structures: RCSB&nbsp;PDB
        (CC0) and PubChem. Some simulations: PhET Interactive Simulations (CC&nbsp;BY&nbsp;4.0).
        <a href="/updates.xml">Updates feed</a>.
      </p>
    </Footer>

    {/* Footer layout for this site (the shared brand footer is built for three link columns; this site has four).
        Wide: brand plus four columns in one row. Tablet and phone: brand on top, links two to a row. */}
    <style is:global>
      footer.footer .footer__grid { grid-template-columns: 1.15fr repeat(4, minmax(0, 1fr)); gap: var(--space-2xl, 2.5rem); }
      /* Each link is a 44px-tall tap target; the padding replaces the old gap between rows. */
      footer.footer .footer__grid .footer__links { gap: 0; }
      footer.footer .footer__grid .footer__links a { display: inline-flex; align-items: center; min-height: 44px; }
      footer.footer .footer__notes { max-width: 72ch; }
      @media (max-width: 960px) {
        footer.footer .footer__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-xl, 2rem); }
        footer.footer .footer__grid > :first-child { grid-column: 1 / -1; }
      }
    </style>

    <style>
      #main {
        padding-bottom: var(--ddp-space-6);
      }
      .site-header {
        border-bottom: 1px solid var(--ddp-color-line);
        background: color-mix(in srgb, var(--ddp-color-surface) 88%, transparent);
        backdrop-filter: blur(6px);
        position: sticky;
        top: 0;
        z-index: 50;
      }
      .site-header nav {
        display: flex;
        align-items: baseline;
        gap: var(--ddp-space-4);
        padding-top: var(--ddp-space-4);
        padding-bottom: var(--ddp-space-4);
      }
      .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        text-decoration: none;
        color: var(--ddp-color-primary);
        font-family: var(--ddp-font-serif);
        font-weight: 700;
        font-size: var(--ddp-text-lg);
      }
      .brand-mark {
        color: var(--ddp-color-accent);
        font-size: 1.2em;
      }
      /* Main links: wide screens only; the Menu button carries them elsewhere. */
      .nav-main { display: none; margin-left: var(--ddp-space-4); gap: var(--ddp-space-1); align-self: center; }
      .nav-link-main {
        display: inline-flex;
        align-items: center;
        min-height: 36px;
        padding: 0 0.75em;
        border-radius: 999px;
        font-family: var(--ddp-font-mono);
        font-size: var(--ddp-text-xs);
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--ddp-color-accent);
        text-decoration: none;
      }
      .nav-link-main:hover { background: color-mix(in srgb, var(--ddp-color-accent) 12%, transparent); }
      @media (min-width: 901px) {
        .nav-main { display: flex; }
      }
      /* Search sits first in the right-hand group and takes the free space. */
      .nav-search {
        margin-left: auto;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        border-radius: 999px;
        color: var(--ddp-color-accent);
      }
      .nav-search:hover { background: color-mix(in srgb, var(--ddp-color-accent) 12%, transparent); }
      .nav-search + .nav-progress { margin-left: 0; }
      /* Search takes the free space; the progress icon and the menu sit snug to its right. */
      .nav-progress + :global(.sitemenu) { margin-left: 0; }
      .nav-progress {
        position: relative; display: inline-flex; align-items: center; justify-content: center;
        width: 36px; height: 36px; border-radius: 999px; color: var(--ddp-color-accent); flex: none;
      }
      .nav-progress:hover { background: color-mix(in srgb, var(--ddp-color-accent) 12%, transparent); }
      .nav-progress-dot { position: absolute; top: 6px; right: 6px; width: 8px; height: 8px; border-radius: 50%; background: var(--ddp-color-caution); }
      .nav-progress-dot[hidden] { display: none; }
      .nav-link {
        margin-left: auto;
        color: var(--ddp-color-accent);
        font-family: var(--ddp-font-mono);
        font-size: var(--ddp-text-xs);
        text-transform: uppercase;
        letter-spacing: 0.06em;
        text-decoration: none;
        white-space: nowrap;
      }
      .nav-link:hover { text-decoration: underline; }
      /* Only the first nav-link absorbs the free space, so any siblings group at
         the right edge (two auto margins would split the gap unevenly). */
      .nav-link ~ .nav-link { margin-left: 0; }
      /* The wordmark must never break across two lines — "Biochem/pedia" in a
         sticky header is the first thing a phone visitor sees. Below 560px the
         tagline goes, and below 400px the mark shrinks rather than wraps. */
      .brand-name { white-space: nowrap; }
      @media (max-width: 560px) {
        .site-header nav { gap: var(--ddp-space-3); }
        /* Room for the progress icon beside search on a phone. */
        .nav-search, .nav-progress { width: 30px; height: 30px; }
        .nav-search + .nav-progress { margin-left: calc(var(--ddp-space-1, 0.25rem) - var(--ddp-space-3)); }
      }
      @media (max-width: 400px) {
        .site-header nav { gap: var(--ddp-space-2); }
        .nav-search + .nav-progress { margin-left: 0; }
        .brand { font-size: var(--ddp-text-base); }
        .nav-link { font-size: 0.66rem; }
      }
      @media (max-width: 350px) {
        .brand-name { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
      }
    </style>
    <script>
      import { load, dueNow, onChange } from '../lib/progress';
      // A small dot on the header's progress link when review questions are due.
      const dot = document.querySelector<HTMLElement>('[data-nav-due]');
      if (dot) onChange(() => { dot.hidden = dueNow(load()).length === 0; });
    </script>
  </body>
</html>
