---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** og:type — 'website' for hubs, 'article' for lessons. */
  ogType?: string;
  /** Optional page-specific JSON-LD (e.g. a LearningResource for a lesson). */
  jsonLd?: Record<string, unknown>;
}
const { title, description, ogType = 'website', jsonLd } = Astro.props;
const year = 2026;
const SITE_NAME = 'Biochemistrypedia';
const DEFAULT_DESC =
  'An interactive biochemistry textbook — live 3D molecules, original simulations, and the history behind the science. From the Deppmann Lab.';
const desc = description ?? DEFAULT_DESC;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;
const ogImage = Astro.site ? new URL('/og.png', Astro.site).href : '/og.png';
const siteUrl = Astro.site ? Astro.site.href.replace(/\/$/, '') : '';
const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_NAME,
  url: siteUrl || undefined,
  description: DEFAULT_DESC,
  publisher: { '@type': 'Organization', name: 'Deppmann Lab, University of Virginia' },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="generator" content={Astro.generator} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteLd)} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <header class="site-header">
      <nav class="wrap">
        <a href="/" class="brand">
          <span class="brand-mark">⬡</span>
          <span class="brand-name">Biochemistrypedia</span>
        </a>
        <span class="brand-tag">an interactive biochemistry textbook</span>
        <a href="/fun" class="nav-link">The&nbsp;Fun&nbsp;Stuff</a>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <p>
          <strong>Biochemistrypedia</strong> — an interactive biochemistry textbook,
          an <a href="/about">AI&nbsp;Catalyst</a> project by the
          Deppmann Lab.
        </p>
        <p class="fine footer-nav">
          <a href="/">Lessons</a> · <a href="/about">About</a> · <a href="/fun">The Fun Stuff</a> · <a href="/contact">Contact</a>
        </p>
        <p class="fine">
          Code: MIT. Lesson narrative & scientist profiles are drawn from
          <em>The Molecule Hunters</em> and Prof. Deppmann's lectures (authors'
          IP — see <a href="https://github.com/deppmann/biochempedia/blob/main/NOTICE">NOTICE</a>).
          Structures are loaded live from RCSB&nbsp;PDB (CC0) and PubChem.
          Simulations from PhET (CC&nbsp;BY&nbsp;4.0). &copy; {year}.
        </p>
        <p class="fine disclaimer">
          <strong>A note on the figures.</strong> Some lecture slides here use AI-assisted
          illustration, and a few carry a caption flagging a specific artifact on that
          slide — a bond drawn wrong, a ring in the wrong chair. For anything you intend
          to memorize, work from the live 3D structures in the lesson&rsquo;s Explore panel:
          those load by accession ID from RCSB&nbsp;PDB and PubChem, so no one has drawn
          them by hand or by model. Every slide names the person who screened it, and each
          lesson&rsquo;s Sources &amp; Integrity panel lists what that covers. Found an
          error? Tell me and I will fix it — the <a href="/contact">contact page</a>, or
          <a href="mailto:deppmann@gmail.com">deppmann@gmail.com</a>.
        </p>
        <!-- SEAM: the shared deppmann-brand footer partial (student-credit +
             inspiration-credit lines) replaces this block once Handoff 0 ships. -->
      </div>
    </footer>

    <style>
      .site-header {
        border-bottom: 1px solid var(--ddp-color-line);
        background: color-mix(in srgb, var(--ddp-color-surface) 88%, transparent);
        backdrop-filter: blur(6px);
        position: sticky;
        top: 0;
        z-index: 50;
      }
      .site-header nav {
        display: flex;
        align-items: baseline;
        gap: var(--ddp-space-4);
        padding-top: var(--ddp-space-4);
        padding-bottom: var(--ddp-space-4);
      }
      .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        text-decoration: none;
        color: var(--ddp-color-primary);
        font-family: var(--ddp-font-serif);
        font-weight: 700;
        font-size: var(--ddp-text-lg);
      }
      .brand-mark {
        color: var(--ddp-color-accent);
        font-size: 1.2em;
      }
      .brand-tag {
        color: var(--ddp-color-muted);
        font-size: var(--ddp-text-sm);
      }
      .nav-link {
        margin-left: auto;
        color: var(--ddp-color-accent);
        font-family: var(--ddp-font-mono);
        font-size: var(--ddp-text-xs);
        text-transform: uppercase;
        letter-spacing: 0.06em;
        text-decoration: none;
        white-space: nowrap;
      }
      .nav-link:hover { text-decoration: underline; }
      /* Only the first nav-link absorbs the free space, so any siblings group at
         the right edge (two auto margins would split the gap unevenly). */
      .nav-link ~ .nav-link { margin-left: 0; }
      /* The wordmark must never break across two lines — "Biochem/pedia" in a
         sticky header is the first thing a phone visitor sees. Below 560px the
         tagline goes, and below 400px the mark shrinks rather than wraps. */
      .brand-name { white-space: nowrap; }
      @media (max-width: 560px) {
        .brand-tag {
          display: none;
        }
        .site-header nav { gap: var(--ddp-space-3); }
      }
      @media (max-width: 400px) {
        .brand { font-size: var(--ddp-text-base); }
        .nav-link { font-size: 0.66rem; }
      }
      .site-footer {
        margin-top: var(--ddp-space-16);
        border-top: 1px solid var(--ddp-color-line);
        padding: var(--ddp-space-8) 0 var(--ddp-space-12);
        color: var(--ddp-color-ink-soft);
        font-size: var(--ddp-text-sm);
      }
      .site-footer .fine {
        color: var(--ddp-color-muted);
        font-size: var(--ddp-text-xs);
      }
      .site-footer .disclaimer {
        margin-top: var(--ddp-space-4);
        padding-top: var(--ddp-space-4);
        border-top: 1px solid var(--ddp-color-line);
        max-width: 80ch;
        line-height: 1.6;
      }
      .site-footer .disclaimer a {
        color: var(--ddp-color-accent);
      }
    </style>
  </body>
</html>
