---
/**
 * "More from the lab" — the one header affordance for everything that is not a
 * lesson.
 *
 * The constraint this solves: the lab's books and side projects need to be
 * findable without competing with the lessons. A nav item per project fails the
 * moment a fourth project exists; the footer alone is where things go to be
 * unfindable. One disclosure holds any number of them at a fixed cost of one
 * item, and the footer carries the same links so nothing lives only in here.
 *
 * Native <details> was the tempting shortcut, but it still needs JS for
 * outside-click and Escape, and its open/close semantics are not what a menu
 * button should announce. A button with aria-expanded says the true thing.
 */
interface Item { label: string; href: string; note?: string; external?: boolean; }

const items: Item[] = [
  { label: 'The Fun Stuff', href: '/fun', note: 'Trading cards, memes, songs — by BIOL 3030 students' },
  { label: 'Deppmann Lab', href: 'https://deppmannlab.com', note: 'The research lab at UVA', external: true },
  { label: 'We Are Biochemistry', href: 'https://deppmannlab.com/podcast', note: 'The lab podcast', external: true },
  // The Molecule Hunters lands here once deppmannlab-website#3 ships /book.
];
---

<div class="labmenu" data-labmenu>
  <button
    type="button"
    class="labmenu-btn"
    id="labmenu-btn"
    aria-expanded="false"
    aria-controls="labmenu-list"
  >
    {/* Two labels rather than one truncated one: the header has ~28px of slack
        at 320px, and the wordmark is not negotiable. */}
    <span class="labmenu-label-full">More from the lab</span>
    <span class="labmenu-label-short">The&nbsp;Lab</span>
    <span class="labmenu-caret" aria-hidden="true">▾</span>
  </button>

  <ul class="labmenu-list" id="labmenu-list" aria-labelledby="labmenu-btn" hidden>
    {items.map((it) => (
      <li>
        <a
          href={it.href}
          {...(it.external ? { target: '_blank', rel: 'noopener' } : {})}
        >
          <span class="labmenu-item-label">
            {it.label}{it.external && <span class="labmenu-ext" aria-hidden="true"> ↗</span>}
          </span>
          {it.note && <span class="labmenu-item-note">{it.note}</span>}
        </a>
      </li>
    ))}
  </ul>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-labmenu]');
  const btn = document.getElementById('labmenu-btn');
  const list = document.getElementById('labmenu-list');

  if (root && btn && list) {
    const setOpen = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      list.hidden = !open;
      root.classList.toggle('is-open', open);
    };

    btn.addEventListener('click', () => {
      setOpen(btn.getAttribute('aria-expanded') !== 'true');
    });

    // Escape closes and hands focus back to the button, so a keyboard user is
    // never dropped somewhere they did not ask to be.
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        btn.focus();
      }
    });

    document.addEventListener('click', (e) => {
      if (!root.contains(e.target as Node)) setOpen(false);
    });

    // Tabbing past the last item should close it rather than leave an orphaned
    // panel open behind the rest of the page.
    root.addEventListener('focusout', () => {
      requestAnimationFrame(() => {
        if (!root.contains(document.activeElement)) setOpen(false);
      });
    });
  }
</script>

<style>
  .labmenu { position: relative; margin-left: auto; }

  .labmenu-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    /* Matches .nav-link so the header reads as one system. */
    font-family: var(--ddp-font-mono);
    font-size: var(--ddp-text-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ddp-color-accent);
    background: none;
    border: 1px solid transparent;
    border-radius: 999px;
    padding: 0.4em 0.7em;
    cursor: pointer;
    white-space: nowrap;
    /* 44px minimum: on a phone this button is the only route to the lab site,
       the podcast and the student galleries. Padding alone left it at 29px. */
    min-height: 44px;
  }
  .labmenu-btn:hover { border-color: var(--ddp-color-line); }
  .labmenu-btn:focus-visible {
    outline: 2px solid var(--ddp-color-accent);
    outline-offset: 2px;
  }
  .labmenu-caret { transition: transform 0.15s ease; font-size: 0.9em; }
  .labmenu.is-open .labmenu-caret { transform: rotate(180deg); }
  .labmenu.is-open .labmenu-btn { border-color: var(--ddp-color-line); }

  .labmenu-label-short { display: none; }

  .labmenu-list {
    position: absolute;
    right: 0;
    top: calc(100% + 0.5rem);
    z-index: 60;
    margin: 0;
    padding: var(--ddp-space-2);
    list-style: none;
    min-width: 15rem;
    max-width: min(20rem, calc(100vw - var(--ddp-space-6)));
    background: var(--ddp-color-surface);
    border: 1px solid var(--ddp-color-line);
    border-radius: var(--ddp-radius);
    box-shadow: 0 12px 32px rgba(20, 22, 30, 0.16);
  }
  .labmenu-list[hidden] { display: none; }

  .labmenu-list a {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    /* 44px min target — this is the only route to these pages on a phone. */
    min-height: 44px;
    justify-content: center;
    padding: var(--ddp-space-2) var(--ddp-space-3);
    border-radius: var(--ddp-radius-sm);
    text-decoration: none;
    color: var(--ddp-color-ink);
  }
  .labmenu-list a:hover,
  .labmenu-list a:focus-visible {
    background: var(--ddp-color-bg-alt, #f0ede7);
    text-decoration: none;
  }
  .labmenu-item-label { font-size: var(--ddp-text-sm); font-weight: 600; }
  .labmenu-item-note {
    font-size: var(--ddp-text-xs);
    color: var(--ddp-color-muted);
    line-height: 1.35;
  }
  .labmenu-ext { color: var(--ddp-color-muted); font-weight: 400; }

  @media (max-width: 560px) {
    .labmenu-label-full { display: none; }
    .labmenu-label-short { display: inline; }
  }
  @media (prefers-reduced-motion: reduce) {
    .labmenu-caret { transition: none; }
  }
</style>
