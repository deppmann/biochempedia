---
/**
 * ComplementationGrid — six recessive white-eyed mutants of an idealized fly. The learner
 * clicks a cell to cross two mutants in trans and reads the F1 (+ wild type, − white).
 * A failure to complement links two mutants into one complementation group; groups form
 * as the grid fills. The results are the worked problem of the complementation-and-pathways
 * lesson (six mutants, fifteen pairs); nothing here is sampled, so there is no resample.
 * Self-contained vanilla-TS Astro island. Original.
 */
---

<figure class="cg card" data-cgrid>
  <figcaption class="cg-head">Complementation grid: sort six mutants into genes<span class="cg-chip">⚙ original · interactive</span></figcaption>

  <p class="cg-lead">Six recessive, autosomal, fully penetrant white-eyed mutants of an idealized fly, 1 to 6; the scores are the lesson’s worked problem. Click a cell to cross two of them and score the F1 diploid.</p>

  <div class="cg-wrap">
    <table class="cg-table" data-table aria-label="Complementation grid of six mutants"></table>
  </div>

  <div class="cg-row">
    <button type="button" class="cg-btn" data-all>Cross all 15 pairs</button>
    <button type="button" class="cg-btn" data-reset>Reset</button>
    <span class="cg-count" data-count></span>
  </div>

  <svg class="cg-svg" viewBox="0 0 360 176" role="img" aria-label="The two homologous chromosomes of the last F1 diploid you scored, with the two mutations in trans" data-stage></svg>

  <div class="cg-groups" data-groups aria-label="Complementation groups so far"></div>

  <p class="cg-verdict" data-verdict role="status"></p>

  <p class="cg-foot">Mutations that fail to complement form a complementation group, which in the simple model is one gene; “at least” that many genes, because other genes needed for red pigment may not have been hit. Exceptions exist: intragenic complementation can make same-gene mutants look wild type, and non-allelic non-complementation can make different-gene mutants look white. This is a sketch of the logic, not to scale.</p>
</figure>

<script>
  const NS = 'http://www.w3.org/2000/svg';
  const N = 6;
  // F1 scores from the lesson's worked problem: true = wild type (+), false = white (−).
  const SCORE: Record<string, boolean> = {
    '1-2': true, '1-3': false, '1-4': true, '1-5': false, '1-6': true,
    '2-3': true, '2-4': true, '2-5': true, '2-6': false,
    '3-4': true, '3-5': false, '3-6': true,
    '4-5': true, '4-6': true,
    '5-6': true,
  };
  const COLORS = ['#0e7c86', '#e57200', '#7a5ea8', '#b8860b', '#2f6f8f', '#9b3d5a'];
  const INK = '#4b4b55', FAINT = '#8a8a96', GOOD = '#2e7d32', BAD = '#b3261e';
  const key = (a: number, b: number) => (a < b ? `${a}-${b}` : `${b}-${a}`);
  function el(name: string, attrs: Record<string, string | number>, text?: string): SVGElement {
    const e = document.createElementNS(NS, name);
    for (const k in attrs) e.setAttribute(k, String(attrs[k]));
    if (text !== undefined) e.textContent = text;
    return e;
  }

  document.querySelectorAll<HTMLElement>('[data-cgrid]').forEach((root) => {
    const table = root.querySelector<HTMLTableElement>('[data-table]')!;
    const stage = root.querySelector<SVGSVGElement>('[data-stage]')!;
    const groupsEl = root.querySelector<HTMLElement>('[data-groups]')!;
    const verdict = root.querySelector<HTMLElement>('[data-verdict]')!;
    const countEl = root.querySelector<HTMLElement>('[data-count]')!;
    const done = new Set<string>();
    let last: [number, number] | null = null;
    let all = false;

    function cross(a: number, b: number) {
      done.add(key(a, b));
      last = [a, b];
      all = false;
      render();
      const btn = table.querySelector<HTMLButtonElement>(`[data-cell="${key(a, b)}"]`);
      if (btn) btn.focus();
    }

    // Clusters of mutants joined by tested failures to complement.
    function clusters(): number[][] {
      const parent = Array.from({ length: N + 1 }, (_, i) => i);
      const find = (x: number): number => (parent[x] === x ? x : (parent[x] = find(parent[x])));
      done.forEach((k) => { if (!SCORE[k]) { const [a, b] = k.split('-').map(Number); parent[find(a)] = find(b); } });
      const map = new Map<number, number[]>();
      for (let i = 1; i <= N; i++) { const r = find(i); map.set(r, [...(map.get(r) ?? []), i]); }
      return [...map.values()].sort((x, y) => x[0] - y[0]);
    }
    // A cluster is settled once every pair that involves one of its members has been crossed.
    function settled(c: number[]): boolean {
      for (const m of c) for (let o = 1; o <= N; o++) if (o !== m && !done.has(key(m, o))) return false;
      return true;
    }
    function untestedInside(c: number[]): number {
      let n = 0;
      for (let i = 0; i < c.length; i++) for (let j = i + 1; j < c.length; j++) if (!done.has(key(c[i], c[j]))) n++;
      return n;
    }
    const list = (c: number[]) => '{' + c.join(', ') + '}';

    function buildTable() {
      table.replaceChildren();
      const head = document.createElement('tr');
      head.appendChild(document.createElement('td'));
      for (let j = 1; j <= N; j++) { const th = document.createElement('th'); th.scope = 'col'; th.textContent = String(j); head.appendChild(th); }
      table.appendChild(head);
      for (let i = 1; i <= N; i++) {
        const tr = document.createElement('tr');
        const th = document.createElement('th'); th.scope = 'row'; th.textContent = String(i); tr.appendChild(th);
        for (let j = 1; j <= N; j++) {
          const td = document.createElement('td');
          if (j > i) {
            const b = document.createElement('button');
            b.type = 'button'; b.className = 'cg-cell'; b.dataset.cell = key(i, j);
            b.addEventListener('click', () => cross(i, j));
            td.appendChild(b);
          } else { td.className = 'cg-dim'; td.textContent = i === j ? '·' : ''; }
          tr.appendChild(td);
        }
        table.appendChild(tr);
      }
    }

    function drawStage() {
      stage.replaceChildren();
      if (all) {
        stage.appendChild(el('text', { x: 180, y: 70, 'font-size': 11, 'text-anchor': 'middle', fill: INK }, 'All 15 pairs scored. Click any cell to see its diploid.'));
        return;
      }
      if (!last) {
        stage.appendChild(el('text', { x: 180, y: 88, 'font-size': 11, 'text-anchor': 'middle', fill: FAINT }, 'Cross a pair to see the two mutations in trans'));
        return;
      }
      const [a, b] = last;
      const ok = SCORE[key(a, b)];
      stage.appendChild(el('text', { x: 8, y: 14, 'font-size': 10, fill: INK }, `mutant ${a} × mutant ${b}, in trans in one diploid (homologs shown as two bars)`));
      const bar = (y: number, who: number, boxes: { x: number; hit: boolean; label: string }[]) => {
        stage.appendChild(el('line', { x1: 24, y1: y, x2: 336, y2: y, stroke: INK, 'stroke-width': 2 }));
        stage.appendChild(el('text', { x: 24, y: y - 22, 'font-size': 10, 'font-weight': 700, fill: COLORS[(who - 1) % 6] }, `chromosome carrying mutant ${who}`));
        for (const bx of boxes) {
          stage.appendChild(el('rect', { x: bx.x, y: y - 14, width: 100, height: 28, rx: 5, fill: bx.hit ? '#fff' : '#e7f3e8', stroke: bx.hit ? BAD : GOOD, 'stroke-width': 1.6 }));
          stage.appendChild(el('text', { x: bx.x + 50, y: y + 4, 'font-size': 10, 'text-anchor': 'middle', fill: bx.hit ? BAD : GOOD, 'font-weight': 700 }, bx.hit ? '✕ ' + bx.label : '✓ ' + bx.label));
        }
      };
      if (ok) {
        bar(52, a, [{ x: 70, hit: true, label: 'broken' }, { x: 200, hit: false, label: 'working' }]);
        bar(106, b, [{ x: 70, hit: false, label: 'working' }, { x: 200, hit: true, label: 'broken' }]);
        stage.appendChild(el('text', { x: 180, y: 144, 'font-size': 11, 'text-anchor': 'middle', 'font-weight': 700, fill: GOOD }, 'Each gene has one working copy: wild type (+).'));
        stage.appendChild(el('text', { x: 180, y: 159, 'font-size': 11, 'text-anchor': 'middle', 'font-weight': 700, fill: GOOD }, 'They complement.'));
      } else {
        bar(52, a, [{ x: 130, hit: true, label: 'broken' }]);
        bar(106, b, [{ x: 130, hit: true, label: 'broken' }]);
        stage.appendChild(el('text', { x: 180, y: 144, 'font-size': 11, 'text-anchor': 'middle', 'font-weight': 700, fill: BAD }, 'No working copy in the simple model: still white (−).'));
        stage.appendChild(el('text', { x: 180, y: 159, 'font-size': 11, 'text-anchor': 'middle', 'font-weight': 700, fill: BAD }, 'No complementation.'));
      }
    }

    function render() {
      // grid cells
      table.querySelectorAll<HTMLButtonElement>('[data-cell]').forEach((btn) => {
        const k = btn.dataset.cell!;
        const [a, b] = k.split('-').map(Number);
        btn.classList.remove('cg-plus', 'cg-minus', 'cg-last');
        if (done.has(k)) {
          const ok = SCORE[k];
          btn.textContent = ok ? '+' : '−';
          btn.classList.add(ok ? 'cg-plus' : 'cg-minus');
          btn.setAttribute('aria-label', `mutant ${a} by mutant ${b}: ${ok ? 'wild type, they complement' : 'white, they do not complement'}`);
        } else {
          btn.textContent = '';
          btn.setAttribute('aria-label', `cross mutant ${a} with mutant ${b}, not yet scored`);
        }
        if (last && key(last[0], last[1]) === k) btn.classList.add('cg-last');
      });
      const nDone = done.size;
      const fails = [...done].filter((k) => !SCORE[k]);
      const pluses = nDone - fails.length;
      countEl.textContent = `${nDone} of 15 crossed: ${pluses} complement (+), ${fails.length} do not (−)`;

      // groups
      const cl = clusters();
      groupsEl.replaceChildren();
      cl.forEach((c, idx) => {
        const d = document.createElement('div');
        d.className = 'cg-group';
        const fin = settled(c);
        d.style.borderColor = c.length > 1 || fin ? COLORS[idx % 6] : '#c9c9d1';
        d.style.borderStyle = fin ? 'solid' : 'dashed';
        const t = document.createElement('strong');
        t.textContent = c.length > 1 ? `group ${list(c)}` : `mutant ${c[0]}`;
        t.style.color = c.length > 1 || fin ? COLORS[idx % 6] : INK;
        const s = document.createElement('span');
        s.textContent = c.length > 1
          ? (fin ? 'no pair left to test' : 'untested pairs remain')
          : (fin ? 'a group of its own' : 'no failure yet');
        d.append(t, s);
        groupsEl.appendChild(d);
      });

      drawStage();

      // status line
      let v = '';
      if (nDone === 0) {
        v = 'Nothing crossed yet. In the simple model, a wild-type F1 means the two mutations are in different genes; a white F1 means they are in one complementation group, usually one gene.';
      } else if (nDone === 15 && all) {
        const gs = cl.length;
        v = `All 15 crossed, ${fails.length} failures and ${pluses} complementations: ${gs} complementation groups, ${cl.map(list).join(', ')}, so at least ${gs} genes (other genes needed for red pigment may not have been hit).`;
      } else {
        const [a, b] = last!;
        v = SCORE[key(a, b)]
          ? `Mutants ${a} and ${b} gave wild type: each chromosome supplies the working copy the other lacks, so, in the simple model, they are in different genes.`
          : `Mutants ${a} and ${b} stayed white: the diploid has no working copy of the gene (in the simple model), so they fail to complement and belong to one group.`;
        if (nDone < 15) {
          v += ` ${15 - nDone} pair${15 - nDone === 1 ? '' : 's'} left to cross.`;
          const gaps = cl.filter((c) => c.length > 2 && untestedInside(c) > 0);
          if (gaps.length) v += ` Check the inside of ${gaps.map(list).join(' and ')}: ${gaps.reduce((s, c) => s + untestedInside(c), 0)} inside pair${gaps.reduce((s, c) => s + untestedInside(c), 0) === 1 ? '' : 's'} not yet crossed.`;
        } else {
          const gs = cl.length;
          v += ` All 15 crossed, ${fails.length} failures and ${pluses} complementations: ${gs} complementation groups, ${cl.map(list).join(', ')}, so at least ${gs} genes (other genes needed for red pigment may not have been hit).`;
        }
      }
      verdict.textContent = v;
    }

    buildTable();
    root.querySelector<HTMLButtonElement>('[data-all]')!.addEventListener('click', () => {
      for (let i = 1; i <= N; i++) for (let j = i + 1; j <= N; j++) done.add(key(i, j));
      last = null; all = true; render();
    });
    root.querySelector<HTMLButtonElement>('[data-reset]')!.addEventListener('click', () => { done.clear(); last = null; all = false; render(); });
    render();
  });
</script>

<style is:global>
  .cg { padding: var(--ddp-space-3) var(--ddp-space-4) var(--ddp-space-4); margin: var(--ddp-space-5) 0; }
  .cg-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem; font-weight: 600; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); margin-bottom: var(--ddp-space-3); }
  .cg-chip { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 400; color: var(--ddp-color-muted); }
  .cg-lead { margin: 0 0 var(--ddp-space-2); font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .cg-wrap { overflow-x: auto; }
  .cg-table { border-collapse: separate; border-spacing: 3px; margin: 0 auto; }
  .cg-table th { font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); font-weight: 700; width: 2.6rem; text-align: center; }
  .cg-table td { width: 2.6rem; height: 2.4rem; text-align: center; padding: 0; }
  .cg-dim { color: var(--ddp-color-muted); background: color-mix(in srgb, var(--ddp-color-line) 35%, transparent); border-radius: 5px; }
  .cg-cell { width: 100%; height: 100%; min-height: 2.4rem; border: 1px dashed var(--ddp-color-line); border-radius: 5px; background: #fff; color: var(--ddp-color-ink-soft); font-size: var(--ddp-text-sm); font-weight: 700; cursor: pointer; }
  .cg-cell:hover { border-color: var(--ddp-color-accent); }
  .cg-cell:focus-visible, .cg-btn:focus-visible { outline: 2px solid var(--ddp-color-accent); outline-offset: 2px; }
  .cg-plus { border: 1px solid #2e7d32; background: #e7f3e8; color: #1b5e20; }
  .cg-minus { border: 1px solid #b3261e; background: #fbe9e7; color: #8c1d18; }
  .cg-last { box-shadow: 0 0 0 2px var(--ddp-color-accent); }
  .cg-row { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem; margin: var(--ddp-space-3) 0; }
  .cg-btn { border: 1px solid var(--ddp-color-line); border-radius: 5px; background: transparent; color: var(--ddp-color-ink-soft); font-size: var(--ddp-text-xs); padding: 0.3rem 0.6rem; cursor: pointer; }
  .cg-count { font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .cg-svg { display: block; width: 100%; max-width: 600px; margin: 0 auto var(--ddp-space-3); height: auto; background: #fff; border: 1px solid var(--ddp-color-line); border-radius: 6px; }
  .cg-groups { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: var(--ddp-space-2); }
  .cg-group { display: flex; flex-direction: column; border: 2px solid; border-radius: 6px; padding: 0.25rem 0.6rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .cg-verdict { margin: var(--ddp-space-2) 0; padding: var(--ddp-space-2) var(--ddp-space-3); background: color-mix(in srgb, var(--ddp-color-accent) 8%, transparent); border-radius: 6px; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); min-height: 3em; }
  .cg-foot { margin: var(--ddp-space-3) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); border-left: 3px solid var(--ddp-color-secondary); padding-left: 0.55rem; }
  @media (max-width: 520px) { .cg-table th, .cg-table td { width: 2.2rem; } }
</style>
