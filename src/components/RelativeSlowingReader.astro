---
/**
 * RelativeSlowingReader — absolute versus relative difference between a drug arm and a
 * placebo arm. Two datasets, both taken from the neurodegeneration lesson: Clarity AD
 * (18-month adjusted mean change in CDR-SB) and TRAILBLAZER-ALZ 2 (ARIA with edema or
 * effusion). "What if" sliders change the two arm values; reset returns the published ones.
 * Group means / percentages only. Self-contained vanilla-TS Astro island. Original.
 */
---

<figure class="rsr card" data-rsr>
  <figcaption class="rsr-head">Reading a trial result — absolute and relative difference<span class="rsr-chip">⚙ original · interactive</span></figcaption>

  <div class="rsr-set" role="group" aria-label="Dataset">
    <span class="rsr-lab">Dataset</span>
    <button type="button" class="rsr-btn" data-ds="cdr" aria-pressed="true">Clarity AD: CDR-SB</button>
    <button type="button" class="rsr-btn" data-ds="aria" aria-pressed="false">TRAILBLAZER-ALZ 2: ARIA</button>
  </div>

  <svg class="rsr-svg" viewBox="0 0 340 172" role="img" aria-label="Two bars from zero, one for the drug arm and one for the placebo arm, with the gap between them marked" data-plot></svg>

  <div class="rsr-controls">
    <label class="rsr-slabel"><span data-lab-drug>Drug arm</span> <em data-out="drug"></em>
      <input type="range" data-in="drug" min="0" max="3" step="0.01" value="1.21" />
    </label>
    <label class="rsr-slabel"><span data-lab-pbo>Placebo arm</span> <em data-out="pbo"></em>
      <input type="range" data-in="pbo" min="0" max="3" step="0.01" value="1.66" />
    </label>
    <button type="button" class="rsr-btn rsr-reset" data-reset>Reset to the published values</button>
  </div>

  <dl class="rsr-readout" data-readout></dl>
  <p class="rsr-why" data-why role="status"></p>

  <p class="rsr-assume" data-assume>In this sketch: group means only, no individual courses; each bar is one number (a reported figure at the published values) drawn from zero, not a trajectory over time. Mechanism-level reading of published trials, not advice.</p>
  <p class="rsr-foot">Rule to keep: a relative figure such as 27% compares two amounts of decline. It is not a 27% gain in memory, a fraction of patients helped or anyone’s prognosis, and setting it beside another trial’s percentage does not rank the drugs, because the scales, populations and durations differ.</p>
</figure>

<script>
  const NS = 'http://www.w3.org/2000/svg';
  const ACCENT = '#0e7c86', ORANGE = '#e57200', INK = '#4b4b55', PBO = '#5f5f6b';
  function el(name: string, attrs: Record<string, string | number>): SVGElement {
    const e = document.createElementNS(NS, name);
    for (const k in attrs) e.setAttribute(k, String(attrs[k]));
    return e;
  }
  type Ds = {
    id: 'cdr' | 'aria';
    drugName: string; pboName: string;
    drug: number; pbo: number; max: number; step: number; dp: number;
    unit: string; axis: string; ticks: number[];
  };
  const DS: Record<string, Ds> = {
    cdr: { id: 'cdr', drugName: 'Lecanemab', pboName: 'Placebo', drug: 1.21, pbo: 1.66, max: 3, step: 0.01, dp: 2,
      unit: 'points', axis: 'CDR-SB adjusted mean change, points (0–18)', ticks: [0, 1, 2, 3] },
    aria: { id: 'aria', drugName: 'Donanemab', pboName: 'Placebo', drug: 24.0, pbo: 2.1, max: 30, step: 0.1, dp: 1,
      unit: '%', axis: 'ARIA with edema or effusion (% of participants)', ticks: [0, 10, 20, 30] },
  };

  document.querySelectorAll<HTMLElement>('[data-rsr]').forEach((root) => {
    const plot = root.querySelector<SVGSVGElement>('[data-plot]');
    const drugIn = root.querySelector<HTMLInputElement>('[data-in="drug"]');
    const pboIn = root.querySelector<HTMLInputElement>('[data-in="pbo"]');
    const drugOut = root.querySelector<HTMLElement>('[data-out="drug"]');
    const pboOut = root.querySelector<HTMLElement>('[data-out="pbo"]');
    const labDrug = root.querySelector<HTMLElement>('[data-lab-drug]');
    const labPbo = root.querySelector<HTMLElement>('[data-lab-pbo]');
    const readout = root.querySelector<HTMLElement>('[data-readout]');
    const why = root.querySelector<HTMLElement>('[data-why]');
    const reset = root.querySelector<HTMLButtonElement>('[data-reset]');
    const btns = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-ds]'));
    if (!plot || !drugIn || !pboIn || !drugOut || !pboOut || !labDrug || !labPbo || !readout || !why || !reset) return;

    let ds: Ds = DS.cdr;
    const X0 = 100, X1 = 322;
    const eq = (a: number, b: number) => Math.abs(a - b) < 1e-9;
    const f = (v: number) => v.toFixed(ds.dp);

    function row(dt: string, dd: string): string {
      return `<div><dt>${dt}</dt><dd>${dd}</dd></div>`;
    }

    function setDataset(id: string) {
      ds = DS[id];
      btns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.ds === id)));
      drugIn!.max = String(ds.max); pboIn!.max = String(ds.max);
      drugIn!.step = String(ds.step); pboIn!.step = String(ds.step);
      drugIn!.value = String(ds.drug); pboIn!.value = String(ds.pbo);
      labDrug!.textContent = ds.drugName + ' arm';
      labPbo!.textContent = ds.pboName + ' arm';
      render();
    }

    function render() {
      const drug = parseFloat(drugIn!.value), pbo = parseFloat(pboIn!.value);
      const published = eq(drug, ds.drug) && eq(pbo, ds.pbo);
      const u = ds.id === 'cdr' ? ' points' : '%';
      drugOut!.textContent = f(drug) + u;
      pboOut!.textContent = f(pbo) + u;
      const px = (v: number) => X0 + (v / ds.max) * (X1 - X0);

      // ---- plot
      plot!.replaceChildren();
      const bars: [number, string, number, string][] = [[20, ds.drugName, drug, ACCENT], [62, ds.pboName, pbo, PBO]];
      const AY = 104;
      plot!.appendChild(el('line', { x1: X0, y1: 10, x2: X0, y2: AY, stroke: INK, 'stroke-width': 1 }));
      plot!.appendChild(el('line', { x1: X0, y1: AY, x2: X1, y2: AY, stroke: INK, 'stroke-width': 1 }));
      ds.ticks.forEach((t) => {
        plot!.appendChild(el('line', { x1: px(t), y1: AY, x2: px(t), y2: AY + 3, stroke: INK, 'stroke-width': 1 }));
        const tx = el('text', { x: px(t), y: AY + 14, 'text-anchor': t === 0 ? 'start' : t === ds.max ? 'end' : 'middle', 'font-size': 9, fill: INK });
        tx.textContent = ds.id === 'cdr' ? String(t) : t + '%';
        plot!.appendChild(tx);
      });
      const ax = el('text', { x: X0, y: AY + 27, 'font-size': 9, fill: INK });
      ax.textContent = ds.id === 'cdr' ? 'CDR-SB adjusted mean change, points (0–18)' : 'ARIA with edema or effusion, % of participants';
      plot!.appendChild(ax);
      bars.forEach(([y, name, v, col]) => {
        const w = Math.max(0, px(v) - X0);
        plot!.appendChild(el('rect', { x: X0, y, width: w, height: 30, fill: col, opacity: 0.9 }));
        const nm = el('text', { x: X0 - 6, y: y + 19, 'text-anchor': 'end', 'font-size': 10, 'font-weight': 700, fill: INK });
        nm.textContent = name;
        plot!.appendChild(nm);
        const inside = w > 110;
        const vt = el('text', { x: inside ? X0 + w - 5 : X0 + w + 5, y: y + 19, 'text-anchor': inside ? 'end' : 'start', 'font-size': 10, 'font-weight': 700, fill: inside ? '#fff' : INK });
        vt.textContent = (ds.id === 'cdr' ? '+' : '') + f(v) + (ds.id === 'cdr' ? '' : '%');
        plot!.appendChild(vt);
      });
      // gap marker on the axis
      const a = Math.min(drug, pbo), b = Math.max(drug, pbo);
      if (b > a) {
        plot!.appendChild(el('line', { x1: px(drug), y1: 50, x2: px(drug), y2: AY, stroke: ORANGE, 'stroke-width': 1, 'stroke-dasharray': '3 2' }));
        plot!.appendChild(el('line', { x1: px(pbo), y1: 62, x2: px(pbo), y2: AY, stroke: ORANGE, 'stroke-width': 1, 'stroke-dasharray': '3 2' }));
        plot!.appendChild(el('line', { x1: px(a), y1: AY, x2: px(b), y2: AY, stroke: ORANGE, 'stroke-width': 4 }));
      }
      const gap = el('text', { x: 6, y: AY + 42, 'font-size': 10, 'font-weight': 700, fill: ORANGE });
      gap.textContent = 'gap (drug − placebo): ' + (drug - pbo >= 0 ? '+' : '−') + Math.abs(drug - pbo).toFixed(ds.dp) + (ds.id === 'cdr' ? ' points' : ' percentage points');
      plot!.appendChild(gap);

      // ---- readout and status
      const diff = drug - pbo;
      let html = '', msg = '';
      if (ds.id === 'cdr') {
        const abs = pbo - drug; // points less worsening
        html += row('Absolute difference', Math.abs(abs).toFixed(2) + ' points ' + (abs >= 0 ? 'less' : 'more') + ' worsening');
        html += row('Paper’s form (drug − placebo)', (diff >= 0 ? '+' : '−') + Math.abs(diff).toFixed(2) + (published ? ' (95% CI −0.67 to −0.23)' : ''));
        if (pbo === 0) {
          html += row('Relative slowing', 'undefined (placebo change is 0)');
          html += row('Check', 'not defined');
        } else {
          const r = abs / pbo;
          const r3 = Math.round(r * 1000) / 1000;
          html += row('Relative slowing = ' + (abs < 0 ? '−' : '') + Math.abs(abs).toFixed(2) + ' / ' + pbo.toFixed(2), (r < 0 ? '−' : '') + Math.abs(r * 100).toFixed(1) + '%' + (r < 0 ? ' (negative)' : ''));
          html += row('Check: placebo × (1 − slowing)', pbo.toFixed(2) + ' × ' + (1 - r3).toFixed(3) + ' = ' + (pbo * (1 - r3)).toFixed(2));
        }
        const still = drug > 0 ? ` The ${ds.drugName.toLowerCase()} arm still worsens by ${drug.toFixed(2)} points.` : ' The drug arm shows no worsening in this what-if.';
        if (pbo === 0) {
          msg = `The placebo arm’s change is 0, so the base of the ratio is 0 and relative slowing is undefined; only the absolute gap (${Math.abs(diff).toFixed(2)} points) can be stated.` + (drug > 0 ? ` The drug arm worsens by ${drug.toFixed(2)} points.` : '');
        } else if (eq(drug, pbo)) {
          msg = `Drug arm equals placebo arm: 0.00 points difference, relative slowing 0%. Both arms worsen by ${drug.toFixed(2)} points.`;
        } else if (drug > pbo) {
          msg = `The drug arm worsens more than the placebo arm, by ${diff.toFixed(2)} points, so relative slowing is negative (−${((drug - pbo) / pbo * 100).toFixed(1)}%).`;
        } else {
          const r = (pbo - drug) / pbo;
          msg = `${(pbo - drug).toFixed(2)} points less worsening, which is ${(pbo - drug).toFixed(2)} / ${pbo.toFixed(2)} = ${(r * 100).toFixed(1)}% of the placebo change.` + still +
            (published ? ' This is the lesson’s Clarity AD example: about 27%, comparing two amounts of decline, not a 27% gain in memory, not a fraction of patients helped and not anyone’s prognosis.' : ' Same arithmetic, what-if values.');
        }
      } else {
        html += row('Absolute difference', Math.abs(diff).toFixed(1) + ' percentage points' + (diff < 0 ? ' (drug lower)' : ''));
        if (pbo === 0) {
          html += row('Ratio, drug / placebo', 'undefined (placebo rate is 0)');
          msg = `The placebo rate is 0, so the ratio is undefined; only the absolute difference (${Math.abs(diff).toFixed(1)} percentage points) can be stated.`;
        } else {
          html += row('Ratio = ' + drug.toFixed(1) + ' / ' + pbo.toFixed(1), '≈ ' + (drug / pbo).toFixed(1));
          if (eq(drug, pbo)) msg = `Drug and placebo rates are equal: 0.0 percentage points apart, ratio 1.0.`;
          else msg = `${Math.abs(diff).toFixed(1)} percentage points apart, a ratio of ${drug.toFixed(1)} / ${pbo.toFixed(1)} ≈ ${(drug / pbo).toFixed(1)}.`;
          if (published) msg += ' In TRAILBLAZER-ALZ 2, ARIA with edema or effusion (fluid or swelling seen on MRI) occurred in 24.0% of donanemab recipients and 2.1% on placebo. Safety is part of the result. Three deaths with donanemab and one with placebo were considered treatment related.';
        }
        msg += ' Donanemab slowed decline by 35.1% in people with low or medium tau, on a different scale (iADRS) over 76 weeks; setting that beside lecanemab’s 27% does not rank the drugs, because the scales, populations and durations differ.';
      }
      if (!published) msg = 'What-if values, not trial data: ' + msg;
      readout!.innerHTML = html;
      why!.textContent = msg;
    }

    btns.forEach((b) => b.addEventListener('click', () => setDataset(b.dataset.ds || 'cdr')));
    [drugIn, pboIn].forEach((s) => s.addEventListener('input', render));
    reset.addEventListener('click', () => { drugIn.value = String(ds.drug); pboIn.value = String(ds.pbo); render(); });
    setDataset('cdr');
  });
</script>

<style is:global>
  .rsr { padding: var(--ddp-space-3) var(--ddp-space-4) var(--ddp-space-4); margin: var(--ddp-space-5) 0; }
  .rsr-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem; font-weight: 600; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); margin-bottom: var(--ddp-space-3); }
  .rsr-chip { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 400; color: var(--ddp-color-muted); }
  .rsr-set { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem; margin-bottom: var(--ddp-space-2); }
  .rsr-lab { font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .rsr-btn { font: inherit; font-size: var(--ddp-text-xs); padding: 0.3rem 0.65rem; border: 1px solid var(--ddp-color-line); border-radius: 6px; background: #fff; color: var(--ddp-color-ink-soft); cursor: pointer; }
  .rsr-btn[aria-pressed="true"] { background: var(--ddp-color-accent); color: #fff; border-color: var(--ddp-color-accent); }
  .rsr-btn:focus-visible, .rsr-slabel input:focus-visible { outline: 2px solid var(--ddp-color-accent); outline-offset: 2px; }
  .rsr-svg { display: block; width: 100%; max-width: 560px; margin: 0 auto; height: auto; background: #fff; border: 1px solid var(--ddp-color-line); border-radius: 6px; }
  .rsr-controls { display: grid; grid-template-columns: 1fr 1fr; gap: var(--ddp-space-2) var(--ddp-space-4); margin: var(--ddp-space-3) 0 var(--ddp-space-2); align-items: end; }
  .rsr-slabel { display: flex; flex-direction: column; gap: 0.1rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .rsr-slabel em { font-style: normal; font-weight: 700; color: var(--ddp-color-accent); font-family: var(--ddp-font-mono); }
  .rsr-slabel input { accent-color: var(--ddp-color-accent); width: 100%; }
  .rsr-reset { grid-column: 1 / -1; justify-self: start; }
  .rsr-readout { display: grid; grid-template-columns: 1fr 1fr; gap: var(--ddp-space-2); margin: var(--ddp-space-2) 0; padding: var(--ddp-space-2) var(--ddp-space-3); background: color-mix(in srgb, var(--ddp-color-accent) 8%, transparent); border-radius: 6px; }
  .rsr-readout div { display: flex; flex-direction: column; gap: 0.1rem; min-width: 0; }
  .rsr-readout dt { font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .rsr-readout dd { margin: 0; font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); color: var(--ddp-color-primary); font-weight: 700; overflow-wrap: anywhere; }
  .rsr-why { margin: 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); line-height: 1.5; min-height: 4.5em; }
  .rsr-assume { margin: var(--ddp-space-2) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .rsr-foot { margin: var(--ddp-space-2) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); border-left: 3px solid var(--ddp-color-secondary); padding-left: 0.55rem; }
  @media (max-width: 480px) { .rsr-controls, .rsr-readout { grid-template-columns: 1fr; } }
</style>
