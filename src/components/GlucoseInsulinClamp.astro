---
/**
 * GlucoseInsulinClamp — "Read the clamp". At steady state in a hyperinsulinemic-euglycemic clamp
 * with negligible urinary glucose loss, the lesson's mass balance is Rd = J + EGP (mg per kg per
 * min). Sliders set Rd, residual EGP and body mass; the sketch shows J = Rd - EGP, the pump rate
 * J x mass / 200 mg per mL, and the error made by reading J as Rd (equal to EGP). A second
 * readout gives the same pump rate for a 50 kg and a 100 kg person. Self-contained vanilla-TS
 * Astro island. Original.
 */
---

<figure class="gic card" data-gic>
  <figcaption class="gic-head"><span>Read the clamp: pump rate against disposal</span><span class="gic-chip">⚙ original · interactive</span></figcaption>

  <svg class="gic-svg" viewBox="0 0 340 176" role="img" aria-label="Schematic of glucose entering and leaving plasma at steady state in a clamp. Arrows in: external glucose J from the pump, and endogenous production EGP. Arrow out: whole-body disposal Rd. Arrow widths follow the slider values." data-flow></svg>
  <svg class="gic-svg" viewBox="0 0 340 140" role="img" aria-label="Two bars on a scale of mg per kg per min. The upper bar is disposal Rd, made of external glucose J plus endogenous production EGP. The lower bar is J alone, with the missing part equal to EGP." data-bars></svg>

  <div class="gic-controls">
    <label class="gic-slabel"><span>Whole-body glucose disposal Rd <em data-out="rd">6.21</em> mg per kg per min</span>
      <input type="range" data-in="rd" min="2" max="11" step="0.01" value="6.21" />
    </label>
    <label class="gic-slabel"><span>Residual endogenous production EGP <em data-out="egp">0.50</em> mg per kg per min</span>
      <input type="range" data-in="egp" min="0" max="2" step="0.01" value="0.5" />
    </label>
    <label class="gic-slabel"><span>Body mass <em data-out="mass">70</em> kg</span>
      <input type="range" data-in="mass" min="50" max="100" step="1" value="70" />
    </label>
  </div>

  <dl class="gic-readout">
    <div><dt>External glucose J = Rd − EGP</dt><dd data-r="j"></dd></div>
    <div><dt>Pump rate = J × mass ÷ 200 mg per mL</dt><dd data-r="pump"></dd></div>
    <div><dt>Disposal Rd = J + EGP (check)</dt><dd data-r="rd"></dd></div>
  </dl>

  <div class="gic-warn" data-warn></div>
  <p class="gic-why" data-why role="status"></p>

  <div class="gic-two">
    <p class="gic-twohead">The same pump rate in two people</p>
    <dl class="gic-readout gic-readout2">
      <div><dt data-two-lab="a">At 50 kg</dt><dd data-r="a"></dd></div>
      <div><dt data-two-lab="b">At 100 kg</dt><dd data-r="b"></dd></div>
    </dl>
    <p class="gic-twonote" data-twonote></p>
  </div>

  <p class="gic-assume">In this sketch: steady state at matched insulin and glucose in a healthy adult, with negligible urinary glucose loss, as in the lesson’s made-up worked problem; the starting values Rd 6.21 and EGP 0.50 mg per kg per min are that problem’s person A. Made up for the sketch: the slider ranges (the top of the Rd range, 11, follows the 10–11 mg per kg per min maximal utilization that Rizza, Mandarino and Gerich found in healthy humans in 1981, a preparation-specific result), body masses of 50 to 100 kg, and the infusate fixed at 20 percent glucose, 200 mg per mL. The pump rate in mL per min is a unit conversion made up for the sketch; the lesson gives only mg per kg per min. Arrow widths are roughly proportional to flux; there is no time course and no insulin dose-response curve.</p>
  <p class="gic-foot">At steady state Rd = J + EGP, so the glucose given from outside equals disposal only if endogenous production is suppressed and urinary losses are negligible, and the lesson’s fluxes are mass-normalized, in mg per kg per min.</p>
</figure>

<script>
  const NS = 'http://www.w3.org/2000/svg';
  const ACCENT = '#0e7c86', ORANGE = '#e57200', INK = '#4b4b55', FAINT = '#b9b9c2';
  const INFUSATE = 200; // mg per mL: 20 percent glucose, made up for the sketch
  const MASS_A = 50, MASS_B = 100; // kg, made up for the sketch

  function el(name: string, attrs: Record<string, string | number>): SVGElement {
    const e = document.createElementNS(NS, name);
    for (const k in attrs) e.setAttribute(k, String(attrs[k]));
    return e;
  }
  function need<T extends Element>(root: ParentNode, sel: string): T {
    const e = root.querySelector<T>(sel);
    if (!e) throw new Error('GlucoseInsulinClamp: missing ' + sel);
    return e;
  }
  function txt(parent: SVGElement, x: number, y: number, s: string, extra: Record<string, string | number> = {}): SVGElement {
    const t = el('text', { x, y, 'font-size': 10, fill: INK, ...extra });
    t.textContent = s;
    parent.appendChild(t);
    return t;
  }
  const f2 = (n: number) => n.toFixed(2);

  document.querySelectorAll<HTMLElement>('[data-gic]').forEach((root) => {
    const flow = need<SVGSVGElement>(root, '[data-flow]');
    const bars = need<SVGSVGElement>(root, '[data-bars]');
    const rdIn = need<HTMLInputElement>(root, '[data-in="rd"]');
    const egpIn = need<HTMLInputElement>(root, '[data-in="egp"]');
    const massIn = need<HTMLInputElement>(root, '[data-in="mass"]');
    const rdOut = need<HTMLElement>(root, '[data-out="rd"]');
    const egpOut = need<HTMLElement>(root, '[data-out="egp"]');
    const massOut = need<HTMLElement>(root, '[data-out="mass"]');
    const rJ = need<HTMLElement>(root, '[data-r="j"]');
    const rPump = need<HTMLElement>(root, '[data-r="pump"]');
    const rRd = need<HTMLElement>(root, '[data-r="rd"]');
    const rA = need<HTMLElement>(root, '[data-r="a"]');
    const rB = need<HTMLElement>(root, '[data-r="b"]');
    const labA = need<HTMLElement>(root, '[data-two-lab="a"]');
    const labB = need<HTMLElement>(root, '[data-two-lab="b"]');
    const twoNote = need<HTMLElement>(root, '[data-twonote]');
    const warn = need<HTMLElement>(root, '[data-warn]');
    const why = need<HTMLElement>(root, '[data-why]');

    // Horizontal block arrow whose shaft thickness follows the flux. Zero flux is a thin dashed line.
    function arrow(svg: SVGElement, x1: number, x2: number, cy: number, flux: number, color: string): number {
      const K = 1.4;
      if (flux < 0.005) {
        svg.appendChild(el('line', { x1, y1: cy, x2, y2: cy, stroke: FAINT, 'stroke-width': 1.5, 'stroke-dasharray': '3 3' }));
        return 5;
      }
      const t = Math.max(0.8, flux * K);
      const hh = Math.max(t / 2 + 3, 5);
      const hl = Math.max(8, t * 0.8);
      const xs = x2 - hl;
      const pts = `${x1},${cy - t / 2} ${xs},${cy - t / 2} ${xs},${cy - hh} ${x2},${cy} ${xs},${cy + hh} ${xs},${cy + t / 2} ${x1},${cy + t / 2}`;
      svg.appendChild(el('polygon', { points: pts, fill: color }));
      return hh;
    }
    function block(svg: SVGElement, x: number, y: number, w: number, h: number, fill: string, stroke: string, lines: string[]) {
      svg.appendChild(el('rect', { x, y, width: w, height: h, rx: 4, fill, stroke, 'stroke-width': 1.3 }));
      const base = y + h / 2 - ((lines.length - 1) * 12.5) / 2 + 3.5;
      lines.forEach((l, i) => txt(svg, x + w / 2, base + i * 12.5, l, { 'text-anchor': 'middle' }));
    }

    function drawFlow(j: number, egp: number, rd: number) {
      flow.replaceChildren();
      // blocks: pump, internal sources, plasma, whole-body disposal
      block(flow, 4, 20, 72, 48, '#e6f4f5', ACCENT, ['glucose pump', 'infusate', '200 mg/mL']);
      block(flow, 4, 116, 72, 48, '#ffe9d1', ORANGE, ['internal', 'sources of', 'glucose']);
      block(flow, 128, 14, 76, 156, '#f4f4f7', INK, ['plasma', 'glucose held', 'near its basal', 'value (steady', 'state)']);
      block(flow, 256, 64, 80, 56, '#fbe9ea', '#b3262e', ['whole-body', 'disposal']);

      // J: pump into plasma (top); EGP: internal sources into plasma (bottom); Rd: plasma out
      const hj = arrow(flow, 76, 128, 44, j, ACCENT);
      txt(flow, 102, 44 - hj - 15, 'J ' + f2(j), { 'text-anchor': 'middle', 'font-weight': 700, fill: ACCENT });
      txt(flow, 102, 44 - hj - 3, 'mg/kg/min', { 'text-anchor': 'middle' });

      const he = arrow(flow, 76, 128, 140, egp, ORANGE);
      txt(flow, 102, 140 + he + 12, 'EGP ' + f2(egp), { 'text-anchor': 'middle', 'font-weight': 700, fill: ORANGE });
      txt(flow, 102, 140 + he + 24, 'mg/kg/min', { 'text-anchor': 'middle' });

      const hr = arrow(flow, 204, 256, 92, rd, '#b3262e');
      txt(flow, 230, 92 - hr - 15, 'Rd ' + f2(rd), { 'text-anchor': 'middle', 'font-weight': 700, fill: '#b3262e' });
      txt(flow, 230, 92 - hr - 3, 'mg/kg/min', { 'text-anchor': 'middle' });
    }

    function drawBars(j: number, egp: number, rd: number) {
      bars.replaceChildren();
      const X0 = 14, X1 = 326, MAXV = 11;
      const px = (v: number) => X0 + (v / MAXV) * (X1 - X0);
      txt(bars, X0, 12, `Disposal Rd = J + EGP = ${f2(j)} + ${f2(egp)} = ${f2(rd)}`, { 'font-weight': 700 });
      bars.appendChild(el('rect', { x: X0, y: 18, width: Math.max(px(j) - X0, 0), height: 20, fill: ACCENT }));
      if (egp >= 0.005) bars.appendChild(el('rect', { x: px(j), y: 18, width: px(rd) - px(j), height: 20, fill: ORANGE }));
      txt(bars, X0, 58, egp >= 0.005 ? `J read as Rd = ${f2(j)}; missed (dashed) = EGP = ${f2(egp)}` : `J read as Rd = ${f2(j)}; missed = EGP = ${f2(egp)}`, { 'font-weight': 700 });
      bars.appendChild(el('rect', { x: X0, y: 64, width: Math.max(px(j) - X0, 0), height: 20, fill: ACCENT }));
      if (egp >= 0.005) bars.appendChild(el('rect', { x: px(j), y: 65, width: px(rd) - px(j), height: 18, fill: 'none', stroke: ORANGE, 'stroke-width': 1.6, 'stroke-dasharray': '3 2' }));
      // axis
      bars.appendChild(el('line', { x1: X0, y1: 94, x2: X1, y2: 94, stroke: INK, 'stroke-width': 1 }));
      for (const v of [0, 2, 4, 6, 8, 10]) {
        bars.appendChild(el('line', { x1: px(v), y1: 94, x2: px(v), y2: 98, stroke: INK, 'stroke-width': 1 }));
        txt(bars, px(v), 108, String(v), { 'text-anchor': 'middle' });
      }
      txt(bars, (X0 + X1) / 2, 120, 'mg per kg per min', { 'text-anchor': 'middle' });
      // legend
      bars.appendChild(el('rect', { x: X0, y: 127, width: 9, height: 9, fill: ACCENT }));
      txt(bars, X0 + 13, 135, 'J: glucose from the pump');
      bars.appendChild(el('rect', { x: 186, y: 127, width: 9, height: 9, fill: ORANGE }));
      txt(bars, 199, 135, 'EGP: from internal sources');
    }

    function render() {
      const rd = parseFloat(rdIn.value);
      const egp = parseFloat(egpIn.value);
      const mass = parseInt(massIn.value, 10);
      const j = Math.max(0, rd - egp); // J = Rd - EGP, floored at zero
      const pump = (j * mass) / INFUSATE; // mL per min
      const aJ = (pump * INFUSATE) / MASS_A;
      const bJ = (pump * INFUSATE) / MASS_B;
      const zero = egp < 0.005;
      const none = j < 0.005;

      rdOut.textContent = f2(rd);
      egpOut.textContent = f2(egp);
      massOut.textContent = String(mass);
      rJ.textContent = f2(j) + ' mg per kg per min';
      rPump.textContent = f2(pump) + ' mL per min';
      rRd.textContent = f2(j + egp) + ' mg per kg per min';

      drawFlow(j, egp, j + egp);
      drawBars(j, egp, j + egp);

      // warning bar: the error made by reading J as Rd
      if (zero) {
        warn.textContent = `No error here: EGP is 0.00 mg per kg per min, so reading J as Rd gives ${f2(rd)}, the true Rd.`;
        warn.className = 'gic-warn gic-warn-ok';
      } else {
        const pct = (egp / rd) * 100;
        warn.textContent = `Warning: reading J as Rd is an underestimate. Error = EGP = ${f2(egp)} mg per kg per min, ${pct.toFixed(1)} percent of Rd (J alone gives ${f2(j)}; Rd is ${f2(j + egp)}).`;
        warn.className = 'gic-warn gic-warn-bad';
      }

      // status sentence, written for the state the controls are in
      let msg: string;
      if (zero) {
        msg = `In this sketch, EGP is 0.00 mg per kg per min, so the pump supplies all the disposal: J = Rd = ${f2(rd)} mg per kg per min, which is ${f2(pump)} mL per min at ${mass} kg. External glucose entry equals disposal only if endogenous production is suppressed and urinary losses are negligible.`;
      } else if (none) {
        msg = `In this sketch, EGP (${f2(egp)}) equals Rd (${f2(rd)}) mg per kg per min, so J = 0.00 and the pump rate is 0.00 mL per min, yet Rd is ${f2(rd)}. Reading J alone would give 0.00.`;
      } else {
        msg = `In this sketch, with Rd ${f2(rd)} and EGP ${f2(egp)} mg per kg per min, the external glucose entry is J = ${f2(rd)} − ${f2(egp)} = ${f2(j)} mg per kg per min, or ${f2(pump)} mL per min at ${mass} kg. At fixed Rd, a larger EGP lowers the external input J, and reading J alone underestimates Rd by EGP.`;
      }
      why.textContent = msg;

      // same pump rate, two people
      labA.textContent = `At ${MASS_A} kg, J would be`;
      labB.textContent = `At ${MASS_B} kg, J would be`;
      rA.textContent = f2(aJ) + ' mg per kg per min';
      rB.textContent = f2(bJ) + ' mg per kg per min';
      twoNote.textContent = none
        ? `In this sketch, a pump rate of 0.00 mL per min is J = 0.00 mg per kg per min at any body mass.`
        : `In this sketch, the same pump rate of ${f2(pump)} mL per min gives a different J per kilogram in a lighter and a heavier person; the lesson’s fluxes are mass-normalized (mg per kg per min).`;
    }

    [rdIn, egpIn, massIn].forEach((s) => s.addEventListener('input', render));
    render();
  });
</script>

<style is:global>
  .gic { padding: var(--ddp-space-3) var(--ddp-space-4) var(--ddp-space-4); margin: var(--ddp-space-5) 0; }
  .gic-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem; font-weight: 600; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); margin-bottom: var(--ddp-space-3); }
  .gic-chip { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 400; color: var(--ddp-color-muted); }
  .gic-svg { display: block; width: 100%; max-width: 480px; margin: 0 auto var(--ddp-space-3); height: auto; background: #fff; border: 1px solid var(--ddp-color-line); border-radius: 6px; }
  .gic-controls { display: grid; grid-template-columns: 1fr; gap: var(--ddp-space-2); margin: var(--ddp-space-3) 0 var(--ddp-space-2); }
  .gic-slabel { display: flex; flex-direction: column; gap: 0.15rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .gic-slabel em { font-style: normal; font-weight: 700; color: var(--ddp-color-accent); font-family: var(--ddp-font-mono); }
  .gic-slabel input[type="range"] { accent-color: var(--ddp-color-accent); width: 100%; }
  .gic-readout { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: var(--ddp-space-2); margin: var(--ddp-space-2) 0; padding: var(--ddp-space-2) var(--ddp-space-3); background: color-mix(in srgb, var(--ddp-color-accent) 8%, transparent); border-radius: 6px; }
  figure.gic .gic-readout div { display: flex; flex-direction: column; gap: 0.1rem; }
  figure.gic .gic-readout dt { font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  figure.gic .gic-readout dd { margin: 0; font-family: var(--ddp-font-mono); font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); font-weight: 700; overflow-wrap: anywhere; }
  figure.gic .gic-warn { margin: var(--ddp-space-2) 0; padding: var(--ddp-space-2) var(--ddp-space-3); border-radius: 6px; font-size: var(--ddp-text-xs); line-height: 1.5; color: var(--ddp-color-ink-soft); min-height: 3.2em; }
  figure.gic .gic-warn-bad { background: #fff1e0; border-left: 4px solid #e57200; }
  figure.gic .gic-warn-ok { background: #e8f5ee; border-left: 4px solid #2e7d4f; }
  figure.gic .gic-why { margin: 0 0 var(--ddp-space-2); font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); line-height: 1.5; min-height: 6em; }
  figure.gic .gic-twohead { margin: var(--ddp-space-2) 0 0; font-size: var(--ddp-text-xs); font-weight: 700; color: var(--ddp-color-primary); }
  figure.gic .gic-twonote { margin: 0 0 var(--ddp-space-2); font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); line-height: 1.5; min-height: 4.5em; }
  figure.gic .gic-assume { margin: 0 0 var(--ddp-space-2); font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); line-height: 1.5; }
  figure.gic .gic-foot { margin: var(--ddp-space-2) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); border-left: 3px solid var(--ddp-color-secondary); padding-left: 0.55rem; }
</style>
