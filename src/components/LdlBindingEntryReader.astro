---
/**
 * LdlBindingEntryReader — read the lesson's illustrative 125I-LDL experiment. Choose a cell
 * type (normal, strain X, strain Y) and a step (bound at 4 °C, or after 10 min at 37 °C and an
 * acid/heparin strip). Bars show bound, surface and internal LDL in ng per mg cell protein;
 * the readouts apply the lesson's two formulas. Every number is from the lesson's worked
 * problem; nothing is random. Self-contained vanilla-TS Astro island. Original.
 */
---

<figure class="lbe card" data-lbe>
  <figcaption class="lbe-head">Binding or entry? Read the 125I-LDL experiment<span class="lbe-chip">⚙ original · interactive</span></figcaption>

  <svg class="lbe-svg" viewBox="0 0 360 190" role="img" aria-label="Bars showing LDL bound at 4 degrees, LDL left on the surface, and LDL inside the cells, in nanograms per milligram of cell protein" data-stage></svg>

  <div class="lbe-controls">
    <fieldset class="lbe-set">
      <legend>Cells</legend>
      <label><input type="radio" name="lbe-cell" value="normal" checked /> Normal</label>
      <label><input type="radio" name="lbe-cell" value="x" /> Strain X</label>
      <label><input type="radio" name="lbe-cell" value="y" /> Strain Y</label>
    </fieldset>
    <fieldset class="lbe-set">
      <legend>Step</legend>
      <label><input type="radio" name="lbe-step" value="cold" checked /> Bound at 4 °C</label>
      <label><input type="radio" name="lbe-step" value="warm" /> After 10 min at 37 °C, then strip</label>
    </fieldset>
  </div>

  <dl class="lbe-readout">
    <div><dt>Binding relative to normal</dt><dd data-rel></dd></div>
    <div><dt>Fraction internalized</dt><dd data-frac></dd></div>
  </dl>

  <p class="lbe-verdict" data-verdict role="status"></p>

  <p class="lbe-foot">Binding relative to normal = bound (strain) ÷ bound (normal); fraction internalized = internal ÷ bound at 4 °C. A low value of the first is a binding defect; normal binding with a low value of the second is an entry defect. The numbers are illustrative, made up for practice in the lesson.</p>
</figure>

<script>
  type Row = { name: string; bound: number; surface: number | null; internal: number | null };
  const ROWS: Record<string, Row> = {
    normal: { name: "Normal cells", bound: 40, surface: 10, internal: 30 },
    x: { name: "Strain X", bound: 1.0, surface: null, internal: null },
    y: { name: "Strain Y", bound: 38, surface: 35, internal: 3 },
  };
  const NS = "http://www.w3.org/2000/svg";
  const SCALE_MAX = 40;
  const X0 = 96, W = 200;
  const pct = (v: number) => (Math.round(v * 1000) / 10).toString().replace(/\.0$/, "");
  const num = (v: number) => (Number.isInteger(v) ? v.toFixed(0) : v.toFixed(1));
  function el(name: string, attrs: Record<string, string | number>, text?: string): SVGElement {
    const e = document.createElementNS(NS, name);
    for (const k in attrs) e.setAttribute(k, String(attrs[k]));
    if (text !== undefined) e.textContent = text;
    return e;
  }
  document.querySelectorAll<HTMLElement>("[data-lbe]").forEach((root) => {
    const stage = root.querySelector<SVGSVGElement>("[data-stage]")!;
    const relEl = root.querySelector<HTMLElement>("[data-rel]")!;
    const fracEl = root.querySelector<HTMLElement>("[data-frac]")!;
    const verdict = root.querySelector<HTMLElement>("[data-verdict]")!;
    const val = (n: string) => root.querySelector<HTMLInputElement>(`input[name="${n}"]:checked`)!.value;

    function bar(y: number, label: string, v: number | null, fill: string, note?: string) {
      stage.appendChild(el("text", { x: X0 - 6, y: y + 15, "font-size": 10, "text-anchor": "end", fill: "#4b4b55" }, label));
      if (v === null) {
        stage.appendChild(el("text", { x: X0 + 4, y: y + 15, "font-size": 10, fill: "#6b6b76" }, note ?? "not given"));
        return;
      }
      const w = Math.max(1.5, (v / SCALE_MAX) * W);
      stage.appendChild(el("rect", { x: X0, y, width: w, height: 22, fill, rx: 2 }));
      stage.appendChild(el("text", { x: X0 + w + 6, y: y + 15, "font-size": 10, "font-weight": 700, fill: "#2b2b33" }, num(v)));
    }
    function render() {
      const cell = ROWS[val("lbe-cell")];
      const step = val("lbe-step");
      const normal = ROWS.normal;
      const warm = step === "warm";
      stage.replaceChildren();
      // axis
      stage.appendChild(el("line", { x1: X0, y1: 28, x2: X0, y2: 148, stroke: "#8a8a96", "stroke-width": 1 }));
      stage.appendChild(el("text", { x: 8, y: 14, "font-size": 10, "font-weight": 700, fill: "#2b2b33" }, `${cell.name}, ${warm ? "after 10 min at 37 °C" : "at 4 °C"}`));
      bar(34, "bound at 4 °C", cell.bound, "#0e7c86");
      let surface: number | null, internal: number | null;
      if (!warm) { surface = cell.bound; internal = 0; }
      else { surface = cell.surface; internal = cell.internal; }
      const missing = warm && surface === null;
      bar(68, "on surface", surface, "#e57200", missing ? "not given in the lesson" : undefined);
      bar(102, "internal", internal, "#7a5ea8", missing ? "not given in the lesson" : undefined);
      stage.appendChild(el("text", { x: X0, y: 160, "font-size": 10, fill: "#4b4b55" }, "0"));
      stage.appendChild(el("text", { x: X0 + W, y: 160, "font-size": 10, "text-anchor": "end", fill: "#4b4b55" }, String(SCALE_MAX)));
      stage.appendChild(el("text", { x: X0 + W / 2, y: 178, "font-size": 10, "text-anchor": "middle", fill: "#4b4b55" }, "ng LDL per mg cell protein"));

      const rel = cell.bound / normal.bound;
      relEl.textContent = `${num(cell.bound)} ÷ ${num(normal.bound)} = ${pct(rel)} percent`;
      let msg = "";
      if (!warm) {
        fracEl.textContent = "not yet: nothing enters at 4 °C";
        if (cell === normal) msg = "At 4 °C the cells bind 40 ng/mg and nothing enters, so all 40 is on the surface. Warm them to see where it goes.";
        else if (cell === ROWS.x) msg = "Strain X binds 1.0 ng/mg, 2.5 percent of normal. That is a binding defect: the receptor is absent from the surface or cannot bind.";
        else msg = "Strain Y binds 38 ng/mg, nearly normal binding (readout above). Warm the cells to test entry.";
      } else if (missing) {
        fracEl.textContent = "not given in the lesson";
        msg = "The lesson gives no warmed values for strain X. It binds only 2.5 percent of normal, which is a binding defect.";
      } else {
        const f = cell.internal! / cell.bound;
        fracEl.textContent = `${num(cell.internal!)} ÷ ${num(cell.bound)} = ${pct(f)} percent`;
        const chk = `Check: ${num(cell.surface!)} + ${num(cell.internal!)} = ${num(cell.bound)}, so no LDL went missing.`;
        if (cell === normal) msg = `Normal cells internalize 30 of 40, 75 percent in 10 minutes. ${chk}`;
        else msg = `Strain Y binds nearly normally (38) but internalizes only 3 of 38, ${pct(f)} percent against 75 percent in normal cells. That is an entry defect, like J.D.’s receptor. ${chk}`;
      }
      verdict.textContent = msg;
    }
    root.querySelectorAll("input").forEach((i) => i.addEventListener("change", render));
    render();
  });
</script>

<style is:global>
  .lbe { padding: var(--ddp-space-3) var(--ddp-space-4) var(--ddp-space-4); margin: var(--ddp-space-5) 0; }
  .lbe-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem; font-weight: 600; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); margin-bottom: var(--ddp-space-3); }
  .lbe-chip { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 400; color: var(--ddp-color-muted); }
  .lbe-svg { display: block; width: 100%; max-width: 560px; margin: 0 auto; height: auto; background: #fff; border: 1px solid var(--ddp-color-line); border-radius: 6px; }
  .lbe-controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: var(--ddp-space-2) var(--ddp-space-4); margin: var(--ddp-space-3) 0 var(--ddp-space-2); }
  .lbe-set { border: 1px solid var(--ddp-color-line); border-radius: 6px; padding: 0.3rem 0.6rem 0.5rem; margin: 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .lbe-set legend { padding: 0 0.3rem; font-weight: 600; }
  .lbe-set label { display: block; padding: 0.15rem 0; }
  .lbe-readout { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: var(--ddp-space-2); margin: var(--ddp-space-2) 0; padding: var(--ddp-space-2) var(--ddp-space-3); background: color-mix(in srgb, var(--ddp-color-accent) 8%, transparent); border-radius: 6px; }
  .lbe-readout dt { font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .lbe-readout dd { margin: 0; font-family: var(--ddp-font-mono); font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); font-weight: 700; overflow-wrap: anywhere; }
  .lbe-verdict { margin: 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); line-height: 1.5; min-height: 4.5em; }
  .lbe-foot { margin: var(--ddp-space-3) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); border-left: 3px solid var(--ddp-color-secondary); padding-left: 0.55rem; }
</style>
