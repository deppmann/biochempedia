---
/**
 * UnitaryConductanceEnsemble — a conductance computed from one recorded point, then a
 * made-up ensemble of identical channels. Left: the linear current-voltage line through
 * the reversal potential, with the measured point marked. Right: a grid of N channels,
 * open ones filled. Numbers are the hair-cell transduction lesson's worked problem
 * (Beurg and colleagues 2006: -15.0 pA at -84 mV, E_rev +3 mV). N and P_open are
 * teaching assumptions. Self-contained vanilla-TS Astro island. Original.
 */
---

<figure class="uce card" data-uce>
  <figcaption class="uce-head">From one channel to an ensemble — conductance and I = N × i × P<sub>open</sub><span class="uce-chip">⚙ original · interactive</span></figcaption>

  <div class="uce-plots">
    <svg class="uce-svg" viewBox="0 0 340 250" role="img" aria-label="Linear current-voltage line for one transduction channel, crossing zero at +3 millivolts, with the measured point at minus 84 millivolts and minus 15 picoamperes" data-iv></svg>
    <svg class="uce-svg" viewBox="0 0 340 250" role="img" aria-label="Grid of channel squares, open channels filled" data-grid></svg>
  </div>

  <div class="uce-controls">
    <label class="uce-slabel"><span>Membrane potential V <em data-out="v">-84</em> mV</span>
      <input type="range" data-in="v" min="-120" max="40" step="1" value="-84" />
    </label>
    <label class="uce-slabel"><span>Number of channels N <em data-out="n">100</em> <small>(teaching assumption)</small></span>
      <input type="range" data-in="n" min="1" max="200" step="1" value="100" />
    </label>
    <label class="uce-slabel"><span>Open probability P<sub>open</sub> <em data-out="p">0.20</em> <small>(teaching assumption)</small></span>
      <input type="range" data-in="p" min="0" max="1" step="0.01" value="0.20" />
    </label>
    <div class="uce-btnrow"><button type="button" class="uce-btn" data-resample>Resample which channels are open</button></div>
  </div>

  <dl class="uce-readout">
    <div><dt>Driving force V − E<sub>rev</sub> (E<sub>rev</sub> = +3 mV)</dt><dd data-r="df"></dd></div>
    <div><dt>Conductance g = i / (V − E<sub>rev</sub>), from −15.0 pA at −84 mV</dt><dd data-r="g"></dd></div>
    <div><dt>Unitary current i at this V (linear assumption)</dt><dd data-r="i"></dd></div>
    <div><dt>Open channels: expected N × P<sub>open</sub> | drawn</dt><dd data-r="cnt"></dd></div>
    <div><dt>Expected ensemble current I = N × i × P<sub>open</sub></dt><dd data-r="exp"></dd></div>
    <div><dt>Simulated current = drawn open count × i</dt><dd data-r="obs"></dd></div>
  </dl>

  <p class="uce-why" data-why role="status"></p>

  <p class="uce-assume"><strong>In this sketch:</strong> a linear current-voltage relation (assumed, and extended in both directions from the one measured point at −84 mV, so everything away from that point is extrapolated, not measured), E<sub>rev</sub> taken as +3 mV (the lesson’s assumption), identical independent channels, rat inner hair cells P6 to P11, 1.5 mM external calcium (Beurg and colleagues, 2006), room temperature (19 to 22 °C), no adaptation. The −15.0 pA is the lesson’s mean unitary current (15.0 ± 1.6 pA, SD, n = 7, taken as inward) at −84 mV; every other number follows from it by the formula.</p>
  <p class="uce-assume"><strong>Not shown here:</strong> that there is one hair-cell conductance (the same paper estimated about 260 pS at 0.02 mM calcium, and in the same paper’s low-calcium estimates, rat outer hair cells rose from 145 to 210 pS between sampled low- and mid-frequency positions); that N and P<sub>open</sub> are measurements; or that a conductance identifies which protein forms the pore.</p>

  <p class="uce-foot">Rule to keep: g = i / (V − E<sub>rev</sub>), and the whole ensemble current is I = N × i × P<sub>open</sub>. A conductance is quoted with its ionic conditions, and a negative current is inward.</p>
</figure>

<script>
  const NS = 'http://www.w3.org/2000/svg';
  const ACCENT = '#0e7c86', ORANGE = '#e57200', INK = '#4b4b55', FAINT = '#b9b9c2', LIGHT = '#e4e6ea';
  function el(name: string, attrs: Record<string, string | number>): SVGElement {
    const e = document.createElementNS(NS, name);
    for (const k in attrs) e.setAttribute(k, String(attrs[k]));
    return e;
  }
  function txt(x: number, y: number, s: string, extra: Record<string, string | number> = {}): SVGElement {
    const t = el('text', { x, y, 'font-size': 10, fill: INK, ...extra });
    t.textContent = s;
    return t;
  }
  const MINUS = '−';
  const fmt = (x: number, d: number) => {
    const s = (Math.abs(x) < 0.5 * Math.pow(10, -d) ? 0 : x).toFixed(d);
    return s.replace('-', MINUS);
  };
  const dir = (x: number) => (Math.abs(x) < 0.05 ? 'zero' : x < 0 ? 'inward' : 'outward');

  const E_REV = 3, V_REF = -84, I_REF = -15.0;
  const G = I_REF / (V_REF - E_REV); // nS (pA / mV)
  const iAt = (v: number) => G * (v - E_REV);

  document.querySelectorAll<HTMLElement>('[data-uce]').forEach((root) => {
    const need = <T extends Element>(s: string): T => {
      const e = root.querySelector<T>(s);
      if (!e) throw new Error('UnitaryConductanceEnsemble: missing ' + s);
      return e;
    };
    const iv = need<SVGSVGElement>('[data-iv]');
    const grid = need<SVGSVGElement>('[data-grid]');
    const vIn = need<HTMLInputElement>('[data-in="v"]');
    const nIn = need<HTMLInputElement>('[data-in="n"]');
    const pIn = need<HTMLInputElement>('[data-in="p"]');
    const vOut = need<HTMLElement>('[data-out="v"]');
    const nOut = need<HTMLElement>('[data-out="n"]');
    const pOut = need<HTMLElement>('[data-out="p"]');
    const resample = need<HTMLButtonElement>('[data-resample]');
    const why = need<HTMLElement>('[data-why]');
    const r = (k: string) => need<HTMLElement>('[data-r="' + k + '"]');
    const rDf = r('df'), rG = r('g'), rI = r('i'), rCnt = r('cnt'), rExp = r('exp'), rObs = r('obs');

    const MAXN = 200;
    let draws: number[] = [];
    const redraw = () => { draws = Array.from({ length: MAXN }, () => Math.random()); };
    redraw();

    // I-V plot geometry
    const X0 = 52, X1 = 326, Y0 = 22, Y1 = 214;
    const VMIN = -120, VMAX = 40, IMIN = -24, IMAX = 8;
    const px = (v: number) => X0 + ((v - VMIN) / (VMAX - VMIN)) * (X1 - X0);
    const py = (i: number) => Y1 - ((i - IMIN) / (IMAX - IMIN)) * (Y1 - Y0);

    function drawIV(v: number, i: number) {
      iv.replaceChildren();
      iv.appendChild(el('rect', { x: X0, y: Y0, width: X1 - X0, height: Y1 - Y0, fill: '#fff', stroke: LIGHT }));
      for (const c of [-20, -15, -10, -5, 0, 5]) {
        iv.appendChild(el('line', { x1: X0, y1: py(c), x2: X1, y2: py(c), stroke: c === 0 ? INK : LIGHT, 'stroke-width': c === 0 ? 1 : 0.7 }));
        iv.appendChild(txt(X0 - 4, py(c) + 3, fmt(c, 0), { 'text-anchor': 'end', 'font-size': 9 }));
      }
      for (const m of [-120, -80, -40, 0, 40]) {
        iv.appendChild(el('line', { x1: px(m), y1: Y1, x2: px(m), y2: Y1 + 3, stroke: INK }));
        iv.appendChild(txt(px(m), Y1 + 13, fmt(m, 0), { 'text-anchor': 'middle', 'font-size': 9 }));
      }
      iv.appendChild(txt((X0 + X1) / 2, Y1 + 28, 'V (mV)', { 'text-anchor': 'middle' }));
      iv.appendChild(txt(X0 - 4, Y0 - 8, 'unitary current i (pA)', { 'text-anchor': 'start' }));
      // the line
      iv.appendChild(el('line', { x1: px(VMIN), y1: py(iAt(VMIN)), x2: px(VMAX), y2: py(iAt(VMAX)), stroke: ACCENT, 'stroke-width': 2.4 }));
      // reversal point
      iv.appendChild(el('circle', { cx: px(E_REV), cy: py(0), r: 4, fill: '#fff', stroke: INK, 'stroke-width': 1.5 }));
      iv.appendChild(txt(px(E_REV) - 4, py(0) - 8, 'E_rev = +3 mV', { 'font-size': 9, 'text-anchor': 'end' }));
      // measured point
      iv.appendChild(el('circle', { cx: px(V_REF), cy: py(I_REF), r: 4.5, fill: ACCENT, stroke: '#fff', 'stroke-width': 1 }));
      iv.appendChild(txt(px(V_REF) - 6, py(I_REF) + 17, 'measured: −15.0 pA at −84 mV', { 'font-size': 9, 'text-anchor': 'start', fill: ACCENT, 'font-weight': 700 }));
      // current point
      const cx = px(v), cy = py(i);
      iv.appendChild(el('line', { x1: cx, y1: Y1, x2: cx, y2: cy, stroke: ORANGE, 'stroke-width': 1.2, 'stroke-dasharray': '3 2' }));
      iv.appendChild(el('line', { x1: X0, y1: cy, x2: cx, y2: cy, stroke: ORANGE, 'stroke-width': 1.2, 'stroke-dasharray': '3 2' }));
      iv.appendChild(el('circle', { cx, cy, r: 5, fill: ORANGE, stroke: '#fff', 'stroke-width': 1 }));
    }

    function drawGrid(n: number, open: number) {
      grid.replaceChildren();
      const W = 300, H = 170, GX = 20, GY = 34;
      const cols = Math.max(1, Math.ceil(Math.sqrt((n * W) / H)));
      const rows = Math.ceil(n / cols);
      const cell = Math.min(40, W / cols, H / rows);
      const gap = cell > 8 ? 1.5 : 0.8;
      const ox = GX + (W - cell * cols) / 2, oy = GY + (H - cell * rows) / 2;
      grid.appendChild(txt(GX, 18, 'N = ' + n + ' channels, ' + open + ' drawn open (filled)', { 'font-size': 10, 'font-weight': 700 }));
      for (let k = 0; k < n; k++) {
        const isOpen = draws[k] < parseFloat(pIn.value);
        const rx = ox + (k % cols) * cell + gap / 2, ry = oy + Math.floor(k / cols) * cell + gap / 2;
        grid.appendChild(el('rect', {
          x: rx, y: ry, width: Math.max(1, cell - gap), height: Math.max(1, cell - gap), rx: cell > 10 ? 2 : 0.5,
          fill: isOpen ? ACCENT : '#fff', stroke: isOpen ? ACCENT : FAINT, 'stroke-width': 0.8,
        }));
      }
      grid.appendChild(el('rect', { x: GX - 4, y: GY - 4, width: W + 8, height: H + 8, fill: 'none', stroke: LIGHT }));
      grid.appendChild(txt(GX, GY + H + 24, 'filled = open, empty = closed; one random draw per channel', { 'font-size': 9 }));
      grid.appendChild(txt(GX, GY + H + 37, 'N and P_open are teaching assumptions', { 'font-size': 9 }));
    }

    function render() {
      const v = parseInt(vIn.value, 10);
      const n = parseInt(nIn.value, 10);
      const p = parseFloat(pIn.value);
      const df = v - E_REV;
      const i = iAt(v);
      let open = 0;
      for (let k = 0; k < n; k++) if (draws[k] < p) open++;
      const expOpen = n * p;
      const expI = n * i * p;
      const obsI = open * i;

      vOut.textContent = fmt(v, 0);
      nOut.textContent = String(n);
      pOut.textContent = p.toFixed(2);

      rDf.textContent = fmt(df, 0) + ' mV';
      rG.textContent = fmt(G, 3) + ' nS (about ' + fmt(G * 1000, 0) + ' pS)';
      rI.textContent = fmt(i, 1) + ' pA (' + dir(i) + ')';
      rCnt.textContent = fmt(expOpen, 1) + ' | ' + open;
      rExp.textContent = fmt(expI, 1) + ' pA (' + dir(expI) + ')';
      rObs.textContent = fmt(obsI, 1) + ' pA (' + dir(obsI) + ')';

      drawIV(v, i);
      drawGrid(n, open);

      let s: string;
      if (v === E_REV) {
        s = `At V = +3 mV the driving force is 0 mV, so in this sketch each channel carries 0 pA however many are open: the expected and the simulated ensemble current are both 0. The conductance g = ${fmt(G * 1000, 0)} pS is unchanged, because it was computed from the measured point.`;
      } else if (v > E_REV) {
        s = `Above E_rev (+3 mV) the driving force is ${fmt(df, 0)} mV, so in this sketch the assumed linear line, extrapolated beyond the measured point, gives an outward current of ${fmt(i, 1)} pA per open channel. The ensemble: expected ${fmt(expI, 1)} pA, simulated ${fmt(obsI, 1)} pA from ${open} drawn open of N = ${n}.`;
      } else {
        s = `Driving force ${fmt(df, 0)} mV with g = ${fmt(G * 1000, 0)} pS gives ${fmt(i, 1)} pA per open channel, inward (negative). The ensemble: expected ${fmt(expOpen, 1)} open × ${fmt(i, 1)} pA = ${fmt(expI, 1)} pA; the draw shows ${open} open, simulated ${fmt(obsI, 1)} pA.`;
      }
      if (v === V_REF && n === 100 && Math.abs(p - 0.2) < 1e-9) {
        s += ' This is the lesson’s made-up ensemble: 100 × (−15.0 pA) × 0.20 = −300 pA expected. The simulated value scatters around it; press Resample.';
      }
      if (p === 0) s += ' With P_open = 0 no channel is open, so the simulated current is 0 pA.';
      if (p === 1) s += ' With P_open = 1 every channel is open, so simulated equals expected.';
      why.textContent = s;
    }

    [vIn, nIn, pIn].forEach((s) => s.addEventListener('input', render));
    resample.addEventListener('click', () => { redraw(); render(); });
    render();
  });
</script>

<style>
  .uce { padding: var(--ddp-space-3) var(--ddp-space-4) var(--ddp-space-4); margin: var(--ddp-space-5) 0; }
  .uce-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem; font-weight: 600; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); margin-bottom: var(--ddp-space-3); }
  .uce-chip { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 400; color: var(--ddp-color-muted); }
  .uce-plots { display: grid; grid-template-columns: 1fr 1fr; gap: var(--ddp-space-3); }
  .uce-svg { display: block; width: 100%; height: auto; background: #fff; border: 1px solid var(--ddp-color-line); border-radius: 6px; }
  .uce-controls { display: grid; grid-template-columns: 1fr 1fr; gap: var(--ddp-space-2) var(--ddp-space-4); margin: var(--ddp-space-3) 0 var(--ddp-space-2); }
  .uce-slabel { display: flex; flex-direction: column; gap: 0.1rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .uce-slabel small { font-size: inherit; color: var(--ddp-color-muted); }
  .uce-slabel em { font-style: normal; font-weight: 700; color: var(--ddp-color-accent); font-family: var(--ddp-font-mono); }
  .uce-slabel input { accent-color: var(--ddp-color-accent); }
  .uce-btnrow { display: flex; align-items: flex-end; }
  .uce-btn { font: inherit; font-size: var(--ddp-text-xs); padding: 0.4rem 0.7rem; border: 1px solid var(--ddp-color-accent); background: #fff; color: var(--ddp-color-accent); border-radius: 6px; cursor: pointer; }
  .uce-btn:hover, .uce-btn:focus-visible { background: color-mix(in srgb, var(--ddp-color-accent) 10%, transparent); }
  .uce-readout { display: grid; grid-template-columns: 1fr 1fr; gap: var(--ddp-space-2); margin: var(--ddp-space-2) 0; padding: var(--ddp-space-2) var(--ddp-space-3); background: color-mix(in srgb, var(--ddp-color-accent) 8%, transparent); border-radius: 6px; }
  .uce-readout div { display: flex; flex-direction: column; gap: 0.1rem; min-width: 0; }
  .uce-readout dt { font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .uce-readout dd { margin: 0; font-family: var(--ddp-font-mono); font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); font-weight: 700; overflow-wrap: anywhere; }
  .uce-why { margin: 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); line-height: 1.5; min-height: 5em; }
  .uce-assume { margin: var(--ddp-space-2) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); line-height: 1.5; }
  .uce-foot { margin: var(--ddp-space-3) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); border-left: 3px solid var(--ddp-color-secondary); padding-left: 0.55rem; }
  @media (max-width: 640px) {
    .uce-plots, .uce-controls, .uce-readout { grid-template-columns: 1fr; }
  }
</style>
