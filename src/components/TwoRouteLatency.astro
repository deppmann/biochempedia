---
/**
 * TwoRouteLatency — the worked problem of the dorsal-horn lesson as a sketch. A flat
 * schematic of one side of a mouse (hindpaw, dorsal root ganglion, the LTMR recipient zone
 * of the lumbar dorsal horn, dorsal column, gracile nucleus) with a direct route (Aβ-LTMR
 * axon up the dorsal column) and an indirect route (two dorsal horn synapses, then a PSDC
 * axon). t = L / v with the lesson's fixed lengths (0.08 m direct; 0.04 m paw to cord;
 * 0.04 m PSDC axon). Everything below the medulla is on the stimulated paw's side; the
 * second-order axon crosses in the medulla. Original; self-contained vanilla-TS island.
 */
---

<figure class="trl card" data-trl>
  <figcaption class="trl-head">Two routes to the gracile nucleus — a latency sketch<span class="trl-chip">⚙ original · interactive</span></figcaption>

  <svg class="trl-svg" viewBox="0 0 360 330" role="img" aria-label="Schematic of one side of a mouse: a direct Aβ-LTMR axon and an indirect route through two dorsal horn synapses and a PSDC axon, both reaching the gracile nucleus on the stimulated paw's side; the second-order axon then crosses in the medulla to VPL" data-map>
    <!-- side headers and the medullary midline -->
    <text x="8" y="14" font-size="10" font-weight="700" fill="#4b4b55">Stimulated paw’s side</text>
    <text x="256" y="14" font-size="10" font-weight="700" fill="#4b4b55">Opposite side</text>
    <line x1="250" y1="4" x2="250" y2="72" stroke="#b9b9c2" stroke-width="1" stroke-dasharray="3 3" />

    <!-- gracile nucleus, crossing, VPL -->
    <rect x="50" y="36" width="150" height="28" rx="5" fill="#f3f3f6" stroke="#4b4b55" stroke-width="1.2" />
    <text x="125" y="54" text-anchor="middle" font-size="10" font-weight="700" fill="#4b4b55">Gracile nucleus</text>
    <line x1="200" y1="50" x2="256" y2="50" stroke="#4b4b55" stroke-width="1.6" marker-end="url(#trl-arrow)" />
    <rect x="258" y="30" width="92" height="40" rx="5" fill="#f3f3f6" stroke="#4b4b55" stroke-width="1.2" />
    <text x="304" y="47" text-anchor="middle" font-size="10" font-weight="700" fill="#4b4b55">VPL</text>
    <text x="304" y="60" text-anchor="middle" font-size="10" fill="#4b4b55">(thalamus)</text>
    <text x="206" y="86" font-size="10" fill="#4b4b55">second-order axon crosses</text>
    <text x="206" y="98" font-size="10" fill="#4b4b55">in the medulla to VPL</text>
    <defs>
      <marker id="trl-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0 L8 4 L0 8 z" fill="#4b4b55" /></marker>
    </defs>

    <!-- dorsal column label -->
    <text x="116" y="104" text-anchor="middle" font-size="10" fill="#4b4b55">dorsal</text>
    <text x="116" y="116" text-anchor="middle" font-size="10" fill="#4b4b55">column</text>

    <!-- LTMR recipient zone -->
    <rect x="96" y="146" width="140" height="72" rx="6" fill="#fdf6ee" stroke="#4b4b55" stroke-width="1.2" data-zone />
    <text x="118" y="186" font-size="10" font-weight="700" fill="#4b4b55">LTMR recipient zone</text>
    <text x="118" y="198" font-size="10" fill="#4b4b55">(lumbar dorsal horn)</text>
    <text x="118" y="211" font-size="10" font-weight="700" fill="#b0301c" data-blocktxt display="none">antagonists applied</text>

    <!-- direct route: Aβ-LTMR axon, x = 80 -->
    <line x1="80" y1="296" x2="80" y2="64" stroke="#0e7c86" stroke-width="3" />
    <text x="74" y="166" text-anchor="end" font-size="10" font-weight="700" fill="#0e7c86">direct</text>
    <text x="74" y="178" text-anchor="end" font-size="10" fill="#0e7c86">0.08 m</text>
    <text x="74" y="190" text-anchor="end" font-size="10" fill="#0e7c86" data-t-direct-lbl>5.0 ms</text>

    <!-- indirect route: afferent to cord, two synapses, PSDC axon -->
    <line x1="110" y1="296" x2="110" y2="160" stroke="#e57200" stroke-width="3" data-ind />
    <line x1="110" y1="160" x2="150" y2="160" stroke="#e57200" stroke-width="3" data-ind />
    <line x1="150" y1="160" x2="150" y2="64" stroke="#e57200" stroke-width="3" data-ind />
    <circle cx="110" cy="160" r="6" fill="#e57200" data-syn />
    <circle cx="150" cy="160" r="6" fill="#e57200" data-syn />
    <text x="158" y="116" font-size="10" font-weight="700" fill="#b85a00">PSDC axon</text>
    <text x="158" y="128" font-size="10" fill="#b85a00">0.04 m</text>
    <text x="158" y="140" font-size="10" fill="#b85a00" data-t-psdc-lbl></text>
    <text x="244" y="156" font-size="10" fill="#b85a00">2 synapses</text>
    <text x="244" y="168" font-size="10" fill="#b85a00" data-t-syn-lbl>1.0 ms each</text>
    <text x="118" y="278" font-size="10" fill="#b85a00">paw to cord, 0.04 m</text>
    <text x="118" y="290" font-size="10" fill="#b85a00" data-t-aff-lbl>2.5 ms</text>

    <!-- dorsal root ganglion (both cell bodies) -->
    <ellipse cx="95" cy="248" rx="29" ry="11" fill="#fff" stroke="#4b4b55" stroke-width="1.2" />
    <text x="132" y="252" font-size="10" fill="#4b4b55">dorsal root ganglion</text>

    <!-- hindpaw -->
    <rect x="50" y="296" width="150" height="26" rx="5" fill="#f3f3f6" stroke="#4b4b55" stroke-width="1.2" />
    <text x="125" y="313" text-anchor="middle" font-size="10" font-weight="700" fill="#4b4b55">Hindpaw (stimulated)</text>
  </svg>
  <p class="trl-side">Left and right are the mouse’s own. Everything below the medulla is on the stimulated paw’s side; nothing crosses in the cord. Only the second-order axon crosses, in the medulla. The direct and indirect afferents are drawn as separate lines for clarity.</p>

  <svg class="trl-svg trl-time" viewBox="0 0 360 150" role="img" aria-label="Time axis with an arrival marker for each route" data-time></svg>

  <div class="trl-controls">
    <label class="trl-slabel"><span>Afferent velocity <em data-out="va">16</em> m/s</span>
      <input type="range" data-in="va" min="8" max="24" step="1" value="16" />
    </label>
    <label class="trl-slabel"><span>PSDC axon velocity <em data-out="vp">8</em> m/s</span>
      <input type="range" data-in="vp" min="4" max="16" step="1" value="8" />
    </label>
    <label class="trl-slabel"><span>Delay per synapse <em data-out="d">1.0</em> ms</span>
      <input type="range" data-in="d" min="0" max="2" step="0.1" value="1" />
    </label>
    <label class="trl-check"><input type="checkbox" data-in="drug" /> <span>Glutamate receptor antagonists on the lumbar cord</span></label>
  </div>

  <dl class="trl-readout">
    <div><dt><i class="trl-sw trl-sw-d"></i>Direct, t = L / v</dt><dd data-r-direct></dd></div>
    <div><dt><i class="trl-sw trl-sw-a"></i>Indirect: afferent + <i class="trl-sw trl-sw-s"></i>synapses + <i class="trl-sw trl-sw-p"></i>PSDC axon</dt><dd data-r-indirect></dd></div>
    <div><dt>Indirect minus direct</dt><dd data-r-gap></dd></div>
  </dl>
  <p class="trl-why" data-why role="status"></p>

  <p class="trl-foot">In this sketch: illustrative lengths and velocities, not measurements; constant speed; conduction plus synaptic delay only; anaesthetized adult mouse logic. The rule to keep is t = L / v for each stage, then add the synaptic delays.</p>
</figure>

<script>
  const NS = 'http://www.w3.org/2000/svg';
  const TEAL = '#0e7c86', ORANGE = '#e57200', DARK = '#8a4a00', INK = '#4b4b55', FAINT = '#b9b9c2', RED = '#b0301c';
  const L_DIRECT = 0.08, L_AFF = 0.04, L_PSDC = 0.04; // metres, fixed by the lesson's worked problem
  const N_SYN = 2;

  function el(name: string, attrs: Record<string, string | number>): SVGElement {
    const e = document.createElementNS(NS, name);
    for (const k in attrs) e.setAttribute(k, String(attrs[k]));
    return e;
  }
  function txt(x: number, y: number, s: string, opts: Record<string, string | number> = {}): SVGElement {
    const t = el('text', Object.assign({ x, y, 'font-size': 10, fill: INK }, opts));
    t.textContent = s;
    return t;
  }
  // one decimal when the value is exact to 0.1, else two
  const fmt = (n: number) => (Math.abs(n * 10 - Math.round(n * 10)) < 1e-9 ? n.toFixed(1) : n.toFixed(2));

  document.querySelectorAll<HTMLElement>('[data-trl]').forEach((root) => {
    const q = <T extends Element>(s: string): T | null => root.querySelector<T>(s);
    const time = q<SVGSVGElement>('[data-time]');
    const vaIn = q<HTMLInputElement>('[data-in="va"]');
    const vpIn = q<HTMLInputElement>('[data-in="vp"]');
    const dIn = q<HTMLInputElement>('[data-in="d"]');
    const drugIn = q<HTMLInputElement>('[data-in="drug"]');
    const vaOut = q<HTMLElement>('[data-out="va"]');
    const vpOut = q<HTMLElement>('[data-out="vp"]');
    const dOut = q<HTMLElement>('[data-out="d"]');
    const rDirect = q<HTMLElement>('[data-r-direct]');
    const rInd = q<HTMLElement>('[data-r-indirect]');
    const rGap = q<HTMLElement>('[data-r-gap]');
    const why = q<HTMLElement>('[data-why]');
    const tDirectLbl = q<SVGElement>('[data-t-direct-lbl]');
    const tAffLbl = q<SVGElement>('[data-t-aff-lbl]');
    const tSynLbl = q<SVGElement>('[data-t-syn-lbl]');
    const tPsdcLbl = q<SVGElement>('[data-t-psdc-lbl]');
    const blockTxt = q<SVGElement>('[data-blocktxt]');
    const zone = q<SVGElement>('[data-zone]');
    if (!time || !vaIn || !vpIn || !dIn || !drugIn || !vaOut || !vpOut || !dOut || !rDirect || !rInd || !rGap || !why ||
        !tDirectLbl || !tAffLbl || !tSynLbl || !tPsdcLbl || !blockTxt || !zone) return;

    const X0 = 40, X1 = 340, TMAX = 20; // ms; the slowest settings give 19 ms
    const px = (ms: number) => X0 + (ms / TMAX) * (X1 - X0);
    const clampX = (x: number, half: number) => Math.max(8 + half, Math.min(352 - half, x));

    function render() {
      const va = parseFloat(vaIn!.value), vp = parseFloat(vpIn!.value), d = parseFloat(dIn!.value);
      const blocked = drugIn!.checked;
      const r2 = (x: number) => Math.round(x * 100) / 100; // displayed parts are rounded to 0.01 ms, and the gap is computed from them
      const tD = r2((L_DIRECT / va) * 1000);
      const tA = r2((L_AFF / va) * 1000);
      const tS = r2(N_SYN * d);
      const tP = r2((L_PSDC / vp) * 1000);
      const tI = tA + tS + tP;
      const gap = tI - tD;

      vaOut!.textContent = String(va);
      vpOut!.textContent = String(vp);
      dOut!.textContent = d.toFixed(1);

      // map labels
      tDirectLbl!.textContent = fmt(tD) + ' ms';
      tAffLbl!.textContent = blocked ? 'conducts to the cord' : fmt(tA) + ' ms';
      tSynLbl!.textContent = blocked ? 'blocked' : d.toFixed(1) + ' ms each';
      tPsdcLbl!.textContent = blocked ? '' : fmt(tP) + ' ms';
      tPsdcLbl!.setAttribute('display', blocked ? 'none' : 'inline');
      blockTxt!.setAttribute('display', blocked ? 'inline' : 'none');
      zone!.setAttribute('stroke', blocked ? RED : INK);
      zone!.setAttribute('stroke-dasharray', blocked ? '4 3' : '0');
      root.querySelectorAll<SVGElement>('[data-ind]').forEach((e) => {
        e.setAttribute('stroke', blocked ? FAINT : ORANGE);
        e.setAttribute('stroke-dasharray', blocked ? '5 4' : '0');
      });
      root.querySelectorAll<SVGElement>('[data-syn]').forEach((e) => e.setAttribute('fill', blocked ? '#fff' : ORANGE));
      root.querySelectorAll<SVGElement>('[data-syn]').forEach((e) => e.setAttribute('stroke', blocked ? RED : 'none'));

      // time axis
      time!.replaceChildren();
      time!.appendChild(txt(X0, 14, 'arrival at the gracile nucleus (in this sketch)', { 'font-weight': 700 }));
      const BY1 = 26, BY2 = 70, BH = 16;
      if (!blocked) time!.appendChild(el('rect', { x: px(tD), y: BY1 - 4, width: Math.max(0, px(tI) - px(tD)), height: BY2 + BH - BY1 + 8, fill: '#e57200', opacity: 0.1 }));
      // direct bar
      time!.appendChild(el('rect', { x: X0, y: BY1, width: px(tD) - X0, height: BH, fill: TEAL, opacity: 0.85 }));
      time!.appendChild(el('line', { x1: px(tD), y1: BY1 - 4, x2: px(tD), y2: BY1 + BH + 4, stroke: TEAL, 'stroke-width': 2.4 }));
      const tl1 = txt(clampX(px(tD), 55), BY1 + BH + 15, 'direct arrives ' + fmt(tD) + ' ms', { 'text-anchor': 'middle', 'font-weight': 700, fill: TEAL });
      time!.appendChild(tl1);
      // indirect bar
      if (blocked) {
        time!.appendChild(el('rect', { x: X0, y: BY2, width: X1 - X0, height: BH, fill: 'none', stroke: FAINT, 'stroke-dasharray': '4 3' }));
        time!.appendChild(txt((X0 + X1) / 2, BY2 + 12, 'no indirect arrival in this sketch', { 'text-anchor': 'middle', fill: RED }));
      } else {
        let x = X0;
        for (const [dt, c] of [[tA, '#f2a65a'], [tS, DARK], [tP, ORANGE]] as [number, string][]) {
          const w = (dt / TMAX) * (X1 - X0);
          if (w > 0) time!.appendChild(el('rect', { x, y: BY2, width: w, height: BH, fill: c }));
          x += w;
        }
        time!.appendChild(el('line', { x1: px(tI), y1: BY2 - 4, x2: px(tI), y2: BY2 + BH + 4, stroke: ORANGE, 'stroke-width': 2.4 }));
        time!.appendChild(txt(clampX(px(tI), 60), BY2 + BH + 15, 'indirect arrives ' + fmt(tI) + ' ms', { 'text-anchor': 'middle', 'font-weight': 700, fill: '#b85a00' }));
      }
      // axis
      const AY = 118;
      time!.appendChild(el('line', { x1: X0, y1: AY, x2: X1, y2: AY, stroke: INK, 'stroke-width': 1 }));
      for (const t of [0, 5, 10, 15, 20]) {
        time!.appendChild(el('line', { x1: px(t), y1: AY, x2: px(t), y2: AY + 3, stroke: INK, 'stroke-width': 1 }));
        time!.appendChild(txt(px(t), AY + 14, String(t), { 'text-anchor': 'middle' }));
      }
      time!.appendChild(txt((X0 + X1) / 2, AY + 28, 'time after the stimulus (ms)', { 'text-anchor': 'middle' }));

      // readouts, with the arithmetic and units
      rDirect!.textContent = `${L_DIRECT.toFixed(2)} m ÷ ${va} m/s = ${fmt(tD)} ms`;
      if (blocked) {
        rInd!.textContent = 'removed in this sketch';
        rGap!.textContent = 'none (one arrival)';
      } else {
        rInd!.textContent = `${L_AFF.toFixed(2)} m ÷ ${va} m/s = ${fmt(tA)} ms; ${N_SYN} × ${d.toFixed(1)} ms = ${fmt(tS)} ms; ${L_PSDC.toFixed(2)} m ÷ ${vp} m/s = ${fmt(tP)} ms; total ${fmt(tI)} ms`;
        rGap!.textContent = `${fmt(tI)} − ${fmt(tD)} = ${gap < 0 ? '−' : ''}${fmt(Math.abs(gap))} ms${gap < 0 ? ' (indirect first)' : ''}`;
      }

      if (blocked) {
        why!.textContent =
          `Glutamate receptor antagonists on the lumbar cord: in this sketch the indirect route is removed and the direct arrival stays at ${fmt(tD)} ms, because the direct axons keep conducting. ` +
          'In anaesthetized adult mice, Turecek and colleagues found sustained-indentation firing nearly abolished in most recorded units, and the blockade also raised the onset threshold, so the indirect route is not only a late add-on. ' +
          'The drug is not PSDC-specific, and both routes contribute to gentle displacement.';
      } else {
        why!.textContent =
          (gap < 0
          ? `In this sketch the direct input arrives at ${fmt(tD)} ms and the indirect copy at ${fmt(tI)} ms, so the indirect copy arrives ${fmt(-gap)} ms before the direct one with these settings; the lesson’s case has it later. The indirect copy takes: `
          : `In this sketch the direct input arrives at ${fmt(tD)} ms and the indirect copy at ${fmt(tI)} ms, a lag of ${fmt(gap)} ms: `) +
          `${fmt(tA)} ms to reach the cord, ${fmt(tS)} ms across two synapses, ${fmt(tP)} ms along the PSDC axon. ` +
          (Math.abs(gap - 4.5) < 1e-9
            ? 'These are the lesson’s illustrative numbers, and the lesson judges this gap large enough to separate the two components in a recording. '
            : 'These are illustrative numbers, not measurements. ') +
          'Turecek and colleagues did not measure latencies this way. Both routes lie on the stimulated paw’s side until the second-order axon crosses in the medulla.';
      }
    }
    [vaIn, vpIn, dIn].forEach((s) => s.addEventListener('input', render));
    drugIn.addEventListener('change', render);
    render();
  });
</script>

<style is:global>
  .trl { padding: var(--ddp-space-3) var(--ddp-space-4) var(--ddp-space-4); margin: var(--ddp-space-5) 0; }
  .trl-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem; font-weight: 600; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); margin-bottom: var(--ddp-space-3); }
  .trl-chip { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 400; color: var(--ddp-color-muted); }
  .trl-svg { display: block; width: 100%; max-width: 480px; margin: 0 auto; height: auto; background: #fff; border: 1px solid var(--ddp-color-line); border-radius: 6px; }
  .trl-time { margin-top: var(--ddp-space-2); }
  .trl-side { margin: var(--ddp-space-2) auto 0; max-width: 480px; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .trl-controls { display: grid; grid-template-columns: 1fr 1fr; gap: var(--ddp-space-2) var(--ddp-space-4); margin: var(--ddp-space-3) 0 var(--ddp-space-2); }
  .trl-slabel { display: flex; flex-direction: column; gap: 0.1rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .trl-slabel em { font-style: normal; font-weight: 700; color: var(--ddp-color-accent); font-family: var(--ddp-font-mono); }
  .trl-slabel input { accent-color: var(--ddp-color-accent); }
  .trl-check { grid-column: 1 / -1; display: flex; align-items: center; gap: 0.4rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .trl-check input { accent-color: var(--ddp-color-accent); }
  .trl-readout { display: grid; grid-template-columns: 1fr; gap: var(--ddp-space-2); margin: var(--ddp-space-2) 0; padding: var(--ddp-space-2) var(--ddp-space-3); background: color-mix(in srgb, var(--ddp-color-accent) 8%, transparent); border-radius: 6px; }
  .trl-readout div { display: flex; flex-direction: column; gap: 0.1rem; }
  .trl-readout dt { font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .trl-readout dd { margin: 0; font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); color: var(--ddp-color-primary); font-weight: 700; }
  .trl-sw { display: inline-block; width: 0.7em; height: 0.7em; margin-right: 0.25em; border-radius: 2px; vertical-align: baseline; }
  .trl-sw-d { background: #0e7c86; } .trl-sw-a { background: #f2a65a; } .trl-sw-s { background: #8a4a00; } .trl-sw-p { background: #e57200; }
  .trl-why { margin: 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); line-height: 1.5; min-height: 6em; }
  .trl-foot { margin: var(--ddp-space-3) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); border-left: 3px solid var(--ddp-color-secondary); padding-left: 0.55rem; }
  @media (max-width: 480px) { .trl-controls { grid-template-columns: 1fr; } }
</style>
