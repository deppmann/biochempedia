---
/**
 * ThresholdOverlapReader — two groups' static vibrotactile detection thresholds drawn as
 * normal curves from the published mean and SD (Puts and colleagues 2014, children aged
 * 8 to 12). The learner reads the difference, ratio and relative increase, flips the
 * denominator, moves a threshold cursor, and resamples cohorts of 67 and 32 children to see
 * how heavily the groups overlap. Original sketch; normal shapes are an assumption.
 */
---

<figure class="tor card" data-tor>
  <figcaption class="tor-head">Two threshold curves, one overlap<span class="tor-chip">⚙ original · interactive</span></figcaption>

  <svg class="tor-svg" viewBox="0 0 340 262" role="img" aria-label="Two overlapping normal curves of static vibration detection threshold in micrometres, one for typically developing children and one for autistic children, with a movable cursor and dots for drawn children" data-plot></svg>

  <div class="tor-controls">
    <label class="tor-slabel"><span>Threshold cursor <em data-out="cur">6.59</em> µm</span>
      <input type="range" data-in="cur" min="0" max="25" step="0.01" value="6.59" />
    </label>
    <div class="tor-jump">
      <button type="button" class="tor-btn" data-jump="6.59">Cursor at control mean</button>
      <button type="button" class="tor-btn" data-jump="9.13">Cursor at autistic mean</button>
    </div>
    <fieldset class="tor-fs">
      <legend>Denominator for the percentage</legend>
      <label><input type="radio" name="tor-den" value="ctrl" checked /> control mean (6.59 µm)</label>
      <label><input type="radio" name="tor-den" value="aut" /> autistic mean (9.13 µm)</label>
    </fieldset>
    <button type="button" class="tor-btn tor-resample" data-resample>Resample 67 + 32 simulated children</button>
  </div>

  <dl class="tor-readout">
    <div><dt>Difference</dt><dd>2.54 µm</dd></div>
    <div><dt>Ratio</dt><dd>1.385</dd></div>
    <div><dt data-pct-label>Relative increase</dt><dd data-pct>38.5%</dd></div>
  </dl>
  <p class="tor-pctnote" data-pctnote></p>

  <table class="tor-table">
    <thead>
      <tr><th scope="col"></th><th scope="col">Expected (means: before clipping at 0)</th><th scope="col">Drawn</th></tr>
    </thead>
    <tbody>
      <tr><th scope="row" data-r-cshare-l>Controls at or below cursor</th><td data-r-cshare-e></td><td data-r-cshare-o></td></tr>
      <tr><th scope="row" data-r-ashare-l>Autistic at or below cursor</th><td data-r-ashare-e></td><td data-r-ashare-o></td></tr>
      <tr><th scope="row">Control sample mean</th><td data-r-cmean-e></td><td data-r-cmean-o></td></tr>
      <tr><th scope="row">Autistic sample mean</th><td data-r-amean-e></td><td data-r-amean-o></td></tr>
      <tr><th scope="row" data-r-diff-l>Difference of sample means</th><td data-r-diff-e></td><td data-r-diff-o></td></tr>
    </tbody>
  </table>

  <p class="tor-why" data-why role="status"></p>

  <p class="tor-foot">In this sketch: normal shapes drawn from the mean and SD in Puts and colleagues 2014 (an assumption), clipped at 0 µm because a threshold cannot be negative, and children drawn independently; the paper’s individual data are not shown. Rule to keep: a group mean difference is not a statement about one child.</p>
</figure>

<script>
  const NS = 'http://www.w3.org/2000/svg';
  const TEAL = '#0e7c86', ORANGE = '#e57200', INK = '#4b4b55', FAINT = '#b9b9c2';
  const MC = 6.59, SC = 2.81, NC = 67, MA = 9.13, SA = 4.81, NA = 32; // Puts and colleagues 2014, Table 1 as given in the lesson
  const XMAX = 25;

  function el(name: string, attrs: Record<string, string | number>): SVGElement {
    const e = document.createElementNS(NS, name);
    for (const k in attrs) e.setAttribute(k, String(attrs[k]));
    return e;
  }
  function erf(x: number): number {
    const s = x < 0 ? -1 : 1; x = Math.abs(x);
    const t = 1 / (1 + 0.3275911 * x);
    const y = 1 - (((((1.061405429 * t - 1.453152027) * t) + 1.421413741) * t - 0.284496736) * t + 0.254829592) * t * Math.exp(-x * x);
    return s * y;
  }
  const cdf = (x: number, m: number, s: number) => 0.5 * (1 + erf((x - m) / (s * Math.SQRT2)));
  const pdf = (x: number, m: number, s: number) => Math.exp(-0.5 * ((x - m) / s) ** 2) / (s * Math.sqrt(2 * Math.PI));
  function mulberry(seed: number) {
    let a = seed >>> 0;
    return () => {
      a = (a + 0x6d2b79f5) >>> 0;
      let t = a;
      t = Math.imul(t ^ (t >>> 15), t | 1);
      t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }
  type Dot = { v: number; j: number };
  function draw(n: number, m: number, s: number, rnd: () => number): Dot[] {
    const out: Dot[] = [];
    for (let i = 0; i < n; i++) {
      const u1 = Math.max(rnd(), 1e-12), u2 = rnd();
      const z = Math.sqrt(-2 * Math.log(u1)) * Math.cos(2 * Math.PI * u2);
      out.push({ v: Math.max(0, m + s * z), j: rnd() });
    }
    return out;
  }
  const pct = (x: number) => (x * 100).toFixed(1) + '%';
  const um = (x: number) => x.toFixed(2) + ' µm';

  document.querySelectorAll<HTMLElement>('[data-tor]').forEach((root) => {
    const plot = root.querySelector<SVGSVGElement>('[data-plot]');
    const curIn = root.querySelector<HTMLInputElement>('[data-in="cur"]');
    const curOut = root.querySelector<HTMLElement>('[data-out="cur"]');
    const why = root.querySelector<HTMLElement>('[data-why]');
    const resample = root.querySelector<HTMLButtonElement>('[data-resample]');
    const pctEl = root.querySelector<HTMLElement>('[data-pct]');
    const pctLabel = root.querySelector<HTMLElement>('[data-pct-label]');
    const pctNote = root.querySelector<HTMLElement>('[data-pctnote]');
    const radios = root.querySelectorAll<HTMLInputElement>('input[name="tor-den"]');
    const jumps = root.querySelectorAll<HTMLButtonElement>('[data-jump]');
    const cell = (k: string) => root.querySelector<HTMLElement>('[data-r-' + k + ']');
    const cells = {
      cl: cell('cshare-l'), ce: cell('cshare-e'), co: cell('cshare-o'),
      al: cell('ashare-l'), ae: cell('ashare-e'), ao: cell('ashare-o'),
      cme: cell('cmean-e'), cmo: cell('cmean-o'), ame: cell('amean-e'), amo: cell('amean-o'),
      dl: cell('diff-l'), de: cell('diff-e'), dobs: cell('diff-o'),
    };
    if (!plot || !curIn || !curOut || !why || !resample || !pctEl || !pctLabel || !pctNote) return;
    for (const k of Object.keys(cells) as (keyof typeof cells)[]) if (!cells[k]) return;
    const C = cells as Record<keyof typeof cells, HTMLElement>;

    const X0 = 36, X1 = 328, Y0 = 20, YB = 140;
    const px = (v: number) => X0 + (Math.min(v, XMAX) / XMAX) * (X1 - X0);
    const PK = pdf(MC, MC, SC); // tallest peak (controls)
    const py = (d: number) => YB - (d / PK) * (YB - Y0 - 6);

    let cohortC: Dot[] = [], cohortA: Dot[] = [];
    function resampleNow(seed: number) {
      const r = mulberry(seed);
      cohortC = draw(NC, MC, SC, r);
      cohortA = draw(NA, MA, SA, r);
    }
    resampleNow(20140);

    function pathFor(m: number, s: number, upTo: number): string {
      let d = 'M' + px(0).toFixed(1) + ' ' + YB;
      const end = Math.min(upTo, XMAX);
      for (let x = 0; x <= end + 1e-9; x += 0.25) d += ' L' + px(x).toFixed(1) + ' ' + py(pdf(x, m, s)).toFixed(1);
      if (end % 0.25 > 1e-9) d += ' L' + px(end).toFixed(1) + ' ' + py(pdf(end, m, s)).toFixed(1);
      return d;
    }
    function text(x: number, y: number, str: string, o: Record<string, string | number> = {}) {
      const t = el('text', Object.assign({ x, y, 'font-size': 9, fill: INK }, o));
      t.textContent = str;
      plot!.appendChild(t);
    }

    function render() {
      const cur = parseFloat(curIn!.value);
      const den = Array.from(radios).find((r) => r.checked)?.value === 'aut' ? 'aut' : 'ctrl';
      curOut!.textContent = cur.toFixed(2);

      const diff = MA - MC;
      const pctVal = den === 'ctrl' ? diff / MC : diff / MA;
      pctEl!.textContent = (pctVal * 100).toFixed(1) + '%';
      pctLabel!.textContent = den === 'ctrl' ? 'Relative increase (of control mean)' : 'Share of the autistic mean';
      pctNote!.textContent = den === 'ctrl'
        ? '2.54 ÷ 6.59 = 0.385: the autistic cohort’s mean threshold was about 38.5% larger than the control mean.'
        : '2.54 ÷ 9.13 = 0.278 is the difference as a share of the autistic mean, not the increase; a different denominator gives a different percentage (27.8% against 38.5%).';

      // expected shares (clipping at 0 does not change the share at or below a cursor of 0 or more)
      const eC = cdf(cur, MC, SC), eA = cdf(cur, MA, SA);
      const oC = cohortC.filter((d) => d.v <= cur).length, oA = cohortA.filter((d) => d.v <= cur).length;
      C.cl.textContent = 'Controls at or below cursor (n = ' + NC + ')';
      C.al.textContent = 'Autistic at or below cursor (n = ' + NA + ')';
      C.ce.textContent = pct(eC);
      C.ae.textContent = pct(eA);
      C.co.textContent = pct(oC / NC) + ' (' + oC + '/' + NC + ')';
      C.ao.textContent = pct(oA / NA) + ' (' + oA + '/' + NA + ')';

      const mC = cohortC.reduce((s, d) => s + d.v, 0) / NC;
      const mA = cohortA.reduce((s, d) => s + d.v, 0) / NA;
      C.cme.textContent = um(MC);
      C.ame.textContent = um(MA);
      C.cmo.textContent = um(mC);
      C.amo.textContent = um(mA);
      const dObs = den === 'ctrl' ? (mA - mC) / mC : (mA - mC) / mA;
      C.dl.textContent = den === 'ctrl' ? 'Difference as % of control mean' : 'Difference as % of autistic mean';
      C.de.textContent = pct(pctVal);
      C.dobs.textContent = pct(dObs);

      // plot
      plot!.replaceChildren();
      plot!.appendChild(el('line', { x1: X0, y1: YB, x2: X1, y2: YB, stroke: INK, 'stroke-width': 1 }));
      plot!.appendChild(el('line', { x1: X0, y1: Y0, x2: X0, y2: YB, stroke: INK, 'stroke-width': 1 }));
      for (let v = 0; v <= XMAX; v += 5) {
        plot!.appendChild(el('line', { x1: px(v), y1: YB, x2: px(v), y2: YB + 3, stroke: INK, 'stroke-width': 1 }));
        text(px(v), YB + 13, String(v), { 'text-anchor': 'middle' });
      }
      text((X0 + X1) / 2, YB + 25, 'static detection threshold (µm); higher = poorer detection', { 'text-anchor': 'middle' });
      text(X0 + 3, 10, 'probability density (relative)', {});
      // shaded areas below cursor
      plot!.appendChild(el('path', { d: pathFor(MC, SC, cur) + ' L' + px(cur).toFixed(1) + ' ' + YB + ' Z', fill: TEAL, 'fill-opacity': 0.22, stroke: 'none' }));
      plot!.appendChild(el('path', { d: pathFor(MA, SA, cur) + ' L' + px(cur).toFixed(1) + ' ' + YB + ' Z', fill: ORANGE, 'fill-opacity': 0.22, stroke: 'none' }));
      // curves
      const open = (m: number, s: number) => pathFor(m, s, XMAX).replace(/^M[\d.]+ [\d.]+ /, 'M' + px(0).toFixed(1) + ' ' + py(pdf(0, m, s)).toFixed(1) + ' ');
      plot!.appendChild(el('path', { d: open(MC, SC), fill: 'none', stroke: TEAL, 'stroke-width': 2.4 }));
      plot!.appendChild(el('path', { d: open(MA, SA), fill: 'none', stroke: ORANGE, 'stroke-width': 2.4 }));
      // mean ticks
      plot!.appendChild(el('line', { x1: px(MC), y1: py(PK), x2: px(MC), y2: YB, stroke: TEAL, 'stroke-width': 1, 'stroke-dasharray': '2 3' }));
      plot!.appendChild(el('line', { x1: px(MA), y1: py(pdf(MA, MA, SA)), x2: px(MA), y2: YB, stroke: ORANGE, 'stroke-width': 1, 'stroke-dasharray': '2 3' }));
      // cursor
      plot!.appendChild(el('line', { x1: px(cur), y1: Y0 - 4, x2: px(cur), y2: YB + 100, stroke: INK, 'stroke-width': 1.4 }));
      plot!.appendChild(el('polygon', { points: `${px(cur) - 4},${Y0 - 6} ${px(cur) + 4},${Y0 - 6} ${px(cur)},${Y0}`, fill: INK }));
      // legend
      const LX = 160, LY = 34;
      plot!.appendChild(el('rect', { x: LX - 4, y: LY - 10, width: 176, height: 38, fill: '#fff', 'fill-opacity': 0.92, stroke: FAINT, 'stroke-width': 0.5 }));
      plot!.appendChild(el('line', { x1: LX, y1: LY, x2: LX + 16, y2: LY, stroke: TEAL, 'stroke-width': 2.4 }));
      text(LX + 20, LY + 3, 'typically developing 6.59 ± 2.81');
      plot!.appendChild(el('line', { x1: LX, y1: LY + 14, x2: LX + 16, y2: LY + 14, stroke: ORANGE, 'stroke-width': 2.4 }));
      text(LX + 20, LY + 17, 'autistic 9.13 ± 4.81');
      // dot strips
      const strip = (dots: Dot[], y0: number, colour: string, label: string) => {
        plot!.appendChild(el('line', { x1: X0, y1: y0 + 20, x2: X1, y2: y0 + 20, stroke: FAINT, 'stroke-width': 0.6 }));
        for (const d of dots) {
          plot!.appendChild(el('circle', { cx: px(d.v), cy: y0 + 3 + d.j * 14, r: 2.3, fill: colour, 'fill-opacity': d.v <= cur ? 0.95 : 0.4, stroke: colour, 'stroke-width': 0.6 }));
        }
        text(X1, y0 + 31, label, { 'text-anchor': 'end', fill: colour, 'font-weight': 700 });
      };
      strip(cohortC, YB + 38, TEAL, 'simulated controls (n = 67)');
      strip(cohortA, YB + 38 + 40, ORANGE, 'simulated autistic children (n = 32)');

      // status
      why!.textContent =
        'At ' + cur.toFixed(2) + ' µm, in this sketch about ' + pct(eC) + ' of control children and ' + pct(eA) +
        ' of autistic children have a threshold at or below it (drawn: ' + oC + ' of ' + NC + ' and ' + oA + ' of ' + NA + '). ' +
        'A higher threshold is poorer detection in this task. The curves overlap heavily, so a group mean predicts nothing about one child. ' +
        'The mouse air-puff measure is reactivity at one stimulus level, a different quantity, and is not modelled here.';
    }

    curIn.addEventListener('input', render);
    radios.forEach((r) => r.addEventListener('change', render));
    jumps.forEach((b) => b.addEventListener('click', () => {
      curIn.value = b.dataset.jump ?? '6.59';
      render();
    }));
    resample.addEventListener('click', () => {
      resampleNow(Math.floor(Math.random() * 4294967295));
      render();
    });
    render();
  });
</script>

<style>
  .tor { padding: var(--ddp-space-3) var(--ddp-space-4) var(--ddp-space-4); margin: var(--ddp-space-5) 0; }
  .tor-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem; font-weight: 600; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); margin-bottom: var(--ddp-space-3); }
  .tor-chip { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 400; color: var(--ddp-color-muted); }
  .tor-svg { display: block; width: 100%; max-width: 560px; margin: 0 auto; height: auto; background: #fff; border: 1px solid var(--ddp-color-line); border-radius: 6px; }
  .tor-controls { display: flex; flex-direction: column; gap: var(--ddp-space-2); margin: var(--ddp-space-3) 0 var(--ddp-space-2); }
  .tor-slabel { display: flex; flex-direction: column; gap: 0.1rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .tor-slabel em { font-style: normal; font-weight: 700; color: var(--ddp-color-accent); font-family: var(--ddp-font-mono); }
  .tor-slabel input { accent-color: var(--ddp-color-accent); width: 100%; }
  .tor-jump { display: flex; flex-wrap: wrap; gap: var(--ddp-space-2); }
  .tor-btn { font: inherit; font-size: var(--ddp-text-xs); padding: 0.3rem 0.6rem; border: 1px solid var(--ddp-color-line); border-radius: 6px; background: #fff; color: var(--ddp-color-ink-soft); cursor: pointer; }
  .tor-btn:hover { border-color: var(--ddp-color-accent); }
  .tor-btn:focus-visible { outline: 2px solid var(--ddp-color-accent); outline-offset: 2px; }
  .tor-resample { align-self: flex-start; color: var(--ddp-color-primary); font-weight: 600; }
  .tor-fs { border: 1px solid var(--ddp-color-line); border-radius: 6px; padding: 0.3rem 0.6rem 0.4rem; margin: 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); display: flex; flex-wrap: wrap; gap: 0.2rem 1rem; }
  .tor-fs legend { padding: 0 0.3rem; color: var(--ddp-color-muted); }
  .tor-fs label { display: inline-flex; align-items: center; gap: 0.35rem; }
  .tor-fs input { accent-color: var(--ddp-color-accent); }
  .tor-readout { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--ddp-space-2); margin: var(--ddp-space-2) 0 0; padding: var(--ddp-space-2) var(--ddp-space-3); background: color-mix(in srgb, var(--ddp-color-accent) 8%, transparent); border-radius: 6px; }
  .tor-readout div { display: flex; flex-direction: column; gap: 0.1rem; }
  .tor-readout dt { font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .tor-readout dd { margin: 0; font-family: var(--ddp-font-mono); font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); font-weight: 700; }
  .tor-pctnote { margin: var(--ddp-space-2) 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); line-height: 1.5; }
  .tor-table { width: 100%; border-collapse: collapse; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); margin: var(--ddp-space-2) 0; }
  .tor-table th, .tor-table td { text-align: left; padding: 0.25rem 0.4rem; border-bottom: 1px solid var(--ddp-color-line); vertical-align: top; }
  .tor-table thead th { color: var(--ddp-color-muted); font-weight: 600; }
  .tor-table tbody th { font-weight: 400; }
  .tor-table td { font-family: var(--ddp-font-mono); color: var(--ddp-color-primary); }
  .tor-why { margin: var(--ddp-space-2) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); line-height: 1.5; min-height: 6em; }
  .tor-foot { margin: var(--ddp-space-3) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); border-left: 3px solid var(--ddp-color-secondary); padding-left: 0.55rem; }
</style>
