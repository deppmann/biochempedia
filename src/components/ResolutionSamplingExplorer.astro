---
/**
 * ResolutionSamplingExplorer — two point sources imaged by an ideal widefield microscope,
 * built on the worked problem of the microscopy-and-images lesson (λ 520 nm, NA 1.40,
 * 100 nm pixels, d = 0.61λ/NA = 226.6 nm). The learner sets wavelength, NA, pixel size and
 * the separation of the two points, and reads off d, pixels per d, whether the pair is
 * resolved by the lesson's rule (separation at least d) and whether the camera meets the
 * lesson's two-pixel rule (at least two pixels per d). The blur curves are Airy patterns
 * scaled so that the first dark ring sits at d; they are drawn in this sketch, in relative
 * intensity units. Nothing here is a measurement. Self-contained vanilla-TS Astro island.
 * Original.
 */
---

<figure class="rs card" data-resolution>
  <figcaption class="rs-head">Resolution and sampling: two points through a microscope<span class="rs-chip">⚙ original · interactive</span></figcaption>

  <svg class="rs-svg" viewBox="0 0 360 302" role="img" aria-label="Top: the summed blur of two point sources along the line joining them. Bottom: the same profile as recorded by camera pixels" data-plot></svg>

  <ul class="rs-legend" aria-label="Key to the plot">
    <li><span class="rs-sw rs-sw-sum"></span>sum of the two blurs</li>
    <li><span class="rs-sw rs-sw-one"></span>each point’s own blur</li>
    <li><span class="rs-sw rs-sw-pt"></span>true position of each point</li>
    <li><span class="rs-sw rs-sw-px"></span>camera pixels</li>
  </ul>

  <div class="rs-controls">
    <label class="rs-slabel"><span>Emission wavelength λ <em data-out="lam">520</em> nm</span>
      <input type="range" data-in="lam" min="450" max="650" step="10" value="520" />
    </label>
    <label class="rs-slabel"><span>Numerical aperture NA <em data-out="na">1.40</em></span>
      <input type="range" data-in="na" min="0.70" max="1.40" step="0.05" value="1.4" />
    </label>
    <label class="rs-slabel"><span>Camera pixel (specimen units) <em data-out="px">100</em> nm</span>
      <input type="range" data-in="px" min="20" max="300" step="10" value="100" />
    </label>
    <label class="rs-slabel"><span>True separation of the two points <em data-out="sep">150</em> nm</span>
      <input type="range" data-in="sep" min="50" max="400" step="10" value="150" />
    </label>
  </div>

  <div class="rs-presets" role="group" aria-label="Cases from the lesson">
    <span class="rs-plabel">Presets (the 250 nm separation is chosen here, not from the lesson)</span>
    <button type="button" class="rs-btn" data-preset="vesicles">Vesicles 150 nm apart</button>
    <button type="button" class="rs-btn" data-preset="px150">150 nm pixels</button>
    <button type="button" class="rs-btn" data-preset="na1">NA 1.00</button>
  </div>

  <dl class="rs-readout">
    <div><dt>d (lateral) = 0.61 λ / NA</dt><dd data-r-d></dd></div>
    <div><dt>Pixels per d</dt><dd data-r-ppd></dd></div>
    <div><dt>Separation ÷ d</dt><dd data-r-ratio></dd></div>
    <div><dt>Resolved? (separation ≥ d)</dt><dd data-r-res></dd></div>
    <div><dt>Sampled? (≥ 2 pixels per d)</dt><dd data-r-smp></dd></div>
  </dl>
  <p class="rs-why" data-why role="status"></p>

  <p class="rs-foot">Keep the rule: for an ideal widefield microscope, by the Rayleigh convention two points closer than the lateral d = 0.61λ/NA count as unresolved, and a common introductory rule asks for at least two camera pixels per d; enlarging the picture afterwards adds neither. The pixel grid is centred on the midpoint of the pair. The blur curves are Airy patterns drawn in this sketch in relative units, with the first dark ring at d. These are ideal-model numbers; a real instrument or a thick sample does worse.</p>
</figure>

<script>
  const NS = 'http://www.w3.org/2000/svg';
  const ACCENT = '#0e7c86', ORANGE = '#e57200', INK = '#4b4b55', FAINT = '#b9b9c2', PXFILL = '#bfe3e6';
  function el(name: string, attrs: Record<string, string | number>): SVGElement {
    const e = document.createElementNS(NS, name);
    for (const k in attrs) e.setAttribute(k, String(attrs[k]));
    return e;
  }
  // Bessel J1 by its integral form, J1(x) = (1/π)∫0^π cos(t − x sin t) dt (midpoint rule).
  function j1(x: number): number {
    const N = 96;
    let s = 0;
    for (let i = 0; i < N; i++) {
      const t = ((i + 0.5) * Math.PI) / N;
      s += Math.cos(t - x * Math.sin(t));
    }
    return s / N;
  }
  // Airy intensity, peak 1; first zero at x = 3.8317, which we place at r = d.
  const FIRST_ZERO = 3.8317;
  function airy(r: number, d: number): number {
    const x = (Math.abs(r) / d) * FIRST_ZERO;
    if (x < 1e-6) return 1;
    const a = (2 * j1(x)) / x;
    return a * a;
  }

  document.querySelectorAll<HTMLElement>('[data-resolution]').forEach((root) => {
    const plot = root.querySelector<SVGSVGElement>('[data-plot]')!;
    const inp = (k: string) => root.querySelector<HTMLInputElement>(`[data-in="${k}"]`)!;
    const out = (k: string) => root.querySelector<HTMLElement>(`[data-out="${k}"]`)!;
    const lamIn = inp('lam'), naIn = inp('na'), pxIn = inp('px'), sepIn = inp('sep');
    const lamOut = out('lam'), naOut = out('na'), pxOut = out('px'), sepOut = out('sep');
    const rD = root.querySelector<HTMLElement>('[data-r-d]')!;
    const rPpd = root.querySelector<HTMLElement>('[data-r-ppd]')!;
    const rRatio = root.querySelector<HTMLElement>('[data-r-ratio]')!;
    const rRes = root.querySelector<HTMLElement>('[data-r-res]')!;
    const rSmp = root.querySelector<HTMLElement>('[data-r-smp]')!;
    const why = root.querySelector<HTMLElement>('[data-why]')!;

    const X0 = 44, X1 = 350;
    const TOP0 = 30, TOP1 = 118; // top panel y range (value 0 at TOP1)
    const BOT0 = 176, BOT1 = 264; // bottom panel y range
    const YMAX = 2.1; // relative intensity at panel top

    function render() {
      const lam = parseInt(lamIn.value, 10);
      const na = parseFloat(naIn.value);
      const pix = parseInt(pxIn.value, 10);
      const sep = parseInt(sepIn.value, 10);
      lamOut.textContent = String(lam);
      naOut.textContent = na.toFixed(2);
      pxOut.textContent = String(pix);
      sepOut.textContent = String(sep);

      const d = (0.61 * lam) / na;
      const ppd = d / pix;
      const ratio = sep / d;
      const resolved = Math.round(sep * 10) / 10 >= Math.round(d * 10) / 10;
      const sampled = Math.round(ppd * 100) / 100 >= 2;

      // horizontal range, a multiple of 100 nm, wide enough for both blurs
      const W = Math.min(1500, Math.ceil((sep / 2 + 2 * d) / 100) * 100);
      const px = (x: number) => X0 + ((x + W) / (2 * W)) * (X1 - X0);
      const A = -sep / 2, B = sep / 2;
      const sum = (x: number) => airy(x - A, d) + airy(x - B, d);
      const ty = (v: number) => TOP1 - (v / YMAX) * (TOP1 - TOP0);
      const by = (v: number) => BOT1 - (v / YMAX) * (BOT1 - BOT0);

      plot.replaceChildren();
      const text = (x: number, y: number, s: string, anchor: string, size = 9, weight = 400, fill = INK) => {
        const t = el('text', { x, y, 'text-anchor': anchor, 'font-size': size, 'font-weight': weight, fill });
        t.textContent = s;
        plot.appendChild(t);
      };

      // panel titles
      text(X0, 14, 'What the optics make: summed blur', 'start', 10, 700);
      text(X0, 162, 'What the camera records: one value per pixel', 'start', 10, 700);

      for (const [y0, y1, yf] of [[TOP0, TOP1, ty], [BOT0, BOT1, by]] as [number, number, (v: number) => number][]) {
        plot.appendChild(el('line', { x1: X0, y1: y0, x2: X0, y2: y1, stroke: INK, 'stroke-width': 1 }));
        plot.appendChild(el('line', { x1: X0, y1: y1, x2: X1, y2: y1, stroke: INK, 'stroke-width': 1 }));
        for (const v of [1, 2]) {
          plot.appendChild(el('line', { x1: X0, y1: yf(v), x2: X1, y2: yf(v), stroke: FAINT, 'stroke-width': 0.6, 'stroke-dasharray': '2 3' }));
          text(X0 - 4, yf(v) + 3, String(v), 'end');
        }
        text(X0 - 4, y1 - 1, '0', 'end');
      }
      for (const [y0, y1] of [[TOP0, TOP1], [BOT0, BOT1]]) {
        const cy = (y0 + y1) / 2;
        text(10, cy, 'relative units', 'middle', 9);
        plot.lastElementChild!.setAttribute('transform', `rotate(-90 10 ${cy})`);
      }
      // x ticks on the bottom axis
      const step = W > 1000 ? 400 : W > 600 ? 200 : 100;
      for (let x = -W; x <= W; x += step) {
        plot.appendChild(el('line', { x1: px(x), y1: BOT1, x2: px(x), y2: BOT1 + 3, stroke: INK, 'stroke-width': 1 }));
        text(Math.min(px(x), X1 - 8), BOT1 + 13, String(x), 'middle');
      }
      text((X0 + X1) / 2, BOT1 + 27, 'position along the line joining the points (nm)', 'middle', 10);

      // pixel bars (bottom panel): grid centred on the midpoint, average of the sum over each pixel
      const nHalf = Math.ceil(W / pix);
      const SUB = 9;
      for (let i = -nHalf; i <= nHalf; i++) {
        const c = i * pix;
        let acc = 0;
        for (let k = 0; k < SUB; k++) acc += sum(c - pix / 2 + ((k + 0.5) / SUB) * pix);
        const v = acc / SUB;
        const xl = Math.max(-W, c - pix / 2), xr = Math.min(W, c + pix / 2);
        if (xr <= xl) continue;
        const yTop = Math.max(BOT0 - 2, by(v));
        plot.appendChild(el('rect', { x: px(xl), y: yTop, width: Math.max(0.5, px(xr) - px(xl)), height: BOT1 - yTop, fill: PXFILL, stroke: ACCENT, 'stroke-width': 0.8 }));
      }

      // true positions
      for (const p of [A, B]) {
        for (const [y0, y1] of [[TOP0, TOP1], [BOT0, BOT1]]) {
          plot.appendChild(el('line', { x1: px(p), y1: y0, x2: px(p), y2: y1, stroke: ORANGE, 'stroke-width': 1.2, 'stroke-dasharray': '3 2' }));
        }
      }

      // continuous curves (top panel)
      let dSum = '', dA = '', dB = '';
      const NPT = 240;
      for (let i = 0; i <= NPT; i++) {
        const x = -W + (2 * W * i) / NPT;
        const c = i === 0 ? 'M' : 'L';
        dSum += `${c}${px(x).toFixed(1)} ${ty(sum(x)).toFixed(1)} `;
        dA += `${c}${px(x).toFixed(1)} ${ty(airy(x - A, d)).toFixed(1)} `;
        dB += `${c}${px(x).toFixed(1)} ${ty(airy(x - B, d)).toFixed(1)} `;
      }
      for (const dd of [dA, dB]) plot.appendChild(el('path', { d: dd, fill: 'none', stroke: FAINT, 'stroke-width': 1.3, 'stroke-dasharray': '4 3' }));
      plot.appendChild(el('path', { d: dSum, fill: 'none', stroke: ACCENT, 'stroke-width': 2.4 }));

      // readouts
      rD.textContent = d.toFixed(1) + ' nm';
      rPpd.textContent = ppd.toFixed(2);
      rRatio.textContent = !resolved && ratio > 0.995 ? '<1.00' : ratio.toFixed(3);
      rRes.textContent = resolved ? '✓ resolved' : '✗ not resolved';
      rSmp.textContent = sampled ? '✓ at least 2' : '✗ fewer than 2';
      rRes.classList.toggle('rs-bad', !resolved);
      rSmp.classList.toggle('rs-bad', !sampled);

      // status line
      const pxTxt = `${pix} nm pixels give ${ppd.toFixed(2)} pixels per d`;
      let s = `With λ = ${lam} nm and NA ${na.toFixed(2)}, d = 0.61 × ${lam} / ${na.toFixed(2)} = ${d.toFixed(1)} nm. `;
      if (!resolved) {
        s += `The points are ${sep} nm apart, closer than d, so by the Rayleigh criterion they are not resolved: the blurs overlap too much to count as two. `;
      } else {
        s += `The points are ${sep} nm apart, at least d, so by the Rayleigh criterion they count as resolved. `;
      }
      if (!sampled) {
        s += `${pxTxt}, fewer than the two the rule asks for, so the camera, not the optics, would limit what you see.`;
      } else {
        s += `${pxTxt}, which meets the two-pixel rule.`;
      }
      if (!resolved && sampled) s += ' Enlarging the picture afterwards would add no information.';
      if (na > 1.0) s += ' (An NA above 1.00 needs an immersion medium such as oil, n ≈ 1.515.)';
      why.textContent = s;
    }

    const setAll = (lam: number, na: number, pix: number, sep: number) => {
      lamIn.value = String(lam);
      naIn.value = na.toFixed(2);
      pxIn.value = String(pix);
      sepIn.value = String(sep);
      render();
    };
    root.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach((b) => {
      b.addEventListener('click', () => {
        const k = b.dataset.preset;
        if (k === 'vesicles') setAll(520, 1.4, 100, 150);
        else if (k === 'px150') setAll(520, 1.4, 150, 250);
        else if (k === 'na1') setAll(520, 1.0, 100, 250);
      });
    });
    [lamIn, naIn, pxIn, sepIn].forEach((s) => s.addEventListener('input', render));
    render();
  });
</script>

<style>
  .rs { padding: var(--ddp-space-3) var(--ddp-space-4) var(--ddp-space-4); margin: var(--ddp-space-5) 0; }
  .rs-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem; font-weight: 600; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); margin-bottom: var(--ddp-space-3); }
  .rs-chip { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 400; color: var(--ddp-color-muted); }
  .rs-svg { display: block; width: 100%; max-width: 560px; margin: 0 auto; height: auto; background: #fff; border: 1px solid var(--ddp-color-line); border-radius: 6px; }
  .rs-legend { display: flex; flex-wrap: wrap; gap: 0.2rem 1rem; list-style: none; margin: var(--ddp-space-2) 0 0; padding: 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .rs-legend li { display: inline-flex; align-items: center; gap: 0.35rem; }
  .rs-sw { display: inline-block; width: 18px; height: 0; border-top: 3px solid #0e7c86; }
  .rs-sw-one { border-top: 2px dashed #b9b9c2; }
  .rs-sw-pt { border-top: 2px dashed #e57200; }
  .rs-sw-px { height: 10px; border: 1px solid #0e7c86; background: #bfe3e6; }
  .rs-controls { display: grid; grid-template-columns: 1fr 1fr; gap: var(--ddp-space-2) var(--ddp-space-4); margin: var(--ddp-space-3) 0 var(--ddp-space-2); }
  .rs-slabel { display: flex; flex-direction: column; gap: 0.1rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .rs-slabel em { font-style: normal; font-weight: 700; color: var(--ddp-color-accent); font-family: var(--ddp-font-mono); }
  .rs-slabel input { accent-color: var(--ddp-color-accent); }
  .rs-presets { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem; margin: var(--ddp-space-2) 0; }
  .rs-plabel { font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .rs-btn { font: inherit; font-size: var(--ddp-text-xs); padding: 0.25rem 0.6rem; border: 1px solid var(--ddp-color-line); border-radius: 999px; background: #fff; color: var(--ddp-color-ink-soft); cursor: pointer; }
  .rs-btn:hover, .rs-btn:focus-visible { border-color: var(--ddp-color-accent); color: var(--ddp-color-accent); }
  .rs-readout { display: grid; grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr)); gap: var(--ddp-space-2); margin: var(--ddp-space-2) 0; padding: var(--ddp-space-2) var(--ddp-space-3); background: color-mix(in srgb, var(--ddp-color-accent) 8%, transparent); border-radius: 6px; }
  .rs-readout div { display: flex; flex-direction: column; gap: 0.1rem; }
  .rs-readout dt { font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .rs-readout dd { margin: 0; font-family: var(--ddp-font-mono); font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); font-weight: 700; }
  .rs-readout dd.rs-bad { color: #b3261e; }
  .rs-why { margin: 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); line-height: 1.5; min-height: 6em; }
  .rs-foot { margin: var(--ddp-space-3) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); border-left: 3px solid var(--ddp-color-secondary); padding-left: 0.55rem; }
  @media (max-width: 480px) { .rs-controls { grid-template-columns: 1fr; } }
</style>
