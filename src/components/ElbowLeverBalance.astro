---
/**
 * ElbowLeverBalance — Muscle, Bone and Movement companion. The lesson's worked problem as a
 * lever: an idealized weightless forearm held horizontal, the elbow as pivot, the biceps pulling
 * straight up, a load in the hand. Torque balance, muscle force x muscle moment arm = load x load
 * arm, gives the muscle force; the same ratio gives how far and how fast the hand moves per unit
 * of muscle shortening (small angle). Every number follows from the lesson's equation. Original.
 */
const uid = Math.random().toString(36).slice(2, 8);
---

<figure class="elb card" data-elb>
  <figcaption class="elb-head">Elbow lever: force traded for distance and speed<span class="elb-chip">⚙ original · interactive</span></figcaption>

  <svg class="elb-svg" viewBox="0 0 360 260" role="img" aria-label="Schematic of a horizontal forearm drawn as a bar pivoting at the elbow, with the biceps as an upward arrow near the pivot and the load as a downward arrow at the hand" data-svg></svg>

  <div class="elb-controls">
    <fieldset class="elb-fs">
      <legend>View</legend>
      <label><input type="radio" name={`elb-v-${uid}`} value="force" checked /> forces and torques</label>
      <label><input type="radio" name={`elb-v-${uid}`} value="move" /> small movement</label>
    </fieldset>
    <label class="elb-slabel"><span>Load in the hand <em data-out="load">20 N</em></span>
      <input type="range" data-in="load" min="5" max="50" step="1" value="20" />
    </label>
    <label class="elb-slabel"><span>Load arm (elbow to hand) <em data-out="la">0.30 m</em></span>
      <input type="range" data-in="la" min="0.10" max="0.40" step="0.01" value="0.30" />
    </label>
    <label class="elb-slabel"><span>Biceps moment arm <em data-out="ma">0.040 m</em></span>
      <input type="range" data-in="ma" min="0.020" max="0.080" step="0.001" value="0.040" />
    </label>
  </div>

  <dl class="elb-readout">
    <div><dt data-k="t-dt">Load torque</dt><dd data-r="t"></dd></div>
    <div><dt>Muscle force</dt><dd data-r="f"></dd></div>
    <div><dt>Muscle force as a multiple of the load</dt><dd data-r="x"></dd></div>
    <div><dt>Hand movement per 1.0 cm of muscle shortening</dt><dd data-r="h"></dd></div>
  </dl>
  <p class="elb-check" data-check></p>

  <p class="elb-why" data-why role="status"></p>

  <p class="elb-assume"><strong>In this sketch:</strong> invented numbers, an idealized weightless forearm held horizontal, static equilibrium, the biceps pulling straight up, the elbow as the pivot; not anatomy.</p>
  <p class="elb-foot">Rule to keep: muscle force x muscle moment arm = load x load arm. A short moment arm means a large muscle force, and the same ratio means the hand moves that many times as far and as fast as the muscle’s attachment (for a small angle).</p>
</figure>

<script>
  const NS = 'http://www.w3.org/2000/svg';
  const ACCENT = '#0e7c86', ORANGE = '#e57200', INK = '#4b4b55', FAINT = '#b9b9c2';
  function el(name: string, attrs: Record<string, string | number>): SVGElement {
    const e = document.createElementNS(NS, name);
    for (const k in attrs) e.setAttribute(k, String(attrs[k]));
    return e;
  }
  function must<T extends Element>(root: ParentNode, sel: string): T {
    const e = root.querySelector<T>(sel);
    if (!e) throw new Error('ElbowLeverBalance: missing ' + sel);
    return e;
  }
  // three significant figures, trailing zeros dropped (150, 7.5, 6.25)
  const fmt = (x: number) => String(parseFloat(x.toPrecision(3)));
  // torque: two decimals, one trailing zero dropped (6.0, 0.57)
  const fmtT = (x: number) => { const s = x.toFixed(2); return s.endsWith('0') ? s.slice(0, -1) : s; };

  document.querySelectorAll<HTMLElement>('[data-elb]').forEach((root) => {
    const svg = must<SVGSVGElement>(root, '[data-svg]');
    const loadIn = must<HTMLInputElement>(root, '[data-in="load"]');
    const laIn = must<HTMLInputElement>(root, '[data-in="la"]');
    const maIn = must<HTMLInputElement>(root, '[data-in="ma"]');
    const loadOut = must<HTMLElement>(root, '[data-out="load"]');
    const laOut = must<HTMLElement>(root, '[data-out="la"]');
    const maOut = must<HTMLElement>(root, '[data-out="ma"]');
    const rT = must<HTMLElement>(root, '[data-r="t"]');
    const rF = must<HTMLElement>(root, '[data-r="f"]');
    const rX = must<HTMLElement>(root, '[data-r="x"]');
    const rH = must<HTMLElement>(root, '[data-r="h"]');
    const check = must<HTMLElement>(root, '[data-check]');
    const why = must<HTMLElement>(root, '[data-why]');
    const radios = Array.from(root.querySelectorAll<HTMLInputElement>('input[type=radio]'));

    function text(x: number, y: number, s: string, opts: Record<string, string | number> = {}) {
      const t = el('text', Object.assign({ x, y, 'font-size': 10, fill: INK }, opts));
      t.textContent = s;
      svg.appendChild(t);
    }
    function arrow(x: number, y1: number, y2: number, color: string) {
      // line from y1 to y2 with an arrowhead at y2
      const dir = y2 < y1 ? -1 : 1;
      svg.appendChild(el('line', { x1: x, y1, x2: x, y2: y2 - dir * 6, stroke: color, 'stroke-width': 3 }));
      svg.appendChild(el('polygon', { points: `${x},${y2} ${x - 5},${y2 - dir * 9} ${x + 5},${y2 - dir * 9}`, fill: color }));
    }

    function render() {
      const mode = (radios.find((r) => r.checked) || radios[0]).value;
      const load = parseFloat(loadIn.value);
      const la = parseFloat(laIn.value);
      const ma = parseFloat(maIn.value);
      const torque = load * la;           // N m
      const force = torque / ma;          // N
      const ratio = la / ma;              // force multiple, and hand distance per attachment distance
      const handCm = ratio * 1.0;         // cm per 1.0 cm shortening
      const prod = force * ma;

      loadOut.textContent = `${load} N`;
      laOut.textContent = `${la.toFixed(2)} m`;
      maOut.textContent = `${ma.toFixed(3)} m`;
      rT.textContent = `${fmtT(torque)} N m (${load} N x ${la.toFixed(2)} m)`;
      rF.textContent = `${fmt(force)} N (${fmtT(torque)} / ${ma.toFixed(3)})`;
      rX.textContent = `${fmt(ratio)} times the load`;
      rH.textContent = `${fmt(handCm)} cm (${la.toFixed(2)} / ${ma.toFixed(3)})`;
      const rounded = Math.abs(parseFloat(force.toPrecision(3)) - force) > 1e-9 * force;
      check.textContent = `Check: ${fmt(force)} N x ${ma.toFixed(3)} m ${rounded ? '≈' : '='} ${fmtT(prod)} N m, matching the load’s torque of ${fmtT(torque)} N m.`;

      // ---- drawing ----
      svg.replaceChildren();
      const PX = 60, S = 650;                 // pivot x, px per metre
      const xa = PX + ma * S, xh = PX + la * S;
      const Y = 185;                          // bar centre line

      if (mode === 'force') {
        const loadLen = 36;
        const muscleLen = Math.min(144, loadLen * (1 + Math.log(Math.max(ratio, 1))));
        // forearm bar and pivot
        svg.appendChild(el('polygon', { points: `${PX},${Y + 7} ${PX - 9},${Y + 24} ${PX + 9},${Y + 24}`, fill: INK }));
        svg.appendChild(el('rect', { x: PX - 8, y: Y - 7, width: xh - PX + 16, height: 14, rx: 3, fill: '#e8eef0', stroke: INK, 'stroke-width': 1.2 }));
        svg.appendChild(el('circle', { cx: PX, cy: Y, r: 3.5, fill: INK }));
        text(PX - 14, Y + 4, 'elbow', { 'text-anchor': 'end' });
        // biceps (up) and load (down)
        arrow(xa, Y - 7, Y - 7 - muscleLen, ACCENT);
        text(xa + 9, Y - 7 - muscleLen / 2 + 4, `biceps ${fmt(force)} N`, { fill: ACCENT, 'font-weight': 700 });
        arrow(xh, Y + 7, Y + 7 + loadLen, ORANGE);
        text(xh > 240 ? xh - 9 : xh + 9, Y + 7 + loadLen / 2 + 4, `load ${load} N`, { fill: ORANGE, 'font-weight': 700, 'text-anchor': xh > 240 ? 'end' : 'start' });
        // torque rows at the top
        text(8, 15, `Muscle torque: ${fmt(force)} N x ${ma.toFixed(3)} m ${rounded ? '≈' : '='} ${fmtT(prod)} N m`, { fill: ACCENT, 'font-weight': 700 });
        text(8, 30, `Load torque: ${load} N x ${la.toFixed(2)} m = ${fmtT(torque)} N m`, { fill: ORANGE, 'font-weight': 700 });
        text(8, 253, 'Bar: weightless forearm held horizontal. Arrow lengths are not to scale.', { 'font-size': 9 });
      } else {
        const K = 130;                         // px per metre of rise (angle exaggerated)
        const riseA = ma * K, riseH = la * K;
        // original position (dashed) and the slightly turned forearm
        svg.appendChild(el('line', { x1: PX, y1: Y, x2: xh, y2: Y, stroke: FAINT, 'stroke-width': 10, 'stroke-dasharray': '5 4' }));
        svg.appendChild(el('polygon', { points: `${PX},${Y + 7} ${PX - 9},${Y + 24} ${PX + 9},${Y + 24}`, fill: INK }));
        svg.appendChild(el('line', { x1: PX, y1: Y, x2: xh, y2: Y - riseH, stroke: INK, 'stroke-width': 10, 'stroke-linecap': 'round' }));
        svg.appendChild(el('circle', { cx: PX, cy: Y, r: 3.5, fill: '#fff' }));
        text(PX - 14, Y + 4, 'elbow', { 'text-anchor': 'end' });
        // travel arrows: attachment point and hand
        arrow(xa, Y - 2, Y - riseA - 2, ACCENT);
        arrow(xh, Y - 2, Y - riseH - 2, ORANGE);
        text(xa, Y + 32, '1.0 cm', { fill: ACCENT, 'font-weight': 700, 'text-anchor': 'middle' });
        text(Math.min(xh + 12, 352), Y - riseH - 12, `hand ${fmt(handCm)} cm`, { fill: ORANGE, 'font-weight': 700, 'text-anchor': 'end' });
        text(8, 15, 'Biceps shortens by 1.0 cm: its attachment moves 1.0 cm', { fill: ACCENT, 'font-weight': 700 });
        text(8, 30, `Hand moves ${la.toFixed(2)} / ${ma.toFixed(3)} = ${fmt(ratio)} times as far: about ${fmt(handCm)} cm`, { fill: ORANGE, 'font-weight': 700 });
        text(8, 253, 'Dashed bar: starting position. Turn angle exaggerated; small-angle approximation.', { 'font-size': 9 });
      }

      // ---- status ----
      const third = 'This is a third-class lever: the muscle pulls between the pivot and the load, and gives up force for distance and speed.';
      why.textContent = mode === 'force'
        ? `Torque balance about the elbow: ${load} N x ${la.toFixed(2)} m = ${fmtT(torque)} N m, so the biceps must pull ${fmt(force)} N, which is ${fmt(ratio)} times the load. ${third}`
        : `The same geometry means the hand moves ${la.toFixed(2)} / ${ma.toFixed(3)} = ${fmt(ratio)} times as far, and as fast, as the point where the biceps attaches: about ${fmt(handCm)} cm for 1.0 cm of shortening (for a small angle). ${third}`;
    }
    [loadIn, laIn, maIn].forEach((s) => s.addEventListener('input', render));
    radios.forEach((r) => r.addEventListener('change', render));
    render();
  });
</script>

<style>
  .elb { padding: var(--ddp-space-3) var(--ddp-space-4) var(--ddp-space-4); margin: var(--ddp-space-5) 0; }
  .elb-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem; font-weight: 600; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); margin-bottom: var(--ddp-space-3); }
  .elb-chip { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 400; color: var(--ddp-color-muted); }
  .elb-svg { display: block; width: 100%; max-width: 560px; margin: 0 auto; height: auto; background: #fff; border: 1px solid var(--ddp-color-line); border-radius: 6px; }
  .elb-controls { display: grid; grid-template-columns: 1fr 1fr; gap: var(--ddp-space-2) var(--ddp-space-4); margin: var(--ddp-space-3) 0 var(--ddp-space-2); }
  .elb-fs { border: 0; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.1rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .elb-fs legend { padding: 0; color: var(--ddp-color-ink-soft); }
  .elb-slabel { display: flex; flex-direction: column; gap: 0.1rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .elb-slabel em { font-style: normal; font-weight: 700; color: var(--ddp-color-accent); font-family: var(--ddp-font-mono); }
  .elb-slabel input, .elb-fs input { accent-color: var(--ddp-color-accent); }
  .elb-readout { display: grid; grid-template-columns: 1fr 1fr; gap: var(--ddp-space-2); margin: var(--ddp-space-2) 0; padding: var(--ddp-space-2) var(--ddp-space-3); background: color-mix(in srgb, var(--ddp-color-accent) 8%, transparent); border-radius: 6px; }
  .elb-readout div { display: flex; flex-direction: column; gap: 0.1rem; }
  .elb-readout dt { font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .elb-readout dd { margin: 0; font-family: var(--ddp-font-mono); font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); font-weight: 700; overflow-wrap: anywhere; }
  .elb-check { margin: 0 0 var(--ddp-space-2); font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .elb-why { margin: 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); line-height: 1.5; min-height: 4.5em; }
  .elb-assume { margin: var(--ddp-space-2) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .elb-foot { margin: var(--ddp-space-3) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); border-left: 3px solid var(--ddp-color-secondary); padding-left: 0.55rem; }
  @media (max-width: 520px) {
    .elb-controls, .elb-readout { grid-template-columns: 1fr; }
  }
</style>
