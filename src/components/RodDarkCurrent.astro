---
/**
 * RodDarkCurrent — in a rod, light is signalled by a fall. One slider (light, dark to bright)
 * moves four small level bars together: cGMP, open cGMP-gated channels, the inward (dark)
 * current, and glutamate release. Each bar only goes in the direction the senses-and-cgmp
 * lesson gives. The bars sketch direction, not measured size: the lesson states no curve, so
 * every bar is drawn at the same fraction, in relative units. The only numbers used are the
 * lesson's: roughly 20 pA of dark current in a toad rod (Baylor, Lamb and Yau) and a dip of
 * about 1 pA per isomerized rhodopsin. The calcium feedback (adaptation) is not drawn.
 * Self-contained vanilla-TS Astro island. Original.
 */
---

<figure class="rdc card" data-rdc>
  <figcaption class="rdc-head">Rod dark current: light is signalled by a fall<span class="rdc-chip">⚙ original · interactive</span></figcaption>

  <svg class="rdc-svg" viewBox="0 0 360 210" role="img" aria-label="Four level bars for a rod: cGMP, open channels, inward current and glutamate release, which fall together as light rises" data-stage></svg>

  <div class="rdc-row">
    <label class="rdc-label" for="rdc-light">Light on the rod</label>
    <span class="rdc-end">dark</span>
    <input id="rdc-light" class="rdc-range" type="range" min="0" max="100" step="1" value="0" data-light aria-describedby="rdc-status" />
    <span class="rdc-end">bright</span>
  </div>

  <p class="rdc-verdict" id="rdc-status" data-verdict role="status"></p>

  <p class="rdc-foot">Rule to keep: in the rod a fall in cGMP is the signal, so more light means less cGMP, fewer open channels, less inward current and less glutamate. The bars sketch direction, not measured size; in this sketch they share one straight-line scale in relative units and never reach zero here, because the lesson does not say every channel closes, and the lesson gives no dose-response curve.</p>
</figure>

<script>
  const NS = 'http://www.w3.org/2000/svg';
  function el(name: string, attrs: Record<string, string | number>, text?: string): SVGElement {
    const e = document.createElementNS(NS, name);
    for (const k in attrs) e.setAttribute(k, String(attrs[k]));
    if (text !== undefined) e.textContent = text;
    return e;
  }
  const BARS = [
    { name: 'cGMP', color: '#0e7c86', word: 'falls' },
    { name: 'open channels', color: '#2f6f8f', word: 'fewer' },
    { name: 'inward current', color: '#e57200', word: 'shrinks' },
    { name: 'glutamate released', color: '#7a5ea8', word: 'drops' },
  ];
  // In this sketch the bars fall along one straight line and never reach zero, because the
  // lesson does not say the channels all close. The line itself is the sketch's, not the lesson's.
  const level = (light: number) => 1 - 0.8 * (light / 100);

  document.querySelectorAll<HTMLElement>('[data-rdc]').forEach((root) => {
    const stage = root.querySelector<SVGSVGElement>('[data-stage]')!;
    const slider = root.querySelector<HTMLInputElement>('[data-light]')!;
    const verdict = root.querySelector<HTMLElement>('[data-verdict]')!;
    const INK = '#4b4b55', FAINT = '#8a8a96';

    function say(light: number): string {
      if (light === 0) {
        return 'Dark. cGMP is high and holds some cation channels open, so sodium and calcium flow in: the dark current, roughly 20 pA in the toad rod the lesson describes. The rod sits partly depolarized and releases glutamate continuously.';
      }
      const lead = light < 34 ? 'A little light.' : light < 67 ? 'More light.' : 'Bright light.';
      return `${lead} Active rhodopsin switches on transducin; transducin-GTP switches on PDE6, which hydrolyzes cGMP to GMP. cGMP falls, channels close, the inward current shrinks and the membrane hyperpolarizes. The rod releases less glutamate, and that drop is the signal. (The lesson gives about 1 pA of dip per isomerized rhodopsin; this slider is not scaled to it.)`;
    }
    function draw(light: number) {
      stage.replaceChildren();
      const L = level(light);
      const base = 150, maxH = 110, w = 52, gap = 22, x0 = 22;
      stage.appendChild(el('text', { x: 8, y: 14, 'font-size': 9, fill: INK }, 'level, relative units (not to scale)'));
      BARS.forEach((b, i) => {
        const x = x0 + i * (w + gap);
        const h = Math.round(maxH * L);
        stage.appendChild(el('rect', { x, y: base - maxH, width: w, height: maxH, rx: 4, fill: '#f1f1f4', stroke: '#d9d9e0' }));
        stage.appendChild(el('rect', { x, y: base - h, width: w, height: h, rx: 4, fill: b.color }));
        stage.appendChild(el('text', { x: x + w / 2, y: base + 14, 'font-size': 10, 'text-anchor': 'middle', 'font-weight': 700, fill: INK }, b.name.split(' ')[0]));
        stage.appendChild(el('text', { x: x + w / 2, y: base + 26, 'font-size': 10, 'text-anchor': 'middle', fill: INK }, b.name.split(' ').slice(1).join(' ') || ' '));
        stage.appendChild(el('text', { x: x + w / 2, y: base + 44, 'font-size': 10, 'text-anchor': 'middle', 'font-weight': 700, fill: light === 0 ? FAINT : b.color }, light === 0 ? 'dark level' : b.word));
      });
    }
    function render() {
      const light = Number(slider.value);
      draw(light);
      verdict.textContent = say(light);
      slider.setAttribute('aria-valuetext', light === 0 ? 'dark' : `${light} on a 0 to 100 scale of light, relative`);
    }
    slider.addEventListener('input', render);
    render();
  });
</script>

<style is:global>
  .rdc { padding: var(--ddp-space-3) var(--ddp-space-4) var(--ddp-space-4); margin: var(--ddp-space-5) 0; }
  .rdc-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem; font-weight: 600; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); margin-bottom: var(--ddp-space-3); }
  .rdc-chip { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 400; color: var(--ddp-color-muted); }
  .rdc-svg { display: block; width: 100%; max-width: 600px; margin: 0 auto var(--ddp-space-3); height: auto; background: #fff; border: 1px solid var(--ddp-color-line); border-radius: 6px; }
  .rdc-row { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; margin: 0.35rem 0; }
  .rdc-label { font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); min-width: 8em; }
  .rdc-end { font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .rdc-range { flex: 1 1 8rem; min-width: 8rem; accent-color: var(--ddp-color-accent); }
  .rdc-range:focus-visible { outline: 2px solid var(--ddp-color-accent); outline-offset: 2px; }
  .rdc-verdict { margin: var(--ddp-space-2) 0; padding: var(--ddp-space-2) var(--ddp-space-3); background: color-mix(in srgb, var(--ddp-color-accent) 8%, transparent); border-radius: 6px; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); min-height: 6em; }
  .rdc-foot { margin: var(--ddp-space-3) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); border-left: 3px solid var(--ddp-color-secondary); padding-left: 0.55rem; }
</style>
