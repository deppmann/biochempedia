---
/**
 * CondensateLeverRule — the made-up phase-separation model of the nuclear-architecture lesson.
 * One control: the total nuclear concentration of a protein (0 to 10 uM). The lesson gives
 * c_sat = 1 uM and a dense phase at 50 uM. Below c_sat there are no bodies; above it the dilute
 * phase stays at c_sat and the dense-phase volume fraction is
 *   phi = (c_total - c_sat) / (c_dense - c_sat).
 * Shown as dots in a nucleus outline (total dot area = phi x nucleus area, fixed positions, so
 * nothing is random) and as a plot of dilute and dense concentration against total.
 * Labelled blocks, dots and a plotted equation only. Self-contained vanilla-TS Astro island. Original.
 */
---

<figure class="cl card" data-condlever>
  <figcaption class="cl-head">Condensate lever rule: how bodies grow as the protein goes up<span class="cl-chip">⚙ original · interactive</span></figcaption>

  <svg class="cl-svg" viewBox="0 0 360 200" role="img" aria-label="Left: a nucleus outline with dense bodies drawn as dots. Right: a plot of dilute and dense phase concentration against total nuclear concentration" data-stage></svg>

  <div class="cl-row">
    <label class="cl-label" for="cl-total">Total nuclear concentration of the protein</label>
    <input id="cl-total" type="range" min="0" max="10" step="0.1" value="2" data-total />
    <output class="cl-out" data-totalout></output>
  </div>
  <div class="cl-row">
    <span class="cl-label">Set the slider to the lesson’s cases</span>
    <div class="cl-presets" data-presets>
      <button type="button" class="cl-btn" data-set="2">2 μM</button>
      <button type="button" class="cl-btn" data-set="4">4 μM</button>
      <button type="button" class="cl-btn" data-set="8">8 μM</button>
    </div>
  </div>

  <dl class="cl-read">
    <div><dt>Dilute phase</dt><dd data-dil></dd></div>
    <div><dt>Dense phase</dt><dd data-den></dd></div>
    <div><dt>Bodies fill (φ)</dt><dd data-phi></dd></div>
  </dl>
  <p class="cl-math" data-math></p>

  <p class="cl-verdict" data-verdict role="status"></p>

  <p class="cl-foot">An idealized model, in this sketch: one dense phase at 50 μM, a saturation concentration of 1 μM, a dilute phase held at that value, and made-up data. The number and places of the dots are arbitrary, only their total area means anything. Binding to clustered sites or bridging chromatin can also make bright spots, and a protein that fails this test may still phase separate as one part of a mixture of several components. A protein that passes has not been shown to need the body for any function. Keep the rule φ = (c_total − c_sat) / (c_dense − c_sat).</p>
</figure>

<script>
  const NS = 'http://www.w3.org/2000/svg';
  const C_SAT = 1, C_DENSE = 50;
  const INK = '#4b4b55', FAINT = '#8a8a96', TEAL = '#0e7c86', ORANGE = '#e57200';
  // Nucleus geometry in the 360 x 200 viewBox.
  const NX = 82, NY = 92, NR = 70;
  // Plot geometry.
  const PX0 = 200, PX1 = 344, PY0 = 164, PY1 = 34; // x: 0..10 uM, y: 0..50 uM (PY0 is the bottom)
  const XMAX = 10, YMAX = 50;
  // Twelve fixed body positions (1 + 5 + 6), spaced so the largest body (phi = 9/49) never overlaps.
  const SPOTS: [number, number][] = [[0, 0]];
  for (let i = 0; i < 5; i++) { const a = -Math.PI / 2 + (i * 2 * Math.PI) / 5; SPOTS.push([30 * Math.cos(a), 30 * Math.sin(a)]); }
  for (let i = 0; i < 6; i++) { const a = Math.PI / 6 + (i * 2 * Math.PI) / 6; SPOTS.push([53 * Math.cos(a), 53 * Math.sin(a)]); }

  function el(name: string, attrs: Record<string, string | number>, text?: string): SVGElement {
    const e = document.createElementNS(NS, name);
    for (const k in attrs) e.setAttribute(k, String(attrs[k]));
    if (text !== undefined) e.textContent = text;
    return e;
  }
  const px = (c: number) => PX0 + (c / XMAX) * (PX1 - PX0);
  const py = (v: number) => PY0 - (v / YMAX) * (PY0 - PY1);
  const fmt = (v: number) => (Math.abs(v - Math.round(v)) < 1e-9 ? String(Math.round(v)) : v.toFixed(1));

  document.querySelectorAll<HTMLElement>('[data-condlever]').forEach((root) => {
    const stage = root.querySelector<SVGSVGElement>('[data-stage]')!;
    const slider = root.querySelector<HTMLInputElement>('[data-total]')!;
    const totalOut = root.querySelector<HTMLElement>('[data-totalout]')!;
    const dilEl = root.querySelector<HTMLElement>('[data-dil]')!;
    const denEl = root.querySelector<HTMLElement>('[data-den]')!;
    const phiEl = root.querySelector<HTMLElement>('[data-phi]')!;
    const mathEl = root.querySelector<HTMLElement>('[data-math]')!;
    const verdict = root.querySelector<HTMLElement>('[data-verdict]')!;

    function model(c: number) {
      const above = c > C_SAT + 1e-9;
      const phi = above ? (c - C_SAT) / (C_DENSE - C_SAT) : 0;
      const dilute = above ? C_SAT : c;
      return { above, phi, dilute };
    }

    function draw(c: number, phi: number, above: boolean, dilute: number) {
      stage.replaceChildren();
      // --- nucleus ---
      stage.appendChild(el('circle', { cx: NX, cy: NY, r: NR, fill: '#f3f7f8', stroke: INK, 'stroke-width': 1.5 }));
      const rb = NR * Math.sqrt(phi / SPOTS.length); // total dot area = phi x nucleus area
      if (above) SPOTS.forEach(([dx, dy]) => stage.appendChild(el('circle', { cx: NX + dx, cy: NY + dy, r: rb, fill: ORANGE })));
      else stage.appendChild(el('text', { x: NX, y: NY + 3, 'font-size': 10, 'text-anchor': 'middle', fill: FAINT }, 'no bodies'));
      stage.appendChild(el('text', { x: NX, y: 180, 'font-size': 9, 'text-anchor': 'middle', fill: INK }, 'nucleus (dense bodies = orange dots)'));
      stage.appendChild(el('text', { x: NX, y: 192, 'font-size': 9, 'text-anchor': 'middle', fill: INK }, 'dot area = share of nuclear volume'));
      // --- plot ---
      stage.appendChild(el('line', { x1: PX0, y1: PY0, x2: PX1, y2: PY0, stroke: INK, 'stroke-width': 1 }));
      stage.appendChild(el('line', { x1: PX0, y1: PY0, x2: PX0, y2: PY1 - 6, stroke: INK, 'stroke-width': 1 }));
      for (const t of [0, 2, 4, 6, 8, 10]) {
        stage.appendChild(el('line', { x1: px(t), y1: PY0, x2: px(t), y2: PY0 + 3, stroke: INK, 'stroke-width': 1 }));
        stage.appendChild(el('text', { x: px(t), y: PY0 + 12, 'font-size': 9, 'text-anchor': 'middle', fill: INK }, String(t)));
      }
      for (const t of [0, 25, 50]) {
        stage.appendChild(el('line', { x1: PX0 - 3, y1: py(t), x2: PX0, y2: py(t), stroke: INK, 'stroke-width': 1 }));
        stage.appendChild(el('text', { x: PX0 - 5, y: py(t) + 3, 'font-size': 9, 'text-anchor': 'end', fill: INK }, String(t)));
      }
      stage.appendChild(el('text', { x: (PX0 + PX1) / 2, y: 191, 'font-size': 9, 'text-anchor': 'middle', fill: INK }, 'total nuclear concentration (μM)'));
      stage.appendChild(el('text', { x: 196, y: 16, 'font-size': 9, 'text-anchor': 'start', fill: INK }, 'phase concentration (μM)'));
      // dense phase: only exists above c_sat
      stage.appendChild(el('line', { x1: px(0), y1: py(C_DENSE), x2: px(C_SAT), y2: py(C_DENSE), stroke: ORANGE, 'stroke-width': 1.5, 'stroke-dasharray': '3 3', opacity: 0.45 }));
      stage.appendChild(el('line', { x1: px(C_SAT), y1: py(C_DENSE), x2: px(XMAX), y2: py(C_DENSE), stroke: ORANGE, 'stroke-width': 2.5 }));
      stage.appendChild(el('text', { x: PX1, y: py(C_DENSE) - 5, 'font-size': 9, 'text-anchor': 'end', fill: ORANGE, 'font-weight': 700 }, 'dense phase: 50 μM'));
      // dilute phase: follows the total up to c_sat, then stays at c_sat
      stage.appendChild(el('polyline', { points: `${px(0)},${py(0)} ${px(C_SAT)},${py(C_SAT)} ${px(XMAX)},${py(C_SAT)}`, fill: 'none', stroke: TEAL, 'stroke-width': 2.5 }));
      stage.appendChild(el('text', { x: PX1, y: py(C_SAT) - 6, 'font-size': 9, 'text-anchor': 'end', fill: TEAL, 'font-weight': 700 }, 'dilute phase: c_sat = 1 μM'));
      // cursor
      stage.appendChild(el('line', { x1: px(c), y1: PY0, x2: px(c), y2: py(C_DENSE), stroke: INK, 'stroke-width': 1, 'stroke-dasharray': '2 3' }));
      stage.appendChild(el('circle', { cx: px(c), cy: py(dilute), r: 4.5, fill: TEAL, stroke: '#fff', 'stroke-width': 1.5 }));
      if (above) stage.appendChild(el('circle', { cx: px(c), cy: py(C_DENSE), r: 4.5, fill: ORANGE, stroke: '#fff', 'stroke-width': 1.5 }));
    }

    function render() {
      const c = Math.round(parseFloat(slider.value) * 10) / 10;
      const { above, phi, dilute } = model(c);
      draw(c, phi, above, dilute);
      totalOut.textContent = `${fmt(c)} μM`;
      slider.setAttribute('aria-valuetext', `${fmt(c)} micromolar`);
      dilEl.textContent = `${fmt(dilute)} μM`;
      denEl.textContent = above ? `${C_DENSE} μM` : 'none yet';
      const pct = (phi * 100).toFixed(1);
      phiEl.textContent = above ? `${pct}%` : '0%';
      if (above) {
        const num = fmt(Math.round((c - C_SAT) * 10) / 10);
        mathEl.textContent = `φ = (${fmt(c)} − 1) / (50 − 1) = ${num} / 49 = ${phi.toFixed(3)}, so bodies fill ${pct}% of the nucleus.`;
      } else {
        mathEl.textContent = `c_total = ${fmt(c)} μM is not above c_sat = 1 μM, so the mass balance gives no dense phase: φ = 0.`;
      }
      let v: string;
      if (c < C_SAT - 1e-9) {
        v = `Below the saturation concentration (1 μM) no bodies form. All of the protein, ${fmt(c)} μM, is in the dilute phase.`;
      } else if (!above) {
        v = 'The total has just reached the saturation concentration of 1 μM. Bodies begin only above it, so none are drawn yet.';
      } else {
        v = `In this model, above the threshold, the extra protein goes into the bodies, which fill ${pct}% of the nucleus, while the dilute phase stays at 1 μM.`;
        if (Math.abs(c - 2) < 1e-9) v += ' This is the lesson’s 2 μM case: 2.0%.';
        else if (Math.abs(c - 4) < 1e-9) v += ' This is the lesson’s 4 μM case: 6.1%.';
        else if (Math.abs(c - 8) < 1e-9) v += ' This is the lesson’s 8 μM case: 14.3%, seven times the 2.0% at 2 μM, with the nucleoplasm still near 1 μM.';
      }
      verdict.textContent = v;
    }

    slider.addEventListener('input', render);
    root.querySelectorAll<HTMLButtonElement>('[data-set]').forEach((b) => b.addEventListener('click', () => { slider.value = b.dataset.set!; render(); }));
    render();
  });
</script>

<style is:global>
  .cl { padding: var(--ddp-space-3) var(--ddp-space-4) var(--ddp-space-4); margin: var(--ddp-space-5) 0; }
  .cl-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem; font-weight: 600; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); margin-bottom: var(--ddp-space-3); }
  .cl-chip { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 400; color: var(--ddp-color-muted); }
  .cl-svg { display: block; width: 100%; max-width: 600px; margin: 0 auto var(--ddp-space-3); height: auto; background: #fff; border: 1px solid var(--ddp-color-line); border-radius: 6px; }
  .cl-row { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem 0.6rem; margin: 0.35rem 0; }
  .cl-label { font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); flex: 1 1 100%; }
  .cl-row input[type="range"] { flex: 1 1 12rem; min-width: 0; accent-color: var(--ddp-color-accent); }
  .cl-out { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); min-width: 4.5em; }
  .cl-presets { display: flex; flex-wrap: wrap; gap: 0.3rem; }
  .cl-btn { border: 1px solid var(--ddp-color-line); border-radius: 5px; background: transparent; color: var(--ddp-color-ink-soft); font-size: var(--ddp-text-xs); padding: 0.25rem 0.6rem; cursor: pointer; }
  .cl-btn:focus-visible, .cl-row input:focus-visible { outline: 2px solid var(--ddp-color-accent); outline-offset: 2px; }
  .cl-read { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.4rem; margin: var(--ddp-space-3) 0 var(--ddp-space-2); }
  .cl-read div { border: 1px solid var(--ddp-color-line); border-radius: 6px; padding: 0.3rem 0.5rem; }
  .cl-read dt { font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .cl-read dd { margin: 0; font-family: var(--ddp-font-mono); font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); }
  .cl-math { margin: var(--ddp-space-2) 0; font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); min-height: 3em; }
  .cl-verdict { margin: var(--ddp-space-2) 0; padding: var(--ddp-space-2) var(--ddp-space-3); background: color-mix(in srgb, var(--ddp-color-accent) 8%, transparent); border-radius: 6px; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); min-height: 4.5em; }
  .cl-foot { margin: var(--ddp-space-3) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); border-left: 3px solid var(--ddp-color-secondary); padding-left: 0.55rem; }
  @media (max-width: 520px) { .cl-read { grid-template-columns: 1fr; } }
</style>
