---
/**
 * InterOrganFuelMap — the body-wide companion to CoriCycleLab. That island zooms in on one loop
 * (muscle lactate ↔ liver glucose); this one zooms all the way out to the whole fuel economy:
 * four tissues (liver, muscle, adipose, brain) trading through the blood, with the traffic
 * labeled by fuel. Flip the FED / FASTED toggle and the arrows redraw — fed means distribute and
 * store (glucose out to everyone, fat banked); fasted means mobilize and protect the brain (fat
 * and lactate and alanine move toward the liver, which ships glucose and ketones to the brain).
 * The legend reports what each organ is exporting and importing in the current state.
 * Self-contained vanilla-TS Astro island. Original.
 */
---

<figure class="iof card" data-fuelmap>
  <figcaption class="iof-head">Who feeds whom — the inter-organ fuel economy<span class="iof-chip">⚙ original · interactive</span></figcaption>

  <div class="iof-toggle" role="group" aria-label="Metabolic state">
    <button type="button" data-state="fed" aria-pressed="true">Fed</button>
    <button type="button" data-state="fasted" aria-pressed="false">Fasted</button>
  </div>

  <p class="iof-summary" data-summary role="status"></p>

  <div class="iof-map" data-map>
    <div class="iof-org" data-org="liver"><span class="iof-org-name">Liver</span><span class="iof-org-role" data-role></span></div>
    <div class="iof-org" data-org="muscle"><span class="iof-org-name">Muscle</span><span class="iof-org-role" data-role></span></div>
    <div class="iof-flow" data-flow="liver" data-pos="top"></div>
    <div class="iof-flow" data-flow="muscle" data-pos="top"></div>
    <div class="iof-blood">
      <div class="iof-gut" data-gut></div>
      <span class="iof-blood-name">bloodstream</span>
    </div>
    <div class="iof-flow" data-flow="adipose" data-pos="bottom"></div>
    <div class="iof-flow" data-flow="brain" data-pos="bottom"></div>
    <div class="iof-org" data-org="adipose"><span class="iof-org-name">Adipose</span><span class="iof-org-role" data-role></span></div>
    <div class="iof-org" data-org="brain"><span class="iof-org-name">Brain</span><span class="iof-org-role" data-role></span></div>
  </div>

  <div class="iof-key" aria-hidden="true">
    <span style="--c:#0e7c86">glucose</span>
    <span style="--c:#D4A843">fat</span>
    <span style="--c:#232d4b">ketone bodies</span>
    <span style="--c:#e57200">lactate · alanine · glycerol · amino acids</span>
  </div>

  <p class="iof-foot">Two states, two logics. Fed, insulin is high and the body distributes and stores: glucose from the gut reaches every tissue, and the liver and adipose bank the surplus as glycogen and fat. Fasted, the priority flips to mobilize and protect the brain: adipose releases fatty acids, muscle returns lactate and alanine to the liver, and the liver — the main source of both — makes fresh glucose and ketone bodies to keep the brain running. No tissue is selfish here; the blood is just a ledger, and the hormones decide which way the entries point.</p>
</figure>

<script>
  // Every exchange runs through the blood, so each organ gets two lanes to the bloodstream:
  // what it SENDS into the blood and what it TAKES from it. Flip the state and the lanes refill.
  type Fuel = 'glucose' | 'fat' | 'ketone' | 'carbon';
  const FUEL_COLOR: Record<Fuel, [string, string]> = {
    // [swatch, text ink] — gold and orange get darker inks so the words clear WCAG AA on white
    glucose: ['#0e7c86', '#0e7c86'],
    fat: ['#D4A843', '#7f6315'],
    ketone: ['#232d4b', '#232d4b'],
    carbon: ['#e57200', '#b35900'],
  };
  type Item = [string, Fuel];
  type OrganState = { role: string; sends: Item[]; takes: Item[] };
  type StateDef = { summary: string; gut: Item[]; organs: Record<string, OrganState> };

  const STATES: Record<string, StateDef> = {
    fed: {
      summary: 'Fed = distribute and store. Insulin is high. The gut floods the blood with glucose, amino acids, and dietary fat; every tissue takes up glucose, the liver banks glycogen and ships surplus carbon out as fat (VLDL), and adipose stores it.',
      gut: [['glucose', 'glucose'], ['amino acids', 'carbon'], ['dietary fat', 'fat']],
      organs: {
        liver: { role: 'stores glycogen; turns surplus glucose into fat', sends: [['fat (VLDL)', 'fat']], takes: [['glucose', 'glucose'], ['amino acids', 'carbon']] },
        muscle: { role: 'refills glycogen, builds protein', sends: [], takes: [['glucose', 'glucose'], ['amino acids', 'carbon']] },
        adipose: { role: 'banks fat as triacylglycerol', sends: [], takes: [['fat', 'fat'], ['glucose', 'glucose']] },
        brain: { role: 'burns glucose', sends: [], takes: [['glucose', 'glucose']] },
      },
    },
    fasted: {
      summary: 'Fasted = mobilize and protect the brain. Glucagon is high and the gut is empty. Adipose releases fatty acids and glycerol, muscle sends lactate and alanine, and the liver turns them into fresh glucose (gluconeogenesis) and ketone bodies for the brain and muscle.',
      gut: [],
      organs: {
        liver: { role: 'makes new glucose and ketone bodies', sends: [['glucose', 'glucose'], ['ketones', 'ketone']], takes: [['fatty acids', 'fat'], ['lactate', 'carbon'], ['alanine', 'carbon'], ['glycerol', 'carbon']] },
        muscle: { role: 'burns fat and ketones, spares glucose', sends: [['lactate', 'carbon'], ['alanine', 'carbon']], takes: [['fatty acids', 'fat'], ['ketones', 'ketone']] },
        adipose: { role: 'lipolysis: releases stored fat', sends: [['fatty acids', 'fat'], ['glycerol', 'carbon']], takes: [] },
        brain: { role: 'glucose, plus ketones as the fast lengthens', sends: [], takes: [['glucose', 'glucose'], ['ketones', 'ketone']] },
      },
    },
  };
  const NAME: Record<string, string> = { liver: 'Liver', muscle: 'Muscle', adipose: 'Adipose', brain: 'Brain' };

  function chips(items: Item[]): HTMLUListElement {
    const ul = document.createElement('ul');
    ul.className = 'iof-fuels';
    items.forEach(([label, fuel]) => {
      const li = document.createElement('li');
      li.className = 'iof-fuel';
      li.style.setProperty('--c', FUEL_COLOR[fuel][0]);
      li.style.setProperty('--ci', FUEL_COLOR[fuel][1]);
      li.textContent = label;
      ul.appendChild(li);
    });
    return ul;
  }

  // one lane = an arrow (pointing toward the blood for "sends", toward the organ for "takes") + its fuels
  function lane(organ: string, kind: 'sends' | 'takes', items: Item[], pos: string): HTMLElement {
    const div = document.createElement('div');
    div.className = `iof-lane iof-lane--${kind}`;
    if (!items.length) { div.classList.add('is-empty'); return div; }
    const down = (pos === 'top') === (kind === 'sends'); // top organs send downward into the blood
    const arrow = document.createElement('span');
    arrow.className = `iof-arrow ${down ? 'iof-arrow--down' : 'iof-arrow--up'}`;
    arrow.style.setProperty('--c', FUEL_COLOR[items[0][1]][0]);
    arrow.setAttribute('aria-hidden', 'true');
    const cap = document.createElement('span');
    cap.className = 'iof-lane-cap';
    cap.textContent = kind === 'sends' ? 'sends' : 'takes';
    const list = chips(items);
    list.setAttribute('aria-label', `${NAME[organ]} ${kind === 'sends' ? 'sends into the blood' : 'takes from the blood'}`);
    div.append(arrow, cap, list);
    return div;
  }

  document.querySelectorAll<HTMLElement>('[data-fuelmap]').forEach((root) => {
    const summaryEl = root.querySelector<HTMLElement>('[data-summary]')!;
    const gutEl = root.querySelector<HTMLElement>('[data-gut]')!;
    const map = root.querySelector<HTMLElement>('[data-map]')!;
    const btns = root.querySelectorAll<HTMLButtonElement>('[data-state]');
    let state = 'fed';

    function render() {
      const def = STATES[state];
      summaryEl.textContent = def.summary;
      btns.forEach((b) => b.setAttribute('aria-pressed', String(b.getAttribute('data-state') === state)));
      map.setAttribute('data-mode', state);
      root.querySelectorAll<HTMLElement>('[data-org]').forEach((o) => {
        o.querySelector<HTMLElement>('[data-role]')!.textContent = def.organs[o.getAttribute('data-org')!].role;
      });
      root.querySelectorAll<HTMLElement>('[data-flow]').forEach((f) => {
        const id = f.getAttribute('data-flow')!, pos = f.getAttribute('data-pos')!;
        const o = def.organs[id];
        f.replaceChildren(lane(id, 'sends', o.sends, pos), lane(id, 'takes', o.takes, pos));
      });
      gutEl.replaceChildren();
      const gname = document.createElement('span');
      gname.className = 'iof-gut-name';
      gname.textContent = def.gut.length ? 'Gut →' : 'Gut';
      gutEl.appendChild(gname);
      if (def.gut.length) {
        const list = chips(def.gut);
        list.setAttribute('aria-label', 'The gut sends into the blood');
        gutEl.appendChild(list);
      } else {
        const empty = document.createElement('span');
        empty.className = 'iof-gut-empty';
        empty.textContent = 'empty — nothing arriving from a meal';
        gutEl.appendChild(empty);
      }
    }

    btns.forEach((b) => b.addEventListener('click', () => { state = b.getAttribute('data-state') || 'fed'; render(); }));
    render();
  });
</script>

<style is:global>
  .iof { padding: var(--ddp-space-3) var(--ddp-space-4) var(--ddp-space-4); margin: var(--ddp-space-5) 0; }
  .iof-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem; font-weight: 600; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); margin-bottom: var(--ddp-space-2); }
  .iof-chip { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 400; color: var(--ddp-color-muted); }
  .iof-toggle { display: inline-flex; gap: 0; border: 1px solid var(--ddp-color-line); border-radius: 6px; overflow: hidden; margin-bottom: var(--ddp-space-2); }
  .iof-toggle button { font-family: inherit; font-size: var(--ddp-text-xs); font-weight: 600; border: none; background: #fff; color: var(--ddp-color-ink-soft); padding: 0.35rem 0.95rem; cursor: pointer; }
  .iof-toggle button + button { border-left: 1px solid var(--ddp-color-line); }
  .iof-toggle button[aria-pressed='true'] { background: var(--ddp-color-accent); color: #fff; }
  .iof-toggle button:hover[aria-pressed='false'] { color: var(--ddp-color-primary); }
  .iof-toggle button:focus-visible { outline: 2px solid var(--ddp-color-accent); outline-offset: -2px; }
  .iof-summary { margin: 0 0 var(--ddp-space-3); font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); line-height: 1.5; min-height: 2.8em; padding: var(--ddp-space-2) var(--ddp-space-3); background: color-mix(in srgb, var(--ddp-color-accent) 8%, transparent); border-radius: 6px; }

  /* the map: two organs above the bloodstream, two below, gut feeding in from the side */
  .iof-map { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: var(--ddp-space-3); padding: var(--ddp-space-3); background: color-mix(in srgb, var(--ddp-color-accent) 5%, #fff); border: 1px solid var(--ddp-color-line); border-radius: 8px; }
  .iof-org { display: flex; flex-direction: column; gap: 0.1rem; background: #fff; border: 1.5px solid var(--ddp-color-primary); border-radius: 8px; padding: 0.4rem 0.6rem; text-align: center; }
  .iof-org-name { font-weight: 700; color: var(--ddp-color-primary); font-size: var(--ddp-text-sm); }
  .iof-org-role { font-size: 0.72rem; line-height: 1.35; color: var(--ddp-color-muted); }
  .iof-flow { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 0.3rem; min-height: 5.2rem; }
  .iof-lane { display: flex; flex-direction: column; align-items: center; gap: 0.15rem; padding: 0.3rem 0; position: relative; }
  .iof-flow[data-pos='top'] .iof-lane { justify-content: flex-start; }
  .iof-flow[data-pos='bottom'] .iof-lane { justify-content: flex-end; }
  .iof-lane-cap { font-family: var(--ddp-font-mono); font-size: 0.62rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--ddp-color-muted); background: color-mix(in srgb, var(--ddp-color-accent) 5%, #fff); position: relative; z-index: 1; padding: 0 0.2rem; }
  .iof-arrow { position: absolute; top: 0; bottom: 0; left: 50%; width: 2px; margin-left: -1px; background: color-mix(in srgb, var(--c) 55%, transparent); }
  .iof-arrow::after { content: ''; position: absolute; left: -5px; border-left: 6px solid transparent; border-right: 6px solid transparent; }
  .iof-arrow--down::after { bottom: -2px; border-top: 9px solid var(--c); }
  .iof-arrow--up::after { top: -2px; border-bottom: 9px solid var(--c); }
  .iof-arrow::before { content: ''; position: absolute; left: -3px; width: 8px; height: 8px; border-radius: 50%; background: var(--c); opacity: 0; }
  .iof-arrow--down::before { animation: iof-down 1.8s ease-in-out infinite; }
  .iof-arrow--up::before { animation: iof-up 1.8s ease-in-out infinite; }
  @keyframes iof-down { 0% { top: 0; opacity: 0; } 15% { opacity: 0.9; } 85% { opacity: 0.9; } 100% { top: calc(100% - 8px); opacity: 0; } }
  @keyframes iof-up { 0% { top: calc(100% - 8px); opacity: 0; } 15% { opacity: 0.9; } 85% { opacity: 0.9; } 100% { top: 0; opacity: 0; } }
  .iof .iof-fuels { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; align-items: center; gap: 0.2rem; position: relative; z-index: 1; }
  .iof .iof-fuel { margin: 0; max-width: 100%; overflow-wrap: anywhere; font-size: 0.78rem; font-weight: 600; line-height: 1.2; color: var(--ci); background: #fff; border: 1px solid color-mix(in srgb, var(--c) 55%, #fff); border-left: 4px solid var(--c); border-radius: 4px; padding: 0.12rem 0.4rem; text-align: center; animation: iof-in 0.35s ease-out both; }
  @keyframes iof-in { from { opacity: 0; transform: scale(0.92); } to { opacity: 1; transform: none; } }
  .iof-blood { grid-column: 1 / -1; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.3rem 0.6rem; background: color-mix(in srgb, #c0392b 10%, #fff); border: 1px solid color-mix(in srgb, #c0392b 30%, #fff); border-radius: 999px; padding: 0.35rem 0.8rem; }
  .iof-blood-name { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: #9b2c20; margin-left: auto; }
  .iof-gut { display: flex; flex-wrap: wrap; align-items: center; gap: 0.3rem; }
  .iof .iof-gut .iof-fuels { flex-direction: row; flex-wrap: wrap; }
  .iof-gut-name { font-weight: 700; font-size: var(--ddp-text-xs); color: var(--ddp-color-primary); }
  .iof-gut-empty { font-size: 0.72rem; color: var(--ddp-color-muted); font-style: italic; }
  .iof-key { display: flex; flex-wrap: wrap; gap: 0.3rem 0.9rem; margin: var(--ddp-space-2) 0 var(--ddp-space-3); font-size: 0.72rem; color: var(--ddp-color-ink-soft); }
  .iof-key span::before { content: ''; display: inline-block; width: 0.65rem; height: 0.65rem; border-radius: 2px; background: var(--c); margin-right: 0.3rem; vertical-align: -0.05rem; }
  @media (max-width: 480px) {
    .iof-map { column-gap: 0.4rem; padding: 0.5rem; }
    .iof-org { padding: 0.35rem 0.4rem; }
    .iof-flow { gap: 0.15rem; }
    .iof .iof-fuel { font-size: 0.66rem; padding: 0.1rem 0.3rem; border-left-width: 3px; }
    .iof-blood { border-radius: 10px; padding: 0.35rem 0.5rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .iof-arrow::before { animation: none; opacity: 0; }
    .iof .iof-fuel { animation: none; }
  }
  .iof-foot { margin: var(--ddp-space-3) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); border-left: 3px solid var(--ddp-color-secondary); padding-left: 0.55rem; }
</style>
