---
/**
 * DynamicInstabilityTrace — one microtubule plus end in purified tubulin. Growth rate =
 * kon·C − koff with the Walker et al. (1988) plus-end constants quoted in the lesson
 * (kon 8.9 per µM per s, koff 44 per s), shortening at the lesson's 733 dimers per s, and
 * 1,625 dimers per µm (13 protofilaments, 8 nm per dimer). Catastrophe and rescue are
 * drawn at random; their frequencies are labelled as belonging to the sketch. Expected
 * growth speed is shown beside the slope measured from the trace. Original.
 */
---

<figure class="dit card" data-dit>
  <figcaption class="dit-head">One microtubule end — growth, catastrophe, rescue<span class="dit-chip">⚙ original · interactive</span></figcaption>

  <svg class="dit-svg" viewBox="0 0 340 262" role="img" aria-label="Length of one microtubule plus end versus time, with slow growth, rapid shortening, catastrophes and rescues" data-plot></svg>

  <div class="dit-controls">
    <label class="dit-slabel"><span>Tubulin <em data-out="c">10.0</em> µM <small>(7 to 15.5 µM, the range tested)</small></span>
      <input type="range" data-in="c" min="7" max="15.5" step="0.5" value="10" />
    </label>
    <label class="dit-check"><input type="checkbox" data-in="sw" checked /> <span>Catastrophe and rescue on</span></label>
    <button type="button" class="dit-btn" data-resample>Resample</button>
  </div>

  <dl class="dit-readout">
    <div><dt>Expected growth speed, kon × C − koff</dt><dd data-r-exp>–</dd></div>
    <div><dt>Growth slope measured on the trace</dt><dd data-r-obs>–</dd></div>
    <div><dt>Catastrophe frequency (in this sketch)</dt><dd data-r-cat-set>–</dd></div>
    <div><dt>Catastrophes counted ÷ time growing (in this sketch)</dt><dd data-r-cat-obs>–</dd></div>
    <div><dt>Shortening speed (lesson: 733 dimers per s)</dt><dd data-r-short>–</dd></div>
    <div><dt>Shortening measured on the trace</dt><dd data-r-short-obs>–</dd></div>
  </dl>
  <p class="dit-why" data-why role="status">Move the slider or press Resample.</p>

  <p class="dit-foot">Rule to keep: growth is kon × C − koff, so it rises with tubulin, but rapid shortening does not depend on tubulin over 7 to 15.5 µM. Growth and shortening use the Walker et al. (1988) plus-end constants (pig brain tubulin free of associated proteins, 37 °C; in cells, associated proteins change them), applied across 7 to 15.5 µM by the rate law. Switching frequencies are invented for this sketch: catastrophe 0.4 per min at 10 µM scaled as 10/C, rescue fixed at 0.04 per s. The lesson supports only that more tubulin makes catastrophes rarer.</p>
</figure>

<script>
  const NS = 'http://www.w3.org/2000/svg';
  const ACCENT = '#0e7c86', ORANGE = '#e57200', INK = '#4b4b55', FAINT = '#b9b9c2';
  function el(name: string, attrs: Record<string, string | number>): SVGElement {
    const e = document.createElementNS(NS, name);
    for (const k in attrs) e.setAttribute(k, String(attrs[k]));
    return e;
  }
  function rng(seed: number) {
    let a = seed >>> 0;
    return () => {
      a = (a + 0x6d2b79f5) >>> 0;
      let t = a;
      t = Math.imul(t ^ (t >>> 15), t | 1);
      t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }
  // Lesson constants
  const KON = 8.9, KOFF = 44, SHORT_DIMERS = 733, DIMERS_PER_UM = 1625;
  const RESCUE = 0.04;            // per s, from the lesson's made-up trace (sketch)
  const CAT_AT_10 = 0.0067;       // per s, from the lesson's made-up trace (sketch)
  const TMAX = 600, DT = 0.5, L0 = 2;

  document.querySelectorAll<HTMLElement>('[data-dit]').forEach((root) => {
    const plot = root.querySelector<SVGSVGElement>('[data-plot]')!;
    const cIn = root.querySelector<HTMLInputElement>('[data-in="c"]')!;
    const swIn = root.querySelector<HTMLInputElement>('[data-in="sw"]')!;
    const btn = root.querySelector<HTMLButtonElement>('[data-resample]')!;
    const cOut = root.querySelector<HTMLElement>('[data-out="c"]')!;
    const o = (s: string) => root.querySelector<HTMLElement>(s)!;
    const rExp = o('[data-r-exp]'), rObs = o('[data-r-obs]'), rCatSet = o('[data-r-cat-set]'), rCatObs = o('[data-r-cat-obs]');
    const rShort = o('[data-r-short]'), rShortObs = o('[data-r-short-obs]'), why = o('[data-why]');

    let seed = 12345;
    const X0 = 40, X1 = 328, Y0 = 20, Y1 = 188;

    function render() {
      const C = parseFloat(cIn.value);
      const sw = swIn.checked;
      cOut.textContent = C.toFixed(1);
      const growDimers = KON * C - KOFF;               // dimers per s
      const g = growDimers / DIMERS_PER_UM;            // µm per s
      const s = SHORT_DIMERS / DIMERS_PER_UM;          // µm per s
      const fc = CAT_AT_10 * (10 / C);                 // sketch only
      const rand = rng(seed);

      const ts: number[] = [0], ls: number[] = [L0];
      const marks: { t: number; l: number; kind: 'cat' | 'res' }[] = [];
      let L = L0, growing = true, nCat = 0, nRes = 0;
      let gainSum = 0, gainT = 0, lossSum = 0, lossT = 0, shortT = 0;
      for (let t = DT; t <= TMAX + 1e-9; t += DT) {
        if (growing) {
          L += g * DT; gainSum += g * DT; gainT += DT;
          if (sw && rand() < fc * DT) { growing = false; nCat++; marks.push({ t, l: L, kind: 'cat' }); }
        } else {
          shortT += DT;
          if (L - s * DT <= 0) { L = 0; growing = true; }            // back at the seed: growth restarts (sketch)
          else {
            L -= s * DT; lossSum += s * DT; lossT += DT;
            if (rand() < RESCUE * DT) { growing = true; nRes++; marks.push({ t, l: L, kind: 'res' }); }
          }
        }
        ts.push(t); ls.push(L);
      }

      // axes
      const lmax = Math.max(...ls);
      const step = lmax <= 12 ? 2 : lmax <= 30 ? 5 : 10;
      const ymax = Math.max(6, Math.ceil((lmax * 1.05) / step) * step);
      const px = (t: number) => X0 + (t / TMAX) * (X1 - X0);
      const py = (l: number) => Y1 - (l / ymax) * (Y1 - Y0);
      plot.replaceChildren();
      plot.appendChild(el('line', { x1: X0, y1: Y0, x2: X0, y2: Y1, stroke: INK, 'stroke-width': 1 }));
      plot.appendChild(el('line', { x1: X0, y1: Y1, x2: X1, y2: Y1, stroke: INK, 'stroke-width': 1 }));
      for (let v = 0; v <= ymax + 1e-9; v += step) {
        plot.appendChild(el('line', { x1: X0, y1: py(v), x2: X1, y2: py(v), stroke: FAINT, 'stroke-width': 0.5, 'stroke-dasharray': '2 3' }));
        const tx = el('text', { x: X0 - 4, y: py(v) + 3, 'text-anchor': 'end', 'font-size': 9, fill: INK }); tx.textContent = String(v); plot.appendChild(tx);
      }
      for (let t = 0; t <= TMAX; t += 100) {
        plot.appendChild(el('line', { x1: px(t), y1: Y1, x2: px(t), y2: Y1 + 3, stroke: INK, 'stroke-width': 1 }));
        const tx = el('text', { x: px(t), y: Y1 + 14, 'text-anchor': 'middle', 'font-size': 9, fill: INK }); tx.textContent = String(t); plot.appendChild(tx);
      }
      const xl = el('text', { x: (X0 + X1) / 2, y: Y1 + 27, 'text-anchor': 'middle', 'font-size': 10, fill: INK }); xl.textContent = 'time (s)'; plot.appendChild(xl);
      const yl = el('text', { x: X0 - 2, y: Y0 - 7, 'text-anchor': 'start', 'font-size': 10, fill: INK }); yl.textContent = 'length from seed (µm)'; plot.appendChild(yl);
      let d = '';
      for (let i = 0; i < ts.length; i++) d += (i ? 'L' : 'M') + px(ts[i]).toFixed(1) + ' ' + py(ls[i]).toFixed(1) + ' ';
      plot.appendChild(el('path', { d: d.trim(), fill: 'none', stroke: ACCENT, 'stroke-width': 1.8, 'stroke-linejoin': 'round' }));
      for (const m of marks) plot.appendChild(el('circle', { cx: px(m.t), cy: py(m.l), r: 3.6, fill: m.kind === 'cat' ? ORANGE : '#fff', stroke: m.kind === 'cat' ? ORANGE : ACCENT, 'stroke-width': 1.6 }));
      // legend below the axis label
      plot.appendChild(el('circle', { cx: X0 + 4, cy: 238, r: 3.6, fill: ORANGE, stroke: ORANGE, 'stroke-width': 1.6 }));
      const l1 = el('text', { x: X0 + 12, y: 241, 'font-size': 9, fill: INK }); l1.textContent = 'catastrophe'; plot.appendChild(l1);
      plot.appendChild(el('circle', { cx: X0 + 94, cy: 238, r: 3.6, fill: '#fff', stroke: ACCENT, 'stroke-width': 1.6 }));
      const l2 = el('text', { x: X0 + 102, y: 241, 'font-size': 9, fill: INK }); l2.textContent = 'rescue'; plot.appendChild(l2);
      const l3 = el('text', { x: X0, y: 256, 'font-size': 9, fill: INK }); l3.textContent = 'sketch: starts at 2 µm; growth restarts at the seed'; plot.appendChild(l3);

      // readouts
      const gUmMin = g * 60, sUmMin = s * 60;
      rExp.textContent = `${growDimers.toFixed(1)} dimers/s = ${gUmMin.toFixed(2)} µm/min`;
      const obsG = gainT > 0 ? (gainSum / gainT) * 60 : NaN;
      rObs.textContent = isNaN(obsG) ? '–' : `${obsG.toFixed(2)} µm/min`;
      rCatSet.textContent = sw ? `${(fc * 60).toFixed(2)} per min` : 'off';
      rCatObs.textContent = !sw ? 'off' : `${nCat} in ${gainT.toFixed(0)} s = ${gainT > 0 ? ((nCat / gainT) * 60).toFixed(2) : '–'} per min`;
      rShort.textContent = `${sUmMin.toFixed(1)} µm/min`;
      rShortObs.textContent = lossT > 0 ? `${((lossSum / lossT) * 60).toFixed(1)} µm/min` : 'none shortened';

      // status
      const net = `At ${C.toFixed(1)} µM the growing end adds (8.9)(${C.toFixed(1)}) − 44 = ${growDimers.toFixed(1)} dimers per second, ${gUmMin.toFixed(2)} µm per min at 1,625 dimers per µm.`;
      if (!sw) {
        why.textContent = `${net} With catastrophe and rescue off, the end only grows, so the trace is a straight line whose slope matches the expected speed. Turn them on to see switching (frequencies invented for this sketch).`;
      } else if (nCat === 0) {
        why.textContent = `${net} No catastrophe happened in this ${TMAX} s run, so the end only grew. Press Resample: the same rule can give a different trace.`;
      } else {
        const ratio = sUmMin / gUmMin;
        why.textContent = `${net} The end suffered ${nCat} catastrophe${nCat > 1 ? 's' : ''} and ${nRes} rescue${nRes === 1 ? '' : 's'} by chance. Shortening is 733 dimers per second, about ${sUmMin.toFixed(0)} µm per min, ${ratio.toFixed(0)} times faster than growth at this concentration, and does not change over this range.`;
      }
    }
    cIn.addEventListener('input', render);
    swIn.addEventListener('change', render);
    btn.addEventListener('click', () => { seed = (Math.random() * 4294967296) >>> 0; render(); });
    render();
  });
</script>

<style>
  .dit { padding: var(--ddp-space-3) var(--ddp-space-4) var(--ddp-space-4); margin: var(--ddp-space-5) 0; }
  .dit-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem; font-weight: 600; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); margin-bottom: var(--ddp-space-3); }
  .dit-chip { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 400; color: var(--ddp-color-muted); }
  .dit-svg { display: block; width: 100%; max-width: 560px; margin: 0 auto; height: auto; background: #fff; border: 1px solid var(--ddp-color-line); border-radius: 6px; }
  .dit-controls { display: grid; grid-template-columns: 1fr; gap: var(--ddp-space-2); margin: var(--ddp-space-3) 0 var(--ddp-space-2); align-items: center; }
  @media (min-width: 640px) { .dit-controls { grid-template-columns: 2fr 1.4fr auto; gap: var(--ddp-space-4); } }
  .dit-slabel { display: flex; flex-direction: column; gap: 0.1rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .dit-slabel small { font-size: inherit; color: var(--ddp-color-muted); }
  .dit-slabel em { font-style: normal; font-weight: 700; color: var(--ddp-color-accent); font-family: var(--ddp-font-mono); }
  .dit-slabel input { accent-color: var(--ddp-color-accent); }
  .dit-check { display: flex; align-items: center; gap: 0.4rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .dit-check input { accent-color: var(--ddp-color-accent); }
  .dit-btn { font: inherit; font-size: var(--ddp-text-xs); padding: 0.4rem 0.8rem; border: 1px solid var(--ddp-color-accent); background: #fff; color: var(--ddp-color-accent); border-radius: 6px; cursor: pointer; }
  .dit-btn:hover, .dit-btn:focus-visible { background: color-mix(in srgb, var(--ddp-color-accent) 10%, #fff); }
  .dit-readout { display: grid; grid-template-columns: 1fr; gap: var(--ddp-space-2); margin: var(--ddp-space-2) 0; padding: var(--ddp-space-2) var(--ddp-space-3); background: color-mix(in srgb, var(--ddp-color-accent) 8%, transparent); border-radius: 6px; }
  @media (min-width: 640px) { .dit-readout { grid-template-columns: 1fr 1fr; } }
  .dit-readout div { display: flex; flex-direction: column; gap: 0.1rem; }
  .dit-readout dt { font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .dit-readout dd { margin: 0; font-family: var(--ddp-font-mono); font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); font-weight: 700; }
  .dit-why { margin: 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); line-height: 1.5; min-height: 5em; }
  .dit-foot { margin: var(--ddp-space-3) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); border-left: 3px solid var(--ddp-color-secondary); padding-left: 0.55rem; }
</style>
