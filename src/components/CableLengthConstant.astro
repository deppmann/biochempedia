---
/**
 * CableLengthConstant — passive spread along a uniform cable. A steady -10 mV
 * deflection is held at x = 0 of an infinite passive cable; V(x) = V0 * exp(-x/lambda).
 * Relative leak and relative diameter move lambda (lambda = 0.5 mm * sqrt(diameter / leak),
 * from the lesson's rules), and a measuring cursor lets the learner read lambda off the
 * curve where V = 37% of V0. Self-contained vanilla-TS Astro island. Original.
 */
---

<figure class="clc card" data-clc>
  <figcaption class="clc-head">Length constant — how far a steady deflection spreads<span class="clc-chip">⚙ original · interactive</span></figcaption>

  <svg class="clc-svg" viewBox="0 0 340 262" role="img" aria-label="A cable drawn as a tube with an electrode at its left end, above a plot of steady voltage deflection against distance with a 37 percent line and a movable measuring cursor" data-plot></svg>

  <div class="clc-controls">
    <label class="clc-slabel"><span>Uniform membrane leak per unit area, relative to the lesson’s cable <em data-out="leak">1</em>×</span>
      <input type="range" data-in="leak" min="0.5" max="4" step="0.125" value="1" />
    </label>
    <label class="clc-slabel"><span>Diameter, relative to the lesson’s cable <em data-out="diam">1</em>×</span>
      <input type="range" data-in="diam" min="0.5" max="4" step="0.25" value="1" />
    </label>
    <label class="clc-slabel clc-wide"><span>Measuring cursor: distance from the electrode <em data-out="x">0.50</em> mm (drag it on the plot, or use this slider)</span>
      <input type="range" data-in="x" min="0" max="2" step="0.01" value="0.5" />
    </label>
  </div>

  <div class="clc-presets" role="group" aria-label="Set the cable to a case from the lesson">
    <button type="button" class="clc-btn" data-preset="1,1">Part 4 cable</button>
    <button type="button" class="clc-btn" data-preset="2,1">Part 5: leak doubled</button>
    <button type="button" class="clc-btn" data-preset="0.625,1">Design problem: leak 0.625×</button>
    <button type="button" class="clc-btn" data-preset="1,4">Diameter 4×</button>
  </div>

  <dl class="clc-readout">
    <div><dt>Cursor reading</dt><dd data-r-read>—</dd></div>
    <div><dt>Lesson’s arithmetic</dt><dd data-r-math>—</dd></div>
    <div><dt>λ from the rule (relative to 0.5 mm)</dt><dd data-r-lam>—</dd></div>
  </dl>
  <p class="clc-why" data-why role="status">—</p>
  <p class="clc-assume">In this sketch: infinite uniform passive cable, steady state only, voltage held at the source, no active channels; leak (per unit area; cytoplasm unchanged) and diameter in relative units, the lesson’s cable (λ = 0.5 mm) is 1× for both.</p>

  <p class="clc-foot">V(x) = V0 × e^(−x/λ): at one λ the deflection is 37% of its value at the source, smaller, not gone. Leakier or narrower shortens λ; with membrane and cytoplasm unchanged, λ grows as the square root of diameter.</p>
</figure>

<script>
  const NS = 'http://www.w3.org/2000/svg';
  const ACCENT = '#0e7c86', ORANGE = '#e57200', INK = '#4b4b55', FAINT = '#b9b9c2';
  function el(name: string, attrs: Record<string, string | number>): SVGElement {
    const e = document.createElementNS(NS, name);
    for (const k in attrs) e.setAttribute(k, String(attrs[k]));
    return e;
  }
  function txt(parent: SVGElement, attrs: Record<string, string | number>, s: string) {
    const t = el('text', attrs); t.textContent = s; parent.appendChild(t); return t;
  }
  document.querySelectorAll<HTMLElement>('[data-clc]').forEach((root) => {
    const plot = root.querySelector<SVGSVGElement>('[data-plot]')!;
    const inp = (n: string) => root.querySelector<HTMLInputElement>('[data-in="' + n + '"]')!;
    const out = (n: string) => root.querySelector<HTMLElement>('[data-out="' + n + '"]')!;
    const leakIn = inp('leak'), diamIn = inp('diam'), xIn = inp('x');
    const leakOut = out('leak'), diamOut = out('diam'), xOut = out('x');
    const rRead = root.querySelector<HTMLElement>('[data-r-read]')!;
    const rMath = root.querySelector<HTMLElement>('[data-r-math]')!;
    const rLam = root.querySelector<HTMLElement>('[data-r-lam]')!;
    const why = root.querySelector<HTMLElement>('[data-why]')!;

    const V0 = -10, LAM0 = 0.5, XMAX = 2;
    const X0 = 52, X1 = 326, Y0 = 118, Y1 = 214; // plot box; deflection 0 at top, -10 mV at bottom
    const px = (x: number) => X0 + (x / XMAX) * (X1 - X0);
    const py = (v: number) => Y0 + (v / V0) * (Y1 - Y0);
    const TUBE_Y = 50; // tube centre line

    function lambdaOf(leak: number, diam: number) { return LAM0 * Math.sqrt(diam / leak); }
    const volt = (x: number, lam: number) => V0 * Math.exp(-x / lam);
    const f2 = (v: number) => v.toFixed(2);
    const mv = (v: number) => (Math.abs(v) < 0.005 ? 'under 0.01 mV' : (v < 0 ? '−' : '') + Math.abs(v).toFixed(2) + ' mV');
    const pct = (q: number) => (q < 0.005 ? 'under 1%' : (q * 100).toFixed(0) + '%');

    let dragging = false;

    function render() {
      const leak = parseFloat(leakIn.value), diam = parseFloat(diamIn.value), x = parseFloat(xIn.value);
      const lam = lambdaOf(leak, diam);
      leakOut.textContent = String(leak);
      diamOut.textContent = String(diam);
      xOut.textContent = f2(x);
      xIn.setAttribute('aria-valuetext', f2(x) + ' millimetres');
      plot.replaceChildren();

      // --- tube with electrode (thickness is relative, not to scale)
      const th = 6 + diam * 6; // 9 .. 30 px
      const colorAt = (xx: number) => Math.exp(-xx / lam);
      const defs = el('defs', {});
      const grad = el('linearGradient', { id: 'clcGrad', x1: 0, y1: 0, x2: 1, y2: 0 });
      for (let i = 0; i <= 20; i++) {
        const xx = (i / 20) * XMAX;
        grad.appendChild(el('stop', { offset: (i / 20 * 100) + '%', 'stop-color': ACCENT, 'stop-opacity': (0.12 + 0.78 * colorAt(xx)).toFixed(3) }));
      }
      defs.appendChild(grad); plot.appendChild(defs);
      plot.appendChild(el('rect', { x: X0, y: TUBE_Y - th / 2, width: X1 - X0, height: th, rx: 3, fill: 'url(#clcGrad)', stroke: ACCENT, 'stroke-width': 1.2 }));
      plot.appendChild(el('line', { x1: X0 - 22, y1: TUBE_Y, x2: X0, y2: TUBE_Y, stroke: INK, 'stroke-width': 2 }));
      plot.appendChild(el('path', { d: `M${X0 - 24} ${TUBE_Y - 5} L${X0 - 22} ${TUBE_Y} L${X0 - 24} ${TUBE_Y + 5}`, fill: 'none', stroke: INK, 'stroke-width': 1.2 }));
      txt(plot, { x: 2, y: 14, 'font-size': 9, fill: INK, 'text-anchor': 'start' }, 'electrode holds −10 mV');
      txt(plot, { x: X1, y: 16, 'font-size': 9, fill: INK, 'text-anchor': 'end' }, 'cable continues past 2 mm (infinite)');
      txt(plot, { x: X1, y: 28, 'font-size': 9, fill: INK, 'text-anchor': 'end' }, 'shading = size of deflection; thickness not to scale');
      txt(plot, { x: X0 + 2, y: 76,'font-size': 9, fill: INK, 'text-anchor': 'start' }, 'x = 0');

      // --- axes
      plot.appendChild(el('line', { x1: X0, y1: Y0, x2: X0, y2: Y1, stroke: INK, 'stroke-width': 1 }));
      plot.appendChild(el('line', { x1: X0, y1: Y0, x2: X1, y2: Y0, stroke: INK, 'stroke-width': 1 }));
      for (const v of [0, -5, -10]) {
        plot.appendChild(el('line', { x1: X0 - 3, y1: py(v), x2: X0, y2: py(v), stroke: INK, 'stroke-width': 1 }));
        txt(plot, { x: X0 - 5, y: py(v) + 3, 'text-anchor': 'end', 'font-size': 9, fill: INK }, String(v).replace('-', '−'));
      }
      txt(plot, { x: 2, y: Y0 - 20, 'font-size': 9, fill: INK }, 'deflection V(x) from rest (mV)');
      for (const xx of [0, 0.5, 1, 1.5, 2]) {
        plot.appendChild(el('line', { x1: px(xx), y1: Y0, x2: px(xx), y2: Y0 - 3, stroke: INK, 'stroke-width': 1 }));
        txt(plot, { x: px(xx), y: Y0 - 6, 'text-anchor': xx === 0 ? 'start' : xx === 2 ? 'end' : 'middle', 'font-size': 9, fill: INK }, xx === 0 ? '0' : f2(xx).replace(/0$/, ''));
      }
      txt(plot, { x: (X0 + X1) / 2, y: Y1 + 14, 'text-anchor': 'middle', 'font-size': 10, fill: INK }, 'distance x from the electrode (mm)');

      // --- 37% line
      const v37 = V0 * Math.exp(-1);
      plot.appendChild(el('line', { x1: X0, y1: py(v37), x2: X1, y2: py(v37), stroke: ORANGE, 'stroke-width': 1.1, 'stroke-dasharray': '4 3' }));
      if (lam >= LAM0) txt(plot, { x: X0 + 4, y: py(v37) - 3, 'text-anchor': 'start', 'font-size': 9, fill: ORANGE, 'font-weight': 700 }, '37% of V0');
      else txt(plot, { x: X1, y: py(v37) + 11, 'text-anchor': 'end', 'font-size': 9, fill: ORANGE, 'font-weight': 700 }, '37% of V0 = −3.68 mV');

      // --- reference: the lesson's cable (ghost) when changed
      const curve = (l: number) => {
        let d = '';
        for (let i = 0; i <= 100; i++) { const xx = (i / 100) * XMAX; d += (i ? 'L' : 'M') + px(xx).toFixed(1) + ' ' + py(volt(xx, l)).toFixed(1) + ' '; }
        return d.trim();
      };
      const changed = leak !== 1 || diam !== 1;
      if (changed) plot.appendChild(el('path', { d: curve(LAM0), fill: 'none', stroke: FAINT, 'stroke-width': 1.6, 'stroke-dasharray': '4 3' }));
      plot.appendChild(el('path', { d: curve(lam), fill: 'none', stroke: ACCENT, 'stroke-width': 2.6 }));
      // legend (bottom right, clear of the decaying curve)
      const LX = X1 - 112, LY = Y1 - 22;
      plot.appendChild(el('line', { x1: LX, y1: LY, x2: LX + 16, y2: LY, stroke: ACCENT, 'stroke-width': 2.6 }));
      txt(plot, { x: LX + 20, y: LY + 3, 'font-size': 9, fill: INK }, 'this cable');
      if (changed) {
        plot.appendChild(el('line', { x1: LX, y1: LY + 12, x2: LX + 16, y2: LY + 12, stroke: FAINT, 'stroke-width': 1.6, 'stroke-dasharray': '4 3' }));
        txt(plot, { x: LX + 20, y: LY + 15, 'font-size': 9, fill: INK }, 'lesson’s cable');
      }

      // --- cursor
      const cx = px(x), v = volt(x, lam), cy = py(v);
      plot.appendChild(el('line', { x1: cx, y1: 42, x2: cx, y2: Y1, stroke: INK, 'stroke-width': 1.2, 'stroke-dasharray': '2 2' }));
      plot.appendChild(el('line', { x1: X0, y1: cy, x2: cx, y2: cy, stroke: INK, 'stroke-width': 0.8, 'stroke-dasharray': '2 2' }));
      const hit = el('circle', { cx, cy, r: 16, fill: 'transparent', style: 'cursor:ew-resize;touch-action:none', 'data-hit': '1' });
      plot.appendChild(el('circle', { cx, cy, r: 5.5, fill: '#fff', stroke: INK, 'stroke-width': 2 }));
      plot.appendChild(hit);

      // --- readouts
      const ratio = v / V0;
      const near = Math.abs(ratio - Math.exp(-1)) <= 0.02;
      rRead.textContent = `x = ${f2(x)} mm: V = ${mv(v)}, ${pct(ratio)} of V0`;
      rMath.textContent = x === 0 ? 'V(0) = V0 × e^0 = −10 mV' : `V = −10 × e^(−${f2(x)}/${lam.toFixed(3)}) = ${mv(v)}`;
      rLam.textContent = `λ = 0.5 × √(${diam} / ${leak}) = ${lam.toFixed(3)} mm (${(lam / LAM0).toFixed(2)}× the lesson’s λ)`;

      // --- status
      let s: string;
      if (x === 0) s = 'At the electrode the deflection is V0 = −10 mV whatever λ is, because the voltage is held there. ';
      else if (near) s = `The cursor is where the deflection has fallen to about 37% of V0 (${mv(v)}), at ${f2(x)} mm: that distance is within a few percent of λ (the rule gives ${lam.toFixed(3)} mm). `;
      else if (ratio > Math.exp(-1)) s = `At ${f2(x)} mm the deflection is still ${pct(ratio)} of V0, above 37%, so λ is farther out than the cursor. `;
      else s = `At ${f2(x)} mm the deflection is down to ${pct(ratio)} of V0, below 37%, so λ is nearer the electrode than the cursor, yet the deflection is smaller, not gone. `;
      if (!changed) s += 'This is the lesson’s cable, λ = 0.5 mm: −3.68 mV at 0.5 mm and −1.35 mV at 1 mm. ';
      else {
        const parts: string[] = [];
        if (leak !== 1) parts.push(leak > 1 ? 'a leakier membrane' : 'a less leaky membrane');
        if (diam !== 1) parts.push(diam > 1 ? 'a wider cable (membrane and cytoplasm unchanged)' : 'a narrower core');
        s += `With ${parts.join(' and ')}, λ is ${lam.toFixed(3)} mm, ${Math.abs(lam - LAM0) < 1e-9 ? 'the same as the lesson’s λ (the two changes cancel)' : (lam / LAM0).toFixed(2) + '× the lesson’s λ'}. `;
        if (leak === 2 && diam === 1) s += 'This is part 5: λ = 0.5 / √2 = 0.354 mm; the leakier cell reaches less far. ';
        if (leak === 0.625 && diam === 1) s += 'This is the design problem’s closed leak (Rin up 1.6 times), if that leak was uniform over the dendrites: λ rises by √1.6, about 1.26 times. ';
        if (leak === 1 && diam === 4) s += 'Four times the diameter doubles λ to 1.0 mm. ';
      }
      s += 'Capacitance does not set the shape in space, only how fast the steady state arrives.';
      why.textContent = s;
    }

    function xFromEvent(ev: PointerEvent) {
      const r = plot.getBoundingClientRect();
      const svgX = ((ev.clientX - r.left) / r.width) * 340;
      const xx = ((svgX - X0) / (X1 - X0)) * XMAX;
      return Math.max(0, Math.min(XMAX, Math.round(xx * 100) / 100));
    }
    plot.addEventListener('pointerdown', (ev) => {
      const t = ev.target as Element;
      if (t.getAttribute('data-hit')) { dragging = true; plot.setPointerCapture(ev.pointerId); ev.preventDefault(); }
    });
    plot.addEventListener('pointermove', (ev) => {
      if (!dragging) return;
      xIn.value = String(xFromEvent(ev)); render();
    });
    const stop = () => { dragging = false; };
    plot.addEventListener('pointerup', stop);
    plot.addEventListener('pointercancel', stop);

    [leakIn, diamIn, xIn].forEach((s) => s.addEventListener('input', render));
    root.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach((b) => b.addEventListener('click', () => {
      const [l, d] = (b.getAttribute('data-preset') as string).split(',');
      leakIn.value = l; diamIn.value = d; render();
    }));
    render();
  });
</script>

<style>
  .clc { padding: var(--ddp-space-3) var(--ddp-space-4) var(--ddp-space-4); margin: var(--ddp-space-5) 0; }
  .clc-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem; font-weight: 600; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); margin-bottom: var(--ddp-space-3); }
  .clc-chip { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 400; color: var(--ddp-color-muted); }
  .clc-svg { display: block; width: 100%; max-width: 560px; margin: 0 auto; height: auto; background: #fff; border: 1px solid var(--ddp-color-line); border-radius: 6px; }
  .clc-controls { display: grid; grid-template-columns: 1fr 1fr; gap: var(--ddp-space-2) var(--ddp-space-4); margin: var(--ddp-space-3) 0 var(--ddp-space-2); }
  .clc-wide { grid-column: 1 / -1; }
  .clc-slabel { display: flex; flex-direction: column; gap: 0.1rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .clc-slabel em { font-style: normal; font-weight: 700; color: var(--ddp-color-accent); font-family: var(--ddp-font-mono); }
  .clc-slabel input { accent-color: var(--ddp-color-accent); }
  .clc-presets { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: var(--ddp-space-2) 0; }
  .clc-btn { font: inherit; font-size: var(--ddp-text-xs); padding: 0.3rem 0.6rem; border: 1px solid var(--ddp-color-line); border-radius: 6px; background: #fff; color: var(--ddp-color-primary); cursor: pointer; }
  .clc-btn:hover, .clc-btn:focus-visible { border-color: var(--ddp-color-accent); outline: 2px solid var(--ddp-color-accent); outline-offset: 1px; }
  .clc-readout { display: grid; grid-template-columns: 1fr; gap: var(--ddp-space-2); margin: var(--ddp-space-2) 0; padding: var(--ddp-space-2) var(--ddp-space-3); background: color-mix(in srgb, var(--ddp-color-accent) 8%, transparent); border-radius: 6px; }
  .clc-readout div { display: flex; flex-direction: column; gap: 0.1rem; }
  .clc-readout dt { font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .clc-readout dd { margin: 0; font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); color: var(--ddp-color-primary); font-weight: 700; overflow-wrap: anywhere; }
  .clc-why { margin: 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); line-height: 1.5; min-height: 6em; }
  .clc-assume { margin: var(--ddp-space-2) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .clc-foot { margin: var(--ddp-space-3) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); border-left: 3px solid var(--ddp-color-secondary); padding-left: 0.55rem; }
  @media (max-width: 480px) { .clc-controls { grid-template-columns: 1fr; } }
</style>
