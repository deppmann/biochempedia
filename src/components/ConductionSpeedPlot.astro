---
/**
 * ConductionSpeedPlot — how conduction velocity scales with diameter, with and without
 * myelin. One slider (diameter) and one switch (myelin). The lesson's rules: in unmyelinated
 * axons velocity rises roughly with the square root of diameter; in myelinated fibres roughly
 * in proportion to diameter, about 6 m/s per micrometre of fibre diameter for large mammalian
 * fibres (Hursh, 1939, as quoted in the lesson), up to around 100 m/s, while thin
 * unmyelinated fibres conduct at about a metre per second or less. The lesson gives no
 * coefficient for bare axons, so that curve is a shape-only sketch and carries no m/s values.
 * Nothing is drawn as a molecular structure. Self-contained vanilla-TS Astro island. Original.
 */
---

<figure class="csp card" data-csp>
  <figcaption class="csp-head">Conduction speed: diameter and myelin<span class="csp-chip">⚙ original · interactive</span></figcaption>

  <svg class="csp-svg" viewBox="0 0 360 230" role="img" aria-label="Plot of conduction velocity against diameter: a straight line for myelinated fibres and a flatter square-root curve for unmyelinated axons" data-plot></svg>

  <div class="csp-controls">
    <label class="csp-slabel"><span>Fibre diameter (µm; axon diameter if bare) <em data-out="d">4</em></span>
      <input type="range" data-in="d" min="1" max="16" step="1" value="4" />
    </label>
    <label class="csp-check"><input type="checkbox" data-in="myelin" /> wrapped in myelin</label>
  </div>

  <dl class="csp-readout">
    <div><dt data-r-label>Unmyelinated axon</dt><dd data-r-val>rises with √diameter</dd></div>
    <div><dt>Doubling the diameter multiplies velocity by about</dt><dd data-r-dbl>1.4</dd></div>
  </dl>
  <p class="csp-why" data-why role="status"></p>

  <p class="csp-foot">Rule to keep: velocity rises roughly with the square root of diameter in a bare axon and roughly in proportion to diameter once it is myelinated, so the gap widens as diameter grows. The bare-axon curve is a sketch in arbitrary units, not a measurement, and is not read against the m/s axis.</p>
</figure>

<script>
  const NS = 'http://www.w3.org/2000/svg';
  const ACCENT = '#0e7c86', ORANGE = '#e57200', INK = '#4b4b55', FAINT = '#b9b9c2';
  function el(name: string, attrs: Record<string, string | number>, text?: string): SVGElement {
    const e = document.createElementNS(NS, name);
    for (const k in attrs) e.setAttribute(k, String(attrs[k]));
    if (text !== undefined) e.textContent = text;
    return e;
  }
  document.querySelectorAll<HTMLElement>('[data-csp]').forEach((root) => {
    const plot = root.querySelector<SVGSVGElement>('[data-plot]')!;
    const dIn = root.querySelector<HTMLInputElement>('[data-in="d"]')!;
    const mIn = root.querySelector<HTMLInputElement>('[data-in="myelin"]')!;
    const dOut = root.querySelector<HTMLElement>('[data-out="d"]')!;
    const rLabel = root.querySelector<HTMLElement>('[data-r-label]')!;
    const rVal = root.querySelector<HTMLElement>('[data-r-val]')!;
    const rDbl = root.querySelector<HTMLElement>('[data-r-dbl]')!;
    const why = root.querySelector<HTMLElement>('[data-why]')!;

    const X0 = 46, X1 = 346, Y0 = 22, Y1 = 188, DMAX = 16, VMAX = 100;
    const px = (d: number) => X0 + (d / DMAX) * (X1 - X0);
    const py = (v: number) => Y1 - (v / VMAX) * (Y1 - Y0);
    // Myelinated: the lesson's estimate, 6 m/s per µm of fibre diameter.
    const vMy = (d: number) => 6 * d;
    // Bare: shape only (square root of diameter). Its height on the plot is arbitrary.
    const SKETCH_K = 1;
    const vBare = (d: number) => SKETCH_K * Math.sqrt(d);

    function path(f: (d: number) => number) {
      let s = '';
      for (let d = 0; d <= DMAX + 1e-9; d += 0.25) s += (d === 0 ? 'M' : 'L') + px(d).toFixed(1) + ' ' + py(f(d)).toFixed(1) + ' ';
      return s.trim();
    }

    function render() {
      const d = parseInt(dIn.value, 10);
      const my = mIn.checked;
      dOut.textContent = String(d);
      plot.replaceChildren();

      // axes
      plot.appendChild(el('line', { x1: X0, y1: Y0, x2: X0, y2: Y1, stroke: INK, 'stroke-width': 1 }));
      plot.appendChild(el('line', { x1: X0, y1: Y1, x2: X1, y2: Y1, stroke: INK, 'stroke-width': 1 }));
      for (const v of [0, 50, 100]) {
        plot.appendChild(el('line', { x1: X0, y1: py(v), x2: X1, y2: py(v), stroke: FAINT, 'stroke-width': 0.7, 'stroke-dasharray': '2 3' }));
        plot.appendChild(el('text', { x: X0 - 4, y: py(v) + 3, 'text-anchor': 'end', 'font-size': 9, fill: INK }, String(v)));
      }
      for (const t of [0, 4, 8, 12, 16]) {
        plot.appendChild(el('line', { x1: px(t), y1: Y1, x2: px(t), y2: Y1 + 3, stroke: INK, 'stroke-width': 1 }));
        plot.appendChild(el('text', { x: px(t), y: Y1 + 14, 'text-anchor': 'middle', 'font-size': 9, fill: INK }, String(t)));
      }
      plot.appendChild(el('text', { x: (X0 + X1) / 2, y: Y1 + 28, 'text-anchor': 'middle', 'font-size': 10, fill: INK }, 'diameter (µm)'));
      plot.appendChild(el('text', { x: X0 - 2, y: Y0 - 9, 'text-anchor': 'start', 'font-size': 10, fill: INK }, 'conduction velocity (m/s)'));

      // curves: the chosen condition bold, the other faint for comparison
      const bareStyle: Record<string, string | number> = my ? { stroke: FAINT, 'stroke-width': 1.6, 'stroke-dasharray': '4 3' } : { stroke: ORANGE, 'stroke-width': 2.8 };
      const myStyle: Record<string, string | number> = my ? { stroke: ACCENT, 'stroke-width': 2.8 } : { stroke: FAINT, 'stroke-width': 1.6, 'stroke-dasharray': '4 3' };
      plot.appendChild(el('path', { d: path(vBare), fill: 'none', ...bareStyle }));
      plot.appendChild(el('path', { d: path(vMy), fill: 'none', ...myStyle }));

      // direct labels
      plot.appendChild(el('text', { x: px(8.5), y: py(vMy(8.5)) - 8, 'text-anchor': 'end', 'font-size': 9, 'font-weight': 700, fill: my ? ACCENT : INK }, 'myelinated: about ∝ D'));
      plot.appendChild(el('text', { x: X1 - 4, y: py(vBare(16)) - 21, 'text-anchor': 'end', 'font-size': 9, 'font-weight': 700, fill: my ? INK : ORANGE }, 'unmyelinated: about ∝ √D'));
      plot.appendChild(el('text', { x: X1 - 4, y: py(vBare(16)) - 10, 'text-anchor': 'end', 'font-size': 9, fill: INK }, '(arbitrary scale, shape only; not m/s)'));

      // marker at chosen diameter
      const v = my ? vMy(d) : vBare(d);
      plot.appendChild(el('line', { x1: px(d), y1: py(v), x2: px(d), y2: Y1, stroke: my ? ACCENT : ORANGE, 'stroke-width': 1.2, 'stroke-dasharray': '3 2' }));
      plot.appendChild(el('circle', { cx: px(d), cy: py(v), r: 4.5, fill: my ? ACCENT : ORANGE }));

      // readouts
      if (my) {
        rLabel.textContent = 'Myelinated fibre, lesson estimate (6 m/s per µm)';
        rVal.textContent = `about ${vMy(d)} m/s`;
        rDbl.textContent = '2';
      } else {
        rLabel.textContent = 'Unmyelinated axon (no coefficient in the lesson)';
        rVal.textContent = 'rises with √diameter';
        rDbl.textContent = '1.4';
      }

      // status sentence: every statement is a lesson rule
      const cmp = `Doubling the diameter multiplies velocity by about ${my ? '2' : '1.4'}`;
      if (my) {
        why.textContent = `Myelin stacks membranes in series and the signal is regenerated only at the nodes; velocity rises roughly in proportion to diameter. The lesson's estimate for large mammalian fibres, 6 m/s per µm, extended here to ${d} µm, gives about ${vMy(d)} m/s${vMy(d) > 90 ? ', near the top of the range, up to around 100 m/s' : ''}. ${cmp}.`;
      } else {
        why.textContent = `A bare axon leaks current and must rebuild the action potential on every patch it reaches, so velocity rises only roughly with the square root of diameter. Thin unmyelinated fibres conduct at about a metre per second or less; the lesson gives no coefficient, so the curve shows shape only. ${cmp}.`;
      }
    }
    dIn.addEventListener('input', render);
    mIn.addEventListener('change', render);
    render();
  });
</script>

<style>
  .csp { padding: var(--ddp-space-3) var(--ddp-space-4) var(--ddp-space-4); margin: var(--ddp-space-5) 0; }
  .csp-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem; font-weight: 600; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); margin-bottom: var(--ddp-space-3); }
  .csp-chip { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 400; color: var(--ddp-color-muted); }
  .csp-svg { display: block; width: 100%; max-width: 600px; margin: 0 auto; height: auto; background: #fff; border: 1px solid var(--ddp-color-line); border-radius: 6px; }
  .csp-controls { display: grid; grid-template-columns: 1fr 1fr; gap: var(--ddp-space-2) var(--ddp-space-4); align-items: end; margin: var(--ddp-space-3) 0 var(--ddp-space-2); }
  .csp-slabel { display: flex; flex-direction: column; gap: 0.1rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .csp-slabel em { font-style: normal; font-weight: 700; color: var(--ddp-color-accent); font-family: var(--ddp-font-mono); }
  .csp-slabel input, .csp-check input { accent-color: var(--ddp-color-accent); }
  .csp-check { font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); display: flex; gap: 0.4rem; align-items: center; }
  .csp-readout { display: grid; grid-template-columns: 1fr 1fr; gap: var(--ddp-space-2); margin: var(--ddp-space-2) 0; padding: var(--ddp-space-2) var(--ddp-space-3); background: color-mix(in srgb, var(--ddp-color-accent) 8%, transparent); border-radius: 6px; }
  .csp-readout div { display: flex; flex-direction: column; gap: 0.1rem; }
  .csp-readout dt { font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .csp-readout dd { margin: 0; font-family: var(--ddp-font-mono); font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); font-weight: 700; }
  .csp-why { margin: 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); line-height: 1.5; min-height: 5em; }
  .csp-foot { margin: var(--ddp-space-3) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); border-left: 3px solid var(--ddp-color-secondary); padding-left: 0.55rem; }
  @media (max-width: 520px) { .csp-controls, .csp-readout { grid-template-columns: 1fr; } }
</style>
