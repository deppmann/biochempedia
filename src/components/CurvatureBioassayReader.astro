---
/**
 * CurvatureBioassayReader — the worked problem of the plant-hormone lesson as a
 * sketch. A standard line (auxin concentration in agar versus curvature, 200
 * degrees per mg per L), a schematic decapitated oat coleoptile bending away from
 * an agar block, a tip-treatment panel, and the lesson's arithmetic. Original.
 */
---

<figure class="cba card" data-cba>
  <figcaption class="cba-head">Reading a curvature bioassay<span class="cba-chip">⚙ original · interactive</span></figcaption>

  <div class="cba-grid">
    <svg class="cba-svg" viewBox="0 0 340 250" role="img" aria-label="Standard line of curvature in degrees against auxin concentration in the agar block, with a cursor" data-plot></svg>
    <svg class="cba-svg" viewBox="0 0 340 356" role="img" aria-label="Schematic of cut oat coleoptile tips on agar blocks, and a decapitated coleoptile bending away from the block placed on one side" data-schem></svg>
  </div>

  <div class="cba-controls">
    <fieldset class="cba-fs">
      <legend>Block source</legend>
      <label><input type="radio" name="cba-src" value="lit" /> Split tips lit from one side: lit-half block</label>
      <label><input type="radio" name="cba-src" value="shaded" checked /> Split tips: shaded-half block</label>
      <label><input type="radio" name="cba-src" value="dark" /> Whole tips kept in the dark</label>
    </fieldset>
    <fieldset class="cba-fs">
      <legend>Hypothesis overlay</legend>
      <label><input type="radio" name="cba-hyp" value="moves" checked /> Light moves auxin to the shaded side</label>
      <label><input type="radio" name="cba-hyp" value="destroys" /> Light destroys auxin on the lit side</label>
    </fieldset>
    <label class="cba-slabel"><span>Curvature cursor <em data-out="cur">8</em> degrees <small>(drag it to read concentration off the line)</small></span>
      <input type="range" data-in="cur" min="0" max="24" step="1" value="8" />
    </label>
  </div>

  <dl class="cba-readout">
    <div><dt>Block on the coleoptile</dt><dd data-r-block></dd></div>
    <div><dt>Cursor reading</dt><dd data-r-cursor></dd></div>
    <div><dt>Shares of the split tip</dt><dd data-r-share></dd></div>
    <div><dt>Split total against dark total</dt><dd data-r-total></dd></div>
    <div class="cba-wide"><dt>Hypothesis overlay</dt><dd data-r-hyp></dd></div>
  </dl>

  <p class="cba-why" data-why role="status"></p>

  <p class="cba-foot">Rule to keep: auxin concentration (mg per L) = curvature (degrees) / 200 degrees per mg per L. In this sketch: illustrative numbers in the linear range, not data from a real experiment; equal block size and collection time; no auxin lost; the picture is a sketch of the logic, not to scale.</p>
</figure>

<script>
  const NS = 'http://www.w3.org/2000/svg';
  const ACCENT = '#0e7c86', ORANGE = '#e57200', INK = '#4b4b55', FAINT = '#b9b9c2', LIGHT = '#d9a400', GREEN = '#cfe6d3';
  const SLOPE = 200; // degrees per mg per L (lesson)
  const STANDARDS: Array<[number, number]> = [[0.02, 4], [0.04, 8], [0.08, 16]]; // mg per L, degrees (lesson)
  const TOP = 18; // largest curvature the lesson reads on this line
  const CURV = { lit: 6, shaded: 12, dark: 18 } as const; // degrees (lesson)
  type Src = keyof typeof CURV;
  const NAME: Record<Src, string> = { lit: 'lit-half block', shaded: 'shaded-half block', dark: 'block from whole tips kept in the dark' };

  function el(name: string, attrs: Record<string, string | number>): SVGElement {
    const e = document.createElementNS(NS, name);
    for (const k in attrs) e.setAttribute(k, String(attrs[k]));
    return e;
  }
  function txt(parent: Element, x: number, y: number, s: string, extra: Record<string, string | number> = {}): void {
    const t = el('text', Object.assign({ x, y, 'font-size': 10, fill: INK }, extra));
    t.textContent = s;
    parent.appendChild(t);
  }
  const c2 = (deg: number) => (deg / SLOPE).toFixed(3).replace(/0$/, '');

  document.querySelectorAll<HTMLElement>('[data-cba]').forEach((root) => {
    const plot = root.querySelector<SVGSVGElement>('[data-plot]');
    const schem = root.querySelector<SVGSVGElement>('[data-schem]');
    const curIn = root.querySelector<HTMLInputElement>('[data-in="cur"]');
    const curOut = root.querySelector<HTMLElement>('[data-out="cur"]');
    const rBlock = root.querySelector<HTMLElement>('[data-r-block]');
    const rCursor = root.querySelector<HTMLElement>('[data-r-cursor]');
    const rShare = root.querySelector<HTMLElement>('[data-r-share]');
    const rTotal = root.querySelector<HTMLElement>('[data-r-total]');
    const rHyp = root.querySelector<HTMLElement>('[data-r-hyp]');
    const why = root.querySelector<HTMLElement>('[data-why]');
    if (!plot || !schem || !curIn || !curOut || !rBlock || !rCursor || !rShare || !rTotal || !rHyp || !why) return;
    const srcRadios = Array.from(root.querySelectorAll<HTMLInputElement>('input[name="cba-src"]'));
    const hypRadios = Array.from(root.querySelectorAll<HTMLInputElement>('input[name="cba-hyp"]'));

    const X0 = 48, X1 = 326, Y0 = 14, Y1 = 198, CMAX = 0.12, DMAX = 24;
    const px = (c: number) => X0 + (c / CMAX) * (X1 - X0);
    const py = (d: number) => Y1 - (d / DMAX) * (Y1 - Y0);

    const getSrc = (): Src => {
      const r = srcRadios.find((x) => x.checked);
      return (r && (r.value === 'lit' || r.value === 'dark')) ? r.value : 'shaded';
    };
    const getHyp = (): 'moves' | 'destroys' => {
      const r = hypRadios.find((x) => x.checked);
      return r && r.value === 'destroys' ? 'destroys' : 'moves';
    };

    function drawPlot(src: Src, cur: number): void {
      if (!plot) return;
      plot.replaceChildren();
      plot.appendChild(el('line', { x1: X0, y1: Y0, x2: X0, y2: Y1, stroke: INK, 'stroke-width': 1 }));
      plot.appendChild(el('line', { x1: X0, y1: Y1, x2: X1, y2: Y1, stroke: INK, 'stroke-width': 1 }));
      for (let d = 0; d <= DMAX; d += 4) {
        plot.appendChild(el('line', { x1: X0 - 3, y1: py(d), x2: X0, y2: py(d), stroke: INK }));
        txt(plot, X0 - 6, py(d) + 3, String(d), { 'text-anchor': 'end' });
      }
      for (let k = 0; k <= 6; k++) {
        const c = k * 0.02;
        plot.appendChild(el('line', { x1: px(c), y1: Y1, x2: px(c), y2: Y1 + 3, stroke: INK }));
        txt(plot, px(c), Y1 + 14, c.toFixed(2), { 'text-anchor': 'middle' });
      }
      txt(plot, (X0 + X1) / 2, Y1 + 30, 'auxin in the agar block (mg per L)', { 'text-anchor': 'middle' });
      txt(plot, 12, (Y0 + Y1) / 2, 'curvature (degrees)', { 'text-anchor': 'middle', transform: `rotate(-90 12 ${(Y0 + Y1) / 2})` });
      // standard line, drawn only over the range the lesson reads (0 to 18 degrees)
      plot.appendChild(el('line', { x1: px(0), y1: py(0), x2: px(TOP / SLOPE), y2: py(TOP), stroke: ACCENT, 'stroke-width': 2.2 }));
      STANDARDS.forEach(([c, d]) => plot.appendChild(el('circle', { cx: px(c), cy: py(d), r: 3.5, fill: ACCENT })));
      // dark-total reference
      plot.appendChild(el('line', { x1: px(0.09), y1: py(TOP), x2: px(0.09), y2: Y1, stroke: FAINT, 'stroke-width': 1.2, 'stroke-dasharray': '3 3' }));
      txt(plot, px(0.09), 24, 'dark total 0.09', { 'text-anchor': 'middle' });
      // legend
      plot.appendChild(el('circle', { cx: X0 + 12, cy: 26, r: 3.5, fill: ACCENT }));
      txt(plot, X0 + 20, 29, 'standards');
      plot.appendChild(el('circle', { cx: X0 + 12, cy: 40, r: 4, fill: ORANGE }));
      txt(plot, X0 + 20, 43, 'block on coleoptile');
      // selected block
      const d = CURV[src], c = d / SLOPE;
      plot.appendChild(el('circle', { cx: px(c), cy: py(d), r: 5, fill: ORANGE, stroke: '#fff', 'stroke-width': 1 }));
      txt(plot, px(c) - 8, py(d) - 6, `${d}° → ${c2(d)}`, { 'text-anchor': 'end', fill: ORANGE, 'font-weight': 700 });
      // cursor
      const inRange = cur <= TOP;
      const cx = px(cur / SLOPE), cy = py(cur);
      const guide = inRange ? INK : '#a33';
      plot.appendChild(el('line', { x1: X0, y1: cy, x2: inRange ? cx : X1, y2: cy, stroke: guide, 'stroke-width': 1.2, 'stroke-dasharray': '4 3' }));
      if (inRange) plot.appendChild(el('line', { x1: cx, y1: cy, x2: cx, y2: Y1, stroke: guide, 'stroke-width': 1.2, 'stroke-dasharray': '4 3' }));
      plot.appendChild(el('rect', { x: X0 - 5, y: cy - 4, width: 10, height: 8, rx: 2, fill: guide }));
      if (inRange) plot.appendChild(el('circle', { cx, cy, r: 4, fill: '#fff', stroke: guide, 'stroke-width': 2 }));
    }

    function drawSchem(src: Src, hyp: 'moves' | 'destroys'): void {
      if (!schem) return;
      schem.replaceChildren();
      const split = src !== 'dark';
      txt(schem, 10, 16, split ? 'Tips lit from one side, split' : 'Whole tips, kept in the dark', { 'font-weight': 700 });
      // tip and blocks
      const tipFill = '#e8f1ea';
      schem.appendChild(el('rect', { x: 100, y: 26, width: 140, height: 40, fill: tipFill, stroke: INK }));
      if (split) {
        for (const y of [36, 46, 56]) {
          schem.appendChild(el('line', { x1: 24, y1: y, x2: 90, y2: y, stroke: LIGHT, 'stroke-width': 2 }));
          schem.appendChild(el('path', { d: `M90 ${y - 4} L98 ${y} L90 ${y + 4} Z`, fill: LIGHT }));
        }
        txt(schem, 10, 28, 'light', { fill: '#8a6900', 'font-weight': 700 });
        schem.appendChild(el('line', { x1: 170, y1: 46, x2: 170, y2: 94, stroke: INK, 'stroke-width': 2.5 }));
        txt(schem, 177, 83, 'barrier', { 'text-anchor': 'start' });
        txt(schem, 135, 61, 'lit half', { 'text-anchor': 'middle' });
        txt(schem, 205, 61, 'shaded half', { 'text-anchor': 'middle' });
        const litOn = src === 'lit', shOn = src === 'shaded';
        schem.appendChild(el('rect', { x: 100, y: 68, width: 66, height: 24, fill: litOn ? '#fbe3c8' : '#f1f1f4', stroke: litOn ? ORANGE : FAINT, 'stroke-width': litOn ? 2.5 : 1 }));
        schem.appendChild(el('rect', { x: 174, y: 68, width: 66, height: 24, fill: shOn ? '#fbe3c8' : '#f1f1f4', stroke: shOn ? ORANGE : FAINT, 'stroke-width': shOn ? 2.5 : 1 }));
        txt(schem, 133, 106, 'lit-half block', { 'text-anchor': 'middle', fill: litOn ? ORANGE : INK, 'font-weight': litOn ? 700 : 400 });
        txt(schem, 207, 106, 'shaded-half block', { 'text-anchor': 'middle', fill: shOn ? ORANGE : INK, 'font-weight': shOn ? 700 : 400 });
        txt(schem, 170, 118, 'barrier: the line between the halves', { 'text-anchor': 'middle' });
        txt(schem, 170, 130, 'top of tip left open so the arrow can cross, not to scale', { 'text-anchor': 'middle' });
        // overlay drawn over the upper part of the tip
        if (hyp === 'moves') {
          schem.appendChild(el('line', { x1: 118, y1: 36, x2: 214, y2: 36, stroke: ACCENT, 'stroke-width': 2.2 }));
          schem.appendChild(el('path', { d: 'M214 31 L224 36 L214 41 Z', fill: ACCENT }));
          txt(schem, 170, 142, 'Overlay: auxin moves from the lit half to the shaded half', { 'text-anchor': 'middle', fill: ACCENT });
        } else {
          schem.appendChild(el('line', { x1: 120, y1: 30, x2: 144, y2: 44, stroke: '#a33', 'stroke-width': 2.5 }));
          schem.appendChild(el('line', { x1: 144, y1: 30, x2: 120, y2: 44, stroke: '#a33', 'stroke-width': 2.5 }));
          txt(schem, 170, 142, 'Overlay: auxin destroyed on the lit side', { 'text-anchor': 'middle', fill: '#a33' });
        }
      } else {
        txt(schem, 170, 50, 'whole tip', { 'text-anchor': 'middle' });
        schem.appendChild(el('rect', { x: 100, y: 68, width: 140, height: 24, fill: '#fbe3c8', stroke: ORANGE, 'stroke-width': 2.5 }));
        txt(schem, 170, 106, 'whole-tip block', { 'text-anchor': 'middle', fill: ORANGE, 'font-weight': 700 });
        txt(schem, 170, 118, 'No light: no sideways overlay', { 'text-anchor': 'middle' });
        txt(schem, 170, 130, '(overlay has no effect on the picture with no light)', { 'text-anchor': 'middle' });
      }
      // bioassay (shifted down to leave room above)
      const bg = el('g', { transform: 'translate(0,16)' });
      schem.appendChild(bg);
      bg.appendChild(el('line', { x1: 10, y1: 138, x2: 330, y2: 138, stroke: FAINT }));
      txt(bg, 10, 154, 'That block on a decapitated coleoptile, in the dark', { 'font-weight': 700 });
      const th = CURV[src];
      let x = 170, y = 328;
      let dpath = `M${x} ${y}`;
      for (let i = 1; i <= 4; i++) {
        const a = ((th * i) / 4) * Math.PI / 180;
        x += 38 * Math.sin(a); y -= 38 * Math.cos(a);
        dpath += ` L${x.toFixed(1)} ${y.toFixed(1)}`;
      }
      bg.appendChild(el('path', { d: dpath, fill: 'none', stroke: GREEN, 'stroke-width': 24, 'stroke-linejoin': 'round' }));
      bg.appendChild(el('path', { d: dpath, fill: 'none', stroke: INK, 'stroke-width': 1, 'stroke-dasharray': '2 3' }));
      bg.appendChild(el('line', { x1: 170, y1: 328, x2: 170, y2: 168, stroke: FAINT, 'stroke-width': 1, 'stroke-dasharray': '4 3' }));
      bg.appendChild(el('rect', { x: x - 16, y: y - 12, width: 22, height: 12, fill: '#fbe3c8', stroke: ORANGE, 'stroke-width': 2, transform: `rotate(${th} ${x.toFixed(1)} ${y.toFixed(1)})` }));
      txt(bg, 10, 192, 'agar block on the left side', { fill: ORANGE, 'font-weight': 700 });
      txt(bg, 10, 206, 'of the cut top');
      txt(bg, 330, 232, 'bends away', { 'text-anchor': 'end' });
      txt(bg, 330, 244, 'from the block', { 'text-anchor': 'end' });
      bg.appendChild(el('line', { x1: 318, y1: 256, x2: 280, y2: 256, stroke: INK, 'stroke-width': 1.5 }));
      bg.appendChild(el('path', { d: 'M318 251 L328 256 L318 261 Z', fill: INK }));
      txt(bg, 330, 282, `curvature ${th} degrees`, { 'text-anchor': 'end', fill: ORANGE, 'font-weight': 700 });
      txt(bg, 330, 296, 'compared with the', { 'text-anchor': 'end' });
      txt(bg, 330, 308, 'upright dashed line', { 'text-anchor': 'end' });
    }

    function cursorText(cur: number): { line: string; status: string } {
      const k = c2(cur);
      if (cur > TOP) {
        return {
          line: 'above 18°: no reading in the lesson',
          status: `The cursor at ${cur} degrees is outside the linear range of these standards. The lesson reads this line only up to 18 degrees and gives no number above that, so no concentration is read here.`,
        };
      }
      const std = STANDARDS.find(([, d]) => d === cur);
      const blk = (Object.keys(CURV) as Src[]).find((s) => CURV[s] === cur);
      let note = '';
      if (cur === 0) note = ' Plain agar caused no curve.';
      else if (std) note = ' This is one of the three standards.';
      else if (blk) note = ` This is the curvature of the ${NAME[blk]}.`;
      let extra = '';
      if (cur > 16) extra = ' It is above the top standard (16 degrees), but the lesson reads its dark block, 18 degrees, on this same line.';
      return {
        line: `${cur} / ${SLOPE} = ${k} mg per L`,
        status: `The cursor at ${cur} degrees reads ${cur} / ${SLOPE} = ${k} mg per L.${note}${extra}`,
      };
    }

    function render(): void {
      if (!curIn || !curOut || !rBlock || !rCursor || !rShare || !rTotal || !rHyp || !why) return;
      const src = getSrc(), hyp = getHyp();
      const cur = parseInt(curIn.value, 10);
      curOut.textContent = String(cur);
      const d = CURV[src];
      const lit = CURV.lit, sh = CURV.shaded, dk = CURV.dark;
      const tot = (lit + sh) / SLOPE;
      const shareSh = Math.round((sh / (lit + sh)) * 100), shareLit = 100 - shareSh;

      rBlock.textContent = `${NAME[src]}: ${d} / ${SLOPE} = ${c2(d)} mg per L`;
      const ct = cursorText(cur);
      rCursor.textContent = ct.line;
      rShare.textContent = `total ${c2(lit)} + ${c2(sh)} = ${tot.toFixed(2)}; shaded ${c2(sh)} / ${tot.toFixed(2)} = ${shareSh}%, lit ${shareLit}%, ratio 2 to 1`;
      rTotal.textContent = `split ${tot.toFixed(2)} mg per L; dark ${dk} / ${SLOPE} = ${c2(dk)} mg per L; equal`;
      rHyp.textContent = hyp === 'moves'
        ? `Moves: the split total equals the dark total. In these illustrative numbers the totals are equal, so it fits.`
        : `Destroys: the split total falls below the dark total. In these illustrative numbers the totals are equal, so it does not fit.`;

      const blockS = src === 'dark'
        ? `Whole tips kept in the dark: the block bends the decapitated coleoptile away from itself by ${d} degrees, so ${d} / ${SLOPE} = ${c2(d)} mg per L, the same as the two halves added together.`
        : `${src === 'lit' ? 'The lit-half block' : 'The shaded-half block'} of split tips lit from one side bends the decapitated coleoptile away from itself by ${d} degrees, so ${d} / ${SLOPE} = ${c2(d)} mg per L. The halves give ${c2(lit)} and ${c2(sh)}: the shaded half carries ${shareSh}% (${c2(sh)} / ${tot.toFixed(2)}), the lit half ${shareLit}%, a ratio of 2 to 1.`;
      const hypS = hyp === 'moves'
        ? 'Moving auxin sideways predicts the equal total seen in these illustrative numbers.'
        : 'Destroying auxin on the lit side predicts a split total below the dark total, but in these illustrative numbers the totals are equal.';
      const concl = 'In these numbers light moved auxin to the shaded side rather than destroying it on the lit side, as the Cholodny-Went idea predicts, and the shaded side then elongates faster, so the shoot bends toward light.';
      const fixed = 'Went’s assay showed transferable growth activity, not the chemical itself; IAA was identified later by others. Auxin speeds shoot elongation but slows root elongation.';
      why.textContent = `${blockS} ${hypS} ${concl} ${ct.status} ${fixed}`;

      drawPlot(src, cur);
      drawSchem(src, hyp);
    }

    srcRadios.forEach((r) => r.addEventListener('change', render));
    hypRadios.forEach((r) => r.addEventListener('change', render));
    curIn.addEventListener('input', render);

    // drag the cursor on the plot
    let dragging = false;
    const fromPointer = (ev: PointerEvent): void => {
      if (!plot || !curIn) return;
      const r = plot.getBoundingClientRect();
      if (r.height === 0) return;
      const vy = ((ev.clientY - r.top) / r.height) * 250;
      const deg = Math.round(((Y1 - vy) / (Y1 - Y0)) * DMAX);
      curIn.value = String(Math.max(0, Math.min(DMAX, deg)));
      render();
    };
    plot.addEventListener('pointerdown', (ev) => { dragging = true; plot.setPointerCapture(ev.pointerId); fromPointer(ev); });
    plot.addEventListener('pointermove', (ev) => { if (dragging) fromPointer(ev); });
    const stop = (): void => { dragging = false; };
    plot.addEventListener('pointerup', stop);
    plot.addEventListener('pointercancel', stop);

    render();
  });
</script>

<style>
  .cba { padding: var(--ddp-space-3) var(--ddp-space-4) var(--ddp-space-4); margin: var(--ddp-space-5) 0; }
  .cba-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem; font-weight: 600; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); margin-bottom: var(--ddp-space-3); }
  .cba-chip { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 400; color: var(--ddp-color-muted); }
  .cba-grid { display: grid; grid-template-columns: 1fr; gap: var(--ddp-space-3); }
  @media (min-width: 760px) { .cba-grid { grid-template-columns: 1fr 1fr; align-items: start; } }
  .cba-svg { display: block; width: 100%; max-width: 560px; margin: 0 auto; height: auto; background: #fff; border: 1px solid var(--ddp-color-line); border-radius: 6px; touch-action: none; }
  .cba-svg:nth-child(2) { touch-action: auto; }
  .cba-controls { display: grid; grid-template-columns: 1fr; gap: var(--ddp-space-2) var(--ddp-space-4); margin: var(--ddp-space-3) 0 var(--ddp-space-2); }
  @media (min-width: 760px) { .cba-controls { grid-template-columns: 1fr 1fr; } .cba-slabel { grid-column: 1 / -1; } }
  .cba-fs { border: 1px solid var(--ddp-color-line); border-radius: 6px; padding: 0.3rem 0.6rem 0.4rem; margin: 0; min-width: 0; }
  .cba-fs legend { font-size: var(--ddp-text-xs); font-weight: 600; color: var(--ddp-color-primary); padding: 0 0.25rem; }
  .cba-fs label { display: flex; gap: 0.4rem; align-items: baseline; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); padding: 0.1rem 0; }
  .cba-fs input { accent-color: var(--ddp-color-accent); }
  .cba-slabel { display: flex; flex-direction: column; gap: 0.1rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .cba-slabel small { font-size: inherit; color: var(--ddp-color-muted); }
  .cba-slabel em { font-style: normal; font-weight: 700; color: var(--ddp-color-accent); font-family: var(--ddp-font-mono); }
  .cba-slabel input { accent-color: var(--ddp-color-accent); }
  .cba-readout { display: grid; grid-template-columns: 1fr; gap: var(--ddp-space-2); margin: var(--ddp-space-2) 0; padding: var(--ddp-space-2) var(--ddp-space-3); background: color-mix(in srgb, var(--ddp-color-accent) 8%, transparent); border-radius: 6px; }
  @media (min-width: 760px) { .cba-readout { grid-template-columns: 1fr 1fr; } .cba-wide { grid-column: 1 / -1; } }
  .cba-readout div { display: flex; flex-direction: column; gap: 0.1rem; min-width: 0; }
  .cba-readout dt { font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .cba-readout dd { margin: 0; font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); color: var(--ddp-color-primary); font-weight: 700; overflow-wrap: anywhere; }
  .cba-why { margin: 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); line-height: 1.5; min-height: 6em; }
  .cba-foot { margin: var(--ddp-space-3) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); border-left: 3px solid var(--ddp-color-secondary); padding-left: 0.55rem; }
</style>
