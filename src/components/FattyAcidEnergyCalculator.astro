---
/**
 * FattyAcidEnergyCalculator — the payoff companion to the β-oxidation pathway map.
 * Pick an even-chain saturated fatty acid and the calculator counts the spiral
 * turns, the acetyl-CoA / FADH₂ / NADH harvest, and the net ATP under the modern
 * P/O convention (2.5 ATP/NADH, 1.5/FADH₂, 10/acetyl-CoA via the TCA cycle and
 * oxidative phosphorylation), minus the 2-ATP activation toll. A bar compares the
 * yield to one glucose (~32 ATP), splits it into the part earned later in the TCA
 * cycle vs. the spiral's own carriers, and reports ATP per carbon, making "fat is
 * the dense fuel" quantitative. Self-contained vanilla-TS Astro island. Original.
 */
// Bars share one scale, set by the longest chain on the slider (C24 nets 162 ATP),
// so no bar ever saturates and every chain length is visibly different.
const MAX_NET = 12 * 10 + 11 * 1.5 + 11 * 2.5 - 2;
const GLC_W = ((32 / MAX_NET) * 100).toFixed(1) + '%';
---

<figure class="fae card" data-fae data-max={MAX_NET}>
  <figcaption class="fae-head">Fatty acid energy calculator<span class="fae-chip">⚙ original · interactive</span></figcaption>

  <label class="fae-slabel">
    <span class="fae-slabel-row">Chain length: <em data-out="n">C16</em> <span class="fae-name" data-name>palmitate</span></span>
    <input type="range" data-in="n" min="4" max="24" step="2" value="16" aria-valuetext="16 carbons, palmitate" />
    <span class="fae-scale" aria-hidden="true"><span>C4 · short</span><span>C24 · very long</span></span>
  </label>

  <div class="fae-grid">
    <dl class="fae-ledger">
      <div><dt>Spiral turns</dt><dd data-r-cycles>7</dd></div>
      <div><dt>Acetyl-CoA</dt><dd data-r-acetyl>8</dd></div>
      <div><dt>FADH₂</dt><dd data-r-fadh2>7</dd></div>
      <div><dt>NADH</dt><dd data-r-nadh>7</dd></div>
      <div><dt>Activation</dt><dd>−2 ATP <small class="fae-sub">ATP → AMP</small></dd></div>
      <div class="fae-net"><dt>Net ATP</dt><dd data-r-atp>106</dd></div>
    </dl>

    <div class="fae-barwrap">
      <p class="fae-bars-title">Net ATP per molecule</p>
      <div class="fae-bar-row">
        <span class="fae-bar-lbl">this fat</span>
        <div class="fae-bar-track"><div class="fae-seg is-tca" data-seg-tca style="width:49.4%"></div><div class="fae-seg is-spiral" data-seg-sp style="width:16.0%"></div></div>
        <b class="fae-bar-n" data-bar-fat-n>106</b>
      </div>
      <div class="fae-bar-row">
        <span class="fae-bar-lbl">glucose</span>
        <div class="fae-bar-track"><div class="fae-seg is-glc" style={`width:${GLC_W}`}></div></div>
        <b class="fae-bar-n">~32</b>
      </div>
      <p class="fae-legend">
        <span><i class="is-tca"></i>acetyl-CoA, burned in the TCA cycle</span>
        <span><i class="is-spiral"></i>spiral's FADH₂ + NADH, minus activation</span>
      </p>
      <p class="fae-eff">ATP per carbon: <b data-r-perc>6.6</b> &nbsp;·&nbsp; glucose ≈ 5.3</p>
    </div>
  </div>

  <p class="fae-why" data-why role="status">C16 palmitate runs 7 turns of the spiral, giving 8 acetyl-CoA, 7 FADH₂, and 7 NADH: about 106 net ATP, 3.3 times what one glucose yields. Most of it (80 ATP) comes later, when the acetyl-CoA burns in the TCA cycle; the spiral's own carriers add 28, minus 2 for activation. Per carbon, fat still wins (6.6 vs 5.3) because its carbons start out more reduced.</p>
  <p class="fae-foot">Modern P/O ratios (2.5 ATP/NADH, 1.5/FADH₂, ~10/acetyl-CoA). Older textbooks counting 3 and 2 give higher totals (palmitate ≈ 129). Even chains only here; odd chains leave a propionyl-CoA.</p>
</figure>

<script>
  const NAMES: Record<number, string> = { 4: 'butyrate', 6: 'caproate', 8: 'caprylate', 10: 'caprate', 12: 'laurate', 14: 'myristate', 16: 'palmitate', 18: 'stearate', 20: 'arachidate', 22: 'behenate', 24: 'lignocerate' };
  document.querySelectorAll<HTMLElement>('[data-fae]').forEach((root) => {
    const nIn = root.querySelector<HTMLInputElement>('[data-in="n"]')!;
    const q = (s: string) => root.querySelector<HTMLElement>(s)!;
    const out = { n: q('[data-out="n"]'), name: q('[data-name]'), cycles: q('[data-r-cycles]'), acetyl: q('[data-r-acetyl]'), fadh2: q('[data-r-fadh2]'), nadh: q('[data-r-nadh]'), atp: q('[data-r-atp]'), perc: q('[data-r-perc]'), why: q('[data-why]'), segTca: q('[data-seg-tca]'), segSp: q('[data-seg-sp]'), barFatN: q('[data-bar-fat-n]') };
    const GLUCOSE = 32;
    const MAX = parseFloat(root.dataset.max || '162');
    const pct = (v: number) => ((v / MAX) * 100).toFixed(1) + '%';
    function render() {
      const n = parseInt(nIn.value, 10);
      const cycles = n / 2 - 1;
      const acetyl = n / 2;
      const fadh2 = cycles, nadh = cycles;
      const fromTca = acetyl * 10;
      const fromSpiral = fadh2 * 1.5 + nadh * 2.5;
      const net = fromTca + fromSpiral - 2;
      const name = NAMES[n] || '';
      out.n.textContent = `C${n}`;
      out.name.textContent = name;
      nIn.setAttribute('aria-valuetext', `${n} carbons${name ? ', ' + name : ''}`);
      out.cycles.textContent = String(cycles);
      out.acetyl.textContent = String(acetyl);
      out.fadh2.textContent = String(fadh2);
      out.nadh.textContent = String(nadh);
      out.atp.textContent = String(net);
      out.perc.textContent = (net / n).toFixed(1);
      out.barFatN.textContent = String(net);
      // one shared scale (C24 = full track): TCA share, then the spiral's carriers net of the 2-ATP toll
      out.segTca.style.width = pct(fromTca);
      out.segSp.style.width = pct(fromSpiral - 2);
      const turns = cycles === 1 ? '1 turn' : `${cycles} turns`;
      out.why.textContent = `C${n}${name ? ' ' + name : ''} runs ${turns} of the spiral, giving ${acetyl} acetyl-CoA, ${fadh2} FADH₂, and ${nadh} NADH: about ${net} net ATP, ${(net / GLUCOSE).toFixed(1)} times what one glucose yields. Most of it (${fromTca} ATP) comes later, when the acetyl-CoA burns in the TCA cycle; the spiral's own carriers add ${fromSpiral}, minus 2 for activation. Per carbon, fat still wins (${(net / n).toFixed(1)} vs 5.3) because its carbons start out more reduced.`;
    }
    nIn.addEventListener('input', render);
    render();
  });
</script>

<style>
  .fae { padding: var(--ddp-space-3) var(--ddp-space-4) var(--ddp-space-4); margin: var(--ddp-space-5) 0; }
  .fae-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem; font-weight: 600; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); margin-bottom: var(--ddp-space-3); }
  .fae-chip { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 400; color: var(--ddp-color-muted); }
  .fae-slabel { display: flex; flex-direction: column; gap: 0.2rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); margin-bottom: var(--ddp-space-3); }
  .fae-slabel-row { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.4rem; }
  .fae-slabel em { font-style: normal; font-weight: 700; font-size: var(--ddp-text-sm); color: var(--ddp-color-accent); font-family: var(--ddp-font-mono); }
  .fae-name { color: var(--ddp-color-primary); font-weight: 600; }
  .fae-slabel input { accent-color: var(--ddp-color-accent); width: 100%; margin: 0.2rem 0 0; }
  .fae-scale { display: flex; justify-content: space-between; font-size: 0.7rem; color: var(--ddp-color-muted); }
  .fae-grid { display: grid; grid-template-columns: 1fr; gap: var(--ddp-space-3); }
  @media (min-width: 600px) { .fae-grid { grid-template-columns: 1fr 1.15fr; align-items: center; } }
  .fae-ledger { display: grid; grid-template-columns: 1fr 1fr; gap: var(--ddp-space-2); margin: 0; }
  .fae-ledger div { display: flex; flex-direction: column; gap: 0.05rem; }
  .fae-ledger dt { font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .fae-ledger dd { margin: 0; font-family: var(--ddp-font-mono); font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); font-weight: 700; }
  .fae-sub { font-family: var(--ddp-font-sans); font-size: 0.7rem; font-weight: 400; color: var(--ddp-color-muted); white-space: nowrap; }
  .fae-net dd { color: var(--ddp-color-accent); font-size: var(--ddp-text-lg, 1.1rem); }
  .fae-barwrap { display: flex; flex-direction: column; gap: 0.4rem; justify-content: center; }
  .fae-bars-title { margin: 0; font-size: var(--ddp-text-xs); font-weight: 600; color: var(--ddp-color-primary); }
  .fae-bar-row { display: flex; align-items: center; gap: 0.5rem; }
  .fae-bar-lbl { width: 52px; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); flex: none; text-align: right; }
  .fae-bar-track { display: flex; flex: 1; min-width: 0; height: 20px; background: color-mix(in srgb, var(--ddp-color-accent) 7%, #fff); border: 1px solid var(--ddp-color-line); border-radius: 5px; overflow: hidden; }
  .fae-seg { height: 100%; flex: none; transition: width 0.25s ease; }
  .fae-seg.is-tca, .fae-legend i.is-tca { background: var(--ddp-color-accent); }
  .fae-seg.is-spiral, .fae-legend i.is-spiral { background: var(--ddp-color-primary-soft); }
  .fae-seg.is-glc { background: var(--ddp-color-secondary); }
  .fae-bar-n { width: 2.4rem; flex: none; font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); color: var(--ddp-color-primary); }
  .fae-legend { display: flex; flex-wrap: wrap; gap: 0.2rem 0.9rem; margin: 0.1rem 0 0; padding-left: calc(52px + 0.5rem); font-size: 0.72rem; color: var(--ddp-color-ink-soft); }
  .fae-legend span { display: inline-flex; align-items: center; gap: 0.3rem; }
  .fae-legend i { display: inline-block; width: 0.7rem; height: 0.7rem; border-radius: 2px; flex: none; }
  .fae-eff { margin: 0.2rem 0 0; padding-left: calc(52px + 0.5rem); font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .fae-eff b { font-family: var(--ddp-font-mono); color: var(--ddp-color-accent); }
  @media (max-width: 420px) { .fae-legend, .fae-eff { padding-left: 0; } }
  .fae-why { margin: var(--ddp-space-3) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); line-height: 1.5; min-height: 2.4em; }
  .fae-foot { margin: var(--ddp-space-3) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); border-left: 3px solid var(--ddp-color-secondary); padding-left: 0.55rem; }
  @media (prefers-reduced-motion: reduce) { .fae-seg { transition: none; } }
</style>
