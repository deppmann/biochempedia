---
/**
 * LacMerodiploidSwitch — the partial-diploid (F′ lac) cis-trans test of the lac-operon
 * lesson. The learner sets the lacI allele, the operator and the lacZ allele on the
 * chromosome and, optionally, on an F′ plasmid, then adds or removes inducer. The model
 * applies only the lesson's rules: a repressor is a diffusing product and reaches every
 * operator in the cell (trans); an operator never leaves its DNA and controls only the
 * Z beside it (cis). Cells are grown without glucose, so CAP and cAMP are available.
 * Nothing is drawn as a molecular structure (labelled blocks only). Original.
 */
---

<figure class="lm card" data-lacmerodiploid>
  <figcaption class="lm-head">Partial diploid: which lac mutations act in cis, which in trans<span class="lm-chip">⚙ original · interactive</span></figcaption>

  <svg class="lm-svg" viewBox="0 0 360 250" role="img" aria-label="One E. coli cell with a chromosomal lac region and, if chosen, an F-prime lac region, showing the repressor, the operator, lacZ and whether beta-galactosidase is made" data-stage></svg>

  <div class="lm-grid">
    <fieldset class="lm-set">
      <legend>Chromosome</legend>
      <label>Repressor gene<select data-k="c-i">
        <option value="I+">I⁺ normal repressor</option>
        <option value="I-">I⁻ no working repressor</option>
        <option value="Is">Iˢ superrepressor</option>
        <option value="Id">I⁻ᵈ dominant-negative</option>
      </select></label>
      <label>Operator<select data-k="c-o">
        <option value="O+">O⁺ normal</option>
        <option value="Oc">Oᶜ constitutive</option>
      </select></label>
      <label>lacZ<select data-k="c-z">
        <option value="Z+">Z⁺ active enzyme</option>
        <option value="Z-">Z⁻ no active enzyme</option>
      </select></label>
    </fieldset>
    <fieldset class="lm-set">
      <legend>F′ lac plasmid</legend>
      <label>Plasmid<select data-k="f-on">
        <option value="1">present (partial diploid)</option>
        <option value="0">absent (haploid)</option>
      </select></label>
      <label>Repressor gene<select data-k="f-i">
        <option value="I+">I⁺ normal repressor</option>
        <option value="I-">I⁻ no working repressor</option>
        <option value="Is">Iˢ superrepressor</option>
        <option value="Id">I⁻ᵈ dominant-negative</option>
      </select></label>
      <label>Operator<select data-k="f-o">
        <option value="O+">O⁺ normal</option>
        <option value="Oc">Oᶜ constitutive</option>
      </select></label>
      <label>lacZ<select data-k="f-z">
        <option value="Z+">Z⁺ active enzyme</option>
        <option value="Z-">Z⁻ no active enzyme</option>
      </select></label>
    </fieldset>
  </div>

  <div class="lm-row">
    <label class="lm-ind"><input type="checkbox" data-ind /> inducer present (IPTG, which needs no β-galactosidase)</label>
    <span class="lm-note">no glucose, so CAP and cAMP are available. Lactose itself would induce only through β-galactosidase.</span>
  </div>
  <div class="lm-row">
    <span class="lm-label">Or load</span>
    <div class="lm-presets" data-presets></div>
  </div>

  <p class="lm-verdict" data-verdict role="status"></p>
  <dl class="lm-out">
    <div><dt>No IPTG</dt><dd data-r0></dd></div>
    <div><dt>With IPTG</dt><dd data-r1></dd></div>
    <div><dt>Behaviour</dt><dd data-rb></dd></div>
  </dl>
  <ul class="lm-list" data-list></ul>

  <p class="lm-foot">An operator acts only on its own DNA molecule; a repressor acts on every operator in the cell. Every lac gene not listed is wild type, and “little or none” allows for the leak the lesson describes. This is a sketch of the logic.</p>
</figure>

<script>
  const NS = 'http://www.w3.org/2000/svg';
  type I = 'I+' | 'I-' | 'Is' | 'Id';
  type O = 'O+' | 'Oc';
  type Z = 'Z+' | 'Z-';
  type Copy = { i: I; o: O; z: Z };
  const INAME: Record<I, string> = { 'I+': 'I⁺', 'I-': 'I⁻', Is: 'Iˢ', Id: 'I⁻ᵈ' };
  const ONAME: Record<O, string> = { 'O+': 'O⁺', Oc: 'Oᶜ' };
  const ZNAME: Record<Z, string> = { 'Z+': 'Z⁺', 'Z-': 'Z⁻' };
  const IFILL: Record<I, string> = { 'I+': '#0e7c86', 'I-': '#6b6b76', Is: '#7a5ea8', Id: '#b03a2e' };
  const OFILL: Record<O, string> = { 'O+': '#c25e00', Oc: '#8c2f1f' };
  const ZFILL: Record<Z, string> = { 'Z+': '#2e7d32', 'Z-': '#6b6b76' };
  const INK = '#4b4b55', FAINT = '#8a8a96', TEAL = '#0e7c86';
  const PRESETS: { label: string; c: Copy; f: Copy; note: string }[] = [
    { label: '(a) I⁻ Z⁺ / F′ I⁺ Z⁻', c: { i: 'I-', o: 'O+', z: 'Z+' }, f: { i: 'I+', o: 'O+', z: 'Z-' }, note: 'Worked problem (a).' },
    { label: '(b) Oᶜ Z⁻ / F′ O⁺ Z⁺', c: { i: 'I+', o: 'Oc', z: 'Z-' }, f: { i: 'I+', o: 'O+', z: 'Z+' }, note: 'Worked problem (b).' },
    { label: '(c) Oᶜ Z⁺ / F′ O⁺ Z⁻', c: { i: 'I+', o: 'Oc', z: 'Z+' }, f: { i: 'I+', o: 'O+', z: 'Z-' }, note: 'Worked problem (c): the same two mutations as (b), swapped between the copies.' },
    { label: '(d) Iˢ Z⁺ / F′ I⁺ Z⁺', c: { i: 'Is', o: 'O+', z: 'Z+' }, f: { i: 'I+', o: 'O+', z: 'Z+' }, note: 'Worked problem (d).' },
    { label: 'I⁻ᵈ Z⁺ / F′ I⁺ Z⁻', c: { i: 'Id', o: 'O+', z: 'Z+' }, f: { i: 'I+', o: 'O+', z: 'Z-' }, note: 'A dominant-negative I⁻ᵈ beside the only Z⁺, with a normal repressor gene on the F′.' },
  ];
  function el(name: string, attrs: Record<string, string | number>, text?: string): SVGElement {
    const e = document.createElementNS(NS, name);
    for (const k in attrs) e.setAttribute(k, String(attrs[k]));
    if (text !== undefined) e.textContent = text;
    return e;
  }

  // The lesson's rules. Returns, for a given inducer state, whether each copy's operator is bound
  // and whether enzyme is made, or unknown when the lesson does not cover the combination.
  function judge(copies: Copy[], ind: boolean) {
    const has = (a: I) => copies.some((c) => c.i === a);
    const hasD = has('Id'), hasS = has('Is'), hasN = has('I+');
    const unknown = hasD && hasS;
    // I⁻ᵈ subunits cannot bind DNA and spoil tetramers they join, so no working repressor remains.
    const normal = hasN && !hasD, sup = hasS && !hasD;
    const bound = copies.map((c) => c.o === 'O+' && (sup || (normal && !ind)));
    const made = copies.map((c, k) => c.z === 'Z+' && !bound[k]);
    return { unknown, normal, sup, hasD, bound, made, any: made.some(Boolean) };
  }

  document.querySelectorAll<HTMLElement>('[data-lacmerodiploid]').forEach((root) => {
    const stage = root.querySelector<SVGSVGElement>('[data-stage]')!;
    const verdict = root.querySelector<HTMLElement>('[data-verdict]')!;
    const list = root.querySelector<HTMLElement>('[data-list]')!;
    const presets = root.querySelector<HTMLElement>('[data-presets]')!;
    const sel = (k: string) => root.querySelector<HTMLSelectElement>(`[data-k="${k}"]`)!;
    const indIn = root.querySelector<HTMLInputElement>('[data-ind]')!;
    const r0 = root.querySelector<HTMLElement>('[data-r0]')!;
    const r1 = root.querySelector<HTMLElement>('[data-r1]')!;
    const rb = root.querySelector<HTMLElement>('[data-rb]')!;
    let note = '';

    function read(): Copy[] {
      const c: Copy = { i: sel('c-i').value as I, o: sel('c-o').value as O, z: sel('c-z').value as Z };
      const out = [c];
      if (sel('f-on').value === '1') out.push({ i: sel('f-i').value as I, o: sel('f-o').value as O, z: sel('f-z').value as Z });
      return out;
    }
    function load(p: { c: Copy; f: Copy }) {
      sel('c-i').value = p.c.i; sel('c-o').value = p.c.o; sel('c-z').value = p.c.z;
      sel('f-on').value = '1'; sel('f-i').value = p.f.i; sel('f-o').value = p.f.o; sel('f-z').value = p.f.z;
    }
    const result = (b: boolean) => (b ? 'β-galactosidase made' : 'little or none');

    function draw(copies: Copy[], ind: boolean) {
      const J = judge(copies, ind);
      const working = (J.normal || J.sup) && !J.unknown;
      stage.replaceChildren();
      stage.appendChild(el('rect', { x: 2, y: 2, width: 356, height: 246, rx: 10, fill: '#fff', stroke: '#b9b9c2' }));
      stage.appendChild(el('text', { x: 12, y: 17, 'font-size': 10, 'font-weight': 700, fill: INK }, 'inside one E. coli cell'));
      const rows = copies.length === 2 ? [78, 188] : [128];
      const names = ['chromosome', 'F′ plasmid'];
      const XI = 40, XO = 150, XZ = 186, XE = 268;
      // the diffusing repressor: one shared line that reaches every operator
      const lineX = 118;
      const lineCol = working ? TEAL : '#b9b9c2';
      const dash = working ? '4 3' : '1 4';
      if (rows.length === 2) stage.appendChild(el('line', { x1: lineX, y1: rows[0], x2: lineX, y2: rows[1], stroke: lineCol, 'stroke-width': 1.6, 'stroke-dasharray': dash }));
      stage.appendChild(el('text', { x: rows.length === 2 ? lineX + 6 : 40, y: rows.length === 2 ? 136 : 196, 'font-size': 9, fill: working ? TEAL : FAINT, 'font-weight': 600 },
        J.unknown ? '' : working ? 'repressor diffuses to every operator' : 'no working repressor'));
      copies.forEach((c, k) => {
        const y = rows[k];
        stage.appendChild(el('text', { x: 10, y: y - 34, 'font-size': 10, 'font-weight': 700, fill: INK }, names[k]));
        stage.appendChild(el('line', { x1: XI, y1: y + 17, x2: XZ + 52, y2: y + 17, stroke: '#b9b9c2', 'stroke-width': 2 }));
        // stubs from the I gene and from the shared line to the operator
        if (working || J.hasD) {
          const makes = c.i === 'I+' || c.i === 'Is';
          if (makes && working) stage.appendChild(el('line', { x1: XI + 46, y1: y, x2: lineX, y2: y, stroke: TEAL, 'stroke-width': 1.6, 'stroke-dasharray': '4 3' }));
          if (working && c.o === 'O+') stage.appendChild(el('line', { x1: lineX, y1: y, x2: XO - 2, y2: y, stroke: TEAL, 'stroke-width': 1.6, 'stroke-dasharray': '4 3' }));
        }
        const block = (x: number, w: number, fill: string, label: string, sub: string) => {
          stage.appendChild(el('rect', { x, y: y - 13, width: w, height: 26, rx: 5, fill }));
          stage.appendChild(el('text', { x: x + w / 2, y: y + 4, 'font-size': 11, 'text-anchor': 'middle', 'font-weight': 700, fill: '#fff' }, label));
          stage.appendChild(el('text', { x: x + w / 2, y: y + 30, 'font-size': 9, 'text-anchor': 'middle', fill: INK }, sub));
        };
        block(XI, 46, IFILL[c.i], INAME[c.i], 'lacI');
        block(XO, 30, OFILL[c.o], ONAME[c.o], 'operator');
        block(XZ, 52, ZFILL[c.z], ZNAME[c.z], 'lacZ');
        // repressor on or off this operator
        if (c.o === 'O+' && working) {
          const rs = J.sup && !J.normal;
          if (J.bound[k]) {
            stage.appendChild(el('rect', { x: XO - 1, y: y - 31, width: 32, height: 17, rx: 4, fill: rs ? '#7a5ea8' : TEAL }));
            stage.appendChild(el('text', { x: XO + 15, y: y - 19, 'font-size': 10, 'text-anchor': 'middle', 'font-weight': 700, fill: '#fff' }, rs ? 'Rˢ on' : 'R on'));
          } else {
            stage.appendChild(el('rect', { x: XO + 4, y: y - 46, width: 32, height: 17, rx: 4, fill: '#fff', stroke: TEAL, 'stroke-dasharray': '3 2' }));
            stage.appendChild(el('text', { x: XO + 20, y: y - 34, 'font-size': 10, 'text-anchor': 'middle', 'font-weight': 700, fill: TEAL }, 'R off'));
          }
        } else if (c.o === 'Oc') {
          stage.appendChild(el('text', { x: XO + 15, y: y - 20, 'font-size': 9, 'text-anchor': 'middle', fill: OFILL.Oc, 'font-weight': 700 }, 'no repressor binds'));
        }
        // transcription and the enzyme made
        const open = !J.bound[k] && !J.unknown;
        if (open) {
          stage.appendChild(el('line', { x1: XZ + 54, y1: y + 17, x2: XE - 2, y2: y + 17, stroke: TEAL, 'stroke-width': 2 }));
          stage.appendChild(el('polygon', { points: `${XE - 2},${y + 17} ${XE - 9},${y + 13} ${XE - 9},${y + 21}`, fill: TEAL }));
        }
        const madeHere = J.made[k] && !J.unknown;
        const label = J.unknown ? 'not covered' : c.z === 'Z-' ? 'no enzyme' : madeHere ? 'β-gal made' : 'little or none';
        stage.appendChild(el('rect', { x: XE, y: y - 13, width: 82, height: 26, rx: 5, fill: madeHere ? '#2e7d32' : '#fff', stroke: madeHere ? '#2e7d32' : FAINT }));
        stage.appendChild(el('text', { x: XE + 41, y: y + 4, 'font-size': 10, 'text-anchor': 'middle', 'font-weight': 700, fill: madeHere ? '#fff' : INK }, label));
      });
      stage.appendChild(el('text', { x: 348, y: 242, 'font-size': 9, 'text-anchor': 'end', fill: ind ? '#b8860b' : FAINT, 'font-weight': 700 }, ind ? 'IPTG present' : 'no IPTG'));
    }

    function describe(copies: Copy[], ind: boolean): string {
      const J = judge(copies, ind);
      const two = copies.length === 2;
      const where = ['chromosome', 'F′'];
      if (J.unknown) return 'This combination (a superrepressor together with a dominant-negative I⁻ᵈ) is not covered by the lesson, so the model makes no prediction.';
      const parts: string[] = [];
      if (J.hasD) {
        parts.push(J.hasD && copies.some((c) => c.i === 'I+')
          ? 'I⁻ᵈ makes subunits that join tetramers but cannot bind DNA, so tetramers that mix them with the normal subunits fail too: no working repressor.'
          : 'I⁻ᵈ makes subunits that cannot bind DNA: no working repressor.');
      } else if (J.sup) {
        parts.push(J.normal
          ? 'The Iˢ repressor binds the operator but cannot bind IPTG, and it diffuses, so it stays on every normal operator even though the normal repressor lets go.'
          : 'The Iˢ repressor binds the operator but cannot bind IPTG, so IPTG does not release it.');
      } else if (J.normal) {
        parts.push(two
          ? 'A normal repressor is made; it diffuses, so it can reach the operator on either copy.'
          : 'A normal repressor is made and binds the operator.');
        if (ind) parts.push('IPTG binds it and lowers its affinity for the operator, so it comes off.');
      } else {
        parts.push('No copy makes a working repressor.');
      }
      copies.forEach((c, k) => {
        const w = two ? ` on the ${where[k]}` : '';
        if (c.z === 'Z-') { parts.push(`The Z⁻${w} makes no active enzyme.`); return; }
        if (c.o === 'Oc') parts.push(`The Z⁺${w} sits beside Oᶜ, which no repressor can bind, so it is transcribed with or without IPTG.`);
        else if (J.bound[k]) parts.push(`The Z⁺${w} sits beside a normal operator held by the repressor: little or none.`);
        else if (J.normal && ind) parts.push(`The Z⁺${w} sits beside a normal operator the repressor has released: enzyme is made.`);
        else parts.push(`The Z⁺${w} sits beside a normal operator that nothing is holding: enzyme is made.`);
      });
      if (!copies.some((c) => c.z === 'Z+')) parts.push('With no Z⁺ in the cell there is nothing to measure.');
      return parts.join(' ');
    }

    function render() {
      const copies = read();
      const ind = indIn.checked;
      const f = root.querySelector<HTMLElement>('[data-k="f-on"]')!;
      void f;
      ['f-i', 'f-o', 'f-z'].forEach((k) => { sel(k).disabled = sel('f-on').value === '0'; });
      draw(copies, ind);
      const a = judge(copies, false), b = judge(copies, true);
      if (a.unknown) {
        r0.textContent = r1.textContent = 'not covered by the lesson';
        rb.textContent = '—';
      } else {
        r0.textContent = result(a.any); r1.textContent = result(b.any);
        const anyZ = copies.some((c) => c.z === 'Z+');
        rb.textContent = !anyZ ? 'no Z⁺ to measure' : a.any && b.any ? 'constitutive' : !a.any && b.any ? 'inducible' : !a.any && !b.any ? 'uninducible (repressed)' : '—';
      }
      verdict.textContent = (note ? note + ' ' : '') + describe(copies, ind);
      list.replaceChildren();
      const li = document.createElement('li');
      li.textContent = 'Genotype, chromosome / F′: ' + copies.map((c) => `${INAME[c.i]} ${ONAME[c.o]} ${ZNAME[c.z]}`).join(' / ') + (copies.length === 1 ? ' (haploid)' : '');
      list.appendChild(li);
    }

    PRESETS.forEach((p) => {
      const bt = document.createElement('button');
      bt.type = 'button'; bt.className = 'lm-btn'; bt.textContent = p.label;
      bt.addEventListener('click', () => { load(p); note = p.note; render(); });
      presets.appendChild(bt);
    });
    root.querySelectorAll<HTMLSelectElement>('select').forEach((s) => s.addEventListener('change', () => { note = ''; render(); }));
    indIn.addEventListener('change', render);
    load(PRESETS[0]);
    note = PRESETS[0].note;
    render();
  });
</script>

<style is:global>
  .lm { padding: var(--ddp-space-3) var(--ddp-space-4) var(--ddp-space-4); margin: var(--ddp-space-5) 0; }
  .lm-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem; font-weight: 600; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); margin-bottom: var(--ddp-space-3); }
  .lm-chip { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 400; color: var(--ddp-color-muted); }
  .lm-svg { display: block; width: 100%; max-width: 600px; margin: 0 auto var(--ddp-space-3); height: auto; background: #fff; border: 1px solid var(--ddp-color-line); border-radius: 6px; }
  .lm-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--ddp-space-2); }
  .lm-set { border: 1px solid var(--ddp-color-line); border-radius: 6px; margin: 0; padding: 0.4rem 0.7rem 0.5rem; display: grid; gap: 0.35rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); min-width: 0; }
  .lm-set legend { font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); padding: 0 0.3rem; }
  .lm-set label { display: grid; gap: 0.15rem; }
  .lm-set select { font: inherit; font-size: var(--ddp-text-xs); padding: 0.25rem 0.3rem; border: 1px solid var(--ddp-color-line); border-radius: 5px; background: #fff; color: var(--ddp-color-ink-soft); max-width: 100%; }
  .lm-set select:disabled { opacity: 0.5; }
  .lm-set select:focus-visible, .lm-btn:focus-visible, .lm-ind input:focus-visible { outline: 2px solid var(--ddp-color-accent); outline-offset: 2px; }
  .lm-row { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem 0.8rem; margin: 0.5rem 0 0; }
  .lm-ind { font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); font-weight: 600; }
  .lm-ind input { accent-color: var(--ddp-color-accent); }
  .lm-note { font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .lm-label { font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .lm-presets { display: flex; flex-wrap: wrap; gap: 0.3rem; }
  .lm-btn { border: 1px solid var(--ddp-color-line); border-radius: 5px; background: transparent; color: var(--ddp-color-ink-soft); font-size: var(--ddp-text-xs); padding: 0.25rem 0.5rem; cursor: pointer; }
  .lm-verdict { margin: var(--ddp-space-3) 0 var(--ddp-space-2); padding: var(--ddp-space-2) var(--ddp-space-3); background: color-mix(in srgb, var(--ddp-color-accent) 8%, transparent); border-radius: 6px; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); min-height: 3em; }
  .lm-out { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.4rem; margin: 0 0 var(--ddp-space-2); font-size: var(--ddp-text-xs); }
  .lm-out dt { color: var(--ddp-color-muted); }
  .lm-out dd { margin: 0; font-weight: 600; color: var(--ddp-color-ink-soft); }
  .lm-list { margin: 0; padding-left: 1.1rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); line-height: 1.5; }
  .lm-foot { margin: var(--ddp-space-3) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); border-left: 3px solid var(--ddp-color-secondary); padding-left: 0.55rem; }
  @media (max-width: 520px) { .lm-grid { grid-template-columns: 1fr; } .lm-out { grid-template-columns: 1fr; } }
</style>
