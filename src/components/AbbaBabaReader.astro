---
/**
 * AbbaBabaReader — the D statistic from ABBA and BABA site counts, with a block-jackknife
 * standard error and the |Z| > 3 convention, as in the Human Evolutionary History lesson.
 * Self-contained vanilla-TS Astro island. Original.
 */
---

<figure class="abr card" data-abbababa>
  <figcaption class="abr-head">Reading a D statistic from ABBA and BABA counts<span class="abr-chip">⚙ original · interactive</span></figcaption>

  <svg class="abr-svg" viewBox="0 0 340 226" role="img" aria-label="Two bars of site counts, ABBA and BABA, and a gauge of D from minus one to plus one" data-plot></svg>

  <div class="abr-controls">
    <label class="abr-slabel"><span>ABBA sites (P2 + P3 share B) <em data-out="abba">600</em></span>
      <input type="range" data-in="abba" min="0" max="1000" step="10" value="600" />
    </label>
    <label class="abr-slabel"><span>BABA sites (P1 + P3 share B) <em data-out="baba">400</em></span>
      <input type="range" data-in="baba" min="0" max="1000" step="10" value="400" />
    </label>
    <label class="abr-slabel"><span>Block-jackknife standard error <em data-out="se">0.05</em></span>
      <input type="range" data-in="se" min="0.01" max="0.15" step="0.01" value="0.05" />
    </label>
  </div>

  <dl class="abr-readout">
    <div><dt>D = (ABBA − BABA) / (ABBA + BABA)</dt><dd data-r-d>0.20</dd></div>
    <div><dt>Z = D / SE</dt><dd data-r-z>4.0</dd></div>
    <div><dt>|Z| greater than 3?</dt><dd data-r-sig>yes</dd></div>
  </dl>
  <p class="abr-why" data-why role="status"></p>

  <p class="abr-assume">In this sketch: the counts are hypothetical, and the standard error is set by hand instead of being computed by dropping genomic blocks. P1 is a sampled African genome, P2 a sampled Eurasian genome, P3 a Neanderthal, with a chimpanzee as outgroup.</p>
  <p class="abr-foot">Rule to keep: D is not percent ancestry, and ancestral structure can also give D above 0.</p>
</figure>

<script>
  const NS = 'http://www.w3.org/2000/svg';
  const ACCENT = '#0e7c86', ORANGE = '#e57200', INK = '#4b4b55', FAINT = '#b9b9c2';
  function el(name: string, attrs: Record<string, string | number>): SVGElement {
    const e = document.createElementNS(NS, name);
    for (const k in attrs) e.setAttribute(k, String(attrs[k]));
    return e;
  }
  function txt(x: number, y: number, s: string, extra: Record<string, string | number> = {}): SVGElement {
    const t = el('text', Object.assign({ x, y, 'font-size': 9, fill: INK }, extra));
    t.textContent = s;
    return t;
  }
  document.querySelectorAll<HTMLElement>('[data-abbababa]').forEach((root) => {
    const plot = root.querySelector<SVGSVGElement>('[data-plot]')!;
    const inp = (n: string) => root.querySelector<HTMLInputElement>('[data-in="' + n + '"]')!;
    const out = (n: string) => root.querySelector<HTMLElement>('[data-out="' + n + '"]')!;
    const abbaIn = inp('abba'), babaIn = inp('baba'), seIn = inp('se');
    const rD = root.querySelector<HTMLElement>('[data-r-d]')!;
    const rZ = root.querySelector<HTMLElement>('[data-r-z]')!;
    const rSig = root.querySelector<HTMLElement>('[data-r-sig]')!;
    const why = root.querySelector<HTMLElement>('[data-why]')!;

    const BASE = 118, TOP = 38, MAXN = 1000;
    const GX0 = 30, GX1 = 310, GY = 182;
    const gx = (d: number) => GX0 + ((d + 1) / 2) * (GX1 - GX0);
    const sgn = (v: number) => (v > 0 ? '+' : v < 0 ? '−' : '');

    function render() {
      const a = parseInt(abbaIn.value, 10);
      const b = parseInt(babaIn.value, 10);
      const se = parseFloat(seIn.value);
      out('abba').textContent = String(a);
      out('baba').textContent = String(b);
      out('se').textContent = se.toFixed(2);
      const n = a + b;
      const defined = n > 0;
      const d = defined ? (a - b) / n : 0;
      const dr = Math.round(d * 100) / 100;
      const z = defined ? dr / se : 0;
      const sig = defined && Math.abs(Math.round(z * 10) / 10) > 3;

      plot.replaceChildren();
      // bars
      plot.appendChild(el('line', { x1: 30, y1: BASE, x2: 310, y2: BASE, stroke: INK, 'stroke-width': 1 }));
      const bars: [number, number, string, string, string][] = [
        [a, 70, 'ABBA', 'P2 + P3 share B', ACCENT],
        [b, 210, 'BABA', 'P1 + P3 share B', ORANGE],
      ];
      for (const [v, x, name, sub, col] of bars) {
        const h = (v / MAXN) * (BASE - TOP);
        if (h > 0) plot.appendChild(el('rect', { x, y: BASE - h, width: 60, height: h, fill: col, opacity: 0.85 }));
        plot.appendChild(txt(x + 30, BASE - h - 4, String(v), { 'text-anchor': 'middle', 'font-weight': 700, 'font-size': 10 }));
        plot.appendChild(txt(x + 30, BASE + 13, name, { 'text-anchor': 'middle', 'font-weight': 700, 'font-size': 10 }));
        plot.appendChild(txt(x + 30, BASE + 25, sub, { 'text-anchor': 'middle' }));
      }
      plot.appendChild(txt(30, 9, 'site counts (of 1,000 at most)', { 'font-size': 9 }));
      // gauge
      plot.appendChild(el('rect', { x: GX0, y: GY, width: GX1 - GX0, height: 9, fill: '#f1f1f4', stroke: FAINT, 'stroke-width': 1 }));
      plot.appendChild(el('line', { x1: gx(0), y1: GY - 3, x2: gx(0), y2: GY + 12, stroke: INK, 'stroke-width': 1.2 }));
      if (defined) {
        const x0 = gx(0), x1 = gx(d);
        if (Math.abs(x1 - x0) > 0.1) plot.appendChild(el('rect', { x: Math.min(x0, x1), y: GY, width: Math.abs(x1 - x0), height: 9, fill: d > 0 ? ACCENT : ORANGE, opacity: 0.8 }));
        plot.appendChild(el('path', { d: `M${x1} ${GY - 1} l-5 -8 h10 z`, fill: INK }));
        const lx = Math.max(GX0 + 30, Math.min(GX1 - 30, x1));
        plot.appendChild(txt(lx, GY - 13, 'D = ' + sgn(d) + Math.abs(d).toFixed(2), { 'text-anchor': 'middle', 'font-weight': 700, 'font-size': 10 }));
      } else {
        plot.appendChild(txt(gx(0), GY - 13, 'D undefined (no sites)', { 'text-anchor': 'middle', 'font-weight': 700, 'font-size': 10 }));
      }
      plot.appendChild(txt(GX0, GY + 22, '−1', { 'text-anchor': 'middle' }));
      plot.appendChild(txt(gx(0), GY + 22, '0 (null)', { 'text-anchor': 'middle' }));
      plot.appendChild(txt(GX1, GY + 22, '+1', { 'text-anchor': 'middle' }));
      plot.appendChild(txt(GX0, GY + 34, 'more BABA', { 'text-anchor': 'start' }));
      plot.appendChild(txt(GX1, GY + 34, 'more ABBA', { 'text-anchor': 'end' }));

      // readouts
      if (defined) {
        rD.textContent = (d < 0 ? '−' : '') + Math.abs(d).toFixed(2);
        rZ.textContent = (z < 0 ? '−' : '') + Math.abs(z).toFixed(1);
        rSig.textContent = sig ? 'yes' : 'no';
      } else {
        rD.textContent = 'undefined';
        rZ.textContent = 'undefined';
        rSig.textContent = 'no';
      }

      // status
      let s: string;
      if (!defined) {
        s = 'There are no ABBA or BABA sites, so the ratio has a zero denominator and D cannot be computed. Add sites to either count.';
      } else if (a === b) {
        s = `ABBA and BABA are equal (${a} each), so D = 0. This is what the model predicts with no gene flow after the populations split and an ancestor that was one randomly mating population: incomplete lineage sorting makes the two patterns equally likely. A D of 0 does not itself exclude every other history.`;
      } else if (d > 0) {
        s = `D = (${a} − ${b}) / (${a} + ${b}) = ${a - b} / ${n} = ${dr.toFixed(2)}. In these counts the Eurasian genome shares derived alleles with the Neanderthal more often than the African genome does. `;
        s += sig
          ? `Z = ${dr.toFixed(2)} / ${se.toFixed(2)} = ${z.toFixed(1)}, and studies of this kind commonly treat |Z| greater than 3 as significant, so the asymmetry is unlikely to be chance. It is consistent with gene flow, not proof of it.`
          : `Z = ${dr.toFixed(2)} / ${se.toFixed(2)} = ${z.toFixed(1)}, which does not exceed 3, so by the convention such studies commonly use this asymmetry is not distinguished from chance.`;
      } else {
        s = `D = (${a} − ${b}) / (${a} + ${b}) = −${Math.abs(a - b)} / ${n} = −${Math.abs(dr).toFixed(2)}. Here the African genome shares derived alleles with the Neanderthal more often than the Eurasian genome does. `;
        s += sig
          ? `Z = −${Math.abs(dr).toFixed(2)} / ${se.toFixed(2)} = −${Math.abs(z).toFixed(1)}, and |Z| is greater than 3, so the asymmetry is unlikely to be chance.`
          : `Z = −${Math.abs(dr).toFixed(2)} / ${se.toFixed(2)} = −${Math.abs(z).toFixed(1)}, so |Z| does not exceed 3 and the asymmetry is not distinguished from chance.`;
      }
      why.textContent = s;
    }
    [abbaIn, babaIn, seIn].forEach((s) => s.addEventListener('input', render));
    render();
  });
</script>

<style>
  .abr { padding: var(--ddp-space-3) var(--ddp-space-4) var(--ddp-space-4); margin: var(--ddp-space-5) 0; }
  .abr-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem; font-weight: 600; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); margin-bottom: var(--ddp-space-3); }
  .abr-chip { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 400; color: var(--ddp-color-muted); }
  .abr-svg { display: block; width: 100%; max-width: 560px; margin: 0 auto; height: auto; background: #fff; border: 1px solid var(--ddp-color-line); border-radius: 6px; }
  .abr-controls { display: grid; grid-template-columns: 1fr 1fr; gap: var(--ddp-space-2) var(--ddp-space-4); margin: var(--ddp-space-3) 0 var(--ddp-space-2); }
  .abr-slabel { display: flex; flex-direction: column; gap: 0.1rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .abr-slabel em { font-style: normal; font-weight: 700; color: var(--ddp-color-accent); font-family: var(--ddp-font-mono); }
  .abr-slabel input { accent-color: var(--ddp-color-accent); }
  .abr-readout { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--ddp-space-2); margin: var(--ddp-space-2) 0; padding: var(--ddp-space-2) var(--ddp-space-3); background: color-mix(in srgb, var(--ddp-color-accent) 8%, transparent); border-radius: 6px; }
  .abr-readout div { display: flex; flex-direction: column; gap: 0.1rem; }
  .abr-readout dt { font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .abr-readout dd { margin: 0; font-family: var(--ddp-font-mono); font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); font-weight: 700; }
  .abr-why { margin: 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); line-height: 1.5; min-height: 6em; }
  .abr-assume { margin: var(--ddp-space-2) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .abr-foot { margin: var(--ddp-space-3) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); border-left: 3px solid var(--ddp-color-secondary); padding-left: 0.55rem; }
  @media (max-width: 520px) {
    .abr-controls, .abr-readout { grid-template-columns: 1fr; }
  }
</style>
