---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hex from './Hex.astro';
import { courseHref, type Course } from '../data/courses';
import { hexFor } from '../data/hex';
import { CATEGORY_LABELS, METHODS, filmLength, methodHref, type MethodCategory } from '../data/methods';
import { methodFilmCounts } from '../lib/film-catalog';
import { methodCourses } from '../lib/method-courses';
import { metaDescription } from '../lib/meta';

interface Props {
  course?: Course;
}

const { course } = Astro.props;
const hex = hexFor('methods');

/* The methods library: every experimental method taught on the site, one film each,
   grouped by what it works on. A card counts visible lessons in the current view. */
const lessons = await getCollection('lessons', ({ data }) =>
  (import.meta.env.DEV || !data.draft) && (!course || data.course === course.slug));
const courseByLesson = new Map(lessons.map(({ data }) => [data.slug, data.course]));
const entries = METHODS.map((m) => {
  const taughtIn = m.lessons.map((slug) => courseByLesson.get(slug)).filter((slug) => slug !== undefined);
  return { m, lessonCount: taughtIn.length, courseCount: new Set(taughtIn).size };
}).filter(({ lessonCount }) => !course || lessonCount > 0);
const methods = entries.filter(({ m }) => m.film);
const groups = (Object.keys(CATEGORY_LABELS) as MethodCategory[])
  .map((cat) => ({ cat, items: methods.filter(({ m }) => m.category === cat).sort((a, b) => a.m.name.localeCompare(b.m.name)) }))
  .filter((g) => g.items.length > 0);
/* The film library (/films/) lists each film file once. A method film that is also a lesson's film
   is listed there under its course, so its Methods stack is smaller than this page; say so here. */
const counts = course ? undefined : await methodFilmCounts();
const coming = entries.filter(({ m }) => !m.film).sort((a, b) => a.m.name.localeCompare(b.m.name));
const title = course ? `Methods for ${course.title}` : 'Methods library';
const description = course
  ? metaDescription(entries.length
    ? `Explore the experimental methods used in STEMhop’s ${course.title} lessons, with short films on how they work and how to read the results.`
    : `See which experimental methods are linked to STEMhop’s ${course.title} lessons. The library has no methods linked to this course yet.`)
  : 'One short narrated film for every experimental method the courses teach: what it solves, how it works, how to read the result, and what it made possible.';
---

<BaseLayout title={`${title} — STEMhop`} description={description}>
  <section class="wrap methods-hero">
    <p class="eyebrow">
      {course
        ? <><a href="/methods/">Methods library</a> · <a href={courseHref(course.slug)}>{course.title}</a></>
        : <><a href="/courses/">All courses</a> · methods</>}
    </p>
    <h1>{title}{!course && <Hex pose={hex.pose} prop={hex.prop} size={60} alive title={hex.label} class="hex-inline" />}</h1>
    {!course && (
      <p class="lede">
        Every claim in these courses rests on a measurement. Each film here explains one method once:
        the problem it solves, how it works, how to read what it gives you, what can go wrong, and what it
        made possible. The same film appears in every lesson that uses the method.
      </p>
    )}
    {entries.length > 0
      ? <p class="count">{methods.length === 1 ? '1 film' : `${methods.length} films`}{coming.length > 0 && ` · ${coming.length} more in production`}</p>
      : <p class="lede">No methods in the library are currently linked to this course’s lessons.</p>}
    {counts && counts.shared > 0 && (
      <p class="count-note">
        {counts.shared === 1 ? 'One of these films is' : `${counts.shared} of these films are`} also a lesson’s own film. The <a href="/films/">film library</a> lists
        {counts.shared === 1 ? ' it with its course' : ' those with their courses'}, so its Methods stack shows the other {counts.own}.
      </p>
    )}
  </section>

  {!course && (
    <nav class="wrap course-nav" aria-labelledby="methods-courses">
      <h2 id="methods-courses">Methods by course</h2>
      <div class="cat-nav">
        {methodCourses(lessons).map((c) => <a href={methodHref(c.slug)}>{c.title}</a>)}
      </div>
    </nav>
  )}

  {groups.length > 0 && (
    <nav class="wrap cat-nav" aria-label="Jump to a group">
      {groups.map((g) => <a href={`#${g.cat}`}>{CATEGORY_LABELS[g.cat]}</a>)}
    </nav>
  )}

  {groups.map((g) => (
    <section class="wrap cat" id={g.cat} aria-labelledby={`${g.cat}-h`}>
      <h2 id={`${g.cat}-h`}>{CATEGORY_LABELS[g.cat]}</h2>
      <ul class="grid">
        {g.items.map(({ m, lessonCount, courseCount }) => {
          const href = methodHref(m.slug);
          const lessonWord = lessonCount === 1 ? 'lesson' : 'lessons';
          const label = course
            ? `${lessonCount} ${course.title} ${lessonWord}`
            : `${lessonCount} ${lessonWord} across ${courseCount} ${courseCount === 1 ? 'course' : 'courses'}`;
          return (
            <li class="card mcard">
              <a class="mcard-main" href={href}>
                <img src={m.film!.poster} alt="" loading="lazy" decoding="async" width="480" height="270" />
                <span class="mname">{m.name}</span>
                <span class="msum">{m.summary}</span>
              </a>
              <div class="mmeta">
                <span>▶ {filmLength(m.film!.durationSec)}</span>
                <a class="mcount" href={`${href}#${course?.slug ?? 'where-h'}`} aria-label={`${label} for ${m.name}`}>{label}</a>
              </div>
            </li>
          );
        })}
      </ul>
    </section>
  ))}

  {coming.length > 0 && (
    <section class="wrap cat" id="coming" aria-labelledby="coming-h">
      <h2 id="coming-h">Films in production</h2>
      <p class="coming-note">These methods have a page with the lessons that use them; each gets its film soon.</p>
      <ul class="coming">
        {coming.map(({ m }) => <li><a href={methodHref(m.slug)}>{m.name}</a></li>)}
      </ul>
    </section>
  )}

  <style>
    .coming-note { margin: 0 0 var(--ddp-space-3); color: var(--ddp-color-muted); font-size: var(--ddp-text-sm); }
    .coming { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--ddp-space-2); }
    .coming a { display: inline-block; padding: 0.3rem 0.8rem; border-radius: 999px; border: 1px dashed var(--ddp-color-border, #d6d3cc); text-decoration: none; font-size: var(--ddp-text-sm); color: var(--ddp-color-ink); }
    .coming a:hover { border-color: var(--ddp-color-accent); }
    .methods-hero { padding-block: var(--ddp-space-8) var(--ddp-space-4); display: flex; flex-direction: column; gap: var(--ddp-space-3); }
    .eyebrow { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); letter-spacing: 0.14em; text-transform: uppercase; color: var(--ddp-color-caution-ink); margin: 0; }
    .eyebrow a { color: inherit; text-underline-offset: 3px; }
    h1 { font-family: var(--ddp-font-serif); font-weight: 500; color: var(--ddp-color-primary); font-size: var(--ddp-text-3xl); line-height: 1.1; margin: 0; }
    .lede { font-size: var(--ddp-text-lg); line-height: 1.6; color: var(--ddp-color-ink-soft); max-width: 62ch; margin: 0; }
    .count-note { margin: 0; max-width: 60ch; font-size: var(--ddp-text-sm); line-height: 1.5; color: var(--ddp-color-muted); }
    .count { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); letter-spacing: 0.12em; text-transform: uppercase; color: var(--ddp-color-muted); margin: 0; }
    .course-nav h2 { margin-block: 0 var(--ddp-space-2); }
    .cat-nav { display: flex; flex-wrap: wrap; gap: var(--ddp-space-2); padding-block: var(--ddp-space-2) var(--ddp-space-4); }
    .cat-nav a { padding: 0.3rem 0.8rem; border-radius: 999px; border: 1px solid var(--ddp-color-border, #d6d3cc); text-decoration: none; font-size: var(--ddp-text-sm); color: var(--ddp-color-ink); }
    .cat-nav a:hover { border-color: var(--ddp-color-accent); }
    .cat { padding-bottom: var(--ddp-space-8); }
    h2 { font-family: var(--ddp-font-serif); font-weight: 500; color: var(--ddp-color-primary); font-size: var(--ddp-text-xl); margin: var(--ddp-space-4) 0; }
    .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr)); gap: var(--ddp-space-4); }
    .mcard { padding: 0; display: flex; flex-direction: column; }
    .mcard-main { display: flex; flex: 1; flex-direction: column; gap: var(--ddp-space-1); text-decoration: none; color: var(--ddp-color-ink); padding-bottom: var(--ddp-space-2); }
    .mcard img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; background: #0f1117; margin-bottom: var(--ddp-space-2); border-radius: var(--ddp-radius) var(--ddp-radius) 0 0; }
    .mname, .msum, .mmeta { padding-inline: var(--ddp-space-4); }
    .mname { font-family: var(--ddp-font-serif); font-size: var(--ddp-text-lg); color: var(--ddp-color-primary); }
    .msum { font-size: var(--ddp-text-sm); line-height: 1.5; color: var(--ddp-color-ink-soft); }
    .mmeta { display: flex; flex-wrap: wrap; align-items: center; gap: 0 var(--ddp-space-2); padding-bottom: var(--ddp-space-2); font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
    .mcount { display: inline-flex; align-items: center; min-height: 44px; min-width: 0; color: var(--ddp-color-accent); text-decoration: underline; text-underline-offset: 3px; }
    .mcard-main:hover .mname { text-decoration: underline; }
  </style>
</BaseLayout>
