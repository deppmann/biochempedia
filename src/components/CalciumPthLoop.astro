---
/**
 * CalciumPthLoop — "Calcium in, calcium out". The kidney filters about ten grams of calcium a
 * day and returns almost all of it, so a small change in the fraction reabsorbed sets the daily
 * excretion, and at whole-body balance net intestinal absorption must match it (less any net
 * bone release). Sliders: GFR, filterable plasma calcium, fractional reabsorption, and a
 * "bone in balance" toggle with a net bone release slider. Equations are the lesson's own:
 * filtered load = GFR x filterable calcium; excretion = filtered load x (1 - fractional
 * reabsorption). No hormones are simulated. Self-contained vanilla-TS Astro island. Original.
 */
---

<figure class="cpl card" data-cpl>
  <figcaption class="cpl-head">Calcium in, calcium out — filtered load, excretion and balance<span class="cpl-chip">⚙ original · interactive</span></figcaption>

  <svg class="cpl-svg" viewBox="0 0 340 360" role="img" aria-label="A schematic of daily calcium flows. Plasma calcium is filtered into the kidney, nearly all of it is reabsorbed back to plasma, and a small part leaves in urine. The gut and bone exchange calcium with plasma. Below, one bar shows the filtered load split into reabsorbed and excreted parts, and a second bar shows urinary excretion and the net intestinal absorption needed for whole-body balance.">
    <defs>
      <marker id="cpl-m-t" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="11" markerHeight="11" markerUnits="userSpaceOnUse" orient="auto"><path d="M0 0 L10 5 L0 10 z" fill="#0e7c86"></path></marker>
      <marker id="cpl-m-i" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="11" markerHeight="11" markerUnits="userSpaceOnUse" orient="auto"><path d="M0 0 L10 5 L0 10 z" fill="#4b4b55"></path></marker>
      <marker id="cpl-m-o" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="11" markerHeight="11" markerUnits="userSpaceOnUse" orient="auto"><path d="M0 0 L10 5 L0 10 z" fill="#e57200"></path></marker>
    </defs>

    <text x="170" y="12" text-anchor="middle" font-size="9" fill="#4b4b55">Arrows show direction only; sizes are in the bars below. Flows in mg per day.</text>

    <!-- reabsorbed: kidney back to plasma -->
    <polyline points="295,60 295,40 165,40 165,58" fill="none" stroke="#0e7c86" stroke-width="2.4" stroke-linejoin="round" marker-end="url(#cpl-m-t)"></polyline>
    <text x="230" y="34" text-anchor="middle" font-size="9" font-weight="700" fill="#0e7c86" data-k="reabs">reabsorbed: 10,600 mg per day</text>

    <!-- blocks -->
    <rect x="6" y="60" width="66" height="44" rx="5" fill="#f4f4f6" stroke="#4b4b55" stroke-width="1"></rect>
    <text x="39" y="74" text-anchor="middle" font-size="10" font-weight="700" fill="#4b4b55">Gut</text>
    <text x="39" y="86" text-anchor="middle" font-size="9" fill="#4b4b55" data-k="gut2">net absorbed</text>
    <text x="39" y="98" text-anchor="middle" font-size="9" font-weight="700" fill="#0e7c86" data-k="gut3">200 mg/day</text>

    <rect x="120" y="60" width="90" height="44" rx="5" fill="#f4f4f6" stroke="#4b4b55" stroke-width="1"></rect>
    <text x="165" y="74" text-anchor="middle" font-size="10" font-weight="700" fill="#4b4b55">Plasma</text>
    <text x="165" y="86" text-anchor="middle" font-size="9" fill="#4b4b55">filterable calcium</text>
    <text x="165" y="98" text-anchor="middle" font-size="9" font-weight="700" fill="#4b4b55" data-k="pl3">60 mg per L</text>

    <rect x="256" y="60" width="78" height="44" rx="5" fill="#f4f4f6" stroke="#4b4b55" stroke-width="1"></rect>
    <text x="295" y="74" text-anchor="middle" font-size="10" font-weight="700" fill="#4b4b55">Kidney</text>
    <text x="295" y="86" text-anchor="middle" font-size="9" fill="#4b4b55">filters per day</text>
    <text x="295" y="98" text-anchor="middle" font-size="9" font-weight="700" fill="#4b4b55" data-k="kid3">10,800 mg</text>

    <rect x="105" y="136" width="120" height="34" rx="5" fill="#f4f4f6" stroke="#4b4b55" stroke-width="1"></rect>
    <text x="165" y="149" text-anchor="middle" font-size="10" font-weight="700" fill="#4b4b55">Bone</text>
    <text x="165" y="162" text-anchor="middle" font-size="9" fill="#4b4b55" data-k="bone2">formation = resorption</text>

    <rect x="256" y="136" width="78" height="34" rx="5" fill="#f4f4f6" stroke="#4b4b55" stroke-width="1"></rect>
    <text x="295" y="149" text-anchor="middle" font-size="10" font-weight="700" fill="#4b4b55">Urine</text>
    <text x="295" y="162" text-anchor="middle" font-size="9" font-weight="700" fill="#e57200" data-k="uri2">200 mg/day</text>

    <!-- arrows -->
    <line x1="212" y1="82" x2="254" y2="82" stroke="#4b4b55" stroke-width="2.4" marker-end="url(#cpl-m-i)"></line>
    <line x1="295" y1="106" x2="295" y2="134" stroke="#e57200" stroke-width="2.4" marker-end="url(#cpl-m-o)"></line>
    <line x1="74" y1="82" x2="118" y2="82" stroke="#0e7c86" stroke-width="2.4" marker-end="url(#cpl-m-t)" data-k="gutIn"></line>
    <line x1="165" y1="134" x2="165" y2="106" stroke="#0e7c86" stroke-width="2.4" marker-end="url(#cpl-m-t)" data-k="boneArr" display="none"></line>

    <!-- bar 1: filtered load -->
    <text x="12" y="192" font-size="10" font-weight="700" fill="#4b4b55" data-k="b1t">Filtered load: 10,800 mg per day</text>
    <rect x="12" y="198" width="300" height="14" fill="#eef0f2" stroke="#b9b9c2" stroke-width="1"></rect>
    <rect x="12" y="198" width="160" height="14" fill="#0e7c86" data-k="b1re"></rect>
    <rect x="172" y="198" width="2" height="14" fill="#e57200" data-k="b1ex"></rect>
    <g stroke="#4b4b55" stroke-width="1">
      <line x1="12" y1="212" x2="12" y2="216"></line><line x1="162" y1="212" x2="162" y2="216"></line><line x1="312" y1="212" x2="312" y2="216"></line>
    </g>
    <g font-size="9" fill="#4b4b55" text-anchor="middle">
      <text x="12" y="226">0</text><text x="162" y="226">10,000</text><text x="312" y="226">20,000</text>
    </g>
    <rect x="12" y="232" width="9" height="9" fill="#0e7c86"></rect>
    <text x="25" y="240" font-size="9" fill="#4b4b55" data-k="legRe">reabsorbed 10,600</text>
    <rect x="150" y="232" width="9" height="9" fill="#e57200"></rect>
    <text x="163" y="240" font-size="9" fill="#4b4b55" data-k="legEx">excreted 200 (1.85%)</text>

    <!-- bar 2: excretion and net absorption (own scale) -->
    <text x="12" y="261" font-size="10" font-weight="700" fill="#4b4b55" data-k="exT">Urinary excretion: 200 mg per day</text>
    <g stroke="#e3e3e8" stroke-width="1">
      <line x1="28" y1="265" x2="28" y2="281"></line><line x1="322" y1="265" x2="322" y2="281"></line><line x1="199.5" y1="265" x2="199.5" y2="281"></line>
      <line x1="28" y1="312" x2="28" y2="329"></line><line x1="322" y1="312" x2="322" y2="329"></line><line x1="199.5" y1="312" x2="199.5" y2="329"></line>
    </g>
    <rect x="77" y="267" width="49" height="12" fill="#e57200" data-k="b2ex"></rect>
    <text x="12" y="296" font-size="10" font-weight="700" fill="#4b4b55">Net intestinal absorption needed for zero balance:</text>
    <text x="12" y="308" font-size="10" font-weight="700" fill="#0e7c86" data-k="netT">200 mg per day</text>
    <rect x="77" y="313" width="49" height="12" fill="#0e7c86" data-k="b2net"></rect>
    <line x1="77" y1="265" x2="77" y2="281" stroke="#4b4b55" stroke-width="1.2"></line>
    <line x1="77" y1="312" x2="77" y2="330" stroke="#4b4b55" stroke-width="1.2"></line>
    <g stroke="#4b4b55" stroke-width="1">
      <line x1="28" y1="329" x2="28" y2="333"></line><line x1="77" y1="329" x2="77" y2="333"></line><line x1="199.5" y1="329" x2="199.5" y2="333"></line><line x1="322" y1="329" x2="322" y2="333"></line>
    </g>
    <g font-size="9" fill="#4b4b55" text-anchor="middle">
      <text x="28" y="343">−200</text><text x="77" y="343">0</text><text x="199.5" y="343">500</text><text x="322" y="343">1,000</text>
    </g>
    <text x="170" y="355" text-anchor="middle" font-size="9" fill="#4b4b55">mg per day (a different scale from the bar above)</text>
  </svg>

  <div class="cpl-controls">
    <label class="cpl-slabel"><span>GFR <em data-out="gfr">125</em> mL per min</span>
      <input type="range" data-in="gfr" min="60" max="180" step="1" value="125" />
    </label>
    <label class="cpl-slabel"><span>Filterable plasma calcium <em data-out="ca">60</em> mg per L</span>
      <input type="range" data-in="ca" min="40" max="70" step="1" value="60" />
    </label>
    <label class="cpl-slabel"><span>Fractional reabsorption <em data-out="fr">98.15</em> percent</span>
      <input type="range" data-in="fr" min="95" max="99.5" step="0.05" value="98.15" />
    </label>
    <div class="cpl-bone">
      <label class="cpl-check"><input type="checkbox" data-in="bal" checked /> <span>Bone in balance (formation equals resorption)</span></label>
      <label class="cpl-slabel"><span>Net bone release <em data-out="rel">0</em> mg per day <small data-note>(used only when bone is not in balance)</small></span>
        <input type="range" data-in="rel" min="0" max="200" step="5" value="0" disabled />
      </label>
    </div>
  </div>

  <dl class="cpl-readout">
    <div><dt>Filtered load = GFR × 1.44 × filterable calcium</dt><dd data-r="fl"></dd></div>
    <div><dt>Urinary excretion = filtered load × (1 − fractional reabsorption)</dt><dd data-r="ex"></dd></div>
    <div><dt>Net intestinal absorption needed = excretion − net bone release</dt><dd data-r="net"></dd></div>
  </dl>

  <p class="cpl-why" data-why role="status"></p>

  <p class="cpl-assume">In this sketch: made-up round numbers for a reference adult at steady state, starting from the lesson’s worked problem (GFR 125 mL per min, filterable calcium 60 mg per L, 98.15 percent reabsorbed, bone formation equal to resorption, no sweat losses). The 1.44 is 1,440 minutes per day divided by 1,000 mL per L. The slider ranges, the 0 to 200 mg per day of net bone release are made up for the sketch. Each slider is moved on its own and filterable calcium is held at the value you set; no hormones are simulated, so the sketch does not show how the body would set or respond to any of these values. A fall of about 1.15 percentage points in reabsorption, from 98.15 to 97.0 percent, moves excretion by 62 percent in the lesson’s example. At whole-body balance, net intestinal absorption equals urinary loss plus net bone accretion (net bone release is negative accretion).</p>

  <p class="cpl-foot">Rule to keep: filtered load = GFR × filterable calcium, and excretion = filtered load × (1 − fractional reabsorption).</p>
</figure>

<script>
  function must<T extends Element>(root: ParentNode, sel: string): T {
    const e = root.querySelector<T>(sel);
    if (!e) throw new Error('CalciumPthLoop: missing element ' + sel);
    return e;
  }
  const MINUS = '−';
  const fmt = (n: number): string => {
    const r = Math.round(n);
    if (r === 0) return '0';
    const s = Math.abs(r).toLocaleString('en-US');
    return r < 0 ? MINUS + s : s;
  };

  document.querySelectorAll<HTMLElement>('[data-cpl]').forEach((root) => {
    const inp = (k: string) => must<HTMLInputElement>(root, `[data-in="${k}"]`);
    const out = (k: string) => must<HTMLElement>(root, `[data-out="${k}"]`);
    const k = (name: string) => must<SVGElement>(root, `[data-k="${name}"]`);
    const gfrIn = inp('gfr'), caIn = inp('ca'), frIn = inp('fr'), balIn = inp('bal'), relIn = inp('rel');
    const gfrOut = out('gfr'), caOut = out('ca'), frOut = out('fr'), relOut = out('rel');
    const rFl = must<HTMLElement>(root, '[data-r="fl"]');
    const rEx = must<HTMLElement>(root, '[data-r="ex"]');
    const rNet = must<HTMLElement>(root, '[data-r="net"]');
    const why = must<HTMLElement>(root, '[data-why]');
    const note = must<HTMLElement>(root, '[data-note]');

    const reabs = k('reabs'), gut2 = k('gut2'), gut3 = k('gut3'), pl3 = k('pl3'), kid3 = k('kid3');
    const bone2 = k('bone2'), uri2 = k('uri2'), gutIn = k('gutIn'), boneArr = k('boneArr');
    const b1t = k('b1t'), b1re = k('b1re'), b1ex = k('b1ex'), legRe = k('legRe'), legEx = k('legEx');
    const exT = k('exT'), b2ex = k('b2ex'), netT = k('netT'), b2net = k('b2net');

    const TEAL = '#0e7c86';
    const NEG = 'negative: bone release exceeds urinary excretion, a case the lesson does not work; this sketch does not show a balanced state';
    const show = (e: SVGElement, on: boolean) => { if (on) e.removeAttribute('display'); else e.setAttribute('display', 'none'); };
    // bar 1: 0 to 20,000 mg per day over x 12 to 312; bar 2: -200 to 1,000 over x 28 to 322, zero at x 77
    const S1 = 300 / 20000, S2 = 294 / 1200, Z2 = 28 + 200 * S2;

    function render() {
      const gfr = parseFloat(gfrIn.value);
      const ca = parseFloat(caIn.value);
      const fr = parseFloat(frIn.value);
      const balanced = balIn.checked;
      const relSet = parseFloat(relIn.value);
      const rel = balanced ? 0 : relSet;

      relIn.disabled = balanced;
      note.textContent = balanced ? '(used only when bone is not in balance)' : '(net calcium leaving bone)';

      gfrOut.textContent = String(Math.round(gfr));
      caOut.textContent = String(Math.round(ca));
      frOut.textContent = fr.toFixed(2);
      relOut.textContent = String(Math.round(relSet));

      // the lesson's equations; GFR in mL per min x 1,440 min per day / 1,000 mL per L = 1.44
      const filtered = gfr * 1.44 * ca;
      const excreted = filtered * (1 - fr / 100);
      const returned = filtered - excreted;
      const net = excreted - rel;
      const fe = (1 - fr / 100) * 100;
      const netR = Math.round(net);

      // readout with arithmetic
      rFl.textContent = `${Math.round(gfr)} × 1.44 × ${Math.round(ca)} = ${fmt(filtered)} mg per day (${Math.round(gfr)} mL per min = ${(gfr * 1.44).toFixed(0)} L per day)`;
      rEx.textContent = `${fmt(filtered)} × (1 − ${(fr / 100).toFixed(4)}) = ${fmt(excreted)} mg per day`;
      rNet.textContent = netR < 0 ? NEG : `${fmt(excreted)} − ${fmt(rel)} = ${fmt(net)} mg per day`;

      // schematic
      pl3.textContent = `${Math.round(ca)} mg per L`;
      kid3.textContent = `${fmt(filtered)} mg`;
      reabs.textContent = `reabsorbed: ${fmt(returned)} mg per day`;
      uri2.textContent = `${fmt(excreted)} mg/day`;
      show(gutIn, netR > 0);
      if (netR > 0) { gut2.textContent = 'net absorbed'; gut3.textContent = `${fmt(net)} mg/day`; gut3.setAttribute('fill', TEAL); }
      else if (netR < 0) { gut2.textContent = 'not defined'; gut3.textContent = '—'; gut3.setAttribute('fill', '#4b4b55'); }
      else { gut2.textContent = 'no net flow'; gut3.textContent = '0 mg/day'; gut3.setAttribute('fill', '#4b4b55'); }
      const boneOut = !balanced && rel > 0;
      show(boneArr, boneOut);
      bone2.textContent = boneOut ? `net release ${fmt(rel)} mg/day` : (balanced ? 'formation = resorption' : 'no net release');

      // bar 1: filtered load split into reabsorbed and excreted
      const wTot = filtered * S1, wEx = Math.max(excreted * S1, 1.5);
      b1t.textContent = `Filtered load: ${fmt(filtered)} mg per day`;
      b1re.setAttribute('width', (wTot - wEx).toFixed(1));
      b1ex.setAttribute('x', (12 + wTot - wEx).toFixed(1));
      b1ex.setAttribute('width', wEx.toFixed(1));
      legRe.textContent = `reabsorbed ${fmt(returned)}`;
      legEx.textContent = `excreted ${fmt(excreted)} (${fe.toFixed(2)}%)`;

      // bar 2: excretion and net absorption needed
      exT.textContent = `Urinary excretion: ${fmt(excreted)} mg per day`;
      b2ex.setAttribute('x', Z2.toFixed(1));
      b2ex.setAttribute('width', Math.max(excreted * S2, 1).toFixed(1));
      if (netR > 0) {
        netT.textContent = `${fmt(net)} mg per day`;
        netT.setAttribute('fill', TEAL);
        b2net.setAttribute('fill', TEAL);
        b2net.setAttribute('x', Z2.toFixed(1));
        b2net.setAttribute('width', Math.max(net * S2, 1).toFixed(1));
      } else if (netR < 0) {
        netT.textContent = '— (not defined in this sketch)';
        netT.setAttribute('fill', '#4b4b55');
        b2net.setAttribute('x', Z2.toFixed(1));
        b2net.setAttribute('width', '0');
      } else {
        netT.textContent = '0 mg per day';
        netT.setAttribute('fill', '#4b4b55');
        b2net.setAttribute('x', Z2.toFixed(1));
        b2net.setAttribute('width', '0');
      }

      // status
      const frTxt = fr.toFixed(2);
      const s1 = `In this sketch, the kidney filters ${fmt(filtered)} mg of calcium per day and reabsorbs ${frTxt} percent of it, so ${fmt(excreted)} mg per day (${fe.toFixed(2)} percent of the filtered load) is excreted.`;
      let s2: string;
      if (rel <= 0) {
        s2 = `In this sketch, with ${balanced ? 'bone in balance' : 'no net bone release'}, net intestinal absorption must equal that urinary excretion, ${fmt(net)} mg per day, for the whole body to stay in balance.`;
      } else if (netR > 0) {
        s2 = `In this sketch, bone releases a net ${fmt(rel)} mg per day, so net intestinal absorption must supply the other ${fmt(net)} mg per day of the ${fmt(excreted)} mg per day excreted.`;
      } else if (netR === 0) {
        s2 = `In this sketch, bone releases a net ${fmt(rel)} mg per day, which matches the ${fmt(excreted)} mg per day excreted, so zero net intestinal absorption keeps the whole body in balance.`;
      } else {
        s2 = `In this sketch, ${NEG}.`;
      }
      const isWorked = Math.round(gfr) === 125 && Math.round(ca) === 60 && Math.abs(fr - 98.15) < 0.001 && rel === 0;
      const ratio = excreted / 200;
      let s3: string;
      if (isWorked) {
        s3 = 'In this sketch, these settings reproduce the lesson’s worked problem: 10,800 mg per day filtered, 98.15 percent reabsorbed, about 200 mg per day excreted.';
      } else if (Math.abs(ratio - 1) < 0.005) {
        s3 = 'In this sketch, excretion is about the same as the worked problem’s 200 mg per day, reached with different settings.';
      } else {
        s3 = `In this sketch, excretion is ${ratio.toFixed(2)} times the worked problem’s 200 mg per day.`;
      }
      why.textContent = `${s1} ${s2} ${s3}`;
    }

    [gfrIn, caIn, frIn, relIn].forEach((s) => s.addEventListener('input', render));
    balIn.addEventListener('change', render);
    render();
  });
</script>

<style>
  .cpl { padding: var(--ddp-space-3) var(--ddp-space-4) var(--ddp-space-4); margin: var(--ddp-space-5) 0; }
  .cpl-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem; font-weight: 600; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); margin-bottom: var(--ddp-space-3); }
  .cpl-chip { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 400; color: var(--ddp-color-muted); }
  .cpl-svg { display: block; width: 100%; max-width: 560px; margin: 0 auto; height: auto; background: #fff; border: 1px solid var(--ddp-color-line); border-radius: 6px; }
  .cpl-controls { display: grid; grid-template-columns: 1fr 1fr; gap: var(--ddp-space-2) var(--ddp-space-4); margin: var(--ddp-space-3) 0 var(--ddp-space-2); }
  .cpl-slabel { display: flex; flex-direction: column; gap: 0.1rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .cpl-slabel small { font-size: inherit; color: var(--ddp-color-muted); }
  .cpl-slabel em { font-style: normal; font-weight: 700; color: var(--ddp-color-accent); font-family: var(--ddp-font-mono); }
  .cpl-slabel input { accent-color: var(--ddp-color-accent); }
  .cpl-bone { display: flex; flex-direction: column; gap: var(--ddp-space-2); }
  .cpl-check { display: flex; align-items: flex-start; gap: 0.4rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); cursor: pointer; }
  .cpl-check input { accent-color: var(--ddp-color-accent); margin-top: 0.15rem; }
  .cpl-check input:focus-visible, .cpl-slabel input:focus-visible { outline: 2px solid var(--ddp-color-accent); outline-offset: 2px; }
  .cpl-readout { display: grid; grid-template-columns: 1fr; gap: var(--ddp-space-2); margin: var(--ddp-space-2) 0; padding: var(--ddp-space-2) var(--ddp-space-3); background: color-mix(in srgb, var(--ddp-color-accent) 8%, transparent); border-radius: 6px; }
  .cpl-readout div { display: flex; flex-direction: column; gap: 0.1rem; }
  .cpl-readout dt { font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .cpl-readout dd { margin: 0; font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); color: var(--ddp-color-primary); font-weight: 700; overflow-wrap: anywhere; }
  .cpl-why { margin: 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); line-height: 1.5; min-height: 8em; }
  .cpl-assume { margin: var(--ddp-space-2) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); line-height: 1.45; }
  .cpl-foot { margin: var(--ddp-space-3) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); border-left: 3px solid var(--ddp-color-secondary); padding-left: 0.55rem; }
  @media (max-width: 520px) {
    .cpl-controls { grid-template-columns: 1fr; }
    .cpl-why { min-height: 12em; }
  }
</style>
