---
/**
 * HormoneHalfLifeDecay — the lesson's worked problem as a plot: after secretion stops,
 * plasma concentration follows C(t) = C0 x 2^(-t / t-half). Sliders set the half-life and a
 * time cursor; a switch shows or hides a faint 5 min peptide curve for illustration.
 * Self-contained vanilla-TS Astro island. Original.
 */
---

<figure class="hh card" data-hhl>
  <figcaption class="hh-head">Hormone half-life — how fast a level can follow its gland<span class="hh-chip">⚙ original · interactive</span></figcaption>

  <svg class="hh-svg" viewBox="0 0 340 240" role="img" aria-label="Plot of plasma concentration in nmol per L against minutes after secretion stops, falling by half every half-life, with guides at 200, 100 and 50 nmol per L and a movable time cursor" data-plot></svg>

  <div class="hh-controls">
    <label class="hh-slabel"><span>Half-life t<sub>half</sub> <em data-out="th">75</em> min</span>
      <input type="range" data-in="th" min="5" max="90" step="1" value="75" list="hh-marks" />
      <datalist id="hh-marks"><option value="5"></option><option value="75"></option></datalist>
      <small>Marks: 75 = cortisol, chosen within the textbook range of about 60 to 90 min; 5 = peptide, for illustration.</small>
    </label>
    <label class="hh-slabel"><span>Time cursor t <em data-out="t">150</em> min after secretion stops</span>
      <input type="range" data-in="t" min="0" max="300" step="1" value="150" />
    </label>
    <label class="hh-check"><input type="checkbox" data-in="pep" checked /> Show the 5 min peptide curve (illustration)</label>
  </div>

  <dl class="hh-readout">
    <div><dt>Half-lives elapsed, t / t<sub>half</sub></dt><dd data-r="n"></dd></div>
    <div><dt>Concentration at the cursor</dt><dd data-r="c"></dd></div>
    <div><dt>Time to fall to 50 nmol per L (3 halvings)</dt><dd data-r="t50"></dd></div>
    <div data-pep-row><dt>5 min peptide at the cursor</dt><dd data-r="p"></dd></div>
  </dl>

  <p class="hh-assume">In this sketch: adult human plasma cortisol (or an invented peptide), C0 = 400 nmol per L, secretion stopped completely at time zero, constant blood volume, first-order elimination; invented numbers.</p>
  <p class="hh-why" data-why role="status"></p>

  <p class="hh-foot">Each half-life halves the level: C(t) = C0 × 2<sup>−t / t-half</sup>. A short half-life lets the plasma level track secretion within minutes; a long one smooths out pulses.</p>
</figure>

<script>
  const NS = 'http://www.w3.org/2000/svg';
  const ACCENT = '#0e7c86', ORANGE = '#e57200', INK = '#4b4b55', FAINT = '#b9b9c2', PEPT = '#9a8fc4';
  const C0 = 400, TMAX = 300, T_PEP = 5;
  function el(name: string, attrs: Record<string, string | number>): SVGElement {
    const e = document.createElementNS(NS, name);
    for (const k in attrs) e.setAttribute(k, String(attrs[k]));
    return e;
  }
  const conc = (t: number, th: number) => C0 * Math.pow(2, -t / th);
  function fmtC(v: number): string {
    if (v >= 100) return v.toFixed(0);
    if (v >= 1) return v.toFixed(2).replace(/\.?0+$/, '');
    if (v >= 0.01) return v.toFixed(3);
    return '< 0.01 (effectively zero in this sketch)';
  }
  function fmtN(v: number): string {
    return Math.abs(v - Math.round(v)) < 1e-9 ? String(Math.round(v)) : v.toFixed(2).replace(/\.?0+$/, '');
  }

  document.querySelectorAll<HTMLElement>('[data-hhl]').forEach((root) => {
    const plot = root.querySelector<SVGSVGElement>('[data-plot]');
    const thIn = root.querySelector<HTMLInputElement>('[data-in="th"]');
    const tIn = root.querySelector<HTMLInputElement>('[data-in="t"]');
    const pepIn = root.querySelector<HTMLInputElement>('[data-in="pep"]');
    const thOut = root.querySelector<HTMLElement>('[data-out="th"]');
    const tOut = root.querySelector<HTMLElement>('[data-out="t"]');
    const rN = root.querySelector<HTMLElement>('[data-r="n"]');
    const rC = root.querySelector<HTMLElement>('[data-r="c"]');
    const rT50 = root.querySelector<HTMLElement>('[data-r="t50"]');
    const rP = root.querySelector<HTMLElement>('[data-r="p"]');
    const pepRow = root.querySelector<HTMLElement>('[data-pep-row]');
    const why = root.querySelector<HTMLElement>('[data-why]');
    if (!plot || !thIn || !tIn || !pepIn || !thOut || !tOut || !rN || !rC || !rT50 || !rP || !pepRow || !why) return;

    const X0 = 44, X1 = 328, Y0 = 22, Y1 = 192;
    const px = (t: number) => X0 + (t / TMAX) * (X1 - X0);
    const py = (c: number) => Y1 - (c / C0) * (Y1 - Y0);
    function path(th: number): string {
      let d = '';
      for (let t = 0; t <= TMAX; t += 1) d += (t === 0 ? 'M' : 'L') + px(t).toFixed(1) + ' ' + py(conc(t, th)).toFixed(1) + ' ';
      return d.trim();
    }
    function text(x: number, y: number, s: string, extra: Record<string, string | number> = {}) {
      const t = el('text', { x, y, 'font-size': 9, fill: INK, ...extra });
      t.textContent = s;
      plot!.appendChild(t);
    }

    function label(th: number): string {
      if (th === 5) return 'peptide, for illustration (5 min)';
      if (th >= 60 && th <= 90) return 'cortisol, ' + th + ' min (textbook range ~60 to 90)';
      return 'illustrative ' + th + ' min half-life';
    }

    function render() {
      const th = parseInt(thIn!.value, 10);
      const t = parseInt(tIn!.value, 10);
      const showPep = pepIn!.checked;
      thOut!.textContent = String(th);
      tOut!.textContent = String(t);
      plot!.replaceChildren();

      // axes
      plot!.appendChild(el('line', { x1: X0, y1: Y0, x2: X0, y2: Y1, stroke: INK, 'stroke-width': 1 }));
      plot!.appendChild(el('line', { x1: X0, y1: Y1, x2: X1, y2: Y1, stroke: INK, 'stroke-width': 1 }));
      // guides
      for (const g of [200, 100, 50]) {
        plot!.appendChild(el('line', { x1: X0, y1: py(g), x2: X1, y2: py(g), stroke: FAINT, 'stroke-width': 0.8, 'stroke-dasharray': '2 3' }));
      }
      for (const g of [400, 200, 100, 50, 0]) text(X0 - 4, py(g) + 3, String(g), { 'text-anchor': 'end' });
      for (let m = 0; m <= TMAX; m += 50) {
        plot!.appendChild(el('line', { x1: px(m), y1: Y1, x2: px(m), y2: Y1 + 3, stroke: INK, 'stroke-width': 1 }));
        text(px(m), Y1 + 14, String(m), { 'text-anchor': 'middle' });
      }
      text((X0 + X1) / 2, Y1 + 29, 'minutes after secretion stops', { 'text-anchor': 'middle', 'font-size': 10 });
      text(X0 - 2, Y0 - 9, 'plasma concentration (nmol per L)', { 'font-size': 10 });

      // peptide curve (faint)
      if (showPep && th !== T_PEP) {
        plot!.appendChild(el('path', { d: path(T_PEP), fill: 'none', stroke: PEPT, 'stroke-width': 1.6, 'stroke-dasharray': '4 3', opacity: 0.8 }));
      }
      // main curve
      plot!.appendChild(el('path', { d: path(th), fill: 'none', stroke: ACCENT, 'stroke-width': 2.6 }));

      // halving ticks on the guides: where each halving is reached
      [1, 2, 3].forEach((k) => {
        const tk = k * th;
        if (tk <= TMAX) plot!.appendChild(el('circle', { cx: px(tk), cy: py(C0 / Math.pow(2, k)), r: 2.6, fill: '#fff', stroke: ACCENT, 'stroke-width': 1.4 }));
      });

      // cursor
      plot!.appendChild(el('line', { x1: px(t), y1: Y0, x2: px(t), y2: Y1, stroke: ORANGE, 'stroke-width': 1.3, 'stroke-dasharray': '3 2' }));
      const c = conc(t, th), cp = conc(t, T_PEP);
      plot!.appendChild(el('circle', { cx: px(t), cy: py(c), r: 4, fill: ORANGE }));
      if (showPep && th !== T_PEP) plot!.appendChild(el('circle', { cx: px(t), cy: py(cp), r: 3.2, fill: PEPT }));

      // legend (top right, clear of the curves)
      const LX = 176, LY = 30, LW = 164, LH = showPep && th !== T_PEP ? 38 : 24;
      plot!.appendChild(el('rect', { x: LX - 4, y: LY - 11, width: LW, height: LH, fill: '#fff', 'fill-opacity': 0.92, stroke: FAINT, 'stroke-width': 0.6, rx: 3 }));
      plot!.appendChild(el('line', { x1: LX, y1: LY - 2, x2: LX + 14, y2: LY - 2, stroke: ACCENT, 'stroke-width': 2.6 }));
      text(LX + 18, LY + 1, th === T_PEP ? 'peptide, 5 min (illustration)' : th >= 60 && th <= 90 ? 'cortisol (textbook range), ' + th + ' min' : 'illustrative, ' + th + ' min');
      if (showPep && th !== T_PEP) {
        plot!.appendChild(el('line', { x1: LX, y1: LY + 12, x2: LX + 14, y2: LY + 12, stroke: PEPT, 'stroke-width': 1.6, 'stroke-dasharray': '4 3' }));
        text(LX + 18, LY + 15, 'peptide, 5 min (illustration)');
      }

      // readouts
      const n = t / th;
      rN!.textContent = t + ' / ' + th + ' = ' + fmtN(n) + (n === 1 ? ' half-life' : ' half-lives');
      const frac = Number.isInteger(n) && n <= 6 ? ' = ' + C0 + ' × 1/' + Math.pow(2, n) : '';
      rC!.textContent = C0 + ' × 2^' + (n === 0 ? '0' : '-' + fmtN(n)) + frac + ' = ' + fmtC(c) + ' nmol per L';
      rT50!.textContent = '3 × ' + th + ' = ' + 3 * th + ' min';
      const pepShown = showPep;
      pepRow!.hidden = !pepShown;
      const np = t / T_PEP;
      rP!.textContent = C0 + ' × 2^' + (np === 0 ? '0' : '-' + fmtN(np)) + ' = ' + fmtC(cp) + ' nmol per L';

      // status
      let s = 'In this sketch, ' + t + ' min after secretion stops is ' + fmtN(n) + (n === 1 ? ' half-life' : ' half-lives') + ' for ' + label(th) + ', so the level is ' + fmtC(c) + ' nmol per L (start 400). It falls to 50 nmol per L at 3 × ' + th + ' = ' + 3 * th + ' min. ';
      if (showPep && th !== T_PEP) s += 'The 5 min illustrative peptide would be at ' + fmtC(cp) + ' nmol per L. ';
      if (th <= 10) s += 'A short half-life lets the plasma level track secretion within minutes. ';
      else if (th >= 60) s += 'A long half-life smooths out pulses. ';
      else s += 'The longer the half-life, the more slowly the plasma level can follow a change in secretion. ';
      s += 'This is a model, not an intact axis: real hormones are not secreted at one steady rate or switched off outright; secretion varies and often comes in pulses.';
      why!.textContent = s;
    }
    [thIn, tIn, pepIn].forEach((s) => s.addEventListener('input', render));
    pepIn.addEventListener('change', render);
    render();
  });
</script>

<style>
  .hh { padding: var(--ddp-space-3) var(--ddp-space-4) var(--ddp-space-4); margin: var(--ddp-space-5) 0; }
  .hh-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem; font-weight: 600; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); margin-bottom: var(--ddp-space-3); }
  .hh-chip { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 400; color: var(--ddp-color-muted); }
  .hh-svg { display: block; width: 100%; max-width: 560px; margin: 0 auto; height: auto; background: #fff; border: 1px solid var(--ddp-color-line); border-radius: 6px; }
  .hh-controls { display: grid; grid-template-columns: 1fr 1fr; gap: var(--ddp-space-2) var(--ddp-space-4); margin: var(--ddp-space-3) 0 var(--ddp-space-2); }
  .hh-slabel { display: flex; flex-direction: column; gap: 0.1rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .hh-slabel small { font-size: inherit; color: var(--ddp-color-muted); }
  .hh-slabel em { font-style: normal; font-weight: 700; color: var(--ddp-color-accent); font-family: var(--ddp-font-mono); }
  .hh-slabel input { accent-color: var(--ddp-color-accent); }
  .hh-check { grid-column: 1 / -1; display: flex; align-items: center; gap: 0.4rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .hh-check input { accent-color: var(--ddp-color-accent); }
  .hh-readout { display: grid; grid-template-columns: 1fr 1fr; gap: var(--ddp-space-2); margin: var(--ddp-space-2) 0; padding: var(--ddp-space-2) var(--ddp-space-3); background: color-mix(in srgb, var(--ddp-color-accent) 8%, transparent); border-radius: 6px; }
  .hh-readout div { display: flex; flex-direction: column; gap: 0.1rem; min-width: 0; }
  .hh-readout div[hidden] { display: none; }
  .hh-readout dt { font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .hh-readout dd { margin: 0; font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); color: var(--ddp-color-primary); font-weight: 700; overflow-wrap: anywhere; }
  .hh-assume { margin: 0 0 var(--ddp-space-2); font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .hh-why { margin: 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); line-height: 1.5; min-height: 6em; }
  .hh-foot { margin: var(--ddp-space-3) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); border-left: 3px solid var(--ddp-color-secondary); padding-left: 0.55rem; }
  @media (max-width: 560px) {
    .hh-controls, .hh-readout { grid-template-columns: 1fr; }
  }
</style>
