---
/**
 * LateralizationBaseRate — an icon array of 1,000 people made of strong right-handers
 * and strong left-handers. Knecht and colleagues' (2000) rates are held fixed (right-
 * hemisphere dominance in 4% of strong right-handers, 27% of strong left-handers); the
 * learner moves only the share of strong left-handers and switches between the two
 * conditional probabilities. Expected values, no random draws. Original.
 */
---

<figure class="lbr card" data-lbr>
  <figcaption class="lbr-head">Lateralization is a probability — the base rate decides the answer<span class="lbr-chip">⚙ original · interactive</span></figcaption>

  <svg class="lbr-svg" viewBox="0 0 400 300" role="img" aria-label="An array of 1,000 people, strong right-handers first and strong left-handers last, with the right-language-dominant people highlighted" data-plot></svg>

  <div class="lbr-controls">
    <label class="lbr-slabel"><span>Strong left-handers in this population <em data-out="share">50</em>%</span>
      <input type="range" data-in="share" min="0" max="100" step="1" value="50" />
    </label>
    <div class="lbr-presets" role="group" aria-label="Presets for the share of strong left-handers">
      <button type="button" class="lbr-btn" data-preset="50">50% (100 plus 100)</button>
      <button type="button" class="lbr-btn" data-preset="10">10%</button>
    </div>
    <fieldset class="lbr-q">
      <legend>Question</legend>
      <label><input type="radio" name="lbr-q" value="A" checked /> Of the right-language-dominant people, how many are left-handers? P(left-hander | right-language dominance)</label>
      <label><input type="radio" name="lbr-q" value="B" /> Of the left-handers, how many are right-dominant? P(right-language dominance | left-hander)</label>
    </fieldset>
  </div>

  <dl class="lbr-readout">
    <div><dt>Right-language-dominant right-handers</dt><dd data-r-rh></dd></div>
    <div><dt>Right-language-dominant left-handers</dt><dd data-r-lh></dd></div>
    <div><dt>Right-language-dominant overall</dt><dd data-r-all></dd></div>
    <div><dt data-r-qname></dt><dd data-r-q></dd></div>
    <div><dt>The other conditional</dt><dd data-r-other></dd></div>
    <div><dt>Share of right-language-dominant people</dt><dd data-r-split></dd></div>
  </dl>
  <p class="lbr-why" data-why role="status"></p>

  <p class="lbr-assume">In this sketch: Knecht’s rates are fixed probabilities (4% and 27%), the cohort sizes are assumed, and ambidextrous people and everyone between the extremes are left out. Rates are for language dominance by functional transcranial Doppler during word generation, in healthy adults (Knecht and colleagues, 2000); left-language-dominant means not right-language-dominant here. Counts are expected values per 1,000; icons are rounded to whole people.</p>
  <p class="lbr-foot">The rates did not change, the base rate did: P(right-language dominance | left-hander) stays 27%, while P(left-hander | right-language dominance) depends on how many left-handers there are. Most left-handers are still left-language-dominant, and lateralization is function by function. The personality claim of “left-brained” or “right-brained” people is not supported by the evidence (a resting-state fMRI analysis of more than 1,000 people, Nielsen and colleagues, 2013, found no global left or right dominance).</p>
</figure>

<script>
  const NS = 'http://www.w3.org/2000/svg';
  const INK = '#4b4b55';
  const C_RH = '#d6d9e2', C_LH = '#a9dde0', C_RH_D = '#e57200', C_LH_D = '#a3195b';
  const P_RH = 0.04, P_LH = 0.27; // Knecht and colleagues (2000)
  const N = 1000;
  function el(name: string, attrs: Record<string, string | number>): SVGElement {
    const e = document.createElementNS(NS, name);
    for (const k in attrs) e.setAttribute(k, String(attrs[k]));
    return e;
  }
  const pct = (x: number) => (100 * x).toFixed(1) + '%';
  const num = (x: number) => String(Math.round(x * 10) / 10);
  const dec = (x: number) => String(Math.round(x * 1e6) / 1e6);

  // The model: fractions of the population, p = share of strong left-handers.
  function model(p: number) {
    const rh = (1 - p) * P_RH, lh = p * P_LH, all = rh + lh; // all > 0 for every p
    return { rh, lh, all, post: lh / all, rev: P_LH };
  }

  document.querySelectorAll<HTMLElement>('[data-lbr]').forEach((root) => {
    const must = <T extends Element>(sel: string): T => {
      const e = root.querySelector<T>(sel);
      if (!e) throw new Error('missing ' + sel);
      return e;
    };
    const plot = must<SVGSVGElement>('[data-plot]');
    const slider = must<HTMLInputElement>('[data-in="share"]');
    const shareOut = must<HTMLElement>('[data-out="share"]');
    const rRh = must<HTMLElement>('[data-r-rh]');
    const rLh = must<HTMLElement>('[data-r-lh]');
    const rAll = must<HTMLElement>('[data-r-all]');
    const rQName = must<HTMLElement>('[data-r-qname]');
    const rQ = must<HTMLElement>('[data-r-q]');
    const rOther = must<HTMLElement>('[data-r-other]');
    const rSplit = must<HTMLElement>('[data-r-split]');
    const why = must<HTMLElement>('[data-why]');
    const radios = root.querySelectorAll<HTMLInputElement>('input[name="lbr-q"]');

    const COLS = 40, DX = 9.5, X0 = 12, Y0 = 10;
    function question(): 'A' | 'B' {
      let q: 'A' | 'B' = 'A';
      radios.forEach((r) => { if (r.checked) q = r.value === 'B' ? 'B' : 'A'; });
      return q;
    }

    function render() {
      const k = parseInt(slider.value, 10);
      const p = k / 100;
      const q = question();
      const m = model(p);
      const L = Math.round(N * p), R = N - L;
      const dR = Math.round(R * P_RH), dL = Math.round(L * P_LH); // rounded icons
      shareOut.textContent = String(k);

      plot.replaceChildren();
      for (let i = 0; i < N; i++) {
        const isLH = i >= R;
        const idx = isLH ? i - R : i;
        const dominant = idx < (isLH ? dL : dR);
        let fill = isLH ? C_LH : C_RH, op = 1;
        if (dominant) fill = isLH ? C_LH_D : C_RH_D;
        // dimming: question A looks at the right-language-dominant people; B at the left-handers
        if (q === 'A' && !dominant) op = 0.35;
        if (q === 'B' && !isLH) op = 0.25;
        const c = el('circle', { cx: X0 + (i % COLS) * DX, cy: Y0 + Math.floor(i / COLS) * DX, r: 3.4, fill, opacity: op });
        plot.appendChild(c);
      }
      // legend
      const items: [string, string, number, number][] = [
        [C_RH, 'right-hander, left-language-dominant', 8, 272],
        [C_LH, 'left-hander, left-language-dominant', 8, 287],
        [C_RH_D, 'right-language-dominant right-hander', 206, 272],
        [C_LH_D, 'right-language-dominant left-hander', 206, 287],
      ];
      for (const [col, txt, x, y] of items) {
        plot.appendChild(el('circle', { cx: x + 4, cy: y - 3, r: 3.4, fill: col }));
        const t = el('text', { x: x + 12, y, 'font-size': 9, fill: INK });
        t.textContent = txt; plot.appendChild(t);
      }
      const note = el('text', { x: 8, y: 254, 'font-size': 9, fill: INK });
      note.textContent = 'Each dot is one person. Strong right-handers first, then strong left-handers.';
      plot.appendChild(note);

      rRh.textContent = `${num(N * m.rh)} (= ${num(N * (1 - p))} × 0.04)`;
      rLh.textContent = `${num(N * m.lh)} (= ${num(N * p)} × 0.27)`;
      rAll.textContent = `${num(N * m.all)} of 1,000 = ${pct(m.all)}`;
      const frac = `share of everyone: ${dec((1 - p) * P_RH)} + ${dec(p * P_LH)} = ${dec(m.all)}`;
      const postStr = `${num(N * m.lh)} / ${num(N * m.all)} = ${pct(m.post)}`;
      const revStr = `27% (0.27, whatever the base rate)`;
      if (q === 'A') {
        rQName.textContent = 'P(left-hander | right-language dominance)';
        rQ.textContent = postStr;
        rOther.textContent = 'P(right-language dominance | left-hander) = ' + revStr;
      } else {
        rQName.textContent = 'P(right-language dominance | left-hander)';
        rQ.textContent = k === 0 ? 'no left-handers in this population' : revStr;
        rOther.textContent = 'P(left-hander | right-language dominance) = ' + pct(m.post);
      }
      rSplit.textContent = `left-handers ${pct(m.post)} + right-handers ${pct(1 - m.post)} = 100%`;
      root.setAttribute('data-post', String(m.post));
      root.setAttribute('data-rev', String(m.rev));

      let s = '';
      if (k === 0) {
        s = `With no strong left-handers, every right-language-dominant person is a strong right-hander: the posterior is 0%. In this sketch the 4% rate gives ${num(N * m.rh)} right-language-dominant people in 1,000, and the 27% rate has no one to apply to.`;
      } else if (k === 100) {
        s = `With only strong left-handers, every right-language-dominant person is a left-hander (100%), yet in this sketch the 27% rate still leaves ${num(N * (1 - P_LH))} of 1,000 left-language-dominant: most left-handers are still left-language-dominant.`;
      } else if (q === 'A') {
        s = `${frac}. Of the right-language-dominant people in this sketch, ${pct(m.post)} are strong left-handers, because the 27% rate is applied to ${num(N * p)} left-handers and the 4% rate to ${num(N * (1 - p))} right-handers. The rates did not change; the base rate did.`;
      } else {
        s = `In this sketch ${num(N * m.lh)} of ${num(N * p)} strong left-handers are right-language-dominant, 27% at every base rate, so most left-handers are still left-language-dominant (${num(N * p - N * m.lh)} of ${num(N * p)}). Move the slider: this conditional does not move, while the other one does.`;
      }
      if (k === 50 && q === 'A') s += ' This is the lesson’s 100 plus 100: 4 + 27 = 31 of 200, 27 / 31.';
      if (k === 10 && q === 'A') s += ' This is the lesson’s part (b): 0.036 + 0.027 = 0.063, and 0.027 / 0.063.';
      why.textContent = s;
    }
    slider.addEventListener('input', render);
    radios.forEach((r) => r.addEventListener('change', render));
    root.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach((b) => {
      b.addEventListener('click', () => { slider.value = b.dataset.preset ?? '50'; render(); });
    });
    render();
  });
</script>

<style>
  .lbr { padding: var(--ddp-space-3) var(--ddp-space-4) var(--ddp-space-4); margin: var(--ddp-space-5) 0; }
  .lbr-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem; font-weight: 600; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); margin-bottom: var(--ddp-space-3); }
  .lbr-chip { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 400; color: var(--ddp-color-muted); }
  .lbr-svg { display: block; width: 100%; max-width: 560px; margin: 0 auto; height: auto; background: #fff; border: 1px solid var(--ddp-color-line); border-radius: 6px; }
  .lbr-controls { display: flex; flex-direction: column; gap: var(--ddp-space-2); margin: var(--ddp-space-3) 0 var(--ddp-space-2); }
  .lbr-slabel { display: flex; flex-direction: column; gap: 0.1rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .lbr-slabel em { font-style: normal; font-weight: 700; color: var(--ddp-color-accent); font-family: var(--ddp-font-mono); }
  .lbr-slabel input { accent-color: var(--ddp-color-accent); }
  .lbr-presets { display: flex; flex-wrap: wrap; gap: var(--ddp-space-2); }
  .lbr-btn { font-size: var(--ddp-text-xs); padding: 0.25rem 0.6rem; border: 1px solid var(--ddp-color-line); border-radius: 6px; background: #fff; color: var(--ddp-color-ink-soft); cursor: pointer; }
  .lbr-btn:hover, .lbr-btn:focus-visible { border-color: var(--ddp-color-accent); color: var(--ddp-color-primary); }
  .lbr-q { border: 1px solid var(--ddp-color-line); border-radius: 6px; padding: 0.3rem 0.6rem; margin: 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .lbr-q legend { padding: 0 0.3rem; color: var(--ddp-color-muted); }
  .lbr-q label { display: block; margin: 0.15rem 0; }
  .lbr-q input { accent-color: var(--ddp-color-accent); }
  .lbr-readout { display: grid; grid-template-columns: 1fr 1fr; gap: var(--ddp-space-2); margin: var(--ddp-space-2) 0; padding: var(--ddp-space-2) var(--ddp-space-3); background: color-mix(in srgb, var(--ddp-color-accent) 8%, transparent); border-radius: 6px; }
  .lbr-readout div { display: flex; flex-direction: column; gap: 0.1rem; min-width: 0; }
  .lbr-readout dt { font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .lbr-readout dd { margin: 0; font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); color: var(--ddp-color-primary); font-weight: 700; overflow-wrap: anywhere; }
  .lbr-why { margin: 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); line-height: 1.5; min-height: 6em; }
  .lbr-assume { margin: var(--ddp-space-2) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .lbr-foot { margin: var(--ddp-space-3) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); border-left: 3px solid var(--ddp-color-secondary); padding-left: 0.55rem; }
  @media (max-width: 520px) { .lbr-readout { grid-template-columns: 1fr; } }
</style>
