---
/**
 * PulsatileHormoneSampler — a 24-hour plasma growth-hormone trace built from invented
 * pulses that decay with the one measured number in the lesson, the 27-minute average
 * half-life after intravenous GH (Parker, Utiger and Daughaday, 1962, five people).
 * C(t) = sum over pulses of A_i x 2^(-(t - t_i) / 27 min) for t at or after t_i, with
 * instantaneous release and no baseline secretion. Three controls: pulse interval,
 * sleep-onset time, sampling time. Self-contained vanilla-TS Astro island. Original.
 */
---

<figure class="pgs card" data-pgs>
  <figcaption class="pgs-head">One sample, many answers — a pulsatile hormone<span class="pgs-chip">⚙ original · interactive</span></figcaption>

  <svg class="pgs-svg" viewBox="0 0 340 236" role="img" aria-label="A 24-hour plasma growth hormone trace made of invented pulses that each decay with a 27-minute average half-life, with one marked sample and the 24-hour mean" data-plot></svg>

  <div class="pgs-controls">
    <label class="pgs-slabel"><span>Pulse interval <em data-out="int">3.0 h</em> <small>(illustrative)</small></span>
      <input type="range" data-in="int" min="2" max="4" step="0.25" value="3" aria-describedby="pgs-assume" />
    </label>
    <fieldset class="pgs-fs">
      <legend>Sleep onset <small>(illustrative times; moves the large pulse)</small></legend>
      <label class="pgs-radio"><input type="radio" name="pgs-sleep" value="960" data-in="sleep" checked /> 23:00</label>
      <label class="pgs-radio"><input type="radio" name="pgs-sleep" value="1140" data-in="sleep" /> 02:00</label>
    </fieldset>
    <label class="pgs-slabel pgs-wide"><span>Sampling time <em data-out="samp">09:55</em> <small>(one sample; arrow keys move it one minute)</small></span>
      <input type="range" data-in="samp" min="0" max="1439" step="1" value="175" aria-describedby="pgs-assume" />
    </label>
  </div>

  <dl class="pgs-readout">
    <div><dt>Single sample reads (relative units)</dt><dd data-r-read>0</dd></div>
    <div><dt>24-hour mean (relative units)</dt><dd data-r-mean>0</dd></div>
    <div><dt>Lowest and highest over the 24 h</dt><dd data-r-range>0</dd></div>
    <div><dt>Same sample drawn 10 min later</dt><dd data-r-later>0</dd></div>
    <div class="pgs-full"><dt>The reading, step by step</dt><dd class="pgs-sum" data-r-sum>0</dd></div>
  </dl>
  <p class="pgs-why" data-why role="status">In this sketch, the status appears here.</p>

  <p class="pgs-assume" id="pgs-assume">In this sketch: the 27-minute average half-life is the only measured number (people, average after large intravenous doses of GH in a 1962 study of five people; individual values 23 to 38 minutes, and not a constant). Everything else is made up for the sketch: a daytime pulse is 1 relative unit and the sleep-onset pulse is 3; pulses come every interval from 07:00 until sleep onset and none follow it; release is instantaneous (real secretion is not instantaneous; in the 1968 study of eight young adults, seven had a major peak at the onset of deep sleep that lasted 1.5 to 3.5 hours); a later onset also adds daytime pulses; there is no baseline secretion and nothing carries over from the day before.</p>
  <p class="pgs-foot">Keep this: with a 27-minute average half-life, a single sample mostly reflects the last hour, so one reading can depend on when it was drawn as much as on how much was secreted, and a mean from frequent sampling over 24 hours is steadier.</p>
</figure>

<script>
  const NS = 'http://www.w3.org/2000/svg';
  const ACCENT = '#0e7c86', ORANGE = '#e57200', INK = '#4b4b55', FAINT = '#b9b9c2';
  const HALF = 27;                       // minutes, measured (average, adult humans, IV GH)
  const TAU = HALF / Math.LN2;           // integral of 2^(-t/HALF) over t >= 0, in minutes
  const DAY = 1440;                      // trace runs 07:00 to 07:00 next day
  const START = 7 * 60;                  // clock minute of the trace start

  type Pulse = { t: number; a: number };

  function el(name: string, attrs: Record<string, string | number>): SVGElement {
    const e = document.createElementNS(NS, name);
    for (const k in attrs) e.setAttribute(k, String(attrs[k]));
    return e;
  }
  function need<T extends Element>(root: ParentNode, sel: string): T {
    const e = root.querySelector<T>(sel);
    if (!e) throw new Error('PulsatileHormoneSampler: missing ' + sel);
    return e;
  }
  const clock = (m: number) => {
    const c = (START + Math.round(m)) % DAY;
    return String(Math.floor(c / 60)).padStart(2, '0') + ':' + String(c % 60).padStart(2, '0');
  };
  const fmt = (v: number) => (v < 0.1 ? v.toFixed(3) : v < 10 ? v.toFixed(2) : v.toFixed(1));
  const fmtLo = (v: number) => (v < 0.001 ? 'below 0.001' : fmt(v));
  const fold = (v: number) => (v < 10 ? v.toFixed(1) : String(Math.round(v)));

  function makePulses(intervalH: number, onset: number): Pulse[] {
    const out: Pulse[] = [];
    for (let t = 0; t < onset - 0.001; t += intervalH * 60) out.push({ t, a: 1 });
    out.push({ t: onset, a: 3 });
    return out;
  }
  function conc(pulses: Pulse[], m: number): number {
    let c = 0;
    for (const p of pulses) if (m >= p.t) c += p.a * Math.pow(2, -(m - p.t) / HALF);
    return c;
  }
  function meanOver(pulses: Pulse[]): number {
    let area = 0;
    for (const p of pulses) area += p.a * TAU * (1 - Math.pow(2, -(DAY - p.t) / HALF));
    return area / DAY;
  }

  document.querySelectorAll<HTMLElement>('[data-pgs]').forEach((root) => {
    const plot = need<SVGSVGElement>(root, '[data-plot]');
    const intIn = need<HTMLInputElement>(root, '[data-in="int"]');
    const sampIn = need<HTMLInputElement>(root, '[data-in="samp"]');
    const sleepIns = Array.from(root.querySelectorAll<HTMLInputElement>('[data-in="sleep"]'));
    const intOut = need<HTMLElement>(root, '[data-out="int"]');
    const sampOut = need<HTMLElement>(root, '[data-out="samp"]');
    const rRead = need<HTMLElement>(root, '[data-r-read]');
    const rMean = need<HTMLElement>(root, '[data-r-mean]');
    const rRange = need<HTMLElement>(root, '[data-r-range]');
    const rLater = need<HTMLElement>(root, '[data-r-later]');
    const rSum = need<HTMLElement>(root, '[data-r-sum]');
    const why = need<HTMLElement>(root, '[data-why]');

    const X0 = 40, X1 = 326, Y0 = 34, Y1 = 188, YMAX = 4;
    const px = (m: number) => X0 + (m / DAY) * (X1 - X0);
    const py = (c: number) => Y1 - (c / YMAX) * (Y1 - Y0);

    function text(x: number, y: number, s: string, extra: Record<string, string | number> = {}) {
      const t = el('text', { x, y, 'font-size': 9, fill: INK, ...extra });
      t.textContent = s;
      plot.appendChild(t);
      return t;
    }

    function render() {
      const intervalH = parseFloat(intIn.value);
      const samp = parseInt(sampIn.value, 10);
      const checked = sleepIns.find((r) => r.checked);
      const onset = checked ? parseInt(checked.value, 10) : 960;
      const pulses = makePulses(intervalH, onset);
      const mean = meanOver(pulses);

      intOut.textContent = intervalH.toFixed(2).replace(/0$/, '') + ' h';
      sampOut.textContent = clock(samp);
      sampIn.setAttribute('aria-valuetext', clock(samp));

      // trace
      let lo = Infinity, hi = 0;
      for (let m = 0; m < DAY; m++) { const c = conc(pulses, m); if (c < lo) lo = c; if (c > hi) hi = c; }
      let d = '';
      const pulseTimes = new Set(pulses.map((p) => p.t));
      for (let m = 0; m <= DAY; m += 3) {
        d += (m === 0 ? 'M' : 'L') + px(m).toFixed(1) + ' ' + py(conc(pulses, m)).toFixed(1) + ' ';
        // vertical rise at a pulse: go down to the value just before it first
        if (pulseTimes.has(m + 3)) d += 'L' + px(m + 3).toFixed(1) + ' ' + py(conc(pulses, m + 2.999)).toFixed(1) + ' ';
      }

      plot.replaceChildren();
      // legend
      const legY = 11;
      plot.appendChild(el('line', { x1: 6, y1: legY, x2: 20, y2: legY, stroke: ACCENT, 'stroke-width': 2.6 }));
      text(24, legY + 3, 'plasma GH, invented pulses');
      plot.appendChild(el('circle', { cx: 160, cy: legY, r: 4, fill: ORANGE }));
      text(167, legY + 3, 'one sample');
      plot.appendChild(el('line', { x1: 226, y1: legY, x2: 242, y2: legY, stroke: INK, 'stroke-width': 1.4, 'stroke-dasharray': '4 3' }));
      text(246, legY + 3, '24-hour mean');

      // axes
      plot.appendChild(el('line', { x1: X0, y1: Y0, x2: X0, y2: Y1, stroke: INK, 'stroke-width': 1 }));
      plot.appendChild(el('line', { x1: X0, y1: Y1, x2: X1, y2: Y1, stroke: INK, 'stroke-width': 1 }));
      for (const v of [0, 1, 2, 3, 4]) {
        if (v > 0) plot.appendChild(el('line', { x1: X0, y1: py(v), x2: X1, y2: py(v), stroke: FAINT, 'stroke-width': 0.6, 'stroke-dasharray': '2 3' }));
        text(X0 - 4, py(v) + 3, String(v), { 'text-anchor': 'end' });
      }
      for (let h = 0; h <= 24; h += 4) {
        const x = px(h * 60);
        plot.appendChild(el('line', { x1: x, y1: Y1, x2: x, y2: Y1 + 3, stroke: INK, 'stroke-width': 1 }));
        text(x, Y1 + 14, clock(h * 60), { 'text-anchor': 'middle' });
      }
      text((X0 + X1) / 2, Y1 + 30, 'clock time (trace runs 07:00 to 07:00 the next morning)', { 'text-anchor': 'middle' });
      const yl = text(0, 0, 'plasma GH (relative units)', { 'text-anchor': 'middle' });
      yl.setAttribute('transform', `translate(11 ${(Y0 + Y1) / 2}) rotate(-90)`);

      // mean line
      plot.appendChild(el('line', { x1: X0, y1: py(mean), x2: X1, y2: py(mean), stroke: INK, 'stroke-width': 1.4, 'stroke-dasharray': '4 3' }));
      // trace
      plot.appendChild(el('path', { d: d.trim(), fill: 'none', stroke: ACCENT, 'stroke-width': 2, 'stroke-linejoin': 'round' }));
      // sleep-onset label, to the left of the large pulse, clear of the trace
      text(px(onset) - 6, py(2.9), 'sleep-onset pulse', { 'text-anchor': 'end', 'font-weight': 700 });
      text(px(onset) - 6, py(2.9) + 11, '(3 × a daytime pulse, invented)', { 'text-anchor': 'end' });

      // sample marker
      const reading = conc(pulses, samp);
      plot.appendChild(el('line', { x1: px(samp), y1: py(reading), x2: px(samp), y2: Y1, stroke: ORANGE, 'stroke-width': 1.2, 'stroke-dasharray': '3 2' }));
      plot.appendChild(el('circle', { cx: px(samp), cy: py(reading), r: 4.5, fill: ORANGE, stroke: '#fff', 'stroke-width': 1 }));

      // readouts
      rRead.textContent = fmt(reading);
      rMean.textContent = fmt(mean);
      rRange.textContent = fmtLo(lo) + ' to ' + fmt(hi);
      const laterM = samp + 10;
      let laterTxt = '';
      let laterReading = 0;
      if (laterM < DAY) {
        laterReading = conc(pulses, laterM);
        rLater.textContent = fmt(laterReading) + ' (at ' + clock(laterM) + ')';
        const ratio = laterReading / reading;
        laterTxt = ratio > 1.05
          ? `drawn 10 minutes later it would read ${fmt(laterReading)}, ${fold(ratio)}-fold higher`
          : ratio < 0.95
            ? `drawn 10 minutes later it would read ${fmt(laterReading)}, ${fold(1 / ratio)}-fold lower`
            : `drawn 10 minutes later it would read about the same, ${fmt(laterReading)}`;
      } else {
        rLater.textContent = 'past the end of the trace';
      }

      // arithmetic: most recent pulse plus earlier ones
      let last = pulses[0];
      for (const p of pulses) if (p.t <= samp) last = p;
      const since = samp - last.t;
      const n = since / HALF;
      const lastTerm = last.a * Math.pow(2, -n);
      const a3 = Math.round(lastTerm * 1000) / 1000;
      const b3 = Math.round(reading * 1000) / 1000 - a3;
      rSum.textContent =
        `Most recent pulse: size ${last.a} at ${clock(last.t)}, ${since} min ago = ${n.toFixed(2)} half-lives, ` +
        `so ${last.a} × 2^−${n.toFixed(2)} = ${a3.toFixed(3)}. Earlier pulses add ${b3.toFixed(3)}. ` +
        `Reading = ${a3.toFixed(3)} + ${b3.toFixed(3)} = ${(a3 + b3).toFixed(3)} relative units.`;

      const vsMean = reading / mean;
      const s1 = `In this sketch, a sample drawn at ${clock(samp)} reads ${fmt(reading)} relative units, ${vsMean < 10 ? vsMean.toFixed(2) : vsMean.toFixed(1)} times the 24-hour mean of ${fmt(mean)}.`;
      const s2 = laterTxt ? ` In this sketch, ${laterTxt}.` : '';
      const s3 = ` In this sketch, the trace runs from ${fmtLo(lo)} to ${fmt(hi)} relative units while the 24-hour mean stays ${fmt(mean)} wherever the sample is drawn.`;
      const s4 = ` In this sketch, the large pulse sits at the chosen sleep onset, ${clock(onset)}, and the pulse sizes and times are invented.`;
      why.textContent = s1 + s2 + s3 + s4;
    }

    [intIn, sampIn, ...sleepIns].forEach((s) => s.addEventListener('input', render));
    sleepIns.forEach((s) => s.addEventListener('change', render));
    render();
  });
</script>

<style is:global>
  .pgs { padding: var(--ddp-space-3) var(--ddp-space-4) var(--ddp-space-4); margin: var(--ddp-space-5) 0; }
  .pgs-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem; font-weight: 600; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); margin-bottom: var(--ddp-space-3); }
  .pgs-chip { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 400; color: var(--ddp-color-muted); }
  .pgs-svg { display: block; width: 100%; max-width: 560px; margin: 0 auto; height: auto; background: #fff; border: 1px solid var(--ddp-color-line); border-radius: 6px; }
  .pgs-controls { display: grid; grid-template-columns: 1fr 1fr; gap: var(--ddp-space-2) var(--ddp-space-4); margin: var(--ddp-space-3) 0 var(--ddp-space-2); }
  .pgs-wide { grid-column: 1 / -1; }
  .pgs-slabel { display: flex; flex-direction: column; gap: 0.1rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .pgs-slabel small, .pgs-fs small { font-size: inherit; color: var(--ddp-color-muted); }
  .pgs-slabel em { font-style: normal; font-weight: 700; color: var(--ddp-color-accent); font-family: var(--ddp-font-mono); }
  .pgs-slabel input { accent-color: var(--ddp-color-accent); }
  .pgs-fs { margin: 0; padding: 0; border: 0; min-width: 0; display: flex; flex-wrap: wrap; gap: 0.1rem 0.9rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .pgs-fs legend { padding: 0; margin-bottom: 0.1rem; }
  .pgs-radio { display: inline-flex; align-items: center; gap: 0.3rem; font-family: var(--ddp-font-mono); font-weight: 700; color: var(--ddp-color-accent); }
  .pgs-radio input { accent-color: var(--ddp-color-accent); }
  .pgs-readout { display: grid; grid-template-columns: 1fr 1fr; gap: var(--ddp-space-2); margin: var(--ddp-space-2) 0; padding: var(--ddp-space-2) var(--ddp-space-3); background: color-mix(in srgb, var(--ddp-color-accent) 8%, transparent); border-radius: 6px; }
  .pgs-readout div { display: flex; flex-direction: column; gap: 0.1rem; min-width: 0; }
  .pgs-full { grid-column: 1 / -1; }
  .pgs-readout dt { font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .pgs-readout dd { margin: 0; font-family: var(--ddp-font-mono); font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); font-weight: 700; overflow-wrap: anywhere; }
  .pgs-readout dd.pgs-sum { font-size: var(--ddp-text-xs); font-weight: 400; line-height: 1.5; }
  .pgs-why { margin: 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); line-height: 1.5; min-height: 7em; }
  .pgs-assume { margin: var(--ddp-space-2) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); line-height: 1.5; }
  .pgs-foot { margin: var(--ddp-space-3) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); border-left: 3px solid var(--ddp-color-secondary); padding-left: 0.55rem; }
  @media (max-width: 520px) { .pgs-controls { grid-template-columns: 1fr; } .pgs-why { min-height: 11em; } }
</style>
