---
/**
 * InterruptedMatingTimer — slide the time at which an Hfr by F- mating is interrupted and
 * see which donor markers have entered the recipient. Markers enter in a fixed order and at
 * characteristic times; the gaps between entry times are the map. The numbers are those of
 * the bacterial-and-phage-genetics lesson, worked problem (a): strain 1 gives a 8, b 14,
 * c 20, d 31 min; strain 2 gives d 4, c 15, b 21, a 27 min. Rules used: transfer runs at a
 * steady speed, first appearance marks entry, distance is the difference in entry times.
 * Nothing is sampled at random, so no expected value is shown beside an observed one.
 * Self-contained vanilla-TS Astro island. Original.
 */
---

<figure class="imt card" data-imt>
  <figcaption class="imt-head">Interrupted mating: when does each gene get in?<span class="imt-chip">⚙ original · interactive</span></figcaption>

  <svg class="imt-svg" viewBox="0 0 360 200" role="img" aria-label="A time axis in minutes with donor markers placed at their times of entry, a dashed line at the chosen interruption time, and the markers already inside the recipient" data-stage></svg>

  <div class="imt-controls">
    <label class="imt-slabel"><span>Interrupt the mating at <em data-out="t">0</em> min</span>
      <input type="range" data-in="t" min="0" max="35" step="1" value="0" />
    </label>
    <label class="imt-slabel"><span>Hfr donor strain</span>
      <select data-in="s">
        <option value="1" selected>Hfr strain 1</option>
        <option value="2">Hfr strain 2</option>
      </select>
    </label>
  </div>

  <dl class="imt-readout">
    <div><dt>Markers entered so far</dt><dd data-r-in>none</dd></div>
    <div><dt>Gaps between them (min)</dt><dd data-r-gap>none yet</dd></div>
  </dl>

  <p class="imt-why" data-why role="status"></p>

  <p class="imt-foot">Each donor gene is recovered only from samples taken after its time of entry, so the order of entry gives the gene order and the gaps give the map in minutes; the gaps, not the absolute times, are the map. This is a sketch of worked problem (a), assuming steady transfer, with first appearance marking entry; a colony also needs the piece to be integrated, and the whole <em>E. coli</em> map runs 0 to 100 minutes, of which only the first 35 are shown.</p>
</figure>

<script>
  const NS = 'http://www.w3.org/2000/svg';
  const INK = '#4b4b55', FAINT = '#8a8a96', TEAL = '#0e7c86', ORANGE = '#e57200';
  const TMAX = 35;
  // Times of first appearance, in minutes, from worked problem (a) of the lesson.
  const STRAINS: Record<string, { gene: string; t: number }[]> = {
    '1': [{ gene: 'a', t: 8 }, { gene: 'b', t: 14 }, { gene: 'c', t: 20 }, { gene: 'd', t: 31 }],
    '2': [{ gene: 'd', t: 4 }, { gene: 'c', t: 15 }, { gene: 'b', t: 21 }, { gene: 'a', t: 27 }],
  };
  function el(name: string, attrs: Record<string, string | number>, text?: string): SVGElement {
    const e = document.createElementNS(NS, name);
    for (const k in attrs) e.setAttribute(k, String(attrs[k]));
    if (text !== undefined) e.textContent = text;
    return e;
  }
  document.querySelectorAll<HTMLElement>('[data-imt]').forEach((root) => {
    const stage = root.querySelector<SVGSVGElement>('[data-stage]')!;
    const tIn = root.querySelector<HTMLInputElement>('[data-in="t"]')!;
    const sIn = root.querySelector<HTMLSelectElement>('[data-in="s"]')!;
    const tOut = root.querySelector<HTMLElement>('[data-out="t"]')!;
    const rIn = root.querySelector<HTMLElement>('[data-r-in]')!;
    const rGap = root.querySelector<HTMLElement>('[data-r-gap]')!;
    const why = root.querySelector<HTMLElement>('[data-why]')!;
    const X0 = 30, X1 = 340;
    const xOf = (t: number) => X0 + (t / TMAX) * (X1 - X0);

    function render() {
      const t = Number(tIn.value);
      const key = sIn.value;
      const genes = STRAINS[key];
      const inside = genes.filter((g) => g.t <= t);
      tOut.textContent = String(t);

      stage.replaceChildren();
      // time axis
      stage.appendChild(el('text', { x: 8, y: 14, 'font-size': 10, 'font-weight': 700, fill: INK }, 'donor chromosome, entering from its origin'));
      stage.appendChild(el('line', { x1: X0, y1: 70, x2: X1, y2: 70, stroke: FAINT, 'stroke-width': 2 }));
      stage.appendChild(el('line', { x1: X0, y1: 70, x2: xOf(t), y2: 70, stroke: TEAL, 'stroke-width': 4 }));
      stage.appendChild(el('text', { x: X0, y: 36, 'font-size': 9, 'text-anchor': 'middle', fill: INK }, 'origin'));
      stage.appendChild(el('line', { x1: X0, y1: 40, x2: X0, y2: 76, stroke: INK, 'stroke-width': 1.5 }));
      for (let m = 0; m <= TMAX; m += 5) {
        stage.appendChild(el('line', { x1: xOf(m), y1: 76, x2: xOf(m), y2: 81, stroke: INK, 'stroke-width': 1 }));
        stage.appendChild(el('text', { x: xOf(m), y: 92, 'font-size': 9, 'text-anchor': 'middle', fill: INK }, String(m)));
      }
      stage.appendChild(el('text', { x: X1, y: 104, 'font-size': 9, 'text-anchor': 'end', fill: INK }, 'minutes since mating began'));

      // gap brackets between consecutive entered markers
      for (let i = 1; i < inside.length; i++) {
        const a = xOf(inside[i - 1].t), b = xOf(inside[i].t);
        stage.appendChild(el('line', { x1: a, y1: 56, x2: b, y2: 56, stroke: ORANGE, 'stroke-width': 1.5 }));
        stage.appendChild(el('text', { x: (a + b) / 2, y: 52, 'font-size': 9, 'text-anchor': 'middle', 'font-weight': 700, fill: ORANGE }, `${inside[i].t - inside[i - 1].t} min`));
      }
      // markers at their entry times
      genes.forEach((g) => {
        const on = g.t <= t, x = xOf(g.t);
        stage.appendChild(el('rect', { x: x - 9, y: 60, width: 18, height: 20, rx: 4, fill: on ? TEAL : '#fff', stroke: on ? TEAL : FAINT, 'stroke-width': 1.5 }));
        stage.appendChild(el('text', { x, y: 74, 'font-size': 11, 'text-anchor': 'middle', 'font-weight': 700, fill: on ? '#fff' : INK }, g.gene));
      });
      // the interruption line
      stage.appendChild(el('line', { x1: xOf(t), y1: 28, x2: xOf(t), y2: 112, stroke: '#a33', 'stroke-width': 1.5, 'stroke-dasharray': '4 3' }));
      const lx = Math.min(Math.max(xOf(t), 60), 300);
      stage.appendChild(el('text', { x: lx, y: 124, 'font-size': 9, 'text-anchor': 'middle', 'font-weight': 700, fill: '#a33' }, `blender at ${t} min`));

      // recipient
      stage.appendChild(el('rect', { x: X0, y: 138, width: X1 - X0, height: 50, rx: 8, fill: '#fff', stroke: INK, 'stroke-width': 1.2 }));
      stage.appendChild(el('text', { x: X0 + 8, y: 153, 'font-size': 9, 'font-weight': 700, fill: INK }, 'F− recipient: donor markers that got in, in order of entry'));
      if (inside.length === 0) {
        stage.appendChild(el('text', { x: (X0 + X1) / 2, y: 175, 'font-size': 10, 'text-anchor': 'middle', fill: FAINT }, 'no donor marker yet'));
      }
      inside.forEach((g, i) => {
        const x = X0 + 14 + i * 34;
        stage.appendChild(el('rect', { x, y: 160, width: 26, height: 22, rx: 4, fill: TEAL }));
        stage.appendChild(el('text', { x: x + 13, y: 175, 'font-size': 11, 'text-anchor': 'middle', 'font-weight': 700, fill: '#fff' }, g.gene));
      });

      // readouts
      rIn.textContent = inside.length ? inside.map((g) => g.gene).join(', ') + ` (${inside.length} of 4)` : 'none';
      if (inside.length < 2) rGap.textContent = 'none yet';
      else rGap.textContent = inside.slice(1).map((g, i) => `${inside[i].gene} to ${g.gene}: ${g.t - inside[i].t}`).join('; ');

      // status sentences
      const next = genes.find((g) => g.t > t);
      let s: string;
      if (inside.length === 0) {
        s = `Interrupted at ${t} min, no donor marker has entered the recipient yet. The first, ${genes[0].gene}, is recovered only from samples taken after ${genes[0].t} min.`;
      } else if (!next) {
        s = `By ${t} min all four markers have entered, in the order ${genes.map((g) => g.gene).join(', ')}. The gaps are ${genes.slice(1).map((g, i) => g.t - genes[i].t).join(', ')} min, so the map is a-b-c-d with a-b 6, b-c 6 and c-d 11 minutes.`;
        if (key === '2') s += ' Strain 2 reads the same map backwards: its origin lies on the far side of d, about 4 minutes before d.';
      } else {
        const last = inside[inside.length - 1];
        s = `Interrupted at ${t} min, ${inside.length === 1 ? 'only ' + last.gene + ' has' : inside.map((g) => g.gene).join(', ') + ' have'} entered; ${next.gene} is still outside and appears only after ${next.t} min. Genes enter one after another, so the order of entry is the gene order.`;
      }
      why.textContent = s;
    }
    tIn.addEventListener('input', render);
    sIn.addEventListener('change', render);
    render();
  });
</script>

<style is:global>
  .imt { padding: var(--ddp-space-3) var(--ddp-space-4) var(--ddp-space-4); margin: var(--ddp-space-5) 0; }
  .imt-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem; font-weight: 600; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); margin-bottom: var(--ddp-space-3); }
  .imt-chip { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 400; color: var(--ddp-color-muted); }
  .imt-svg { display: block; width: 100%; max-width: 600px; margin: 0 auto var(--ddp-space-3); height: auto; background: #fff; border: 1px solid var(--ddp-color-line); border-radius: 6px; }
  .imt-controls { display: flex; flex-wrap: wrap; gap: 0.5rem 1.2rem; align-items: flex-end; margin: var(--ddp-space-2) 0; }
  .imt-slabel { display: flex; flex-direction: column; gap: 0.2rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); flex: 1 1 200px; }
  .imt-slabel em { font-style: normal; font-weight: 700; color: var(--ddp-color-primary); }
  .imt-slabel input[type="range"] { width: 100%; accent-color: var(--ddp-color-accent); }
  .imt-slabel select { font-size: var(--ddp-text-xs); padding: 0.25rem 0.4rem; border: 1px solid var(--ddp-color-line); border-radius: 5px; background: transparent; color: var(--ddp-color-ink-soft); }
  .imt-slabel input:focus-visible, .imt-slabel select:focus-visible { outline: 2px solid var(--ddp-color-accent); outline-offset: 2px; }
  .imt-readout { display: grid; grid-template-columns: 1fr 1fr; gap: 0.4rem 1rem; margin: var(--ddp-space-3) 0; font-size: var(--ddp-text-xs); }
  .imt-readout dt { color: var(--ddp-color-muted); }
  .imt-readout dd { margin: 0; font-weight: 700; color: var(--ddp-color-primary); }
  .imt-why { margin: var(--ddp-space-2) 0; padding: var(--ddp-space-2) var(--ddp-space-3); background: color-mix(in srgb, var(--ddp-color-accent) 8%, transparent); border-radius: 6px; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); min-height: 3em; }
  .imt-foot { margin: var(--ddp-space-3) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); border-left: 3px solid var(--ddp-color-secondary); padding-left: 0.55rem; }
  @media (max-width: 520px) { .imt-readout { grid-template-columns: 1fr; } }
</style>
