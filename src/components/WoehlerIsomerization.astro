---
/**
 * WoehlerIsomerization — the first crack in vitalism. In 1828 Wöhler evaporated a solution meant
 * to hold ammonium cyanate, an inorganic salt, and got urea — the very compound an animal kidney
 * makes to dump nitrogen. This island puts the two molecules side by side, draws them atom-for-atom, and
 * tallies their inventory: 1 C, 4 H, 2 N, 1 O on both sides. They are isomers — same atoms, only
 * the wiring differs. Press "Warm and evaporate" and the salt rearranges into urea in the two steps
 * the lesson describes (proton transfer to NH3 + HNCO, then attack on the carbon). Urea is the
 * more stable isomer: warmth only speeds a change already downhill. Self-contained vanilla-TS
 * Astro island. Original.
 */
---

<figure class="woe card" data-woehler>
  <figcaption class="woe-head">Wöhler, 1828 — the same atoms, with and without life<span class="woe-chip">⚙ original · interactive</span></figcaption>

  <svg class="woe-svg" viewBox="20 40 420 192" role="img" aria-label="Ammonium cyanate drawn atom by atom: an ammonium ion, NH4 plus, beside a cyanate ion, OCN minus" data-svg></svg>
  <p class="woe-cap" data-cap></p>

  <div class="woe-tally">
    <span class="woe-tally-label">Atom inventory (identical on both sides)</span>
    <span class="woe-tally-row"><strong>C</strong>:1 &nbsp; <strong>H</strong>:4 &nbsp; <strong>N</strong>:2 &nbsp; <strong>O</strong>:1</span>
  </div>

  <p class="woe-payoff" data-payoff role="status" hidden></p>

  <div class="woe-controls">
    <button type="button" data-heat>Warm and evaporate</button>
    <button type="button" data-reset class="woe-reset">Reset</button>
    <span class="woe-state" data-state role="status">Unreacted salt</span>
  </div>

  <p class="woe-foot">This is an isomerization: same formula (CH₄N₂O), atoms simply rearranged. No new matter, no missing matter — and yet an inorganic salt became a hallmark of animal metabolism. It was the first crack, not the end: a skeptic could still point to where the cyanate came from.</p>
</figure>

<script>
  const ACCENT = '#0e7c86', NAVY = '#232d4b', ORANGE = '#e57200', FAINT = '#b9b9c2', INK = '#4b4b55', MUTE = '#6b6b6b';
  const FONT = 'Inter, system-ui, -apple-system, sans-serif';
  const SVGNS = 'http://www.w3.org/2000/svg';
  function el(name: string, attrs: Record<string, string | number>): SVGElement {
    const e = document.createElementNS(SVGNS, name);
    for (const k in attrs) e.setAttribute(k, String(attrs[k]));
    return e;
  }

  type Atom = { id: string; sym: string; x: number; y: number; color: string };
  type Bond = { a: string; b: string; double?: boolean };

  // Layout of the same eight atoms in two arrangements. Atom ids are preserved across states
  // so the heating step can move identical atoms from salt positions to urea positions.
  const SALT: Atom[] = [
    // ammonium ion NH4+ — central N with four H, left cluster
    { id: 'N1', sym: 'N', x: 95, y: 115, color: NAVY },
    { id: 'H1', sym: 'H', x: 95, y: 70, color: FAINT },
    { id: 'H2', sym: 'H', x: 95, y: 160, color: FAINT },
    { id: 'H3', sym: 'H', x: 52, y: 115, color: FAINT },
    { id: 'H4', sym: 'H', x: 138, y: 115, color: FAINT },
    // cyanate ion O=C=N(-) — O, C, N in a row, right cluster
    { id: 'O1', sym: 'O', x: 290, y: 115, color: ORANGE },
    { id: 'C1', sym: 'C', x: 345, y: 115, color: ACCENT },
    { id: 'N2', sym: 'N', x: 400, y: 115, color: NAVY },
  ];
  const SALT_BONDS: Bond[] = [
    { a: 'N1', b: 'H1' }, { a: 'N1', b: 'H2' }, { a: 'N1', b: 'H3' }, { a: 'N1', b: 'H4' },
    { a: 'O1', b: 'C1', double: true }, { a: 'C1', b: 'N2', double: true },
  ];

  // Halfway point: ammonium has handed a proton (H4) to cyanate, giving ammonia (NH3, left)
  // and cyanic acid (H–N=C=O, right). Two neutral molecules, no ion brackets.
  const MID: Atom[] = [
    { id: 'N1', sym: 'N', x: 110, y: 115, color: NAVY },
    { id: 'H1', sym: 'H', x: 110, y: 70, color: FAINT },
    { id: 'H2', sym: 'H', x: 110, y: 160, color: FAINT },
    { id: 'H3', sym: 'H', x: 67, y: 115, color: FAINT },
    { id: 'H4', sym: 'H', x: 400, y: 165, color: FAINT },
    { id: 'O1', sym: 'O', x: 290, y: 115, color: ORANGE },
    { id: 'C1', sym: 'C', x: 345, y: 115, color: ACCENT },
    { id: 'N2', sym: 'N', x: 400, y: 115, color: NAVY },
  ];
  const MID_BONDS: Bond[] = [
    { a: 'N1', b: 'H1' }, { a: 'N1', b: 'H2' }, { a: 'N1', b: 'H3' },
    { a: 'O1', b: 'C1', double: true }, { a: 'C1', b: 'N2', double: true }, { a: 'N2', b: 'H4' },
  ];

  const UREA: Atom[] = [
    // central C double-bonded to O, two -NH2 groups: H2N-CO-NH2
    { id: 'C1', sym: 'C', x: 230, y: 130, color: ACCENT },
    { id: 'O1', sym: 'O', x: 230, y: 70, color: ORANGE },
    { id: 'N1', sym: 'N', x: 165, y: 165, color: NAVY },
    { id: 'N2', sym: 'N', x: 295, y: 165, color: NAVY },
    { id: 'H1', sym: 'H', x: 120, y: 140, color: FAINT },
    { id: 'H2', sym: 'H', x: 150, y: 210, color: FAINT },
    { id: 'H3', sym: 'H', x: 340, y: 140, color: FAINT },
    { id: 'H4', sym: 'H', x: 310, y: 210, color: FAINT },
  ];
  const UREA_BONDS: Bond[] = [
    { a: 'C1', b: 'O1', double: true },
    { a: 'C1', b: 'N1' }, { a: 'C1', b: 'N2' },
    { a: 'N1', b: 'H1' }, { a: 'N1', b: 'H2' },
    { a: 'N2', b: 'H3' }, { a: 'N2', b: 'H4' },
  ];
  // What the rearrangement changed: the ammonium N (N1) bonds to carbon, and two of its
  // hydrogens (H3, H4) end up on the cyanate N (N2). Highlighted in the urea drawing.
  const NEW_BOND = { a: 'C1', b: 'N1' };
  const MOVED_H = ['H3', 'H4'];

  function bondLine(from: Atom, to: Atom, color: string, dbl: boolean, width = 2): SVGElement {
    const g = el('g', {});
    const dx = to.x - from.x, dy = to.y - from.y;
    const len = Math.hypot(dx, dy) || 1;
    // trim the line so it stops at the atom-circle edge (r = 16)
    const ux = dx / len, uy = dy / len, pad = 16;
    const x1 = from.x + ux * pad, y1 = from.y + uy * pad;
    const x2 = to.x - ux * pad, y2 = to.y - uy * pad;
    if (dbl) {
      // offset perpendicular for the two parallel lines of a double bond
      const ox = -uy * 3, oy = ux * 3;
      g.appendChild(el('line', { x1: x1 + ox, y1: y1 + oy, x2: x2 + ox, y2: y2 + oy, stroke: color, 'stroke-width': width }));
      g.appendChild(el('line', { x1: x1 - ox, y1: y1 - oy, x2: x2 - ox, y2: y2 - oy, stroke: color, 'stroke-width': width }));
    } else {
      g.appendChild(el('line', { x1, y1, x2, y2, stroke: color, 'stroke-width': width, 'stroke-linecap': 'round' }));
    }
    return g;
  }

  // Square brackets around an ion with its overall charge at the top right, the way a salt
  // is written on paper: [NH4]+ and [OCN]−.
  function ionBracket(x0: number, y0: number, x1: number, y1: number, charge: string, name: string, opacity: number): SVGElement {
    const g = el('g', { opacity });
    const arm = 7;
    g.appendChild(el('path', { d: `M${x0 + arm} ${y0} H${x0} V${y1} H${x0 + arm}`, fill: 'none', stroke: INK, 'stroke-width': 1.6 }));
    g.appendChild(el('path', { d: `M${x1 - arm} ${y0} H${x1} V${y1} H${x1 - arm}`, fill: 'none', stroke: INK, 'stroke-width': 1.6 }));
    const q = el('text', { x: x1 + 4, y: y0 + 11, fill: NAVY, 'font-size': 17, 'font-weight': 700, 'font-family': FONT });
    q.textContent = charge;
    g.appendChild(q);
    const lab = el('text', { x: (x0 + x1) / 2, y: 207, 'text-anchor': 'middle', fill: MUTE, 'font-size': 11, 'font-family': FONT });
    lab.textContent = name;
    g.appendChild(lab);
    return g;
  }

  type DrawOpts = { bonds: Bond[]; bondOpacity?: number; ions?: number; highlight?: boolean; midLabels?: number };
  function draw(svg: SVGElement, atoms: Atom[], o: DrawOpts) {
    while (svg.firstChild) svg.removeChild(svg.firstChild);
    const byId: Record<string, Atom> = {};
    for (const a of atoms) byId[a.id] = a;
    if (o.ions && o.ions > 0.01) {
      svg.appendChild(ionBracket(34, 50, 156, 180, '+', 'ammonium ion, NH₄⁺', o.ions));
      svg.appendChild(ionBracket(270, 93, 420, 137, '−', 'cyanate ion, OCN⁻', o.ions));
    }
    if (o.midLabels && o.midLabels > 0.01) {
      const lg = el('g', { opacity: o.midLabels });
      const l1 = el('text', { x: 95, y: 207, 'text-anchor': 'middle', fill: MUTE, 'font-size': 11, 'font-family': FONT });
      l1.textContent = 'ammonia, NH₃';
      const l2 = el('text', { x: 345, y: 207, 'text-anchor': 'middle', fill: MUTE, 'font-size': 11, 'font-family': FONT });
      l2.textContent = 'cyanic acid, HNCO';
      lg.appendChild(l1); lg.appendChild(l2);
      svg.appendChild(lg);
    }
    // bonds first, under the atoms
    const bg = el('g', { opacity: o.bondOpacity ?? 1 });
    for (const b of o.bonds) {
      const fa = byId[b.a], ta = byId[b.b];
      if (!fa || !ta) continue;
      const isNew = o.highlight && b.a === NEW_BOND.a && b.b === NEW_BOND.b;
      bg.appendChild(bondLine(fa, ta, isNew ? ACCENT : INK, !!b.double, isNew ? 4 : 2));
    }
    svg.appendChild(bg);
    // atoms as labeled circles
    for (const a of atoms) {
      if (o.highlight && MOVED_H.includes(a.id)) {
        svg.appendChild(el('circle', { cx: a.x, cy: a.y, r: 21, fill: 'none', stroke: ACCENT, 'stroke-width': 2, 'stroke-dasharray': '4 3' }));
      }
      svg.appendChild(el('circle', { cx: a.x, cy: a.y, r: 16, fill: a.color, stroke: '#fff', 'stroke-width': 2 }));
      const t = el('text', { x: a.x, y: a.y + 5, 'text-anchor': 'middle', fill: a.sym === 'H' ? NAVY : '#fff', 'font-size': 15, 'font-weight': 700, 'font-family': FONT });
      t.textContent = a.sym;
      svg.appendChild(t);
    }
  }

  document.querySelectorAll<HTMLElement>('[data-woehler]').forEach((root) => {
    const svg = root.querySelector('[data-svg]') as unknown as SVGElement;
    const capEl = root.querySelector<HTMLElement>('[data-cap]')!;
    const payoffEl = root.querySelector<HTMLElement>('[data-payoff]')!;
    const stateEl = root.querySelector<HTMLElement>('[data-state]')!;
    const heatB = root.querySelector<HTMLButtonElement>('[data-heat]')!;
    const resetB = root.querySelector<HTMLButtonElement>('[data-reset]')!;

    const SALT_TITLE = '<strong>Ammonium cyanate</strong> (NH₄⁺ OCN⁻) — an inorganic salt of two ions · CH₄N₂O';
    const UREA_TITLE = '<strong>Urea</strong> (H₂N–CO–NH₂) — a signature of animal metabolism · CH₄N₂O';
    const CHANGED = '<span class="woe-key" aria-hidden="true"></span>What changed: the ammonium nitrogen bonded to the carbon (thick teal bond), and two of its hydrogens (dashed rings) moved onto the cyanate nitrogen.';
    const STABLE = '<span class="woe-changed">Urea is the more stable isomer: warming speeds the change, it does not force it.</span>';
    const STEP1 = '<strong>Step 1:</strong> ammonium hands a proton to cyanate → ammonia + cyanic acid';
    const STEP2 = '<strong>Step 2:</strong> ammonia’s nitrogen attacks the carbon; a proton shifts → urea';
    const PAYOFF = 'Same atoms, different connections. Life was taken out of the making — no kidney in the flask — but not out of the starting material: the cyanate was made from blood and horn. So this cracked the vital force; it did not break it.';
    const SALT_LABEL = 'Ammonium cyanate: an ammonium ion, NH4 plus, beside a cyanate ion, OCN minus';
    const UREA_LABEL = 'Urea: a carbon double-bonded to oxygen and single-bonded to two NH2 groups. The new carbon–nitrogen bond and the two hydrogens that moved are highlighted.';

    let heated = false;
    let animating = false;
    let run = 0; // bumps on every start/reset so stale timers and frames from an old run do nothing

    function showSalt() {
      heated = false; animating = false; run++;
      draw(svg, SALT, { bonds: SALT_BONDS, ions: 1 });
      svg.setAttribute('aria-label', SALT_LABEL);
      capEl.innerHTML = SALT_TITLE;
      stateEl.textContent = 'Unreacted salt';
      payoffEl.hidden = true;
      heatB.disabled = false;
    }
    function showUrea() {
      heated = true; animating = false; run++;
      draw(svg, UREA, { bonds: UREA_BONDS, highlight: true });
      svg.setAttribute('aria-label', UREA_LABEL);
      capEl.innerHTML = `${UREA_TITLE}<span class="woe-changed">${CHANGED}</span>${STABLE}`;
      stateEl.textContent = 'Urea — the stable isomer';
      payoffEl.textContent = PAYOFF;
      payoffEl.hidden = false;
      heatB.disabled = true;
    }

    // Tween every atom (matched by id) between two layouts. Old bonds fade out as the atoms
    // leave and new bonds fade in as they arrive, so no line ever whips across the drawing.
    function tween(from: Atom[], fromBonds: Bond[], to: Atom[], toBonds: Bond[], fade: { ions?: [number, number]; mid?: [number, number] }, dur: number, myRun: number, done: () => void) {
      const fromById: Record<string, Atom> = {};
      for (const a of from) fromById[a.id] = a;
      const start = performance.now();
      const lerp = (r: [number, number] | undefined, e: number) => (r ? r[0] + (r[1] - r[0]) * e : 0);
      function frame(now: number) {
        if (!animating || myRun !== run) return; // reset pressed mid-animation
        const t = Math.min(1, (now - start) / dur);
        const ease = t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2;
        const moving: Atom[] = to.map((u) => {
          const s = fromById[u.id]!;
          return { id: u.id, sym: u.sym, color: u.color, x: s.x + (u.x - s.x) * ease, y: s.y + (u.y - s.y) * ease };
        });
        const extra = { ions: lerp(fade.ions, ease), midLabels: lerp(fade.mid, ease) };
        if (ease < 0.35) draw(svg, moving, { bonds: fromBonds, bondOpacity: 1 - ease / 0.35, ...extra });
        else if (ease > 0.65) draw(svg, moving, { bonds: toBonds, bondOpacity: (ease - 0.65) / 0.35, ...extra });
        else draw(svg, moving, { bonds: [], ...extra });
        if (t < 1) requestAnimationFrame(frame);
        else done();
      }
      requestAnimationFrame(frame);
    }

    function animateToUrea() {
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce || document.hidden) { showUrea(); return; }
      animating = true;
      const myRun = ++run;
      const STEP = 800, HOLD = 900;
      // safety net: if rAF never delivers (throttled/backgrounded tab), guarantee the end state
      window.setTimeout(() => { if (animating && myRun === run) showUrea(); }, 2 * STEP + HOLD + 900);
      heatB.disabled = true;
      stateEl.textContent = 'Rearranging (downhill; warmth only speeds it)…';
      payoffEl.hidden = true;
      capEl.innerHTML = STEP1;
      tween(SALT, SALT_BONDS, MID, MID_BONDS, { ions: [1, 0], mid: [0, 1] }, STEP, myRun, () => {
        draw(svg, MID, { bonds: MID_BONDS, midLabels: 1 });
        svg.setAttribute('aria-label', 'Halfway: ammonia, NH3, beside cyanic acid, H–N=C=O');
        window.setTimeout(() => {
          if (!animating || myRun !== run) return;
          capEl.innerHTML = STEP2;
          tween(MID, MID_BONDS, UREA, UREA_BONDS, { mid: [1, 0] }, STEP, myRun, () => { if (myRun === run) showUrea(); });
        }, HOLD);
      });
    }

    heatB.addEventListener('click', () => { if (!heated && !animating) animateToUrea(); });
    resetB.addEventListener('click', showSalt);

    // clear static initial state — the unreacted salt, fully drawn, no animation needed
    showSalt();
  });
</script>

<style>
  .woe { padding: var(--ddp-space-3) var(--ddp-space-4) var(--ddp-space-4); margin: var(--ddp-space-5) 0; }
  .woe-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem; font-weight: 600; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); margin-bottom: var(--ddp-space-2); }
  .woe-chip { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 400; color: var(--ddp-color-muted); }
  .woe-svg { width: 100%; height: auto; display: block; background: color-mix(in srgb, var(--ddp-color-accent) 5%, #fff); border: 1px solid var(--ddp-color-line); border-radius: 8px; margin-bottom: var(--ddp-space-2); }
  .woe-cap { margin: 0 0 var(--ddp-space-3); font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); line-height: 1.5; text-align: center; }
  .woe-cap :global(strong) { color: var(--ddp-color-primary); }
  .woe-cap :global(.woe-changed) { display: block; margin-top: 0.2rem; color: var(--ddp-color-accent); }
  .woe-cap :global(.woe-key) { display: inline-block; width: 0.8em; height: 0.8em; border: 1.5px dashed var(--ddp-color-accent); border-radius: 50%; margin-right: 0.35em; vertical-align: -0.1em; }
  .woe-tally { display: flex; flex-direction: column; gap: 0.15rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); padding: var(--ddp-space-2) var(--ddp-space-3); background: color-mix(in srgb, var(--ddp-color-accent) 8%, transparent); border-radius: 6px; margin-bottom: var(--ddp-space-3); }
  .woe-tally-label { color: var(--ddp-color-muted); }
  .woe-tally-row { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); letter-spacing: 0.02em; }
  .woe-tally-row strong { color: var(--ddp-color-accent); }
  .woe-payoff { margin: 0 0 var(--ddp-space-3); font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); line-height: 1.5; padding: var(--ddp-space-2) var(--ddp-space-3); background: color-mix(in srgb, var(--ddp-color-secondary) 12%, transparent); border-radius: 6px; }
  .woe-controls { display: flex; align-items: center; gap: 0.4rem; margin-bottom: var(--ddp-space-3); }
  .woe-controls button { font-family: inherit; font-size: var(--ddp-text-xs); border: 1px solid var(--ddp-color-line); background: #fff; color: var(--ddp-color-ink-soft); border-radius: 5px; padding: 0.32rem 0.7rem; cursor: pointer; }
  .woe-controls button:hover:not(:disabled) { border-color: var(--ddp-color-accent); color: var(--ddp-color-primary); }
  .woe-controls button:disabled { opacity: 0.4; cursor: default; }
  .woe-reset { margin-left: 0; }
  .woe-state { margin-left: auto; font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .woe-foot { margin: var(--ddp-space-3) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); border-left: 3px solid var(--ddp-color-secondary); padding-left: 0.55rem; }
</style>
