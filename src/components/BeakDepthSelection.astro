  .bds-btn { min-height: 44px; border: 1px solid var(--ddp-color-line); border-radius: 6px; background: transparent; color: var(--ddp-color-ink-soft); font-size: var(--ddp-text-xs); padding: 0.4rem 0.8rem; cursor: pointer; }
  .bds-btn[aria-pressed="true"] { background: var(--ddp-color-accent); border-color: var(--ddp-color-accent); color: #fff; font-weight: 700; }
  .bds-go { border-color: var(--ddp-color-accent); color: var(--ddp-color-accent); font-weight: 700; }
