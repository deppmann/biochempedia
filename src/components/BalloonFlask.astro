---
/**
 * BalloonFlask — grade 7 Life Science, "Releasing Energy from Food". A flask of sprouting
 * seeds or of yeast in sugar water sits in a water bath with a balloon on top and a
 * thermometer. Controls: organism, water-bath temperature, open or sealed flask (oxygen),
 * and sugar level (yeast) or number of seeds. The balloon collects carbon dioxide at a rate
 * shown as a bar; a rate-versus-temperature plot climbs and then drops. The curve is one
 * smooth sketch: 0 to 25 degrees C passes through the midpoints of the lesson's pea table;
 * above 25 it is made up. Oxygen uses the lesson's yeast table. Self-contained vanilla-TS
 * Astro island. Original.
 */
---

<figure class="bf card" data-bf>
  <figcaption class="bf-head">Balloon flask: what speeds up respiration?<span class="bf-chip">⚙ original · interactive</span></figcaption>

  <div class="bf-panels">
    <div class="bf-col">
      <svg class="bf-svg" viewBox="0 0 360 345" role="img" aria-label="A flask of living cells in a water bath with a balloon on top and a thermometer beside it" data-scene>
        <defs>
          <clipPath id="bf-flaskclip"><path d="M135 130 V190 L84 296 Q80 306 92 306 H208 Q220 306 216 296 L165 190 V130 Z" /></clipPath>
        </defs>
        <rect data-bath x="40" y="215" width="220" height="105" rx="8" fill="#dbe9f6" stroke="#8aa0b4" stroke-width="1.2" />
        <g clip-path="url(#bf-flaskclip)">
          <rect x="70" y="235" width="160" height="75" fill="#bfe3f2" opacity="0.9" />
          <g data-sugar></g>
          <g data-orgs></g>
        </g>
        <path d="M135 130 V190 L84 296 Q80 306 92 306 H208 Q220 306 216 296 L165 190 V130" fill="none" stroke="#4b4b55" stroke-width="2" />
        <rect x="131" y="124" width="38" height="8" rx="2" fill="#fff" stroke="#4b4b55" stroke-width="1.6" />
        <ellipse data-balloon cx="150" cy="122" rx="5" ry="6" fill="#f3c9a5" stroke="#b86a2b" stroke-width="1.6" />
        <rect x="165" y="146" width="50" height="10" fill="#fff" stroke="#4b4b55" stroke-width="1.4" />
        <g data-air-open>
          <line x1="268" y1="151" x2="224" y2="151" stroke="#0e7c86" stroke-width="2.4" />
          <polygon points="216,151 227,145 227,157" fill="#0e7c86" />
        </g>
        <rect data-air-seal x="205" y="140" width="10" height="22" rx="2" fill="#4b4b55" />
        <text data-airlabel x="174" y="140" font-size="13" fill="#2b2b33">fresh air in</text>
        <text x="196" y="66" font-size="13" fill="#2b2b33">balloon holds</text>
        <text x="196" y="82" font-size="13" fill="#2b2b33">carbon dioxide</text>
        <text data-orglabel1 x="4" y="184" font-size="13" fill="#2b2b33"></text>
        <text data-orglabel2 x="4" y="200" font-size="13" fill="#2b2b33"></text>
        <text data-bathlabel x="150" y="337" text-anchor="middle" font-size="13" fill="#2b2b33"></text>
        <text x="355" y="106" text-anchor="end" font-size="13" fill="#2b2b33">thermometer</text>
        <rect x="303" y="114" width="14" height="168" rx="7" fill="#fff" stroke="#4b4b55" stroke-width="1.6" />
        <circle cx="310" cy="294" r="12" fill="#fff" stroke="#4b4b55" stroke-width="1.6" />
        <circle cx="310" cy="294" r="8.5" fill="#c0392b" />
        <rect data-merc x="307" y="200" width="6" height="90" fill="#c0392b" />
        <g font-size="13" fill="#2b2b33" text-anchor="end">
          <text x="298" y="126">50</text>
          <text x="298" y="206">25</text>
          <text x="298" y="286">0</text>
        </g>
      </svg>
      <p class="bf-key">Schematic, not to scale. Circles are yeast cells, ovals are seeds, small squares are sugar (glucose).</p>

      <div class="bf-bar-wrap">
        <div class="bf-bar-label">Carbon dioxide rate now: <strong data-out="rate">0</strong> relative units</div>
        <div class="bf-bar" aria-hidden="true"><span data-bar></span></div>
      </div>
    </div>

    <div class="bf-col">
      <svg class="bf-svg" viewBox="0 0 360 255" role="img" aria-label="A plot of respiration rate against water bath temperature that rises and then falls" data-plot></svg>
      <p class="bf-key">
        <span class="bf-sw bf-sw-solid"></span> <span data-keysolid></span>
        <span class="bf-sw bf-sw-dash"></span> made up (above 25 °C)
        <span data-keybarwrap><span class="bf-sw bf-sw-bar"></span> pea table range (only at 5 seeds, open flask)</span>
      </p>
    </div>
  </div>

  <div class="bf-controls">
    <div class="bf-group" role="group" aria-label="What is in the flask">
      <span class="bf-glabel">What is in the flask</span>
      <div class="bf-btns">
        <button type="button" class="bf-btn bf-tog" data-org="seeds" aria-pressed="true">Sprouting seeds</button>
        <button type="button" class="bf-btn bf-tog" data-org="yeast" aria-pressed="false">Yeast in sugar water</button>
      </div>
    </div>
    <label class="bf-slabel"><span>Water bath: <em data-out="temp">10</em> °C</span>
      <input type="range" min="0" max="50" step="1" value="10" data-in="temp" />
    </label>
    <div class="bf-group" role="group" aria-label="Oxygen">
      <span class="bf-glabel">Oxygen</span>
      <div class="bf-btns">
        <button type="button" class="bf-btn bf-tog" data-air="open" aria-pressed="true">Open: fresh air</button>
        <button type="button" class="bf-btn bf-tog" data-air="sealed" aria-pressed="false">Sealed: no fresh air</button>
      </div>
    </div>
    <label class="bf-slabel"><span data-amtlabel>Number of seeds: <em data-out="amt">5</em></span>
      <input type="range" min="1" max="10" step="1" value="5" data-in="amt" />
    </label>
  </div>

  <dl class="bf-read">
    <div><dt>Carbon dioxide in balloon</dt><dd data-out="gas">0 of 100 (relative units)</dd></div>
    <div><dt>Oxygen in the flask gas (made-up run-down)</dt><dd data-out="o2">20.9 %</dd></div>
    <div><dt>Time so far</dt><dd data-out="time">0 time units</dd></div>
  </dl>
  <p class="bf-math" data-table></p>

  <div class="bf-btns bf-actions">
    <button type="button" class="bf-btn bf-main" data-go>Start</button>
    <button type="button" class="bf-btn" data-reset>Reset</button>
  </div>
  <p class="bf-status" role="status" data-status>Press Start. The balloon collects carbon dioxide from the cells.</p>

  <p class="bf-assume" data-assume></p>
  <p class="bf-foot">Rule to keep: warmer cells usually respire faster, but too much heat damages them; less oxygen or less sugar slows respiration.</p>
</figure>

<script>
  const NS = 'http://www.w3.org/2000/svg';
  const INK = '#4b4b55', FAINT = '#b9b9c2', ACCENT = '#0e7c86', ORANGE = '#e57200';

  function svgEl(name: string, attrs: Record<string, string | number>): SVGElement {
    const e = document.createElementNS(NS, name);
    for (const k in attrs) e.setAttribute(k, String(attrs[k]));
    return e;
  }

  document.querySelectorAll<HTMLElement>('[data-bf]').forEach((root) => {
    function q<T extends Element>(sel: string): T {
      const e = root.querySelector<T>(sel);
      if (!e) throw new Error('BalloonFlask: missing ' + sel);
      return e;
    }
    const scene = q<SVGSVGElement>('[data-scene]');
    const plot = q<SVGSVGElement>('[data-plot]');
    const bath = q<SVGRectElement>('[data-bath]');
    const sugarG = q<SVGGElement>('[data-sugar]');
    const orgsG = q<SVGGElement>('[data-orgs]');
    const balloon = q<SVGEllipseElement>('[data-balloon]');
    const airOpen = q<SVGGElement>('[data-air-open]');
    const airSeal = q<SVGRectElement>('[data-air-seal]');
    const airLabel = q<SVGTextElement>('[data-airlabel]');
    const orgL1 = q<SVGTextElement>('[data-orglabel1]');
    const orgL2 = q<SVGTextElement>('[data-orglabel2]');
    const bathLabel = q<SVGTextElement>('[data-bathlabel]');
    const merc = q<SVGRectElement>('[data-merc]');
    const bar = q<HTMLElement>('[data-bar]');
    const tempIn = q<HTMLInputElement>('[data-in="temp"]');
    const amtIn = q<HTMLInputElement>('[data-in="amt"]');
    const amtLabel = q<HTMLElement>('[data-amtlabel]');
    const goBtn = q<HTMLButtonElement>('[data-go]');
    const resetBtn = q<HTMLButtonElement>('[data-reset]');
    const status = q<HTMLElement>('[data-status]');
    const tableLine = q<HTMLElement>('[data-table]');
    const keySolid = q<HTMLElement>('[data-keysolid]');
    const keyBarWrap = q<HTMLElement>('[data-keybarwrap]');
    const assume = q<HTMLElement>('[data-assume]');
    const out = (k: string) => q<HTMLElement>('[data-out="' + k + '"]');
    const oRate = out('rate'), oTemp = out('temp'), oGas = out('gas'), oO2 = out('o2'), oTime = out('time');
    const orgBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-org]'));
    const airBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-air]'));

    // ---- the model -------------------------------------------------------------
    // Pea table midpoints (mg CO2 per kg per hour) at 0..25 C, then made-up points above 25 C.
    const XS = [0, 5, 10, 15, 20, 25, 32, 38, 42, 46, 50];
    const YS = [38, 63.5, 85.5, 175, 271, 312.5, 350, 300, 150, 30, 0];
    const LO = [30, 55, 63, 165, 220, 298];
    const HI = [46, 72, 108, 185, 322, 327];
    const PEAK = 350; // the made-up top of the curve = 100 relative units

    // Monotone cubic (Fritsch-Carlson) so the one curve is smooth and never dips below 0.
    const n = XS.length;
    const dx: number[] = [], dl: number[] = [];
    for (let i = 0; i < n - 1; i++) { dx.push(XS[i + 1] - XS[i]); dl.push((YS[i + 1] - YS[i]) / dx[i]); }
    const slope: number[] = new Array(n).fill(0);
    for (let i = 1; i < n - 1; i++) {
      if (dl[i - 1] * dl[i] > 0) {
        const w1 = 2 * dx[i] + dx[i - 1], w2 = dx[i] + 2 * dx[i - 1];
        slope[i] = (w1 + w2) / (w1 / dl[i - 1] + w2 / dl[i]);
      }
    }
    slope[0] = dl[0] > 0 ? dl[0] : 0;
    slope[n - 1] = 0;
    function curveRaw(t: number): number {
      if (t <= XS[0]) return YS[0];
      if (t >= XS[n - 1]) return YS[n - 1];
      let i = 0;
      while (t > XS[i + 1]) i++;
      const h = dx[i], s = (t - XS[i]) / h;
      const h00 = 2 * s ** 3 - 3 * s ** 2 + 1, h10 = s ** 3 - 2 * s ** 2 + s, h01 = -2 * s ** 3 + 3 * s ** 2, h11 = s ** 3 - s ** 2;
      return h00 * YS[i] + h10 * h * slope[i] + h01 * YS[i + 1] + h11 * h * slope[i + 1];
    }
    const tempCurve = (t: number) => (curveRaw(t) / PEAK) * 100; // relative units, made-up peak = 100

    // Oxygen factor from the yeast table, relative to 20.9 % (2.7 units): 1.7/2.7, 1.2/2.7, 0/2.7.
    const O_X = [0, 0.5, 1.0, 20.9];
    const O_Y = [0, 1.2 / 2.7, 1.7 / 2.7, 1];
    function o2Factor(o: number): number {
      if (o >= 20.9) return 1;
      if (o <= 0) return 0;
      for (let i = 0; i < O_X.length - 1; i++) {
        if (o <= O_X[i + 1]) return O_Y[i] + ((o - O_X[i]) / (O_X[i + 1] - O_X[i])) * (O_Y[i + 1] - O_Y[i]);
      }
      return 1;
    }
    // More sugar helps only up to a point; level 3 = 1.00. More seeds: in proportion; 5 seeds = 1.00.
    const sugarFactor = (s: number) => (s / (s + 1.5)) / (3 / 4.5);
    const seedFactor = (k: number) => k / 5;

    const CAP = 800; // balloon full, relative units
    const RATE_MAX = 220; // top of the bar and of the plot

    type Org = 'seeds' | 'yeast';
    const state = {
      org: 'seeds' as Org,
      sealed: false,
      amt: { seeds: 5, yeast: 3 },
      gas: 0,
      o2: 20.9,
      time: 0,
      running: false,
      started: false,
      full: false,
      last: 0,
      timer: 0,
    };

    const amtFactor = () => (state.org === 'seeds' ? seedFactor(state.amt.seeds) : sugarFactor(state.amt.yeast));
    const temp = () => parseInt(tempIn.value, 10);
    const rateAt = (t: number, o: number) => tempCurve(t) * o2Factor(o) * amtFactor();
    const rateNow = () => rateAt(temp(), state.o2);

    // ---- drawing ---------------------------------------------------------------
    const PX0 = 50, PX1 = 346, PY0 = 22, PY1 = 196;
    const px = (t: number) => PX0 + (t / 50) * (PX1 - PX0);
    const py = (r: number) => PY1 - (Math.min(r, RATE_MAX) / RATE_MAX) * (PY1 - PY0);

    function addText(parent: SVGElement, x: number, y: number, s: string, anchor: string, size = 13) {
      const t = svgEl('text', { x, y, 'text-anchor': anchor, 'font-size': size, fill: INK });
      t.textContent = s;
      parent.appendChild(t);
    }

    function drawPlot() {
      plot.replaceChildren();
      // grid + axes
      for (const r of [0, 100, 200]) {
        plot.appendChild(svgEl('line', { x1: PX0, y1: py(r), x2: PX1, y2: py(r), stroke: FAINT, 'stroke-width': r === 0 ? 1.2 : 0.7, 'stroke-dasharray': r === 0 ? '' : '2 3' }));
        addText(plot, PX0 - 6, py(r) + 4, String(r), 'end');
      }
      plot.appendChild(svgEl('line', { x1: PX0, y1: PY0, x2: PX0, y2: PY1, stroke: INK, 'stroke-width': 1.2 }));
      for (const t of [0, 10, 20, 30, 40, 50]) {
        plot.appendChild(svgEl('line', { x1: px(t), y1: PY1, x2: px(t), y2: PY1 + 4, stroke: INK, 'stroke-width': 1 }));
        addText(plot, px(t), PY1 + 18, String(t), 'middle');
      }
      addText(plot, (PX0 + PX1) / 2, PY1 + 38, 'water bath temperature (°C)', 'middle');
      addText(plot, 4, 14, 'rate (relative units)', 'start');
      // pea table range bars (raw table, scaled the same way as the curve: 100 = made-up peak)
      const showBars = state.org === 'seeds' && state.amt.seeds === 5 && !state.sealed;
      for (let i = 0; showBars && i < LO.length; i++) {
        const x = px(i * 5);
        plot.appendChild(svgEl('line', { x1: x, y1: py((LO[i] / PEAK) * 100), x2: x, y2: py((HI[i] / PEAK) * 100), stroke: '#8d8d99', 'stroke-width': 5, 'stroke-linecap': 'butt', opacity: 0.55 }));
      }
      // the curve for the current settings
      const o = state.o2;
      let d1 = '', d2 = '';
      for (let t = 0; t <= 50; t += 0.5) {
        const seg = (t === 0 ? 'M' : 'L') + px(t).toFixed(1) + ' ' + py(rateAt(t, o)).toFixed(1) + ' ';
        if (t <= 25) d1 += seg;
        if (t >= 25) d2 += (t === 25 ? 'M' : 'L') + px(t).toFixed(1) + ' ' + py(rateAt(t, o)).toFixed(1) + ' ';
      }
      plot.appendChild(svgEl('path', { d: d1.trim(), fill: 'none', stroke: ACCENT, 'stroke-width': 3 }));
      plot.appendChild(svgEl('path', { d: d2.trim(), fill: 'none', stroke: ACCENT, 'stroke-width': 3, 'stroke-dasharray': '6 4' }));
      // marker
      const t = temp(), r = rateNow();
      plot.appendChild(svgEl('line', { x1: px(t), y1: py(r), x2: px(t), y2: PY1, stroke: ORANGE, 'stroke-width': 1.4, 'stroke-dasharray': '3 3' }));
      plot.appendChild(svgEl('circle', { cx: px(t), cy: py(r), r: 6, fill: ORANGE, stroke: '#fff', 'stroke-width': 1.5 }));
    }

    function buildOrgs() {
      orgsG.replaceChildren();
      sugarG.replaceChildren();
      if (state.org === 'seeds') {
        const k = state.amt.seeds;
        for (let i = 0; i < k; i++) {
          const row = i < 5 ? 0 : 1, col = i % 5;
          const cx = row === 0 ? 110 + col * 20 : 106 + col * 22;
          const cy = row === 0 ? 296 : 280;
          orgsG.appendChild(svgEl('ellipse', { cx, cy, rx: 8, ry: 5, fill: '#e8d9a0', stroke: '#8a7a2e', 'stroke-width': 1.4 }));
        }
      } else {
        const spots: number[][] = [[112, 296], [132, 298], [152, 296], [172, 298], [192, 296], [120, 282], [142, 284], [164, 282], [186, 284], [132, 268], [156, 270], [178, 268]];
        for (const s of spots) orgsG.appendChild(svgEl('circle', { cx: s[0], cy: s[1], r: 6, fill: '#f6efe2', stroke: '#8a6b2e', 'stroke-width': 1.4 }));
        const sug: number[][] = [[130, 246], [150, 252], [170, 246], [140, 262], [160, 262], [182, 256]];
        for (let i = 0; i < state.amt.yeast; i++) {
          sugarG.appendChild(svgEl('rect', { x: sug[i][0] - 4, y: sug[i][1] - 4, width: 8, height: 8, fill: '#fff', stroke: '#6b6b78', 'stroke-width': 1.3 }));
        }
      }
      orgL1.textContent = state.org === 'seeds' ? 'sprouting seeds' : 'yeast cells';
      orgL2.textContent = state.org === 'seeds' ? 'in water' : 'in sugar water';
    }

    function setAmtControl() {
      if (state.org === 'seeds') {
        amtIn.min = '1'; amtIn.max = '10'; amtIn.value = String(state.amt.seeds);
        amtLabel.innerHTML = 'Number of seeds: <em data-out="amt">' + state.amt.seeds + '</em>';
      } else {
        amtIn.min = '1'; amtIn.max = '6'; amtIn.value = String(state.amt.yeast);
        amtLabel.innerHTML = 'Sugar in the water: level <em data-out="amt">' + state.amt.yeast + '</em> of 6 (relative units)';
      }
    }

    function statusText(rate: number): string {
      if (!state.started && state.time === 0) return 'Press Start. The balloon collects carbon dioxide from the cells.';
      if (state.full) return 'The balloon is full. Press Reset to try again.';
      const t = temp();
      let main: string;
      if (state.sealed && state.o2 <= 0.05) {
        return 'The sealed flask has no oxygen left, so the rate is about zero in this sketch.';
      } else if (state.sealed && state.o2 < 20.4) {
        main = 'The flask is sealed. Oxygen is being used up, so the rate falls.';
      } else if (state.sealed) {
        main = 'The flask is sealed: no fresh air gets in. Watch the rate.';
      } else if (t >= 40) {
        main = 'Too much heat damages cells, and respiration slows or stops.';
      } else if (t >= 33) {
        main = 'Hotter than this, the rate drops in this sketch. Too much heat damages cells.';
      } else if (t >= 26) {
        main = 'Warmer water: the rate still rises, but more slowly in this sketch.';
      } else if (t <= 5) {
        main = 'Cold water: respiration is slow, so the balloon fills slowly.';
      } else {
        main = 'Warmer water: cells usually respire faster, so the balloon fills faster.';
      }
      let extra = '';
      if (state.org === 'yeast') {
        if (state.amt.yeast <= 1) extra = ' With little sugar, respiration slows.';
        else if (state.amt.yeast >= 5) extra = ' More sugar helps only up to a point.';
      } else {
        if (state.amt.seeds <= 2) extra = ' In this sketch, fewer seeds give off less carbon dioxide in total.';
        else if (state.amt.seeds >= 9) extra = ' In this sketch, more seeds give off more carbon dioxide in total.';
      }
      void rate;
      return main + extra;
    }

    function render() {
      const t = temp();
      const rate = rateNow();
      // bath, labels, thermometer
      const hue = 205 - (t / 50) * 185;
      bath.setAttribute('fill', 'hsl(' + hue.toFixed(0) + ' 65% 88%)');
      bathLabel.textContent = 'water bath: ' + t + ' °C';
      const yT = (v: number) => 282 - (Math.min(v, 50) / 50) * 160;
      const yB = yT(t);
      merc.setAttribute('y', yB.toFixed(1));
      merc.setAttribute('height', (292 - yB).toFixed(1));
      // balloon
      const frac = Math.min(state.gas / CAP, 1);
      const ry = 6 + 52 * Math.sqrt(frac), rx = 5 + 36 * Math.sqrt(frac);
      balloon.setAttribute('ry', ry.toFixed(1));
      balloon.setAttribute('rx', rx.toFixed(1));
      balloon.setAttribute('cy', (124 - ry).toFixed(1));
      // air inlet
      airOpen.style.display = state.sealed ? 'none' : '';
      airSeal.style.display = state.sealed ? '' : 'none';
      airLabel.textContent = state.sealed ? 'sealed' : 'fresh air in';
      airLabel.setAttribute('x', state.sealed ? '160' : '174');
      // bar and readouts
      const shown = state.started ? rate : 0;
      bar.style.width = Math.min(shown / RATE_MAX, 1) * 100 + '%';
      oRate.textContent = String(Math.round(shown));
      oTemp.textContent = String(t);
      const amtOut = root.querySelector<HTMLElement>('[data-amtlabel] em');
      if (amtOut) amtOut.textContent = String(state.org === 'seeds' ? state.amt.seeds : state.amt.yeast);
      oGas.textContent = Math.round(frac * 100) + ' of 100 (relative units)';
      oO2.textContent = (state.sealed ? Math.round(state.o2) : 21) + ' %' + (state.sealed ? '' : ' (fresh air)');
      oTime.textContent = Math.round(state.time) + ' time units';
      if (state.org === 'yeast') {
        tableLine.textContent = '';
        tableLine.style.display = 'none';
      } else {
        tableLine.style.display = '';
        if (t <= 25 && t % 5 === 0) {
          const i = t / 5;
          tableLine.textContent = 'Pea table at ' + t + ' °C: ' + LO[i] + ' to ' + HI[i] + ' mg of carbon dioxide per kg of peas per hour.';
        } else if (t <= 25) {
          tableLine.textContent = 'Between table rows; the table has no value here.';
        } else {
          tableLine.textContent = 'The pea table stops at 25 °C, so the curve above 25 °C is made up.';
        }
      }
      keySolid.textContent = state.org === 'seeds'
        ? 'follows the pea table at 5 seeds, open flask (0 to 25 °C); the peas stand in for sprouting seeds'
        : 'temperature curve borrowed from peas in this sketch';
      keyBarWrap.style.display = state.org === 'seeds' ? '' : 'none';
      assume.textContent = (state.org === 'seeds'
        ? 'In this sketch the curve is one smooth made-up line. From 0 to 25 °C, at 5 seeds with the flask open, it passes through the middle of each row of the pea table; above 25 °C it is invented. '
        : 'In this sketch the curve is one smooth made-up line. Yeast uses the pea temperature curve in this sketch; the lesson has no yeast temperature data. ') +
        'The oxygen falling in the sealed flask, and the rate between the table’s oxygen values, are made up. The number-of-seeds and sugar effects are made up. Sugar never runs out. Cells and the flask are drawn as shapes, not molecules. With no oxygen the rate simply falls to zero; the way cells release energy without oxygen, which you study in Biology, is left out. Oxygen values come from the yeast table and are used for seeds too.';
      const st = statusText(rate);
      if (st !== status.textContent) status.textContent = st;
      goBtn.textContent = state.running ? 'Pause' : state.started ? 'Keep going' : 'Start';
      goBtn.disabled = state.full;
      drawPlot();
    }

    // ---- the run ---------------------------------------------------------------
    function tick() {
      if (!state.running) return;
      const now = performance.now();
      const dt = Math.min((now - state.last) / 1000, 0.1);
      state.last = now;
      const r = rateNow();
      state.time += dt;
      state.gas += r * dt;
      if (state.sealed) state.o2 = Math.max(0, state.o2 - 0.05 * r * dt);
      if (state.gas >= CAP) { state.gas = CAP; state.full = true; state.running = false; window.clearInterval(state.timer); }
      render();
    }
    function play() {
      if (state.full) return;
      state.running = true; state.started = true;
      state.last = performance.now();
      window.clearInterval(state.timer);
      state.timer = window.setInterval(tick, 50);
      render();
    }
    function pause() { state.running = false; window.clearInterval(state.timer); render(); }
    function emptyFlask() {
      state.gas = 0; state.time = 0; state.o2 = 20.9; state.full = false; state.started = false;
    }

    goBtn.addEventListener('click', () => { if (state.running) pause(); else play(); });
    resetBtn.addEventListener('click', () => {
      pause();
      state.org = 'seeds'; state.sealed = false; state.amt = { seeds: 5, yeast: 3 };
      emptyFlask();
      tempIn.value = '10';
      syncToggles(); setAmtControl(); buildOrgs(); render();
    });
    tempIn.addEventListener('input', render);
    amtIn.addEventListener('input', () => {
      const v = parseInt(amtIn.value, 10);
      if (state.org === 'seeds') state.amt.seeds = v; else state.amt.yeast = v;
      buildOrgs(); render();
    });
    orgBtns.forEach((b) => b.addEventListener('click', () => {
      const o = b.dataset.org === 'yeast' ? 'yeast' : 'seeds';
      if (o === state.org) return;
      pause(); state.org = o; emptyFlask();
      syncToggles(); setAmtControl(); buildOrgs(); render();
    }));
    airBtns.forEach((b) => b.addEventListener('click', () => {
      const sealed = b.dataset.air === 'sealed';
      if (sealed === state.sealed) return;
      state.sealed = sealed;
      if (!sealed) state.o2 = 20.9;
      syncToggles(); render();
    }));
    function syncToggles() {
      orgBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.org === state.org)));
      airBtns.forEach((b) => b.setAttribute('aria-pressed', String((b.dataset.air === 'sealed') === state.sealed)));
    }

    void scene;
    syncToggles(); setAmtControl(); buildOrgs(); render();
  });
</script>

