---
/**
 * The Side Hops of one lesson, placed right after the lesson text.
 *
 * With scripts off this is a labelled section: the audio, its transcript and every card. With scripts
 * on, the script below runs the three views chosen in SideHopsSwitch.astro:
 *   Full lesson      each card moves to the end of its section; this section is hidden
 *   Just the films   the films, copied out of the <template> only while this view is open, so the
 *                    page never holds two live copies of a film
 *   Side Hops        the cards move back here, under the audio
 * The film markup is written here, not taken from LessonFilm.astro: importing that component would add
 * its styles to every lesson page, and a lesson without Side Hops must stay exactly as it was.
 * The cards carry data-no-hl, and lesson.mdx is untouched, so highlights, Listen and search are unaffected.
 */
import FilmTranscript from './FilmTranscript.astro';
import SideHopCard from './SideHopCard.astro';
import type { SideHopsData } from '../lib/side-hops';

interface Film {
  src: string;
  captions: string;
  poster: string;
  title: string;
  durationSec: number;
  predatesCorrection?: string;
  takeaways?: string[];
}
interface Props {
  data: SideHopsData;
  /** The lesson's headings, from render(). */
  headings: { depth: number; slug: string; text: string }[];
  films: Film[];
}
const { data, headings, films } = Astro.props;
const sections = headings.filter((h) => h.depth === 2);
const hops = data.hops.map((hop) => {
  const at = sections.findIndex((h) => h.text === hop.afterHeading);
  if (at < 0) throw new Error(`Side Hops for ${data.slug}: no ## heading "${hop.afterHeading}" in the lesson`);
  return { hop, before: sections[at + 1]?.slug };
});
const { audio } = data;
const clock = (s: number) => `${Math.floor(s / 60)}:${String(Math.round(s % 60)).padStart(2, '0')}`;
const paragraphs = audio.transcript.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
---

<section class="sh-panel" data-sh-panel aria-labelledby="sh-panel-h">
  <h2 class="sh-panel-h" id="sh-panel-h">Side Hops</h2>
  <p class="sh-intro">Real stories and things to try that go with this lesson.</p>
  <div class="sh-player">
    <h3 class="sh-player-h">{audio.title}</h3>
    <audio controls preload="none" src={`/${audio.file}`}>
      <a href={`/${audio.file}`}>Download the audio (MP3)</a>
    </audio>
    <p class="sh-note">{clock(audio.durationSec)} · Narration: {audio.narration}.</p>
    <details class="sh-transcript">
      <summary>Read the transcript</summary>
      {paragraphs.map((p) => <p>{p}</p>)}
    </details>
  </div>
  <div data-sh-cards>
    {hops.map(({ hop, before }) => <SideHopCard hop={hop} before={before} />)}
  </div>
  <p class="sh-back" data-sh-back hidden><a href="#top" data-sh-full>Back to the full lesson</a></p>
</section>

{films.length > 0 && (
  <section class="sh-films" data-sh-films aria-labelledby="sh-films-h" hidden>
    <h2 class="sh-panel-h" id="sh-films-h">Just the films</h2>
    <div data-sh-films-slot></div>
    <p class="sh-back"><a href="#top" data-sh-full>Back to the full lesson</a></p>
    <template data-sh-films-copy>
      {films.map((f, i) => (
        <div class="sh-film">
          <figure>
            <video controls preload="none" playsinline poster={f.poster} width="1920" height="1080">
              <source src={f.src} type="video/mp4" />
              <track kind="captions" src={f.captions} srclang="en" label="English" />
              Your browser cannot play this video. <a href={f.src}>Download the film (MP4)</a>.
            </video>
            <figcaption>{f.title} <span>· {clock(f.durationSec)}</span></figcaption>
          </figure>
          {f.predatesCorrection && <p class="sh-film-note"><strong>This film was made before a correction to the lesson text.</strong> {f.predatesCorrection}</p>}
          {f.takeaways && f.takeaways.length > 0 && (
            <div class="sh-film-takes">
              <p>From the film</p>
              <ul>{f.takeaways.map((t) => <li>{t}</li>)}</ul>
            </div>
          )}
          <FilmTranscript captions={f.captions} title={f.title} id={`side-hops-${i}`} />
        </div>
      ))}
    </template>
  </section>
)}

<script is:inline>
  (function () {
    var page = document.getElementById('top');
    var box = document.querySelector('[data-sh-switch]');
    var panel = document.querySelector('[data-sh-panel]');
    var prose = document.querySelector('.prose-col[data-lesson-title]');
    if (!page || !box || !panel || !prose) return;
    var home = panel.querySelector('[data-sh-cards]');
    var cards = Array.prototype.slice.call(panel.querySelectorAll('[data-sh-card]'));
    var filmsPane = document.querySelector('[data-sh-films]');
    var status = box.querySelector('[data-sh-status]');
    var KEY = 'stemhop:side-hops:view:' + box.getAttribute('data-slug');
    var SAID = { full: 'Showing the full lesson', films: 'Showing just the films', hops: 'Showing Side Hops' };
    var view = '';

    // ---- where each card goes ----
    function toSection(card) {
      var id = card.getAttribute('data-sh-before');
      var next = id ? document.getElementById(id) : null;
      if (!next || !prose.contains(next)) { prose.appendChild(card); return; }
      while (next.parentNode !== prose) next = next.parentNode;
      prose.insertBefore(card, next);
    }

    // ---- the three views ----
    function show(next) {
      if (next === view) return;
      var leaving = view;
      view = next;
      page.querySelectorAll('audio, video').forEach(function (m) { m.pause(); });
      if (leaving === 'full' && next !== 'full') {
        var listen = document.querySelector('[data-listen-player]:not([hidden]) [data-lp="close"]');
        if (listen) listen.click();
      }
      cards.forEach(function (c) { if (next === 'hops') home.appendChild(c); else toSection(c); });
      if (filmsPane) {
        var slot = filmsPane.querySelector('[data-sh-films-slot]');
        slot.replaceChildren();
        if (next === 'films') slot.appendChild(filmsPane.querySelector('[data-sh-films-copy]').content.cloneNode(true));
        filmsPane.hidden = next !== 'films';
      }
      page.setAttribute('data-sh-view', next);
    }
    function choose(next) {
      show(next);
      status.textContent = SAID[next];
      try {
        if (next === 'full') localStorage.removeItem(KEY); else localStorage.setItem(KEY, next);
      } catch (e) { /* storage blocked: the choice lasts until the page closes */ }
    }

    box.addEventListener('change', function (e) { if (e.target.name === 'sh-view') choose(e.target.value); });
    page.querySelectorAll('[data-sh-full]').forEach(function (a) {
      a.addEventListener('click', function (e) {
        e.preventDefault();
        var radio = box.querySelector('input[value="full"]');
        radio.checked = true;
        choose('full');
        box.scrollIntoView({ block: 'start' });
        radio.focus({ preventScroll: true });
      });
    });
    panel.querySelector('[data-sh-back]').hidden = false;
    // A link to a spot in the lesson (the notebook, "Continue at") opens the lesson first.
    window.addEventListener('hashchange', function () {
      if (view === 'full') return;
      var el = null;
      try { el = document.getElementById(decodeURIComponent(location.hash.slice(1))); } catch (e) { return; }
      if (!el || el === page || panel.contains(el) || (filmsPane && filmsPane.contains(el))) return;
      box.querySelector('input[value="full"]').checked = true;
      choose('full');
      el.scrollIntoView();
    });

    // ---- Hex ----
    var calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    function hop(card) {
      card.removeAttribute('data-sh-wait');
      card.classList.remove('is-hopping');
      void card.offsetWidth;
      card.classList.add('is-hopping');
    }
    if (!calm) {
      cards.forEach(function (card) {
        var hex = card.querySelector('[data-sh-hex]');
        hex.disabled = false;
        hex.removeAttribute('aria-hidden');
        hex.removeAttribute('tabindex');
        hex.addEventListener('click', function () { hop(card); });
      });
      if ('IntersectionObserver' in window) {
        var watcher = new IntersectionObserver(function (seen) {
          seen.forEach(function (s) {
            if (!s.isIntersecting) return;
            watcher.unobserve(s.target);
            hop(s.target);
          });
        }, { rootMargin: '0px 0px -12% 0px' });
        cards.forEach(function (card) {
          card.setAttribute('data-sh-wait', '');
          watcher.observe(card);
        });
      }
    }

    show(page.getAttribute('data-sh-view') || 'full');
  })();
</script>
