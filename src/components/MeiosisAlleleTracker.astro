---
/**
 * MeiosisAlleleTracker — step one cell heterozygous at two genes on different chromosomes
 * (Aa Bb) through the lesson's meiosis: G1, prophase I after S phase, metaphase I, after
 * meiosis I, after meiosis II. The learner chooses how the two bivalents face the spindle at
 * metaphase I (A with B toward one pole, A with b toward one pole, or chosen at random in each
 * meiosis). One meiosis gives two kinds of product, 2 AB + 2 ab or 2 Ab + 2 aB (lesson rule);
 * a tally of N meioses shows all four classes at 1/4 each only when the orientation is random,
 * with the expected count beside the observed one. Chromosome, chromatid and C-value counts
 * follow the lesson's table for a cell with two pairs (2n = 4). Crossing over is left out, as
 * the lesson does for this case. Labelled bars only. Self-contained vanilla-TS Astro island. Original.
 */
---

<figure class="mat card" data-mat>
  <figcaption class="mat-head">Meiosis allele tracker: Aa Bb through two divisions<span class="mat-chip">⚙ original · interactive</span></figcaption>

  <svg class="mat-svg" viewBox="0 0 360 250" role="img" aria-label="A cell with two chromosome pairs, one carrying A and a and the other carrying B and b, shown at the chosen stage of meiosis" data-stage-svg></svg>

  <div class="mat-row">
    <span class="mat-label" id="mat-stage-label">Stage</span>
    <div class="mat-stages" role="group" aria-labelledby="mat-stage-label" data-stages></div>
  </div>

  <div class="mat-controls">
    <label class="mat-field"><span>Orientation of the two bivalents at metaphase I</span>
      <select data-ori>
        <option value="AB">A and B face the same pole</option>
        <option value="Ab">A and b face the same pole</option>
        <option value="rand">Each meiosis picks one at random</option>
      </select>
    </label>
    <label class="mat-field"><span>Meioses tallied</span>
      <select data-n>
        <option value="10">10</option>
        <option value="50" selected>50</option>
        <option value="200">200</option>
        <option value="1000">1,000</option>
      </select>
    </label>
    <button type="button" class="mat-btn" data-resample>Resample</button>
  </div>

  <dl class="mat-readout">
    <div><dt>cells</dt><dd data-r-cells>–</dd></div>
    <div><dt>ploidy of each cell</dt><dd data-r-ploidy>–</dd></div>
    <div><dt>chromosomes per cell</dt><dd data-r-chrom>–</dd></div>
    <div><dt>chromatids per cell</dt><dd data-r-chrt>–</dd></div>
    <div><dt>DNA per cell</dt><dd data-r-c>–</dd></div>
  </dl>

  <svg class="mat-svg" viewBox="0 0 360 150" role="img" aria-label="Bars of the observed number of AB, Ab, aB and ab gametes from the tallied meioses, with the expected number marked beside each" data-tally-svg></svg>

  <p class="mat-verdict" data-verdict role="status"></p>

  <p class="mat-foot">Rule to keep: anaphase I separates homologs and anaphase II separates sisters, so one meiosis gives two kinds of product, and only across many meioses with random orientation does each of AB, Ab, aB and ab make up 1/4. This is a sketch of the logic with two chromosome pairs and no crossing over.</p>
</figure>

<script>
  const NS = 'http://www.w3.org/2000/svg';
  const C1 = '#2f6f8f', C2 = '#7a5ea8', INK = '#4b4b55', FAINT = '#8a8a96', GRID = '#d9d9e0', TEAL = '#0e7c86', ORANGE = '#e57200';
  type Ori = 'AB' | 'Ab' | 'rand';
  const STAGES = ['G1, before S', 'Prophase I, after S', 'Metaphase I', 'After meiosis I', 'After meiosis II'];
  // Per-cell counts for a cell with two pairs (2n = 4), by the lesson's rules.
  const COUNTS = [
    { cells: 1, ploidy: 'diploid (2n)', chrom: 4, chrt: 4, c: '2C' },
    { cells: 1, ploidy: 'diploid (2n)', chrom: 4, chrt: 8, c: '4C' },
    { cells: 1, ploidy: 'diploid (2n)', chrom: 4, chrt: 8, c: '4C' },
    { cells: 2, ploidy: 'haploid (n)', chrom: 2, chrt: 4, c: '2C' },
    { cells: 4, ploidy: 'haploid (n)', chrom: 2, chrt: 2, c: '1C' },
  ];
  function el(name: string, attrs: Record<string, string | number>, text?: string): SVGElement {
    const e = document.createElementNS(NS, name);
    for (const k in attrs) e.setAttribute(k, String(attrs[k]));
    if (text !== undefined) e.textContent = text;
    return e;
  }
  const fmt = (x: number) => x.toLocaleString('en-US');

  document.querySelectorAll<HTMLElement>('[data-mat]').forEach((root) => {
    const svg = root.querySelector<SVGSVGElement>('[data-stage-svg]')!;
    const tally = root.querySelector<SVGSVGElement>('[data-tally-svg]')!;
    const stagesEl = root.querySelector<HTMLElement>('[data-stages]')!;
    const oriSel = root.querySelector<HTMLSelectElement>('[data-ori]')!;
    const nSel = root.querySelector<HTMLSelectElement>('[data-n]')!;
    const verdict = root.querySelector<HTMLElement>('[data-verdict]')!;
    const q = (k: string) => root.querySelector<HTMLElement>(`[data-r-${k}]`)!;
    let stage = 0;
    let draws: boolean[] = []; // true = A and B toward the same pole

    function resample() {
      const n = Number(nSel.value);
      draws = Array.from({ length: n }, () => Math.random() < 0.5);
    }
    const ori = () => oriSel.value as Ori;
    // Orientation shown in the single cell: the chosen one, or the first draw of the tally.
    const shownAB = () => (ori() === 'rand' ? draws[0] : ori() === 'AB');

    function chrom(cx: number, cy: number, len: number, rep: boolean, label: string, color: string) {
      if (rep) {
        svg.appendChild(el('rect', { x: cx - len / 2, y: cy - 7, width: len, height: 6, rx: 2, fill: color }));
        svg.appendChild(el('rect', { x: cx - len / 2, y: cy + 1, width: len, height: 6, rx: 2, fill: color }));
        svg.appendChild(el('rect', { x: cx - 2.5, y: cy - 9, width: 5, height: 18, fill: INK }));
        svg.appendChild(el('text', { x: cx, y: cy - 13, 'font-size': 12, 'font-weight': 700, 'text-anchor': 'middle', fill: INK }, label));
      } else {
        svg.appendChild(el('rect', { x: cx - len / 2, y: cy - 3, width: len, height: 6, rx: 2, fill: color }));
        svg.appendChild(el('rect', { x: cx - 2.5, y: cy - 5, width: 5, height: 10, fill: INK }));
        svg.appendChild(el('text', { x: cx, y: cy - 9, 'font-size': 12, 'font-weight': 700, 'text-anchor': 'middle', fill: INK }, label));
      }
    }
    function cell(x: number, y: number, w: number, h: number, note: string) {
      svg.appendChild(el('rect', { x, y, width: w, height: h, rx: 14, fill: '#fff', stroke: FAINT, 'stroke-width': 1.5 }));
      svg.appendChild(el('text', { x: x + w / 2, y: y + h - 7, 'font-size': 10, 'text-anchor': 'middle', fill: INK }, note));
    }
    function draw() {
      svg.replaceChildren();
      const ab = shownAB();
      const L1 = 70, L2 = 44;
      if (stage <= 1) {
        cell(6, 6, 348, 238, stage === 0 ? 'diploid cell, 4 chromosomes in 2 homologous pairs' : 'diploid cell after S phase: 2 bivalents');
        const ya = stage === 0 ? 80 : 112, yb = stage === 0 ? 170 : 138;
        chrom(100, ya, L1, stage === 1, 'A', C1);
        chrom(100, yb + 8, L1, stage === 1, 'a', C1);
        chrom(260, ya, L2, stage === 1, 'B', C2);
        chrom(260, yb + 8, L2, stage === 1, 'b', C2);
        svg.appendChild(el('text', { x: 100, y: 32, 'font-size': 10, 'text-anchor': 'middle', fill: C1 }, 'pair 1: A and a'));
        svg.appendChild(el('text', { x: 260, y: 32, 'font-size': 10, 'text-anchor': 'middle', fill: C2 }, 'pair 2: B and b'));
        if (stage === 1) {
          svg.appendChild(el('text', { x: 100, y: 190, 'font-size': 10, 'text-anchor': 'middle', fill: INK }, 'bivalent: 4 chromatids'));
          svg.appendChild(el('text', { x: 260, y: 190, 'font-size': 10, 'text-anchor': 'middle', fill: INK }, 'bivalent: 4 chromatids'));
        }
      } else if (stage === 2) {
        cell(6, 6, 348, 238, 'metaphase I');
        svg.appendChild(el('text', { x: 180, y: 22, 'font-size': 10, 'text-anchor': 'middle', fill: INK }, 'pole'));
        svg.appendChild(el('text', { x: 180, y: 218, 'font-size': 10, 'text-anchor': 'middle', fill: INK }, 'pole'));
        svg.appendChild(el('line', { x1: 14, y1: 125, x2: 346, y2: 125, stroke: GRID, 'stroke-width': 1.5, 'stroke-dasharray': '4 3' }));
        const topB = ab ? 'B' : 'b', botB = ab ? 'b' : 'B';
        const items: [number, number, number, string, string][] = [
          [100, 90, L1, 'A', C1], [100, 160, L1, 'a', C1], [260, 90, L2, topB, C2], [260, 160, L2, botB, C2],
        ];
        for (const [cx, cy] of items) {
          const top = cy < 125;
          svg.appendChild(el('line', { x1: 180, y1: top ? 28 : 212, x2: cx, y2: top ? cy - 22 : cy + 12, stroke: FAINT, 'stroke-width': 1 }));
        }
        for (const [cx, cy, len, lab, col] of items) chrom(cx, cy, len, true, lab, col);
      } else if (stage === 3) {
        const topB = ab ? 'B' : 'b', botB = ab ? 'b' : 'B';
        cell(6, 6, 348, 112, 'haploid cell · 2 chromosomes · 2C');
        cell(6, 132, 348, 112, 'haploid cell · 2 chromosomes · 2C');
        chrom(100, 62, L1, true, 'A', C1); chrom(260, 62, L2, true, topB, C2);
        chrom(100, 188, L1, true, 'a', C1); chrom(260, 188, L2, true, botB, C2);
      } else {
        const topB = ab ? 'B' : 'b', botB = ab ? 'b' : 'B';
        const cells: [number, number, string, string][] = [
          [6, 6, 'A', topB], [189, 6, 'A', topB], [6, 132, 'a', botB], [189, 132, 'a', botB],
        ];
        for (const [x, y, a1, b1] of cells) {
          cell(x, y, 165, 112, 'haploid product: ' + a1 + b1);
          chrom(x + 47, y + 56, L1, false, a1, C1);
          chrom(x + 120, y + 56, L2, false, b1, C2);
        }
      }
    }
    function counts() {
      const c = COUNTS[stage];
      q('cells').textContent = String(c.cells);
      q('ploidy').textContent = c.ploidy;
      q('chrom').textContent = String(c.chrom);
      q('chrt').textContent = String(c.chrt);
      q('c').textContent = c.c;
    }
    function tallyCounts() {
      const n = draws.length, o = ori();
      let nAB = 0;
      for (const d of draws) if (o === 'rand' ? d : o === 'AB') nAB++;
      if (o !== 'rand') nAB = o === 'AB' ? n : 0;
      const nAb = n - nAB;
      const obs = { AB: 2 * nAB, ab: 2 * nAB, Ab: 2 * nAb, aB: 2 * nAb };
      const exp = o === 'rand' ? { AB: n, ab: n, Ab: n, aB: n }
        : o === 'AB' ? { AB: 2 * n, ab: 2 * n, Ab: 0, aB: 0 } : { AB: 0, ab: 0, Ab: 2 * n, aB: 2 * n };
      return { n, nAB, nAb, obs, exp };
    }
    function drawTally() {
      tally.replaceChildren();
      const { obs, exp } = tallyCounts();
      const keys = ['AB', 'Ab', 'aB', 'ab'] as const;
      const max = Math.max(1, ...keys.map((k) => Math.max(obs[k], exp[k])));
      const x0 = 44, W = 215;
      tally.appendChild(el('text', { x: 6, y: 14, 'font-size': 10, fill: INK }, 'gametes from the tallied meioses (bar = observed, orange tick = expected)'));
      tally.appendChild(el('text', { x: 354, y: 30, 'font-size': 10, 'text-anchor': 'end', fill: INK }, 'observed / expected'));
      keys.forEach((k, i) => {
        const y = 38 + i * 27;
        tally.appendChild(el('text', { x: 6, y: y + 14, 'font-size': 12, 'font-weight': 700, fill: INK }, k));
        tally.appendChild(el('rect', { x: x0, y: y + 2, width: W, height: 16, fill: '#f3f3f6' }));
        if (obs[k] > 0) tally.appendChild(el('rect', { x: x0, y: y + 2, width: (obs[k] / max) * W, height: 16, fill: TEAL }));
        const ex = x0 + (exp[k] / max) * W;
        tally.appendChild(el('line', { x1: ex, y1: y - 1, x2: ex, y2: y + 21, stroke: ORANGE, 'stroke-width': 2.5 }));
        tally.appendChild(el('text', { x: 354, y: y + 14, 'font-size': 10, 'text-anchor': 'end', fill: INK }, `${fmt(obs[k])} / ${fmt(exp[k])}`));
      });
    }
    function say() {
      const ab = shownAB();
      const topB = ab ? 'B' : 'b', botB = ab ? 'b' : 'B';
      const kinds = ab ? '2 AB + 2 ab' : '2 Ab + 2 aB';
      let s: string;
      if (stage === 0) s = 'G1, before S phase: a diploid cell, Aa Bb, with the two genes on different chromosomes. Each chromosome is one chromatid, so 4 chromosomes, 4 chromatids, 2C.';
      else if (stage === 1) s = 'S phase has copied every chromosome into two sister chromatids: still 4 chromosomes, now 8 chromatids and 4C. In prophase I the homologs synapse, and each synapsed pair is a bivalent, so there are 2 bivalents.';
      else if (stage === 2) s = `At metaphase I each bivalent has its two homologs facing opposite poles. Here A and ${topB} face the top pole and a and ${botB} the bottom pole. How one pair faces does not affect how the other does.`;
      else if (stage === 3) s = `Anaphase I pulled the homologs apart, not the sisters, so A and a went to different cells. Each cell is haploid with 2 chromosomes, still two chromatids each, so 2C. The top cell carries A and ${topB}; the bottom cell carries a and ${botB}.`;
      else s = `There was no S phase between the divisions. Anaphase II pulled apart identical sisters, giving 4 haploid products at 1C. This one meiosis made two kinds: ${kinds}.`;
      const t = tallyCounts();
      if (ori() === 'rand') {
        s += ` Tally: ${fmt(t.n)} meioses, each with its own random orientation, gave ${fmt(t.nAB)} of the AB and ab type and ${fmt(t.nAb)} of the Ab and aB type. The two orientations are equally likely, so each of the four classes is expected as 1/4 of the ${fmt(4 * t.n)} gametes (${fmt(t.n)}); the observed counts scatter around that.`;
      } else {
        const other = ori() === 'AB' ? 'Ab and aB' : 'AB and ab';
        s += ` Tally: if all ${fmt(t.n)} meioses took this one orientation, only ${ori() === 'AB' ? 'AB and ab' : 'Ab and aB'} gametes would appear. The orientations are equally likely, so ${other} are made too. Choose random orientation to see all four classes.`;
      }
      verdict.textContent = s;
    }
    function render() {
      stagesEl.querySelectorAll<HTMLButtonElement>('button').forEach((b, i) => b.setAttribute('aria-pressed', String(i === stage)));
      draw(); counts(); drawTally(); say();
    }
    STAGES.forEach((name, i) => {
      const b = document.createElement('button');
      b.type = 'button'; b.className = 'mat-stagebtn'; b.textContent = name;
      b.addEventListener('click', () => { stage = i; render(); });
      stagesEl.appendChild(b);
    });
    oriSel.addEventListener('change', render);
    nSel.addEventListener('change', () => { resample(); render(); });
    root.querySelector<HTMLButtonElement>('[data-resample]')!.addEventListener('click', () => { resample(); render(); });
    resample();
    render();
  });
</script>

<style is:global>
  .mat { padding: var(--ddp-space-3) var(--ddp-space-4) var(--ddp-space-4); margin: var(--ddp-space-5) 0; }
  .mat-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem; font-weight: 600; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); margin-bottom: var(--ddp-space-3); }
  .mat-chip { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 400; color: var(--ddp-color-muted); }
  .mat-svg { display: block; width: 100%; max-width: 600px; margin: 0 auto var(--ddp-space-3); height: auto; background: #fff; border: 1px solid var(--ddp-color-line); border-radius: 6px; }
  .mat-row { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem; margin: 0.35rem 0; }
  .mat-label { font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); min-width: 3.6em; }
  .mat-stages { display: flex; flex-wrap: wrap; gap: 0.3rem; }
  .mat-stagebtn, .mat-btn { border: 1px solid var(--ddp-color-line); border-radius: 5px; background: transparent; color: var(--ddp-color-ink-soft); font-size: var(--ddp-text-xs); padding: 0.3rem 0.55rem; cursor: pointer; }
  .mat-stagebtn[aria-pressed="true"] { background: var(--ddp-color-primary); border-color: var(--ddp-color-primary); color: #fff; font-weight: 700; }
  .mat-stagebtn:focus-visible, .mat-btn:focus-visible, .mat-field select:focus-visible { outline: 2px solid var(--ddp-color-accent); outline-offset: 2px; }
  .mat-controls { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 0.6rem 1rem; margin: var(--ddp-space-3) 0; }
  .mat-field { display: flex; flex-direction: column; gap: 0.2rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); min-width: 0; }
  .mat-field select { font-size: var(--ddp-text-xs); padding: 0.25rem 0.4rem; border: 1px solid var(--ddp-color-line); border-radius: 5px; background: #fff; color: var(--ddp-color-ink-soft); max-width: 100%; }
  .mat-readout { display: grid; grid-template-columns: repeat(auto-fit, minmax(7.5em, 1fr)); gap: 0.4rem; margin: 0 0 var(--ddp-space-3); }
  .mat-readout div { border: 1px solid var(--ddp-color-line); border-radius: 6px; padding: 0.3rem 0.5rem; }
  .mat-readout dt { font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .mat-readout dd { margin: 0; font-size: var(--ddp-text-sm); font-weight: 600; color: var(--ddp-color-primary); }
  .mat-verdict { margin: var(--ddp-space-2) 0; padding: var(--ddp-space-2) var(--ddp-space-3); background: color-mix(in srgb, var(--ddp-color-accent) 8%, transparent); border-radius: 6px; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); min-height: 3em; }
  .mat-foot { margin: var(--ddp-space-3) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); border-left: 3px solid var(--ddp-color-secondary); padding-left: 0.55rem; }
</style>
