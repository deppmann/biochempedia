---
/**
 * IslandEquilibriumCurves — MacArthur-Wilson immigration and extinction curves for an
 * island drawing on a pool of P = 100 species. I(S) = I0(1 - S/100), E(S) = eS. The
 * crossing is S*; an inset shows S filling from an empty island, with a random run
 * (Resample) beside the deterministic curve. Self-contained vanilla-TS Astro island.
 * Original.
 */
---

<figure class="ieq card" data-ieq>
  <figcaption class="ieq-head">Island equilibrium — immigration and extinction curves<span class="ieq-chip">⚙ original · interactive</span></figcaption>

  <svg class="ieq-svg" viewBox="0 0 340 230" role="img" aria-label="Immigration rate falling and extinction rate rising with species richness S on an island, crossing at the equilibrium S star" data-plot></svg>
  <div class="ieq-legend" aria-hidden="true">
    <span><i class="ieq-sw ieq-sw-i"></i>immigration I(S) = I₀(1 − S/100)</span>
    <span><i class="ieq-sw ieq-sw-e"></i>extinction E(S) = eS</span>
  </div>

  <div class="ieq-controls">
    <label class="ieq-slabel"><span>Immigration at S = 0, I₀ <em data-out="i0">10</em> species per day <small>(lower for a more distant island)</small></span>
      <input type="range" data-in="i0" min="2" max="20" step="1" value="10" />
    </label>
    <label class="ieq-slabel"><span>Extinction per species, e <em data-out="e">0.10</em> per day <small>(higher for a smaller island)</small></span>
      <input type="range" data-in="e" min="0.02" max="0.3" step="0.01" value="0.1" />
    </label>
    <div class="ieq-btnrow"><button type="button" class="ieq-btn" data-resample>Resample a random run</button></div>
  </div>

  <p class="ieq-ins-title">Inset: richness S filling from an empty island (day 0)</p>
  <svg class="ieq-svg ieq-ins" viewBox="0 0 340 170" role="img" aria-label="Richness S against days: the deterministic curve rising toward S star, with one random run beside it" data-inset></svg>
  <div class="ieq-legend" aria-hidden="true">
    <span><i class="ieq-sw ieq-sw-d"></i>S(t) = S*(1 − e<sup>−kt</sup>), k = I₀/100 + e</span>
    <span><i class="ieq-sw ieq-sw-r"></i>one random run</span>
  </div>

  <dl class="ieq-readout">
    <div><dt>Equilibrium S* (I = E)</dt><dd data-r-star></dd></div>
    <div><dt>Turnover at S*</dt><dd data-r-turn></dd></div>
    <div><dt>Richness reaches 90% of S*</dt><dd data-r-t90></dd></div>
    <div><dt>Net change at that richness</dt><dd data-r-net></dd></div>
  </dl>

  <table class="ieq-cmp">
    <caption data-cmp-cap>Expected (deterministic curve) beside simulated</caption>
    <thead><tr><th scope="col">Quantity</th><th scope="col">Expected</th><th scope="col">Simulated (this run)</th></tr></thead>
    <tbody>
      <tr><th scope="row" data-c-label-s></th><td data-c-es></td><td data-c-os></td></tr>
      <tr><th scope="row" data-c-label-i></th><td data-c-ei></td><td data-c-oi></td></tr>
      <tr><th scope="row" data-c-label-x></th><td data-c-ex></td><td data-c-ox></td></tr>
    </tbody>
  </table>

  <p class="ieq-why" data-why role="status"></p>

  <p class="ieq-assume"><strong>In this sketch:</strong> the curves assume continuous, deterministic change; the random run adds chance. Constant coefficients, no speciation, an empty island at day 0, pool P = 100 species; the numbers are invented teaching inputs, not estimates for any real island. In the random run each absent species arrives at the same rate I₀/100 per day and each resident goes extinct at rate e per day, independently.</p>
  <p class="ieq-foot">Rule to keep: richness settles where immigration equals extinction, and at that point species are still arriving and leaving at the turnover rate.</p>
</figure>

<script>
  const NS = 'http://www.w3.org/2000/svg';
  const TEAL = '#0e7c86', ORANGE = '#e57200', INK = '#4b4b55', FAINT = '#b9b9c2', VIOLET = '#6b4bb0';
  const POOL = 100;
  function el(name: string, attrs: Record<string, string | number>): SVGElement {
    const e = document.createElementNS(NS, name);
    for (const k in attrs) e.setAttribute(k, String(attrs[k]));
    return e;
  }
  function txt(parent: SVGElement, x: number, y: number, s: string, opts: Record<string, string | number> = {}) {
    const t = el('text', Object.assign({ x, y, 'font-size': 9, fill: INK }, opts));
    t.textContent = s;
    parent.appendChild(t);
    return t;
  }
  function rng(seed: number) {
    let a = seed >>> 0;
    return () => {
      a = (a + 0x6d2b79f5) >>> 0;
      let t = a;
      t = Math.imul(t ^ (t >>> 15), t | 1);
      t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }
  const f1 = (x: number) => x.toFixed(1);

  document.querySelectorAll<HTMLElement>('[data-ieq]').forEach((root) => {
    const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const plot = q<SVGSVGElement>('[data-plot]');
    const inset = q<SVGSVGElement>('[data-inset]');
    const i0In = q<HTMLInputElement>('[data-in="i0"]'), eIn = q<HTMLInputElement>('[data-in="e"]');
    const i0Out = q<HTMLElement>('[data-out="i0"]'), eOut = q<HTMLElement>('[data-out="e"]');
    const rStar = q<HTMLElement>('[data-r-star]'), rTurn = q<HTMLElement>('[data-r-turn]');
    const rT90 = q<HTMLElement>('[data-r-t90]'), rNet = q<HTMLElement>('[data-r-net]');
    const why = q<HTMLElement>('[data-why]');
    const cap = q<HTMLElement>('[data-cmp-cap]');
    const lS = q<HTMLElement>('[data-c-label-s]'), lI = q<HTMLElement>('[data-c-label-i]'), lX = q<HTMLElement>('[data-c-label-x]');
    const eS = q<HTMLElement>('[data-c-es]'), oS = q<HTMLElement>('[data-c-os]');
    const eI = q<HTMLElement>('[data-c-ei]'), oI = q<HTMLElement>('[data-c-oi]');
    const eX = q<HTMLElement>('[data-c-ex]'), oX = q<HTMLElement>('[data-c-ox]');
    const btn = q<HTMLButtonElement>('[data-resample]');

    let seed = 20240607;

    // Plot 1: rates against S
    const X0 = 40, X1 = 326, Y0 = 22, Y1 = 188;
    const px = (s: number) => X0 + (s / POOL) * (X1 - X0);

    // Inset: S against days
    const IX0 = 40, IX1 = 326, IY0 = 14, IY1 = 128;

    function render() {
      const I0 = parseInt(i0In.value, 10);
      const e = parseFloat(eIn.value);
      i0Out.textContent = String(I0);
      eOut.textContent = e.toFixed(2);

      const k = I0 / POOL + e;            // dS/dt = I0 - kS
      const star = I0 / k;                // equilibrium S*
      const turn = e * star;              // I(S*) = E(S*)
      const S = (t: number) => star * (1 - Math.exp(-k * t));
      const t90 = Math.log(10) / k;
      const s90 = 0.9 * star;
      const iAt90 = I0 * (1 - s90 / POOL), eAt90 = e * s90;
      const tmax = Math.ceil(5 / k / 5) * 5;

      // ---------- rate plot ----------
      const ymax = Math.max(10, Math.ceil(Math.max(I0, e * POOL) / 5) * 5);
      const py = (r: number) => Y1 - (r / ymax) * (Y1 - Y0);
      plot.replaceChildren();
      plot.appendChild(el('line', { x1: X0, y1: Y0, x2: X0, y2: Y1, stroke: INK, 'stroke-width': 1 }));
      plot.appendChild(el('line', { x1: X0, y1: Y1, x2: X1, y2: Y1, stroke: INK, 'stroke-width': 1 }));
      const yStep = ymax <= 10 ? 5 : ymax <= 20 ? 10 : 10;
      for (let r = yStep; r <= ymax; r += yStep) {
        plot.appendChild(el('line', { x1: X0, y1: py(r), x2: X1, y2: py(r), stroke: FAINT, 'stroke-width': 0.7, 'stroke-dasharray': '2 3' }));
      }
      for (let r = 0; r <= ymax; r += yStep) txt(plot, X0 - 4, py(r) + 3, String(r), { 'text-anchor': 'end' });
      for (const s of [0, 25, 50, 75, 100]) {
        plot.appendChild(el('line', { x1: px(s), y1: Y1, x2: px(s), y2: Y1 + 3, stroke: INK, 'stroke-width': 1 }));
        txt(plot, px(s), Y1 + 14, String(s), { 'text-anchor': 'middle' });
      }
      txt(plot, (X0 + X1) / 2, Y1 + 28, 'species richness S on the island (pool P = 100)', { 'text-anchor': 'middle', 'font-size': 10 });
      txt(plot, X0 - 2, Y0 - 8, 'rate (species per day)', { 'text-anchor': 'start', 'font-size': 10 });
      plot.appendChild(el('line', { x1: px(0), y1: py(I0), x2: px(POOL), y2: py(0), stroke: TEAL, 'stroke-width': 2.6 }));
      plot.appendChild(el('line', { x1: px(0), y1: py(0), x2: px(POOL), y2: py(e * POOL), stroke: ORANGE, 'stroke-width': 2.6 }));
      plot.appendChild(el('line', { x1: px(star), y1: py(turn), x2: px(star), y2: Y1, stroke: INK, 'stroke-width': 1.1, 'stroke-dasharray': '3 2' }));
      plot.appendChild(el('line', { x1: X0, y1: py(turn), x2: px(star), y2: py(turn), stroke: INK, 'stroke-width': 1.1, 'stroke-dasharray': '3 2' }));
      plot.appendChild(el('circle', { cx: px(star), cy: py(turn), r: 4.5, fill: '#222' }));
      // label beside the crossing, kept inside the viewBox
      const lblRight = star < 62;
      const lx = lblRight ? px(star) + 8 : px(star) - 8;
      const ly = Math.max(Y0 + 10, py(turn) - 10);
      txt(plot, lx, ly, `S* = ${f1(star)}`, { 'text-anchor': lblRight ? 'start' : 'end', 'font-weight': 700, fill: '#222', stroke: '#fff', 'stroke-width': 3, 'paint-order': 'stroke' });
      txt(plot, lx, ly + 11, `I = E = ${f1(turn)} per day`, { 'text-anchor': lblRight ? 'start' : 'end', fill: '#222', stroke: '#fff', 'stroke-width': 3, 'paint-order': 'stroke' });

      // ---------- random run (Gillespie, seeded) ----------
      const rand = rng(seed);
      const pts: Array<[number, number]> = [[0, 0]];
      let t = 0, n = 0;
      const ev: Array<[number, number]> = []; // [time, +1 immigration | -1 extinction]
      for (let guard = 0; guard < 200000; guard++) {
        const a = I0 * (1 - n / POOL), b = e * n;
        const r = a + b;
        if (r <= 0) break;
        t += -Math.log(1 - rand()) / r;
        if (t >= tmax) break;
        if (rand() * r < a) { n += 1; ev.push([t, 1]); } else { n -= 1; ev.push([t, -1]); }
        pts.push([t, n]);
      }
      const nEnd = n;

      // ---------- inset ----------
      const ix = (d: number) => IX0 + (d / tmax) * (IX1 - IX0);
      const iy = (s: number) => IY1 - (s / POOL) * (IY1 - IY0);
      inset.replaceChildren();
      inset.appendChild(el('line', { x1: IX0, y1: IY0, x2: IX0, y2: IY1, stroke: INK, 'stroke-width': 1 }));
      inset.appendChild(el('line', { x1: IX0, y1: IY1, x2: IX1, y2: IY1, stroke: INK, 'stroke-width': 1 }));
      for (const s of [0, 50, 100]) {
        txt(inset, IX0 - 4, iy(s) + 3, String(s), { 'text-anchor': 'end' });
        if (s > 0) inset.appendChild(el('line', { x1: IX0, y1: iy(s), x2: IX1, y2: iy(s), stroke: FAINT, 'stroke-width': 0.7, 'stroke-dasharray': '2 3' }));
      }
      for (const d of [0, tmax / 2, tmax]) {
        inset.appendChild(el('line', { x1: ix(d), y1: IY1, x2: ix(d), y2: IY1 + 3, stroke: INK, 'stroke-width': 1 }));
        txt(inset, ix(d), IY1 + 14, String(d), { 'text-anchor': d === 0 ? 'start' : d === tmax ? 'end' : 'middle' });
      }
      txt(inset, (IX0 + IX1) / 2, IY1 + 28, 'days since the island was empty', { 'text-anchor': 'middle', 'font-size': 10 });
      txt(inset, IX0 - 2, IY0 - 4, 'richness S', { 'text-anchor': 'start', 'font-size': 10 });
      // equilibrium line
      inset.appendChild(el('line', { x1: IX0, y1: iy(star), x2: IX1, y2: iy(star), stroke: INK, 'stroke-width': 1, 'stroke-dasharray': '4 3' }));
      // random run as a step path
      let d = `M${ix(0).toFixed(1)} ${iy(0).toFixed(1)}`;
      for (let j = 1; j < pts.length; j++) {
        d += ` L${ix(pts[j][0]).toFixed(1)} ${iy(pts[j - 1][1]).toFixed(1)} L${ix(pts[j][0]).toFixed(1)} ${iy(pts[j][1]).toFixed(1)}`;
      }
      d += ` L${ix(tmax).toFixed(1)} ${iy(nEnd).toFixed(1)}`;
      inset.appendChild(el('path', { d, fill: 'none', stroke: VIOLET, 'stroke-width': 1.4, 'stroke-linejoin': 'round' }));
      // deterministic curve
      let dd = '';
      for (let j = 0; j <= 120; j++) {
        const dt = (j / 120) * tmax;
        dd += (j === 0 ? 'M' : 'L') + ix(dt).toFixed(1) + ' ' + iy(S(dt)).toFixed(1) + ' ';
      }
      inset.appendChild(el('path', { d: dd.trim(), fill: 'none', stroke: TEAL, 'stroke-width': 2.6 }));
      // 90% marker
      if (t90 <= tmax) {
        inset.appendChild(el('line', { x1: ix(t90), y1: iy(s90), x2: ix(t90), y2: IY1, stroke: ORANGE, 'stroke-width': 1.1, 'stroke-dasharray': '3 2' }));
        inset.appendChild(el('circle', { cx: ix(t90), cy: iy(s90), r: 4, fill: ORANGE }));
        txt(inset, ix(t90) + 6, Math.min(IY1 - 6, iy(s90) + 14), `90% of S*: day ${f1(t90)}`, { 'font-weight': 700, fill: '#a04a00' });
      }
      txt(inset, IX1 - 2, Math.max(IY0 + 9, iy(star) - 4 > IY0 + 9 ? iy(star) + 12 : iy(star) + 12), 'S*', { 'text-anchor': 'end', 'font-weight': 700 });

      // ---------- readouts ----------
      rStar.textContent = `${f1(star)} species`;
      rTurn.textContent = `I = E = ${f1(turn)} per day (${f1(2 * turn)} events counting gains and losses separately)`;
      rT90.textContent = `${f1(s90)} species at ${f1(t90)} days`;
      const net = iAt90 - eAt90;
      rNet.textContent = `I = ${f1(iAt90)}, E = ${f1(eAt90)}: net ${net >= 0 ? '+' : '−'}${f1(Math.abs(net))} per day`;

      // expected beside observed, over the last 40% of the run
      const w0 = tmax * 0.6, w = tmax - w0;
      let expI = 0, expE = 0;
      const M = 400;
      for (let j = 0; j < M; j++) {
        const s = S(w0 + ((j + 0.5) / M) * w);
        expI += I0 * (1 - s / POOL);
        expE += e * s;
      }
      expI /= M; expE /= M;
      let obsI = 0, obsE = 0;
      for (const [tt, kind] of ev) if (tt >= w0) { if (kind > 0) obsI++; else obsE++; }
      obsI /= w; obsE /= w;
      cap.textContent = `Expected (deterministic curve) beside simulated (this random run, fixed until you press Resample; days ${f1(w0)} to ${tmax})`;
      lS.textContent = `Richness S on day ${tmax}`;
      eS.textContent = `${f1(S(tmax))} species`;
      oS.textContent = `${nEnd} species`;
      lI.textContent = 'Immigrations per day (last 40% of run)';
      eI.textContent = f1(expI);
      oI.textContent = f1(obsI);
      lX.textContent = 'Extinctions per day (last 40% of run)';
      eX.textContent = f1(expE);
      oX.textContent = f1(obsE);

      // ---------- status ----------
      const cmp3 = (v: number, d: number, lo: string, hi: string) => (v < d - 1e-9 ? lo : v > d + 1e-9 ? hi : 'unchanged');
      const iw = cmp3(I0, 10, 'lower', 'higher'), ew = cmp3(e, 0.1, 'lower', 'higher');
      const sw = star < 50 - 0.05 ? 'below' : star > 50 + 0.05 ? 'above' : 'at';
      let dir = ` Immigration is ${iw} and extinction is ${ew} than the default; S* is ${sw} the default of 50.`;
      if (I0 < 10 && e === 0.1) dir += ' A lower immigration curve is what the lesson describes for a more distant island.';
      else if (e > 0.1 && I0 === 10) dir += ' A higher extinction curve is what the lesson describes for a smaller island.';
      else if (I0 === 10 && e === 0.1) dir = ' These are the worked problem’s values: pool of 100, I = 10(1 − S/100), E = 0.1S.';
      why.textContent = `The curves cross at S* = ${f1(star)} species. There I = E = ${f1(turn)} species per day, so richness is steady while about ${f1(turn)} species are replaced each day (${f1(2 * turn)} events counting gains and losses separately).${dir} The random run is one of many possible; compare its scatter with the expected values in the table.`;
    }

    [i0In, eIn].forEach((s) => s.addEventListener('input', render));
    btn.addEventListener('click', () => { seed = (seed * 1664525 + 1013904223 + Math.floor(Math.random() * 1e9)) >>> 0; render(); });
    render();
  });
</script>

<style>
  .ieq { padding: var(--ddp-space-3) var(--ddp-space-4) var(--ddp-space-4); margin: var(--ddp-space-5) 0; }
  .ieq-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem; font-weight: 600; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); margin-bottom: var(--ddp-space-3); }
  .ieq-chip { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 400; color: var(--ddp-color-muted); }
  .ieq-svg { display: block; width: 100%; max-width: 560px; margin: 0 auto; height: auto; background: #fff; border: 1px solid var(--ddp-color-line); border-radius: 6px; }
  .ieq-legend { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.2rem 1rem; margin: var(--ddp-space-2) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .ieq-sw { display: inline-block; width: 16px; height: 0; border-top: 3px solid; margin-right: 0.35rem; vertical-align: middle; }
  .ieq-sw-i, .ieq-sw-d { border-color: #0e7c86; }
  .ieq-sw-e { border-color: #e57200; }
  .ieq-sw-r { border-color: #6b4bb0; border-top-width: 2px; }
  .ieq-controls { display: grid; grid-template-columns: 1fr 1fr; gap: var(--ddp-space-2) var(--ddp-space-4); margin: var(--ddp-space-3) 0 var(--ddp-space-2); }
  .ieq-slabel { display: flex; flex-direction: column; gap: 0.1rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .ieq-slabel small { font-size: inherit; color: var(--ddp-color-muted); }
  .ieq-slabel em { font-style: normal; font-weight: 700; color: var(--ddp-color-accent); font-family: var(--ddp-font-mono); }
  .ieq-slabel input { accent-color: var(--ddp-color-accent); }
  .ieq-btnrow { grid-column: 1 / -1; }
  .ieq-btn { font: inherit; font-size: var(--ddp-text-xs); padding: 0.35rem 0.8rem; border: 1px solid var(--ddp-color-accent); border-radius: 6px; background: transparent; color: var(--ddp-color-accent); cursor: pointer; }
  .ieq-btn:hover, .ieq-btn:focus-visible { background: color-mix(in srgb, var(--ddp-color-accent) 12%, transparent); }
  .ieq-ins-title { margin: var(--ddp-space-3) 0 var(--ddp-space-2); font-size: var(--ddp-text-xs); font-weight: 600; color: var(--ddp-color-ink-soft); }
  .ieq-readout { display: grid; grid-template-columns: 1fr 1fr; gap: var(--ddp-space-2); margin: var(--ddp-space-3) 0 var(--ddp-space-2); padding: var(--ddp-space-2) var(--ddp-space-3); background: color-mix(in srgb, var(--ddp-color-accent) 8%, transparent); border-radius: 6px; }
  .ieq-readout div { display: flex; flex-direction: column; gap: 0.1rem; min-width: 0; }
  .ieq-readout dt { font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .ieq-readout dd { margin: 0; font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); color: var(--ddp-color-primary); font-weight: 700; overflow-wrap: anywhere; }
  .ieq-cmp { width: 100%; border-collapse: collapse; margin: var(--ddp-space-2) 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .ieq-cmp caption { text-align: left; font-weight: 600; padding-bottom: 0.25rem; }
  .ieq-cmp th, .ieq-cmp td { text-align: left; padding: 0.2rem 0.4rem; border-bottom: 1px solid var(--ddp-color-line); vertical-align: top; }
  .ieq-cmp td { font-family: var(--ddp-font-mono); }
  .ieq-why { margin: var(--ddp-space-2) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); line-height: 1.5; min-height: 4.5em; }
  .ieq-assume { margin: var(--ddp-space-2) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); line-height: 1.5; }
  .ieq-foot { margin: var(--ddp-space-3) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); border-left: 3px solid var(--ddp-color-secondary); padding-left: 0.55rem; }
  @media (max-width: 520px) {
    .ieq-controls, .ieq-readout { grid-template-columns: 1fr; }
  }
</style>
