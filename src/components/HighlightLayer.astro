---
/**
 * HighlightLayer — highlights and notes on a lesson, kept in this browser.
 *
 * Select text in the lesson body and a small bar appears: three colours and
 * "Add note". On a phone the bar sits near the bottom of the screen, because the
 * phone's own copy/paste menu sits above the selection. Selecting with the
 * keyboard (Shift + arrows) shows the bar too; press Tab to reach it.
 *
 * A highlight is a <mark class="bp-hl bp-hl-yellow" data-hl="id"> around the text.
 * Clicking it (or Enter on it) opens a small box to change the colour, write a
 * note, or delete it. On each page load the marks are put back by searching for
 * the saved quote (src/lib/highlight-anchor.ts). A highlight whose passage is no
 * longer in the lesson is kept and listed under "Your notes" as changed.
 *
 * The "Your notes" panel renders where this component is placed (after the
 * lesson body): notes on the whole lesson, changed passages, and a link to the
 * notebook. Links like /lessons/<slug>/#hl-<id> scroll to a highlight and flash it.
 *
 * Storage: src/lib/notebook.ts (shared with account sync).
 */
interface Props { slug: string; title: string; }
const { slug, title } = Astro.props;
---

<section class="hl-notes" id="your-notes" aria-labelledby="hl-notes-h" data-hl-panel data-slug={slug} data-title={title} data-no-hl>
  <h2 id="hl-notes-h" class="hl-notes-h">Your notes</h2>
  <p class="hl-notes-help">
    Select any text in the lesson to highlight it or add a note to it.
    Your highlights and notes are saved in this browser and collected in <a href="/notebook/">your notebook</a>.
  </p>
  <p class="hl-notes-warn" data-hl-blocked hidden>
    This browser is not letting the site save anything (a private window or strict privacy settings),
    so highlights and notes will be lost when you leave the page.
  </p>
  <p class="hl-notes-count" data-hl-count hidden></p>
  <ul class="hl-notes-list" data-hl-list></ul>
  <div class="hl-notes-form" data-hl-form hidden>
    <label for="hl-page-note">Your note on this lesson</label>
    <textarea id="hl-page-note" rows="4" data-hl-form-text></textarea>
    <div class="hl-row">
      <button type="button" class="hl-btn hl-btn-main" data-hl-form-save>Save note</button>
      <button type="button" class="hl-btn" data-hl-form-cancel>Cancel</button>
    </div>
  </div>
  <div class="hl-row">
    <button type="button" class="hl-btn" data-hl-add-page-note>Add a note on this lesson</button>
    <a class="hl-link" href="/notebook/">Open your notebook →</a>
  </div>
</section>

<div class="hl-bar" role="toolbar" aria-label="Highlight the selected text" data-hl-bar hidden>
  <button type="button" class="hl-sw hl-sw-yellow" data-color="yellow" aria-label="Highlight yellow" title="Highlight yellow"></button>
  <button type="button" class="hl-sw hl-sw-green" data-color="green" aria-label="Highlight green" title="Highlight green"></button>
  <button type="button" class="hl-sw hl-sw-blue" data-color="blue" aria-label="Highlight blue" title="Highlight blue"></button>
  <button type="button" class="hl-bar-note" data-hl-bar-note>Add note</button>
</div>

<div class="hl-pop" role="dialog" aria-label="Your highlight" data-hl-pop hidden>
  <div class="hl-pop-top">
    <span class="hl-pop-k">Colour</span>
    <button type="button" class="hl-sw hl-sw-yellow" data-pop-color="yellow" aria-label="Yellow" aria-pressed="false"></button>
    <button type="button" class="hl-sw hl-sw-green" data-pop-color="green" aria-label="Green" aria-pressed="false"></button>
    <button type="button" class="hl-sw hl-sw-blue" data-pop-color="blue" aria-label="Blue" aria-pressed="false"></button>
    <button type="button" class="hl-pop-x" data-pop-close aria-label="Close">×</button>
  </div>
  <label class="hl-pop-k" for="hl-pop-note">Note</label>
  <textarea id="hl-pop-note" rows="3" placeholder="Write a note (optional)" data-pop-note></textarea>
  <p class="hl-pop-status" data-pop-status aria-live="polite"></p>
  <div class="hl-row">
    <button type="button" class="hl-btn hl-btn-main" data-pop-done>Done</button>
    <button type="button" class="hl-btn hl-btn-danger" data-pop-delete>Delete highlight</button>
  </div>
</div>

<p class="hl-sr" aria-live="polite" data-hl-live></p>

<style>
  .hl-notes {
    margin: var(--ddp-space-8, 2rem) 0 var(--ddp-space-6, 1.5rem);
    max-width: var(--ddp-maxw, 72ch);
    padding: var(--ddp-space-4, 1rem);
    border: 1px solid var(--ddp-color-line);
    border-radius: var(--ddp-radius-sm, 6px);
    background: var(--ddp-color-surface);
  }
  .hl-notes-h { margin: 0 0 0.25rem; font-size: var(--ddp-text-lg, 1.15rem); }
  .hl-notes-help, .hl-notes-count { margin: 0 0 0.75rem; color: var(--ddp-color-muted); font-size: var(--ddp-text-sm, 0.9rem); }
  .hl-notes-warn { margin: 0 0 0.75rem; color: var(--ddp-color-caution-ink); font-size: var(--ddp-text-sm, 0.9rem); }
  .hl-notes-list { list-style: none; margin: 0 0 0.75rem; padding: 0; display: grid; gap: 0.6rem; }
  .hl-notes-list:empty { display: none; }
  .hl-notes-form { display: grid; gap: 0.4rem; margin: 0 0 0.75rem; }
  .hl-notes-form label { font-weight: 600; font-size: var(--ddp-text-sm, 0.9rem); }
  :global(.hl-row) { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; }
  .hl-link { font-size: var(--ddp-text-sm, 0.9rem); margin-left: auto; }
</style>

<style is:global>
  /* The marks are created by the script, so these rules are global. */
  mark.bp-hl { color: inherit; border-radius: 2px; padding: 0.05em 0; cursor: pointer; box-decoration-break: clone; -webkit-box-decoration-break: clone; }
  mark.bp-hl-yellow { background: #fff09a; }
  mark.bp-hl-green { background: #c9efc2; }
  mark.bp-hl-blue { background: #cfe3ff; }
  mark.bp-hl[data-hl-last].bp-hl-has-note::after {
    content: '✎'; font-size: 0.7em; vertical-align: super; margin-left: 0.1em; color: var(--ddp-color-muted);
  }
  mark.bp-hl:focus-visible { outline: 2px solid var(--ddp-color-accent); outline-offset: 1px; }
  mark.bp-hl.bp-hl-flash { animation: bp-hl-flash 1.6s ease-out 2; }
  @keyframes bp-hl-flash { 0%, 100% { box-shadow: 0 0 0 0 transparent; } 30% { box-shadow: 0 0 0 4px var(--ddp-color-accent); } }
  @media (prefers-reduced-motion: reduce) {
    mark.bp-hl.bp-hl-flash { animation: none; outline: 3px solid var(--ddp-color-accent); outline-offset: 2px; }
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) mark.bp-hl-yellow { background: rgba(240, 205, 70, 0.38); }
    :root:not([data-theme="light"]) mark.bp-hl-green { background: rgba(110, 200, 110, 0.32); }
    :root:not([data-theme="light"]) mark.bp-hl-blue { background: rgba(100, 160, 255, 0.36); }
    /* Light "paper" cards keep the light colours. */
    :root:not([data-theme="light"]) .card mark.bp-hl-yellow { background: #fff09a; }
    :root:not([data-theme="light"]) .card mark.bp-hl-green { background: #c9efc2; }
    :root:not([data-theme="light"]) .card mark.bp-hl-blue { background: #cfe3ff; }
  }

  .hl-bar, .hl-pop {
    position: fixed; z-index: 1000;
    background: var(--ddp-color-surface); color: var(--ddp-color-ink);
    border: 1px solid var(--ddp-color-line); border-radius: 8px;
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.18);
    font-family: var(--ddp-font-sans, system-ui, sans-serif); font-size: 0.9rem;
  }
  .hl-bar[hidden], .hl-pop[hidden] { display: none; }
  .hl-bar { display: flex; align-items: center; gap: 0.35rem; padding: 0.35rem 0.45rem; }
  .hl-bar.hl-bottom {
    left: 50% !important; top: auto !important; transform: translateX(-50%);
    bottom: calc(5.5rem + env(safe-area-inset-bottom, 0px)); padding: 0.5rem 0.6rem; gap: 0.5rem;
  }
  .hl-sw {
    width: 28px; height: 28px; border-radius: 50%; padding: 0; cursor: pointer;
    border: 2px solid color-mix(in srgb, var(--ddp-color-ink) 25%, transparent);
  }
  .hl-bottom .hl-sw { width: 36px; height: 36px; }
  .hl-sw-yellow { background: #ffe55c; }
  .hl-sw-green { background: #8fdc83; }
  .hl-sw-blue { background: #8cbcff; }
  .hl-sw:focus-visible, .hl-bar-note:focus-visible, .hl-pop-x:focus-visible, .hl-btn:focus-visible {
    outline: 2px solid var(--ddp-color-accent); outline-offset: 2px;
  }
  .hl-sw[aria-pressed="true"] { box-shadow: 0 0 0 2px var(--ddp-color-surface), 0 0 0 4px var(--ddp-color-ink); }
  .hl-bar-note, .hl-btn {
    font: inherit; cursor: pointer; border-radius: 6px; padding: 0.3rem 0.65rem;
    border: 1px solid var(--ddp-color-line); background: var(--ddp-color-bg); color: var(--ddp-color-ink);
  }
  .hl-bar-note { white-space: nowrap; }
  .hl-bottom .hl-bar-note { padding: 0.5rem 0.8rem; }
  .hl-btn-main { background: var(--ddp-color-accent); border-color: var(--ddp-color-accent); color: #fff; }
  .hl-btn-danger { color: #b3261e; }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .hl-btn-main { color: #0f1522; }
    :root:not([data-theme="light"]) .hl-btn-danger { color: #ff8a80; }
  }

  .hl-pop { width: min(340px, calc(100vw - 32px)); padding: 0.6rem 0.75rem 0.75rem; display: grid; gap: 0.4rem; }
  .hl-pop.hl-bottom { left: 16px !important; right: 16px; top: auto !important; width: auto; bottom: calc(1rem + env(safe-area-inset-bottom, 0px)); }
  .hl-pop-top { display: flex; align-items: center; gap: 0.4rem; }
  .hl-pop-k { font-weight: 600; font-size: 0.8rem; color: var(--ddp-color-muted); margin-right: 0.15rem; }
  .hl-pop-x { margin-left: auto; font-size: 1.3rem; line-height: 1; border: 0; background: none; color: var(--ddp-color-muted); cursor: pointer; padding: 0.1rem 0.35rem; }
  .hl-pop textarea, .hl-notes textarea {
    width: 100%; box-sizing: border-box; font: inherit; font-size: 0.95rem; padding: 0.45rem;
    border: 1px solid var(--ddp-color-line); border-radius: 6px;
    background: var(--ddp-color-bg); color: var(--ddp-color-ink); resize: vertical;
  }
  .hl-pop-status { margin: 0; min-height: 1em; font-size: 0.78rem; color: var(--ddp-color-muted); }
  .hl-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  .hl-note-item { border-left: 4px solid var(--ddp-color-line); padding: 0.3rem 0 0.3rem 0.7rem; }
  .hl-note-item.hl-note-changed { border-left-color: var(--ddp-color-caution); }
  .hl-note-item p { margin: 0 0 0.3rem; white-space: pre-wrap; }
  .hl-note-item .hl-note-meta { font-size: 0.8rem; color: var(--ddp-color-muted); }
  .hl-note-item blockquote { margin: 0 0 0.3rem; font-style: italic; }
  .hl-note-item.bp-hl-flash { animation: bp-hl-flash 1.6s ease-out 2; }
</style>

<script>
  import { loadNotebook, upsertItem, deleteItem, storageWorks, NOTEBOOK_EVENT, NOTEBOOK_KEY, type HighlightColor, type NotebookItem } from '../lib/notebook';
  import { buildIndex, rangeToOffsets, describe, locate, wrap, unwrap, excluded } from '../lib/highlight-anchor';

  /** Ids this page could not place, kept so the notebook page can say "this passage changed". */
  const MISSING_KEY = 'biochempedia:notebook-missing:v1';

  const panel = document.querySelector<HTMLElement>('[data-hl-panel]');
  const root = document.querySelector<HTMLElement>('.prose-col[data-lesson-title]');
  if (panel && root) init(panel, root);

  function init(panel: HTMLElement, root: HTMLElement) {
    const slug = panel.dataset.slug!;
    const title = panel.dataset.title!;
    const bar = document.querySelector<HTMLElement>('[data-hl-bar]')!;
    const pop = document.querySelector<HTMLElement>('[data-hl-pop]')!;
    const popNote = pop.querySelector<HTMLTextAreaElement>('[data-pop-note]')!;
    const popStatus = pop.querySelector<HTMLElement>('[data-pop-status]')!;
    const live = document.querySelector<HTMLElement>('[data-hl-live]')!;
    const list = panel.querySelector<HTMLElement>('[data-hl-list]')!;
    const count = panel.querySelector<HTMLElement>('[data-hl-count]')!;
    const form = panel.querySelector<HTMLElement>('[data-hl-form]')!;
    const formText = panel.querySelector<HTMLTextAreaElement>('[data-hl-form-text]')!;
    const addPageNote = panel.querySelector<HTMLButtonElement>('[data-hl-add-page-note]')!;
    // Bars and popovers live at the end of <body>, outside any transformed parent.
    document.body.append(bar, pop);
    if (!storageWorks()) panel.querySelector<HTMLElement>('[data-hl-blocked]')!.hidden = false;

    let missing = new Set<string>();
    let muted = false;               // our own saves: do not re-render on our own event
    const save = <T,>(fn: () => T): T => { muted = true; try { return fn(); } finally { muted = false; } };

    const phoneLayout = () => window.matchMedia('(pointer: coarse)').matches || window.innerWidth < 700;

    /* ---------- rendering ---------- */

    function makeMark(it: NotebookItem) {
      return () => {
        const m = document.createElement('mark');
        m.className = `bp-hl bp-hl-${it.color}${it.note ? ' bp-hl-has-note' : ''}`;
        m.dataset.hl = it.id;
        if (it.note) m.title = it.note.length > 140 ? it.note.slice(0, 140) + '…' : it.note;
        return m;
      };
    }

    function decorate(marks: HTMLElement[], it: NotebookItem) {
      if (!marks.length) return;
      marks[0].id = `hl-${it.id}`;
      marks[0].tabIndex = 0;
      marks[0].setAttribute('aria-label', `Highlighted: ${it.quote.slice(0, 80)}${it.note ? '. Has a note' : ''}. Press Enter to edit.`);
      marks.forEach((m) => m.removeAttribute('data-hl-last'));
      marks[marks.length - 1].setAttribute('data-hl-last', '');
    }

    function place(it: NotebookItem): boolean {
      const idx = buildIndex(root);
      const at = locate(idx, it.quote, it.prefix, it.suffix);
      if (!at) return false;
      const marks = wrap(idx, at[0], at[1], makeMark(it));
      decorate(marks, it);
      return marks.length > 0;
    }

    function lessonItems() {
      return Object.values(loadNotebook().items)
        .filter((i) => i.slug === slug && !i.deleted)
        .sort((a, b) => a.created - b.created);
    }

    function renderAll() {
      unwrap(root);
      missing = new Set();
      const items = lessonItems();
      for (const it of items) if (it.kind === 'highlight' && !place(it)) missing.add(it.id);
      rememberMissing(items);
      renderPanel(items);
    }

    function rememberMissing(items: NotebookItem[]) {
      try {
        const raw = window.localStorage.getItem(MISSING_KEY);
        const m: Record<string, string> = raw ? JSON.parse(raw) : {};
        for (const it of items) if (it.kind === 'highlight') delete m[it.id];
        missing.forEach((id) => { m[id] = slug; });
        window.localStorage.setItem(MISSING_KEY, JSON.stringify(m));
      } catch { /* storage blocked */ }
    }

    function renderPanel(items: NotebookItem[]) {
      list.replaceChildren();
      const highlights = items.filter((i) => i.kind === 'highlight');
      const placed = highlights.length - missing.size;
      count.hidden = highlights.length === 0;
      count.textContent = placed === 1 ? 'You have 1 highlight in this lesson.' : `You have ${placed} highlights in this lesson.`;
      for (const it of items) {
        if (it.kind === 'note') list.append(noteRow(it));
        else if (missing.has(it.id)) list.append(changedRow(it));
      }
    }

    function meta(text: string) {
      const p = document.createElement('p');
      p.className = 'hl-note-meta';
      p.textContent = text;
      return p;
    }
    const day = (t: number) => new Date(t).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' });

    function noteRow(it: NotebookItem) {
      const li = document.createElement('li');
      li.className = 'hl-note-item';
      li.id = `hl-${it.id}`;
      const p = document.createElement('p');
      p.textContent = it.note;
      const row = document.createElement('div');
      row.className = 'hl-row';
      const edit = button('Edit', () => openForm(it));
      const del = button('Delete', () => { save(() => deleteItem(it.id)); renderPanel(lessonItems()); say('Note deleted.'); addPageNote.focus(); });
      row.append(edit, del);
      li.append(meta(`Note on this lesson · ${day(it.updated)}`), p, row);
      return li;
    }

    function changedRow(it: NotebookItem) {
      const li = document.createElement('li');
      li.className = 'hl-note-item hl-note-changed';
      li.id = `hl-${it.id}`;
      const q = document.createElement('blockquote');
      q.textContent = it.quote;
      li.append(meta('This passage changed, so this highlight could not be placed in the text.'), q);
      if (it.note) { const p = document.createElement('p'); p.textContent = it.note; li.append(p); }
      const row = document.createElement('div');
      row.className = 'hl-row';
      row.append(button('Delete', () => { save(() => deleteItem(it.id)); renderAll(); say('Highlight deleted.'); }));
      li.append(row);
      return li;
    }

    function button(label: string, onClick: () => void) {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'hl-btn';
      b.textContent = label;
      b.addEventListener('click', onClick);
      return b;
    }

    function say(text: string) { live.textContent = ''; window.setTimeout(() => { live.textContent = text; }, 30); }

    /* ---------- page notes ---------- */

    let editingNote: string | null = null;
    function openForm(it?: NotebookItem) {
      editingNote = it?.id ?? null;
      formText.value = it?.note ?? '';
      form.hidden = false;
      addPageNote.hidden = true;
      formText.focus();
    }
    function closeForm() { form.hidden = true; addPageNote.hidden = false; editingNote = null; }
    addPageNote.addEventListener('click', () => openForm());
    panel.querySelector('[data-hl-form-cancel]')!.addEventListener('click', () => { closeForm(); addPageNote.focus(); });
    panel.querySelector('[data-hl-form-save]')!.addEventListener('click', () => {
      const text = formText.value.trim();
      if (!text) { formText.focus(); return; }
      save(() => upsertItem({
        ...(editingNote ? { id: editingNote } : {}),
        kind: 'note', slug, title, section: '', anchorId: '', quote: '', prefix: '', suffix: '', color: 'yellow', note: text,
      }));
      closeForm();
      renderPanel(lessonItems());
      say('Note saved.');
      addPageNote.focus();
    });
    form.addEventListener('keydown', (e) => { if (e.key === 'Escape') { closeForm(); addPageNote.focus(); } });

    /* ---------- the selection bar ---------- */

    let pending: Range | null = null;
    let mouseDown = false;
    let timer = 0;

    function validRange(): Range | null {
      const sel = document.getSelection();
      if (!sel || sel.rangeCount === 0 || sel.isCollapsed) return null;
      const active = document.activeElement;
      if (active && /^(INPUT|TEXTAREA|SELECT)$/.test(active.tagName)) return null;
      const r = sel.getRangeAt(0);
      if (!root.contains(r.commonAncestorContainer)) return null;
      if (excluded(r.startContainer, root) && excluded(r.endContainer, root)) return null;
      if (!r.toString().trim()) return null;
      return r;
    }

    function showBar() {
      const r = validRange();
      if (!r) { if (!bar.contains(document.activeElement)) hideBar(); return; }
      pending = r.cloneRange();
      hidePop();
      bar.hidden = false;
      positionBar();
    }

    function positionBar() {
      if (bar.hidden || !pending) return;
      if (phoneLayout()) { bar.classList.add('hl-bottom'); bar.style.left = bar.style.top = ''; return; }
      bar.classList.remove('hl-bottom');
      const rects = pending.getClientRects();
      const first = rects[0] ?? pending.getBoundingClientRect();
      const bw = bar.offsetWidth, bh = bar.offsetHeight;
      let top = first.top - bh - 8;
      if (top < 8) {
        const last = rects[rects.length - 1] ?? first;
        top = last.bottom + 8;
      }
      const left = Math.min(Math.max(8, first.left + first.width / 2 - bw / 2), window.innerWidth - bw - 8);
      bar.style.left = `${left}px`;
      bar.style.top = `${Math.min(top, window.innerHeight - bh - 8)}px`;
    }

    function hideBar() { bar.hidden = true; pending = null; }

    function schedule(ms: number) {
      window.clearTimeout(timer);
      timer = window.setTimeout(() => { if (!mouseDown) showBar(); }, ms);
    }

    document.addEventListener('selectionchange', () => schedule(phoneLayout() ? 350 : 250));
    document.addEventListener('mousedown', (e) => { if (!bar.contains(e.target as Node)) mouseDown = true; });
    document.addEventListener('mouseup', () => { mouseDown = false; schedule(10); });
    document.addEventListener('keyup', (e) => { if (e.shiftKey || e.key === 'Shift') schedule(10); });
    window.addEventListener('scroll', () => window.requestAnimationFrame(() => {
      positionBar();
      if (!pop.hidden && popFor) positionPop(popFor);
    }), { passive: true });
    window.addEventListener('resize', () => { positionBar(); if (!pop.hidden && popFor) positionPop(popFor); });

    // Keep the selection when a bar button is pressed.
    bar.addEventListener('mousedown', (e) => e.preventDefault());
    bar.addEventListener('pointerdown', (e) => { if (e.pointerType === 'mouse') e.preventDefault(); });

    // Keyboard: Tab from a fresh selection moves into the bar; Escape closes it.
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        if (!pop.hidden) { closePop(true); e.preventDefault(); return; }
        if (!bar.hidden) { hideBar(); document.getSelection()?.removeAllRanges(); e.preventDefault(); }
        return;
      }
      if (e.key === 'Tab' && !e.shiftKey && !bar.hidden && !bar.contains(document.activeElement)) {
        e.preventDefault();
        bar.querySelector<HTMLButtonElement>('button')!.focus();
      }
    });
    bar.addEventListener('keydown', (e) => {
      const btns = Array.from(bar.querySelectorAll<HTMLButtonElement>('button'));
      const i = btns.indexOf(document.activeElement as HTMLButtonElement);
      if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
        e.preventDefault();
        btns[(i + (e.key === 'ArrowRight' ? 1 : btns.length - 1)) % btns.length].focus();
      }
    });

    function createFromPending(color: HighlightColor, withNote: boolean) {
      const range = pending;
      if (!range) return;
      snapToWords(range);
      const idx = buildIndex(root);
      const at = rangeToOffsets(idx, range);
      hideBar();
      document.getSelection()?.removeAllRanges();
      if (!at) return;
      const { quote, prefix, suffix } = describe(idx, at[0], at[1]);
      const h2 = sectionOf(range.startContainer);
      const it = save(() => upsertItem({
        kind: 'highlight', slug, title,
        section: h2 ? headingText(h2) : '', anchorId: h2?.id ?? '',
        quote: quote.slice(0, 4000), prefix, suffix, color, note: '',
      }));
      const marks = wrap(idx, at[0], at[1], makeMark(it));
      decorate(marks, it);
      renderPanel(lessonItems());
      say(withNote ? 'Highlighted. Write your note.' : `Highlighted ${color}.`);
      if (withNote && marks[0]) openPop(it.id, marks[0], true);
      else marks[0]?.focus({ preventScroll: true });
    }

    /** Grow a selection that stops mid-word to the whole word (within the same text node). */
    function snapToWords(r: Range) {
      const W = /[\p{L}\p{N}'’-]/u;
      if (r.startContainer.nodeType === 3) {
        const d = (r.startContainer as Text).data;
        let i = r.startOffset;
        while (i > 0 && W.test(d[i - 1]) && W.test(d[i] ?? '')) i--;
        r.setStart(r.startContainer, i);
      }
      if (r.endContainer.nodeType === 3) {
        const d = (r.endContainer as Text).data;
        let i = r.endOffset;
        while (i < d.length && W.test(d[i]) && i > 0 && W.test(d[i - 1])) i++;
        r.setEnd(r.endContainer, i);
      }
    }

    bar.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest('button');
      if (!b) return;
      if (b.hasAttribute('data-hl-bar-note')) createFromPending('yellow', true);
      else createFromPending(b.dataset.color as HighlightColor, false);
    });

    function sectionOf(node: Node): HTMLHeadingElement | null {
      let found: HTMLHeadingElement | null = null;
      for (const h of Array.from(root.querySelectorAll<HTMLHeadingElement>('h2'))) {
        if (h.compareDocumentPosition(node) & Node.DOCUMENT_POSITION_FOLLOWING || h.contains(node)) found = h;
        else break;
      }
      return found;
    }
    function headingText(h: HTMLElement) {
      const c = h.cloneNode(true) as HTMLElement;
      c.querySelectorAll('button, [aria-hidden="true"], .sr-only').forEach((x) => x.remove());
      return (c.textContent ?? '').replace(/\s+/g, ' ').trim();
    }

    /* ---------- the popover for an existing highlight ---------- */

    let popFor: string | null = null;
    let returnFocus: HTMLElement | null = null;
    let noteTimer = 0;

    function marksOf(id: string) {
      return Array.from(root.querySelectorAll<HTMLElement>(`mark.bp-hl[data-hl="${CSS.escape(id)}"]`));
    }

    function openPop(id: string, from: HTMLElement, focusNote = false) {
      const it = loadNotebook().items[id];
      if (!it || it.deleted) return;
      hideBar();
      popFor = id;
      returnFocus = marksOf(id)[0] ?? from;
      popNote.value = it.note;
      popStatus.textContent = '';
      setPressed(it.color);
      pop.hidden = false;
      positionPop(id);
      (focusNote ? popNote : pop.querySelector<HTMLButtonElement>(`[data-pop-color="${it.color}"]`)!).focus({ preventScroll: true });
    }

    function positionPop(id: string) {
      if (phoneLayout()) { pop.classList.add('hl-bottom'); pop.style.left = pop.style.top = ''; return; }
      pop.classList.remove('hl-bottom');
      const ms = marksOf(id);
      if (!ms.length) return;
      const last = ms[ms.length - 1].getBoundingClientRect();
      const pw = pop.offsetWidth, ph = pop.offsetHeight;
      let top = last.bottom + 8;
      if (top + ph > window.innerHeight - 8) top = Math.max(8, ms[0].getBoundingClientRect().top - ph - 8);
      top = Math.min(Math.max(8, top), window.innerHeight - ph - 8);
      const left = Math.min(Math.max(8, last.left), window.innerWidth - pw - 8);
      pop.style.left = `${left}px`;
      pop.style.top = `${top}px`;
    }

    function setPressed(color: string) {
      pop.querySelectorAll<HTMLButtonElement>('[data-pop-color]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.popColor === color)));
    }

    function hidePop() { pop.hidden = true; popFor = null; }

    function closePop(restore: boolean) {
      if (pop.hidden) return;
      flushNote();
      hidePop();
      if (restore && returnFocus?.isConnected) returnFocus.focus({ preventScroll: true });
    }

    function update(patch: Partial<NotebookItem>) {
      if (!popFor) return null;
      const it = loadNotebook().items[popFor];
      if (!it) return null;
      const next = save(() => upsertItem({ ...it, ...patch }));
      const ms = marksOf(next.id);
      for (const m of ms) {
        m.className = `bp-hl bp-hl-${next.color}${next.note ? ' bp-hl-has-note' : ''}`;
        if (next.note) m.title = next.note.length > 140 ? next.note.slice(0, 140) + '…' : next.note;
        else m.removeAttribute('title');
      }
      decorate(ms, next);
      return next;
    }

    function flushNote() {
      window.clearTimeout(noteTimer);
      if (!popFor) return;
      const it = loadNotebook().items[popFor];
      if (it && it.note !== popNote.value) update({ note: popNote.value });
    }

    popNote.addEventListener('input', () => {
      window.clearTimeout(noteTimer);
      popStatus.textContent = '';
      noteTimer = window.setTimeout(() => { flushNote(); popStatus.textContent = 'Saved in this browser.'; }, 500);
    });
    popNote.addEventListener('keydown', (e) => { if (e.key === 'Enter' && (e.metaKey || e.ctrlKey)) { e.preventDefault(); closePop(true); } });
    pop.querySelectorAll<HTMLButtonElement>('[data-pop-color]').forEach((b) => b.addEventListener('click', () => {
      const color = b.dataset.popColor as HighlightColor;
      update({ color });
      setPressed(color);
      say(`Colour changed to ${color}.`);
    }));
    pop.querySelector('[data-pop-close]')!.addEventListener('click', () => closePop(true));
    pop.querySelector('[data-pop-done]')!.addEventListener('click', () => closePop(true));
    pop.querySelector('[data-pop-delete]')!.addEventListener('click', () => {
      if (!popFor) return;
      const id = popFor;
      window.clearTimeout(noteTimer);
      save(() => deleteItem(id));
      hidePop();
      unwrap(root, id);
      renderPanel(lessonItems());
      say('Highlight deleted.');
    });

    root.addEventListener('click', (e) => {
      const m = (e.target as HTMLElement).closest<HTMLElement>('mark.bp-hl');
      if (!m) return;
      const sel = document.getSelection();
      if (sel && !sel.isCollapsed) return;           // the reader is selecting, not tapping
      openPop(m.dataset.hl!, m);
    });
    root.addEventListener('keydown', (e) => {
      const m = (e.target as HTMLElement).closest?.<HTMLElement>('mark.bp-hl');
      if (m && (e.key === 'Enter' || e.key === ' ')) { e.preventDefault(); openPop(m.dataset.hl!, m); }
    });
    document.addEventListener('mousedown', (e) => {
      const t = e.target as Node;
      if (!pop.hidden && !pop.contains(t) && !(t instanceof Element && t.closest('mark.bp-hl'))) closePop(false);
    });
    document.addEventListener('touchstart', (e) => {
      const t = e.target as Node;
      if (!pop.hidden && !pop.contains(t) && !(t instanceof Element && t.closest('mark.bp-hl'))) closePop(false);
    }, { passive: true });

    /* ---------- links to a highlight ---------- */

    function goToHash(smooth = true) {
      const m = /^#hl-(h_[a-z0-9]+)$/.exec(window.location.hash);
      if (!m) return;
      const el = document.getElementById(`hl-${m[1]}`) as HTMLElement | null;
      if (!el) return;
      for (let d = el.closest('details'); d; d = d.parentElement?.closest('details') ?? null) d.open = true;
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      el.scrollIntoView({ block: 'center', behavior: reduce || !smooth ? 'instant' : 'smooth' });
      // Images and players above can still change size after load, pushing the passage
      // out of view. Check a few times, unless the reader has started scrolling.
      if (!smooth) {
        let touched = false;
        const stop = () => { touched = true; };
        ['wheel', 'touchstart', 'keydown', 'mousedown'].forEach((t) => window.addEventListener(t, stop, { once: true, passive: true }));
        [400, 1000, 2000].forEach((ms) => window.setTimeout(() => {
          const r = el.getBoundingClientRect();
          if (!touched && (r.top < 80 || r.bottom > window.innerHeight - 20)) el.scrollIntoView({ block: 'center', behavior: 'instant' });
        }, ms));
      }
      const targets = el.matches('mark') ? marksOf(m[1]) : [el];
      targets.forEach((t) => { t.classList.remove('bp-hl-flash'); void t.offsetWidth; t.classList.add('bp-hl-flash'); });
      window.setTimeout(() => targets.forEach((t) => t.classList.remove('bp-hl-flash')), 3400);
    }

    /* ---------- start ---------- */

    renderAll();
    // Give late layout (images, fonts) a moment so the scroll lands on the right line.
    if (window.location.hash.startsWith('#hl-')) window.setTimeout(() => goToHash(false), 150);
    window.addEventListener('hashchange', () => goToHash(true));
    window.addEventListener(NOTEBOOK_EVENT, () => { if (!muted && pop.hidden) renderAll(); });
    window.addEventListener('storage', (e) => { if (e.key === NOTEBOOK_KEY && pop.hidden) renderAll(); });
  }
</script>
