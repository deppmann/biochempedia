---
/**
 * PreferenceLostReader — the lesson's worked problem "sugar versus sweetener" as a sketch.
 * A two-bottle choice (sucrose versus sucralose) in mice is scored against 50 percent chance.
 * advantage = preference - 50; fraction lost = (C - M) / (C - 50).
 * Original. Self-contained vanilla-TS Astro island.
 */
---

<figure class="plr card" data-plr>
  <figcaption class="plr-head">Preference lost — reading a two-bottle choice against chance<span class="plr-chip">⚙ original · interactive</span></figcaption>

  <svg class="plr-svg" viewBox="0 0 340 262" role="img" aria-label="Horizontal bars of the sucrose preference advantage, drawn from a 50 percent chance line, for a control group and a manipulated group, and below them the fraction of the control advantage that was lost." data-plot></svg>

  <div class="plr-cases" role="group" aria-label="Group from the lesson">
    <button type="button" class="plr-btn" data-case="ctrl" aria-pressed="false">Light, controls (N = 5)</button>
    <button type="button" class="plr-btn" data-case="sil" aria-pressed="true">Neuropod cells silenced (N = 8)</button>
    <button type="button" class="plr-btn" data-case="glu" aria-pressed="false">Duodenal glutamate receptors blocked (N = 4)</button>
  </div>

  <div class="plr-controls">
    <label class="plr-slabel"><span>Control preference, C <em data-out="c">90.8</em> % sucrose</span>
      <input type="range" data-in="c" min="50" max="100" step="0.1" value="90.8" />
    </label>
    <label class="plr-slabel"><span>Manipulated preference, M <em data-out="m">58.9</em> % sucrose</span>
      <input type="range" data-in="m" min="30" max="100" step="0.1" value="58.9" />
    </label>
  </div>

  <dl class="plr-readout">
    <div><dt>Control advantage, C − 50</dt><dd data-r-ac></dd></div>
    <div><dt>Manipulated advantage, M − 50</dt><dd data-r-am></dd></div>
    <div><dt>Points lost, C − M</dt><dd data-r-lost></dd></div>
    <div><dt>Fraction lost, (C − M) / (C − 50)</dt><dd data-r-frac></dd></div>
  </dl>
  <p class="plr-why" data-why role="status"></p>

  <p class="plr-assume">In this sketch: mice, a one-hour choice between 300 mM sucrose and 15 mM sucralose, preference scored as sucrose’s share of total intake, with 50 percent as chance, and the lesson’s rule applied to whatever values are set. Any value other than the lesson’s is labelled as set in this sketch.</p>
  <p class="plr-foot">Rule to keep: measure preference as the advantage over 50 percent chance, then divide the points lost by the control advantage, not by the raw preference; and compare each group only with its own matching control. Small groups (N of 4 to 8) leave wide uncertainty.</p>
</figure>

<script>
  const NS = 'http://www.w3.org/2000/svg';
  const ACCENT = '#0e7c86', ORANGE = '#e57200', INK = '#4b4b55', FAINT = '#b9b9c2';
  function el(name: string, attrs: Record<string, string | number>): SVGElement {
    const e = document.createElementNS(NS, name);
    for (const k in attrs) e.setAttribute(k, String(attrs[k]));
    return e;
  }
  function txt(x: number, y: number, s: string, anchor: string, extra: Record<string, string | number> = {}): SVGElement {
    const t = el('text', { x, y, 'text-anchor': anchor, 'font-size': 9, fill: INK, ...extra });
    t.textContent = s;
    return t;
  }
  const nz = (t: string) => (/^-0(\.0+)?$/.test(t) ? t.slice(1) : t);
  const f1 = (v: number) => nz(v.toFixed(1));
  const f2 = (v: number) => nz(v.toFixed(2));
  const pct = (v: number) => String(Math.round(v * 100) + 0);
  const sg = (v: number) => (v < 0 ? '−' : v > 0 ? '+' : '') + Math.abs(v).toFixed(1);

  type Case = { c: number; m: number; n: number; name: string };
  const CASES: Record<string, Case> = {
    ctrl: { c: 90.8, m: 90.8, n: 5, name: 'light, controls' },
    sil: { c: 90.8, m: 58.9, n: 8, name: 'neuropod cells silenced' },
    glu: { c: 82.4, m: 44.0, n: 4, name: 'duodenal glutamate receptors blocked' },
  };

  document.querySelectorAll<HTMLElement>('[data-plr]').forEach((root) => {
    const plot = root.querySelector<SVGSVGElement>('[data-plot]')!;
    const q = (s: string) => root.querySelector<HTMLInputElement>(s)!;
    const o = (s: string) => root.querySelector<HTMLElement>(s)!;
    const cIn = q('[data-in="c"]'), mIn = q('[data-in="m"]');
    const cOut = o('[data-out="c"]'), mOut = o('[data-out="m"]');
    const rAc = o('[data-r-ac]'), rAm = o('[data-r-am]'), rLost = o('[data-r-lost]'), rFrac = o('[data-r-frac]');
    const why = o('[data-why]');
    const btns = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-case]'));
    let cur = 'sil';

    // bar axis: 30..100 percent sucrose
    const X0 = 24, X1 = 322;
    const sx = (p: number) => X0 + ((p - 30) / 70) * (X1 - X0);
    const CH = sx(50);

    function bar(y: number, label: string, v: number, color: string) {
      plot.appendChild(txt(12, y - 6, label, 'start', { 'font-size': 10, 'font-weight': 700, fill: color }));
      const a = Math.min(sx(v), CH), b = Math.max(sx(v), CH);
      if (b - a > 0.2) plot.appendChild(el('rect', { x: a, y, width: b - a, height: 18, fill: v < 50 ? ORANGE : color, 'fill-opacity': 0.85 }));
    }

    function render() {
      const C = parseFloat(cIn.value), M = parseFloat(mIn.value);
      cOut.textContent = f1(C); mOut.textContent = f1(M);
      const cs = CASES[cur];
      const aC = C - 50, aM = M - 50, lost = C - M;
      const isGlu = cur === 'glu';
      const defined = C > 50;
      const frac = defined ? lost / aC : NaN;
      const showFrac = defined && !isGlu;

      plot.replaceChildren();
      plot.appendChild(txt(12, 14, 'Sucrose preference advantage over 50 percent chance (points)', 'start', { 'font-size': 10 }));

      // axis
      for (const p of [30, 40, 50, 60, 70, 80, 90, 100]) {
        plot.appendChild(el('line', { x1: sx(p), y1: 24, x2: sx(p), y2: 160, stroke: p === 50 ? INK : FAINT, 'stroke-width': p === 50 ? 1.4 : 0.6, 'stroke-dasharray': p === 50 ? '' : '2 3' }));
        plot.appendChild(txt(sx(p), 172, String(p), 'middle'));
      }
      plot.appendChild(txt((X0 + X1) / 2, 184, '% of choices for sucrose', 'middle'));
      plot.appendChild(txt(CH + 3, 24 + 8, 'chance', 'start', { fill: INK, 'font-weight': 700 }));

      bar(52, `Control, C = ${f1(C)} (${sg(aC)} points)`, C, ACCENT);
      bar(100, `Manipulated, M = ${f1(M)} (${sg(aM)} points)`, M, ACCENT);
      if (M < 50) plot.appendChild(txt(Math.min(CH + 4, 250), 128, 'below chance, not indifference', 'start', { fill: ORANGE, 'font-weight': 700 }));

      // fraction lost
      plot.appendChild(txt(12, 204, isGlu ? 'Fraction lost: not computed for this group' : defined ? `Fraction of control advantage lost = ${f2(frac)}` : 'Fraction lost: undefined (C is 50 or below)', 'start', { 'font-size': 10, 'font-weight': 700, fill: ORANGE }));
      plot.appendChild(el('rect', { x: X0, y: 212, width: X1 - X0, height: 16, fill: '#fff', stroke: INK, 'stroke-width': 1 }));
      if (showFrac) {
        const w = Math.max(0, Math.min(1, frac)) * (X1 - X0);
        if (w > 0) plot.appendChild(el('rect', { x: X0, y: 212, width: w, height: 16, fill: ORANGE, 'fill-opacity': 0.85 }));
      }
      plot.appendChild(txt(X0, 241, '0', 'middle'));
      plot.appendChild(txt((X0 + X1) / 2, 241, '0.5', 'middle'));
      plot.appendChild(txt(X1, 241, '1', 'middle'));
      if (showFrac && (frac > 1 || frac < 0)) plot.appendChild(txt((X0 + X1) / 2, 255, 'beyond the 0 to 1 bar', 'middle', { fill: ORANGE, 'font-weight': 700 }));

      // readouts
      rAc.textContent = `${f1(C)} − 50 = ${f1(aC)} points`;
      rAm.textContent = `${f1(M)} − 50 = ${f1(aM)} points`;
      rLost.textContent = isGlu ? 'not computed' : `${f1(C)} − ${f1(M)} = ${f1(lost)} points`;
      rFrac.textContent = isGlu ? 'not computed' : defined ? `${f1(lost)} / ${f1(aC)} = ${f2(frac)} (about ${pct(frac)} percent)` : 'undefined';

      // status
      const same = (a: number, b: number) => Math.abs(a - b) < 0.05;
      const lessonVals = same(C, cs.c) && same(M, cs.m);
      const parts: string[] = [];
      if (cur === 'ctrl') {
        parts.push(lessonVals
          ? `The lesson’s group “${cs.name}” (N = ${cs.n}, mice): C = ${f1(cs.c)} percent sucrose. M is set equal to C as a sketch convention; the lesson gives no manipulated group here.`
          : `In this sketch C = ${f1(C)} and M = ${f1(M)} are values set here; the lesson’s controls showed a ${f1(cs.c)} percent sucrose preference, measured as the share of total intake (N = ${cs.n}, mice), and M is set equal to C only as a sketch convention because the lesson gives no manipulated group here.`);
      } else if (lessonVals) {
        parts.push(`The lesson’s group “${cs.name}” (N = ${cs.n}, mice): C = ${f1(cs.c)} and M = ${f1(cs.m)} percent sucrose.`);
      } else {
        parts.push(`In this sketch C = ${f1(C)} and M = ${f1(M)} percent sucrose are values set here, not the lesson’s ${f1(cs.c)} and ${f1(cs.m)} for “${cs.name}” (N = ${cs.n}).`);
      }
      if (isGlu) {
        parts.push('Its matching vehicle control was 82.4 percent in a separate cohort, so the cohorts differ; the lesson does not compare it with 90.8 and gives no fraction lost for this group, so none is computed here.');
        if (!same(C, 82.4)) parts.push('In this sketch C no longer equals this group’s vehicle (82.4).');
      } else if (!defined) {
        parts.push('C is 50 or below, so the control shows no above-chance advantage to lose: the fraction lost is undefined.');
      } else if (cur === 'ctrl' && lessonVals) {
        parts.push('Controls against themselves: nothing is lost, so the fraction lost is 0.00.');
      } else if (lost < -0.05) {
        parts.push(`M is above C, so nothing was lost here and the fraction is ${f2(frac)} (negative).`);
      } else {
        parts.push(`The advantage is ${f1(aC)} points in C and ${f1(aM)} in M; ${f1(lost)} points were lost, which is ${f2(frac)} of the control advantage (about ${pct(frac)} percent).`);
      }
      if (M < 50) {
        parts.push(`M is ${f1(50 - M)} points below chance, and below chance is not indifference.`);
      }
      if (cur === 'sil' && lessonVals) {
        parts.push('The lesson’s guard: locomotion and 24-hour food and water intake were unchanged in the silenced mice, so this is not malaise.');
      }
      parts.push('With N of 4 to 8 the percentages carry wide uncertainty that the arithmetic hides.');
      why.textContent = parts.join(' ');
    }

    btns.forEach((b) => {
      b.addEventListener('click', () => {
        cur = b.dataset.case || 'sil';
        const cs = CASES[cur];
        cIn.value = String(cs.c);
        mIn.value = String(cs.m);
        btns.forEach((x) => x.setAttribute('aria-pressed', x === b ? 'true' : 'false'));
        render();
      });
    });
    [cIn, mIn].forEach((s) => s.addEventListener('input', render));
    render();
  });
</script>

<style>
  .plr { padding: var(--ddp-space-3) var(--ddp-space-4) var(--ddp-space-4); margin: var(--ddp-space-5) 0; }
  .plr-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem; font-weight: 600; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); margin-bottom: var(--ddp-space-3); }
  .plr-chip { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 400; color: var(--ddp-color-muted); }
  .plr-svg { display: block; width: 100%; max-width: 560px; margin: 0 auto; height: auto; background: #fff; border: 1px solid var(--ddp-color-line); border-radius: 6px; }
  .plr-cases { display: flex; flex-wrap: wrap; gap: var(--ddp-space-2); margin: var(--ddp-space-3) 0 0; }
  .plr-btn { font: inherit; font-size: var(--ddp-text-xs); padding: 0.3rem 0.65rem; border: 1px solid var(--ddp-color-line); border-radius: 6px; background: #fff; color: var(--ddp-color-primary); cursor: pointer; }
  .plr-btn[aria-pressed="true"] { border-color: var(--ddp-color-accent); background: color-mix(in srgb, var(--ddp-color-accent) 12%, #fff); font-weight: 700; }
  .plr-btn:hover, .plr-btn:focus-visible { border-color: var(--ddp-color-accent); outline: 2px solid color-mix(in srgb, var(--ddp-color-accent) 40%, transparent); outline-offset: 1px; }
  .plr-controls { display: grid; grid-template-columns: 1fr 1fr; gap: var(--ddp-space-2) var(--ddp-space-4); margin: var(--ddp-space-3) 0 var(--ddp-space-2); }
  .plr-slabel { display: flex; flex-direction: column; gap: 0.1rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .plr-slabel em { font-style: normal; font-weight: 700; color: var(--ddp-color-accent); font-family: var(--ddp-font-mono); }
  .plr-slabel input { accent-color: var(--ddp-color-accent); }
  .plr-readout { display: grid; grid-template-columns: 1fr 1fr; gap: var(--ddp-space-2); margin: var(--ddp-space-2) 0; padding: var(--ddp-space-2) var(--ddp-space-3); background: color-mix(in srgb, var(--ddp-color-accent) 8%, transparent); border-radius: 6px; }
  .plr-readout div { display: flex; flex-direction: column; gap: 0.1rem; }
  .plr-readout dt { font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .plr-readout dd { margin: 0; font-family: var(--ddp-font-mono); font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); font-weight: 700; overflow-wrap: anywhere; }
  .plr-why { margin: 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); line-height: 1.5; min-height: 8em; }
  .plr-assume { margin: var(--ddp-space-2) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .plr-foot { margin: var(--ddp-space-2) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); border-left: 3px solid var(--ddp-color-secondary); padding-left: 0.55rem; }
  @media (max-width: 520px) {
    .plr-controls, .plr-readout { grid-template-columns: 1fr; }
  }
</style>
