---
/**
 * DriftToBoundTrials — the lesson's drift-to-bound worked problem. One neuron stands for the
 * accumulator: 30 spikes/s until 200 ms, then a linear rise at 7.8125 (spikes/s)/s per percent
 * coherence to a 70 spikes/s bound, saccade 70 ms later. rise time = (bound - baseline) / slope;
 * reaction time = latency + rise time + motor delay. With noise on, 200 trials are drawn as a
 * random walk around that drift, with a second bound for the other choice 40 relative units
 * below the baseline (symmetric with the upper bound). Self-contained vanilla-TS Astro island. Original.
 */
---

<figure class="dtb card" data-dtb>
  <figcaption class="dtb-head">Drift to bound — coherence, noise and reaction time<span class="dtb-chip">⚙ original · interactive</span></figcaption>

  <svg class="dtb-svg" viewBox="0 0 340 352" role="img" aria-label="A sketch of a firing-rate accumulator rising from 30 to a bound of 70 spikes per second after a 200 millisecond latency, with, when noise is on, 200 faint trials and a histogram of their reaction times" data-plot></svg>

  <p class="dtb-key" aria-hidden="true">
    <span><i class="dtb-sw dtb-sw-up"></i>trials reaching the preferred-target bound</span>
    <span><i class="dtb-sw dtb-sw-dn"></i>trials reaching the other-choice bound</span>
    <span><i class="dtb-sw dtb-sw-nl"></i>noiseless prediction</span>
    <span><i class="dtb-sw dtb-sw-ob"></i>observed mean</span>
    <span><i class="dtb-sw dtb-sw-ex"></i>expected mean, this noisy sketch</span>
  </p>

  <div class="dtb-controls">
    <label class="dtb-slabel"><span>Motion coherence <em data-out="coh">12.8</em>%</span>
      <input type="range" data-in="coh" min="0" max="5" step="1" value="3" aria-valuetext="12.8 percent" />
    </label>
    <label class="dtb-slabel"><span>Noise <em data-out="noise">0</em> <small>(relative units; 0 = none)</small></span>
      <input type="range" data-in="noise" min="0" max="40" step="5" value="0" />
    </label>
    <button type="button" class="dtb-btn" data-resample>Resample (200 trials)</button>
  </div>

  <dl class="dtb-readout">
    <div class="dtb-wide"><dt>The lesson’s arithmetic</dt><dd data-r-arith>—</dd></div>
    <div><dt>Noiseless reaction time (expected)</dt><dd data-r-nl>—</dd></div>
    <div><dt>Observed mean, noisy trials</dt><dd data-r-obs>—</dd></div>
    <div><dt>Expected mean for this noisy sketch</dt><dd data-r-exp>—</dd></div>
    <div><dt>Choices toward the preferred target</dt><dd data-r-choice>—</dd></div>
  </dl>

  <p class="dtb-why" data-why role="status">—</p>

  <p class="dtb-assume">In this sketch: invented numbers (30 spikes/s baseline, 70 spikes/s bound, 200 ms latency, 70 ms motor delay), one neuron standing for the accumulator, no noise unless you set it. With noise, the accumulator takes random steps in relative units and a second bound for the other choice sits 40 relative units below the baseline, symmetric with the upper bound, which is why it can fall below 0 on this relative scale. Time is cut off at 3 s on the plot; noisy trials are run to 6 s. Expected means and choice percentages are the standard first-passage results for this random walk between two bounds, not figures from the lesson.</p>

  <p class="dtb-foot">rise time = (bound − baseline) / slope, and reaction time = latency + rise time + motor delay. The ramps in the lesson are trial averages, and whether single trials ramp or step is debated; this sketch draws a noisy accumulator and does not settle that.</p>
</figure>

<script>
  const NS = 'http://www.w3.org/2000/svg';
  const ACCENT = '#0e7c86', ORANGE = '#e57200', INK = '#4b4b55', FAINT = '#b9b9c2', DARK = '#1f1f26';
  function el(name: string, attrs: Record<string, string | number>): SVGElement {
    const e = document.createElementNS(NS, name);
    for (const k in attrs) e.setAttribute(k, String(attrs[k]));
    return e;
  }
  function txt(attrs: Record<string, string | number>, s: string): SVGElement {
    const t = el('text', attrs); t.textContent = s; return t;
  }

  // The lesson's numbers (invented, for teaching).
  const BASE = 30, BOUND = 70, LAT = 0.2, MOTOR = 0.07, K = 7.8125;
  const DIST = BOUND - BASE; // 40 spikes/s; the other-choice bound sits the same distance below the baseline
  const COHS = [0, 3.2, 6.4, 12.8, 25.6, 51.2];
  const NTRIALS = 200, DT = 0.002, TMAX = 6, PLOT_T = 3;

  document.querySelectorAll<HTMLElement>('[data-dtb]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string): T => {
      const e = root.querySelector<T>(s);
      if (!e) throw new Error('DriftToBoundTrials: missing ' + s);
      return e;
    };
    const plot = q<HTMLElement>('[data-plot]') as unknown as SVGSVGElement;
    const cohIn = q<HTMLInputElement>('[data-in="coh"]'), noiseIn = q<HTMLInputElement>('[data-in="noise"]');
    const cohOut = q('[data-out="coh"]'), noiseOut = q('[data-out="noise"]');
    const btn = q<HTMLButtonElement>('[data-resample]');
    const rArith = q('[data-r-arith]'), rNl = q('[data-r-nl]'), rObs = q('[data-r-obs]'), rExp = q('[data-r-exp]'), rChoice = q('[data-r-choice]');
    const why = q('[data-why]');

    // Main plot geometry: time 0..3 s on x, rate -20..80 on y.
    const X0 = 44, X1 = 326, Y0 = 20, Y1 = 190, RMIN = -20, RMAX = 80;
    const px = (t: number) => X0 + (Math.min(t, PLOT_T) / PLOT_T) * (X1 - X0);
    const py = (r: number) => Y1 - ((r - RMIN) / (RMAX - RMIN)) * (Y1 - Y0);
    // Histogram geometry.
    const H0 = 250, H1 = 318;

    type Trial = { pts: string; up: boolean; done: boolean; rt: number };
    let trials: Trial[] = [];

    function gauss(): number {
      let u = 0, v = 0;
      while (u === 0) u = Math.random();
      v = Math.random();
      return Math.sqrt(-2 * Math.log(u)) * Math.cos(2 * Math.PI * v);
    }

    function simulate(mu: number, sigma: number): Trial[] {
      const out: Trial[] = [];
      const sq = Math.sqrt(DT);
      const nSteps = Math.round((TMAX - LAT) / DT);
      for (let n = 0; n < NTRIALS; n++) {
        let x = BASE, t = LAT, done = false, up = false;
        let pts = 'M' + px(0).toFixed(1) + ' ' + py(BASE).toFixed(1) + ' L' + px(LAT).toFixed(1) + ' ' + py(BASE).toFixed(1);
        for (let i = 1; i <= nSteps; i++) {
          x += mu * DT + sigma * sq * gauss();
          t = LAT + i * DT;
          if (x >= BOUND) { x = BOUND; done = true; up = true; }
          else if (x <= BASE - DIST) { x = BASE - DIST; done = true; up = false; }
          if (t <= PLOT_T && (i % 4 === 0 || done)) pts += ' L' + px(t).toFixed(1) + ' ' + py(x).toFixed(1);
          if (done) break;
        }
        out.push({ pts, up, done, rt: done ? (t + MOTOR) * 1000 : NaN });
      }
      return out;
    }

    const f = (v: number, d = 0) => v.toLocaleString('en-US', { minimumFractionDigits: d, maximumFractionDigits: d });

    function draw() {
      const ci = parseInt(cohIn.value, 10);
      const coh = COHS[ci] ?? 0;
      const sigma = parseInt(noiseIn.value, 10);
      const noisy = sigma > 0;
      const slope = K * coh; // (spikes/s)/s
      const mu = slope;
      cohOut.textContent = String(coh);
      cohIn.setAttribute('aria-valuetext', coh + ' percent');
      noiseOut.textContent = String(sigma);
      btn.disabled = !noisy;

      // Lesson arithmetic, noiseless.
      const rise = slope > 0 ? DIST / slope : Infinity;
      const nlRt = slope > 0 ? LAT * 1000 + rise * 1000 + MOTOR * 1000 : Infinity;
      rArith.textContent = slope > 0
        ? `slope 7.8125 × ${coh} = ${f(slope, slope % 1 ? 2 : 0)} (spikes/s)/s; rise (70 − 30) / ${f(slope, slope % 1 ? 2 : 0)} = ${f(rise, 2)} s; reaction time 200 + ${f(rise * 1000)} + 70 = ${f(nlRt)} ms`
        : 'slope 7.8125 × 0 = 0 (spikes/s)/s; rise time (70 − 30) / 0 never ends, so there is no reaction time';
      rNl.textContent = slope > 0 ? f(nlRt) + ' ms' : 'none (bound never reached)';

      // Expected values for the noisy sketch (symmetric bounds a = 40 around the baseline, Gaussian steps).
      let expRt = NaN, expUp = 0.5;
      if (noisy) {
        const s2 = sigma * sigma;
        expRt = (mu > 0 ? (DIST / mu) * Math.tanh((DIST * mu) / s2) : (DIST * DIST) / s2) * 1000 + (LAT + MOTOR) * 1000;
        expUp = 1 / (1 + Math.exp((-2 * mu * DIST) / s2));
      }

      plot.replaceChildren();
      // axes and grid
      plot.appendChild(el('line', { x1: X0, y1: Y0, x2: X0, y2: Y1, stroke: INK, 'stroke-width': 1 }));
      plot.appendChild(el('line', { x1: X0, y1: Y1, x2: X1, y2: Y1, stroke: INK, 'stroke-width': 1 }));
      for (const r of [-20, 0, 20, 40, 60, 80]) {
        plot.appendChild(el('line', { x1: X0 - 3, y1: py(r), x2: X0, y2: py(r), stroke: INK, 'stroke-width': 1 }));
        plot.appendChild(txt({ x: X0 - 5, y: py(r) + 3, 'text-anchor': 'end', 'font-size': 9, fill: INK }, String(r)));
      }
      for (let s = 0; s <= 3; s += 0.5) {
        plot.appendChild(el('line', { x1: px(s), y1: Y1, x2: px(s), y2: Y1 + 3, stroke: INK, 'stroke-width': 1 }));
        plot.appendChild(txt({ x: px(s), y: Y1 + 13, 'text-anchor': 'middle', 'font-size': 9, fill: INK }, String(s)));
      }
      plot.appendChild(txt({ x: (X0 + X1) / 2, y: Y1 + 26, 'text-anchor': 'middle', 'font-size': 10, fill: INK }, 'time since motion onset (s)'));
      plot.appendChild(txt({ x: 2, y: Y0 - 8, 'text-anchor': 'start', 'font-size': 10, fill: INK }, 'accumulator (spikes/s; below 0 = relative units)'));
      // baseline, bound, other-choice bound
      plot.appendChild(el('line', { x1: X0, y1: py(BASE), x2: X1, y2: py(BASE), stroke: FAINT, 'stroke-width': 0.8, 'stroke-dasharray': '2 3' }));
      plot.appendChild(el('line', { x1: X0, y1: py(BOUND), x2: X1, y2: py(BOUND), stroke: ACCENT, 'stroke-width': 1.2 }));
      plot.appendChild(txt({ x: X1 - 2, y: py(BOUND) - 4, 'text-anchor': 'end', 'font-size': 9, fill: ACCENT }, 'bound 70'));
      plot.appendChild(txt({ x: X1 - 2, y: py(BASE) - 4, 'text-anchor': 'end', 'font-size': 9, fill: INK }, 'baseline 30'));
      if (noisy) {
        plot.appendChild(el('line', { x1: X0, y1: py(BASE - DIST), x2: X1, y2: py(BASE - DIST), stroke: ORANGE, 'stroke-width': 1.2 }));
        plot.appendChild(txt({ x: X1 - 2, y: py(BASE - DIST) - 4, 'text-anchor': 'end', 'font-size': 9, fill: ORANGE }, 'other-choice bound −10 (relative)'));
      }
      // latency marker
      plot.appendChild(el('line', { x1: px(LAT), y1: Y0, x2: px(LAT), y2: Y1, stroke: FAINT, 'stroke-width': 0.8, 'stroke-dasharray': '3 3' }));
      plot.appendChild(txt({ x: px(LAT) + 3, y: Y1 - 5, 'font-size': 9, fill: INK }, 'latency 200 ms'));

      // noiseless prediction
      const nl = (() => {
        let d = 'M' + px(0).toFixed(1) + ' ' + py(BASE).toFixed(1) + ' L' + px(LAT).toFixed(1) + ' ' + py(BASE).toFixed(1);
        if (slope > 0) {
          const tCross = LAT + rise;
          const tEnd = Math.min(tCross, PLOT_T);
          d += ' L' + px(tEnd).toFixed(1) + ' ' + py(BASE + slope * (tEnd - LAT)).toFixed(1);
          if (tCross < PLOT_T) d += ' L' + px(Math.min(tCross + MOTOR, PLOT_T)).toFixed(1) + ' ' + py(BOUND).toFixed(1);
        } else d += ' L' + px(PLOT_T).toFixed(1) + ' ' + py(BASE).toFixed(1);
        return d;
      })();

      let stats = { n: 0, mean: NaN, upN: 0, unfinished: 0, over: 0 };
      if (noisy) {
        // faint trials
        const up = trials.filter((t) => t.up && t.done).map((t) => t.pts).join(' ');
        const dn = trials.filter((t) => !t.up && t.done).map((t) => t.pts).join(' ');
        const un = trials.filter((t) => !t.done).map((t) => t.pts).join(' ');
        if (dn) plot.appendChild(el('path', { d: dn, fill: 'none', stroke: ORANGE, 'stroke-width': 1, 'stroke-opacity': 0.16, 'stroke-linejoin': 'round' }));
        if (un) plot.appendChild(el('path', { d: un, fill: 'none', stroke: INK, 'stroke-width': 1, 'stroke-opacity': 0.16, 'stroke-linejoin': 'round' }));
        if (up) plot.appendChild(el('path', { d: up, fill: 'none', stroke: ACCENT, 'stroke-width': 1, 'stroke-opacity': 0.16, 'stroke-linejoin': 'round' }));
        const first = trials[0];
        if (first) plot.appendChild(el('path', { d: first.pts, fill: 'none', stroke: first.up ? ACCENT : ORANGE, 'stroke-width': 2, 'stroke-linejoin': 'round' }));
        if (slope > 0) plot.appendChild(el('path', { d: nl, fill: 'none', stroke: DARK, 'stroke-width': 1.4, 'stroke-dasharray': '5 3' }));
        const fin = trials.filter((t) => t.done);
        stats.n = fin.length;
        stats.unfinished = trials.length - fin.length;
        stats.upN = fin.filter((t) => t.up).length;
        stats.mean = fin.length ? fin.reduce((a, t) => a + t.rt, 0) / fin.length : NaN;
        stats.over = fin.filter((t) => t.rt > PLOT_T * 1000).length;
      } else {
        plot.appendChild(el('path', { d: nl, fill: 'none', stroke: ACCENT, 'stroke-width': 2.6, 'stroke-linejoin': 'round' }));
        if (slope > 0) {
          const tCross = LAT + rise;
          if (tCross < PLOT_T) {
            plot.appendChild(el('circle', { cx: px(tCross), cy: py(BOUND), r: 4, fill: ORANGE }));
            const xs = px(tCross);
            const lab = 'decision; saccade +70 ms';
            const endA = xs > 190;
            plot.appendChild(txt({ x: endA ? xs - 7 : xs + 7, y: py(BOUND) - 4, 'text-anchor': endA ? 'end' : 'start', 'font-size': 9, 'font-weight': 700, fill: ORANGE }, lab));
          } else {
            plot.appendChild(txt({ x: px(PLOT_T) - 4, y: py(BASE + slope * (PLOT_T - LAT)) + 14, 'text-anchor': 'end', 'font-size': 9, fill: ORANGE }, 'bound reached after 3 s (cut off)'));
          }
        } else {
          plot.appendChild(txt({ x: (X0 + X1) / 2 + 20, y: py(BASE) + 14, 'text-anchor': 'middle', 'font-size': 9, 'font-weight': 700, fill: ORANGE }, 'never reaches the bound (cut off at 3 s)'));
        }
      }

      // histogram
      plot.appendChild(txt({ x: 2, y: 236, 'text-anchor': 'start', 'font-size': 10, fill: INK }, noisy ? 'reaction times of the 200 trials (0.1 s bins)' : 'reaction-time histogram'));
      if (!noisy) {
        plot.appendChild(el('rect', { x: X0, y: H0, width: X1 - X0, height: H1 - H0, fill: 'none', stroke: FAINT, 'stroke-dasharray': '3 3' }));
        plot.appendChild(txt({ x: (X0 + X1) / 2, y: (H0 + H1) / 2 + 3, 'text-anchor': 'middle', 'font-size': 10, fill: INK }, 'turn the noise above 0 to draw 200 trials'));
      } else {
        const nb = 30, up = new Array<number>(nb).fill(0), dn = new Array<number>(nb).fill(0);
        for (const t of trials) {
          if (!t.done || t.rt >= PLOT_T * 1000) continue;
          const b = Math.min(nb - 1, Math.floor(t.rt / 100));
          if (t.up) up[b] = (up[b] ?? 0) + 1; else dn[b] = (dn[b] ?? 0) + 1;
        }
        let mx = 1;
        for (let b = 0; b < nb; b++) mx = Math.max(mx, (up[b] ?? 0) + (dn[b] ?? 0));
        const hy = (c: number) => H1 - (c / mx) * (H1 - H0);
        plot.appendChild(el('line', { x1: X0, y1: H0, x2: X0, y2: H1, stroke: INK, 'stroke-width': 1 }));
        plot.appendChild(el('line', { x1: X0, y1: H1, x2: X1, y2: H1, stroke: INK, 'stroke-width': 1 }));
        plot.appendChild(txt({ x: X0 - 5, y: H0 + 3, 'text-anchor': 'end', 'font-size': 9, fill: INK }, String(mx)));
        plot.appendChild(txt({ x: X0 - 5, y: H1 + 3, 'text-anchor': 'end', 'font-size': 9, fill: INK }, '0'));
        const bw = (X1 - X0) / nb;
        for (let b = 0; b < nb; b++) {
          const u = up[b] ?? 0, d = dn[b] ?? 0;
          if (u + d === 0) continue;
          plot.appendChild(el('rect', { x: X0 + b * bw + 0.5, y: hy(u + d), width: bw - 1, height: hy(u) - hy(u + d), fill: ORANGE }));
          plot.appendChild(el('rect', { x: X0 + b * bw + 0.5, y: hy(u), width: bw - 1, height: hy(0) - hy(u), fill: ACCENT }));
        }
        const vline = (ms: number, col: string, dash: string, w: number) => {
          if (!isFinite(ms) || ms > PLOT_T * 1000) return;
          plot.appendChild(el('line', { x1: px(ms / 1000), y1: H0 - 2, x2: px(ms / 1000), y2: H1, stroke: col, 'stroke-width': w, 'stroke-dasharray': dash }));
        };
        vline(nlRt, DARK, '5 3', 1.4);
        vline(expRt, ORANGE, '2 2', 1.6);
        vline(stats.mean, '#6a2c91', '', 1.6);
        for (let s = 0; s <= 3; s += 0.5) {
          plot.appendChild(el('line', { x1: px(s), y1: H1, x2: px(s), y2: H1 + 3, stroke: INK, 'stroke-width': 1 }));
          plot.appendChild(txt({ x: px(s), y: H1 + 13, 'text-anchor': 'middle', 'font-size': 9, fill: INK }, String(s)));
        }
        plot.appendChild(txt({ x: (X0 + X1) / 2, y: H1 + 26, 'text-anchor': 'middle', 'font-size': 10, fill: INK }, 'reaction time (s)'));
      }

      // readouts
      if (noisy) {
        rObs.textContent = isFinite(stats.mean) ? f(stats.mean) + ' ms (' + stats.n + ' finished trials)' : 'no trial reached a bound';
        rExp.textContent = f(expRt) + ' ms';
        rChoice.textContent = stats.n ? f((100 * stats.upN) / stats.n, 1) + '% observed; expected ' + f(100 * expUp, 1) + '%' : '—';
      } else {
        rObs.textContent = 'no noise: one trace, no scatter';
        rExp.textContent = '—';
        rChoice.textContent = slope > 0 ? 'every trace ends at the preferred-target bound' : 'none: no bound is reached';
      }

      // status
      const hedge = ' The ramps in the lesson are trial averages, and whether single trials ramp or step is debated. LIP activity correlates with the decision, but silencing LIP produced no measurable impairment of motion decisions in the tasks Katz and colleagues tested, so the best correlate was not necessary for them.';
      let s: string;
      if (!noisy) {
        if (slope === 0) {
          s = 'At 0% coherence the slope is 0, so the noiseless trace stays at 30 spikes/s and never reaches the 70 spikes/s bound; the plot is cut off at 3 s and there is no reaction time in this sketch. In the lesson, at 0% only noise reaches the bound, giving long, variable times and chance choices: raise the noise to see that.';
        } else {
          s = `In this sketch with no noise, ${coh}% coherence gives a slope of ${f(slope, slope % 1 ? 2 : 0)} (spikes/s)/s, a rise time of ${f(rise, 2)} s and a reaction time of ${f(nlRt)} ms (200 ms latency + rise + 70 ms motor delay).`;
          if (coh === 51.2) s += ' In one illustrated experiment, Roitman and Shadlen reported a mean of 350 ± 9 ms (SEM) for correct choices at 51.2% in monkeys, close to this model.';
        }
      } else {
        const parts: string[] = [];
        if (stats.n === 0) {
          s = `In this sketch with noise ${sigma}, none of the 200 trials reached a bound within 6 s (trials are stopped there); the expected mean time is ${f(expRt)} ms. Raise the noise to see choices and times.`;
        } else {
          if (slope === 0) {
            parts.push(`At 0% coherence there is no drift, so only noise carries the accumulator to a bound: ${f((100 * stats.upN) / stats.n, 1)}% of choices went to the preferred target (chance is 50%), with long, variable times (observed mean ${f(stats.mean)} ms; this sketch’s expected mean ${f(expRt)} ms).`);
          } else {
            const shorter = expRt < nlRt - 1;
            if (coh <= 12.8 && shorter) {
              parts.push(`At ${coh}% coherence with noise ${sigma}, this sketch’s expected mean reaction time is ${f(expRt)} ms, shorter than the noiseless prediction of ${f(nlRt)} ms, as the lesson says for weak motion: noise carries many trials to one bound or the other early. This draw of 200 trials averaged ${f(stats.mean)} ms, ${f((100 * stats.upN) / stats.n, 1)}% of choices toward the preferred target (expected ${f(100 * expUp, 1)}%).`);
            } else {
              parts.push(`At ${coh}% coherence with noise ${sigma}, this sketch’s expected mean reaction time is ${f(expRt)} ms against the noiseless ${f(nlRt)} ms; this draw averaged ${f(stats.mean)} ms, with ${f((100 * stats.upN) / stats.n, 1)}% of choices toward the preferred target (expected ${f(100 * expUp, 1)}%). Resample to see the scatter around the expected values.`);
            }
          }
          if (stats.unfinished > 0) parts.push(`${stats.unfinished} trials had not reached a bound by 6 s and are left out of the observed mean, which therefore runs below the expected mean.`);
          if (stats.over > 0) parts.push(`${stats.over} finished trials took longer than 3 s and fall off the right of the histogram.`);
          s = parts.join(' ');
        }
      }
      why.textContent = s + hedge;
    }

    function resample() {
      const ci = parseInt(cohIn.value, 10);
      const sigma = parseInt(noiseIn.value, 10);
      trials = sigma > 0 ? simulate(K * (COHS[ci] ?? 0), sigma) : [];
      draw();
    }
    cohIn.addEventListener('input', resample);
    noiseIn.addEventListener('input', resample);
    btn.addEventListener('click', resample);
    resample();
  });
</script>

<style>
  .dtb { padding: var(--ddp-space-3) var(--ddp-space-4) var(--ddp-space-4); margin: var(--ddp-space-5) 0; }
  .dtb-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem; font-weight: 600; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); margin-bottom: var(--ddp-space-3); }
  .dtb-chip { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 400; color: var(--ddp-color-muted); }
  .dtb-svg { display: block; width: 100%; max-width: 560px; margin: 0 auto; height: auto; background: #fff; border: 1px solid var(--ddp-color-line); border-radius: 6px; }
  .dtb-key { display: flex; flex-wrap: wrap; gap: 0.2rem 0.9rem; margin: var(--ddp-space-2) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .dtb-sw { display: inline-block; width: 1.1rem; height: 0; border-top: 3px solid; margin-right: 0.35rem; vertical-align: middle; }
  .dtb-sw-up { border-color: #0e7c86; }
  .dtb-sw-dn { border-color: #e57200; }
  .dtb-sw-nl { border-top: 2px dashed #1f1f26; }
