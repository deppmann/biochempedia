---
/**
 * PoreLeakTimer — the worked problem "how soft is the barrier?" as a measurement.
 * Excess nuclear signal decays as x(t)/x(0) = exp(-t/τ). The learner picks one of the
 * two reporters the lesson gives (27 kDa GFP, τ = 15 s; 67 kDa, τ = 413 s), drags a
 * time cursor, and reads the fraction left and the half-time τ·ln 2 beside the lesson's
 * arithmetic. Self-contained vanilla-TS Astro island. Original.
 */
---

<figure class="plt card" data-pltimer>
  <figcaption class="plt-head">Pore leak timer — how soft is the barrier?<span class="plt-chip">⚙ original · interactive</span></figcaption>

  <svg class="plt-svg" viewBox="0 0 340 230" role="img" aria-label="Decay of excess nuclear signal over time for two reporters, with a movable time cursor" data-plot></svg>

  <div class="plt-controls">
    <fieldset class="plt-fs">
      <legend>Reporter</legend>
      <label class="plt-radio"><input type="radio" name="plt-rep" value="gfp" checked data-rep /> 27 kDa GFP (τ = 15 s)</label>
      <label class="plt-radio"><input type="radio" name="plt-rep" value="big" data-rep /> 67 kDa reporter (τ = 413 s)</label>
    </fieldset>
    <label class="plt-slabel"><span>Time cursor t <em data-out="t">60</em> s</span>
      <input type="range" data-in="t" min="0" max="900" step="1" value="60" />
    </label>
  </div>

  <dl class="plt-readout">
    <div><dt>t / τ</dt><dd data-r-ratio></dd></div>
    <div><dt>Excess left, exp(−t/τ)</dt><dd data-r-frac></dd></div>
    <div><dt>Half-time, τ × ln 2</dt><dd data-r-half></dd></div>
  </dl>
  <p class="plt-why" data-why role="status"></p>

  <p class="plt-foot">In this model, the excess nuclear signal falls as exp(−t/τ), using the normalized τ values the lesson gives (Timney et al. 2016, yeast; uncertainty ignored). These are model curves, not measured traces; τ grew about 27-fold (413/15 = 27.5) for a 2.5-fold rise in mass (67/27 = 2.48), so the pore is a soft barrier, not a cutoff. Only these two reporters are given; the picture does not interpolate between them.</p>
</figure>

<script>
  const NS = 'http://www.w3.org/2000/svg';
  const ACCENT = '#0e7c86', ORANGE = '#e57200', INK = '#4b4b55', FAINT = '#b9b9c2';
  function el(name: string, attrs: Record<string, string | number>): SVGElement {
    const e = document.createElementNS(NS, name);
    for (const k in attrs) e.setAttribute(k, String(attrs[k]));
    return e;
  }
  const REP: Record<string, { tau: number; label: string; short: string }> = {
    gfp: { tau: 15, label: '27 kDa GFP', short: 'GFP' },
    big: { tau: 413, label: '67 kDa reporter', short: '67 kDa' },
  };
  const LN2 = Math.LN2;
  document.querySelectorAll<HTMLElement>('[data-pltimer]').forEach((root) => {
    const plot = root.querySelector<SVGSVGElement>('[data-plot]')!;
    const tIn = root.querySelector<HTMLInputElement>('[data-in="t"]')!;
    const tOut = root.querySelector<HTMLElement>('[data-out="t"]')!;
    const reps = Array.from(root.querySelectorAll<HTMLInputElement>('[data-rep]'));
    const rRatio = root.querySelector<HTMLElement>('[data-r-ratio]')!;
    const rFrac = root.querySelector<HTMLElement>('[data-r-frac]')!;
    const rHalf = root.querySelector<HTMLElement>('[data-r-half]')!;
    const why = root.querySelector<HTMLElement>('[data-why]')!;

    const X0 = 44, X1 = 326, Y0 = 22, Y1 = 188, TMAX = 900;
    const px = (t: number) => X0 + (t / TMAX) * (X1 - X0);
    const py = (f: number) => Y1 - f * (Y1 - Y0);
    const curve = (tau: number) => {
      let d = '';
      for (let t = 0; t <= TMAX; t += 5) d += (t === 0 ? 'M' : 'L') + px(t).toFixed(1) + ' ' + py(Math.exp(-t / tau)).toFixed(1) + ' ';
      return d.trim();
    };
    const txt = (x: number, y: number, s: string, extra: Record<string, string | number> = {}) => {
      const t = el('text', Object.assign({ x, y, 'font-size': 9, fill: INK }, extra));
      t.textContent = s;
      plot.appendChild(t);
    };
    const pct = (f: number) => (f * 100 >= 10 ? (f * 100).toFixed(1) : (f * 100).toFixed(2)) + '%';

    function render() {
      const sel = reps.find((r) => r.checked)?.value ?? 'gfp';
      const other = sel === 'gfp' ? 'big' : 'gfp';
      const { tau, label, short } = REP[sel];
      const t = parseInt(tIn.value, 10);
      const f = Math.exp(-t / tau);
      const half = tau * LN2;
      tOut.textContent = String(t);
      plot.replaceChildren();
      plot.appendChild(el('line', { x1: X0, y1: Y0, x2: X0, y2: Y1, stroke: INK, 'stroke-width': 1 }));
      plot.appendChild(el('line', { x1: X0, y1: Y1, x2: X1, y2: Y1, stroke: INK, 'stroke-width': 1 }));
      for (const g of [0, 0.5, 1]) {
        plot.appendChild(el('line', { x1: X0, y1: py(g), x2: X1, y2: py(g), stroke: FAINT, 'stroke-width': 0.7, 'stroke-dasharray': '2 3' }));
        txt(X0 - 4, py(g) + 3, g === 0 ? '0' : g === 1 ? '1' : '0.5', { 'text-anchor': 'end' });
      }
      for (const tk of [0, 300, 600, 900]) {
        plot.appendChild(el('line', { x1: px(tk), y1: Y1, x2: px(tk), y2: Y1 + 3, stroke: INK, 'stroke-width': 1 }));
        txt(px(tk), Y1 + 13, String(tk), { 'text-anchor': 'middle' });
      }
      txt((X0 + X1) / 2, Y1 + 28, 'time after bleaching (s)', { 'text-anchor': 'middle', 'font-size': 10 });
      txt(X0 - 2, Y0 - 8, 'excess nuclear signal, x(t)/x(0)', { 'text-anchor': 'start', 'font-size': 10 });

      plot.appendChild(el('path', { d: curve(REP[other].tau), fill: 'none', stroke: FAINT, 'stroke-width': 1.6, 'stroke-dasharray': '4 3' }));
      plot.appendChild(el('path', { d: curve(tau), fill: 'none', stroke: ACCENT, 'stroke-width': 2.6 }));

      // legend in the upper right, clear of both curves at late times
      const LX = X1 - 140, LY = Y0 + 14;
      plot.appendChild(el('line', { x1: LX, y1: LY, x2: LX + 16, y2: LY, stroke: ACCENT, 'stroke-width': 2.6 }));
      txt(LX + 20, LY + 3, label + ' (selected)');
      plot.appendChild(el('line', { x1: LX, y1: LY + 13, x2: LX + 16, y2: LY + 13, stroke: FAINT, 'stroke-width': 1.6, 'stroke-dasharray': '4 3' }));
      txt(LX + 20, LY + 16, REP[other].label);

      // half-time marker on the selected curve
      plot.appendChild(el('line', { x1: px(half), y1: py(0.5), x2: px(half), y2: Y1, stroke: ORANGE, 'stroke-width': 1.2, 'stroke-dasharray': '3 2' }));
      plot.appendChild(el('circle', { cx: px(half), cy: py(0.5), r: 3.5, fill: ORANGE }));
      txt(Math.min(px(half) + 6, X1 - 50), py(0.5) - 6, 't½ = ' + half.toFixed(tau > 100 ? 0 : 1) + ' s', { fill: ORANGE, 'font-weight': 700 });

      // time cursor
      plot.appendChild(el('line', { x1: px(t), y1: Y0, x2: px(t), y2: Y1, stroke: INK, 'stroke-width': 1.2 }));
      plot.appendChild(el('circle', { cx: px(t), cy: py(f), r: 4.5, fill: '#fff', stroke: INK, 'stroke-width': 2 }));

      rRatio.textContent = (t / tau).toFixed(3);
      rFrac.textContent = pct(f) + ' (' + f.toFixed(3) + ')';
      rHalf.textContent = tau + ' × 0.693 = ' + half.toFixed(tau > 100 ? 0 : 1) + ' s';

      const fo = Math.exp(-t / REP[other].tau);
      let s = `At t = ${t} s the ${label} has ${pct(f)} of its excess nuclear signal left (t/τ = ${(t / tau).toFixed(3)}, exp(−${(t / tau).toFixed(3)}) = ${f.toFixed(3)}). The other reporter, ${REP[other].label}, would have ${pct(fo)}.`;
      if (t === 0) s = `At t = 0 all of the excess is still there (x/x(0) = 1) for either reporter. Drag the cursor to see how fast each one falls.`;
      else if (sel === 'big' && t >= 286) s += ` By then it has crossed in part, slowly. The lesson reads this as a soft barrier, not a sharp 40 kDa cutoff.`;
      else if (sel === 'gfp' && f < 0.05) s += ` GFP has mostly equilibrated; the 67 kDa reporter has not.`;
      why.textContent = s;
    }
    reps.forEach((r) => r.addEventListener('change', render));
    tIn.addEventListener('input', render);
    render();
  });
</script>

<style>
  .plt { padding: var(--ddp-space-3) var(--ddp-space-4) var(--ddp-space-4); margin: var(--ddp-space-5) 0; }
  .plt-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem; font-weight: 600; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); margin-bottom: var(--ddp-space-3); }
  .plt-chip { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 400; color: var(--ddp-color-muted); }
  .plt-svg { display: block; width: 100%; max-width: 560px; margin: 0 auto; height: auto; background: #fff; border: 1px solid var(--ddp-color-line); border-radius: 6px; }
  .plt-controls { display: grid; grid-template-columns: 1fr 1fr; gap: var(--ddp-space-2) var(--ddp-space-4); margin: var(--ddp-space-3) 0 var(--ddp-space-2); }
  .plt-fs { border: 0; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.2rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); min-width: 0; }
  .plt-fs legend { padding: 0; font-weight: 600; margin-bottom: 0.15rem; }
  .plt-radio { display: flex; gap: 0.4rem; align-items: center; }
  .plt-radio input { accent-color: var(--ddp-color-accent); }
  .plt-slabel { display: flex; flex-direction: column; gap: 0.1rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .plt-slabel em { font-style: normal; font-weight: 700; color: var(--ddp-color-accent); font-family: var(--ddp-font-mono); }
  .plt-slabel input { accent-color: var(--ddp-color-accent); }
  .plt-readout { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--ddp-space-2); margin: var(--ddp-space-2) 0; padding: var(--ddp-space-2) var(--ddp-space-3); background: color-mix(in srgb, var(--ddp-color-accent) 8%, transparent); border-radius: 6px; }
  .plt-readout div { display: flex; flex-direction: column; gap: 0.1rem; min-width: 0; }
  .plt-readout dt { font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .plt-readout dd { margin: 0; font-family: var(--ddp-font-mono); font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); font-weight: 700; overflow-wrap: anywhere; }
  .plt-why { margin: 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); line-height: 1.5; min-height: 5em; }
  .plt-foot { margin: var(--ddp-space-3) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); border-left: 3px solid var(--ddp-color-secondary); padding-left: 0.55rem; }
  @media (max-width: 520px) {
    .plt-controls { grid-template-columns: 1fr; }
    .plt-readout { grid-template-columns: 1fr; }
  }
</style>
