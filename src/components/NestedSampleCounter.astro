---
/**
 * NestedSampleCounter — the lesson's invented nested dataset (animals, sessions, units, trials)
 * with a mean firing rate and an n computed at the level of analysis the learner chooses, and a
 * hypothetical "copy mouse A's units" slider that shows how unequal sampling moves the pooled mean.
 * Original. Self-contained vanilla-TS Astro island.
 */
---

<figure class="nsc card" data-nsc>
  <figcaption class="nsc-head">Nested samples — what is n?<span class="nsc-chip">⚙ original · interactive</span></figcaption>

  <fieldset class="nsc-levels">
    <legend>Level of analysis (what is counted as one sample)</legend>
    <label><input type="radio" name="nsc-level" value="trials" checked /> Unit-trials</label>
    <label><input type="radio" name="nsc-level" value="pres" /> Stimulus presentations</label>
    <label><input type="radio" name="nsc-level" value="units" /> Units</label>
    <label><input type="radio" name="nsc-level" value="sessions" /> Sessions</label>
    <label><input type="radio" name="nsc-level" value="animals" /> Animals</label>
  </fieldset>

  <label class="nsc-slabel"><span>Copy mouse A’s units (hypothetical): extra copies of U1 to U4 <em data-out="copies">0</em></span>
    <input type="range" data-in="copies" min="0" max="4" step="1" value="0" />
  </label>

  <svg class="nsc-svg" viewBox="0 0 340 176" role="img" aria-label="Mean firing rate and sample size n at each level of analysis, from an invented dataset" data-plot></svg>

  <div class="nsc-tree" data-tree aria-label="The invented dataset as a tree: animals, sessions, units and their four spike counts"></div>

  <dl class="nsc-readout">
    <div><dt>Mean at this level</dt><dd data-r-mean></dd></div>
    <div><dt>n at this level</dt><dd data-r-n></dd></div>
    <div><dt>Pooled rate (all units)</dt><dd data-r-pool></dd></div>
    <div><dt>Animal mean (mice weighted equally)</dt><dd data-r-animal></dd></div>
  </dl>
  <p class="nsc-count" data-count></p>
  <p class="nsc-why" data-why role="status"></p>

  <p class="nsc-assume">In this sketch: invented counts (spikes in 0.25 s windows, four presentations per session), each unit in one session only, means without spread.</p>
  <p class="nsc-foot">Counting units or trials as independent is pseudoreplication (Lazic, 2010); averaging within animals, or a mixed-effects model, keeps the animal as the unit. Say which level the question is about.</p>
</figure>

<script>
  const NS = 'http://www.w3.org/2000/svg';
  const ACCENT = '#0e7c86', ORANGE = '#e57200', INK = '#4b4b55', FAINT = '#b9b9c2';
  function el(name: string, attrs: Record<string, string | number>): SVGElement {
    const e = document.createElementNS(NS, name);
    for (const k in attrs) e.setAttribute(k, String(attrs[k]));
    return e;
  }
  type Unit = { id: string; counts: number[] };
  type Session = { n: number; units: Unit[] };
  type Mouse = { name: string; sessions: Session[] };
  const DATA: Mouse[] = [
    { name: 'A', sessions: [
      { n: 1, units: [{ id: 'U1', counts: [1, 2, 3, 2] }, { id: 'U2', counts: [0, 0, 1, 1] }] },
      { n: 2, units: [{ id: 'U3', counts: [1, 1, 1, 1] }, { id: 'U4', counts: [2, 2, 2, 2] }] },
    ] },
    { name: 'B', sessions: [
      { n: 3, units: [{ id: 'U5', counts: [0, 1, 0, 1] }] },
      { n: 4, units: [{ id: 'U6', counts: [1, 0, 1, 0] }] },
    ] },
  ];
  const WINDOW = 0.25, PRES = 4; // seconds per window, presentations per session
  const sum = (a: number[]) => a.reduce((s, x) => s + x, 0);
  const mean = (a: number[]) => sum(a) / a.length;
  const rate = (u: Unit) => sum(u.counts) / (u.counts.length * WINDOW); // spikes/s (each unit watched 1 s)
  const fmt = (x: number) => { const r = Math.round(x * 100) / 100; return (Number.isInteger(r) ? r.toFixed(0) : r.toFixed(2).replace(/0$/, '')); };

  const LEVELS = ['trials', 'pres', 'units', 'sessions', 'animals'] as const;
  type Level = typeof LEVELS[number];
  const LABEL: Record<Level, string> = { trials: 'Unit-trials', pres: 'Presentations', units: 'Units', sessions: 'Sessions', animals: 'Animals' };

  document.querySelectorAll<HTMLElement>('[data-nsc]').forEach((root) => {
    const plot = root.querySelector<SVGSVGElement>('[data-plot]');
    const tree = root.querySelector<HTMLElement>('[data-tree]');
    const copiesIn = root.querySelector<HTMLInputElement>('[data-in="copies"]');
    const copiesOut = root.querySelector<HTMLElement>('[data-out="copies"]');
    const rMean = root.querySelector<HTMLElement>('[data-r-mean]');
    const rN = root.querySelector<HTMLElement>('[data-r-n]');
    const rPool = root.querySelector<HTMLElement>('[data-r-pool]');
    const rAnimal = root.querySelector<HTMLElement>('[data-r-animal]');
    const count = root.querySelector<HTMLElement>('[data-count]');
    const why = root.querySelector<HTMLElement>('[data-why]');
    const radios = Array.from(root.querySelectorAll<HTMLInputElement>('input[name="nsc-level"]'));
    if (!plot || !tree || !copiesIn || !copiesOut || !rMean || !rN || !rPool || !rAnimal || !count || !why || radios.length === 0) return;

    function currentLevel(): Level {
      const r = radios.find((x) => x.checked);
      const v = r ? r.value : 'trials';
      return (LEVELS as readonly string[]).includes(v) ? (v as Level) : 'trials';
    }

    // Copies: k extra copies of each of U1 to U4 (mouse A), hypothetical. They share mouse A's presentations.
    function compute(k: number) {
      const sessions = DATA.flatMap((m) => m.sessions.map((s) => ({ mouse: m.name, s })));
      const sessionUnitRates = (mouse: string, s: Session) => {
        const rs = s.units.map(rate);
        const copies = mouse === 'A' ? s.units.map(rate) : [];
        let all = rs.slice();
        for (let i = 0; i < k; i++) all = all.concat(copies);
        return all;
      };
      const perSession = sessions.map(({ mouse, s }) => ({ mouse, n: s.n, rates: sessionUnitRates(mouse, s) }));
      const allRates = perSession.flatMap((x) => x.rates);
      const nUnits = allRates.length;
      const sessionMeans = perSession.map((x) => mean(x.rates));
      const mouseMeans = DATA.map((m) => mean(perSession.filter((x) => x.mouse === m.name).map((x) => mean(x.rates))));
      const animalMean = mean(mouseMeans);
      const pooled = mean(allRates); // every unit is watched for the same 1 s
      const nSessions = perSession.length, nAnimals = DATA.length;
      const nPres = nSessions * PRES;
      return {
        perSession, nUnits, sessionMeans, mouseMeans, animalMean, pooled, nSessions, nAnimals, nPres,
        nTrials: nUnits * PRES,
        // Each presentation's rate is the mean over the units recorded in it; presentations are then averaged.
        presMean: mean(sessionMeans), sessionMean: mean(sessionMeans),
      };
    }

    function render() {
      const k = parseInt(copiesIn!.value, 10) || 0;
      const lv = currentLevel();
      const c = compute(k);
      copiesOut!.textContent = String(k);
      const means: Record<Level, number> = { trials: c.pooled, pres: c.presMean, units: c.pooled, sessions: c.sessionMean, animals: c.animalMean };
      const ns: Record<Level, number> = { trials: c.nTrials, pres: c.nPres, units: c.nUnits, sessions: c.nSessions, animals: c.nAnimals };

      // --- plot: mean rate and n at each level ---
      plot!.replaceChildren();
      const X0 = 84, X1 = 236, scale = (X1 - X0) / 6;
      LEVELS.forEach((L, i) => {
        const y = 14 + i * 26, on = L === lv;
        const lab = el('text', { x: 4, y: y + 12, 'font-size': 10, 'font-weight': on ? 700 : 400, fill: on ? ACCENT : INK }); lab.textContent = LABEL[L]; plot!.appendChild(lab);
        plot!.appendChild(el('rect', { x: X0, y, width: means[L] * scale, height: 16, fill: on ? ACCENT : FAINT, rx: 2 }));
        const v = el('text', { x: X0 + means[L] * scale + 4, y: y + 12, 'font-size': 10, fill: INK }); v.textContent = fmt(means[L]); plot!.appendChild(v);
        const n = el('text', { x: 336, y: y + 12, 'text-anchor': 'end', 'font-size': 10, 'font-weight': on ? 700 : 400, fill: on ? ORANGE : INK }); n.textContent = 'n = ' + ns[L]; plot!.appendChild(n);
      });
      plot!.appendChild(el('line', { x1: X0, y1: 10, x2: X0, y2: 146, stroke: INK, 'stroke-width': 1 }));
      plot!.appendChild(el('line', { x1: X0 + c.animalMean * scale, y1: 10, x2: X0 + c.animalMean * scale, y2: 146, stroke: ORANGE, 'stroke-width': 1, 'stroke-dasharray': '3 2' }));
      for (const t of [0, 2, 4, 6]) {
        const tx = el('text', { x: X0 + t * scale, y: 158, 'text-anchor': 'middle', 'font-size': 9, fill: INK }); tx.textContent = String(t); plot!.appendChild(tx);
      }
      const ax = el('text', { x: X0 + 3 * scale, y: 171, 'text-anchor': 'middle', 'font-size': 9, fill: INK }); ax.textContent = 'mean firing rate, spikes/s (dashed: animal mean)'; plot!.appendChild(ax);

      // --- tree ---
      tree!.replaceChildren();
      const row = (cls: string, text: string, lvls: string, depth: number) => {
        const d = document.createElement('div');
        d.className = 'nsc-row ' + cls; d.style.paddingLeft = (depth * 0.9) + 'rem';
        d.dataset.lv = lvls; d.textContent = text; tree!.appendChild(d);
        if (lvls.split(' ').includes(lv)) d.classList.add('nsc-on');
        return d;
      };
      DATA.forEach((m, mi) => {
        row('nsc-animal', `Mouse ${m.name}: ${fmt(c.mouseMeans[mi])} spikes/s (mean of its sessions)`, 'animals', 0);
        m.sessions.forEach((s) => {
          const si = c.perSession.findIndex((x) => x.n === s.n);
          row('nsc-sess', `Session ${s.n}: mean ${fmt(c.sessionMeans[si])} spikes/s; 4 presentations shared by its units`, 'sessions pres', 1);
          s.units.forEach((u) => row('nsc-unit', `${u.id} (${u.counts.join(', ')}) = ${sum(u.counts)} spikes in 1 s = ${fmt(rate(u))} spikes/s`, 'units trials', 2));
          if (m.name === 'A' && k > 0) row('nsc-copy', `+ ${k} hypothetical ${k === 1 ? 'copy' : 'copies'} of ${s.units.map((u) => u.id).join(' and ')} (not real units)`, 'units trials', 2);
        });
      });

      // --- readouts ---
      rMean!.textContent = fmt(means[lv]) + ' spikes/s';
      rN!.textContent = String(ns[lv]);
      rPool!.textContent = fmt(c.pooled) + ' spikes/s';
      rAnimal!.textContent = fmt(c.animalMean) + ' spikes/s';
      const unitTrialsTxt = k === 0 ? `${c.nUnits} units × 4 = ${c.nTrials} unit-trials` : `${c.nUnits} units (6 real + ${4 * k} hypothetical) × 4 = ${c.nTrials} unit-trials`;
      count!.textContent = `${c.nUnits} units, ${c.nSessions} sessions, ${c.nAnimals} animals; ${unitTrialsTxt}, but only ${c.nPres} stimulus presentations, because units recorded together share presentations. A claim about mice rests on n = ${c.nAnimals}.`;

      // --- status ---
      let msg = '';
      if (lv === 'trials') msg = `Counting every unit-trial gives n = ${c.nTrials}, but the ${c.nTrials} counts come from ${c.nUnits} units, ${c.nSessions} sessions and ${c.nAnimals} animals and are not independent; treating them as independent is pseudoreplication (Lazic, 2010). Mean ${fmt(c.pooled)} spikes/s.`;
      else if (lv === 'pres') msg = `The ${c.nPres} presentations are shared by the units recorded in the same session, so they are not ${c.nPres} independent samples either. In this sketch, taking each presentation’s rate as the mean over the units recorded in it gives ${fmt(c.presMean)} spikes/s (the lesson gives only the count, ${c.nPres}).`;
      else if (lv === 'units') msg = `Counting units gives n = ${c.nUnits} and a pooled mean of ${fmt(c.pooled)} spikes/s${k === 0 ? ' (26 spikes over 6 unit-seconds)' : ''}. Units in one animal share its conditions, so this n is not the number of mice.`;
      else if (lv === 'sessions') msg = `In this sketch, averaging within each session gives n = ${c.nSessions}: session means ${c.sessionMeans.map(fmt).join(', ')} spikes/s. Sessions in one animal still share that animal, so this is not n for a claim about mice.`;
      else msg = `Averaging within each animal and then across animals gives ${fmt(c.animalMean)} spikes/s with n = ${c.nAnimals}: mouse A ${fmt(c.mouseMeans[0])}, mouse B ${fmt(c.mouseMeans[1])}. For a claim about mice, n = 2, not the number of units or trials.`;
      if (k > 0) {
        msg += ` With ${k} hypothetical ${k === 1 ? 'copy' : 'copies'} of mouse A’s units, the pooled mean moves to ${fmt(c.pooled)} spikes/s, toward mouse A’s ${fmt(c.mouseMeans[0])}, because mouse A supplies more units; the animal mean stays ${fmt(c.animalMean)}.`;
      } else {
        msg += ` The pooled rate (${fmt(c.pooled)}) is higher than the animal mean (${fmt(c.animalMean)}) because mouse A supplied twice the units.`;
      }
      why!.textContent = msg;
    }
    radios.forEach((r) => r.addEventListener('change', render));
    copiesIn.addEventListener('input', render);
    render();
  });
</script>

<style is:global>
  .nsc { padding: var(--ddp-space-3) var(--ddp-space-4) var(--ddp-space-4); margin: var(--ddp-space-5) 0; }
  .nsc-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem; font-weight: 600; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); margin-bottom: var(--ddp-space-3); }
  .nsc-chip { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 400; color: var(--ddp-color-muted); }
  .nsc-levels { display: flex; flex-wrap: wrap; gap: 0.3rem 1rem; border: 1px solid var(--ddp-color-line); border-radius: 6px; padding: 0.4rem 0.7rem; margin: 0 0 var(--ddp-space-2); font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .nsc-levels legend { font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); padding: 0 0.3rem; }
  .nsc-levels label { display: inline-flex; align-items: center; gap: 0.3rem; }
  .nsc-levels input { accent-color: var(--ddp-color-accent); }
  .nsc-slabel { display: flex; flex-direction: column; gap: 0.1rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); margin: 0 0 var(--ddp-space-2); }
  .nsc-slabel em { font-style: normal; font-weight: 700; color: var(--ddp-color-accent); font-family: var(--ddp-font-mono); }
  .nsc-slabel input { accent-color: var(--ddp-color-accent); max-width: 20rem; }
  .nsc-svg { display: block; width: 100%; max-width: 560px; margin: 0 auto; height: auto; background: #fff; border: 1px solid var(--ddp-color-line); border-radius: 6px; }
  .nsc-tree { margin: var(--ddp-space-2) 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); font-family: var(--ddp-font-mono); line-height: 1.45; }
  .nsc-row { padding-top: 0.12rem; padding-bottom: 0.12rem; border-left: 3px solid transparent; overflow-wrap: anywhere; }
  .nsc-row.nsc-on { border-left-color: var(--ddp-color-accent); background: color-mix(in srgb, var(--ddp-color-accent) 9%, transparent); color: var(--ddp-color-primary); }
  .nsc-row.nsc-copy { font-style: italic; }
  .nsc-readout { display: grid; grid-template-columns: 1fr 1fr; gap: var(--ddp-space-2); margin: var(--ddp-space-2) 0; padding: var(--ddp-space-2) var(--ddp-space-3); background: color-mix(in srgb, var(--ddp-color-accent) 8%, transparent); border-radius: 6px; }
  .nsc-readout div { display: flex; flex-direction: column; gap: 0.1rem; }
  .nsc-readout dt { font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .nsc-readout dd { margin: 0; font-family: var(--ddp-font-mono); font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); font-weight: 700; }
  .nsc-count { margin: 0 0 var(--ddp-space-2); font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); line-height: 1.5; }
  .nsc-why { margin: 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); line-height: 1.5; min-height: 4.5em; }
  .nsc-assume { margin: var(--ddp-space-2) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .nsc-foot { margin: var(--ddp-space-2) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); border-left: 3px solid var(--ddp-color-secondary); padding-left: 0.55rem; }
  @media (max-width: 480px) { .nsc-readout { grid-template-columns: 1fr; } }
</style>
