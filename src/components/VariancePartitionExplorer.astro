---
/**
 * VariancePartitionExplorer — many small additive loci plus environment make a bell-shaped
 * trait, and heritability is a ratio of variances in one population in one environment.
 * The learner sets the number of loci, the additive genetic variance (VA) and the
 * environmental variance (VE) in environment A, then a second environment B with its own VE,
 * and sees the same 500 genotypes appear in both. Rules are those of the complex-traits
 * lesson: loci unlinked, one "plus" allele of equal small effect per locus with probability 1/2,
 * effects simply add (VD = VI = 0), VP = VA + VE, h2 = VA / VP. The per-allele effect is not
 * set by hand: it follows from VA and the number of loci. Observed values come from a random
 * sample of 500 people; the expected value is shown beside each. Labelled bars and lines only.
 * Self-contained vanilla-TS Astro island. Original.
 */
---

<figure class="vpe card" data-vpe>
  <figcaption class="vpe-head">Variance partition: genes, environment and heritability<span class="vpe-chip">⚙ original · interactive</span></figcaption>

  <svg class="vpe-svg" viewBox="0 0 360 232" role="img" aria-label="Histogram of a trait in 500 simulated people in two environments, with the expected curves drawn dashed" data-plot></svg>

  <div class="vpe-controls">
    <label class="vpe-slabel"><span>Number of loci <em data-out="n">3</em></span>
      <input type="range" data-in="n" min="1" max="100" step="1" value="3" />
    </label>
    <label class="vpe-slabel"><span>Genetic variance V<sub>A</sub> <em data-out="va">40</em> cm²</span>
      <input type="range" data-in="va" min="5" max="100" step="5" value="40" />
    </label>
    <label class="vpe-slabel"><span>Environment A: V<sub>E</sub> <em data-out="vea">50</em> cm²</span>
      <input type="range" data-in="vea" min="0" max="100" step="5" value="50" />
    </label>
    <label class="vpe-slabel"><span>Environment B: V<sub>E</sub> <em data-out="veb">20</em> cm²</span>
      <input type="range" data-in="veb" min="0" max="100" step="5" value="20" />
    </label>
  </div>
  <div class="vpe-actions">
    <button type="button" class="vpe-btn" data-resample>Resample 500 people</button>
    <span class="vpe-note" data-draw>Sample 1</span>
    <span class="vpe-note" data-eff></span>
  </div>

  <table class="vpe-table">
    <caption class="vpe-cap">Observed in this sample, with the expected value from the rule beside it</caption>
    <thead>
      <tr><th scope="col"></th><th scope="col">V<sub>A</sub> obs / exp</th><th scope="col">V<sub>E</sub> obs / exp</th><th scope="col">V<sub>P</sub> obs / exp</th><th scope="col">h² obs / exp</th></tr>
    </thead>
    <tbody data-rows></tbody>
  </table>

  <p class="vpe-why" data-why role="status"></p>

  <p class="vpe-foot">Heritability is a ratio of variances in one population in one environment: change V<sub>E</sub> and h² changes although no DNA did. Here every effect is additive (V<sub>D</sub> = V<sub>I</sub> = 0), so h² = V<sub>A</sub>/V<sub>P</sub>. Unlike the lesson’s worked problem, V<sub>D</sub> = 0 here, so the numbers differ. In this sketch every locus has the same effect, each allele is a plus allele with probability 1/2, loci are unlinked and the environmental effect is bell-shaped; real effects are unequal. This is a sketch of the logic, not a model of a real trait.</p>
</figure>

<script>
  const NS = 'http://www.w3.org/2000/svg';
  const TEAL = '#0e7c86', ORANGE = '#e57200', INK = '#4b4b55', FAINT = '#b9b9c2';
  const N = 500;
  const MAXL = 100; // alleles drawn per person = 2 * MAXL; the first 2n are used
  const LO = -50, HI = 50, BIN = 2.5, NB = (HI - LO) / BIN;

  function el(name: string, attrs: Record<string, string | number>, text?: string): SVGElement {
    const e = document.createElementNS(NS, name);
    for (const k in attrs) e.setAttribute(k, String(attrs[k]));
    if (text !== undefined) e.textContent = text;
    return e;
  }
  function mulberry(seed: number) {
    let a = seed >>> 0;
    return () => {
      a = (a + 0x6d2b79f5) >>> 0;
      let t = a;
      t = Math.imul(t ^ (t >>> 15), t | 1);
      t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }
  function erf(x: number) {
    const s = x < 0 ? -1 : 1; x = Math.abs(x);
    const t = 1 / (1 + 0.3275911 * x);
    const y = 1 - (((((1.061405429 * t - 1.453152027) * t) + 1.421413741) * t - 0.284496736) * t + 0.254829592) * t * Math.exp(-x * x);
    return s * y;
  }
  const cdf = (x: number, sd: number) => (sd < 1e-9 ? (x >= 0 ? 1 : 0) : 0.5 * (1 + erf(x / (sd * Math.SQRT2))));
  function logChoose(n: number, k: number) {
    let s = 0; for (let i = 1; i <= k; i++) s += Math.log((n - k + i) / i); return s;
  }
  const mean = (v: number[]) => v.reduce((s, x) => s + x, 0) / v.length;
  const variance = (v: number[]) => { const m = mean(v); return v.reduce((s, x) => s + (x - m) * (x - m), 0) / v.length; };
  const f = (x: number, d = 1) => x.toFixed(d);

  document.querySelectorAll<HTMLElement>('[data-vpe]').forEach((root) => {
    const plot = root.querySelector<SVGSVGElement>('[data-plot]')!;
    const inp = (k: string) => root.querySelector<HTMLInputElement>(`[data-in="${k}"]`)!;
    const out = (k: string) => root.querySelector<HTMLElement>(`[data-out="${k}"]`)!;
    const rows = root.querySelector<HTMLElement>('[data-rows]')!;
    const why = root.querySelector<HTMLElement>('[data-why]')!;
    const drawLbl = root.querySelector<HTMLElement>('[data-draw]')!;
    let draw = 1;
    let bits = new Uint8Array(N * 2 * MAXL);
    let zA = new Float64Array(N), zB = new Float64Array(N);

    function resample() {
      const rnd = mulberry(1000 + draw * 7919);
      for (let i = 0; i < bits.length; i++) bits[i] = rnd() < 0.5 ? 1 : 0;
      const gauss = () => Math.sqrt(-2 * Math.log(1 - rnd())) * Math.cos(2 * Math.PI * rnd());
      for (let i = 0; i < N; i++) { zA[i] = gauss(); zB[i] = gauss(); }
      drawLbl.textContent = `Sample ${draw}`;
    }

    // expected counts per bin: genotype ~ Binomial(2n, 1/2), then normal environment
    function expected(n: number, a: number, ve: number): number[] {
      const L = 2 * n, sd = Math.sqrt(ve), out = new Array(NB).fill(0);
      for (let k = 0; k <= L; k++) {
        const pk = Math.exp(logChoose(L, k) - L * Math.LN2);
        const g = a * (k - n);
        for (let b = 0; b < NB; b++) {
          const lo = LO + b * BIN, hi = lo + BIN;
          const lower = b === 0 ? 0 : cdf(lo - g, sd);
          const upper = b === NB - 1 ? 1 : cdf(hi - g, sd);
          out[b] += N * pk * (upper - lower);
        }
      }
      return out;
    }
    function bin(x: number) { return Math.max(0, Math.min(NB - 1, Math.floor((x - LO) / BIN))); }

    function render() {
      const n = parseInt(inp('n').value, 10);
      const va = parseInt(inp('va').value, 10);
      const vea = parseInt(inp('vea').value, 10);
      const veb = parseInt(inp('veb').value, 10);
      out('n').textContent = String(n);
      out('va').textContent = String(va);
      out('vea').textContent = String(vea);
      out('veb').textContent = String(veb);
      // each locus has 2 alleles, each "plus" with prob 1/2 and equal effect a: VA = 2n * a^2 / 4
      const a = Math.sqrt((2 * va) / n);

      const g: number[] = [];
      for (let i = 0; i < N; i++) {
        let k = 0; const off = i * 2 * MAXL;
        for (let j = 0; j < 2 * n; j++) k += bits[off + j];
        g.push(a * (k - n));
      }
      const pA = g.map((x, i) => x + Math.sqrt(vea) * zA[i]);
      const pB = g.map((x, i) => x + Math.sqrt(veb) * zB[i]);
      const mg = mean(g);
      const vgObs = variance(g);
      const eA = pA.map((x, i) => x - g[i]), eB = pB.map((x, i) => x - g[i]);
      const stats = [
        { name: 'Environment A', color: TEAL, vp: variance(pA), ve: variance(eA), vee: vea },
        { name: 'Environment B', color: ORANGE, vp: variance(pB), ve: variance(eB), vee: veb },
      ].map((s) => ({ ...s, h: vgObs / s.vp, he: va / (va + s.vee), vpe: va + s.vee }));

      // histograms
      const cA = new Array(NB).fill(0), cB = new Array(NB).fill(0);
      pA.forEach((x) => cA[bin(x - mg)]++);
      pB.forEach((x) => cB[bin(x - mg)]++);
      const xA = expected(n, a, vea), xB = expected(n, a, veb);
      const ymaxRaw = Math.max(...cA, ...cB, ...xA, ...xB) * 1.1;
      const step = ymaxRaw > 120 ? 50 : ymaxRaw > 50 ? 20 : ymaxRaw > 24 ? 10 : 5;
      const ymax = Math.ceil(ymaxRaw / step) * step;

      const X0 = 40, X1 = 350, Y0 = 18, Y1 = 178;
      const px = (x: number) => X0 + ((x - LO) / (HI - LO)) * (X1 - X0);
      const py = (c: number) => Y1 - (c / ymax) * (Y1 - Y0);
      plot.replaceChildren();
      plot.appendChild(el('rect', { x: 0, y: 0, width: 360, height: 232, fill: '#fff' }));
      plot.appendChild(el('line', { x1: X0, y1: Y0, x2: X0, y2: Y1, stroke: INK, 'stroke-width': 1 }));
      plot.appendChild(el('line', { x1: X0, y1: Y1, x2: X1, y2: Y1, stroke: INK, 'stroke-width': 1 }));
      for (let c = 0; c <= ymax; c += step) {
        plot.appendChild(el('line', { x1: X0, y1: py(c), x2: X1, y2: py(c), stroke: FAINT, 'stroke-width': 0.6, 'stroke-dasharray': '2 3' }));
        plot.appendChild(el('text', { x: X0 - 4, y: py(c) + 3, 'text-anchor': 'end', 'font-size': 9, fill: INK }, String(c)));
      }
      for (const x of [-50, -25, 0, 25, 50]) {
        plot.appendChild(el('line', { x1: px(x), y1: Y1, x2: px(x), y2: Y1 + 3, stroke: INK, 'stroke-width': 1 }));
        plot.appendChild(el('text', { x: px(x), y: Y1 + 13, 'text-anchor': 'middle', 'font-size': 9, fill: INK }, (x > 0 ? '+' : '') + x));
      }
      plot.appendChild(el('text', { x: (X0 + X1) / 2, y: Y1 + 26, 'text-anchor': 'middle', 'font-size': 10, fill: INK }, 'trait, difference from the genotype mean (cm)'));
      plot.appendChild(el('text', { x: X0 - 2, y: Y0 - 6, 'font-size': 10, fill: INK }, 'people (of 500)'));

      // environment A observed: filled bars
      for (let b = 0; b < NB; b++) {
        if (cA[b] === 0) continue;
        plot.appendChild(el('rect', { x: px(LO + b * BIN) + 0.4, y: py(cA[b]), width: (X1 - X0) / NB - 0.8, height: Y1 - py(cA[b]), fill: TEAL, opacity: 0.45 }));
      }
      const path = (c: number[]) => c.map((v, b) => `${b === 0 ? 'M' : 'L'}${f(px(LO + (b + 0.5) * BIN), 1)} ${f(py(v), 1)}`).join(' ');
      // environment B observed: solid orange line; expected: dashed
      plot.appendChild(el('path', { d: path(cB), fill: 'none', stroke: ORANGE, 'stroke-width': 1.8 }));
      plot.appendChild(el('path', { d: path(xA), fill: 'none', stroke: '#0a5a62', 'stroke-width': 1.3, 'stroke-dasharray': '4 3' }));
      plot.appendChild(el('path', { d: path(xB), fill: 'none', stroke: '#a24f00', 'stroke-width': 1.3, 'stroke-dasharray': '4 3' }));
      // legend, bottom strip
      const ly = Y1 + 41;
      plot.appendChild(el('rect', { x: 40, y: ly - 7, width: 10, height: 8, fill: TEAL, opacity: 0.45 }));
      plot.appendChild(el('text', { x: 54, y: ly, 'font-size': 9, fill: INK }, 'A observed'));
      plot.appendChild(el('line', { x1: 112, y1: ly - 3, x2: 128, y2: ly - 3, stroke: ORANGE, 'stroke-width': 1.8 }));
      plot.appendChild(el('text', { x: 132, y: ly, 'font-size': 9, fill: INK }, 'B observed'));
      plot.appendChild(el('line', { x1: 192, y1: ly - 3, x2: 208, y2: ly - 3, stroke: '#0a5a62', 'stroke-width': 1.3, 'stroke-dasharray': '4 3' }));
      plot.appendChild(el('text', { x: 212, y: ly, 'font-size': 9, fill: INK }, 'A expected'));
      plot.appendChild(el('line', { x1: 270, y1: ly - 3, x2: 286, y2: ly - 3, stroke: '#a24f00', 'stroke-width': 1.3, 'stroke-dasharray': '4 3' }));
      plot.appendChild(el('text', { x: 290, y: ly, 'font-size': 9, fill: INK }, 'B expected'));

      root.querySelector<HTMLElement>('[data-eff]')!.textContent = `each plus allele adds ${f(a, 2)} cm (set by VA and the number of loci, in this sketch)`;
      // table
      rows.replaceChildren();
      stats.forEach((s) => {
        const tr = document.createElement('tr');
        const cells = [
          `<th scope="row" style="color:${s.color === TEAL ? '#0a5a62' : '#a24f00'}">${s.name}</th>`,
          `<td>${f(vgObs)} / ${f(va)}</td>`,
          `<td>${f(s.ve)} / ${f(s.vee)}</td>`,
          `<td>${f(s.vp)} / ${f(s.vpe)}</td>`,
          `<td class="vpe-h">${f(s.h, 2)} / ${f(s.he, 2)}</td>`,
        ];
        tr.innerHTML = cells.join('');
        rows.appendChild(tr);
      });

      // status sentence
      const [A, B] = stats;
      let s = '';
      const loci = n === 1 ? '1 locus' : `${n} loci`;
      if (n <= 5) s += `With ${loci} there are only ${2 * n + 1} genotype classes; with little environmental variance the trait comes in steps, and more loci or more environmental variance blur them toward a curve. `;
      else s += `With ${loci} there are ${2 * n + 1} genotype classes; ` + (vea === 0 && veb === 0 ? 'with no environmental variance the classes stay separate. ' : 'environmental variance blurs them toward a smooth curve. ');
      if (vea === 0) s += 'With no environmental variance in A, all the variation is genetic and h² = 1. ';
      if (veb === vea) s += vea === 0 ? 'Both environments have no environmental variance, so the two are identical. ' : `Both environments have V<sub>E</sub> = ${vea}, so the expected h² is the same, ${f(A.he, 2)}; the observed values differ only by chance, since the environmental scatter is redrawn. `;
      else if (veb < vea) s += `The same genotypes in environment B have less environmental variance: expected h² rises from ${f(A.he, 2)} to ${f(B.he, 2)} (V<sub>A</sub>/(V<sub>A</sub>+V<sub>E</sub>)) although no DNA changed. `;
      else s += `The same genotypes in environment B have more environmental variance: expected h² falls from ${f(A.he, 2)} to ${f(B.he, 2)} although no DNA changed. `;
      s += 'Heritability describes this population in this environment, not any one person.';
      why.innerHTML = s;
    }

    ['n', 'va', 'vea', 'veb'].forEach((k) => inp(k).addEventListener('input', render));
    root.querySelector<HTMLButtonElement>('[data-resample]')!.addEventListener('click', () => { draw++; resample(); render(); });
    resample();
    render();
  });
</script>

<style is:global>
  .vpe { padding: var(--ddp-space-3) var(--ddp-space-4) var(--ddp-space-4); margin: var(--ddp-space-5) 0; }
  .vpe-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem; font-weight: 600; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); margin-bottom: var(--ddp-space-3); }
  .vpe-chip { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 400; color: var(--ddp-color-muted); }
  .vpe-svg { display: block; width: 100%; max-width: 600px; margin: 0 auto; height: auto; background: #fff; border: 1px solid var(--ddp-color-line); border-radius: 6px; }
  .vpe-controls { display: grid; grid-template-columns: 1fr 1fr; gap: var(--ddp-space-2) var(--ddp-space-4); margin: var(--ddp-space-3) 0 var(--ddp-space-2); }
  .vpe-slabel { display: flex; flex-direction: column; gap: 0.1rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .vpe-slabel em { font-style: normal; font-weight: 700; color: var(--ddp-color-accent); font-family: var(--ddp-font-mono); }
  .vpe-slabel input { accent-color: var(--ddp-color-accent); }
  .vpe-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem; margin: var(--ddp-space-2) 0; }
  .vpe-btn { border: 1px solid var(--ddp-color-line); border-radius: 5px; background: transparent; color: var(--ddp-color-ink-soft); font-size: var(--ddp-text-xs); padding: 0.3rem 0.6rem; cursor: pointer; }
  .vpe-btn:focus-visible, .vpe-slabel input:focus-visible { outline: 2px solid var(--ddp-color-accent); outline-offset: 2px; }
  .vpe-note { font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); font-family: var(--ddp-font-mono); }
  .vpe-table { width: 100%; border-collapse: collapse; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); margin: var(--ddp-space-2) 0; }
  .vpe-cap { caption-side: top; text-align: left; font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); padding-bottom: 0.25rem; }
  .vpe-table th, .vpe-table td { text-align: left; padding: 0.2rem 0.35rem; border-bottom: 1px solid var(--ddp-color-line); font-family: var(--ddp-font-mono); font-weight: 400; white-space: nowrap; }
  .vpe-table thead th { font-weight: 600; color: var(--ddp-color-muted); }
  .vpe-table tbody th { font-weight: 700; font-family: inherit; white-space: normal; }
  .vpe-h { font-weight: 700; color: var(--ddp-color-primary); }
  .vpe-why { margin: var(--ddp-space-2) 0; padding: var(--ddp-space-2) var(--ddp-space-3); background: color-mix(in srgb, var(--ddp-color-accent) 8%, transparent); border-radius: 6px; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); min-height: 3em; }
  .vpe-foot { margin: var(--ddp-space-3) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); border-left: 3px solid var(--ddp-color-secondary); padding-left: 0.55rem; }
  @media (max-width: 520px) {
    .vpe-controls { grid-template-columns: 1fr; }
    .vpe-table { display: block; overflow-x: auto; }
  }
</style>
