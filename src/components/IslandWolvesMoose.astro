---
/**
 * IslandWolvesMoose — a model island with one predator (wolves) and one prey (moose).
 * Bars show the two populations and a plant-food meter; a line plot follows them over 40
 * years. Controls: starting wolves (0 to 50), how fast moose have calves (low, medium, high),
 * and a one-time harsh winter. A sketch in relative units, computed from a few made-up
 * rules in yearly steps (smooth averages, no individual animals). Original.
 */
---

<figure class="iw card" data-islandwm>
  <figcaption class="iw-head">Model island: wolves and moose<span class="iw-chip">⚙ original · interactive</span></figcaption>

  <svg class="iw-svg" viewBox="0 0 340 190" role="img" aria-label="A model island with a moose bar, a wolf bar and a plant food meter" data-island></svg>

  <div class="iw-controls">
    <label class="iw-slabel"><span>Wolves at the start (relative): <em data-out="wolves">20</em></span>
      <input type="range" data-in="wolves" min="0" max="50" step="1" value="20" />
    </label>
    <fieldset class="iw-calves">
      <legend>How fast moose have calves</legend>
      <label class="iw-opt"><input type="radio" name="iw-calf" value="low" /><span>Low</span></label>
      <label class="iw-opt"><input type="radio" name="iw-calf" value="medium" checked /><span>Medium</span></label>
      <label class="iw-opt"><input type="radio" name="iw-calf" value="high" /><span>High</span></label>
    </fieldset>
  </div>

  <div class="iw-buttons">
    <button type="button" class="iw-btn iw-primary" data-run>Run 40 years</button>
    <button type="button" class="iw-btn" data-winter>Harsh winter next year</button>
    <button type="button" class="iw-btn" data-reset>Reset</button>
    <span class="iw-year" data-yearread>Year 0 of 40</span>
  </div>

  <svg class="iw-svg" viewBox="0 0 340 285" role="img" aria-label="A line plot of moose and wolves over 40 years, each on its own relative scale" data-plot></svg>

  <p class="iw-why" data-why role="status">Press Run. Bars show moose, wolves and plant food at the start.</p>

  <p class="iw-assume">In this sketch: all sizes are relative units, not real counts, and the wolf count can be a fraction. The starting moose, how fast plants grow back, how many moose each wolf catches, how fast wolves gain and lose numbers (which sets how long they lag behind the moose), the calf rates, and a harsh winter taking half the moose in one year are invented. Moose eat the plants. There is no disease and no age groups, and the numbers are smooth averages, not individual animals.</p>
  <p class="iw-foot">Pattern scientists often see: when prey are plentiful, more predators tend to survive. When prey become few, predators can run short of food and fewer may survive, so the prey can recover.</p>
</figure>

<script>
  const NS = 'http://www.w3.org/2000/svg';
  const TEAL = '#0e7c86', ORANGE = '#e57200', GREEN = '#3f8f3f', INK = '#4b4b55', FAINT = '#b9b9c2', BLUE = '#3b5bb5';
  const YEARS = 40;
  const MMAX = 1.0; // moose axis top (relative units)
  const WMAX = 100; // wolf axis top (relative units)
  const CALF: Record<string, number> = { low: 0.3, medium: 0.45, high: 0.6 };
  // Made-up rules for the sketch (relative units, one step per year).
  const P = { d: 0.12, g: 0.35, rf: 0.06, s: 1.2, fs: 0.5, k: 0.17, m0: 0.25, e: 0.7, dw: 0.25, M0: 0.2, hw: 0.5 };

  function el(name: string, attrs: Record<string, string | number>): SVGElement {
    const e = document.createElementNS(NS, name);
    for (const k in attrs) e.setAttribute(k, String(attrs[k]));
    return e;
  }
  function txt(x: number, y: number, s: string, extra: Record<string, string | number> = {}): SVGElement {
    const t = el('text', Object.assign({ x, y, 'font-size': 13, fill: INK }, extra));
    t.textContent = s;
    return t;
  }

  type Series = { M: number[]; W: number[]; F: number[] };
  function simulate(w0: number, b: number, winter: number | null): Series {
    let M = P.M0, W = w0, F = 1;
    const out: Series = { M: [M], W: [W], F: [F] };
    for (let y = 1; y <= YEARS; y++) {
      const N = 20, h = 1 / N;
      for (let i = 0; i < N; i++) {
        const Wn = W / 50;
        const share = (M * M) / (M * M + P.m0 * P.m0);
        const kill = P.k * Wn * share;
        const dM = M * (b * F - P.d - P.s * Math.max(0, P.fs - F)) - kill;
        const dW = W * (P.e * share - P.dw);
        const dF = P.rf * (1 - F) - P.g * M * F;
        M = Math.max(0.001, M + h * dM);
        W = Math.max(0, W + h * dW);
        F = Math.min(1, Math.max(0, F + h * dF));
      }
      if (winter !== null && y === winter) M *= 1 - P.hw;
      out.M.push(M); out.W.push(W); out.F.push(F);
    }
    return out;
  }

  // First clear high point of a line within years 0..upTo: the line must rise above its start,
  // then fall to 90% of that top. Returns the year, or -1.
  function firstPeak(v: number[], upTo: number): number {
    let top = 0;
    for (let y = 1; y <= upTo; y++) {
      if (v[y] > v[top]) top = y;
      if (top >= 1 && v[top] > v[0] * 1.08 && v[y] < v[top] * 0.9) return top;
    }
    return -1;
  }

  document.querySelectorAll<HTMLElement>('[data-islandwm]').forEach((root) => {
    function q<T extends Element>(sel: string): T {
      const e = root.querySelector<T>(sel);
      if (!e) throw new Error('IslandWolvesMoose: missing ' + sel);
      return e;
    }
    const island = q<SVGSVGElement>('[data-island]');
    const plot = q<SVGSVGElement>('[data-plot]');
    const wolvesIn = q<HTMLInputElement>('[data-in="wolves"]');
    const wolvesOut = q<HTMLElement>('[data-out="wolves"]');
    const runBtn = q<HTMLButtonElement>('[data-run]');
    const winterBtn = q<HTMLButtonElement>('[data-winter]');
    const resetBtn = q<HTMLButtonElement>('[data-reset]');
    const yearRead = q<HTMLElement>('[data-yearread]');
    const why = q<HTMLElement>('[data-why]');
    const radios = Array.from(root.querySelectorAll<HTMLInputElement>('input[name="iw-calf"]'));

    let year = 0;
    let winter: number | null = null;
    let timer: number | null = null;
    let cur: Series = simulate(20, CALF.medium, null);
    let ghost: Series | null = null;
    const reduced = typeof window.matchMedia === 'function' && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const calfKey = (): string => {
      const on = radios.find((r) => r.checked);
      return on ? on.value : 'medium';
    };
    const startWolves = () => parseInt(wolvesIn.value, 10) || 0;

    function recompute() {
      const w0 = startWolves(), b = CALF[calfKey()] ?? CALF.medium;
      cur = simulate(w0, b, winter);
      ghost = winter !== null ? simulate(w0, b, null) : null;
    }
    function stop() {
      if (timer !== null) { window.clearInterval(timer); timer = null; }
      why.setAttribute('aria-live', 'polite');
    }
    const playing = () => timer !== null;

    function status(): string {
      const w0 = startWolves();
      if (year === 0) return 'Press Run. Bars show moose, wolves and plant food at the start.';
      const t = year;
      const dM = (cur.M[t] - cur.M[t - 1]) / MMAX, dW = (cur.W[t] - cur.W[t - 1]) / WMAX;
      const tr = (x: number) => (x > 0.012 ? 1 : x < -0.012 ? -1 : 0);
      const mT = tr(dM), wT = tr(dW);
      if (winter !== null && t === winter) return 'In this sketch, a harsh winter lowered moose survival this year.';
      if (w0 === 0) {
        if (t === YEARS && firstPeak(cur.M, t) >= 1) return 'In this sketch, with no wolves, moose grew, ate much of their food, and many can go hungry.';
        if (mT > 0) return cur.F[t] < cur.F[t - 1] ? 'In this sketch, with no wolves, moose numbers climb and the food meter falls.' : 'In this sketch, with no wolves, moose numbers climb.';
        if (mT < 0) return 'In this sketch, moose ate much of their own food, so many can go hungry.';
        return 'In this sketch, moose and plant food are changing slowly now.';
      }
      if (winter !== null && ghost && t > winter) {
        if (cur.W[t] < ghost.W[t] - 0.06 * WMAX) return 'In this sketch, wolves are now fewer than in the run with no harsh winter.';
        if (cur.M[t] < ghost.M[t] - 0.06 * MMAX) return 'In this sketch, the harsh winter left fewer moose than the dotted line shows.';
      }
      if (t === YEARS) {
        const mp = firstPeak(cur.M, t), wp = firstPeak(cur.W, t);
        if (winter === null && mp >= 1 && wp > mp) return 'In this sketch, the wolf line reached its high point after the moose line.';
      }
      if (mT > 0 && wT > 0) return 'In this sketch, moose are plentiful, so more wolves survive and raise pups.';
      if (mT < 0 && wT > 0) return 'In this sketch, more wolves catch more moose, so the moose fall.';
      if (mT < 0 && wT < 0) return 'In this sketch, wolves run short of food as moose become fewer.';
      if (mT > 0 && wT < 0) return 'In this sketch, with fewer wolves hunting, more moose survive and the moose grow.';
      if (mT === 0 && wT > 0) return 'In this sketch, wolves are increasing while the moose stay about the same.';
      if (mT === 0 && wT < 0) return 'In this sketch, wolves are decreasing while the moose stay about the same.';
      if (mT > 0) return 'In this sketch, the moose are growing while the wolves stay about the same.';
      if (mT < 0) return 'In this sketch, the moose are falling while the wolves stay about the same.';
      return 'In this sketch, both lines are changing slowly now.';
    }

    function drawIsland() {
      island.replaceChildren();
      island.appendChild(txt(170, 15, 'Model island (a sketch)', { 'text-anchor': 'middle', 'font-weight': 700 }));
      island.appendChild(el('rect', { x: 6, y: 22, width: 328, height: 160, rx: 50, fill: '#eef6ea', stroke: INK, 'stroke-width': 1.2 }));
      const BASE = 138, H = 100;
      const bar = (x: number, frac: number, color: string, label: string) => {
        island.appendChild(el('rect', { x, y: BASE - H, width: 44, height: H, fill: '#fff', stroke: FAINT, 'stroke-width': 1, 'stroke-dasharray': '3 3' }));
        const h = Math.max(1.5, Math.min(1, frac) * H);
        island.appendChild(el('rect', { x, y: BASE - h, width: 44, height: h, fill: color, stroke: INK, 'stroke-width': 1 }));
        island.appendChild(txt(x + 22, BASE + 20, label, { 'text-anchor': 'middle', 'font-weight': 700 }));
      };
      bar(52, cur.M[year] / MMAX, TEAL, 'Moose');
      bar(130, cur.W[year] / WMAX, ORANGE, 'Wolves');
      // plant food meter
      island.appendChild(txt(265, 68, 'Plant food left', { 'text-anchor': 'middle', 'font-weight': 700 }));
      island.appendChild(el('rect', { x: 215, y: 76, width: 100, height: 22, fill: '#fff', stroke: FAINT, 'stroke-width': 1, 'stroke-dasharray': '3 3' }));
      island.appendChild(el('rect', { x: 215, y: 76, width: Math.max(1.5, cur.F[year] * 100), height: 22, fill: GREEN, stroke: INK, 'stroke-width': 1 }));
      island.appendChild(txt(215, 116, 'empty', { 'text-anchor': 'start' }));
      island.appendChild(txt(315, 116, 'full', { 'text-anchor': 'end' }));
      island.appendChild(txt(265, 172, 'relative units', { 'text-anchor': 'middle' }));
    }

    const X0 = 46, X1 = 326, Y0 = 28, Y1 = 196;
    const px = (y: number) => X0 + (y / YEARS) * (X1 - X0);
    const pyM = (v: number) => Y1 - Math.min(1, v / MMAX) * (Y1 - Y0);
    const pyW = (v: number) => Y1 - Math.min(1, v / WMAX) * (Y1 - Y0);

    function path(v: number[], f: (n: number) => number, upTo: number): string {
      let d = '';
      for (let y = 0; y <= upTo; y++) d += (y === 0 ? 'M' : 'L') + px(y).toFixed(1) + ' ' + f(v[y]).toFixed(1) + ' ';
      return d.trim();
    }

    function drawPlot() {
      plot.replaceChildren();
      plot.appendChild(txt(X0, 14, 'relative size (each line has its own scale)'));
      plot.appendChild(el('line', { x1: X0, y1: Y0, x2: X0, y2: Y1, stroke: INK, 'stroke-width': 1 }));
      plot.appendChild(el('line', { x1: X0, y1: Y1, x2: X1, y2: Y1, stroke: INK, 'stroke-width': 1 }));
      plot.appendChild(txt(X0 - 5, Y0 + 8, 'high', { 'text-anchor': 'end' }));
      plot.appendChild(txt(X0 - 5, Y1, 'low', { 'text-anchor': 'end' }));
      for (const y of [0, 10, 20, 30, 40]) {
        plot.appendChild(el('line', { x1: px(y), y1: Y1, x2: px(y), y2: Y1 + 4, stroke: INK, 'stroke-width': 1 }));
        plot.appendChild(txt(px(y), Y1 + 18, String(y), { 'text-anchor': 'middle' }));
      }
      plot.appendChild(txt((X0 + X1) / 2, Y1 + 36, 'years', { 'text-anchor': 'middle' }));

      // harsh winter marker
      if (winter !== null && winter <= year) {
        plot.appendChild(el('line', { x1: px(winter), y1: Y0, x2: px(winter), y2: Y1, stroke: BLUE, 'stroke-width': 1.4, 'stroke-dasharray': '2 3' }));
        const right = winter > 24;
        plot.appendChild(txt(px(winter) + (right ? -4 : 4), Y0 + 10, 'harsh winter', { 'text-anchor': right ? 'end' : 'start', fill: BLUE, 'font-weight': 700 }));
      }
      // dotted ghost lines: the same run with no harsh winter
      if (ghost && winter !== null && winter <= year) {
        plot.appendChild(el('path', { d: path(ghost.M, pyM, year), fill: 'none', stroke: TEAL, 'stroke-width': 1.6, 'stroke-dasharray': '2 3', opacity: 0.7 }));
        plot.appendChild(el('path', { d: path(ghost.W, pyW, year), fill: 'none', stroke: ORANGE, 'stroke-width': 1.6, 'stroke-dasharray': '2 3', opacity: 0.7 }));
      }
      // the two lines
      plot.appendChild(el('path', { d: path(cur.M, pyM, year), fill: 'none', stroke: TEAL, 'stroke-width': 2.8, 'stroke-linejoin': 'round' }));
      plot.appendChild(el('path', { d: path(cur.W, pyW, year), fill: 'none', stroke: ORANGE, 'stroke-width': 2.8, 'stroke-linejoin': 'round' }));
      // playhead dots
      plot.appendChild(el('circle', { cx: px(year), cy: pyM(cur.M[year]), r: 4.5, fill: TEAL, stroke: '#fff', 'stroke-width': 1.2 }));
      plot.appendChild(el('circle', { cx: px(year), cy: pyW(cur.W[year]), r: 4.5, fill: ORANGE, stroke: '#fff', 'stroke-width': 1.2 }));
      // first high points, once the line has fallen from them
      const diamond = (cx: number, cy: number, color: string) => plot.appendChild(el('path', { d: `M${cx} ${cy - 7} L${cx + 6} ${cy} L${cx} ${cy + 7} L${cx - 6} ${cy} Z`, fill: color, stroke: '#fff', 'stroke-width': 1.5 }));
      const mp = firstPeak(cur.M, year);
      if (mp >= 1) diamond(px(mp), pyM(cur.M[mp]), TEAL);
      const wp = startWolves() > 0 ? firstPeak(cur.W, year) : -1;
      if (wp >= 1) diamond(px(wp), pyW(cur.W[wp]), ORANGE);

      // legend
      const LY = 252;
      plot.appendChild(el('line', { x1: 10, y1: LY - 4, x2: 32, y2: LY - 4, stroke: TEAL, 'stroke-width': 2.8 }));
      plot.appendChild(txt(37, LY, 'moose'));
      plot.appendChild(el('line', { x1: 100, y1: LY - 4, x2: 122, y2: LY - 4, stroke: ORANGE, 'stroke-width': 2.8 }));
      plot.appendChild(txt(127, LY, 'wolves'));
      diamond(200, LY - 4, INK);
      plot.appendChild(txt(210, LY, 'first high point'));
      if (winter !== null) {
        plot.appendChild(el('line', { x1: 10, y1: LY + 20, x2: 32, y2: LY + 20, stroke: INK, 'stroke-width': 1.6, 'stroke-dasharray': '2 3' }));
        plot.appendChild(txt(37, LY + 24, 'dotted: same run with no harsh winter'));
      }
    }

    function render() {
      wolvesOut.textContent = String(startWolves());
      yearRead.textContent = 'Year ' + year + ' of ' + YEARS;
      const done = year >= YEARS;
      runBtn.textContent = playing() ? 'Pause' : done ? 'Run again' : year === 0 ? 'Run 40 years' : 'Resume';
      winterBtn.disabled = winter !== null || done;
      winterBtn.textContent = winter !== null ? 'Harsh winter set for year ' + winter : 'Harsh winter next year';
      drawIsland();
      drawPlot();
      why.textContent = status();
    }

    function tick() {
      if (year < YEARS) year += 1;
      if (year >= YEARS) stop();
      render();
    }
    function startPlay() {
      if (year >= YEARS) year = 0;
      if (reduced) { year = YEARS; render(); return; }
      why.setAttribute('aria-live', 'off');
      timer = window.setInterval(tick, 400);
      render();
    }
    function resetRun() {
      stop();
      year = 0;
      winter = null;
      recompute();
      render();
    }

    runBtn.addEventListener('click', () => {
      if (playing()) { stop(); render(); } else startPlay();
    });
    winterBtn.addEventListener('click', () => {
      if (winter !== null || year >= YEARS) return;
      winter = year + 1;
      recompute();
      render();
    });
    resetBtn.addEventListener('click', () => {
      stop();
      wolvesIn.value = '20';
      const med = radios.find((r) => r.value === 'medium');
      if (med) med.checked = true;
      resetRun();
    });
    wolvesIn.addEventListener('input', resetRun);
    radios.forEach((r) => r.addEventListener('change', resetRun));

    recompute();
    render();
  });
</script>

<style is:global>
  .iw { padding: var(--ddp-space-3) var(--ddp-space-4) var(--ddp-space-4); margin: var(--ddp-space-5) 0; }
  .iw-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem; font-weight: 600; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); margin-bottom: var(--ddp-space-3); }
  .iw-chip { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 400; color: var(--ddp-color-muted); }
  .iw-svg { display: block; width: 100%; max-width: 560px; margin: 0 auto var(--ddp-space-3); height: auto; background: #fff; border: 1px solid var(--ddp-color-line); border-radius: 6px; }
  .iw-controls { display: grid; grid-template-columns: 1fr 1fr; gap: var(--ddp-space-3) var(--ddp-space-4); margin: var(--ddp-space-3) 0; align-items: start; }
  .iw-slabel { display: flex; flex-direction: column; gap: 0.2rem; font-size: var(--ddp-text-sm); color: var(--ddp-color-ink-soft); }
  .iw-slabel em { font-style: normal; font-weight: 700; color: var(--ddp-color-accent); font-family: var(--ddp-font-mono); }
  .iw-slabel input { accent-color: var(--ddp-color-accent); width: 100%; min-height: 44px; margin: 0; }
  .iw-calves { border: 0; padding: 0; margin: 0; min-width: 0; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .iw-calves legend { font-size: var(--ddp-text-sm); color: var(--ddp-color-ink-soft); padding: 0 0 0.2rem; }
  .iw-opt { position: relative; display: inline-flex; }
  .iw-opt input { position: absolute; opacity: 0; inset: 0; width: 100%; height: 100%; margin: 0; cursor: pointer; }
  .iw-opt span { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; min-width: 64px; padding: 0 0.8rem; border: 1px solid var(--ddp-color-line); border-radius: 6px; background: #fff; color: var(--ddp-color-ink-soft); font-size: var(--ddp-text-sm); font-weight: 600; }
  .iw-opt input:checked + span { background: var(--ddp-color-accent); border-color: var(--ddp-color-accent); color: #fff; }
  .iw-opt input:focus-visible + span { outline: 3px solid var(--ddp-color-secondary); outline-offset: 2px; }
  .iw-buttons { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; margin: var(--ddp-space-2) 0 var(--ddp-space-3); }
  .iw-btn { min-height: 44px; padding: 0 1rem; border: 1px solid var(--ddp-color-line); border-radius: 6px; background: #fff; color: var(--ddp-color-ink-soft); font-size: var(--ddp-text-sm); font-weight: 600; cursor: pointer; }
  .iw-btn:hover:not(:disabled) { border-color: var(--ddp-color-accent); }
  .iw-btn:disabled { opacity: 0.55; cursor: default; }
  .iw-btn:focus-visible { outline: 3px solid var(--ddp-color-secondary); outline-offset: 2px; }
  .iw-primary { background: var(--ddp-color-accent); border-color: var(--ddp-color-accent); color: #fff; }
  .iw-year { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-sm); color: var(--ddp-color-muted); margin-left: auto; }
  .iw-why { margin: 0 0 var(--ddp-space-2); font-size: var(--ddp-text-sm); color: var(--ddp-color-ink-soft); line-height: 1.5; min-height: 3em; }
  .iw-assume { margin: var(--ddp-space-2) 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); line-height: 1.5; }
  .iw-foot { margin: var(--ddp-space-3) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); border-left: 3px solid var(--ddp-color-secondary); padding-left: 0.55rem; }
  @media (max-width: 520px) { .iw-controls { grid-template-columns: 1fr; } .iw-year { margin-left: 0; } }
</style>
