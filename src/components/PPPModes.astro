---
/**
 * PPPModes — the regulation companion to the pentose-phosphate pathway map. The PPP is
 * not one fixed route; the cell tunes the balance of its one-way tap (oxidative) and reversible exchange (non-oxidative)
 * branches to whatever it needs most — ribose-5-phosphate for DNA, NADPH for
 * biosynthesis and antioxidant defense, or both, sometimes feeding the leftover carbon
 * back into glycolysis for ATP. Pick a demand and see which branches run, in which
 * direction, and what comes out; a small flow map lights the active arrows (oxidative G6P → Ru5P,
 * non-oxidative R5P ⇄ F6P + G3P, recycling to G6P, or onward to pyruvate). Mode numbers and
 * nicknames match the lesson's list. Self-contained vanilla-TS Astro island. Original.
 */
---

<figure class="ppm card" data-pppmodes>
  <figcaption class="ppm-head">Four modes of the pentose phosphate pathway<span class="ppm-chip">⚙ original · interactive</span></figcaption>

  <div class="ppm-tabs" role="group" aria-label="Cellular demand">
    <button type="button" data-mode="ribose" aria-pressed="false"><b>1</b> Ribose, NADPH already high</button>
    <button type="button" data-mode="both" aria-pressed="true"><b>2</b> 2 NADPH per ribose</button>
    <button type="button" data-mode="nadph" aria-pressed="false"><b>3</b> Need NADPH, not ribose</button>
    <button type="button" data-mode="nadphatp" aria-pressed="false"><b>4</b> Need NADPH + ATP</button>
  </div>

  <svg class="ppm-map" viewBox="0 0 440 172" role="img" aria-label="Flow map of the pentose phosphate pathway: glucose-6-phosphate, ribose-5-phosphate, and the glycolytic intermediates fructose-6-phosphate plus glyceraldehyde-3-phosphate. Lit arrows show which routes run in the selected mode." data-map>
    <defs>
      <marker id="ppm-ar-on" markerWidth="4" markerHeight="4" refX="3" refY="2" orient="auto"><path d="M0,0 L4,2 L0,4 Z" class="ppm-mk-on" /></marker>
      <marker id="ppm-ar-off" markerWidth="4" markerHeight="4" refX="3" refY="2" orient="auto"><path d="M0,0 L4,2 L0,4 Z" class="ppm-mk-off" /></marker>
    </defs>
    <g class="ppm-a" data-a="ox"><path d="M 96 34 L 240 34" /><text x="168" y="12" text-anchor="middle">tap: 2 NADPH + 1 CO₂ per G6P</text></g>
    <g class="ppm-a" data-a="nucl"><path d="M 336 34 L 386 34" /><text x="410" y="38" text-anchor="middle">DNA/</text><text x="410" y="52" text-anchor="middle">RNA</text></g>
    <g class="ppm-a" data-a="fwd"><path d="M 296 52 L 252 108" /></g>
    <g class="ppm-a" data-a="rev"><path d="M 222 108 L 266 52" /></g>
    <text class="ppm-nonox" x="300" y="86">exchange</text>
    <text class="ppm-nonox" x="300" y="99">(reversible)</text>
    <g class="ppm-a" data-a="glyin"><path d="M 60 126 L 144 126" /><text x="100" y="144" text-anchor="middle">from glycolysis</text></g>
    <g class="ppm-a" data-a="recyc"><path d="M 150 114 C 110 96, 60 88, 56 56" /><text x="70" y="76">back to G6P</text></g>
    <g class="ppm-a" data-a="glyout"><path d="M 290 126 L 350 126" /><text x="356" y="122">pyruvate</text><text x="356" y="136">+ ATP</text></g>
    <rect class="ppm-node" x="16" y="18" width="80" height="32" rx="7" /><text class="ppm-nt" x="56" y="39" text-anchor="middle">G6P</text>
    <rect class="ppm-node" x="240" y="18" width="96" height="32" rx="7" /><text class="ppm-nt" x="288" y="39" text-anchor="middle">Ribose-5-P</text>
    <rect class="ppm-node" x="150" y="110" width="140" height="32" rx="7" /><text class="ppm-nt" x="220" y="131" text-anchor="middle">F6P + G3P</text>
    <text class="ppm-foot-t" x="220" y="165" text-anchor="middle" data-map-cap></text>
  </svg>

  <div class="ppm-branches">
    <div class="ppm-branch" data-b-ox><span class="ppm-b-name">Tap (oxidative, one-way)</span><span class="ppm-b-state" data-ox-state>—</span></div>
    <div class="ppm-branch" data-b-non><span class="ppm-b-name">Exchange (non-oxidative, reversible)</span><span class="ppm-b-state" data-non-state>—</span></div>
  </div>

  <dl class="ppm-readout">
    <div><dt>Net output</dt><dd data-r-out>—</dd></div>
    <div><dt>Where you see it</dt><dd data-r-where>—</dd></div>
    <div class="ppm-tally"><dt>Net per batch</dt><dd data-r-tally>—</dd></div>
  </dl>
  <p class="ppm-why" data-why role="status" aria-live="polite">The same enzymes, run forward or backward in different proportions, let one pathway serve four very different cellular needs.</p>

  <div class="ppm-custom" data-custom>
    <span class="ppm-custom-h">Your own demand</span>
    <label>NADPH <input type="number" min="0" max="60" step="1" value="12" data-n /></label>
    <label>ribose-5-P <input type="number" min="0" max="60" step="1" value="0" data-r /></label>
    <output class="ppm-custom-out" data-custom-out aria-live="polite">—</output>
  </div>

  <p class="ppm-foot">The tap (G6PD onward) is one-way; NADP⁺ opens it. The exchange (transketolase, transaldolase) is reversible and runs toward whichever end is being drained.</p>
</figure>

<script>
  type Mode = { ox: string; non: string; out: string; where: string; why: string; tally: string; oxOn: boolean };
  // which arrows on the flow map are lit in each mode, plus a one-line caption under the map
  const ARROWS: Record<string, { on: string[]; cap: string }> = {
    ribose:   { on: ['glyin', 'rev', 'nucl'], cap: 'glycolytic sugars → exchange runs backward → ribose' },
    both:     { on: ['ox', 'nucl'], cap: 'G6P → tap → ribose + 2 NADPH, exchange idle' },
    nadph:    { on: ['ox', 'fwd', 'recyc'], cap: 'exchange runs forward → back to G6P → through the tap again' },
    nadphatp: { on: ['ox', 'fwd', 'glyout'], cap: 'exchange runs forward → on down glycolysis' },
  };
  const MODES: Record<string, Mode> = {
    ribose: { oxOn: false, ox: 'nearly shut (NADPH high, so little NADP⁺ to open it)', non: 'runs backward: F6P + G3P → ribose', out: 'ribose-5-P (no NADPH)',
      tally: '5 G6P + 1 ATP → 6 ribose-5-P',
      where: 'rapidly dividing cells (DNA/RNA synthesis)',
      why: 'When a cell needs ribose for nucleotides but not reducing power, it keeps the tap nearly shut, because NADPH is already high, and runs the exchange BACKWARD, building ribose-5-phosphate out of glycolytic fructose-6-phosphate and glyceraldehyde-3-phosphate.' },
    both: { oxOn: true, non: 'idle', ox: 'runs', out: '2 NADPH + ribose-5-P',
      tally: '1 G6P → 1 ribose-5-P + 2 NADPH + 1 CO₂',
      where: 'cells balancing growth and biosynthesis',
      why: 'When the cell wants 2 NADPH for every ribose — the tap\'s own fixed ratio — the tap alone does the job: one G6P gives 2 NADPH, 1 CO₂ and, through the isomerase, one ribose-5-phosphate. The exchange sits idle.' },
    nadph: { oxOn: true, non: 'runs forward: ribose → F6P + G3P', ox: 'runs hard (NADP⁺ high)',
      tally: '6 G6P through the tap, 5 back: net 1 G6P → 12 NADPH + 6 CO₂',
      out: 'lots of NADPH (carbon recycled to G6P)',
      where: 'liver, adipose, lactating mammary (making fat)',
      why: 'When the cell wants maximum NADPH and little ribose, the tap runs hard and the exchange converts the leftover ribose-5-phosphate into fructose-6-phosphate and glyceraldehyde-3-phosphate. Those are turned back into glucose-6-phosphate (phosphoglucose isomerase, plus gluconeogenic steps for G3P), which goes through the tap again — squeezing out NADPH without piling up ribose.' },
    nadphatp: { oxOn: true, non: 'runs forward: ribose → F6P + G3P', ox: 'runs',
      tally: '3 G6P → 6 NADPH + 3 CO₂ + 5 pyruvate + 5 NADH + 8 ATP',
      out: 'NADPH + ATP (carbon to pyruvate)',
      where: 'cells needing both reducing power and energy',
      why: 'When both NADPH and ATP are needed, the tap makes NADPH and the exchange funnels the carbon into fructose-6-phosphate and glyceraldehyde-3-phosphate, which continue down glycolysis to pyruvate and ATP. Reducing power and energy from one stream.' },
  };

  document.querySelectorAll<HTMLElement>('[data-pppmodes]').forEach((root) => {
    const oxState = root.querySelector<HTMLElement>('[data-ox-state]')!;
    const nonState = root.querySelector<HTMLElement>('[data-non-state]')!;
    const bOx = root.querySelector<HTMLElement>('[data-b-ox]')!;
    const bNon = root.querySelector<HTMLElement>('[data-b-non]')!;
    const arrows = root.querySelectorAll<SVGGElement>('[data-a]');
    const mapCap = root.querySelector<SVGTextElement>('[data-map-cap]')!;
    const out = root.querySelector<HTMLElement>('[data-r-out]')!;
    const where = root.querySelector<HTMLElement>('[data-r-where]')!;
    const why = root.querySelector<HTMLElement>('[data-why]')!;
    const tally = root.querySelector<HTMLElement>('[data-r-tally]')!;
    function render(key: string) {
      const m = MODES[key];
      oxState.textContent = m.ox;
      nonState.textContent = m.non;
      bOx.classList.toggle('is-on', m.oxOn);
      bOx.classList.toggle('is-off', !m.oxOn);
      const nonOn = m.non !== 'idle';
      bNon.classList.toggle('is-on', nonOn);
      bNon.classList.toggle('is-off', !nonOn);
      const lit = ARROWS[key];
      arrows.forEach((g) => g.classList.toggle('is-on', lit.on.includes(g.dataset.a!)));
      mapCap.textContent = lit.cap;
      out.textContent = m.out; where.textContent = m.where; why.textContent = m.why; tally.textContent = m.tally;
    }
    root.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((b) =>
      b.addEventListener('click', () => {
        root.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        render(b.getAttribute('data-mode')!);
      }));
    render('both');

    // Custom demand: n NADPH and r ribose-5-P → tap runs n/2 times; the exchange
    // runs forward (n/2 − r)/3 turns (negative = backward), as in the lesson's Going deeper.
    const nIn = root.querySelector<HTMLInputElement>('[data-n]')!;
    const rIn = root.querySelector<HTMLInputElement>('[data-r]')!;
    const cOut = root.querySelector<HTMLOutputElement>('[data-custom-out]')!;
    const fmt = (x: number) => (Number.isInteger(x) ? String(x) : x.toFixed(2).replace(/0+$/, ''));
    function custom() {
      const n = Math.max(0, Number(nIn.value) || 0);
      const r = Math.max(0, Number(rIn.value) || 0);
      const tap = n / 2;
      const ex = (tap - r) / 3;
      const dir = ex > 0 ? 'forward' : ex < 0 ? 'backward' : 'idle';
      cOut.textContent = `tap runs ${fmt(tap)}× · exchange ${dir}${ex === 0 ? '' : ` ${fmt(Math.abs(ex))} turn${Math.abs(ex) === 1 ? '' : 's'}`}`;
    }
    nIn.addEventListener('input', custom);
    rIn.addEventListener('input', custom);
    custom();
  });
</script>

<style>
  .ppm { padding: var(--ddp-space-3) var(--ddp-space-4) var(--ddp-space-4); margin: var(--ddp-space-5) 0; }
  .ppm-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem; font-weight: 600; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); margin-bottom: var(--ddp-space-2); }
  .ppm-chip { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 400; color: var(--ddp-color-muted); }
  .ppm-tabs { display: flex; flex-wrap: wrap; gap: 0.3rem; margin-bottom: var(--ddp-space-3); }
  .ppm-tabs button { font-family: inherit; font-size: var(--ddp-text-xs); border: 1px solid var(--ddp-color-line); background: #fff; color: var(--ddp-color-ink-soft); border-radius: 5px; padding: 0.28rem 0.6rem; cursor: pointer; }
  .ppm-tabs button:hover { border-color: var(--ddp-color-accent); color: var(--ddp-color-primary); }
  .ppm-tabs button[aria-pressed='true'] { background: color-mix(in srgb, var(--ddp-color-accent) 14%, #fff); color: var(--ddp-color-primary); font-weight: 700; border-color: var(--ddp-color-accent); }
  .ppm-tabs button b { font-family: var(--ddp-font-mono); margin-right: 0.25rem; color: var(--ddp-color-accent); }
  .ppm-map { width: 100%; max-width: 560px; height: auto; display: block; margin: 0 auto var(--ddp-space-3); background: color-mix(in srgb, var(--ddp-color-accent) 4%, #fff); border: 1px solid var(--ddp-color-line); border-radius: 8px; }
  .ppm-node { fill: #fff; stroke: var(--ddp-color-primary); stroke-width: 1.5; }
  .ppm-nt { font-size: 13px; font-weight: 700; fill: var(--ddp-color-primary); }
  .ppm-a path { fill: none; stroke: var(--ddp-color-line); stroke-width: 2; stroke-dasharray: 4 4; marker-end: url(#ppm-ar-off); transition: stroke 0.25s ease; }
  .ppm-a text { font-size: 11px; fill: var(--ddp-color-muted); }
  .ppm-a.is-on path { stroke: var(--ddp-color-accent); stroke-width: 3.5; stroke-dasharray: none; marker-end: url(#ppm-ar-on); }
  .ppm-a.is-on text { fill: var(--ddp-color-primary); font-weight: 700; }
  .ppm-mk-on { fill: var(--ddp-color-accent); }
  .ppm-mk-off { fill: var(--ddp-color-line); }
  .ppm-nonox { font-size: 10.5px; fill: var(--ddp-color-ink-soft); font-style: italic; }
  .ppm-foot-t { font-size: 11px; fill: var(--ddp-color-ink-soft); }
  @media (prefers-reduced-motion: reduce) { .ppm-a path { transition: none; } }
  .ppm-branches { display: grid; grid-template-columns: 1fr 1fr; gap: var(--ddp-space-2); margin-bottom: var(--ddp-space-2); }
  .ppm-branch { border: 1px solid var(--ddp-color-line); border-left: 3px solid var(--ddp-color-muted); border-radius: 6px; padding: var(--ddp-space-2) var(--ddp-space-3); display: flex; flex-direction: column; gap: 0.15rem; }
  .ppm-branch.is-on { border-left-color: var(--ddp-color-accent); background: color-mix(in srgb, var(--ddp-color-accent) 8%, #fff); }
  .ppm-branch.is-off { opacity: 0.6; }
  .ppm-branch.is-off .ppm-b-state { color: var(--ddp-color-muted); }
  .ppm-b-name { font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .ppm-b-state { font-size: var(--ddp-text-sm); font-weight: 700; color: var(--ddp-color-primary); }
  .ppm-readout { display: grid; grid-template-columns: 1fr 1fr; gap: var(--ddp-space-2); margin: var(--ddp-space-2) 0; padding: var(--ddp-space-2) var(--ddp-space-3); background: color-mix(in srgb, var(--ddp-color-accent) 8%, transparent); border-radius: 6px; }
  .ppm-readout div { display: flex; flex-direction: column; gap: 0.1rem; }
  .ppm-readout dt { font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .ppm-readout dd { margin: 0; font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); color: var(--ddp-color-primary); font-weight: 700; }
  .ppm-readout .ppm-tally { grid-column: 1 / -1; }
  .ppm-custom { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem 0.8rem; margin: var(--ddp-space-3) 0 0; padding: var(--ddp-space-2) var(--ddp-space-3); border: 1px dashed var(--ddp-color-line); border-radius: 6px; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .ppm-custom-h { font-weight: 700; color: var(--ddp-color-primary); }
  .ppm-custom input { width: 4.2em; font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); padding: 0.15rem 0.3rem; border: 1px solid var(--ddp-color-line); border-radius: 4px; }
  .ppm-custom-out { font-family: var(--ddp-font-mono); font-weight: 700; color: var(--ddp-color-primary); }
  .ppm-why { margin: 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); line-height: 1.5; min-height: 3.6em; }
  .ppm-foot { margin: var(--ddp-space-3) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); border-left: 3px solid var(--ddp-color-secondary); padding-left: 0.55rem; }
</style>
