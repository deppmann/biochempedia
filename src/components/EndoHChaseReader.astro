---
/**
 * EndoHChaseReader — read an Endo H pulse-chase gel the way the secretory-pathway lesson does.
 * One control (chase time, over the lesson's four time points: 0, 15, 30, 60 min) moves a
 * highlight across the lesson's illustrative table (resistant and sensitive bands, each pair
 * summing to 1,000). The two bands are drawn as gel rectangles, fraction resistant is plotted
 * against time, and the readout repeats the lesson's arithmetic: k = -ln S / t at the chosen
 * time, then t1/2 = ln 2 / k. Nothing is random, so there is nothing to resample: the
 * observed points are the table, and the dashed curve is the single first-order step the
 * lesson fits to them. Only the lesson's times and numbers. Self-contained vanilla-TS Astro
 * island. Original.
 */
---

<figure class="eh card" data-endoh>
  <figcaption class="eh-head">Endo H time course: reading the half-time<span class="eh-chip">⚙ original · interactive</span></figcaption>

  <svg class="eh-svg" viewBox="0 0 360 150" role="img" aria-label="Four gel lanes at 0, 15, 30 and 60 minutes of chase, each with a resistant band above and a sensitive band below" data-gel></svg>
  <svg class="eh-svg" viewBox="0 0 360 200" role="img" aria-label="Fraction of the glycoprotein that is Endo H resistant plotted against chase time, with a first-order curve" data-plot></svg>

  <label class="eh-slabel"><span>Chase time <em data-out>15 min</em></span>
    <input type="range" min="0" max="3" step="1" value="1" data-in aria-describedby="eh-ticks" />
  </label>
  <div class="eh-ticks" id="eh-ticks" aria-hidden="true"><span>0</span><span>15</span><span>30</span><span>60</span></div>

  <dl class="eh-readout">
    <div><dt>Resistant : sensitive</dt><dd data-r-pair></dd></div>
    <div><dt>Fraction resistant</dt><dd data-r-frac></dd></div>
    <div><dt>Fraction still sensitive, S</dt><dd data-r-s></dd></div>
    <div><dt>k = −ln S / t</dt><dd data-r-k></dd></div>
    <div class="eh-wide"><dt>Half-time, t½ = ln 2 / k</dt><dd data-r-half></dd></div>
  </dl>
  <p class="eh-arith" data-arith></p>
  <p class="eh-why" data-why role="status"></p>

  <p class="eh-foot">Endo H cuts high-mannose glycans but not the complex glycans made after GlcNAc transferase I and mannosidase II have acted, so the resistant band times arrival at those Golgi enzymes. These data are illustrative, each pair sums to 1,000 if nothing is secreted or degraded, and the picture is a sketch of the logic.</p>
</figure>

<script>
  const NS = 'http://www.w3.org/2000/svg';
  const ACCENT = '#0e7c86', ORANGE = '#e57200', INK = '#4b4b55', FAINT = '#b9b9c2', BAND = '#2b2b33';
  // The lesson's table (illustrative); each pair sums to 1,000.
  const TIMES = [0, 15, 30, 60];
  const RES = [0, 330, 550, 800];
  const SEN = [1000, 670, 450, 200];
  const K = 0.0267;               // the lesson's single first-order constant, per minute
  const HALF = 26;                // the lesson's half-time, minutes
  const fmt = (n: number) => n.toLocaleString('en-US');
  function el(name: string, attrs: Record<string, string | number>, text?: string): SVGElement {
    const e = document.createElementNS(NS, name);
    for (const k in attrs) e.setAttribute(k, String(attrs[k]));
    if (text !== undefined) e.textContent = text;
    return e;
  }
  document.querySelectorAll<HTMLElement>('[data-endoh]').forEach((root) => {
    const gel = root.querySelector<SVGSVGElement>('[data-gel]')!;
    const plot = root.querySelector<SVGSVGElement>('[data-plot]')!;
    const inp = root.querySelector<HTMLInputElement>('[data-in]')!;
    const out = root.querySelector<HTMLElement>('[data-out]')!;
    const q = (s: string) => root.querySelector<HTMLElement>(s)!;
    const rPair = q('[data-r-pair]'), rFrac = q('[data-r-frac]'), rS = q('[data-r-s]'), rK = q('[data-r-k]'), rHalf = q('[data-r-half]');
    const arith = q('[data-arith]'), why = q('[data-why]');

    const LANE_X = [150, 200, 250, 300];

    function drawGel(i: number) {
      gel.replaceChildren();
      gel.appendChild(el('text', { x: 8, y: 14, 'font-size': 9, fill: INK }, 'chase (min)'));
      gel.appendChild(el('text', { x: 112, y: 54, 'font-size': 9, 'text-anchor': 'end', 'font-weight': 700, fill: INK }, 'resistant'));
      gel.appendChild(el('text', { x: 112, y: 65, 'font-size': 9, 'text-anchor': 'end', fill: INK }, 'not cut'));
      gel.appendChild(el('text', { x: 112, y: 102, 'font-size': 9, 'text-anchor': 'end', 'font-weight': 700, fill: INK }, 'sensitive'));
      gel.appendChild(el('text', { x: 112, y: 113, 'font-size': 9, 'text-anchor': 'end', fill: INK }, 'cut, runs faster'));
      TIMES.forEach((t, j) => {
        const cx = LANE_X[j], on = j === i;
        gel.appendChild(el('rect', { x: cx - 22, y: 20, width: 44, height: 108, rx: 4, fill: on ? '#e7f3f4' : '#f6f6f8', stroke: on ? ACCENT : FAINT, 'stroke-width': on ? 2 : 1 }));
        gel.appendChild(el('text', { x: cx, y: 14, 'font-size': 10, 'text-anchor': 'middle', 'font-weight': on ? 700 : 400, fill: on ? ACCENT : INK }, String(t)));
        // resistant band (upper) and sensitive band (lower): darkness is proportional to the count
        if (RES[j] > 0) gel.appendChild(el('rect', { x: cx - 16, y: 42, width: 32, height: 12, rx: 2, fill: BAND, opacity: (0.1 + 0.9 * RES[j] / 1000).toFixed(2) }));
        if (SEN[j] > 0) gel.appendChild(el('rect', { x: cx - 16, y: 90, width: 32, height: 12, rx: 2, fill: BAND, opacity: (0.1 + 0.9 * SEN[j] / 1000).toFixed(2) }));
        gel.appendChild(el('text', { x: cx, y: 71, 'font-size': 9, 'text-anchor': 'middle', fill: INK }, fmt(RES[j])));
        gel.appendChild(el('text', { x: cx, y: 120, 'font-size': 9, 'text-anchor': 'middle', fill: INK }, fmt(SEN[j])));
      });
      gel.appendChild(el('text', { x: 180, y: 144, 'font-size': 9, 'text-anchor': 'middle', fill: INK }, 'band darkness rises with the count (sketch; band placement is a sketch)'));
    }

    const X0 = 46, X1 = 338, Y0 = 22, Y1 = 158, TMAX = 60;
    const px = (t: number) => X0 + (t / TMAX) * (X1 - X0);
    const py = (f: number) => Y1 - f * (Y1 - Y0);

    function drawPlot(i: number) {
      plot.replaceChildren();
      plot.appendChild(el('line', { x1: X0, y1: Y0, x2: X0, y2: Y1, stroke: INK, 'stroke-width': 1 }));
      plot.appendChild(el('line', { x1: X0, y1: Y1, x2: X1, y2: Y1, stroke: INK, 'stroke-width': 1 }));
      for (const f of [0, 0.5, 1]) {
        if (f > 0) plot.appendChild(el('line', { x1: X0, y1: py(f), x2: X1, y2: py(f), stroke: FAINT, 'stroke-width': 0.7, 'stroke-dasharray': '2 3' }));
        plot.appendChild(el('text', { x: X0 - 4, y: py(f) + 3, 'text-anchor': 'end', 'font-size': 9, fill: INK }, Math.round(f * 100) + '%'));
      }
      for (const t of TIMES) {
        plot.appendChild(el('line', { x1: px(t), y1: Y1, x2: px(t), y2: Y1 + 3, stroke: INK, 'stroke-width': 1 }));
        plot.appendChild(el('text', { x: px(t), y: Y1 + 14, 'text-anchor': 'middle', 'font-size': 9, fill: INK }, String(t)));
      }
      plot.appendChild(el('text', { x: (X0 + X1) / 2, y: Y1 + 28, 'text-anchor': 'middle', 'font-size': 10, fill: INK }, 'chase time (min)'));
      plot.appendChild(el('text', { x: X0 - 2, y: Y0 - 8, 'font-size': 10, fill: INK }, 'fraction Endo H resistant'));
      // the lesson's single first-order step: fraction resistant = 1 - e^(-kt)
      let d = '';
      for (let t = 0; t <= TMAX; t += 1) d += (t === 0 ? 'M' : 'L') + px(t).toFixed(1) + ' ' + py(1 - Math.exp(-K * t)).toFixed(1) + ' ';
      plot.appendChild(el('path', { d: d.trim(), fill: 'none', stroke: FAINT, 'stroke-width': 1.8, 'stroke-dasharray': '4 3' }));
      // half-time marker from the lesson's k
      if (i > 0) {
        plot.appendChild(el('line', { x1: X0, y1: py(0.5), x2: px(HALF), y2: py(0.5), stroke: ORANGE, 'stroke-width': 1.1, 'stroke-dasharray': '3 2' }));
        plot.appendChild(el('line', { x1: px(HALF), y1: py(0.5), x2: px(HALF), y2: Y1, stroke: ORANGE, 'stroke-width': 1.1, 'stroke-dasharray': '3 2' }));
        plot.appendChild(el('text', { x: px(HALF) + 4, y: Y1 - 6, 'font-size': 9, 'font-weight': 700, fill: ORANGE }, 't½ = ' + HALF + ' min'));
      }
      // observed points (the table)
      TIMES.forEach((t, j) => {
        const f = RES[j] / 1000, on = j === i;
        plot.appendChild(el('circle', { cx: px(t), cy: py(f), r: on ? 6 : 4, fill: on ? ACCENT : '#fff', stroke: ACCENT, 'stroke-width': 2 }));
      });
      const fx = px(TIMES[i]), fy = py(RES[i] / 1000);
      const right = i === 3;
      plot.appendChild(el('text', { x: right ? fx - 9 : fx + 9, y: fy - 8, 'text-anchor': right ? 'end' : 'start', 'font-size': 10, 'font-weight': 700, fill: ACCENT }, Math.round(RES[i] / 10) + '% resistant'));
      // legend, in the empty upper-left of the plot
      plot.appendChild(el('circle', { cx: X0 + 12, cy: Y0 + 8, r: 4, fill: '#fff', stroke: ACCENT, 'stroke-width': 2 }));
      plot.appendChild(el('text', { x: X0 + 22, y: Y0 + 11, 'font-size': 9, fill: INK }, 'observed (the table)'));
      plot.appendChild(el('line', { x1: X0 + 6, y1: Y0 + 24, x2: X0 + 18, y2: Y0 + 24, stroke: FAINT, 'stroke-width': 1.8, 'stroke-dasharray': '4 3' }));
      plot.appendChild(el('text', { x: X0 + 22, y: Y0 + 27, 'font-size': 9, fill: INK }, 'first-order fit, k = 0.0267/min'));
    }

    function render() {
      const i = parseInt(inp.value, 10);
      const t = TIMES[i], r = RES[i], s = SEN[i];
      out.textContent = t + ' min';
      inp.setAttribute('aria-valuetext', t + ' minutes of chase');
      drawGel(i);
      drawPlot(i);
      rPair.textContent = `${fmt(r)} : ${fmt(s)}`;
      rFrac.textContent = Math.round(r / 10) + '%';
      rS.textContent = (s / 1000).toFixed(2);
      if (i === 0) {
        rK.textContent = 'not defined at t = 0';
        rHalf.textContent = 'not defined at t = 0';
        arith.textContent = 'Move the slider past 0: at t = 0, ln S is 0 and there is no time to divide by.';
        why.textContent = 'At 0 min of chase all 1,000 are sensitive: Endo H cuts every glycan, which fits none of the labelled protein having yet met the Golgi enzymes (GlcNAc transferase I and mannosidase II) that make a glycan resistant.';
      } else {
        const sv = s / 1000, k = -Math.log(sv) / t, th = Math.LN2 / k;
        rK.textContent = k.toFixed(4) + ' per min';
        rHalf.textContent = Math.round(th) + ' min';
        arith.textContent = `k = −ln(${sv.toFixed(2)}) / ${t} = ${k.toFixed(4)} per min. The three times (15, 30, 60 min) give 0.0267, 0.0266, 0.0268, so k = ${K} per min and t½ = 0.693 / ${K} = ${HALF} min.`;
        why.textContent = `At ${t} min, ${fmt(r)} of 1,000 are resistant (${Math.round(r / 10)}%): their glycans have been processed by the Golgi enzymes, so Endo H no longer cuts them. ${fmt(s)} are still sensitive and high-mannose. Resistance is a threshold in glycan processing, not a switch between organelles. The half-time of ${HALF} min covers ER exit plus the trip to those enzymes, so it is an upper bound for ER exit alone.`;
      }
    }
    inp.addEventListener('input', render);
    render();
  });
</script>

<style is:global>
  .eh { padding: var(--ddp-space-3) var(--ddp-space-4) var(--ddp-space-4); margin: var(--ddp-space-5) 0; }
  .eh-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem; font-weight: 600; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); margin-bottom: var(--ddp-space-3); }
  .eh-chip { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 400; color: var(--ddp-color-muted); }
  .eh-svg { display: block; width: 100%; max-width: 560px; margin: 0 auto var(--ddp-space-3); height: auto; background: #fff; border: 1px solid var(--ddp-color-line); border-radius: 6px; }
  .eh-slabel { display: flex; flex-direction: column; gap: 0.1rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); max-width: 560px; margin: 0 auto; }
  .eh-slabel em { font-style: normal; font-weight: 700; color: var(--ddp-color-accent); font-family: var(--ddp-font-mono); }
  .eh-slabel input { accent-color: var(--ddp-color-accent); width: 100%; }
  .eh-ticks { display: flex; justify-content: space-between; max-width: 560px; margin: 0 auto; padding: 0 0.4rem; font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .eh-readout { display: grid; grid-template-columns: 1fr 1fr; gap: var(--ddp-space-2); margin: var(--ddp-space-3) 0 var(--ddp-space-2); padding: var(--ddp-space-2) var(--ddp-space-3); background: color-mix(in srgb, var(--ddp-color-accent) 8%, transparent); border-radius: 6px; }
  .eh-readout div { display: flex; flex-direction: column; gap: 0.1rem; }
  .eh-readout .eh-wide { grid-column: 1 / -1; }
  .eh-readout dt { font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .eh-readout dd { margin: 0; font-family: var(--ddp-font-mono); font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); font-weight: 700; }
  .eh-arith { margin: var(--ddp-space-2) 0; font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); line-height: 1.5; min-height: 3em; }
  .eh-why { margin: 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); line-height: 1.5; min-height: 6em; }
  .eh-foot { margin: var(--ddp-space-3) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); border-left: 3px solid var(--ddp-color-secondary); padding-left: 0.55rem; }
  @media (max-width: 520px) { .eh-readout { grid-template-columns: 1fr; } }
</style>
