---
/**
 * OsmoticWorldsBudget — three osmotic worlds on one screen. An osmolality bar for the
 * animal's blood beside one for its water; passive arrows (water by osmosis, salt by
 * diffusion); and the animal's response as labelled block arrows (gills, gut, kidney,
 * rectal gland). Animals: marine teleost, freshwater teleost, elasmobranch (spiny dogfish
 * and relatives). Freshwater teleost: the lesson's worked problem (urine flow x 1.0 kg x
 * 24 h = water gain; urine sodium 10 mmol per L plus gill loss = gill uptake). Elasmobranch:
 * 600 + 350 + 70 = 1,020 mOsm per kg, with a urea switch. A sketch; every number is from
 * the Osmoregulation lesson. Self-contained vanilla-TS Astro island. Original.
 */
---

<figure class="os card" data-osmotic>
  <figcaption class="os-head">Three osmotic worlds — water and sodium budgets<span class="os-chip">⚙ original · interactive</span></figcaption>

  <div class="os-controls">
    <label class="os-slabel"><span>Animal</span>
      <select data-in="animal">
        <option value="marine">Marine teleost (bony fish in the sea)</option>
        <option value="fresh">Freshwater teleost (1.0 kg)</option>
        <option value="elasmo">Elasmobranch (spiny dogfish and relatives)</option>
      </select>
    </label>
    <label class="os-check" data-ctl="urea" hidden><input type="checkbox" data-in="urea" checked /> <span>Plasma urea present (illustrative 350 mOsm per kg)</span></label>
    <label class="os-slabel" data-ctl="flow" hidden><span>Urine flow <em data-out="flow">4.0</em> mL per kg per h <small>(review’s reported range, roughly 1 to 6)</small></span>
      <input type="range" data-in="flow" min="1" max="6" step="0.5" value="4" />
    </label>
    <label class="os-slabel" data-ctl="gill" hidden><span>Gill diffusive sodium loss <em data-out="gill">2.0</em> mmol per day</span>
      <input type="range" data-in="gill" min="0" max="4" step="0.5" value="2" />
    </label>
  </div>

  <svg class="os-svg" viewBox="0 0 360 300" role="img" aria-label="Schematic: an osmolality bar for the animal's blood on the left and for its water on the right, passive arrows for water and salt between them, and labelled block arrows for the animal's response" data-svg></svg>

  <dl class="os-readout">
    <div><dt data-k1></dt><dd data-v1></dd></div>
    <div><dt data-k2></dt><dd data-v2></dd></div>
    <div><dt data-k3></dt><dd data-v3></dd></div>
  </dl>
  <p class="os-why" data-why role="status"></p>
  <p class="os-assume" data-assume></p>

  <p class="os-foot">Rule to keep: water crosses by osmosis toward the side with more dissolved particles and salt moves by diffusion; at steady state a freshwater fish’s osmotic water gain equals its urine volume, and the sodium its gills take up equals its urinary plus gill losses.</p>
</figure>

<script>
  const NS = 'http://www.w3.org/2000/svg';
  const WATER = '#1d5fa8', SALT = '#b45309', ACT = '#0e7c86', INK = '#4b4b55', FAINT = '#b9b9c2';
  function el(name: string, attrs: Record<string, string | number>): SVGElement {
    const e = document.createElementNS(NS, name);
    for (const k in attrs) e.setAttribute(k, String(attrs[k]));
    return e;
  }
  type Dir = 'out' | 'in';

  document.querySelectorAll<HTMLElement>('[data-osmotic]').forEach((root) => {
    const svg = root.querySelector<SVGSVGElement>('[data-svg]');
    const animalIn = root.querySelector<HTMLSelectElement>('[data-in="animal"]');
    const ureaIn = root.querySelector<HTMLInputElement>('[data-in="urea"]');
    const flowIn = root.querySelector<HTMLInputElement>('[data-in="flow"]');
    const gillIn = root.querySelector<HTMLInputElement>('[data-in="gill"]');
    const ureaCtl = root.querySelector<HTMLElement>('[data-ctl="urea"]');
    const flowCtl = root.querySelector<HTMLElement>('[data-ctl="flow"]');
    const gillCtl = root.querySelector<HTMLElement>('[data-ctl="gill"]');
    const flowOut = root.querySelector<HTMLElement>('[data-out="flow"]');
    const gillOut = root.querySelector<HTMLElement>('[data-out="gill"]');
    const why = root.querySelector<HTMLElement>('[data-why]');
    const assume = root.querySelector<HTMLElement>('[data-assume]');
    const k = [1, 2, 3].map((i) => root.querySelector<HTMLElement>(`[data-k${i}]`));
    const v = [1, 2, 3].map((i) => root.querySelector<HTMLElement>(`[data-v${i}]`));
    if (!svg || !animalIn || !ureaIn || !flowIn || !gillIn || !ureaCtl || !flowCtl || !gillCtl || !flowOut || !gillOut || !why || !assume || k.some((x) => !x) || v.some((x) => !x)) return;
    const S = svg;

    const BASE = 250, SC = 0.19; // px per mOsm per kg; 1,100 fills the frame
    const h = (x: number) => x * SC;
    const comma = (n: number) => String(n).replace(/\B(?=(\d{3})+(?!\d))/g, ',');

    function text(x: number, y: number, s: string, opts: Record<string, string | number> = {}) {
      const t = el('text', Object.assign({ x, y, 'font-size': 9, fill: INK, 'text-anchor': 'middle' }, opts));
      t.textContent = s;
      S.appendChild(t);
    }
    function rect(x: number, y: number, w: number, hh: number, fill: string, extra: Record<string, string | number> = {}) {
      S.appendChild(el('rect', Object.assign({ x, y, width: w, height: hh, fill }, extra)));
    }
    // Block arrow: 'out' points right (leaves the animal), 'in' points left (enters it).
    function arrow(x0: number, x1: number, y: number, dir: Dir, color: string, lines: string[], dashed = false) {
      const H = 26, hd = 12, ys = y + 3, ye = y + H - 3;
      const pts = dir === 'out'
        ? [[x0, ys], [x1 - hd, ys], [x1 - hd, y], [x1, y + H / 2], [x1 - hd, y + H], [x1 - hd, ye], [x0, ye]]
        : [[x1, ys], [x0 + hd, ys], [x0 + hd, y], [x0, y + H / 2], [x0 + hd, y + H], [x0 + hd, ye], [x1, ye]];
      S.appendChild(el('polygon', { points: pts.map((p) => p.join(',')).join(' '), fill: color, opacity: dashed ? 0.55 : 1 }));
      const cx = dir === 'out' ? (x0 + x1 - hd) / 2 : (x0 + hd + x1) / 2;
      const y0 = lines.length === 1 ? y + H / 2 + 3 : y + H / 2 - 2;
      lines.forEach((ln, i) => text(cx, y0 + i * 10, ln, { fill: '#fff', 'font-weight': 600 }));
    }
    function block(y: number, label: string) {
      rect(66, y + 1, 60, 24, '#eef3f5', { stroke: ACT, 'stroke-width': 1, rx: 3 });
      const parts = label.split('|');
      const y0 = parts.length === 1 ? y + 16 : y + 11;
      parts.forEach((p, i) => text(96, y0 + i * 10, p, { 'font-weight': 700, fill: '#0b5a62' }));
    }
    function bar(x: number, segs: { from: number; to: number; fill: string; label?: string }[]) {
      rect(x, BASE - h(1100), 50, h(1100), '#fafafb', { stroke: FAINT, 'stroke-width': 1 });
      segs.forEach((s) => {
        rect(x, BASE - h(s.to), 50, h(s.to - s.from), s.fill);
        if (s.label) text(x + 25, BASE - h(s.from) - (h(s.to - s.from) - 9) / 2 - 2, s.label, { fill: '#10222a' });
      });
      S.appendChild(el('line', { x1: x - 3, y1: BASE, x2: x + 53, y2: BASE, stroke: INK, 'stroke-width': 1 }));
    }

    function render() {
      const animal = animalIn!.value;
      const urea = ureaIn!.checked;
      const flow = parseFloat(flowIn!.value);
      const gill = parseFloat(gillIn!.value);
      ureaCtl!.hidden = animal !== 'elasmo';
      flowCtl!.hidden = animal !== 'fresh';
      gillCtl!.hidden = animal !== 'fresh';
      flowOut!.textContent = flow.toFixed(1);
      gillOut!.textContent = gill.toFixed(1);
      S.replaceChildren();

      // headers
      text(35, 30, 'Blood', { 'font-weight': 700 });
      text(327, 30, 'Water', { 'font-weight': 700 });
      text(180, 40, 'Passive: osmosis and diffusion', { 'font-weight': 700, fill: '#2b2b33' });
      text(180, 119, 'The animal’s response', { 'font-weight': 700, fill: '#2b2b33' });
      text(180, 294, 'Arrows pointing right leave the animal; arrows pointing left enter it.', { fill: INK });

      let bl = '', wl = '';
      const water = animal === 'fresh' ? [{ from: 0, to: 10, fill: WATER }] : [{ from: 0, to: 1000, fill: '#7fa9d6' }];

      if (animal === 'marine') {
        bar(8, [{ from: 0, to: 300, fill: '#6fb7bd' }, { from: 300, to: 400, fill: '#bfe0e3' }]);
        bar(302, water);
        bl = 'roughly 300 to 400'; wl = 'about 1,000';
        arrow(66, 294, 46, 'out', WATER, ['water out across the gills', '(osmosis)']);
        arrow(66, 294, 78, 'in', SALT, ['salt in (diffusion)']);
        block(125, 'Gills');
        arrow(134, 294, 125, 'out', ACT, ['monovalent ions (Na⁺, Cl⁻)', 'leave, mostly']);
        block(157, 'Gut');
        arrow(134, 294, 157, 'in', ACT, ['drinks seawater; absorbs', 'water and ions']);
        block(189, 'Gut');
        arrow(134, 294, 189, 'out', ACT, ['most divalent ions leave', 'with the gut fluid']);
        block(221, 'Kidney');
        arrow(134, 294, 221, 'out', ACT, ['absorbed divalent ions:', 'small volume of urine']);
      } else if (animal === 'fresh') {
        bar(8, [{ from: 0, to: 300, fill: '#6fb7bd' }, { from: 300, to: 400, fill: '#bfe0e3' }]);
        bar(302, water);
        bl = 'roughly 300 to 400'; wl = 'usually below 10';
        const ml = flow * 1.0 * 24;
        arrow(66, 294, 46, 'in', WATER, ['water in across the gills (osmosis):', `${ml.toFixed(0)} mL per day at steady state`]);
        arrow(66, 294, 78, 'out', SALT, ['ions diffuse out; gill loss', `${gill.toFixed(1)} mmol sodium per day`]);
        const up = ml / 1000 * 10 + gill;
        block(125, 'Gills');
        arrow(134, 294, 125, 'in', ACT, ['active Na⁺, Cl⁻ uptake (ATP):', `${up.toFixed(2)} mmol Na⁺ per day`]);
        block(157, 'Kidney');
        arrow(134, 294, 157, 'out', ACT, ['large volume of dilute urine:', `${ml.toFixed(0)} mL per day`]);
      } else {
        const ions = 600, ur = urea ? 350 : 0, tm = 70, tot = ions + ur + tm;
        const segs = [{ from: 0, to: ions, fill: '#6fb7bd', label: `ions ${ions}` }];
        if (urea) segs.push({ from: ions, to: ions + ur, fill: '#e8c872', label: `urea ${ur}` });
        segs.push({ from: ions + ur, to: tot, fill: '#b7a6d6', label: `TMAO ${tm}` });
        bar(8, segs);
        bar(302, water);
        bl = `${comma(tot)} (illustrative)`; wl = 'about 1,000';
        if (urea) arrow(66, 294, 46, 'in', WATER, ['water in slowly (osmosis):', '1,020 vs seawater about 1,000']);
        else arrow(66, 294, 46, 'out', WATER, ['water would leave (osmosis):', '670 vs seawater about 1,000']);
        text(180, 95, 'plasma holds less salt than seawater', { fill: INK });
        if (urea) {
          block(125, 'Kidney');
          text(214, 138, 'returns urea to the blood', { fill: INK });
          text(214, 148, 'rather than excreting it', { fill: INK });
          block(157, 'Rectal|gland');
          arrow(134, 294, 157, 'out', ACT, ['secretes concentrated', 'sodium chloride']);
        } else {
          block(125, 'Rectal|gland');
          arrow(134, 294, 125, 'out', ACT, ['secretes concentrated', 'sodium chloride']);
          text(180, 172, 'urea removed: the lesson’s thought experiment', { fill: INK });
        }
      }
      text(4, 264, bl, { 'text-anchor': 'start', 'font-weight': 700, fill: '#2b2b33' });
      text(4, 276, 'mOsm per kg', { 'text-anchor': 'start' });
      text(356, 264, wl, { 'text-anchor': 'end', 'font-weight': 700, fill: '#2b2b33' });
      text(356, 276, 'mOsm per kg', { 'text-anchor': 'end' });

      // readout and status
      let rows: [string, string][] = [];
      let msg = '';
      let asm = 'In this sketch: illustrative values; steady state.';
      if (animal === 'marine') {
        rows = [
          ['Blood of a marine teleost', 'roughly 300 to 400 mOsm per kg, roughly a third of seawater'],
          ['Seawater', 'about 1,000 mOsm per kg'],
          ['Budget', 'no numbers computed for this animal'],
        ];
        msg = 'Marine teleost: its blood is roughly a third as concentrated as seawater, so it loses water across its gills by osmosis and gains salt by diffusion. It drinks seawater and absorbs water, with ions, through its intestine, leaving a salt surplus. Excess monovalent ions such as sodium and chloride leave mostly across the gills; most divalent ions, such as magnesium and sulfate, are never absorbed and leave with the gut fluid, and the share that is absorbed leaves through the kidneys in a small volume of urine. The sodium chloride does not leave mainly in urine.';
      } else if (animal === 'fresh') {
        const ml = flow * 1.0 * 24;
        const uNa = ml / 1000 * 10;
        const tot = uNa + gill;
        const mostly = Math.abs(uNa - gill) < 1e-9 ? 'Here the uptake replaces the urinary loss and the gill leak in equal parts.' : (gill > uNa ? 'Here most of the uptake replaces the gill leak.' : 'Here most of the uptake replaces the urinary loss.');
        rows = [
          ['Urine, and water gain', `${flow.toFixed(1)} × 1.0 × 24 = ${ml.toFixed(0)} mL per day`],
          ['Sodium in urine', `${(ml / 1000).toFixed(3)} L × 10 mmol per L = ${uNa.toFixed(2)} mmol per day`],
          ['Gill uptake needed', `${uNa.toFixed(2)} + ${gill.toFixed(1)} = ${tot.toFixed(2)} mmol per day`],
        ];
        msg = `Freshwater teleost, 1.0 kg, at steady state: urine flow of ${flow.toFixed(1)} mL per kg per hour gives ${ml.toFixed(0)} mL of urine a day, so osmotic water gain across the gills must also be ${ml.toFixed(0)} mL a day. Urine sodium is 10 mmol per L, so ${uNa.toFixed(2)} mmol leaves in urine; with ${gill.toFixed(1)} mmol lost by diffusion across the gills, total loss is ${tot.toFixed(2)} mmol a day, so the gills must take up ${tot.toFixed(2)} mmol of sodium a day, actively, using ATP. ${mostly}`;
        asm = 'In this sketch: illustrative values; steady state; urine is the only route of water loss; food supplies no sodium; body mass 1.0 kg and urine sodium 10 mmol per L are fixed. Urine flow range is the one reported by Takvam and colleagues (2021).';
      } else if (urea) {
        rows = [
          ['Plasma, illustrative', '600 + 350 + 70 = 1,020 mOsm per kg'],
          ['Seawater', 'taken as 1,000 mOsm per kg'],
          ['Direction of water', 'in, slowly: slightly hyperosmotic'],
        ];
        msg = 'Elasmobranch (spiny dogfish and relatives), with urea: illustrative plasma of 600 mOsm per kg of inorganic ions, 350 of urea and 70 of TMAO totals 1,020, against seawater taken as 1,000. The plasma is slightly hyperosmotic, so water enters slowly by osmosis and the shark need not drink seawater. The kidney returns urea to the blood rather than excreting it, the plasma still holds less salt than seawater, and a rectal gland near the end of the gut secretes a concentrated sodium chloride solution.';
      } else {
        rows = [
          ['Plasma without urea', '600 + 70 = 670 mOsm per kg'],
          ['Seawater', 'taken as 1,000 mOsm per kg'],
          ['Direction of water', 'out of the plasma'],
        ];
        msg = 'Elasmobranch (spiny dogfish and relatives), thought experiment with the urea removed: the illustrative total falls to 670 mOsm per kg, well below seawater taken as 1,000, and water would leave by osmosis. This shows what the retained urea does in the lesson’s numbers; it is not a state the lesson describes in a living shark. Elasmobranchs still regulate ions: a rectal gland secretes a concentrated sodium chloride solution.';
      }
      for (let i = 0; i < 3; i++) { k[i]!.textContent = rows[i][0]; v[i]!.textContent = rows[i][1]; }
      why!.textContent = msg;
      assume!.textContent = asm;
    }
    [animalIn, ureaIn, flowIn, gillIn].forEach((c) => {
      c.addEventListener('input', render);
      c.addEventListener('change', render);
    });
    render();
  });
</script>

<style is:global>
  .os { padding: var(--ddp-space-3) var(--ddp-space-4) var(--ddp-space-4); margin: var(--ddp-space-5) 0; }
  .os-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem; font-weight: 600; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); margin-bottom: var(--ddp-space-3); }
  .os-chip { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 400; color: var(--ddp-color-muted); }
  .os-svg { display: block; width: 100%; max-width: 560px; margin: var(--ddp-space-2) auto 0; height: auto; background: #fff; border: 1px solid var(--ddp-color-line); border-radius: 6px; }
  .os-controls { display: grid; grid-template-columns: 1fr 1fr; gap: var(--ddp-space-2) var(--ddp-space-4); margin: 0 0 var(--ddp-space-2); }
  .os-controls [hidden] { display: none; }
  .os-slabel { display: flex; flex-direction: column; gap: 0.15rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .os-slabel small { font-size: inherit; color: var(--ddp-color-muted); }
  .os-slabel em { font-style: normal; font-weight: 700; color: var(--ddp-color-accent); font-family: var(--ddp-font-mono); }
  .os-slabel input, .os-slabel select { accent-color: var(--ddp-color-accent); font: inherit; max-width: 100%; }
  .os-check { display: flex; align-items: center; gap: 0.4rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .os-check input { accent-color: var(--ddp-color-accent); }
  .os-readout { display: grid; grid-template-columns: 1fr; gap: var(--ddp-space-2); margin: var(--ddp-space-3) 0 var(--ddp-space-2); padding: var(--ddp-space-2) var(--ddp-space-3); background: color-mix(in srgb, var(--ddp-color-accent) 8%, transparent); border-radius: 6px; }
  .os-readout div { display: flex; flex-wrap: wrap; gap: 0.1rem 0.6rem; align-items: baseline; }
  .os-readout dt { font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); min-width: 9.5rem; }
  .os-readout dd { margin: 0; font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); color: var(--ddp-color-primary); font-weight: 700; }
  .os-why { margin: 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); line-height: 1.5; min-height: 4.5em; }
  .os-assume { margin: var(--ddp-space-2) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); font-style: italic; }
  .os-foot { margin: var(--ddp-space-3) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); border-left: 3px solid var(--ddp-color-secondary); padding-left: 0.55rem; }
  @media (max-width: 520px) { .os-controls { grid-template-columns: 1fr; } }
</style>
