---
/**
 * LogMarSnellenConverter — the logMAR-to-Snellen rule used to read the PRIMA retinal-implant
 * results. Snellen denominator = 20 x 10^logMAR; a drop of d in logMAR is a 10^d-fold finer
 * minimum angle of resolution. Arithmetic only: it refuses to mix native implant resolution
 * with zoom-assisted scores. Self-contained vanilla-TS Astro island. Original.
 */
---

<figure class="lms card" data-logmar>
  <figcaption class="lms-head">logMAR and Snellen — reading an acuity number<span class="lms-chip">⚙ original · interactive</span></figcaption>

  <svg class="lms-svg" viewBox="0 0 340 186" role="img" aria-label="A logMAR axis from 0 to 2 with the matching Snellen denominators, a marker for the chosen acuity and a second marker for the acuity after a chosen change" data-plot></svg>

  <div class="lms-controls">
    <label class="lms-slabel"><span>Acuity, logMAR <em data-out="a">1.32</em></span>
      <input type="range" data-in="a" min="0" max="2" step="0.01" value="1.32" />
    </label>
    <label class="lms-slabel"><span>Change (improvement), logMAR <em data-out="d">0.20</em></span>
      <input type="range" data-in="d" min="0" max="0.6" step="0.05" value="0.2" />
    </label>
  </div>
  <p class="lms-endpoint" data-endpoint></p>

  <dl class="lms-readout">
    <div><dt>Snellen = 20 × 10<sup>logMAR</sup></dt><dd data-r-snellen></dd></div>
    <div><dt>Fold change, 10<sup>Δ</sup> (finer minimum angle)</dt><dd data-r-fold></dd></div>
    <div><dt>Acuity after the change</dt><dd data-r-after></dd></div>
    <div><dt>Endpoint responders, two denominators</dt><dd data-r-denom></dd></div>
  </dl>
  <p class="lms-why" data-why role="status"></p>

  <p class="lms-assume">In this sketch: the standard logMAR-to-Snellen conversion only, with no zoom or image-processing arithmetic. The 1.32 and the 0.2 endpoint come from adults with geographic atrophy (mean age 78.9) in an open-label, single-arm study (Holz and colleagues); the band is from five adults in the first clinical report (Palanker and colleagues).</p>
  <p class="lms-foot">Rule to keep: convert with 20 × 10<sup>logMAR</sup>, keep native implant resolution apart from zoom-assisted scores, and quote responders with both denominators.</p>
</figure>

<script>
  const NS = 'http://www.w3.org/2000/svg';
  const ACCENT = '#0e7c86', ORANGE = '#e57200', INK = '#4b4b55';
  function el(name: string, attrs: Record<string, string | number>): SVGElement {
    const e = document.createElementNS(NS, name);
    for (const k in attrs) e.setAttribute(k, String(attrs[k]));
    return e;
  }
  const snellen = (l: number) => 20 * Math.pow(10, l);
  const clamp = (v: number, lo: number, hi: number) => Math.min(hi, Math.max(lo, v));

  document.querySelectorAll<HTMLElement>('[data-logmar]').forEach((root) => {
    const q = <T extends Element>(s: string): T | null => root.querySelector<T>(s);
    const plotEl = q<SVGSVGElement>('[data-plot]');
    const aIn = q<HTMLInputElement>('[data-in="a"]');
    const dIn = q<HTMLInputElement>('[data-in="d"]');
    const aOut = q<HTMLElement>('[data-out="a"]');
    const dOut = q<HTMLElement>('[data-out="d"]');
    const endpoint = q<HTMLElement>('[data-endpoint]');
    const rSn = q<HTMLElement>('[data-r-snellen]');
    const rFold = q<HTMLElement>('[data-r-fold]');
    const rAfter = q<HTMLElement>('[data-r-after]');
    const rDen = q<HTMLElement>('[data-r-denom]');
    const why = q<HTMLElement>('[data-why]');
    if (!plotEl || !aIn || !dIn || !aOut || !dOut || !endpoint || !rSn || !rFold || !rAfter || !rDen || !why) return;

    const plot: SVGSVGElement = plotEl;
    const X0 = 24, X1 = 316, AX = 84;
    const px = (l: number) => X0 + (clamp(l, 0, 2) / 2) * (X1 - X0);
    const txt = (x: number, y: number, s: string, opts: Record<string, string | number> = {}) => {
      const t = el('text', Object.assign({ x, y, 'font-size': 9, fill: INK, 'text-anchor': 'middle' }, opts));
      t.textContent = s;
      plot.appendChild(t);
    };
    const mid = (x: number) => clamp(x, 72, 268);

    // Responders: the lesson's 26 of 32 assessed and 26 of 38 implanted.
    const p32 = (100 * 26 / 32).toFixed(1), p38 = (100 * 26 / 38).toFixed(1);
    rDen.textContent = `26/32 = ${p32}% assessed; 26/38 = ${p38}% implanted`;

    function render() {
      const a = Math.round(parseFloat(aIn!.value) * 100) / 100;
      const d = Math.round(parseFloat(dIn!.value) * 100) / 100;
      const s = snellen(a), fold = Math.pow(10, d);
      const after = Math.round((a - d) * 100) / 100;
      const off = after < 0;
      const meets = d >= 0.2 - 1e-9;
      aOut!.textContent = a.toFixed(2);
      dOut!.textContent = d.toFixed(2);
      endpoint!.textContent = meets
        ? 'Change ≥ 0.2 logMAR: this is the size of change the PRIMAvera endpoint required.'
        : 'Change < 0.2 logMAR: smaller than the size of change the PRIMAvera endpoint required.';

      rSn!.textContent = `20 × 10^${a.toFixed(2)} = ${s.toFixed(1)}, so 20/${Math.round(s)}`;
      rFold!.textContent = `10^${d.toFixed(2)} = ${fold.toFixed(2)}-fold`;
      rAfter!.textContent = off
        ? `${after.toFixed(2)} logMAR, below the 0 end of this scale`
        : `${after.toFixed(2)} logMAR, 20/${Math.round(snellen(after))}`;

      // ---- plot ----
      plot.replaceChildren();
      plot.appendChild(el('line', { x1: X0, y1: AX, x2: X1, y2: AX, stroke: INK, 'stroke-width': 1.2 }));
      // reference band: first clinical report, 20/460 to 20/550 = logMAR 1.36 to 1.44
      const bx0 = px(Math.log10(460 / 20)), bx1 = px(Math.log10(550 / 20));
      plot.appendChild(el('rect', { x: bx0, y: AX - 7, width: bx1 - bx0, height: 14, fill: ORANGE, opacity: 0.35 }));
      for (const l of [0, 0.5, 1, 1.5, 2]) {
        plot.appendChild(el('line', { x1: px(l), y1: AX - 4, x2: px(l), y2: AX + 4, stroke: INK, 'stroke-width': 1 }));
        txt(px(l), AX - 9, l.toFixed(1));
        txt(px(l), AX + 17, '20/' + Math.round(snellen(l)));
      }
      txt(X0, 16, 'logMAR above the line, Snellen below', { 'text-anchor': 'start', 'font-size': 9 });
      // chosen marker (stem up)
      const ax = px(a);
      plot.appendChild(el('line', { x1: ax, y1: AX, x2: ax, y2: 44, stroke: ACCENT, 'stroke-width': 1.6 }));
      plot.appendChild(el('circle', { cx: ax, cy: AX, r: 4.5, fill: ACCENT }));
      txt(mid(ax), 38, `chosen ${a.toFixed(2)} = 20/${Math.round(s)}`, { 'font-weight': 700, fill: ACCENT });
      // after-change marker (stem down)
      const bxm = px(Math.max(after, 0));
      plot.appendChild(el('line', { x1: bxm, y1: AX, x2: bxm, y2: 132, stroke: ORANGE, 'stroke-width': 1.6, 'stroke-dasharray': '4 2' }));
      plot.appendChild(el('circle', { cx: bxm, cy: AX, r: 4.5, fill: '#fff', stroke: ORANGE, 'stroke-width': 2 }));
      txt(mid(bxm), 144, off ? `after: ${after.toFixed(2)}, off scale` : `after change ${after.toFixed(2)} = 20/${Math.round(snellen(after))}`, { 'font-weight': 700, fill: ORANGE });
      // legend
      plot.appendChild(el('rect', { x: X0, y: 160, width: 14, height: 8, fill: ORANGE, opacity: 0.35 }));
      txt(X0 + 19, 168, 'band: first report, 20/460 to 20/550 (logMAR about 1.36 to 1.44)', { 'text-anchor': 'start' });
      txt(X0, 181, 'Mean implant resolution without zoom: 1.32 logMAR (lesson)', { 'text-anchor': 'start' });

      // ---- status ----
      const parts: string[] = [];
      let first = `In this sketch, 20 × 10^${a.toFixed(2)} = ${s.toFixed(1)}, shown as 20/${Math.round(s)}.`;
      if (Math.abs(a - 1.32) < 0.005) first += ' This is the mean implant-resolution acuity the lesson gives (no zoom, no image processing); the lesson rounds it to about 20/417.';
      else if (a === 0) first += ' LogMAR 0 is 20/20.';
      else if (s >= 460 && s <= 550) first += ' That falls within the 20/460 to 20/550 range of the three best-placed participants in the first clinical report (five adults).';
      parts.push(first);
      parts.push(`A drop of ${d.toFixed(2)} in logMAR is a ${fold.toFixed(2)}-fold finer minimum angle of resolution` + (d >= 0.2 - 1e-9 && Math.abs(d - 0.2) < 1e-9 ? ' (the lesson’s “about 1.6-fold”).' : '.'));
      parts.push('The 0.2 logMAR endpoint was measured with the PRIMA glasses, where participants could adjust zoom from 1 to 12 times, against baseline. A zoom-assisted score measures the implant plus a magnifier, so no zoom arithmetic is done here and the change above must not be applied to the native resolution.');
      parts.push('Meeting the endpoint shows a change in a measured score, not by itself normal or useful sight; none of this applies to people with other retinal diseases; and 26 of 32 assessed is not 26 of 38 implanted.');
      why!.textContent = parts.join(' ');
    }
    [aIn, dIn].forEach((s) => s.addEventListener('input', render));
    render();
  });
</script>

<style>
  .lms { padding: var(--ddp-space-3) var(--ddp-space-4) var(--ddp-space-4); margin: var(--ddp-space-5) 0; }
  .lms-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem; font-weight: 600; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); margin-bottom: var(--ddp-space-3); }
  .lms-chip { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 400; color: var(--ddp-color-muted); }
  .lms-svg { display: block; width: 100%; max-width: 560px; margin: 0 auto; height: auto; background: #fff; border: 1px solid var(--ddp-color-line); border-radius: 6px; }
  .lms-controls { display: grid; grid-template-columns: 1fr 1fr; gap: var(--ddp-space-2) var(--ddp-space-4); margin: var(--ddp-space-3) 0 var(--ddp-space-2); }
  .lms-slabel { display: flex; flex-direction: column; gap: 0.1rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .lms-slabel em { font-style: normal; font-weight: 700; color: var(--ddp-color-accent); font-family: var(--ddp-font-mono); }
  .lms-slabel input { accent-color: var(--ddp-color-accent); }
  .lms-endpoint { margin: 0 0 var(--ddp-space-2); font-size: var(--ddp-text-xs); font-weight: 600; color: var(--ddp-color-ink-soft); }
  .lms-readout { display: grid; grid-template-columns: 1fr 1fr; gap: var(--ddp-space-2); margin: var(--ddp-space-2) 0; padding: var(--ddp-space-2) var(--ddp-space-3); background: color-mix(in srgb, var(--ddp-color-accent) 8%, transparent); border-radius: 6px; }
  .lms-readout div { display: flex; flex-direction: column; gap: 0.1rem; min-width: 0; }
  .lms-readout dt { font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .lms-readout dd { margin: 0; font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); color: var(--ddp-color-primary); font-weight: 700; overflow-wrap: anywhere; }
  .lms-why { margin: 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); line-height: 1.5; min-height: 3em; }
  .lms-assume { margin: var(--ddp-space-2) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .lms-foot { margin: var(--ddp-space-3) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); border-left: 3px solid var(--ddp-color-secondary); padding-left: 0.55rem; }
  @media (max-width: 480px) { .lms-controls, .lms-readout { grid-template-columns: 1fr; } }
</style>
