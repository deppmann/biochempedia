---
/**
 * FissionDoublingClock — the worked problem of "Microbes, Protists and Fungi". One growth
 * curve, N = N0 x 2^g with g = elapsed time / doubling time, drawn on a log scale against
 * generations g, with two clocks under the same axis: minutes for E. coli (doubling about
 * every 20 min in rich medium at 37 degrees C in the laboratory) and days for the Asgard
 * archaeon MK-D1 (20 days chosen inside its estimated 14 to 25 days, counted from the end
 * of its 30 to 60 day lag). Every number follows from the lesson's equation and its two
 * doubling times. Nothing is drawn but axes, a curve and labelled marks. Self-contained
 * vanilla-TS Astro island. Original.
 */
---

<figure class="fdc card" data-fdc>
  <figcaption class="fdc-head">Fission doubling clock: one curve, two clocks<span class="fdc-chip">⚙ original · interactive</span></figcaption>

  <svg class="fdc-svg" viewBox="0 0 340 262" role="img" aria-label="Log-scale plot of cell number against generations for N equals N0 times 2 to the power g, with a minutes axis for E. coli and a days axis for the archaeon MK-D1 under the same curve" data-plot></svg>

  <div class="fdc-controls">
    <fieldset class="fdc-set">
      <legend>Organism</legend>
      <label class="fdc-opt"><input type="radio" name="fdc-org" value="ecoli" data-org checked /> <span>E. coli: doubling about every 20 min (rich medium, 37 °C, laboratory)</span></label>
      <label class="fdc-opt"><input type="radio" name="fdc-org" value="mkd1" data-org /> <span>Archaeon MK-D1: doubling every 20 days (chosen inside the estimated 14 to 25 days)</span></label>
    </fieldset>
    <fieldset class="fdc-set">
      <legend>Starting cells N0</legend>
      <label class="fdc-opt"><input type="radio" name="fdc-n0" value="100" data-n0 checked /> <span>100 cells</span></label>
      <label class="fdc-opt"><input type="radio" name="fdc-n0" value="1000" data-n0 /> <span>1,000 cells</span></label>
    </fieldset>
    <label class="fdc-slabel"><span>Elapsed time <em data-out="t">180 min</em> <small data-range-note>(0 to 400 min)</small></span>
      <input type="range" data-in="t" min="0" max="400" step="10" value="180" aria-label="Elapsed time, 0 to 400, in minutes for E. coli or days for MK-D1" />
    </label>
  </div>

  <dl class="fdc-readout">
    <div><dt>Generations</dt><dd data-r="g"></dd></div>
    <div><dt>Doublings</dt><dd data-r="pow"></dd></div>
    <div class="fdc-wide"><dt data-cells-label>Cells</dt><dd data-r="n"></dd></div>
    <div class="fdc-wide"><dt>The same number of doublings on each clock</dt><dd data-r="clock"></dd></div>
  </dl>

  <p class="fdc-assume">In this sketch: exponential growth, every cell divides once per doubling time, none die, food and space never run short, constant doubling time, with the curve drawn smoothly so a count between whole doublings is an average; counting for MK-D1 starts after its lag.</p>
  <div class="fdc-why" data-why role="status"></div>

  <p class="fdc-foot">Rule to keep: g = elapsed time / doubling time, and N = N0 × 2<sup>g</sup>, so equal numbers of doublings give equal cell numbers; only the clock differs. This is a sketch of the logic, not a prediction for a real culture.</p>
</figure>

<script>
  const NS = 'http://www.w3.org/2000/svg';
  const ACCENT = '#0e7c86', ORANGE = '#e57200', INK = '#4b4b55', FAINT = '#b9b9c2';
  const SUP: Record<string, string> = { '-': '⁻', '0': '⁰', '1': '¹', '2': '²', '3': '³', '4': '⁴', '5': '⁵', '6': '⁶', '7': '⁷', '8': '⁸', '9': '⁹' };
  const sup = (n: number) => String(n).split('').map((c) => SUP[c] ?? c).join('');
  const fmt = (n: number) => n.toLocaleString('en-US');
  function el(name: string, attrs: Record<string, string | number>): SVGElement {
    const e = document.createElementNS(NS, name);
    for (const k in attrs) e.setAttribute(k, String(attrs[k]));
    return e;
  }
  function need<T extends Element>(root: ParentNode, sel: string): T {
    const e = root.querySelector<T>(sel);
    if (!e) throw new Error('FissionDoublingClock: missing ' + sel);
    return e;
  }

  const TD = 20;            // doubling time: 20 min (E. coli) or 20 days (MK-D1)
  const MIN_PER_DAY = 1440; // lesson: 200 days x 1,440 minutes per day
  const GMAX = 20;          // 400 / 20
  const LMIN = 1.7, LMAX = 9.2; // log10 N axis (10^2 to 10^9 labelled)

  document.querySelectorAll<HTMLElement>('[data-fdc]').forEach((root) => {
    const plot = need<SVGSVGElement>(root, '[data-plot]');
    const tIn = need<HTMLInputElement>(root, '[data-in="t"]');
    const tOut = need<HTMLElement>(root, '[data-out="t"]');
    const rangeNote = need<HTMLElement>(root, '[data-range-note]');
    const rG = need<HTMLElement>(root, '[data-r="g"]');
    const rPow = need<HTMLElement>(root, '[data-r="pow"]');
    const rN = need<HTMLElement>(root, '[data-r="n"]');
    const rClock = need<HTMLElement>(root, '[data-r="clock"]');
    const cellsLabel = need<HTMLElement>(root, '[data-cells-label]');
    const why = need<HTMLElement>(root, '[data-why]');
    const orgIns = Array.from(root.querySelectorAll<HTMLInputElement>('[data-org]'));
    const n0Ins = Array.from(root.querySelectorAll<HTMLInputElement>('[data-n0]'));

    const X0 = 66, X1 = 324, Y0 = 22, Y1 = 192;
    const px = (g: number) => X0 + (g / GMAX) * (X1 - X0);
    const py = (lg: number) => Y1 - ((lg - LMIN) / (LMAX - LMIN)) * (Y1 - Y0);

    function txt(x: number, y: number, s: string, opts: Record<string, string | number> = {}) {
      const t = el('text', Object.assign({ x, y, 'font-size': 9.5, fill: INK }, opts));
      t.textContent = s;
      plot.appendChild(t);
    }

    function render() {
      const mk = orgIns.some((r) => r.checked && r.value === 'mkd1');
      const n0 = n0Ins.some((r) => r.checked && r.value === '1000') ? 1000 : 100;
      const t = parseInt(tIn.value, 10);
      const unit = mk ? 'days' : 'min';
      const g = t / TD;
      const whole = Number.isInteger(g);
      const pow = Math.pow(2, g);
      const n = Math.round(n0 * pow);
      const powTxt = whole ? fmt(pow) : pow.toFixed(2);
      const gTxt = whole ? String(g) : g.toFixed(1);

      tOut.textContent = t + ' ' + unit;
      rangeNote.textContent = mk ? '(0 to 400 days after its lag)' : '(0 to 400 min)';
      tIn.setAttribute('aria-valuetext', t + ' ' + unit);

      // clocks for the same g
      const ecoliMin = g * TD;
      const mkDays = g * TD;
      const mkMin = mkDays * MIN_PER_DAY;

      cellsLabel.textContent = mk ? 'Cells (or gene copies, as measured)' : 'Cells';
      rG.textContent = `g = ${t} ${unit} / ${TD} ${unit} = ${gTxt}` + (mk ? ' (20 days, chosen)' : ' (doubling about 20 min)');
      rPow.textContent = `2^g = 2^${gTxt} = ${powTxt}`;
      rN.textContent = `N = N0 × 2^g = ${fmt(n0)} × ${powTxt} = ${fmt(n)} cells` + (whole ? '' : ' (rounded to a whole cell)');
      rClock.textContent = g === 0
        ? 'g = 0: no doubling yet, so 0 min for E. coli and 0 days for MK-D1.'
        : `E. coli: ${gTxt} × 20 min = ${fmt(ecoliMin)} min. MK-D1: ${gTxt} × 20 days = ${fmt(mkDays)} days = ${fmt(mkDays)} × 1,440 min per day = ${fmt(mkMin)} min, which is 1,440 times as long (lag not counted) as E. coli’s ${fmt(ecoliMin)} min.`;

      // ---- plot ----
      plot.replaceChildren();
      plot.appendChild(el('line', { x1: X0, y1: Y0, x2: X0, y2: Y1, stroke: INK, 'stroke-width': 1 }));
      plot.appendChild(el('line', { x1: X0, y1: Y1, x2: X1, y2: Y1, stroke: INK, 'stroke-width': 1 }));
      for (let p = 2; p <= 9; p++) {
        plot.appendChild(el('line', { x1: X0, y1: py(p), x2: X1, y2: py(p), stroke: '#e4e4ea', 'stroke-width': 0.7 }));
        plot.appendChild(el('line', { x1: X0 - 3, y1: py(p), x2: X0, y2: py(p), stroke: INK, 'stroke-width': 1 }));
        txt(X0 - 5, py(p) + 3, '10' + sup(p), { 'text-anchor': 'end' });
      }
      txt(X0 - 2, Y0 - 8, 'cells N (log scale)', { 'font-size': 10 });
      for (let gg = 0; gg <= GMAX; gg += 5) {
        plot.appendChild(el('line', { x1: px(gg), y1: Y1, x2: px(gg), y2: Y1 + 3, stroke: INK, 'stroke-width': 1 }));
        txt(px(gg), Y1 + 13, String(gg), { 'text-anchor': 'middle' });
        txt(px(gg), Y1 + 27, String(gg * TD), { 'text-anchor': 'middle', 'font-weight': mk ? 400 : 700, fill: mk ? INK : ACCENT });
        txt(px(gg), Y1 + 41, String(gg * TD), { 'text-anchor': 'middle', 'font-weight': mk ? 700 : 400, fill: mk ? ACCENT : INK });
      }
      txt(X0 - 6, Y1 + 13, 'g', { 'text-anchor': 'end', 'font-weight': 700 });
      txt(X0 - 6, Y1 + 27, 'E. coli, min', { 'text-anchor': 'end', 'font-weight': mk ? 400 : 700, fill: mk ? INK : ACCENT });
      txt(X0 - 6, Y1 + 41, 'MK-D1, days', { 'text-anchor': 'end', 'font-weight': mk ? 700 : 400, fill: mk ? ACCENT : INK });
      txt((X0 + X1) / 2, Y1 + 56, 'generations g = elapsed time / doubling time', { 'text-anchor': 'middle' });
      txt((X0 + X1) / 2, Y1 + 68, '(about 20 min, or a chosen 20 days)', { 'text-anchor': 'middle' });

      // curve N = N0 x 2^g : a straight line on the log axis
      const lg0 = Math.log10(n0);
      const lgEnd = lg0 + GMAX * Math.log10(2);
      plot.appendChild(el('line', { x1: px(0), y1: py(lg0), x2: px(GMAX), y2: py(lgEnd), stroke: FAINT, 'stroke-width': 1.6, 'stroke-dasharray': '4 3' }));
      const lgNow = lg0 + g * Math.log10(2);
      plot.appendChild(el('line', { x1: px(0), y1: py(lg0), x2: px(g), y2: py(lgNow), stroke: ACCENT, 'stroke-width': 2.8 }));

      // ten doublings (the lesson's example), hollow ring
      const lg10 = lg0 + 10 * Math.log10(2);
      plot.appendChild(el('circle', { cx: px(10), cy: py(lg10), r: 4.5, fill: '#fff', stroke: INK, 'stroke-width': 1.4 }));

      // current point with guides to the axes
      plot.appendChild(el('line', { x1: px(g), y1: py(lgNow), x2: px(g), y2: Y1, stroke: ORANGE, 'stroke-width': 1.2, 'stroke-dasharray': '3 2' }));
      plot.appendChild(el('line', { x1: X0, y1: py(lgNow), x2: px(g), y2: py(lgNow), stroke: ORANGE, 'stroke-width': 1.2, 'stroke-dasharray': '3 2' }));
      plot.appendChild(el('circle', { cx: px(g), cy: py(lgNow), r: 4.5, fill: ORANGE }));

      // fixed read-out and legend (never move with the point)
      txt(X0 + 8, Y0 + 12, `now: g = ${gTxt}, N = ${fmt(n)}`, { 'font-weight': 700, fill: ORANGE });
      const LX = X1 - 128, LY = Y1 - 34;
      plot.appendChild(el('circle', { cx: LX + 6, cy: LY, r: 4, fill: ORANGE }));
      txt(LX + 15, LY + 3, 'now');
      plot.appendChild(el('circle', { cx: LX + 6, cy: LY + 13, r: 4, fill: '#fff', stroke: INK, 'stroke-width': 1.4 }));
      txt(LX + 15, LY + 16, 'ten doublings (g = 10)');
      plot.appendChild(el('line', { x1: LX, y1: LY + 26, x2: LX + 12, y2: LY + 26, stroke: FAINT, 'stroke-width': 1.6, 'stroke-dasharray': '4 3' }));
      txt(LX + 15, LY + 29, 'N0 × 2^g, rest of range');

      // ---- status ----
      const who = mk
        ? 'The Asgard archaeon MK-D1 (doubling time 20 days, chosen inside the estimated 14 to 25 days; days counted from the end of its 30 to 60 day lag)'
        : 'E. coli (typically doubling about every 20 min in rich medium at 37 °C in the laboratory)';
      const body = g === 0
        ? `${who}: at 0 ${unit} no doubling has happened, so g = 0, 2^g = 1 and N = N0 = ${fmt(n0)} cells.`
        : `${who}: ${t} ${unit} / ${TD} ${unit} = ${gTxt} generations, so ${fmt(n0)} × ${powTxt} = ${fmt(n)} cells. The same ${gTxt} doublings take ${mk ? fmt(ecoliMin) + ' min for E. coli' : fmt(mkDays) + ' days (' + fmt(mkMin) + ' min) for MK-D1'}, so only the clock changes.`;
      why.textContent = body + ' Two cautions: real cultures run out of food, and MK-D1 growth was measured as gene copies by qPCR, not cell counts. Generation time is one factor in how fast a population, and the genes in it, can change.';
    }

    tIn.addEventListener('input', render);
    orgIns.forEach((r) => r.addEventListener('change', render));
    n0Ins.forEach((r) => r.addEventListener('change', render));
    render();
  });
</script>

<style>
  .fdc { padding: var(--ddp-space-3) var(--ddp-space-4) var(--ddp-space-4); margin: var(--ddp-space-5) 0; }
  .fdc-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem; font-weight: 600; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); margin-bottom: var(--ddp-space-3); }
  .fdc-chip { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 400; color: var(--ddp-color-muted); }
  .fdc-svg { display: block; width: 100%; max-width: 560px; margin: 0 auto; height: auto; background: #fff; border: 1px solid var(--ddp-color-line); border-radius: 6px; }
  .fdc-controls { display: grid; grid-template-columns: 1fr 1fr; gap: var(--ddp-space-2) var(--ddp-space-4); margin: var(--ddp-space-3) 0 var(--ddp-space-2); }
  .fdc-set { border: 0; margin: 0; padding: 0; min-width: 0; display: flex; flex-direction: column; gap: 0.25rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .fdc-set legend { padding: 0; font-weight: 600; color: var(--ddp-color-primary); margin-bottom: 0.15rem; }
  .fdc-opt { display: flex; gap: 0.4rem; align-items: flex-start; }
  .fdc-opt input { accent-color: var(--ddp-color-accent); margin-top: 0.15rem; }
  .fdc-slabel { grid-column: 1 / -1; display: flex; flex-direction: column; gap: 0.1rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .fdc-slabel small { font-size: inherit; color: var(--ddp-color-muted); }
  .fdc-slabel em { font-style: normal; font-weight: 700; color: var(--ddp-color-accent); font-family: var(--ddp-font-mono); }
  .fdc-slabel input { accent-color: var(--ddp-color-accent); width: 100%; }
  .fdc-readout { display: grid; grid-template-columns: 1fr 1fr; gap: var(--ddp-space-2); margin: var(--ddp-space-2) 0; padding: var(--ddp-space-2) var(--ddp-space-3); background: color-mix(in srgb, var(--ddp-color-accent) 8%, transparent); border-radius: 6px; }
  .fdc-readout div { display: flex; flex-direction: column; gap: 0.1rem; min-width: 0; }
  .fdc-wide { grid-column: 1 / -1; }
  .fdc-readout dt { font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .fdc-readout dd { margin: 0; font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); color: var(--ddp-color-primary); font-weight: 700; overflow-wrap: anywhere; }
  .fdc-assume { margin: 0 0 var(--ddp-space-2); font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .fdc-why { margin: 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); line-height: 1.5; min-height: 6em; }
  .fdc-foot { margin: var(--ddp-space-3) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); border-left: 3px solid var(--ddp-color-secondary); padding-left: 0.55rem; }
  @media (max-width: 560px) { .fdc-controls { grid-template-columns: 1fr; } }
</style>
