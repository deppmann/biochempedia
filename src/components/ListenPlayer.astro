---
/**
 * ListenPlayer — read the lesson aloud (2026-11-05).
 *
 * rehype-listen (src/lib/rehype-listen.mjs) marks each paragraph and list item of the lesson body
 * with data-say="<hash>". This adds a "Listen" button under the lesson summary, a small ▶ at each
 * h2, and a mini-player fixed to the bottom of the screen: play/pause, back or forward one
 * paragraph, speed 0.75–1.75, close. It reads from the chosen point to the end, marks the
 * paragraph being read (class bp-reading) and keeps it on screen.
 *
 * For each paragraph: if src/data/listen-manifest.json lists its hash for this lesson, it plays
 * the Kokoro clip /listen/<slug>/<hash>.mp3 (served from R2 by the worker; made by
 * scripts/listen-render.mjs). Otherwise, or if the clip fails to load, the browser's own
 * speechSynthesis reads the text. The player says which voice is reading.
 *
 * It stops when the reader leaves the page and pauses when a video on the page starts. Without
 * JavaScript, or with neither clips nor a device voice, nothing is shown.
 */
import manifest from '../data/listen-manifest.json';

interface Props { slug: string }
const { slug } = Astro.props;
const clips: string[] = (manifest as Record<string, string[]>)[slug] ?? [];
---
<div class="bp-listen-launch" data-listen-root data-slug={slug} data-clips={clips.join(' ')} hidden>
  <button type="button" class="bp-listen-btn" data-listen-start>
    <span aria-hidden="true">▶</span> Listen
  </button>
  <span class="bp-listen-note">{clips.length ? 'Read aloud in the recorded Kokoro voice.' : 'Read aloud by your device’s voice.'}</span>
</div>

<div class="bp-listen-player" role="region" aria-label="Listen player" data-listen-player hidden>
  <button type="button" class="bp-lp-btn" data-lp="prev" aria-label="Back one paragraph" title="Back one paragraph">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 5h2v14H6zM20 5v14L9 12z" /></svg>
  </button>
  <button type="button" class="bp-lp-btn bp-lp-main" data-lp="toggle" aria-label="Pause" title="Pause">
    <svg class="bp-lp-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5h4v14H7zM13 5h4v14h-4z" /></svg>
    <svg class="bp-lp-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4v16l13-8z" /></svg>
  </button>
  <button type="button" class="bp-lp-btn" data-lp="next" aria-label="Forward one paragraph" title="Forward one paragraph">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16 5h2v14h-2zM4 5v14l11-7z" /></svg>
  </button>
  <p class="bp-lp-status" data-lp="status"></p>
  <label class="bp-lp-speed">
    <span class="bp-lp-sr">Speed</span>
    <select data-lp="speed">
      <option value="0.75">0.75×</option>
      <option value="1" selected>1×</option>
      <option value="1.25">1.25×</option>
      <option value="1.5">1.5×</option>
      <option value="1.75">1.75×</option>
    </select>
  </label>
  <button type="button" class="bp-lp-btn" data-lp="close" aria-label="Close player" title="Close">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.4 5 5 6.4 10.6 12 5 17.6 6.4 19l5.6-5.6 5.6 5.6 1.4-1.4-5.6-5.6L19 6.4 17.6 5 12 10.6z" /></svg>
  </button>
</div>

<script>
  const RATE_KEY = 'biochempedia:listen:rate';
  const root = document.querySelector<HTMLElement>('[data-listen-root]');
  const player = document.querySelector<HTMLElement>('[data-listen-player]');
  const prose = document.querySelector<HTMLElement>('.prose-col[data-lesson-title]');
  const synth: SpeechSynthesis | null = 'speechSynthesis' in window ? window.speechSynthesis : null;

  if (root && player && prose) init(root, player, prose);

  function init(root: HTMLElement, player: HTMLElement, prose: HTMLElement) {
    const slug = root.dataset.slug || '';
    const clips = new Set((root.dataset.clips || '').split(' ').filter(Boolean));
    // Only the build's 12-hex hashes: EquationCard's own "Read aloud" button also carries data-say (its text).
    const all = Array.from(prose.querySelectorAll<HTMLElement>('[data-say]')).filter((el) => /^[0-9a-f]{12}$/.test(el.dataset.say || ''));
    if (!all.length || (!synth && !all.some((b) => clips.has(b.dataset.say || '')))) return;

    const $ = (k: string) => player.querySelector<HTMLElement>(`[data-lp="${k}"]`)!;
    const toggleBtn = $('toggle'), statusEl = $('status');
    const speedSel = $('speed') as HTMLSelectElement;
    const reduced = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let rate = 1;
    try { const r = Number(localStorage.getItem(RATE_KEY)); if (r >= 0.75 && r <= 1.75) rate = r; } catch { /* storage blocked */ }
    speedSel.value = String(rate);

    let list: HTMLElement[] = [];     // the paragraphs being read, in order (visible ones only)
    let idx = -1;                     // which paragraph
    let playing = false;
    let gen = 0;                      // bumps on every stop, so late callbacks from old audio/speech are ignored
    let mode: 'clip' | 'device' | null = null;
    let chunks: string[] = [];        // device voice: the paragraph split into sentences
    let chunkIdx = 0;
    let utter: SpeechSynthesisUtterance | null = null;   // kept referenced: Chrome drops events of collected utterances
    const audio = new Audio();
    audio.preload = 'auto';
    const prefetch = new Audio();
    prefetch.preload = 'auto';

    // ---- voice -------------------------------------------------------------------------------
    let voice: SpeechSynthesisVoice | null = null;
    const pickVoice = () => {
      if (!synth) return;
      const en = synth.getVoices().filter((v) => /^en([-_]|$)/i.test(v.lang));
      const score = (v: SpeechSynthesisVoice) =>
        (/^en[-_]us/i.test(v.lang) ? 4 : /^en[-_]gb/i.test(v.lang) ? 3 : 1) +
        (/natural|neural|premium|enhanced|samantha|google us/i.test(v.name) ? 4 : 0) + (v.localService ? 1 : 0);
      voice = en.sort((a, b) => score(b) - score(a))[0] || null;
    };
    if (synth) { pickVoice(); synth.addEventListener?.('voiceschanged', pickVoice); }

    // ---- text the device voice reads (same rules as the build: sub, sup, ×, −) ------------------
    const speakable = (el: Element): string => {
      let s = '';
      el.childNodes.forEach((n) => {
        if (n.nodeType === Node.TEXT_NODE) s += n.textContent;
        else if (n instanceof Element) {
          const t = n.tagName;
          if (/^(UL|OL|BUTTON|SCRIPT|STYLE|svg)$/.test(t) || n.getAttribute('aria-hidden') === 'true') return;
          if (t === 'SUB') s += ` sub ${speakable(n)}`;
          else if (t === 'SUP') s += ` to the ${speakable(n)}`;
          else if (t === 'BR') s += ' ';
          else s += speakable(n);
        }
      });
      return s;
    };
    const textOf = (el: Element) => speakable(el).replace(/×/g, ' times ').replace(/−/g, ' minus ').replace(/\s+/g, ' ').trim();
    const sentences = (t: string) => {
      const out: string[] = [];
      for (const s of t.split(/(?<=[.!?:;])\s+(?=[A-Z0-9“"(‘'])/)) {
        if (out.length && (out[out.length - 1].length + s.length < 120)) out[out.length - 1] += ' ' + s;
        else out.push(s);
      }
      return out;
    };

    // ---- display ------------------------------------------------------------------------------
    const visible = (el: HTMLElement) => el.getClientRects().length > 0 && !el.closest('[hidden], details:not([open])');
    const setStatus = (msg?: string) => {
      if (msg !== undefined) { statusEl.textContent = msg; return; }
      const voiceName = mode === 'clip' ? 'Kokoro voice' : 'Device voice';
      statusEl.replaceChildren();
      if (idx < 0) return;
      for (const t of [`${idx + 1} of ${list.length}`, voiceName]) {
        const s = document.createElement('span');
        s.textContent = t;
        statusEl.appendChild(s);
      }
    };
    const setPlaying = (p: boolean) => {
      playing = p;
      player.classList.toggle('is-playing', p);
      toggleBtn.setAttribute('aria-label', p ? 'Pause' : 'Play');
      toggleBtn.title = p ? 'Pause' : 'Play';
    };
    const mark = (el: HTMLElement | null) => {
      prose.querySelectorAll('.bp-reading').forEach((e) => e.classList.remove('bp-reading'));
      if (!el) return;
      el.classList.add('bp-reading');
      const r = el.getBoundingClientRect();
      const bottomLimit = window.innerHeight - player.offsetHeight - 24;
      if (r.top < 72 || r.bottom > bottomLimit) el.scrollIntoView({ block: 'center', behavior: reduced() ? 'auto' : 'smooth' });
    };
    const open = () => {
      player.hidden = false;
      document.body.classList.add('bp-listening');
    };

    // ---- playback -----------------------------------------------------------------------------
    const silence = () => {
      gen += 1;
      audio.onended = audio.onerror = null;
      audio.pause();
      if (synth && (synth.speaking || synth.pending)) synth.cancel();
    };
    const clipUrl = (h: string) => `/listen/${slug}/${h}.mp3`;

    const speakFrom = (k: number) => {
      if (!synth) { playAt(idx + 1); return; }
      const g = gen;
      chunkIdx = k;
      if (k >= chunks.length) { playAt(idx + 1); return; }
      const u = new SpeechSynthesisUtterance(chunks[k]);
      u.rate = rate;
      if (voice) { u.voice = voice; u.lang = voice.lang; } else u.lang = 'en-US';
      u.onend = () => { if (g === gen) speakFrom(k + 1); };
      u.onerror = (e) => {
        if (g !== gen) return;
        // Our own stops bump gen first, so an interruption here came from something else on the page
        // (another read-aloud button): treat it as a pause.
        if (e.error === 'interrupted' || e.error === 'canceled') { gen += 1; setPlaying(false); }
        else speakFrom(k + 1);
      };
      utter = u;
      synth.speak(u);
    };
    const useDevice = (el: HTMLElement) => {
      mode = 'device';
      chunks = sentences(textOf(el));
      setStatus();
      speakFrom(0);
    };

    const playAt = (i: number) => {
      silence();
      if (i < 0) i = 0;
      if (i >= list.length) { idx = -1; mark(null); setPlaying(false); setStatus('Finished. Press play to start again.'); return; }
      idx = i;
      const el = list[i];
      const h = el.dataset.say || '';
      mark(el);
      setPlaying(true);
      const g = gen;
      const next = list[i + 1]?.dataset.say;
      if (next && clips.has(next)) prefetch.src = clipUrl(next);
      if (clips.has(h)) {
        mode = 'clip';
        setStatus();
        audio.src = clipUrl(h);
        audio.playbackRate = rate;
        audio.onended = () => { if (g === gen) playAt(i + 1); };
        // A missing or broken clip falls back to the device voice for this paragraph.
        audio.onerror = () => { if (g === gen) useDevice(el); };
        audio.play().catch((err) => {
          if (g !== gen) return;
          if (err && err.name === 'NotAllowedError') { setPlaying(false); setStatus('Press play to listen.'); }
          else useDevice(el);
        });
      } else useDevice(el);
    };

    const pause = () => {
      if (!playing) return;
      if (mode === 'clip') { audio.pause(); }
      else { gen += 1; if (synth) synth.cancel(); }   // pause() is unreliable on phones; resume restarts the sentence
      setPlaying(false);
    };
    const resume = () => {
      if (idx < 0) { start(0); return; }
      setPlaying(true);
      if (mode === 'clip' && audio.src) {
        audio.playbackRate = rate;
        audio.play().catch(() => useDevice(list[idx]));
      } else speakFrom(chunkIdx);
    };
    const start = (from: number | HTMLElement) => {
      list = all.filter(visible);
      if (!list.length) return;
      const i = typeof from === 'number' ? from : Math.max(0, list.findIndex((b) => b === from || !!(from.compareDocumentPosition(b) & Node.DOCUMENT_POSITION_FOLLOWING)));
      open();
      playAt(i);
    };
    const close = () => {
      const hadFocus = player.contains(document.activeElement);
      silence();
      setPlaying(false);
      idx = -1;
      mark(null);
      player.hidden = true;
      document.body.classList.remove('bp-listening');
      if (hadFocus) root.querySelector<HTMLElement>('[data-listen-start]')?.focus({ preventScroll: true });
    };

    // ---- controls -----------------------------------------------------------------------------
    root.hidden = false;
    root.querySelector('[data-listen-start]')!.addEventListener('click', () => {
      // Start from the paragraph nearest the top of the screen when the reader has scrolled into the lesson.
      const firstOnScreen = all.find((b) => visible(b) && b.getBoundingClientRect().bottom > 80);
      const proseTop = prose.getBoundingClientRect().top;
      start(proseTop < 0 && firstOnScreen ? firstOnScreen : 0);
      toggleBtn.focus({ preventScroll: true });
    });
    toggleBtn.addEventListener('click', () => (playing ? pause() : resume()));
    $('prev').addEventListener('click', () => { if (idx < 0) return start(0); playAt(Math.max(0, idx - 1)); });
    $('next').addEventListener('click', () => { if (idx < 0) return start(0); playAt(idx + 1); });
    $('close').addEventListener('click', close);
    player.addEventListener('keydown', (e) => { if (e.key === 'Escape') { e.preventDefault(); close(); } });
    speedSel.addEventListener('change', () => {
      rate = Number(speedSel.value) || 1;
      try { localStorage.setItem(RATE_KEY, String(rate)); } catch { /* storage blocked */ }
      audio.playbackRate = rate;
      if (playing && mode === 'device') { gen += 1; synth?.cancel(); speakFrom(chunkIdx); }
    });

    // A ▶ at each section heading: read from that section's first paragraph.
    prose.querySelectorAll<HTMLElement>('h2').forEach((h2) => {
      if (h2.closest('details, [data-listen-skip]')) return;
      const first = all.find((b) => !!(h2.compareDocumentPosition(b) & Node.DOCUMENT_POSITION_FOLLOWING));
      if (!first) return;
      const nextH2 = Array.from(prose.querySelectorAll('h2')).find((h) => !!(h2.compareDocumentPosition(h) & Node.DOCUMENT_POSITION_FOLLOWING));
      if (nextH2 && !(first.compareDocumentPosition(nextH2) & Node.DOCUMENT_POSITION_FOLLOWING)) return;   // section has nothing to read
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'bp-listen-h2';
      b.setAttribute('aria-label', 'Listen from here');
      b.title = 'Listen from here';
      b.innerHTML = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4v16l13-8z"/></svg>';
      b.addEventListener('click', () => { start(first); toggleBtn.focus({ preventScroll: true }); });
      h2.appendChild(b);
    });

    // Pause when a video (or any other media on the page) starts; stop when leaving the page.
    document.addEventListener('play', (e) => { if (e.target !== audio && e.target instanceof HTMLMediaElement) pause(); }, true);
    // Another read-aloud control on the page (EquationCard) also pauses the player.
    prose.addEventListener('click', (e) => { if ((e.target as Element).closest?.('.eqc-listen')) pause(); }, true);
    window.addEventListener('pagehide', () => { silence(); setPlaying(false); });

    // For tests and debugging: window.__bpListen.state()
    (window as unknown as { __bpListen: unknown }).__bpListen = {
      state: () => ({ idx, total: list.length, playing, mode, rate, src: audio.src, audioPaused: audio.paused, speaking: !!synth?.speaking, voice: voice?.name ?? null, chunk: chunkIdx, chunks: chunks.length }),
    };
  }
</script>

<style>
  .bp-listen-launch { display: flex; align-items: center; flex-wrap: wrap; gap: var(--ddp-space-2) var(--ddp-space-3); margin: var(--ddp-space-4) 0 0; }
  .bp-listen-launch[hidden] { display: none; }
  .bp-listen-btn {
    display: inline-flex; align-items: center; gap: 0.45em; min-height: 40px;
    font: 600 var(--ddp-text-sm)/1 var(--ddp-font-sans); color: var(--ddp-color-primary);
    background: var(--ddp-color-surface); border: 1px solid var(--ddp-color-line); border-radius: 999px;
    padding: 0.55em 1.1em; cursor: pointer;
  }
  .bp-listen-btn:hover { border-color: var(--ddp-color-accent); color: var(--ddp-color-accent); }
  .bp-listen-btn span { font-size: 0.8em; }
  .bp-listen-note { font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }

  .bp-listen-player {
    position: fixed; z-index: 50; left: 50%; transform: translateX(-50%);
    bottom: calc(var(--ddp-space-4) + env(safe-area-inset-bottom, 0px));
    width: min(560px, calc(100vw - 32px)); box-sizing: border-box;
    display: flex; align-items: center; gap: var(--ddp-space-1);
    padding: var(--ddp-space-2); background: var(--ddp-color-surface); color: var(--ddp-color-ink);
    border: 1px solid var(--ddp-color-line); border-radius: 14px; box-shadow: var(--ddp-shadow);
    font-family: var(--ddp-font-sans);
  }
  .bp-listen-player[hidden] { display: none; }
  .bp-lp-btn {
    flex: none; display: inline-grid; place-items: center; width: 40px; height: 40px; padding: 0;
    background: transparent; color: var(--ddp-color-primary); border: 1px solid transparent; border-radius: 999px; cursor: pointer;
  }
  .bp-lp-btn:hover { border-color: var(--ddp-color-line); }
  .bp-lp-btn svg { width: 20px; height: 20px; fill: currentColor; }
  .bp-lp-main { background: var(--ddp-color-primary); color: var(--ddp-color-surface); width: 44px; height: 44px; }
  .bp-lp-main:hover { border-color: transparent; opacity: 0.9; }
  .bp-lp-main .bp-lp-pause, .bp-listen-player.is-playing .bp-lp-main .bp-lp-play { display: none; }
  .bp-listen-player.is-playing .bp-lp-main .bp-lp-pause { display: block; }
  .bp-lp-status {
    flex: 1 1 auto; min-width: 0; margin: 0 var(--ddp-space-2); font-size: var(--ddp-text-xs); color: var(--ddp-color-muted);
    line-height: 1.3; overflow: hidden;
  }
  .bp-lp-status :global(span) { display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .bp-lp-speed select {
    font: 600 var(--ddp-text-xs) var(--ddp-font-mono); color: var(--ddp-color-ink); background: var(--ddp-color-surface);
    border: 1px solid var(--ddp-color-line); border-radius: 8px; height: 36px; padding: 0 0.4em; cursor: pointer;
  }
  .bp-lp-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .bp-lp-btn:focus-visible, .bp-listen-btn:focus-visible, .bp-lp-speed select:focus-visible {
    outline: 2px solid var(--ddp-color-accent); outline-offset: 2px;
  }
  @media (max-width: 420px) {
    .bp-listen-player { gap: 2px; padding: 6px; }
    .bp-lp-status { margin: 0 4px; }
  }

  /* Elements outside this component: the lesson's paragraphs and headings, and the page. */
  :global(.bp-reading) {
    background: var(--ddp-color-accent-soft, rgba(255, 210, 80, 0.25));
    box-shadow: 0 0 0 6px var(--ddp-color-accent-soft, rgba(255, 210, 80, 0.25));
    border-radius: 3px;
    transition: background-color 0.2s ease, box-shadow 0.2s ease;
  }
  :global(.bp-listen-h2) {
    display: inline-grid; place-items: center; vertical-align: middle; width: 32px; height: 32px; margin-left: 0.4em; padding: 0;
    color: var(--ddp-color-muted); background: transparent; border: 1px solid var(--ddp-color-line); border-radius: 999px; cursor: pointer;
  }
  :global(.bp-listen-h2 svg) { width: 14px; height: 14px; fill: currentColor; }
  :global(.bp-listen-h2:hover) { color: var(--ddp-color-accent); border-color: var(--ddp-color-accent); }
  :global(.bp-listen-h2:focus-visible) { outline: 2px solid var(--ddp-color-accent); outline-offset: 2px; }
  :global(body.bp-listening) { padding-bottom: 88px; }
  :global(body.bp-listening .to-top) { bottom: calc(88px + env(safe-area-inset-bottom, 0px)); }
  @media (prefers-reduced-motion: reduce) { :global(.bp-reading) { transition: none; } }
</style>
