---
/**
 * OveryieldingPartition — the Loreau-Hector partition for two species sown in equal
 * proportions. Four sliders (monoculture and mixture yields of species A and B) drive
 * yield bars and a signed split of the net effect into complementarity and selection.
 * Every number follows from the lesson's rules. Self-contained vanilla-TS Astro island. Original.
 */
---

<figure class="oyp card" data-oyp>
  <figcaption class="oyp-head">Overyielding — complementarity and selection<span class="oyp-chip">⚙ original · interactive</span></figcaption>

  <svg class="oyp-svg" viewBox="0 0 340 300" role="img" aria-label="Bars of monoculture and mixture yields for two species, and signed bars splitting the net effect into complementarity and selection" data-plot></svg>

  <div class="oyp-controls">
    <label class="oyp-slabel"><span>Monoculture yield M<sub>A</sub> <em data-out="ma">400</em> g m⁻²</span>
      <input type="range" data-in="ma" min="0" max="600" step="10" value="400" />
    </label>
    <label class="oyp-slabel"><span>Monoculture yield M<sub>B</sub> <em data-out="mb">100</em> g m⁻²</span>
      <input type="range" data-in="mb" min="0" max="600" step="10" value="100" />
    </label>
    <label class="oyp-slabel"><span>Mixture yield Y<sub>A</sub> <em data-out="ya">300</em> g m⁻²</span>
      <input type="range" data-in="ya" min="0" max="600" step="10" value="300" />
    </label>
    <label class="oyp-slabel"><span>Mixture yield Y<sub>B</sub> <em data-out="yb">100</em> g m⁻²</span>
      <input type="range" data-in="yb" min="0" max="600" step="10" value="100" />
    </label>
  </div>

  <dl class="oyp-readout">
    <div><dt>Expected yield (mean M)</dt><dd data-r="exp">250 g m⁻²</dd></div>
    <div><dt>Observed yield (Y<sub>A</sub> + Y<sub>B</sub>)</dt><dd data-r="obs">400 g m⁻²</dd></div>
    <div><dt>Relative yields RY<sub>A</sub>, RY<sub>B</sub></dt><dd data-r="ry">0.75, 1.00</dd></div>
    <div><dt>Net effect</dt><dd data-r="net">+150.0 g m⁻²</dd></div>
    <div><dt>Complementarity = 2 × mean(ΔRY) × mean(M)</dt><dd data-r="comp">+187.5 g m⁻²</dd></div>
    <div><dt>Selection = 2 × population covariance</dt><dd data-r="sel">−37.5 g m⁻²</dd></div>
    <div class="oyp-wide"><dt>Against the best monoculture</dt><dd data-r="best">400 vs 400 g m⁻²</dd></div>
  </dl>

  <p class="oyp-why" data-why role="status">Loading.</p>

  <p class="oyp-assume">In this sketch: two species sown in equal proportions (expected RY = 0.5 each), plots of the same area in the same year, constructed yields.</p>
  <p class="oyp-foot">Net effect = complementarity + selection, and the split is algebra on yields: it does not say which biological process produced them. Beating the average monoculture is overyielding; beating the best one is transgressive overyielding.</p>
</figure>

<script>
  const NS = 'http://www.w3.org/2000/svg';
  const CA = '#0e7c86', CB = '#e57200', INK = '#4b4b55', FAINT = '#b9b9c2', GREY = '#8a8a96';
  function el(name: string, attrs: Record<string, string | number>): SVGElement {
    const e = document.createElementNS(NS, name);
    for (const k in attrs) e.setAttribute(k, String(attrs[k]));
    return e;
  }
  function txt(x: number, y: number, s: string, anchor: string, size = 9, fill = INK, weight = 400): SVGElement {
    const t = el('text', { x, y, 'text-anchor': anchor, 'font-size': size, fill, 'font-weight': weight });
    t.textContent = s;
    return t;
  }
  const fmt = (v: number) => (Math.abs(v) < 0.05 ? 0 : v).toFixed(1).replace('-', '−');
  const sgn = (v: number) => (Math.abs(v) < 0.05 ? '' : v > 0 ? '+' : '') + fmt(v);

  document.querySelectorAll<HTMLElement>('[data-oyp]').forEach((root) => {
    const plot = root.querySelector<SVGSVGElement>('[data-plot]')!;
    const inp = (k: string) => root.querySelector<HTMLInputElement>(`[data-in="${k}"]`)!;
    const outp = (k: string) => root.querySelector<HTMLElement>(`[data-out="${k}"]`)!;
    const rd = (k: string) => root.querySelector<HTMLElement>(`[data-r="${k}"]`)!;
    const why = root.querySelector<HTMLElement>('[data-why]')!;
    const keys = ['ma', 'mb', 'ya', 'yb'];

    // yield panel
    const BASE = 150, TOP = 22, YMAX = 1200;
    const hy = (v: number) => (v / YMAX) * (BASE - TOP);

    function render() {
      const [MA, MB, YA, YB] = keys.map((k) => parseInt(inp(k).value, 10));
      keys.forEach((k, i) => (outp(k).textContent = String([MA, MB, YA, YB][i])));
      const exp = (MA + MB) / 2, obs = YA + YB, net = obs - exp, best = Math.max(MA, MB);
      const defined = MA > 0 && MB > 0;
      plot.replaceChildren();

      // axis and gridlines
      plot.appendChild(el('line', { x1: 40, y1: BASE, x2: 330, y2: BASE, stroke: INK, 'stroke-width': 1 }));
      plot.appendChild(el('line', { x1: 40, y1: TOP, x2: 40, y2: BASE, stroke: INK, 'stroke-width': 1 }));
      for (const v of [0, 600, 1200]) {
        const y = BASE - hy(v);
        if (v > 0) plot.appendChild(el('line', { x1: 40, y1: y, x2: 330, y2: y, stroke: FAINT, 'stroke-width': 0.7, 'stroke-dasharray': '2 3' }));
        plot.appendChild(txt(36, y + 3, String(v), 'end'));
      }
      plot.appendChild(txt(40, 11, 'yield (g m⁻² of dry biomass)', 'start', 10));

      const bw = 46, cx = [80, 150, 220, 290];
      const bar = (c: number, y0: number, v: number, fill: string, label: string) => {
        const h = hy(v);
        if (h > 0) plot.appendChild(el('rect', { x: c - bw / 2, y: BASE - hy(y0) - h, width: bw, height: h, fill, 'fill-opacity': 0.85 }));
        if (h >= 12) plot.appendChild(txt(c, BASE - hy(y0) - h / 2 + 3, label, 'middle', 9, '#fff', 700));
      };
      bar(cx[0], 0, MA, CA, 'A');
      bar(cx[1], 0, MB, CB, 'B');
      // expected mixture bar: outline only
      plot.appendChild(el('rect', { x: cx[2] - bw / 2, y: BASE - hy(exp), width: bw, height: hy(exp), fill: 'none', stroke: GREY, 'stroke-width': 1.5, 'stroke-dasharray': '4 3' }));
      bar(cx[3], 0, YA, CA, 'A');
      bar(cx[3], YA, YB, CB, 'B');
      // best-monoculture line
      plot.appendChild(el('line', { x1: 40, y1: BASE - hy(best), x2: 330, y2: BASE - hy(best), stroke: INK, 'stroke-width': 1, 'stroke-dasharray': '5 3' }));

      const names = ['Monoculture A', 'Monoculture B', 'Expected mixture', 'Observed mixture'];
      const vals = [MA, MB, exp, obs];
      names.forEach((n, i) => {
        plot.appendChild(txt(cx[i], 163, i === 2 ? 'Expected' : i === 3 ? 'Observed' : n.replace('Monoculture', 'Mono'), 'middle'));
        plot.appendChild(txt(cx[i], 174, (Number.isInteger(vals[i]) ? String(vals[i]) : vals[i].toFixed(1)), 'middle', 9, INK, 700));
      });
      plot.appendChild(txt(330, 188, 'Dashed line across: the better monoculture', 'end'));

      // partition panel
      plot.appendChild(txt(4, 206, 'Net effect split (g m⁻²)', 'start', 10));
      let comp = NaN, sel = NaN, ryA = NaN, ryB = NaN;
      if (defined) {
        ryA = YA / MA; ryB = YB / MB;
        const dA = ryA - 0.5, dB = ryB - 0.5;
        const mdr = (dA + dB) / 2, mm = (MA + MB) / 2;
        comp = 2 * mdr * mm;
        sel = 2 * (((MA - mm) * (dA - mdr) + (MB - mm) * (dB - mdr)) / 2);
        const scale = Math.max(Math.abs(comp), Math.abs(sel), Math.abs(net), 50);
        const ZX = 190, HW = 90;
        plot.appendChild(el('line', { x1: ZX, y1: 212, x2: ZX, y2: 290, stroke: INK, 'stroke-width': 1 }));
        const rows: [string, number, string][] = [['Complementarity', comp, CA], ['Selection', sel, CB], ['Net effect', net, GREY]];
        rows.forEach(([lab, v, col], i) => {
          const y = 218 + i * 26, w = (Math.abs(v) / scale) * HW;
          plot.appendChild(txt(4, y + 11, lab, 'start'));
          if (w > 0.2) plot.appendChild(el('rect', { x: v >= 0 ? ZX : ZX - w, y, width: w, height: 16, fill: col, 'fill-opacity': 0.85 }));
          plot.appendChild(txt(336, y + 11, sgn(v), 'end', 9, INK, 700));
        });
        plot.appendChild(txt(ZX, 297, '0', 'middle'));
      } else {
        plot.appendChild(txt(170, 250, 'RY is undefined when a monoculture yield is 0,', 'middle', 10));
        plot.appendChild(txt(170, 264, 'so there is no partition to draw.', 'middle', 10));
      }

      // readouts
      rd('exp').textContent = `${exp.toFixed(1)} g m⁻²`;
      rd('obs').textContent = `${obs.toFixed(1)} g m⁻²`;
      rd('net').textContent = `${sgn(net)} g m⁻²`;
      rd('ry').textContent = defined ? `${ryA.toFixed(2)}, ${ryB.toFixed(2)}` : 'undefined';
      rd('comp').textContent = defined ? `${sgn(comp)} g m⁻²` : 'undefined';
      rd('sel').textContent = defined ? `${sgn(sel)} g m⁻²` : 'undefined';
      const trans = obs > best;
      rd('best').textContent = `${obs} vs ${best} g m⁻²: ` + (trans ? 'transgressive' : 'not transgressive');

      // status
      const parts: string[] = [];
      if (!defined) {
        parts.push('A species with a monoculture yield of 0 has no relative yield (Y divided by M), so complementarity and selection cannot be computed. The net effect, observed minus expected yield, can still be read from the bars.');
      } else {
        if (Math.abs(net) < 0.05) parts.push('The mixture yields exactly the expected amount, the mean of the monocultures, so the net effect is zero.');
        else if (net > 0) parts.push(`The mixture yields ${obs} against ${exp.toFixed(1)} expected from the mean monoculture, so it overyields by ${net.toFixed(1)} g m⁻².`);
        else parts.push(`The mixture yields ${obs} against ${exp.toFixed(1)} expected from the mean monoculture, so it falls short of the expected yield by ${(-net).toFixed(1)} g m⁻².`);
        const cs = Math.abs(comp) < 0.05 ? 'is zero: on average the species did as well as their monocultures predict' : comp > 0 ? 'is positive: on average the species did better in mixture than their monocultures predict' : 'is negative: on average the species did worse in mixture than their monocultures predict';
        parts.push(`Complementarity ${cs}.`);
        const ss = Math.abs(sel) < 0.05 ? 'is zero: monoculture yield and the change in relative yield do not covary' : sel > 0 ? 'is positive: the species with the higher monoculture yield had the higher change in relative yield (gained more or lost less)' : 'is negative: the species with the lower monoculture yield had the higher change in relative yield (gained more or lost less)';
        parts.push(`Selection ${ss}.`);
      }
      parts.push(trans ? 'The mixture beats its best monoculture: transgressive overyielding.' : obs > exp ? 'It beats the average monoculture but not the best one, so there is no transgressive overyielding.' : 'It does not beat the best monoculture, so there is no transgressive overyielding.');
      why.textContent = parts.join(' ');
    }
    keys.forEach((k) => inp(k).addEventListener('input', render));
    render();
  });
</script>

<style>
  .oyp { padding: var(--ddp-space-3) var(--ddp-space-4) var(--ddp-space-4); margin: var(--ddp-space-5) 0; }
  .oyp-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem; font-weight: 600; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); margin-bottom: var(--ddp-space-3); }
  .oyp-chip { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 400; color: var(--ddp-color-muted); }
  .oyp-svg { display: block; width: 100%; max-width: 560px; margin: 0 auto; height: auto; background: #fff; border: 1px solid var(--ddp-color-line); border-radius: 6px; }
  .oyp-controls { display: grid; grid-template-columns: 1fr 1fr; gap: var(--ddp-space-2) var(--ddp-space-4); margin: var(--ddp-space-3) 0 var(--ddp-space-2); }
  .oyp-slabel { display: flex; flex-direction: column; gap: 0.1rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .oyp-slabel em { font-style: normal; font-weight: 700; color: var(--ddp-color-accent); font-family: var(--ddp-font-mono); }
  .oyp-slabel input { accent-color: var(--ddp-color-accent); width: 100%; }
  .oyp-readout { display: grid; grid-template-columns: 1fr 1fr; gap: var(--ddp-space-2); margin: var(--ddp-space-2) 0; padding: var(--ddp-space-2) var(--ddp-space-3); background: color-mix(in srgb, var(--ddp-color-accent) 8%, transparent); border-radius: 6px; }
  .oyp-readout div { display: flex; flex-direction: column; gap: 0.1rem; min-width: 0; }
  .oyp-readout .oyp-wide { grid-column: 1 / -1; }
  .oyp-readout dt { font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .oyp-readout dd { margin: 0; font-family: var(--ddp-font-mono); font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); font-weight: 700; overflow-wrap: anywhere; }
  .oyp-why { margin: 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); line-height: 1.5; min-height: 6em; }
  .oyp-assume { margin: var(--ddp-space-2) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .oyp-foot { margin: var(--ddp-space-3) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); border-left: 3px solid var(--ddp-color-secondary); padding-left: 0.55rem; }
  @media (max-width: 480px) { .oyp-controls, .oyp-readout { grid-template-columns: 1fr; } }
</style>
