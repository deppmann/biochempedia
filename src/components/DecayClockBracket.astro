---
/**
 * DecayClockBracket — the History of Life lesson's worked problem as something to turn.
 * A decay curve, fraction of parent left = P/(P + D) = (1/2)^n, and a rock column with an ash
 * above and below a fossil bed. The learner sets the measured daughter-to-parent ratio, the
 * clock (uranium-235 to lead-207 with the rounded 704-million-year half-life, or carbon-14 with
 * about 5,730 years) and the lower ash date; the sketch reads off n, the age of the upper ash and
 * the bracket. Self-contained vanilla-TS Astro island. Original.
 */
---

<figure class="dcb card" data-dcb>
  <figcaption class="dcb-head">Decay clock and bracket — date a fossil bed between two ashes<span class="dcb-chip">⚙ original · interactive</span></figcaption>

  <p class="dcb-assume" data-assume>In this sketch: closed system, no initial daughter, one parent and one daughter. A hypothetical zircon, not a real measurement.</p>

  <div class="dcb-figs">
    <svg class="dcb-svg" viewBox="0 0 340 230" role="img" aria-label="Decay curve: fraction of parent left against number of half-lives, with the measured point marked" data-curve></svg>
    <svg class="dcb-svg dcb-rock" viewBox="0 0 220 230" role="img" aria-label="Rock column: upper ash, fossil bed, lower ash, with ages" data-rock></svg>
  </div>

  <div class="dcb-controls">
    <div class="dcb-ctl">
      <label for="dcb-dp-r">Measured daughter-to-parent ratio D/P</label>
      <div class="dcb-pair">
        <input id="dcb-dp-r" type="range" data-in="dpr" min="0" max="15" step="0.5" value="3" />
        <input id="dcb-dp-n" class="dcb-num" type="number" data-in="dpn" min="0" max="1000" step="any" value="3" aria-label="D/P, typed value (the slider stops at 15; you can type larger)" />
      </div>
    </div>
    <div class="dcb-ctl">
      <label for="dcb-clock">Clock</label>
      <select id="dcb-clock" data-in="clock">
        <option value="u">Uranium-235 to lead-207 (rounded 704 million years)</option>
        <option value="c">Carbon-14 (about 5,730 years; range roughly 50,000 years)</option>
      </select>
    </div>
    <div class="dcb-ctl">
      <label for="dcb-lower">Lower ash date, <span data-unit>million years</span></label>
      <input id="dcb-lower" class="dcb-num dcb-wide" type="number" data-in="lower" min="0" max="1000000000" step="any" value="1450" />
    </div>
  </div>

  <dl class="dcb-readout">
    <div><dt>Fraction of parent left, P/(P + D)</dt><dd data-r-f>0.25</dd></div>
    <div><dt>Half-lives, n</dt><dd data-r-n>2</dd></div>
    <div><dt>Age of upper ash</dt><dd data-r-age>1,408 million years</dd></div>
    <div><dt>Fossil bed lies</dt><dd data-r-br>between 1,408 and 1,450 million years</dd></div>
  </dl>

  <p class="dcb-why" data-why role="status"></p>

  <p class="dcb-foot">Keep the rule: fraction left = (1/2)^n, age = n × half-life, and the fossils get a bracket (younger than the lower ash, older than the upper ash), not a point. This is a sketch of the logic; real geochronology uses exact decay constants and corrections.</p>
</figure>

<script>
  const NS = 'http://www.w3.org/2000/svg';
  const ACCENT = '#0e7c86', ORANGE = '#e57200', INK = '#4b4b55', FAINT = '#b9b9c2';
  function el(name: string, attrs: Record<string, string | number>): SVGElement {
    const e = document.createElementNS(NS, name);
    for (const k in attrs) e.setAttribute(k, String(attrs[k]));
    return e;
  }
  function txt(x: number, y: number, s: string, extra: Record<string, string | number> = {}): SVGElement {
    const t = el('text', { x, y, 'font-size': 9, fill: INK, ...extra });
    t.textContent = s;
    return t;
  }
  const fmt = (v: number) => {
    const a = Math.abs(v);
    if (a > 0 && a < 0.01) return Number(v.toPrecision(2)).toString();
    if (a >= 100) return Math.round(v).toLocaleString('en-US');
    if (a >= 10) return (Math.round(v * 10) / 10).toLocaleString('en-US');
    return (Math.round(v * 100) / 100).toLocaleString('en-US');
  };
  const CLOCKS = {
    u: { half: 704, unit: 'million years', short: 'Myr', lowerDefault: 1450 },
    c: { half: 5730, unit: 'years', short: 'yr', lowerDefault: 30000 },
  } as const;
  const C14_LIMIT = 50000;

  document.querySelectorAll<HTMLElement>('[data-dcb]').forEach((root) => {
    const curve = root.querySelector<SVGSVGElement>('[data-curve]')!;
    const rock = root.querySelector<SVGSVGElement>('[data-rock]')!;
    const inp = (s: string) => root.querySelector<HTMLInputElement>(s)!;
    const dpR = inp('[data-in="dpr"]'), dpN = inp('[data-in="dpn"]'), lowerIn = inp('[data-in="lower"]');
    const clockSel = root.querySelector<HTMLSelectElement>('[data-in="clock"]')!;
    const o = (s: string) => root.querySelector<HTMLElement>(s)!;
    const assume = o('[data-assume]'); const ASSUME_U = assume.textContent || ''; const ASSUME_C = 'In this sketch the same arithmetic is applied to carbon-14 with hypothetical dates, only to show the clock’s range; real C-14 dating does not date ash from a built-up daughter.';
    const unitOut = o('[data-unit]'), rF = o('[data-r-f]'), rN = o('[data-r-n]'), rAge = o('[data-r-age]'), rBr = o('[data-r-br]'), why = o('[data-why]');

    const X0 = 44, X1 = 328, Y0 = 22, Y1 = 188, NMAX = 10;
    const px = (n: number) => X0 + (n / NMAX) * (X1 - X0);
    const py = (f: number) => Y1 - f * (Y1 - Y0);

    function readDP(): number {
      const v = parseFloat(dpN.value);
      return isFinite(v) && v >= 0 ? v : 0;
    }

    function drawCurve(dp: number, n: number, f: number) {
      curve.replaceChildren();
      curve.appendChild(el('line', { x1: X0, y1: Y0, x2: X0, y2: Y1, stroke: INK, 'stroke-width': 1 }));
      curve.appendChild(el('line', { x1: X0, y1: Y1, x2: X1, y2: Y1, stroke: INK, 'stroke-width': 1 }));
      for (const fv of [0, 0.25, 0.5, 0.75, 1]) {
        curve.appendChild(el('line', { x1: X0, y1: py(fv), x2: X1, y2: py(fv), stroke: FAINT, 'stroke-width': 0.7, 'stroke-dasharray': '2 3' }));
        curve.appendChild(txt(X0 - 4, py(fv) + 3, String(fv), { 'text-anchor': 'end' }));
      }
      for (let k = 0; k <= NMAX; k++) {
        curve.appendChild(el('line', { x1: px(k), y1: Y1, x2: px(k), y2: Y1 + 3, stroke: INK, 'stroke-width': 1 }));
        curve.appendChild(txt(px(k), Y1 + 13, String(k), { 'text-anchor': 'middle' }));
      }
      curve.appendChild(txt((X0 + X1) / 2, Y1 + 28, 'half-lives elapsed, n', { 'text-anchor': 'middle', 'font-size': 10 }));
      curve.appendChild(txt(X0 - 2, Y0 - 8, 'fraction of parent left = (1/2)^n', { 'font-size': 10 }));
      let d = '';
      for (let i = 0; i <= 200; i++) {
        const nn = (i / 200) * NMAX;
        d += (i === 0 ? 'M' : 'L') + px(nn).toFixed(1) + ' ' + py(Math.pow(0.5, nn)).toFixed(1) + ' ';
      }
      curve.appendChild(el('path', { d: d.trim(), fill: 'none', stroke: ACCENT, 'stroke-width': 2.6 }));
      if (n > 0 && n <= NMAX) {
        curve.appendChild(el('line', { x1: X0, y1: py(f), x2: px(n), y2: py(f), stroke: ORANGE, 'stroke-width': 1.2, 'stroke-dasharray': '3 2' }));
        curve.appendChild(el('line', { x1: px(n), y1: py(f), x2: px(n), y2: Y1, stroke: ORANGE, 'stroke-width': 1.2, 'stroke-dasharray': '3 2' }));
      }
      if (n <= NMAX) {
        curve.appendChild(el('circle', { cx: px(n), cy: py(f), r: 4.5, fill: ORANGE }));
        const right = px(n) < X1 - 110;
        const label = 'D/P = ' + fmt(dp) + ', n = ' + fmt(n);
        curve.appendChild(txt(right ? px(n) + 8 : px(n) - 8, (f > 0.85 ? py(f) + 16 : Math.min(py(f) - 8, Y1 - 6)), label, { 'text-anchor': right ? 'start' : 'end', 'font-weight': 700, fill: ORANGE }));
      } else {
        curve.appendChild(txt(X1 - 4, Y0 + 14, 'n is beyond 10 half-lives', { 'text-anchor': 'end', fill: ORANGE, 'font-weight': 700 }));
      }
    }

    function wrapLabel(parent: SVGSVGElement, x: number, y: number, lines: string[], extra: Record<string, string | number> = {}) {
      lines.forEach((s, i) => parent.appendChild(txt(x, y + i * 11, s, extra)));
    }

    function drawRock(upperLabel: string, lowerLabel: string, bedLabel: string[], state: 'ok' | 'bad' | 'none') {
      rock.replaceChildren();
      const cx = 12, w = 74;
      // sediment layers
      rock.appendChild(el('rect', { x: cx, y: 24, width: w, height: 182, fill: '#efe6d6', stroke: INK, 'stroke-width': 1 }));
      // upper ash
      rock.appendChild(el('rect', { x: cx, y: 56, width: w, height: 16, fill: '#b9b9c2', stroke: INK, 'stroke-width': 1 }));
      // lower ash
      rock.appendChild(el('rect', { x: cx, y: 158, width: w, height: 16, fill: '#b9b9c2', stroke: INK, 'stroke-width': 1 }));
      // fossil bed
      rock.appendChild(el('rect', { x: cx, y: 104, width: w, height: 22, fill: state === 'bad' ? '#f3d6d6' : '#f6e3c4', stroke: ORANGE, 'stroke-width': 1.4 }));
      rock.appendChild(txt(cx + w / 2, 119, 'fossil bed', { 'text-anchor': 'middle', 'font-weight': 700, fill: ORANGE }));
      rock.appendChild(txt(cx + w / 2, 16, 'younger', { 'text-anchor': 'middle' }));
      rock.appendChild(txt(cx + w / 2, 220, 'older', { 'text-anchor': 'middle' }));
      // labels at right
      const lx = cx + w + 8;
      wrapLabel(rock, lx, 62, ['upper ash', upperLabel], { 'font-weight': 700 });
      wrapLabel(rock, lx, 108, bedLabel, { fill: state === 'bad' ? '#a02020' : ORANGE, 'font-weight': 700 });
      wrapLabel(rock, lx, 164, ['lower ash', lowerLabel], { 'font-weight': 700 });
    }

    function render() {
      const key = clockSel.value === 'c' ? 'c' : 'u';
      const clk = CLOCKS[key];
      const dp = readDP();
      dpR.value = String(Math.min(dp, 15));
      unitOut.textContent = clk.unit;
      assume.textContent = key === 'c' ? ASSUME_C : ASSUME_U;
      const lowerRaw = parseFloat(lowerIn.value);
      const lower = isFinite(lowerRaw) && lowerRaw >= 0 ? lowerRaw : 0;

      const f = 1 / (1 + dp);            // P/(P + D)
      const n = Math.log2(1 + dp);        // f = (1/2)^n
      const age = n * clk.half;
      const ageStr = fmt(age) + ' ' + clk.unit;
      const lowerStr = fmt(lower) + ' ' + clk.unit;

      rF.textContent = fmt(f);
      rN.textContent = fmt(n);
      drawCurve(dp, n, f);

      const tooOld = key === 'c' && age > C14_LIMIT;
      const lowerTooOld = key === 'c' && lower > C14_LIMIT;
      let state: 'ok' | 'bad' | 'none' = 'ok';
      let bedLabel: string[] = [];
      let msg = '';
      const base = 'D/P = ' + fmt(dp) + ' means the starting parent was P + D = ' + fmt(1 + dp) + ' P, so the fraction left is ' + fmt(f) + ' = (1/2)^' + fmt(n) + '.';

      if (dp === 0) {
        state = 'none';
        rAge.textContent = '0 ' + clk.unit;
        rBr.textContent = 'no bracket';
        bedLabel = ['no bracket'];
        msg = 'D/P = 0: no daughter has built up, so the fraction left is 1, n = 0 and the formula gives an age of 0, so there is no useful bracket; this sketch draws none.';
      } else if (tooOld) {
        state = 'none';
        rAge.textContent = 'beyond the clock’s range';
        rBr.textContent = 'no bracket';
        bedLabel = ['no bracket'];
        msg = base + ' With a half-life of about 5,730 years that is ' + ageStr + ' by the formula, but after roughly 50,000 years too little carbon-14 remains to measure. This age is beyond what the clock can give; a deep-time clock such as uranium is needed.';
      } else if (lower <= age) {
        state = 'bad';
        rAge.textContent = ageStr;
        rBr.textContent = 'inconsistent';
        bedLabel = ['inconsistent'];
        msg = base + ' Age ≈ n × half-life = ' + fmt(n) + ' × ' + fmt(clk.half) + ' ≈ ' + ageStr + '. The lower ash, ' + lowerStr + ', is not older than the upper ash, so the bracket (younger than the lower ash, older than the upper ash) cannot be formed. Recheck the dates, or the assumptions of a closed system and no initial daughter.';
      } else {
        rAge.textContent = ageStr;
        rBr.textContent = 'between ' + ageStr + ' and ' + lowerStr;
        bedLabel = ['between', fmt(age), 'and ' + fmt(lower)];
        msg = base + ' Age ≈ n × half-life = ' + fmt(n) + ' × ' + fmt(clk.half) + ' ≈ ' + ageStr + '. Check: (1 − f)/f ≈ ' + fmt(dp) + '. The fossils are younger than ' + lowerStr + ' and older than ' + ageStr + ': a bracket, not a point.';
        if (lowerTooOld) msg += ' The lower ash date is beyond the roughly 50,000 years carbon-14 can reach, so it would need another clock.';
      }

      drawRock(
        state === 'none' && (dp === 0 || tooOld) ? (dp === 0 ? '0 ' + clk.short : 'not measurable') : fmt(age) + ' ' + clk.short,
        fmt(lower) + ' ' + clk.short,
        bedLabel,
        state,
      );
      why.textContent = msg;
    }

    dpR.addEventListener('input', () => { dpN.value = dpR.value; render(); });
    dpN.addEventListener('input', render);
    lowerIn.addEventListener('input', render);
    clockSel.addEventListener('change', () => {
      lowerIn.value = String(CLOCKS[clockSel.value === 'c' ? 'c' : 'u'].lowerDefault);
      render();
    });
    render();
  });
</script>

<style>
  .dcb { padding: var(--ddp-space-3) var(--ddp-space-4) var(--ddp-space-4); margin: var(--ddp-space-5) 0; }
  .dcb-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem; font-weight: 600; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); margin-bottom: var(--ddp-space-3); }
  .dcb-chip { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 400; color: var(--ddp-color-muted); }
  .dcb-assume { margin: 0 0 var(--ddp-space-2); font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .dcb-figs { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); gap: var(--ddp-space-3); align-items: start; }
  .dcb-svg { display: block; width: 100%; height: auto; background: #fff; border: 1px solid var(--ddp-color-line); border-radius: 6px; }
  .dcb-controls { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--ddp-space-2); margin: var(--ddp-space-3) 0 var(--ddp-space-2); }
  .dcb-ctl { min-width: 0; display: flex; flex-direction: column; gap: 0.2rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .dcb-pair { min-width: 0; flex-wrap: wrap; display: flex; gap: var(--ddp-space-2); align-items: center; }
  .dcb-pair input[type='range'] { flex: 1 1 8rem; min-width: 0; width: 100%; accent-color: var(--ddp-color-accent); }
  .dcb-num { width: 5.5rem; max-width: 100%; box-sizing: border-box; font-family: var(--ddp-font-mono); font-size: var(--ddp-text-sm); padding: 0.15rem 0.3rem; }
  .dcb-wide { width: 9rem; max-width: 100%; }
  .dcb-ctl select { width: 100%; font-size: var(--ddp-text-xs); padding: 0.2rem 0.3rem; max-width: 100%; }
  .dcb-readout { display: grid; grid-template-columns: 1fr 1fr; gap: var(--ddp-space-2); margin: var(--ddp-space-2) 0; padding: var(--ddp-space-2) var(--ddp-space-3); background: color-mix(in srgb, var(--ddp-color-accent) 8%, transparent); border-radius: 6px; }
  .dcb-readout div { display: flex; flex-direction: column; gap: 0.1rem; min-width: 0; }
  .dcb-readout dt { font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .dcb-readout dd { margin: 0; font-family: var(--ddp-font-mono); font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); font-weight: 700; overflow-wrap: anywhere; }
  .dcb-why { margin: 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); line-height: 1.5; min-height: 4.5em; }
  .dcb-foot { margin: var(--ddp-space-3) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); border-left: 3px solid var(--ddp-color-secondary); padding-left: 0.55rem; }
  @media (max-width: 560px) {
    .dcb-figs { grid-template-columns: 1fr; }
    .dcb-rock { max-width: 320px; margin: 0 auto; }
  }
</style>
