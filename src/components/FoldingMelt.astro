---
/**
 * FoldingMelt — the stability companion to the Ramachandran explorer. A two-state
 * thermal denaturation curve (fraction folded vs temperature) showing that folding
 * is cooperative and all-or-none: the protein stays folded, then melts over a
 * narrow window around its Tm. Sliders for Tm and cooperativity (ΔH), plus a
 * "stabilizing change" toggle (a disulfide / thermophile substitution) that shifts
 * Tm up. A marker at body temperature reads out the folded fraction, making
 * marginal stability concrete. Self-contained vanilla-TS Astro island. Original.
 */
---

<figure class="fm card" data-folding>
  <figcaption class="fm-head">Folding is cooperative — the melt curve<span class="fm-chip">⚙ original · interactive</span></figcaption>

  <svg class="fm-svg" viewBox="0 0 320 220" role="img" aria-label="Fraction of protein folded versus temperature, a sigmoidal melting curve with the melting temperature marked" data-plot></svg>

  <div class="fm-controls">
    <label class="fm-slabel"><span>Starting melting temperature T<sub>m</sub> <em data-out="tm">60</em> <em>°C</em></span>
      <input type="range" data-in="tm" min="40" max="95" step="1" value="60" />
    </label>
    <label class="fm-slabel"><span>Cooperativity (ΔH) <em data-out="coop">sharp</em></span>
      <input type="range" data-in="coop" min="1" max="6" step="0.5" value="4" />
    </label>
    <label class="fm-check"><input type="checkbox" data-stab /> <span>add a stabilizing change (disulfide / thermophile): T<sub>m</sub> +18 °C</span></label>
  </div>

  <dl class="fm-readout">
    <div><dt>Folded at 37 °C</dt><dd data-r-f37>~100%</dd></div>
    <div><dt>Melting temperature</dt><dd data-r-tm>60 °C</dd></div>
  </dl>
  <p class="fm-why" data-why role="status">A protein does not loosen gradually; it holds its shape, then unravels over a few degrees. That sharp transition is the signature of cooperative folding.</p>

  <p class="fm-foot">Native proteins are only marginally stable — the folded state beats the unfolded one by the energy of just a few hydrogen bonds. A single disulfide or a thermophile's extra salt bridge can push Tm well up.</p>
</figure>

<script>
  const NS = 'http://www.w3.org/2000/svg';
  const ACCENT = '#0e7c86', ORANGE = '#e57200', NAVY = '#232d4b', INK = '#4b4b55', FAINT = '#b9b9c2', GHOST = '#9a9aa3';
  const STAB = 18; // °C shift from the stabilizing change
  function el(name: string, attrs: Record<string, string | number>): SVGElement {
    const e = document.createElementNS(NS, name);
    for (const k in attrs) e.setAttribute(k, String(attrs[k]));
    return e;
  }
  const reduceMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-folding]').forEach((root) => {
    const tmIn = root.querySelector<HTMLInputElement>('[data-in="tm"]')!;
    const coopIn = root.querySelector<HTMLInputElement>('[data-in="coop"]')!;
    const stab = root.querySelector<HTMLInputElement>('[data-stab]')!;
    const tmOut = root.querySelector<HTMLElement>('[data-out="tm"]')!;
    const coopOut = root.querySelector<HTMLElement>('[data-out="coop"]')!;
    const plot = root.querySelector<SVGSVGElement>('[data-plot]')!;
    const rF37 = root.querySelector<HTMLElement>('[data-r-f37]')!;
    const rTm = root.querySelector<HTMLElement>('[data-r-tm]')!;
    const why = root.querySelector<HTMLElement>('[data-why]')!;

    const X0 = 40, X1 = 304, Y0 = 16, Y1 = 192, TMIN = 20, TMAX = 100;
    const px = (t: number) => X0 + ((t - TMIN) / (TMAX - TMIN)) * (X1 - X0);
    const py = (f: number) => Y1 - f * (Y1 - Y0);
    function folded(T: number, tm: number, coop: number) { return 1 / (1 + Math.exp((T - tm) * coop * 0.12)); }
    function curve(tm: number, coop: number) {
      let d = '';
      for (let t = TMIN; t <= TMAX; t += 0.5) { d += (t === TMIN ? 'M' : 'L') + px(t).toFixed(1) + ' ' + py(folded(t, tm, coop)).toFixed(1) + ' '; }
      return d.trim();
    }
    // Keep SVG text legible when the plot is drawn narrow (phones): never below ~9.5 px on screen.
    let fs = (n: number) => n;
    function text(x: number, y: number, str: string, size: number, fill: string, anchor = 'middle', weight?: number) {
      const t = el('text', { x, y, 'text-anchor': anchor, 'font-size': fs(size), fill });
      if (weight) t.setAttribute('font-weight', String(weight));
      t.textContent = str; plot.appendChild(t); return t;
    }

    // The stabilizing shift is tweened so the student SEES the curve slide right.
    let shown = 0; // current drawn shift (°C)
    let raf = 0;

    function draw() {
      const baseTm = parseInt(tmIn.value, 10);
      const coop = parseFloat(coopIn.value);
      const tm = baseTm + shown;
      const target = baseTm + (stab.checked ? STAB : 0);
      const w = plot.getBoundingClientRect().width || 320;
      const k = w / 320;
      fs = (n: number) => Math.max(n, 9.5 / k);

      tmOut.textContent = String(baseTm);
      coopOut.textContent = coop < 2.5 ? 'gradual' : coop < 4.5 ? 'sharp' : 'switch-like';
      plot.replaceChildren();
      // axes + gridlines
      plot.appendChild(el('line', { x1: X0, y1: Y0, x2: X0, y2: Y1, stroke: INK, 'stroke-width': 1 }));
      plot.appendChild(el('line', { x1: X0, y1: Y1, x2: X1, y2: Y1, stroke: INK, 'stroke-width': 1 }));
      for (const f of [0.5, 1]) { plot.appendChild(el('line', { x1: X0, y1: py(f), x2: X1, y2: py(f), stroke: FAINT, 'stroke-width': 0.7, 'stroke-dasharray': '2 3' })); text(X0 - 4, py(f) + 3, (f * 100) + '%', 8, INK, 'end'); }
      text(X0 - 4, py(0) + 3, '0%', 8, INK, 'end');
      for (const T of [20, 37, 60, 80, 100]) { plot.appendChild(el('line', { x1: px(T), y1: Y1, x2: px(T), y2: Y1 + 3, stroke: INK, 'stroke-width': 1 })); text(px(T), Y1 + 13, String(T), 8, INK); }
      text((X0 + X1) / 2, Y1 + 26, 'temperature (°C)', 9, INK);
      text(X0 + 4, Y0 - 4, 'fraction folded', 9, INK, 'start');
      // body temp marker, labelled at its foot so it never collides with the orange point
      plot.appendChild(el('line', { x1: px(37), y1: Y0, x2: px(37), y2: Y1, stroke: FAINT, 'stroke-width': 1.2, 'stroke-dasharray': '3 3' }));
      text(px(37) + 3, Y1 - 5, 'body temp.', 7.5, INK, 'start');
      // wild-type ghost curve when the stabilizing change is on
      if (shown > 0.5) {
        plot.appendChild(el('path', { d: curve(baseTm, coop), fill: 'none', stroke: GHOST, 'stroke-width': 1.6, 'stroke-dasharray': '4 3' }));
        if (baseTm >= TMIN && baseTm <= TMAX) text(px(baseTm) - 5, py(0.5) + 12, 'before', 7.5, GHOST, 'end');
      }
      // curve
      plot.appendChild(el('path', { d: curve(tm, coop), fill: 'none', stroke: ACCENT, 'stroke-width': 2.6 }));
      // Tm marker (50% folded), labelled beside the point rather than on the curve
      if (tm >= TMIN && tm <= TMAX) {
        plot.appendChild(el('line', { x1: px(tm), y1: py(0.5), x2: px(tm), y2: Y1, stroke: NAVY, 'stroke-width': 1.2, 'stroke-dasharray': '4 3' }));
        plot.appendChild(el('circle', { cx: px(tm), cy: py(0.5), r: 4, fill: NAVY }));
        const right = px(tm) < X1 - 60;
        text(px(tm) + (right ? 7 : -7), py(0.5) - 5, `Tm = ${Math.round(tm)} °C`, 8, NAVY, right ? 'start' : 'end', 700);
      }
      // 37 °C folded fraction point
      const f37 = folded(37, tm, coop);
      plot.appendChild(el('circle', { cx: px(37), cy: py(f37), r: 4, fill: ORANGE, stroke: '#fff', 'stroke-width': 1 }));

      // readouts always describe the TARGET state (not the mid-tween frame)
      const f37t = folded(37, target, coop);
      rF37.textContent = (f37t > 0.995 ? '~100' : Math.round(f37t * 100)) + '%';
      rTm.textContent = target + ' °C';
      plot.setAttribute('aria-label', `Melting curve: fraction folded falls from 100% to 0% around Tm = ${target} °C; ${Math.round(f37t * 100)}% folded at body temperature, 37 °C.`);
    }

    function explain() {
      const baseTm = parseInt(tmIn.value, 10);
      const coop = parseFloat(coopIn.value);
      const tm = baseTm + (stab.checked ? STAB : 0);
      const f37 = folded(37, tm, coop);
      why.textContent = stab.checked
        ? `The stabilizing change pushed Tm from ${baseTm} to ${tm} °C (dashed curve = before). The protein now resists heat that would have melted the original; this is how thermophiles keep their enzymes folded in hot springs.`
        : f37 < 0.9
          ? `With Tm at ${tm} °C the protein is already partly unfolded at body temperature (only ${Math.round(f37 * 100)}% folded). A destabilizing change can drag Tm down toward 37 °C, which is how many disease mutations act.`
          : coop < 2.5
            ? 'With low cooperativity the protein loosens gradually over a wide temperature range. Real single-domain proteins are sharper than this: the whole structure tends to go at once.'
            : 'A protein does not loosen gradually; it holds its shape, then unravels over a few degrees around Tm. That sharp transition is the signature of cooperative folding: the whole structure goes at once.';
    }

    function animateTo() {
      const target = stab.checked ? STAB : 0;
      cancelAnimationFrame(raf);
      if (reduceMotion() || shown === target) { shown = target; draw(); return; }
      const from = shown, t0 = performance.now(), dur = 600;
      const step = (now: number) => {
        const u = Math.min(1, (now - t0) / dur);
        const e = u < 0.5 ? 2 * u * u : 1 - Math.pow(-2 * u + 2, 2) / 2; // ease-in-out
        shown = from + (target - from) * e;
        draw();
        if (u < 1) raf = requestAnimationFrame(step);
      };
      raf = requestAnimationFrame(step);
    }

    tmIn.addEventListener('input', () => { draw(); explain(); });
    coopIn.addEventListener('input', () => { draw(); explain(); });
    stab.addEventListener('change', () => { animateTo(); explain(); });
    new ResizeObserver(() => draw()).observe(plot);
    draw(); explain();
  });
</script>

<style>
  .fm { padding: var(--ddp-space-3) var(--ddp-space-4) var(--ddp-space-4); margin: var(--ddp-space-5) 0; }
  .fm-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem; font-weight: 600; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); margin-bottom: var(--ddp-space-3); }
  .fm-chip { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 400; color: var(--ddp-color-muted); }
  .fm-svg { width: 100%; height: auto; background: #fff; border: 1px solid var(--ddp-color-line); border-radius: 6px; }
  .fm-controls { display: grid; grid-template-columns: 1fr 1fr; gap: var(--ddp-space-2) var(--ddp-space-4); margin: var(--ddp-space-3) 0 var(--ddp-space-2); align-items: end; }
  .fm-slabel { display: flex; flex-direction: column; gap: 0.15rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .fm-slabel em { font-style: normal; font-weight: 700; color: var(--ddp-color-accent); font-family: var(--ddp-font-mono); }
  .fm-slabel input { accent-color: var(--ddp-color-accent); }
  .fm-check { grid-column: 1 / -1; display: flex; align-items: center; gap: 0.35rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .fm-check input { accent-color: var(--ddp-color-accent); }
  .fm-readout { display: grid; grid-template-columns: 1fr 1fr; gap: var(--ddp-space-2); margin: var(--ddp-space-2) 0; padding: var(--ddp-space-2) var(--ddp-space-3); background: color-mix(in srgb, var(--ddp-color-accent) 8%, transparent); border-radius: 6px; }
  .fm-readout div { display: flex; flex-direction: column; gap: 0.1rem; }
  .fm-readout dt { font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .fm-readout dd { margin: 0; font-family: var(--ddp-font-mono); font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); font-weight: 700; }
  .fm-why { margin: 0; font-size: var(--ddp-text-sm); color: var(--ddp-color-ink); line-height: 1.5; min-height: 4.5em; }
  .fm-foot { margin: var(--ddp-space-3) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); border-left: 3px solid var(--ddp-color-secondary); padding-left: 0.55rem; }
</style>
