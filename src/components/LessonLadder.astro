---
/* =============================================================================
   LessonLadder: the "Where this lesson sits" card on a high school lesson.
   One row per step of the depth ladder (Life Science grade 7, Biology,
   Biology II, College). The step below and the step above open in place as
   native <details> (no script needed); the college row links to the lessons on
   this site that take the idea further. The review and preview texts are the
   lesson's explainLevels 'grade7' and 'bio2'. A grade 7 lesson (step 1) shows
   the Biology step as a preview (explainLevels 'highschool') with links to the
   high school lessons in ladder.biology; a high school lesson links its grade 7
   lessons (ladder.grade7) under the grade 7 review.
   ============================================================================ */
import { getCollection } from 'astro:content';
import DepthLadder from './DepthLadder.astro';

interface Props {
  ladder: {
    sol: string[];
    practices: string[];
    essentialQuestion: string;
    lifeScience?: string;
    biology2?: string;
    college: string[];
    grade7?: string[];
    biology?: string[];
  };
  explainLevels: { level: string; label: string; text: string }[];
  /** The step this lesson is on (1 for Life Science, 2 for Biology). */
  step?: 1 | 2 | 3 | 4;
}
const { ladder, explainLevels, step = 2 } = Astro.props;
const paras = (t: string) => t.split(/\n\n+/).map((p) => p.trim()).filter(Boolean);
const grade7 = explainLevels.find((l) => l.level === 'grade7');
const bio2 = explainLevels.find((l) => l.level === 'bio2');
const hsPreview = explainLevels.find((l) => l.level === 'highschool');
// Only published lessons are linked; a slug that is missing or still a draft is skipped
// (`astro dev` also links drafts, as the rest of the lesson page does).
const wanted = [...ladder.college, ...(ladder.grade7 ?? []), ...(ladder.biology ?? [])];
const published = await getCollection('lessons', ({ data }) => (import.meta.env.DEV || !data.draft) && wanted.includes(data.slug));
const linked = (slugs: string[] = []) => slugs
  .map((slug) => published.find((l) => l.data.slug === slug))
  .filter((l): l is NonNullable<typeof l> => Boolean(l))
  .map((l) => ({ slug: l.data.slug, title: l.data.title }));
const college = linked(ladder.college);
const grade7Lessons = linked(ladder.grade7);
const biologyLessons = linked(ladder.biology);
const here = (n: number) => n === step;
---
<section class="wrap ladder-wrap" aria-labelledby="ladder-h">
  <div class="ladder card">
    <div class="ladder-head">
      <h2 id="ladder-h">Where this lesson sits</h2>
      <DepthLadder step={step} size="md" />
    </div>
    <ul class="ladder-chips" aria-label="Standards">
      {ladder.sol.map((c) => <li class="ladder-chip">Virginia SOL {c}</li>)}
      {ladder.practices.length > 0 && <li class="ladder-chip is-soft">Practices {ladder.practices.join(', ')}</li>}
    </ul>
    <p class="ladder-q">Essential question: <strong>{ladder.essentialQuestion}</strong></p>

    <ol class="ladder-steps">
      <li class:list={['ladder-step', { 'is-here': here(1) }]} aria-current={here(1) ? 'step' : undefined}>
        <p class="ls-name">
          <span class="ls-num" aria-hidden="true">1</span> Life Science (grade 7)
          {here(1) ? <span class="ls-code">{ladder.sol.join(', ')}</span> : ladder.lifeScience && <span class="ls-code">{ladder.lifeScience}</span>}
          {here(1) && <span class="ls-here">You are here</span>}
        </p>
        {here(1) ? <p class="ls-note">This lesson</p> : grade7 && (
          <details class="ls-details">
            <summary>Review it at grade 7 level</summary>
            <div class="ls-body">{paras(grade7.text).map((p) => <p>{p}</p>)}</div>
          </details>
        )}
        {!here(1) && grade7Lessons.length > 0 && (
          <ul class="ls-links">
            {grade7Lessons.map((c) => (
              <li><a href={`/lessons/${c.slug}/`}><span class="ls-link-title">{c.title}</span> <span class="ls-link-go">Go back to the grade 7 lesson →</span></a></li>
            ))}
          </ul>
        )}
      </li>
      <li class:list={['ladder-step', { 'is-here': here(2) }]} aria-current={here(2) ? 'step' : undefined}>
        <p class="ls-name">
          <span class="ls-num" aria-hidden="true">2</span> Biology
          {here(2) && <span class="ls-code">{ladder.sol.join(', ')}</span>}
          {here(2) && <span class="ls-here">You are here</span>}
        </p>
        {here(2) ? <p class="ls-note">This lesson</p> : hsPreview && (
          <details class="ls-details">
            <summary>Preview it at high school level</summary>
            <div class="ls-body">{paras(hsPreview.text).map((p) => <p>{p}</p>)}</div>
          </details>
        )}
        {!here(2) && biologyLessons.length > 0 && (
          <ul class="ls-links">
            {biologyLessons.map((c) => (
              <li><a href={`/lessons/${c.slug}/`}><span class="ls-link-title">{c.title}</span> <span class="ls-link-go">Go up to the Biology lesson →</span></a></li>
            ))}
          </ul>
        )}
      </li>
      <li class:list={['ladder-step', { 'is-here': here(3) }]} aria-current={here(3) ? 'step' : undefined}>
        <p class="ls-name">
          <span class="ls-num" aria-hidden="true">3</span> Biology II
          {ladder.biology2 && <span class="ls-code">{ladder.biology2}</span>}
          {here(3) && <span class="ls-here">You are here</span>}
        </p>
        {bio2 && (
          <details class="ls-details">
            <summary>Preview where it goes next</summary>
            <div class="ls-body">{paras(bio2.text).map((p) => <p>{p}</p>)}</div>
          </details>
        )}
      </li>
      <li class:list={['ladder-step', { 'is-here': here(4) }]} aria-current={here(4) ? 'step' : undefined}>
        <p class="ls-name">
          <span class="ls-num" aria-hidden="true">4</span> College
          {here(4) && <span class="ls-here">You are here</span>}
        </p>
        {college.length > 0 && (
          <ul class="ls-links">
            {college.map((c) => (
              <li><a href={`/lessons/${c.slug}/`}><span class="ls-link-title">{c.title}</span> <span class="ls-link-go">Go further at college level →</span></a></li>
            ))}
          </ul>
        )}
      </li>
    </ol>
  </div>
</section>

<style>
  .ladder-wrap { margin-bottom: var(--ddp-space-6); }
  .ladder { padding: var(--ddp-space-4) var(--ddp-space-6); }
  .ladder-head {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;
    gap: var(--ddp-space-3); margin-bottom: var(--ddp-space-3);
  }
  .ladder-head h2 { margin: 0; font-size: var(--ddp-text-lg); }
  .ladder-chips {
    list-style: none; margin: 0 0 var(--ddp-space-3); padding: 0;
    display: flex; flex-wrap: wrap; gap: var(--ddp-space-2);
  }
  .ladder-chip {
    font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 600;
    letter-spacing: 0.03em; color: var(--ddp-color-primary);
    padding: 0.2em 0.65em; border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--ddp-color-accent) 45%, var(--ddp-color-line));
    background: color-mix(in srgb, var(--ddp-color-accent) 10%, var(--ddp-color-surface));
  }
  .ladder-chip.is-soft { font-weight: 400; color: var(--ddp-color-ink-soft); background: var(--ddp-color-surface); border-color: var(--ddp-color-line); }
  .ladder-q { margin: 0 0 var(--ddp-space-4); font-size: var(--ddp-text-base); line-height: 1.5; color: var(--ddp-color-ink); }
  .ladder-steps {
    list-style: none; margin: 0; padding: 0;
    display: flex; flex-direction: column;
    border-top: 1px solid var(--ddp-color-line);
  }
  .ladder-step {
    padding: var(--ddp-space-3) var(--ddp-space-3);
    border-bottom: 1px solid var(--ddp-color-line);
  }
  .ladder-step.is-here {
    background: color-mix(in srgb, var(--ddp-color-accent) 8%, var(--ddp-color-surface));
    box-shadow: inset 3px 0 0 var(--ddp-color-accent);
  }
  .ls-name {
    margin: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 0.35rem 0.6rem;
    font-weight: 600; color: var(--ddp-color-primary); font-size: var(--ddp-text-sm);
  }
  .ls-num {
    display: inline-grid; place-items: center; width: 1.4rem; height: 1.4rem; flex: none;
    border-radius: 50%; font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs);
    border: 1px solid var(--ddp-color-line); color: var(--ddp-color-ink-soft);
  }
  .is-here .ls-num { background: var(--ddp-color-accent); border-color: var(--ddp-color-accent); color: #fff; }
  .ls-code { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 400; color: var(--ddp-color-muted); }
  .ls-here {
    font-family: var(--ddp-font-mono); font-size: 0.68rem; font-weight: 700; letter-spacing: 0.06em;
    text-transform: uppercase; color: var(--ddp-color-accent);
  }
  .ls-note { margin: var(--ddp-space-1) 0 0 2rem; font-size: var(--ddp-text-sm); color: var(--ddp-color-ink-soft); }
  .ls-details { margin: var(--ddp-space-1) 0 0 2rem; }
  .ls-details > summary {
    display: inline-flex; align-items: center; min-height: 44px; cursor: pointer;
    font-size: var(--ddp-text-sm); font-weight: 600; color: var(--ddp-color-accent);
  }
  .ls-body { padding: 0 0 var(--ddp-space-2); max-width: 68ch; }
  .ls-body p { margin: 0 0 var(--ddp-space-3); font-size: var(--ddp-text-sm); line-height: 1.6; color: var(--ddp-color-ink); }
  .ls-body p:last-child { margin-bottom: 0; }
  .ls-links { list-style: none; margin: var(--ddp-space-1) 0 0 2rem; padding: 0; display: flex; flex-direction: column; gap: var(--ddp-space-1); }
  .ls-links a {
    display: inline-flex; flex-wrap: wrap; align-items: center; gap: 0 0.5rem; min-height: 44px;
    font-size: var(--ddp-text-sm); text-underline-offset: 3px;
  }
  .ls-link-title { font-weight: 600; color: var(--ddp-color-ink); }
  .ls-link-go { color: var(--ddp-color-accent); }
  @media (max-width: 600px) {
    .ladder { padding: var(--ddp-space-3) var(--ddp-space-4); }
    .ladder-step { padding-inline: var(--ddp-space-2); }
    .ls-note, .ls-details, .ls-links { margin-left: 0; }
  }
</style>
