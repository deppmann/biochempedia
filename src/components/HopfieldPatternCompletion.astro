---
/**
 * HopfieldPatternCompletion — the lesson's four-unit Hopfield network as a sketch. One stored
 * pattern x = (1, 1, -1, -1), w_ij = x_i x_j / 4, w_ii = 0, zero thresholds. The learner sets a cue,
 * updates units one at a time in order 1 to 4 (s_i = sign of the field h_i, unchanged at exactly
 * zero), and reads the fields, the overlap with x and the energy E = -(overlap^2 - 4)/8. Original.
 */
---

<figure class="hp card" data-hpc>
  <figcaption class="hp-head">Completing a pattern — a four-unit Hopfield network<span class="hp-chip">⚙ original · interactive</span></figcaption>

  <svg class="hp-svg" viewBox="0 0 340 238" role="img" aria-label="Four units drawn as squares at the corners of a square, filled for plus one and open for minus one, joined by six lines labelled with their weights of plus or minus one quarter" data-plot></svg>

  <fieldset class="hp-cue">
    <legend>Cue: toggle a unit to flip it (or click it in the picture)</legend>
    <div class="hp-toggles">
      <button type="button" class="hp-tog" data-tog="0" aria-pressed="true"></button>
      <button type="button" class="hp-tog" data-tog="1" aria-pressed="true"></button>
      <button type="button" class="hp-tog" data-tog="2" aria-pressed="true"></button>
      <button type="button" class="hp-tog" data-tog="3" aria-pressed="true"></button>
    </div>
  </fieldset>
  <div class="hp-btns">
    <button type="button" class="hp-btn" data-next>Update next unit</button>
    <button type="button" class="hp-btn" data-run>Run to stable</button>
    <button type="button" class="hp-btn hp-btn2" data-reset>Reset to the lesson’s cue</button>
  </div>

  <dl class="hp-readout hp-fields" data-fields></dl>
  <dl class="hp-readout hp-sum">
    <div><dt>Overlap with x = Σ x_i s_i</dt><dd data-r-ov>—</dd></div>
    <div><dt>Energy E = −[(overlap)² − 4] / 8</dt><dd data-r-e>—</dd></div>
    <div><dt>Updates so far | energy rises</dt><dd data-r-count>—</dd></div>
  </dl>
  <p class="hp-why" data-why role="status">—</p>

  <p class="hp-assume">In this sketch: four units of +1 or −1, one stored pattern x = (1, 1, −1, −1), w_ij = x_i x_j / 4 with w_ii = 0, zero thresholds, units updated one at a time in order 1 to 4, s_i = sign of the field, and a unit keeps its value if its field is exactly zero. These are the lesson’s teaching values, not hippocampal measurements.</p>
  <p class="hp-foot">Rule to keep: each unit takes the sign of the weighted sum of the others, so the state slides downhill in energy to a stored pattern or its inverse; CA3’s recurrent connections are often modelled this way, the model completes a pattern from part of it, capacity is limited, and more stored patterns give spurious mixtures.</p>
</figure>

<script>
  const NS = 'http://www.w3.org/2000/svg';
  const ACCENT = '#0e7c86', ORANGE = '#e57200', INK = '#4b4b55';
  const X = [1, 1, -1, -1];            // stored pattern from the lesson
  const CUE = [-1, 1, -1, -1];         // the lesson's corrupted cue
  const POS: Array<[number, number]> = [[90, 62], [250, 62], [250, 172], [90, 172]]; // units 1..4
  const HALF = 18;
  const MINUS = '−';

  function el(name: string, attrs: Record<string, string | number>): SVGElement {
    const e = document.createElementNS(NS, name);
    for (const k in attrs) e.setAttribute(k, String(attrs[k]));
    return e;
  }
  function sg(n: number): string { return n > 0 ? '+' + n : n < 0 ? MINUS + Math.abs(n) : '0'; }
  function quarters(n: number): string { return n === 0 ? '0' : (n > 0 ? '+' : MINUS) + Math.abs(n) + '/4'; }
  function wq(i: number, j: number): number { return i === j ? 0 : X[i] * X[j]; } // weight in quarters
  function fieldQ(s: number[], i: number): number { let h = 0; for (let j = 0; j < 4; j++) h += wq(i, j) * s[j]; return h; }
  function overlap(s: number[]): number { return s.reduce((a, v, i) => a + X[i] * v, 0); }
  function energy(s: number[]): number { const ov = overlap(s); return -(ov * ov - 4) / 8; }
  function ef(e: number): string { return e === 0 ? '0.00' : (e < 0 ? MINUS : '+') + Math.abs(e).toFixed(2); }
  function vec(s: number[]): string { return '(' + s.map(sg).join(', ') + ')'; }
  function isStable(s: number[]): boolean {
    for (let i = 0; i < 4; i++) { const h = fieldQ(s, i); if (h !== 0 && Math.sign(h) !== s[i]) return false; }
    return true;
  }

  document.querySelectorAll<HTMLElement>('[data-hpc]').forEach((root) => {
    const plotQ = root.querySelector<SVGSVGElement>('[data-plot]');
    const fieldsDlQ = root.querySelector<HTMLElement>('[data-fields]');
    const rOvQ = root.querySelector<HTMLElement>('[data-r-ov]');
    const rEQ = root.querySelector<HTMLElement>('[data-r-e]');
    const rCountQ = root.querySelector<HTMLElement>('[data-r-count]');
    const whyQ = root.querySelector<HTMLElement>('[data-why]');
    const btnNextQ = root.querySelector<HTMLButtonElement>('[data-next]');
    const btnRunQ = root.querySelector<HTMLButtonElement>('[data-run]');
    const btnResetQ = root.querySelector<HTMLButtonElement>('[data-reset]');
    const togs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-tog]'));
    if (!plotQ || !fieldsDlQ || !rOvQ || !rEQ || !rCountQ || !whyQ || !btnNextQ || !btnRunQ || !btnResetQ || togs.length !== 4) return;
    const plot = plotQ, fieldsDl = fieldsDlQ, rOv = rOvQ, rE = rEQ, rCount = rCountQ, why = whyQ, btnNext = btnNextQ, btnRun = btnRunQ, btnReset = btnResetQ;

    let s = CUE.slice();
    let next = 0;            // index of the unit the next update acts on
    let lastTouched = -1;    // unit most recently updated
    let updates = 0, rises = 0;
    let note = '';           // status text from the last action

    // Perform one update on unit `next`; returns whether the unit changed.
    function updateOne(): { changed: boolean; text: string } {
      const i = next, h = fieldQ(s, i), before = s[i], eBefore = energy(s);
      const after = h > 0 ? 1 : h < 0 ? -1 : before;
      s[i] = after;
      const eAfter = energy(s);
      updates++;
      if (eAfter > eBefore) rises++;
      lastTouched = i;
      next = (i + 1) % 4;
      const changed = after !== before;
      const why1 = h === 0
        ? `Unit ${i + 1}: field exactly 0, so it keeps its value ${sg(before)}.`
        : `Unit ${i + 1}: field ${quarters(h)} is ${h > 0 ? 'positive' : 'negative'}, so it is set to ${sg(after)} and ${changed ? 'flips' : 'stays unchanged'}.`;
      return { changed, text: `${why1} Energy ${ef(eBefore)} to ${ef(eAfter)}${eAfter < eBefore ? ', downhill' : eAfter === eBefore ? ', no change' : ', UP'}.` };
    }

    function situation(): string {
      const ov = overlap(s), e = energy(s);
      const sv = vec(s);
      const fl = '(' + [0, 1, 2, 3].map((i) => quarters(fieldQ(s, i))).join(', ') + ')';
      if (ov === 4) return `State ${sv} is the stored pattern x (overlap 4, E = ${ef(e)}). The fields are ${fl}; every sign matches its unit, so nothing changes.`;
      if (ov === -4) return `State ${sv} is the inverted pattern ${MINUS}x (overlap ${MINUS}4, E = ${ef(e)}). It is also stable: the fields ${fl} all match their units. This sketch stores x, and the inverse is an attractor as well.`;
      const stab = isStable(s);
      let t = `State ${sv}: overlap ${sg(ov)}, E = ${ef(e)}, fields ${fl}.`;
      if (ov === 0) t += ' An overlap of 0 agrees with x on two units and disagrees on two, and sits at the top of the energy range here.';
      t += stab ? ' No unit would change.' : ` Unit ${next + 1} is next.`;
      return t;
    }

    function draw(): void {
      plot.replaceChildren();
      // weights
      for (let i = 0; i < 4; i++) for (let j = i + 1; j < 4; j++) {
        const w = wq(i, j);
        const [x1, y1] = POS[i], [x2, y2] = POS[j];
        const pos = w > 0;
        plot.appendChild(el('line', { x1, y1, x2, y2, stroke: pos ? ACCENT : ORANGE, 'stroke-width': 1.6, 'stroke-dasharray': pos ? '' : '5 3' }));
        // label placement
        let lx: number, ly: number, anchor = 'middle';
        const diag = Math.abs(x1 - x2) > 1 && Math.abs(y1 - y2) > 1;
        if (diag) {
          const t = 0.3; lx = x1 + (x2 - x1) * t; ly = y1 + (y2 - y1) * t + 3;
          plot.appendChild(el('rect', { x: lx - 14, y: ly - 9, width: 28, height: 13, fill: '#fff' }));
        } else if (y1 === y2) { lx = (x1 + x2) / 2; ly = y1 + (y1 < 100 ? -6 : 15); }
        else { lx = x1 + (x1 < 170 ? -8 : 8); anchor = x1 < 170 ? 'end' : 'start'; ly = (y1 + y2) / 2 + 3; }
        const tx = el('text', { x: lx, y: ly, 'text-anchor': anchor, 'font-size': 10, 'font-weight': 700, fill: pos ? ACCENT : ORANGE });
        tx.textContent = (pos ? '+' : MINUS) + '1/4';
        plot.appendChild(tx);
      }
      // units
      for (let i = 0; i < 4; i++) {
        const [cx, cy] = POS[i];
        if (i === next && !isStable(s)) plot.appendChild(el('rect', { x: cx - HALF - 5, y: cy - HALF - 5, width: 2 * HALF + 10, height: 2 * HALF + 10, fill: 'none', stroke: INK, 'stroke-width': 1.2, 'stroke-dasharray': '3 3', rx: 4 }));
        const r = el('rect', { x: cx - HALF, y: cy - HALF, width: 2 * HALF, height: 2 * HALF, rx: 3, fill: s[i] > 0 ? ACCENT : '#fff', stroke: ACCENT, 'stroke-width': 2, cursor: 'pointer' });
        r.addEventListener('click', () => flip(i));
        plot.appendChild(r);
        const top = cy < 100;
        const lab = el('text', { x: cx, y: top ? cy - HALF - 9 : cy + HALF + 16, 'text-anchor': 'middle', 'font-size': 10, 'font-weight': 700, fill: INK });
        lab.textContent = `unit ${i + 1}: ${sg(s[i])}` + (i === lastTouched ? ' (last checked)' : '');
        plot.appendChild(lab);
      }
      const k = el('text', { x: 170, y: 232, 'text-anchor': 'middle', 'font-size': 10, fill: INK });
      k.textContent = `stored x = (1, 1, ${MINUS}1, ${MINUS}1); filled = +1, open = ${MINUS}1; dashed ring = next unit`;
      plot.appendChild(k);

      // toggles
      togs.forEach((b, i) => {
        b.textContent = `Unit ${i + 1}: ${sg(s[i])}`;
        b.setAttribute('aria-pressed', s[i] > 0 ? 'true' : 'false');
        b.setAttribute('aria-label', `Unit ${i + 1} is ${s[i] > 0 ? 'plus one' : 'minus one'}; press to flip`);
      });
      // fields
      fieldsDl.replaceChildren();
      for (let i = 0; i < 4; i++) {
        const h = fieldQ(s, i);
        const d = document.createElement('div');
        const dt = document.createElement('dt'); dt.textContent = `Field h_${i + 1}`;
        const dd = document.createElement('dd');
        const verdict = h === 0 ? 'keeps ' + sg(s[i]) : Math.sign(h) === s[i] ? `matches ${sg(s[i])}` : `would flip to ${sg(Math.sign(h))}`;
        dd.textContent = `${quarters(h)}, ${verdict}`;
        d.append(dt, dd); fieldsDl.appendChild(d);
      }
      const ov = overlap(s);
      rOv.textContent = `${sg(ov)}`;
      rE.textContent = `${ef(energy(s))}  [\u2212((${sg(ov)})\u00b2 \u2212 4)/8]`;
      rCount.textContent = `${updates} | ${rises}`;
      const stab = isStable(s);
      btnNext.disabled = stab; btnRun.disabled = stab;
      why.textContent = (note ? note + ' ' : 'In this sketch, the lesson’s corrupted cue has unit 1 wrong. ') + situation() +
        (updates > 0 && rises === 0 ? ` Across ${updates} update${updates === 1 ? '' : 's'} the energy never rose.` : '');
    }

    function flip(i: number): void {
      s[i] = -s[i]; next = 0; lastTouched = -1; updates = 0; rises = 0;
      note = `You flipped unit ${i + 1} in the cue; the update order restarts at unit 1.`;
      draw();
    }
    togs.forEach((b, i) => b.addEventListener('click', () => flip(i)));

    btnNext.addEventListener('click', () => { note = updateOne().text; draw(); });
    btnRun.addEventListener('click', () => {
      const start = vec(s), log: string[] = [];
      let quiet = 0, guard = 0;
      while (quiet < 4 && guard++ < 40) {
        const r = updateOne();
        if (r.changed) { quiet = 0; log.push(r.text); } else quiet++;
      }
      note = log.length
        ? `Run from ${start}: ${log.join(' ')} Then a full pass changed nothing.`
        : `Run from ${start}: a full pass changed nothing.`;
      draw();
    });
    btnReset.addEventListener('click', () => {
      s = CUE.slice(); next = 0; lastTouched = -1; updates = 0; rises = 0; note = '';
      draw();
    });
    draw();
  });
</script>

<style is:global>
  .hp { padding: var(--ddp-space-3) var(--ddp-space-4) var(--ddp-space-4); margin: var(--ddp-space-5) 0; }
  .hp-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem; font-weight: 600; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); margin-bottom: var(--ddp-space-3); }
  .hp-chip { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 400; color: var(--ddp-color-muted); }
  .hp-svg { display: block; width: 100%; max-width: 560px; margin: 0 auto; height: auto; background: #fff; border: 1px solid var(--ddp-color-line); border-radius: 6px; }
  .hp-cue { border: 0; padding: 0; margin: var(--ddp-space-3) 0 var(--ddp-space-2); }
  .hp-cue legend { font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); padding: 0; margin-bottom: 0.3rem; }
  .hp-toggles { display: flex; flex-wrap: wrap; gap: var(--ddp-space-2); }
  .hp-tog { font: inherit; font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); padding: 0.3rem 0.6rem; border-radius: 6px; border: 1px solid var(--ddp-color-accent); background: transparent; color: var(--ddp-color-accent); cursor: pointer; }
  .hp-tog[aria-pressed="true"] { background: var(--ddp-color-accent); color: #fff; }
  .hp-btns { display: flex; flex-wrap: wrap; gap: var(--ddp-space-2); margin: var(--ddp-space-2) 0; }
  .hp-btn { font: inherit; font-size: var(--ddp-text-xs); padding: 0.35rem 0.7rem; border-radius: 6px; border: 1px solid var(--ddp-color-accent); background: var(--ddp-color-accent); color: #fff; cursor: pointer; }
  .hp-btn2 { background: transparent; color: var(--ddp-color-accent); }
  .hp-btn:disabled { opacity: 0.45; cursor: not-allowed; }
  .hp-btn:focus-visible, .hp-tog:focus-visible { outline: 2px solid var(--ddp-color-secondary); outline-offset: 2px; }
  .hp-readout { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--ddp-space-2); margin: var(--ddp-space-2) 0; padding: var(--ddp-space-2) var(--ddp-space-3); background: color-mix(in srgb, var(--ddp-color-accent) 8%, transparent); border-radius: 6px; }
  .hp-sum { grid-template-columns: 1fr 1fr 1fr; }
  .hp-readout div { display: flex; flex-direction: column; gap: 0.1rem; min-width: 0; }
  .hp-readout dt { font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .hp-readout dd { margin: 0; font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); color: var(--ddp-color-primary); font-weight: 700; overflow-wrap: anywhere; }
  .hp-why { margin: 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); line-height: 1.5; min-height: 6em; }
  .hp-assume { margin: var(--ddp-space-2) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .hp-foot { margin: var(--ddp-space-2) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); border-left: 3px solid var(--ddp-color-secondary); padding-left: 0.55rem; }
  @media (max-width: 560px) { .hp-readout { grid-template-columns: 1fr 1fr; } .hp-sum { grid-template-columns: 1fr; } }
</style>
