---
/**
 * AtpSynthaseGearRatio — the rotary-stoichiometry companion to the ProtonMotiveDam island.
 * That one perturbs the proton-motive force and the coupling; this one isolates the gearbox.
 * ATP synthase is a literal molecular gear train: the Fo c-ring turns one notch per proton, and
 * one full 360° turn drives the F1 head through 3 catalytic β-subunit cycles — so 3 ATP per turn.
 * That makes the proton cost of ATP = (c-subunits in the ring) / 3. But the ring size VARIES across
 * life — mammal c8, yeast c10, spinach chloroplast c14 — so the H+/ATP "gear ratio" is a real,
 * measurable, species-varying number, not a universal constant. Slide the ring size and watch the
 * ratio, the efficiency framing, and the ATP yield from one NADH's proton budget. The NADH yield
 * includes the ~1 H⁺ "export tax" (ATP/ADP translocase + phosphate carrier) that the lesson adds for
 * mitochondria, so c8 gives ~3.7 H⁺ per exported ATP and ~2.7 ATP per NADH, matching the prose.
 * "Turn the rotor" animates one full 360° turn (requestAnimationFrame; instant under reduced
 * motion): c protons in, 3 β-subunit catalytic events out. Original.
 */
---

<figure class="agr card" data-gearratio>
  <figcaption class="agr-head">ATP synthase as a molecular gearbox<span class="agr-chip">⚙ original · interactive</span></figcaption>

  <svg class="agr-svg" viewBox="0 0 460 220" role="img" aria-label="ATP synthase drawn as a gearbox: the membrane c-ring on the left takes one proton per subunit, and the shaft drives the three catalytic beta subunits of the F1 head on the right, three ATP per full turn." data-svg></svg>

  <div class="agr-play">
    <button type="button" data-spin>↻ Turn the rotor one full turn</button>
    <span class="agr-play-note" data-tally aria-live="polite">Press to count protons in and ATP out for one 360° turn.</span>
  </div>

  <div class="agr-presets">
    <span class="agr-presets-label">Species:</span>
    <button type="button" data-preset="8" aria-pressed="true">Mammal · c8</button>
    <button type="button" data-preset="10" aria-pressed="false">Yeast · c10</button>
    <button type="button" data-preset="14" aria-pressed="false">Chloroplast · c14</button>
  </div>

  <label class="agr-slabel"><span>c-ring size: <em data-out="cnum">8</em> c-subunits (= protons per full turn)</span>
    <input type="range" data-in="cnum" min="8" max="15" step="1" value="8" />
  </label>

  <div class="agr-ledger">
    <div class="agr-cell"><span class="agr-c-name">Full turn → catalytic cycles</span><span class="agr-c-v" data-turns>3 ATP / 360° turn</span></div>
    <div class="agr-cell"><span class="agr-c-name">Proton cost at the rotor (gear ratio)</span><span class="agr-c-v agr-hi" data-ratio>2.7 H⁺ / ATP</span></div>
    <div class="agr-cell"><span class="agr-c-name">ATP per NADH (~10 H⁺), after the +1 H⁺ export tax</span><span class="agr-c-v" data-yield>2.7 ATP</span></div>
  </div>
  <p class="agr-why" data-why role="status"></p>

  <p class="agr-foot">The "P/O ratio" you memorized as a constant is really a gear ratio you can read off the hardware, plus a one-proton tax for shipping each ATP out of the matrix. A smaller c-ring (mammal c8 ≈ 2.7 H⁺/ATP) is a high-yield gearbox — fewer protons per ATP — but it needs a steeper proton-motive force to crank, like a low gear on a hill. A bigger ring (spinach c14 ≈ 4.7) spends more protons per ATP yet turns at a gentler Δp. Same machine, different transmission — and evolution tuned each one to the membrane it lives in.</p>
</figure>

<script>
  const ACCENT = '#0e7c86', NAVY = '#232d4b', ORANGE = '#e57200', GOLD = '#D4A843', GOLD_INK = '#7f6315', FAINT = '#b9b9c2', INK = '#4b4b55';
  const SVGNS = 'http://www.w3.org/2000/svg';
  function el(name: string, attrs: Record<string, string | number>): SVGElement {
    const e = document.createElementNS(SVGNS, name);
    for (const k in attrs) e.setAttribute(k, String(attrs[k]));
    return e;
  }

  const H_PER_NADH = 10; // protons pumped per NADH down the electron transport chain
  const EXPORT_TAX = 1;  // ~1 H⁺ per ATP to export it (ATP/ADP translocase + phosphate carrier), per the lesson
  const CX = 118, CY = 121, R = 40;   // c-ring
  const HX = 358, HY = 121;           // F1 head

  function draw(svg: SVGElement, c: number) {
    while (svg.firstChild) svg.removeChild(svg.firstChild);
    // membrane band
    svg.appendChild(el('rect', { x: 0, y: 96, width: 235, height: 50, fill: ACCENT, opacity: 0.08 }));
    const ml = el('text', { x: 8, y: 92, fill: INK, 'font-size': 9.5 }); ml.textContent = 'inner membrane'; svg.appendChild(ml);

    // Fo c-ring: N subunits evenly spaced around a circle, one notch per proton. Grouped so it can rotate.
    svg.appendChild(el('circle', { cx: CX, cy: CY, r: R, fill: 'none', stroke: FAINT, 'stroke-width': 1, 'stroke-dasharray': '3 3' }));
    const ring = el('g', { 'data-ring': '1' });
    for (let i = 0; i < c; i++) {
      const ang = (i / c) * Math.PI * 2 - Math.PI / 2;
      const x = CX + R * Math.cos(ang), y = CY + R * Math.sin(ang);
      ring.appendChild(el('circle', { cx: x, cy: y, r: 9, fill: ORANGE, opacity: 0.9, stroke: '#fff', 'stroke-width': 1.5 }));
    }
    svg.appendChild(ring);
    const ct = el('text', { x: CX, y: CY + 4, 'text-anchor': 'middle', fill: NAVY, 'font-size': 13, 'font-weight': 700, 'font-family': 'monospace' });
    ct.textContent = 'c' + c; svg.appendChild(ct);
    const fl = el('text', { x: CX, y: CY + R + 22, 'text-anchor': 'middle', fill: NAVY, 'font-size': 10, 'font-weight': 600 });
    fl.textContent = 'Fo c-ring — 1 notch per H⁺'; svg.appendChild(fl);

    // proton entry point at the top of the ring
    const hin = el('text', { x: CX, y: CY - R - 18, 'text-anchor': 'middle', fill: ORANGE, 'font-size': 11, 'font-weight': 700 });
    hin.textContent = 'H⁺ in ↓'; svg.appendChild(hin);
    svg.appendChild(el('circle', { cx: CX, cy: CY - R, r: 4, fill: '#fff', stroke: ORANGE, 'stroke-width': 1.5, opacity: 0, 'data-hflash': '1' }));

    // central shaft connecting Fo to F1
    svg.appendChild(el('line', { x1: CX + R + 6, y1: CY, x2: 300, y2: CY, stroke: NAVY, 'stroke-width': 5 }));
    svg.appendChild(el('text', { x: 245, y: CY - 8, 'text-anchor': 'middle', fill: NAVY, 'font-size': 9.5 })).textContent = 'γ shaft';

    // F1 head: 3 catalytic β-subunits = 3 ATP per turn; γ tip inside points at the active β
    svg.appendChild(el('circle', { cx: HX, cy: HY, r: 34, fill: NAVY, opacity: 0.1, stroke: NAVY, 'stroke-width': 1.5 }));
    for (let i = 0; i < 3; i++) {
      const ang = (i / 3) * Math.PI * 2 - Math.PI / 2;
      const x = HX + 18 * Math.cos(ang), y = HY + 18 * Math.sin(ang);
      svg.appendChild(el('circle', { cx: x, cy: y, r: 12, fill: GOLD, opacity: 0.9, stroke: '#fff', 'stroke-width': 1.5, 'data-beta': i }));
      svg.appendChild(el('text', { x, y: y + 4, 'text-anchor': 'middle', fill: NAVY, 'font-size': 11, 'font-weight': 700 })).textContent = 'β';
    }
    svg.appendChild(el('line', { x1: HX, y1: HY, x2: HX, y2: HY - 9, stroke: NAVY, 'stroke-width': 3, 'stroke-linecap': 'round', 'data-gamma': '1' }));
    svg.appendChild(el('text', { x: HX, y: HY + 52, 'text-anchor': 'middle', fill: GOLD_INK, 'font-size': 10, 'font-weight': 600 })).textContent = 'F1 head — 3 ATP per turn';

    // live tally (updated by the spin animation)
    const tally = el('text', { x: HX, y: 34, 'text-anchor': 'middle', fill: ACCENT, 'font-size': 12, 'font-weight': 700, 'data-svg-tally': '1' });
    tally.textContent = '3 ATP per 360°'; svg.appendChild(tally);

    // gear-ratio readout strip across the bottom
    const ratio = c / 3;
    const gr = el('text', { x: 230, y: 206, 'text-anchor': 'middle', fill: INK, 'font-size': 11, 'font-family': 'monospace' });
    gr.textContent = `${c} H⁺  ÷  3 ATP  =  ${ratio.toFixed(1)} H⁺ / ATP`; svg.appendChild(gr);
  }

  const reduceMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-gearratio]').forEach((root) => {
    const svg = root.querySelector('[data-svg]') as unknown as SVGElement;
    const cIn = root.querySelector<HTMLInputElement>('[data-in="cnum"]')!;
    const cOut = root.querySelector<HTMLElement>('[data-out="cnum"]')!;
    const ratioEl = root.querySelector<HTMLElement>('[data-ratio]')!;
    const yieldEl = root.querySelector<HTMLElement>('[data-yield]')!;
    const whyEl = root.querySelector<HTMLElement>('[data-why]')!;
    const spinB = root.querySelector<HTMLButtonElement>('[data-spin]')!;
    const tallyEl = root.querySelector<HTMLElement>('[data-tally]')!;
    const presetBtns = root.querySelectorAll<HTMLButtonElement>('[data-preset]');
    let raf = 0;

    // Pose the rotor at `deg` of a turn and show the running count of protons in / ATP out.
    function pose(c: number, deg: number) {
      const ring = svg.querySelector('[data-ring]');
      const gamma = svg.querySelector('[data-gamma]');
      const tally = svg.querySelector('[data-svg-tally]');
      const flash = svg.querySelector('[data-hflash]');
      if (!ring || !gamma || !tally || !flash) return;
      ring.setAttribute('transform', `rotate(${deg} ${CX} ${CY})`);
      gamma.setAttribute('transform', `rotate(${deg} ${HX} ${HY})`);
      const hIn = Math.min(c, Math.floor(deg / (360 / c) + 1e-6));
      const atp = Math.min(3, Math.floor(deg / 120 + 1e-6));
      // the β the γ tip currently faces glows; a proton "clicks in" as each notch passes the entry point
      const active = Math.floor(((deg % 360) + 60) / 120) % 3;
      svg.querySelectorAll('[data-beta]').forEach((b) => b.setAttribute('fill', Number(b.getAttribute('data-beta')) === active && deg > 0 && deg < 360 ? ORANGE : GOLD));
      const notchFrac = (deg / (360 / c)) % 1;
      flash.setAttribute('opacity', deg > 0 && deg < 360 && notchFrac < 0.35 ? '1' : '0');
      tally.textContent = deg <= 0 ? '3 ATP per 360°' : `${hIn} H⁺ in → ${atp} ATP out`;
      return { hIn, atp };
    }

    function spin() {
      const c = parseInt(cIn.value, 10);
      cancelAnimationFrame(raf);
      const done = () => {
        pose(c, 360);
        tallyEl.textContent = `One full turn: ${c} H⁺ went in, 3 ATP came out — ${(c / 3).toFixed(1)} H⁺ per ATP.`;
        spinB.disabled = false;
      };
      if (reduceMotion()) { done(); return; }
      spinB.disabled = true;
      tallyEl.textContent = 'Turning…';
      const t0 = performance.now(), dur = 3000;
      const step = (now: number) => {
        const t = Math.min(1, (now - t0) / dur);
        pose(c, t * 360);
        if (t < 1) raf = requestAnimationFrame(step); else done();
      };
      raf = requestAnimationFrame(step);
    }

    function render() {
      cancelAnimationFrame(raf);
      spinB.disabled = false;
      const c = parseInt(cIn.value, 10);
      cOut.textContent = String(c);
      const ratio = c / 3;
      const exported = ratio + EXPORT_TAX;
      const perNadh = H_PER_NADH / exported;
      ratioEl.textContent = `${ratio.toFixed(1)} H⁺ / ATP`;
      yieldEl.textContent = `${perNadh.toFixed(1)} ATP`;
      tallyEl.textContent = 'Press to count protons in and ATP out for one 360° turn.';
      presetBtns.forEach((b) => b.classList.toggle('is-on', parseInt(b.dataset.preset!, 10) === c));
      presetBtns.forEach((b) => b.setAttribute('aria-pressed', String(parseInt(b.dataset.preset!, 10) === c)));
      whyEl.textContent = c <= 8
        ? `Mammalian mitochondria run the smallest known ring (c8): ${ratio.toFixed(1)} H⁺ per ATP at the rotor, the highest-yield gearbox in the lineup. Add ~1 H⁺ to export each ATP from the matrix and the cost is ~${exported.toFixed(1)} H⁺, so one NADH's ~10 protons buy about ${perNadh.toFixed(1)} ATP (textbooks usually quote ~2.5). The catch: a small ring only turns if the membrane holds a steep proton-motive force.`
        : c <= 11
          ? `A mid-sized ring (yeast and E. coli sit near c10). At ${ratio.toFixed(1)} H⁺/ATP the gearbox spends more protons per ATP than the mammalian c8; with the export tax, one NADH's ~10 protons would buy about ${perNadh.toFixed(1)} ATP instead of ~2.7.`
          : `A large ring — the spinach chloroplast runs c14, and some bacteria push to c15. At ${ratio.toFixed(1)} H⁺/ATP this is a low-yield, low-torque gearbox: it spends more protons per ATP, but it turns at the gentler Δp these membranes maintain. (A chloroplast spends its ATP in the stroma where it is made, so it pays no export tax; fitted to a mitochondrion's ~10-proton NADH budget, this ring would buy only ~${perNadh.toFixed(1)} ATP.)`;
      draw(svg, c);
    }

    cIn.addEventListener('input', render);
    presetBtns.forEach((b) => b.addEventListener('click', () => { cIn.value = b.dataset.preset!; render(); }));
    spinB.addEventListener('click', spin);
    render();
  });
</script>

<style>
  .agr { padding: var(--ddp-space-3) var(--ddp-space-4) var(--ddp-space-4); margin: var(--ddp-space-5) 0; }
  .agr-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem; font-weight: 600; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); margin-bottom: var(--ddp-space-2); }
  .agr-chip { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 400; color: var(--ddp-color-muted); }
  .agr-svg { width: 100%; height: auto; display: block; background: color-mix(in srgb, var(--ddp-color-accent) 5%, #fff); border: 1px solid var(--ddp-color-line); border-radius: 8px; margin-bottom: var(--ddp-space-2); }
  .agr-presets { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem; margin-bottom: var(--ddp-space-2); }
  .agr-presets-label { font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .agr-presets button { font-family: inherit; font-size: var(--ddp-text-xs); border: 1px solid var(--ddp-color-line); background: #fff; color: var(--ddp-color-ink-soft); border-radius: 5px; padding: 0.32rem 0.7rem; cursor: pointer; }
  .agr-presets button:hover { border-color: var(--ddp-color-accent); color: var(--ddp-color-primary); }
  .agr-presets button.is-on { border-color: var(--ddp-color-accent); background: color-mix(in srgb, var(--ddp-color-accent) 12%, #fff); color: var(--ddp-color-primary); font-weight: 600; }
  .agr-play { display: flex; flex-wrap: wrap; align-items: center; gap: 0.3rem 0.6rem; margin-bottom: var(--ddp-space-2); }
  .agr-play button { font-family: inherit; font-size: var(--ddp-text-xs); font-weight: 600; border: 1px solid var(--ddp-color-accent); background: color-mix(in srgb, var(--ddp-color-accent) 10%, #fff); color: var(--ddp-color-primary); border-radius: 5px; padding: 0.36rem 0.8rem; cursor: pointer; }
  .agr-play button:hover:not(:disabled) { background: color-mix(in srgb, var(--ddp-color-accent) 18%, #fff); }
  .agr-play button:disabled { opacity: 0.55; cursor: default; }
  .agr-play-note { font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .agr-slabel { display: flex; flex-direction: column; gap: 0.1rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); margin-bottom: var(--ddp-space-3); }
  .agr-slabel em { font-style: normal; font-weight: 700; color: var(--ddp-color-accent); font-family: var(--ddp-font-mono); }
  .agr-slabel input { accent-color: var(--ddp-color-accent); }
  .agr-ledger { display: grid; grid-template-columns: 1fr; gap: var(--ddp-space-2); margin-bottom: var(--ddp-space-3); }
  @media (min-width: 560px) { .agr-ledger { grid-template-columns: repeat(3, 1fr); } }
  .agr-cell { border: 1px solid var(--ddp-color-line); border-radius: 6px; padding: var(--ddp-space-2) var(--ddp-space-3); display: flex; flex-direction: column; gap: 0.15rem; }
  .agr-c-name { font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .agr-c-v { font-size: var(--ddp-text-sm); font-weight: 700; font-family: var(--ddp-font-mono); color: var(--ddp-color-primary); }
  .agr-hi { color: var(--ddp-color-accent); }
  .agr-why { margin: 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); line-height: 1.5; min-height: 3.4em; padding: var(--ddp-space-2) var(--ddp-space-3); background: color-mix(in srgb, var(--ddp-color-accent) 8%, transparent); border-radius: 6px; }
  .agr-foot { margin: var(--ddp-space-3) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); border-left: 3px solid var(--ddp-color-secondary); padding-left: 0.55rem; }
</style>
