---
/**
 * SecMutantSecretionReader — read the made-up invertase data of the vesicle-traffic
 * lesson. Pick a yeast strain and a temperature (25 or 37 °C). Where the lesson gives
 * numbers, external and internal invertase are drawn as one bar of 200 units and the
 * fraction secreted = external / (external + internal) is worked out in full. For the
 * single mutants the lesson only describes, and for the double mutants, the strip below
 * shows which compartment piles up and the order that implies. No number appears here
 * that the lesson does not give or that does not follow from its numbers by its own
 * arithmetic. Labelled blocks and bars only. Self-contained vanilla-TS Astro island. Original.
 */
---

<figure class="smr card" data-smr>
  <figcaption class="smr-head">Yeast sec mutants: read the secretion data<span class="smr-chip">⚙ original · interactive</span></figcaption>

  <div class="smr-controls">
    <div class="smr-field">
      <label for="smr-strain" class="smr-label">Strain</label>
      <select id="smr-strain" class="smr-select" data-strain>
        <option value="wt">wild type</option>
        <option value="X" selected>secX</option>
        <option value="Y">secY</option>
        <option value="Z">secZ</option>
        <option value="XZ">secX secZ double</option>
        <option value="YZ">secY secZ double</option>
        <option value="XY">secX secY double (the lesson’s proposed test)</option>
      </select>
    </div>
    <fieldset class="smr-field smr-temp">
      <legend class="smr-label">Temperature</legend>
      <label><input type="radio" name="smr-temp" value="25" data-temp /> 25 °C (permissive)</label>
      <label><input type="radio" name="smr-temp" value="37" data-temp checked /> 37 °C (restrictive)</label>
    </fieldset>
  </div>

  <svg class="smr-svg" viewBox="0 0 360 236" role="img" aria-label="Bars of external and internal invertase for the chosen strain, and a strip of the secretory route showing which compartment piles up" data-stage></svg>

  <p class="smr-calc" data-calc></p>
  <p class="smr-verdict" data-verdict role="status"></p>

  <p class="smr-foot">Fraction secreted = external / (external + internal). In a double mutant on a linear route, the earlier block wins, so the compartment that piles up names the earlier gene. The numbers are the lesson’s made-up units, in arbitrary units after 1 h at 37 °C; this is a sketch of the logic, not data.</p>
</figure>

<script>
  const NS = 'http://www.w3.org/2000/svg';
  const INK = '#4b4b55', FAINT = '#6e6e7a', EXT = '#0e7c86', INT = '#e57200', HOT = '#fbe3c4';
  type Bar = { label: string; ext: number; int: number };
  type Strain = 'wt' | 'X' | 'Y' | 'Z' | 'XZ' | 'YZ' | 'XY';
  // Route from the lesson: ER (X), Golgi-like stacks (Y), 80 to 100 nm vesicles (Z), surface.
  const STAGES = ['ER', 'Golgi', 'vesicles', 'surface'];
  const GENES = ['X', 'Y', 'Z', ''];
  const pct = (a: number, b: number) => {
    const v = (100 * a) / b;
    return (Math.round(v * 10) / 10).toString().replace(/\.0$/, '') + '%';
  };
  function el(name: string, attrs: Record<string, string | number>, text?: string): SVGElement {
    const e = document.createElementNS(NS, name);
    for (const k in attrs) e.setAttribute(k, String(attrs[k]));
    if (text !== undefined) e.textContent = text;
    return e;
  }
  type State = {
    bars: Bar[] | null;
    noBars: string;
    pile: number | null; // index into STAGES
    predicted: boolean;
    calc: string;
    status: string;
  };
  function compute(s: Strain, t: number): State {
    const hot = t === 37;
    const base: State = { bars: null, noBars: '', pile: null, predicted: false, calc: '', status: '' };
    if (s === 'wt') {
      if (!hot) return { ...base, noBars: 'The lesson gives wild-type numbers only for 37 °C.', calc: 'No wild-type invertase numbers are given for 25 °C.', status: 'Wild type is shown at 25 °C. The lesson gives no invertase numbers here, so none are drawn. Switch to 37 °C to see its numbers.' };
      return { ...base, bars: [{ label: 'wild type, 37 °C, 1 h', ext: 180, int: 20 }], calc: 'Wild type: external 180, internal 20, total 200, so 180 / 200 = 90% secreted.', status: 'Wild type secretes most of its invertase: 90% is outside. Nothing piles up along the route.' };
    }
    if (s === 'X') {
      if (hot) return { ...base, bars: [{ label: 'secX, 37 °C, 1 h', ext: 12, int: 188 }], pile: 0, calc: 'secX: external 12, internal 188, total 200, so 12 / 200 = 6% secreted.', status: 'At 37 °C secX holds nearly all its invertase inside, 6% secreted against 90% for wild type. The block is real, and the cells pile up ER.' };
      return { ...base, bars: [{ label: 'secX at 37 °C, 1 h (start)', ext: 12, int: 188 }, { label: 'after 60 min at 25 °C + cycloheximide', ext: 150, int: 50 }], calc: 'Pool released = (188 − 50) / 188 = 138 / 188 = 73.4%. External rose by the same 138 units, and the total is still 200.', status: 'Shifted back to 25 °C with cycloheximide, so no new invertase is made, secX releases most of its trapped pool: 150 outside, 50 inside. The trapped material was deliverable, not dead protein.' };
    }
    if (!hot) {
      const nm = { Y: 'secY', Z: 'secZ', XZ: 'secX secZ', YZ: 'secY secZ', XY: 'secX secY' }[s];
      return { ...base, noBars: 'The lesson gives no invertase numbers for this strain.', calc: 'No invertase numbers are given for this strain.', status: `${nm}: the screen's mutants work at 25 °C and fail at 37 °C, so no block is expected at 25 °C (inferred, not a measurement), so nothing is shown piling up. Switch to 37 °C to read the block.` };
    }
    const none = 'The lesson gives no invertase numbers for this strain, so no bars are drawn.';
    if (s === 'Y') return { ...base, noBars: none, pile: 1, calc: 'secY alone accumulates Golgi-like stacks (Berkeley bodies).', status: 'At 37 °C secY piles up Golgi-like stacks. That marks where its block lies on the route.' };
    if (s === 'Z') return { ...base, noBars: none, pile: 2, calc: 'secZ alone accumulates 80 to 100 nm vesicles.', status: 'At 37 °C secZ piles up 80 to 100 nm vesicles. That marks where its block lies on the route.' };
    if (s === 'XZ') return { ...base, noBars: none, pile: 0, calc: 'secX alone: ER. secZ alone: vesicles. secX secZ double: ER.', status: 'The secX secZ double accumulates ER, the secX picture, so X acts before Z: cargo never reaches the step Z needs. This assumes a linear route; a gene product could still act early and be needed only later.' };
    if (s === 'YZ') return { ...base, noBars: none, pile: 1, calc: 'secY alone: Golgi-like stacks. secZ alone: vesicles. secY secZ double: Golgi-like membranes.', status: 'The secY secZ double accumulates Golgi-like membranes, the secY picture, so Y acts before Z. This assumes a linear route; a gene product could still act early and be needed only later.' };
    return { ...base, noBars: 'No measurement for this double is given. The lesson only proposes it as a test.', pile: 0, predicted: true, calc: 'secX alone: ER. secY alone: Golgi-like stacks. ER precedes Golgi on the secretory route.', status: 'Prediction, not a result: ER precedes Golgi on the route, which places X before Y. A secX secY double accumulating ER would test that directly.' };
  }

  document.querySelectorAll<HTMLElement>('[data-smr]').forEach((root) => {
    const stage = root.querySelector<SVGSVGElement>('[data-stage]')!;
    const sel = root.querySelector<HTMLSelectElement>('[data-strain]')!;
    const calc = root.querySelector<HTMLElement>('[data-calc]')!;
    const verdict = root.querySelector<HTMLElement>('[data-verdict]')!;
    const temps = root.querySelectorAll<HTMLInputElement>('[data-temp]');

    function draw(st: State) {
      stage.replaceChildren();
      // Legend
      stage.appendChild(el('rect', { x: 40, y: 6, width: 10, height: 10, fill: EXT }));
      stage.appendChild(el('text', { x: 54, y: 15, 'font-size': 10, fill: INK }, 'external invertase'));
      stage.appendChild(el('rect', { x: 196, y: 6, width: 10, height: 10, fill: INT }));
      stage.appendChild(el('text', { x: 210, y: 15, 'font-size': 10, fill: INK }, 'internal invertase'));
      const X0 = 40, W = 280;
      if (st.bars) {
        st.bars.forEach((b, i) => {
          const y = 36 + i * 56;
          const tot = b.ext + b.int, we = (W * b.ext) / tot;
          stage.appendChild(el('text', { x: X0, y, 'font-size': 10, 'font-weight': 700, fill: INK }, b.label));
          stage.appendChild(el('text', { x: X0, y: y + 14, 'font-size': 10, fill: EXT }, `external ${b.ext}`));
          stage.appendChild(el('text', { x: X0 + W, y: y + 14, 'font-size': 10, 'text-anchor': 'end', fill: '#a14f00' }, `internal ${b.int}`));
          if (we > 0) stage.appendChild(el('rect', { x: X0, y: y + 19, width: we, height: 18, fill: EXT }));
          stage.appendChild(el('rect', { x: X0 + we, y: y + 19, width: W - we, height: 18, fill: INT }));
          stage.appendChild(el('rect', { x: X0, y: y + 19, width: W, height: 18, fill: 'none', stroke: INK, 'stroke-width': 0.8 }));
        });
      } else {
        stage.appendChild(el('rect', { x: X0, y: 34, width: W, height: 40, fill: '#f4f4f7', stroke: '#c9c9d2', 'stroke-width': 0.8, 'stroke-dasharray': '3 3' }));
        const words = st.noBars.split(' ');
        let l1 = '', l2 = '';
        for (const w of words) { if ((l1 + ' ' + w).trim().length <= 48 && !l2) l1 = (l1 + ' ' + w).trim(); else l2 = (l2 + ' ' + w).trim(); }
        stage.appendChild(el('text', { x: X0 + W / 2, y: l2 ? 51 : 58, 'font-size': 10, 'text-anchor': 'middle', fill: INK }, l1));
        if (l2) stage.appendChild(el('text', { x: X0 + W / 2, y: 65, 'font-size': 10, 'text-anchor': 'middle', fill: INK }, l2));
      }
      // Route strip
      const ty = 146;
      stage.appendChild(el('text', { x: 18, y: ty - 6, 'font-size': 10, 'font-weight': 700, fill: INK }, st.predicted ? 'Predicted pile-up on the route (not a result)' : 'Where cargo piles up on the route'));
      const bw = 66, gap = 20, x0 = 18;
      STAGES.forEach((nm, i) => {
        const x = x0 + i * (bw + gap), hot = st.pile === i;
        stage.appendChild(el('rect', { x, y: ty, width: bw, height: 28, rx: 5, fill: hot ? HOT : '#fff', stroke: hot ? INT : '#9a9aa6', 'stroke-width': hot ? 2 : 1, 'stroke-dasharray': hot && st.predicted ? '4 3' : '0' }));
        stage.appendChild(el('text', { x: x + bw / 2, y: ty + 18, 'font-size': 10, 'text-anchor': 'middle', 'font-weight': hot ? 700 : 400, fill: INK }, nm));
        if (i < 3) {
          stage.appendChild(el('line', { x1: x + bw + 3, y1: ty + 14, x2: x + bw + gap - 5, y2: ty + 14, stroke: FAINT, 'stroke-width': 1.2 }));
          stage.appendChild(el('path', { d: `M${x + bw + gap - 8} ${ty + 10} L${x + bw + gap - 3} ${ty + 14} L${x + bw + gap - 8} ${ty + 18} Z`, fill: FAINT }));
        }
        if (GENES[i]) stage.appendChild(el('text', { x: x + bw / 2, y: ty + 44, 'font-size': 10, 'text-anchor': 'middle', fill: FAINT }, `gene ${GENES[i]}`));
        if (hot) stage.appendChild(el('text', { x: x + bw / 2, y: ty + 60, 'font-size': 10, 'text-anchor': 'middle', 'font-weight': 700, fill: '#a14f00' }, st.predicted ? 'predicted' : 'piles up'));
      });
      stage.appendChild(el('text', { x: 18, y: 230, 'font-size': 9, fill: FAINT }, 'Order from the lesson: ER (X), Golgi (Y), vesicles (Z), surface.'));
    }
    function render() {
      const t = [...temps].find((r) => r.checked)?.value === '25' ? 25 : 37;
      const st = compute(sel.value as Strain, t);
      draw(st);
      calc.textContent = st.calc;
      verdict.textContent = st.status;
    }
    sel.addEventListener('change', render);
    temps.forEach((r) => r.addEventListener('change', render));
    render();
  });
</script>

<style is:global>
  .smr { padding: var(--ddp-space-3) var(--ddp-space-4) var(--ddp-space-4); margin: var(--ddp-space-5) 0; }
  .smr-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem; font-weight: 600; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); margin-bottom: var(--ddp-space-3); }
  .smr-chip { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 400; color: var(--ddp-color-muted); }
  .smr-controls { display: flex; flex-wrap: wrap; gap: 0.6rem 1.2rem; align-items: flex-start; margin-bottom: var(--ddp-space-3); }
  .smr-field { display: flex; flex-direction: column; gap: 0.25rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); min-width: 0; }
  .smr-temp { border: 1px solid var(--ddp-color-line); border-radius: 6px; padding: 0.3rem 0.6rem; margin: 0; }
  .smr-temp label { display: block; }
  .smr-label { font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); padding: 0; }
  .smr-select { max-width: 100%; font-size: var(--ddp-text-xs); padding: 0.3rem 0.4rem; border: 1px solid var(--ddp-color-line); border-radius: 5px; background: transparent; color: var(--ddp-color-ink-soft); }
  .smr-select:focus-visible, .smr input:focus-visible { outline: 2px solid var(--ddp-color-accent); outline-offset: 2px; }
  .smr input { accent-color: var(--ddp-color-accent); }
  .smr-svg { display: block; width: 100%; max-width: 600px; margin: 0 auto var(--ddp-space-3); height: auto; background: #fff; border: 1px solid var(--ddp-color-line); border-radius: 6px; }
  .smr-calc { margin: var(--ddp-space-2) 0; font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); min-height: 2.6em; }
  .smr-verdict { margin: var(--ddp-space-2) 0; padding: var(--ddp-space-2) var(--ddp-space-3); background: color-mix(in srgb, var(--ddp-color-accent) 8%, transparent); border-radius: 6px; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); min-height: 4.5em; }
  .smr-foot { margin: var(--ddp-space-3) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); border-left: 3px solid var(--ddp-color-secondary); padding-left: 0.55rem; }
</style>
