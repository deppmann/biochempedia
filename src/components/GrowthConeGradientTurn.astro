---
/**
 * GrowthConeGradientTurn — a growth cone sits in a gradient of an attractive cue. Two
 * sliders set the steepness of the gradient and its level. Following the lesson, a cue
 * shifts actin assembly, flow or adhesion on the side nearer the source, and turning is
 * the difference in that balance between the two sides. In this sketch each side's
 * response is simply proportional to the cue it meets, so the turn follows the
 * difference across the width of the cone and an equal rise on both sides cancels.
 * Schematic relative units throughout. Self-contained vanilla-TS Astro island. Original.
 */
---

<figure class="gct card" data-gct>
  <figcaption class="gct-head">Reading a gradient across the width of a growth cone<span class="gct-chip">⚙ original · interactive</span></figcaption>

  <svg class="gct-svg" viewBox="0 0 340 250" role="img" aria-label="A growth cone in a gradient of an attractive cue (as in the NGF pipette assay) that is higher on its right side, with the path the sketch predicts" data-plot></svg>

  <div class="gct-controls">
    <label class="gct-slabel"><span>Steepness: attractive cue change across the cone <em data-out="steep">2.0</em> <small>(relative units)</small></span>
      <input type="range" data-in="steep" min="0" max="4" step="0.25" value="2" />
    </label>
    <label class="gct-slabel"><span>Level: attractive cue at the cone’s centre <em data-out="level">6.0</em> <small>(relative units)</small></span>
      <input type="range" data-in="level" min="2" max="10" step="0.5" value="6" />
    </label>
  </div>

  <dl class="gct-readout">
    <div><dt>Attractive cue, side away from source</dt><dd data-r-far>5.0</dd></div>
    <div><dt>Attractive cue, side nearer source</dt><dd data-r-near>7.0</dd></div>
    <div><dt>Difference across the cone</dt><dd data-r-diff>2.0</dd></div>
  </dl>
  <p class="gct-why" data-why role="status"></p>

  <p class="gct-foot">In this sketch, each side’s response is assumed proportional to the cue it meets, so only the difference across the cone matters. The lesson says turning is a difference in balance between the two sides, not how that balance depends on cue; these numbers and the path are invented.</p>
</figure>

<script>
  const NS = 'http://www.w3.org/2000/svg';
  const ACCENT = '#0e7c86', ORANGE = '#e57200', INK = '#4b4b55', FAINT = '#b9b9c2';
  function el(name: string, attrs: Record<string, string | number>): SVGElement {
    const e = document.createElementNS(NS, name);
    for (const k in attrs) e.setAttribute(k, String(attrs[k]));
    return e;
  }
  function txt(x: number, y: number, s: string, size: number, fill: string, anchor = 'start', weight = 400): SVGElement {
    const t = el('text', { x, y, 'font-size': size, fill, 'text-anchor': anchor, 'font-weight': weight });
    t.textContent = s;
    return t;
  }
  document.querySelectorAll<HTMLElement>('[data-gct]').forEach((root) => {
    const plot = root.querySelector<SVGSVGElement>('[data-plot]')!;
    const q = (s: string) => root.querySelector<HTMLInputElement>(s)!;
    const o = (s: string) => root.querySelector<HTMLElement>(s)!;
    const steepIn = q('[data-in="steep"]'), levelIn = q('[data-in="level"]');
    const steepOut = o('[data-out="steep"]'), levelOut = o('[data-out="level"]');
    const rFar = o('[data-r-far]'), rNear = o('[data-r-near]'), rDiff = o('[data-r-diff]'), why = o('[data-why]');

    const CX = 170, HALF = 55, CMAX = 12; // cone centre x, half-width in px (full width = one "cone width"), top of scale
    const FIELD_TOP = 70, FIELD_BOT = 246;

    function render() {
      const steep = parseFloat(steepIn.value);
      const level = parseFloat(levelIn.value);
      const cNear = level + steep / 2, cFar = level - steep / 2;
      const diff = cNear - cFar;
      steepOut.textContent = steep.toFixed(1);
      levelOut.textContent = level.toFixed(1);
      rFar.textContent = cFar.toFixed(1);
      rNear.textContent = cNear.toFixed(1);
      rDiff.textContent = diff.toFixed(1);

      plot.replaceChildren();
      // cue field: darker orange where the cue is higher; rises to the right
      for (let x = 10; x < 330; x += 8) {
        const c = Math.max(0, level + steep * ((x + 4 - CX) / (2 * HALF)));
        plot.appendChild(el('rect', { x, y: FIELD_TOP, width: 8.5, height: FIELD_BOT - FIELD_TOP, fill: ORANGE, 'fill-opacity': (Math.min(c, 14) / 14 * 0.55).toFixed(3) }));
      }
      plot.appendChild(el('rect', { x: 10, y: FIELD_TOP, width: 320, height: FIELD_BOT - FIELD_TOP, fill: 'none', stroke: FAINT, 'stroke-width': 1 }));
      plot.appendChild(txt(14, FIELD_TOP + 12, 'cue (darker = more)', 9, INK));
      plot.appendChild(txt(326, FIELD_TOP + 12, 'source this way →', 9, INK, 'end', 700));

      // header: the cue met by each side, as bars
      plot.appendChild(txt(14, 14, 'Attractive cue met by each side (relative units)', 10, INK, 'start', 700));
      const bar = (y: number, label: string, c: number, fill: string) => {
        plot.appendChild(txt(14, y + 9, label, 9, INK));
        plot.appendChild(el('rect', { x: 130, y, width: 190 * Math.min(c, CMAX) / CMAX, height: 11, fill, rx: 2 }));
        plot.appendChild(txt(Math.min(134 + 190 * Math.min(c, CMAX) / CMAX, 308), y + 9, c.toFixed(1), 9, INK, 'start'));
      };
      bar(22, 'side nearer the source', cNear, ORANGE);
      bar(38, 'side away from source', cFar, '#f3b27a');

      // growth cone: central axon shaft, fan split into two halves shaded by the cue each meets
      plot.appendChild(el('line', { x1: CX, y1: 246, x2: CX, y2: 168, stroke: ACCENT, 'stroke-width': 8, 'stroke-linecap': 'butt' }));
      const shade = (c: number) => (0.25 + 0.5 * Math.min(c, CMAX) / CMAX).toFixed(3);
      plot.appendChild(el('path', { d: `M${CX} 170 L${CX - 12} 170 L${CX - HALF} 130 Q${CX - HALF / 2} 112 ${CX} 116 Z`, fill: ACCENT, 'fill-opacity': shade(cFar), stroke: ACCENT, 'stroke-width': 1.2 }));
      plot.appendChild(el('path', { d: `M${CX} 170 L${CX + 12} 170 L${CX + HALF} 130 Q${CX + HALF / 2} 112 ${CX} 116 Z`, fill: ACCENT, 'fill-opacity': shade(cNear), stroke: ACCENT, 'stroke-width': 1.2 }));
      for (let i = -3; i <= 3; i++) {
        const fx = CX + i * 15, fy = 118 + Math.abs(i) * 4.2;
        plot.appendChild(el('line', { x1: fx, y1: fy, x2: fx + i * 2.2, y2: fy - 13, stroke: ACCENT, 'stroke-width': 1.3, 'stroke-linecap': 'round' }));
      }
      // width marker
      plot.appendChild(el('line', { x1: CX - HALF, y1: 187, x2: CX + HALF, y2: 187, stroke: INK, 'stroke-width': 1 }));
      plot.appendChild(el('line', { x1: CX - HALF, y1: 183, x2: CX - HALF, y2: 191, stroke: INK, 'stroke-width': 1 }));
      plot.appendChild(el('line', { x1: CX + HALF, y1: 183, x2: CX + HALF, y2: 191, stroke: INK, 'stroke-width': 1 }));
      plot.appendChild(txt(CX, 202, 'width of the growth cone', 9, INK, 'middle'));
      plot.appendChild(txt(CX - HALF - 4, 160, 'away', 9, INK, 'end'));
      plot.appendChild(txt(CX + HALF + 4, 160, 'near', 9, INK, 'start'));

      // predicted path: heading bends toward the source in proportion to the difference
      let x = CX, y = 108, th = 0, d = `M${x} ${y}`;
      for (let i = 0; i < 12; i++) {
        th += 0.02 * diff;
        x += Math.sin(th) * 4.5;
        y -= Math.cos(th) * 4.5;
        d += ` L${x.toFixed(1)} ${y.toFixed(1)}`;
      }
      plot.appendChild(el('path', { d, fill: 'none', stroke: INK, 'stroke-width': 2, 'stroke-dasharray': '5 3' }));
      plot.appendChild(el('circle', { cx: x, cy: y, r: 3.5, fill: INK }));
      plot.appendChild(txt(Math.min(x + 8, 190), Math.max(y - 2, FIELD_TOP + 26), diff === 0 ? 'keeps its heading (sketch)' : 'path (sketch, not to scale)', 9, INK, 'start', 700));

      const sentence = diff === 0
        ? `The cue is ${level.toFixed(1)} on both sides, so nothing differs between them. Turning is a difference in the balance between the two sides, so in this sketch the growth cone keeps its heading, even though the cue is present.`
        : `The cue is ${cNear.toFixed(1)} on the side nearer the source and ${cFar.toFixed(1)} on the other, a difference of ${diff.toFixed(1)} across the cone. The cue shifts actin assembly, flow or adhesion on the nearer side, and microtubules follow the side that is gaining, so the growth cone turns toward the source. Raising the level lifts both sides together and does not change the difference in this sketch.`;
      why.textContent = sentence;
    }
    [steepIn, levelIn].forEach((s) => s.addEventListener('input', render));
    render();
  });
</script>

<style>
  .gct { padding: var(--ddp-space-3) var(--ddp-space-4) var(--ddp-space-4); margin: var(--ddp-space-5) 0; }
  .gct-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem; font-weight: 600; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); margin-bottom: var(--ddp-space-3); }
  .gct-chip { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 400; color: var(--ddp-color-muted); }
  .gct-svg { display: block; width: 100%; max-width: 560px; margin: 0 auto; height: auto; background: #fff; border: 1px solid var(--ddp-color-line); border-radius: 6px; }
  .gct-controls { display: grid; grid-template-columns: 1fr 1fr; gap: var(--ddp-space-2) var(--ddp-space-4); margin: var(--ddp-space-3) 0 var(--ddp-space-2); }
  .gct-slabel { display: flex; flex-direction: column; gap: 0.1rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .gct-slabel small { font-size: inherit; color: var(--ddp-color-muted); }
  .gct-slabel em { font-style: normal; font-weight: 700; color: var(--ddp-color-accent); font-family: var(--ddp-font-mono); }
  .gct-slabel input { accent-color: var(--ddp-color-accent); }
  .gct-readout { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--ddp-space-2); margin: var(--ddp-space-2) 0; padding: var(--ddp-space-2) var(--ddp-space-3); background: color-mix(in srgb, var(--ddp-color-accent) 8%, transparent); border-radius: 6px; }
  .gct-readout div { display: flex; flex-direction: column; gap: 0.1rem; }
  .gct-readout dt { font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .gct-readout dd { margin: 0; font-family: var(--ddp-font-mono); font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); font-weight: 700; }
  .gct-why { margin: 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); line-height: 1.5; min-height: 6em; }
  .gct-foot { margin: var(--ddp-space-3) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); border-left: 3px solid var(--ddp-color-secondary); padding-left: 0.55rem; }
  @media (max-width: 480px) {
    .gct-controls { grid-template-columns: 1fr; }
    .gct-readout { grid-template-columns: 1fr; }
  }
</style>
