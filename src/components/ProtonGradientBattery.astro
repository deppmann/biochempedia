  .pgb-svg { width: 100%; height: auto; display: block; background: #fff; border: 1px solid var(--ddp-color-line); border-radius: 6px; margin-bottom: var(--ddp-space-2); }

  .pgb .pgb-legend { list-style: none; margin: 0 0 var(--ddp-space-3); padding: 0; display: flex; flex-wrap: wrap; gap: 0.25rem 0.9rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .pgb .pgb-legend li { display: inline-flex; align-items: center; gap: 0.35rem; margin: 0; padding: 0; font-size: var(--ddp-text-xs); line-height: 1.4; }
  .pgb .pgb-legend li::before, .pgb .pgb-legend li::marker { content: none; }
  .pgb-dot { display: inline-block; width: 0.7rem; height: 0.7rem; border-radius: 50%; }
  .pgb-dot-e { background: #e57200; }
  .pgb-dot-h { background: #D4A843; }
  .pgb-dot-red { background: #0e7c86; }
  .pgb-dot-ox { background: #8a93ad; }

  .pgb-meter { margin-bottom: var(--ddp-space-3); }
  .pgb-meter-top { display: flex; justify-content: space-between; align-items: baseline; gap: 0.5rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); margin-bottom: 0.25rem; }
  .pgb-meter-top strong { font-family: var(--ddp-font-mono); color: var(--ddp-color-primary); }
