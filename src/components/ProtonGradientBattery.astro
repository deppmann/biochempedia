  .pgb-actions { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .pgb-actions .pgb-run { font-weight: 700; background: var(--ddp-color-accent); border-color: var(--ddp-color-accent); color: #fff; }
  .pgb-actions .pgb-run:hover { background: color-mix(in srgb, var(--ddp-color-accent) 85%, #000); color: #fff; }
