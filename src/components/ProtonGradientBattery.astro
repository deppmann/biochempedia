  @media (min-width: 560px) { .pgb-readouts { grid-template-columns: repeat(4, 1fr); } }
  .pgb-ro { border: 1px solid var(--ddp-color-line); border-radius: 6px; padding: var(--ddp-space-2) var(--ddp-space-3); display: flex; flex-direction: column; gap: 0.15rem; }
  .pgb-ro-name { font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .pgb-ro-v { font-size: var(--ddp-text-sm); font-weight: 700; font-family: var(--ddp-font-mono); color: var(--ddp-color-primary); }
  .pgb-pos { color: #2e8b57; }
  .pgb-neg { color: #c0392b; }

  .pgb-controls { display: flex; flex-direction: column; gap: var(--ddp-space-3); margin-bottom: var(--ddp-space-3); }
  .pgb-group { display: flex; flex-direction: column; gap: 0.25rem; }
  .pgb-g-label { font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); font-weight: 600; }
  .pgb-seg { display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .pgb-seg button, .pgb-actions button {
    font-family: inherit; font-size: var(--ddp-text-xs); border: 1px solid var(--ddp-color-line);
    background: #fff; color: var(--ddp-color-ink-soft); border-radius: var(--ddp-radius-sm); padding: 0.35rem 0.7rem; cursor: pointer;
  }
  .pgb-seg button:hover, .pgb-actions button:hover { border-color: var(--ddp-color-accent); color: var(--ddp-color-primary); }
  .pgb-seg button[aria-pressed='true'] { background: var(--ddp-color-accent); border-color: var(--ddp-color-accent); color: #fff; font-weight: 700; }
