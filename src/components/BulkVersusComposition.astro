---
/**
 * BulkVersusComposition — the lesson's made-up bulk-RNA example. Cell type T expresses gene X
 * at 50 units per cell, other cells at 5. Before a treatment T is 20% of cells. The learner sets
 * the fraction of T after the treatment and the per-cell level in T and in other cells, and the
 * bulk signal is computed with the lesson's rule:
 *   bulk = (fraction T x level in T) + (fraction other x level in other).
 * A switch moves between the bulk view (stacked contributions) and the single-cell view
 * (per-cell level in each cluster). The status says whether a bulk change comes from
 * composition, regulation or both. Deterministic: nothing is sampled at random.
 * Self-contained vanilla-TS Astro island. Original.
 */
---

<figure class="bvc card" data-bvc>
  <figcaption class="bvc-head">Bulk average versus composition<span class="bvc-chip">⚙ original · interactive</span></figcaption>

  <svg class="bvc-svg" viewBox="0 0 360 260" role="img" aria-label="Before and after panels showing the share of cell type T among cells and either the bulk signal of gene X or the per-cell level in each cluster" data-stage></svg>

  <div class="bvc-controls">
    <label class="bvc-ctl">
      <span class="bvc-ctl-name">Fraction of T cells after treatment (20% before) <output data-out="f"></output></span>
      <input type="range" min="0" max="100" step="1" value="40" data-in="f" />
    </label>
    <label class="bvc-ctl">
      <span class="bvc-ctl-name">Gene X in T cells after, units per cell (50 before) <output data-out="t"></output></span>
      <input type="range" min="0" max="100" step="1" value="50" data-in="t" />
    </label>
    <label class="bvc-ctl">
      <span class="bvc-ctl-name">Gene X in other cells after, units per cell (5 before) <output data-out="o"></output></span>
      <input type="range" min="0" max="100" step="1" value="5" data-in="o" />
    </label>
    <div class="bvc-row">
      <label class="bvc-tog"><input type="checkbox" data-in="sc" /> single-cell view</label>
      <button type="button" class="bvc-btn" data-reset>back to the lesson’s numbers</button>
    </div>
  </div>

  <div class="bvc-math" data-math></div>
  <p class="bvc-verdict" data-verdict role="status"></p>

  <p class="bvc-foot">Rule to keep: a bulk change is an average weighted by how many cells of each kind there are, so it can come from a change in composition with no change in regulation in any cell. The numbers are made up, as in the lesson.</p>
</figure>

<script>
  const NS = 'http://www.w3.org/2000/svg';
  const INK = '#4b4b55', FAINT = '#8a8a96', C_T = '#0e7c86', C_O = '#e57200';
  const B_F = 0.2, B_T = 50, B_O = 5; // the lesson's "before"
  function el(name: string, attrs: Record<string, string | number>, text?: string): SVGElement {
    const e = document.createElementNS(NS, name);
    for (const k in attrs) e.setAttribute(k, String(attrs[k]));
    if (text !== undefined) e.textContent = text;
    return e;
  }
  const fmt = (n: number) => String(+n.toFixed(2));
  const bulk = (f: number, t: number, o: number) => f * t + (1 - f) * o;

  document.querySelectorAll<HTMLElement>('[data-bvc]').forEach((root) => {
    const stage = root.querySelector<SVGSVGElement>('[data-stage]')!;
    const math = root.querySelector<HTMLElement>('[data-math]')!;
    const verdict = root.querySelector<HTMLElement>('[data-verdict]')!;
    const inp = (k: string) => root.querySelector<HTMLInputElement>(`[data-in="${k}"]`)!;
    const out = (k: string) => root.querySelector<HTMLElement>(`[data-out="${k}"]`)!;

    function panel(x0: number, title: string, f: number, t: number, o: number, sc: boolean, maxV: number) {
      const W = 150, base = 212, H = 112;
      stage.appendChild(el('text', { x: x0 + W / 2, y: 16, 'font-size': 11, 'font-weight': 700, 'text-anchor': 'middle', fill: INK }, title));
      // composition strip
      const wT = W * f;
      if (wT > 0) stage.appendChild(el('rect', { x: x0, y: 24, width: wT, height: 18, fill: C_T }));
      if (W - wT > 0) stage.appendChild(el('rect', { x: x0 + wT, y: 24, width: W - wT, height: 18, fill: C_O }));
      stage.appendChild(el('text', { x: x0, y: 56, 'font-size': 9, fill: INK }, `T ${Math.round(f * 100)}%`));
      stage.appendChild(el('text', { x: x0 + W, y: 56, 'font-size': 9, 'text-anchor': 'end', fill: INK }, `other ${Math.round((1 - f) * 100)}%`));
      stage.appendChild(el('line', { x1: x0, y1: base, x2: x0 + W, y2: base, stroke: FAINT, 'stroke-width': 1 }));
      if (!sc) {
        const cT = f * t, cO = (1 - f) * o, hT = (cT / maxV) * H, hO = (cO / maxV) * H, bw = 56, bx = x0 + (W - bw) / 2;
        if (hO > 0) stage.appendChild(el('rect', { x: bx, y: base - hO, width: bw, height: hO, fill: C_O }));
        if (hT > 0) stage.appendChild(el('rect', { x: bx, y: base - hO - hT, width: bw, height: hT, fill: C_T }));
        if (hT >= 13) stage.appendChild(el('text', { x: bx + bw / 2, y: base - hO - hT / 2 + 3, 'font-size': 9, 'text-anchor': 'middle', 'font-weight': 700, fill: '#fff' }, fmt(cT)));
        if (hO >= 13) stage.appendChild(el('text', { x: bx + bw / 2, y: base - hO / 2 + 3, 'font-size': 9, 'text-anchor': 'middle', 'font-weight': 700, fill: '#1f1f26' }, fmt(cO)));
        stage.appendChild(el('text', { x: bx + bw / 2, y: base - hO - hT - 5, 'font-size': 10, 'text-anchor': 'middle', 'font-weight': 700, fill: INK }, fmt(cT + cO)));
        stage.appendChild(el('text', { x: x0 + W / 2, y: base + 14, 'font-size': 9, 'text-anchor': 'middle', fill: INK }, 'bulk signal'));
      } else {
        const bw = 44, xs = [x0 + 18, x0 + 88], vals = [t, o], cols = [C_T, C_O], names = ['T cells', 'other cells'];
        vals.forEach((v, i) => {
          const h = (v / 100) * H;
          if (h > 0) stage.appendChild(el('rect', { x: xs[i], y: base - h, width: bw, height: h, fill: cols[i] }));
          stage.appendChild(el('text', { x: xs[i] + bw / 2, y: base - h - 5, 'font-size': 10, 'text-anchor': 'middle', 'font-weight': 700, fill: INK }, fmt(v)));
          stage.appendChild(el('text', { x: xs[i] + bw / 2, y: base + 14, 'font-size': 9, 'text-anchor': 'middle', fill: INK }, names[i]));
        });
      }
    }

    function render() {
      const f = +inp('f').value / 100, t = +inp('t').value, o = +inp('o').value, sc = inp('sc').checked;
      out('f').textContent = `${Math.round(f * 100)}%`;
      out('t').textContent = String(t);
      out('o').textContent = String(o);
      const b0 = bulk(B_F, B_T, B_O), b1 = bulk(f, t, o), fold = b1 / b0;
      const maxV = Math.max(b0, b1, 1) * 1.1;

      stage.replaceChildren();
      panel(20, 'Before', B_F, B_T, B_O, sc, maxV);
      panel(190, 'After', f, t, o, sc, maxV);
      stage.appendChild(el('text', { x: 180, y: 252, 'font-size': 9, 'text-anchor': 'middle', fill: INK },
        sc ? 'bar height: units of gene X per cell (0 to 100)' : `bar height: units per average cell (0 to ${fmt(maxV)}); teal = T, orange = other`));

      const l1 = `Bulk before = ${fmt(B_F)} × ${B_T} + ${fmt(1 - B_F)} × ${B_O} = ${fmt(B_F * B_T)} + ${fmt((1 - B_F) * B_O)} = ${fmt(b0)} units per average cell.`;
      const l2 = `Bulk after = ${fmt(f)} × ${t} + ${fmt(1 - f)} × ${o} = ${fmt(f * t)} + ${fmt((1 - f) * o)} = ${fmt(b1)} units per average cell.`;
      const l3 = `Fold change = ${fmt(b1)} / ${fmt(b0)} = ${fold.toFixed(2)}.`;
      math.replaceChildren();
      [l1, l2, l3].forEach((s) => { const p = document.createElement('div'); p.textContent = s; math.appendChild(p); });

      const compChanged = Math.round(f * 100) !== Math.round(B_F * 100);
      const regChanged = t !== B_T || o !== B_O;
      const dir = fold > 1 ? 'up' : 'down';
      const canceled = Math.abs(fold - 1) < 0.005;
      let v: string;
      if (!compChanged && !regChanged) {
        v = `Nothing has changed from the lesson’s starting point (T is 20% of cells, 50 and 5 units per cell), so bulk stays at ${fmt(b0)} and the fold change is 1.00. Move a slider.`;
      } else if (compChanged && !regChanged) {
        v = `Composition only. T goes from 20% to ${Math.round(f * 100)}% with no change in expression per cell, yet bulk goes from ${fmt(b0)} to ${fmt(b1)}: a ${fold.toFixed(2)}-fold change, ${dir}, although no cell regulated gene X.`;
      } else if (!compChanged && regChanged) {
        v = canceled
          ? `In this sketch, with T fixed at 20% of cells, the per-cell levels changed in a way that leaves the bulk average at ${fmt(b1)}, so the bulk number shows no change.`
          : `In this sketch’s arithmetic, with T fixed at 20% of cells, the ${fold.toFixed(2)}-fold bulk change (${fmt(b0)} to ${fmt(b1)}) can only come from the per-cell levels.`;
      } else {
        const compOnly = bulk(f, B_T, B_O) / b0, regOnly = bulk(B_F, t, o) / b0;
        v = `Both, in this sketch. The proportion of T changed (by the formula alone it would give ${compOnly.toFixed(2)}-fold) and per-cell expression changed (by the formula alone it would give ${regOnly.toFixed(2)}-fold). ` +
          (canceled ? 'In this sketch, together they cancel, so the bulk average shows no change.' : `Together the bulk goes ${dir} ${fold.toFixed(2)}-fold. Per lesson step 4, single-cell data would show the per-cell levels and the cluster proportions separately.`);
      }
      if (sc) {
        v += ` Single-cell view: per-cell level in T is ${B_T} before and ${t} after; in other cells ${B_O} before and ${o} after.`;
      }
      verdict.textContent = v;
    }
    ['f', 't', 'o'].forEach((k) => inp(k).addEventListener('input', render));
    inp('sc').addEventListener('change', render);
    root.querySelector<HTMLButtonElement>('[data-reset]')!.addEventListener('click', () => {
      inp('f').value = '40'; inp('t').value = '50'; inp('o').value = '5'; render();
    });
    render();
  });
</script>

<style is:global>
  .bvc { padding: var(--ddp-space-3) var(--ddp-space-4) var(--ddp-space-4); margin: var(--ddp-space-5) 0; }
  .bvc-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem; font-weight: 600; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); margin-bottom: var(--ddp-space-3); }
  .bvc-chip { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 400; color: var(--ddp-color-muted); }
  .bvc-svg { display: block; width: 100%; max-width: 600px; margin: 0 auto var(--ddp-space-3); height: auto; background: #fff; border: 1px solid var(--ddp-color-line); border-radius: 6px; }
  .bvc-controls { display: flex; flex-direction: column; gap: 0.5rem; margin: var(--ddp-space-2) 0; }
  .bvc-ctl { display: flex; flex-direction: column; gap: 0.15rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .bvc-ctl-name { display: flex; justify-content: space-between; gap: 0.5rem; }
  .bvc-ctl output { font-weight: 700; color: var(--ddp-color-primary); }
  .bvc-ctl input { width: 100%; accent-color: var(--ddp-color-accent); }
  .bvc-row { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem 1rem; }
  .bvc-tog { font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .bvc-tog input { accent-color: var(--ddp-color-accent); }
  .bvc-btn { border: 1px solid var(--ddp-color-line); border-radius: 5px; background: transparent; color: var(--ddp-color-ink-soft); font-size: var(--ddp-text-xs); padding: 0.25rem 0.5rem; cursor: pointer; }
  .bvc-btn:focus-visible, .bvc-ctl input:focus-visible, .bvc-tog input:focus-visible { outline: 2px solid var(--ddp-color-accent); outline-offset: 2px; }
  .bvc-math { margin: var(--ddp-space-2) 0; font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); line-height: 1.55; overflow-wrap: anywhere; }
  .bvc-verdict { margin: var(--ddp-space-2) 0; padding: var(--ddp-space-2) var(--ddp-space-3); background: color-mix(in srgb, var(--ddp-color-accent) 8%, transparent); border-radius: 6px; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); min-height: 4.5em; }
  .bvc-foot { margin: var(--ddp-space-3) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); border-left: 3px solid var(--ddp-color-secondary); padding-left: 0.55rem; }
</style>
