---
/**
 * TcaCarbonTracker — the carbon-bookkeeping companion to the TCA PathwayExplorer. The ring
 * map shows the enzymes and the NADH/FADH2/GTP tally; this island answers the question that
 * trips everyone: which carbons actually leave as CO2? Step through one turn and watch the
 * two acetyl carbons (orange) join oxaloacetate's C=O carbon, the -OH move onto the navy arm,
 * the two navy carboxyls of that arm leave as CO2, and symmetric succinate scramble the label.
 * A second tally shows the electron pairs loading at 3, 4, 6 and 8, half of them after both
 * CO2 have gone, and two summary frames show turns 2 and 3. Each intermediate is drawn from
 * an explicit atom layout. Self-contained vanilla-TS Astro island. Original.
 */
---

<figure class="cct card" data-cctrack>
  <figcaption class="cct-head">Follow the carbons through one turn, then the next<span class="cct-chip">⚙ original · interactive</span></figcaption>

  <svg class="cct-svg" viewBox="0 0 460 140" role="img" aria-label="The carbon skeleton of the current intermediate, colored by where each carbon came from, with the CO₂ released so far." data-svg></svg>

  <ul class="cct-legend" aria-hidden="true">
    <li><i class="cct-key cct-key-a"></i>from acetyl-CoA (this turn)</li>
    <li><i class="cct-key cct-key-o"></i>from oxaloacetate</li>
    <li><i class="cct-key cct-key-s"></i>scrambled: 50/50 either origin</li>
    <li><i class="cct-key cct-key-l"></i>leaves as CO₂ at the next step</li>
  </ul>

  <div class="cct-stage">
    <span class="cct-stepname" data-name></span>
    <span class="cct-count" data-count></span>
  </div>
  <p class="cct-note" data-note role="status"></p>

  <div class="cct-controls">
    <button type="button" data-prev aria-label="Previous step">‹ Back</button>
    <span class="cct-progress" data-prog>Step 1 / 9</span>
    <button type="button" data-next aria-label="Next step">Next ›</button>
    <button type="button" data-turn aria-label="Show the next turn" hidden>Next turn ›</button>
    <button type="button" data-reset class="cct-reset">Reset</button>
  </div>

  <div class="cct-tally">
    <span>CO₂ released this turn: <strong data-co2>0</strong> / 2 — <span data-co2src>both oxaloacetate-derived</span></span>
    <span>Electron pairs loaded: <strong data-pairs>0</strong> / 4</span>
  </div>

  <p class="cct-foot">The net is honest — two carbons in as acetyl-CoA, two out as CO₂. But in this one turn the CO₂ comes from oxaloacetate, while your labeled acetyl carbons stay in the molecule. The carbonyl carbon leaves in turn 2; the methyl carbon trickles out, half of what remains each turn from turn 3. The electrons part ways with the carbons too: two pairs load as the CO₂ leaves, and two more load during the rebuild, after the CO₂ is gone.</p>
</figure>

<script>
  const ORANGE = '#e57200', NAVY = '#232d4b', MUTED = '#6b6b6b', GOLD = '#c99700';
  const SVGNS = 'http://www.w3.org/2000/svg';
  function el(name: string, attrs: Record<string, string | number>, text?: string): SVGElement {
    const e = document.createElementNS(SVGNS, name);
    for (const k in attrs) e.setAttribute(k, String(attrs[k]));
    if (text !== undefined) e.textContent = text;
    return e;
  }
  // o: A = from acetyl-CoA, O = from oxaloacetate, S = scrambled. tag: a small group label
  // drawn beside the atom; tagAt places it (default below).
  type Atom = { x: number; y: number; o: 'A' | 'O' | 'S'; tag?: string; tagAt?: 'below' | 'right' };
  type Step = {
    name: string; enzyme: string; atoms: Atom[]; bonds: [number, number][];
    leaving?: number[]; co2: number; pairs: number; note: string;
    co2Orange?: number;   // turn summary frames: share of each CO₂ pill drawn orange
    co2Src?: string;      // text after the CO₂ count
    progress?: string;    // overrides "Step n / 9"
    caption?: string;     // extra orange caption above the orange arm
  };
  const C = 'COO⁻';
  // linear chain of n atoms centered on x = 190
  const line = (os: ('A' | 'O' | 'S')[], tags: (string | undefined)[]): Atom[] =>
    os.map((o, k) => ({ x: 190 - (os.length - 1) * 23 + k * 46, y: 84, o, tag: tags[k] }));
  const chainBonds = (n: number): [number, number][] => Array.from({ length: n - 1 }, (_, k) => [k, k + 1] as [number, number]);
  // Citrate / isocitrate skeleton: 0 old carbonyl (now COO⁻), 1 old methyl (CH₂), 2 central carbon
  // (OAA's old C=O), 3 navy carboxyl on the central carbon, 4 navy CH₂, 5 navy end carboxyl.
  const branched = (ohOn: 2 | 4): Atom[] => [
    { x: 98, y: 84, o: 'A', tag: C },
    { x: 144, y: 84, o: 'A' },
    { x: 190, y: 84, o: 'O', tag: ohOn === 2 ? '–OH' : undefined },
    { x: 190, y: 40, o: 'O', tag: C, tagAt: 'right' },
    { x: 236, y: 84, o: 'O', tag: ohOn === 4 ? '–OH' : undefined },
    { x: 282, y: 84, o: 'O', tag: C },
  ];
  const branchedBonds: [number, number][] = [[0, 1], [1, 2], [2, 3], [2, 4], [4, 5]];
  const S4 = (mid?: string): Atom[] => line(['S', 'S', 'S', 'S'], [C, mid, undefined, C]);
  const STEPS: Step[] = [
    { name: 'Oxaloacetate', enzyme: 'start of the turn', atoms: line(['O', 'O', 'O', 'O'], [C, 'C=O', undefined, C]), bonds: chainBonds(4), co2: 0, pairs: 0, note: 'The four-carbon acceptor (navy): a carboxyl at each end and two middle carbons, one carrying a C=O. No acetyl carbons yet.' },
    { name: 'Citrate', enzyme: 'citrate synthase', atoms: branched(2), bonds: branchedBonds, co2: 0, pairs: 0, caption: '+ 2 C from acetyl-CoA', note: 'Acetyl-CoA delivers two carbons (orange). Its methyl carbon bonds to oxaloacetate\'s C=O carbon, which becomes citrate\'s central carbon with three branches: the orange arm, a navy arm and a navy carboxyl.' },
    { name: 'Isocitrate', enzyme: 'aconitase', atoms: branched(4), bonds: branchedBonds, leaving: [3], co2: 0, pairs: 0, note: 'Aconitase moves the –OH onto the navy, oxaloacetate-derived arm. It can tell the two look-alike arms apart because it grips citrate at three points. Nothing is lost, but this choice decides which carbons leave next.' },
    { name: 'α-Ketoglutarate', enzyme: 'isocitrate dehydrogenase', atoms: line(['A', 'A', 'O', 'O', 'O'], [C, undefined, undefined, 'C=O', C]), bonds: chainBonds(5), leaving: [4], co2: 1, pairs: 1, note: 'First CO₂ leaves (isocitrate dehydrogenase) and NADH #1 is loaded. The –OH became a C=O, and the navy carboxyl beside it, on the central carbon, left: not one of the two carbons you just added.' },
    { name: 'Succinyl-CoA', enzyme: 'α-ketoglutarate dehydrogenase', atoms: line(['A', 'A', 'O', 'O'], [C, undefined, undefined, 'CoA']), bonds: chainBonds(4), co2: 2, pairs: 2, note: 'Second CO₂ leaves (α-ketoglutarate dehydrogenase) and NADH #2 is loaded. It takes the carboxyl at the far end of the same navy arm. Both CO₂ for this turn are gone, and neither was an acetyl carbon.' },
    { name: 'Succinate', enzyme: 'succinyl-CoA synthetase', atoms: S4(), bonds: chainBonds(4), co2: 2, pairs: 2, note: 'Succinate is symmetric: no enzyme can tell its two ends apart, so the acetyl label scrambles — each of the four carbons is now 50/50 acetyl- or oxaloacetate-derived (shown half-and-half). This step makes GTP; no electrons are loaded.' },
    { name: 'Fumarate', enzyme: 'succinate dehydrogenase', atoms: S4(), bonds: chainBonds(4), co2: 2, pairs: 3, note: 'FADH₂ is loaded: electron pair 3, with no carbon lost. Four carbons, label still scrambled.' },
    { name: 'Malate', enzyme: 'fumarase', atoms: S4('–OH'), bonds: chainBonds(4), co2: 2, pairs: 3, note: 'Water is added. Four carbons, one oxidation from the finish.' },
    { name: 'Oxaloacetate (regenerated)', enzyme: 'malate dehydrogenase', atoms: S4('C=O'), bonds: chainBonds(4), co2: 2, pairs: 4, note: 'NADH #3 is loaded: the fourth electron pair. Half the pairs came during the rebuild, after both CO₂ had gone. Your two labeled carbons are still here; they only leave in later turns.' },
  ];
  const TURNS: Step[] = [
    { ...STEPS[8], name: 'Turn 2 (summary)', enzyme: 'summary of a second full turn', co2: 2, pairs: 4, co2Orange: 0.5, co2Src: 'carrying all of the old carbonyl label', progress: 'Turn 2', note: 'Turn 2: both ends of the oxaloacetate leave, taking all of the old carbonyl label. Each CO₂ has even odds of being the labeled one.' },
    { ...STEPS[8], name: 'Turn 3 (summary)', enzyme: 'summary of a third full turn', co2: 2, pairs: 4, co2Orange: 0.25, co2Src: 'carrying half of the methyl label', progress: 'Turn 3', note: 'Turn 3: half of the methyl label leaves; the rest waits. A middle carbon must first reach an end, and each turn does that only half the time.' },
  ];
  const FRAMES: Step[] = [...STEPS, ...TURNS];
  const LAST_STEP = STEPS.length - 1;

  function draw(svg: SVGElement, step: Step, prev: Step | null, animate: boolean) {
    const g = el('g', {});
    const cy = 84;
    const released = prev ? step.co2 - prev.co2 : 0;
    const countA = (s: Step) => s.atoms.filter((a) => a.o === 'A').length;
    const joined = prev ? countA(step) - countA(prev) : 0;
    // step caption: which enzyme produced this intermediate
    g.appendChild(el('text', { x: 12, y: 22, fill: MUTED, 'font-size': 11.5, 'font-style': 'italic' }, step.enzyme === 'start of the turn' || step.progress ? step.enzyme : `via ${step.enzyme}`));
    // bonds, then atoms
    for (const [a, b] of step.bonds) {
      const p = step.atoms[a], q = step.atoms[b];
      g.appendChild(el('line', { x1: p.x, y1: p.y, x2: q.x, y2: q.y, stroke: '#9aa0b4', 'stroke-width': 4, 'stroke-linecap': 'round' }));
    }
    step.atoms.forEach((a, k) => {
      const { x, y } = a, r = 17;
      const isNew = animate && joined > 0 && a.o === 'A';
      const atom = el('g', isNew ? { class: 'cct-pop', style: `transform-origin:${x}px ${y}px` } : {});
      if (a.o === 'S') {
        atom.appendChild(el('path', { d: `M${x},${y - r} A${r},${r} 0 0 0 ${x},${y + r} Z`, fill: ORANGE }));
        atom.appendChild(el('path', { d: `M${x},${y - r} A${r},${r} 0 0 1 ${x},${y + r} Z`, fill: NAVY }));
        atom.appendChild(el('circle', { cx: x, cy: y, r, fill: 'none', stroke: '#fff', 'stroke-width': 2 }));
      } else {
        atom.appendChild(el('circle', { cx: x, cy: y, r, fill: a.o === 'A' ? ORANGE : NAVY, stroke: '#fff', 'stroke-width': 2 }));
      }
      atom.appendChild(el('text', { x, y: y + 5, 'text-anchor': 'middle', fill: '#fff', 'font-size': 14, 'font-weight': 700 }, 'C'));
      g.appendChild(atom);
      if (a.tag) {
        const right = a.tagAt === 'right';
        g.appendChild(el('text', { x: right ? x + 26 : x, y: right ? y + 4 : y + 33, 'text-anchor': right ? 'start' : 'middle', fill: MUTED, 'font-size': 10.5, 'font-weight': 600 }, a.tag));
      }
      if (step.leaving?.includes(k)) {
        g.appendChild(el('circle', { cx: x, cy: y, r: r + 5, fill: 'none', stroke: GOLD, 'stroke-width': 2.5, 'stroke-dasharray': '5 3' }));
      }
    });
    if (step.caption) {
      g.appendChild(el('text', { x: 108, y: 54, 'text-anchor': 'middle', fill: '#a85400', 'font-size': 11, 'font-weight': 700 }, step.caption));
    }
    // CO2 released so far this turn, parked right; the one released on this step floats in
    const f = step.co2Orange ?? 0;
    g.appendChild(el('text', { x: 405, y: 122, 'text-anchor': 'middle', fill: MUTED, 'font-size': 10.5 }, !step.co2 ? 'no CO₂ yet' : f ? 'orange: label odds' : 'released (from OAA)'));
    for (let j = 0; j < 2; j++) {
      const x = 380 + j * 50, y = cy;
      if (j >= step.co2) {
        g.appendChild(el('circle', { cx: x, cy: y, r: 18, fill: 'none', stroke: '#c9cedb', 'stroke-width': 1.5, 'stroke-dasharray': '4 3' }));
        continue;
      }
      const fresh = animate && released > 0 && j === step.co2 - 1;
      const b = el('g', fresh ? { class: 'cct-float', style: `--cct-dx:${j ? -125 : -95}px` } : {});
      b.appendChild(el('circle', { cx: x, cy: y, r: 18, fill: '#fff', stroke: NAVY, 'stroke-width': 2.5 }));
      if (f > 0) {
        // orange wedge from 12 o'clock, clockwise, covering f of the pill
        const ang = 2 * Math.PI * f, rr = 16.5;
        const ex = x + rr * Math.sin(ang), ey = y - rr * Math.cos(ang);
        b.appendChild(el('path', { d: `M${x},${y} L${x},${y - rr} A${rr},${rr} 0 ${f > 0.5 ? 1 : 0} 1 ${ex.toFixed(2)},${ey.toFixed(2)} Z`, fill: ORANGE, opacity: 0.85 }));
      }
      b.appendChild(el('text', { x, y: y + 4.5, 'text-anchor': 'middle', fill: NAVY, 'font-size': 12, 'font-weight': 700 }, 'CO₂'));
      g.appendChild(b);
    }
    svg.replaceChildren(g);
  }

  document.querySelectorAll<HTMLElement>('[data-cctrack]').forEach((root) => {
    const svg = root.querySelector('[data-svg]') as unknown as SVGElement;
    const nameEl = root.querySelector<HTMLElement>('[data-name]')!;
    const countEl = root.querySelector<HTMLElement>('[data-count]')!;
    const noteEl = root.querySelector<HTMLElement>('[data-note]')!;
    const progEl = root.querySelector<HTMLElement>('[data-prog]')!;
    const co2El = root.querySelector<HTMLElement>('[data-co2]')!;
    const co2SrcEl = root.querySelector<HTMLElement>('[data-co2src]')!;
    const pairsEl = root.querySelector<HTMLElement>('[data-pairs]')!;
    const prevB = root.querySelector<HTMLButtonElement>('[data-prev]')!;
    const nextB = root.querySelector<HTMLButtonElement>('[data-next]')!;
    const turnB = root.querySelector<HTMLButtonElement>('[data-turn]')!;
    const resetB = root.querySelector<HTMLButtonElement>('[data-reset]')!;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    let i = 0;
    function render(from: number | null = null) {
      const s = FRAMES[i];
      nameEl.textContent = s.name;
      countEl.textContent = `${s.atoms.length} carbons`;
      noteEl.textContent = s.note;
      progEl.textContent = s.progress ?? `Step ${i + 1} / ${STEPS.length}`;
      co2El.textContent = String(s.co2);
      co2SrcEl.textContent = s.co2Src ?? 'both oxaloacetate-derived';
      pairsEl.textContent = String(s.pairs);
      prevB.disabled = i === 0;
      nextB.disabled = i >= LAST_STEP;
      // the extra turn frames come after the last step of turn 1
      turnB.hidden = i < LAST_STEP || i === FRAMES.length - 1;
      const forward = from !== null && from === i - 1 && i <= LAST_STEP;
      draw(svg, s, forward ? FRAMES[from as number] : null, forward && !reduce.matches);
    }
    // keep focus on a usable button when one disables or hides itself
    prevB.addEventListener('click', () => { if (i > 0) { i--; render(); if (i === 0) nextB.focus(); } });
    nextB.addEventListener('click', () => { if (i < LAST_STEP) { i++; render(i - 1); if (i === LAST_STEP) turnB.focus(); } });
    turnB.addEventListener('click', () => { if (i < FRAMES.length - 1) { i++; render(i - 1); if (i === FRAMES.length - 1) prevB.focus(); } });
    resetB.addEventListener('click', () => { i = 0; render(); });
    render();
  });
</script>

<style>
  .cct { padding: var(--ddp-space-3) var(--ddp-space-4) var(--ddp-space-4); margin: var(--ddp-space-5) 0; }
  .cct-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem; font-weight: 600; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); margin-bottom: var(--ddp-space-2); }
  .cct-chip { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 400; color: var(--ddp-color-muted); }
  .cct-svg { width: 100%; height: auto; display: block; background: color-mix(in srgb, var(--ddp-color-accent) 5%, #fff); border: 1px solid var(--ddp-color-line); border-radius: 8px; margin-bottom: var(--ddp-space-2); }
  .cct .cct-legend { list-style: none; margin: 0 0 var(--ddp-space-2); padding: 0; display: flex; flex-wrap: wrap; gap: 0.2rem 0.9rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .cct .cct-legend li { display: inline-flex; align-items: center; gap: 0.35rem; margin: 0; padding: 0; font-size: var(--ddp-text-xs); line-height: 1.4; }
  .cct .cct-legend li::before, .cct .cct-legend li::marker { content: none; }
  .cct-key { display: inline-block; width: 0.75rem; height: 0.75rem; border-radius: 50%; }
  .cct-key-a { background: #e57200; }
  .cct-key-o { background: #232d4b; }
  .cct-key-s { background: linear-gradient(90deg, #e57200 50%, #232d4b 50%); }
  .cct-key-l { background: none; border: 2px dashed #c99700; box-sizing: border-box; }
  .cct-stage { display: flex; align-items: baseline; justify-content: space-between; gap: 0.5rem; margin-bottom: var(--ddp-space-1); }
  .cct-stepname { font-size: var(--ddp-text-lg); font-weight: 700; color: var(--ddp-color-primary); }
  .cct-count { white-space: nowrap; font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); color: var(--ddp-color-accent); }
  .cct-note { margin: 0 0 var(--ddp-space-3); font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); line-height: 1.5; min-height: 3.4em; }
  .cct-controls { display: flex; align-items: center; gap: 0.4rem; margin-bottom: var(--ddp-space-3); }
  .cct-controls button { font-family: inherit; font-size: var(--ddp-text-xs); border: 1px solid var(--ddp-color-line); background: #fff; color: var(--ddp-color-ink-soft); border-radius: 5px; padding: 0.32rem 0.7rem; cursor: pointer; }
  .cct-controls button:hover:not(:disabled) { border-color: var(--ddp-color-accent); color: var(--ddp-color-primary); }
  .cct-controls button:disabled { opacity: 0.4; cursor: default; }
  .cct-reset { margin-left: auto; }
  .cct-progress { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .cct-tally { display: flex; flex-wrap: wrap; gap: 0.2rem 1rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); padding: var(--ddp-space-2) var(--ddp-space-3); background: color-mix(in srgb, var(--ddp-color-accent) 8%, transparent); border-radius: 6px; }
  .cct-tally strong { color: var(--ddp-color-accent); font-family: var(--ddp-font-mono); }
  .cct-foot { margin: var(--ddp-space-3) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); border-left: 3px solid var(--ddp-color-secondary); padding-left: 0.55rem; }
</style>

<style is:global>
  /* runtime-drawn SVG groups (no Astro scope stamp), anchored to the .cct prefix */
  .cct .cct-pop { animation: cct-pop 420ms cubic-bezier(.2,.9,.3,1.3) both; }
  .cct .cct-float { animation: cct-float 520ms ease-out both; }
  @keyframes cct-pop { from { transform: scale(0.2); opacity: 0; } to { transform: scale(1); opacity: 1; } }
  @keyframes cct-float { from { transform: translate(var(--cct-dx, -100px), 0) scale(0.6); opacity: 0.2; } to { transform: translate(0, 0) scale(1); opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .cct .cct-pop, .cct .cct-float { animation: none; } }
</style>
