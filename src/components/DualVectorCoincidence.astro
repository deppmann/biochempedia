---
/**
 * DualVectorCoincidence — a sketch of why dual-AAV rescue is capped by coincidence.
 * 100 sketch inner hair cells; each is reached by vector 1 (with probability p1) and,
 * separately, by vector 2 (probability p2). Only cells with both are counted as able to
 * rebuild full-length otoferlin. Expected fraction under independence = p1 x p2, shown
 * beside the observed count in the drawn field and the reported maximum (up to 50 percent).
 * Self-contained vanilla-TS Astro island. Original.
 */
---

<figure class="dvc card" data-dvc>
  <figcaption class="dvc-head">Two vectors, one cell — coverage by coincidence<span class="dvc-chip">⚙ original · interactive</span></figcaption>

  <svg class="dvc-svg" viewBox="0 0 340 340" role="img" aria-label="A 10 by 10 field of sketch inner hair cells marked by vector 1, vector 2 or both, and bars comparing the expected fraction with both, the observed fraction and the reported maximum of up to 50 percent" data-plot></svg>

  <div class="dvc-controls">
    <label class="dvc-slabel"><span>Cells reached by vector 1 <em data-out="p1">70</em>%</span>
      <input type="range" data-in="p1" min="0" max="100" step="1" value="70" />
    </label>
    <label class="dvc-slabel"><span>Cells reached by vector 2 <em data-out="p2">70</em>%</span>
      <input type="range" data-in="p2" min="0" max="100" step="1" value="70" />
    </label>
    <button type="button" class="dvc-btn" data-resample>Resample</button>
  </div>

  <dl class="dvc-readout">
    <div><dt>Expected with both (p1 × p2)</dt><dd data-r-exp>49.0 of 100</dd></div>
    <div><dt>Observed in this drawn field</dt><dd data-r-obs>0 of 100</dd></div>
    <div><dt>Reported maximum</dt><dd>up to 50 percent</dd></div>
  </dl>

  <p class="dvc-why" data-why role="status"></p>

  <p class="dvc-assume">In this sketch: independent delivery, every cell with both halves counted as reconstituted, made-up reach values. The reference line is from Otof-null mice injected at P6 to P7 with dual AAV2/6 (Al-Moyed and colleagues, 2019).</p>
  <p class="dvc-assume dvc-refuse">This sketch does not say: that the product is a prediction (real transduction is not independent); that a cell with both vectors works normally (vesicle replenishment reached only 35 to 50 percent of wild type in transduced cells); that coverage equals hearing (click ABR thresholds in treated mice were 40 to 60 dB); or anything about children or speech.</p>

  <p class="dvc-foot">A cell can rebuild full-length otoferlin only if it received both halves, so, in this sketch, the fraction with full-length otoferlin is limited by how many cells receive both, not by either vector alone.</p>
</figure>

<script>
  const NS = 'http://www.w3.org/2000/svg';
  const C1 = '#0e7c86', C2 = '#e57200', BOTH = '#2f2a6b', INK = '#4b4b55', FAINT = '#b9b9c2';
  function el(name: string, attrs: Record<string, string | number>): SVGElement {
    const e = document.createElementNS(NS, name);
    for (const k in attrs) e.setAttribute(k, String(attrs[k]));
    return e;
  }
  function mulberry(a: number) {
    return () => {
      a |= 0; a = (a + 0x6d2b79f5) | 0;
      let t = Math.imul(a ^ (a >>> 15), 1 | a);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }
  document.querySelectorAll<HTMLElement>('[data-dvc]').forEach((root) => {
    const plot = root.querySelector<SVGSVGElement>('[data-plot]');
    const p1In = root.querySelector<HTMLInputElement>('[data-in="p1"]');
    const p2In = root.querySelector<HTMLInputElement>('[data-in="p2"]');
    const p1Out = root.querySelector<HTMLElement>('[data-out="p1"]');
    const p2Out = root.querySelector<HTMLElement>('[data-out="p2"]');
    const rExp = root.querySelector<HTMLElement>('[data-r-exp]');
    const rObs = root.querySelector<HTMLElement>('[data-r-obs]');
    const why = root.querySelector<HTMLElement>('[data-why]');
    const btn = root.querySelector<HTMLButtonElement>('[data-resample]');
    if (!plot || !p1In || !p2In || !p1Out || !p2Out || !rExp || !rObs || !why || !btn) return;

    const N = 100;
    // Each cell keeps two fixed random numbers; vector k reaches the cell when u_k < p_k.
    // Resample redraws them, so moving a slider changes the coverage of the same field.
    let u1: number[] = [], u2: number[] = [];
    function draw(seed: number) {
      const r = mulberry(seed);
      u1 = []; u2 = [];
      for (let i = 0; i < N; i++) { u1.push(r()); u2.push(r()); }
    }
    draw(20190);

    const GX = 10, GY = 8, CS = 20, PAD = 2; // grid origin and cell pitch (viewBox units)
    const BX0 = 92, BX1 = 272; // bar axis: 0 to 100 percent

    function render() {
      const p1 = parseInt(p1In!.value, 10), p2 = parseInt(p2In!.value, 10);
      p1Out!.textContent = String(p1); p2Out!.textContent = String(p2);
      const exp = (p1 / 100) * (p2 / 100) * N;
      let n1 = 0, n2 = 0, nb = 0;
      plot!.replaceChildren();

      for (let i = 0; i < N; i++) {
        const a = u1[i] < p1 / 100, b = u2[i] < p2 / 100;
        if (a) n1++; if (b) n2++; if (a && b) nb++;
        const x = GX + (i % 10) * CS, y = GY + Math.floor(i / 10) * CS;
        const w = CS - PAD * 2, h = CS - PAD * 2;
        if (a && b) {
          plot!.appendChild(el('rect', { x: x + PAD, y: y + PAD, width: w, height: h, rx: 3, fill: BOTH, stroke: BOTH, 'stroke-width': 1 }));
        } else {
          plot!.appendChild(el('rect', { x: x + PAD, y: y + PAD, width: w, height: h, rx: 3, fill: '#fff', stroke: FAINT, 'stroke-width': 1 }));
          if (a) plot!.appendChild(el('rect', { x: x + PAD + 1, y: y + PAD + 1, width: w / 2 - 1, height: h - 2, fill: C1 }));
          if (b) plot!.appendChild(el('rect', { x: x + PAD + w / 2, y: y + PAD + 1, width: w / 2 - 1, height: h - 2, fill: C2 }));
        }
      }
      // legend, right of the field
      const LX = 222;
      const legend: Array<[string, string, string, string]> = [
        ['half', C1, 'vector 1', 'left half of cell'],
        ['half', C2, 'vector 2', 'right half of cell'],
        ['full', BOTH, 'both vectors:', 'counted as full-length'],
      ];
      let ly = GY + 10;
      for (const [kind, col, t1, t2] of legend) {
        if (kind === 'full') plot!.appendChild(el('rect', { x: LX, y: ly, width: 14, height: 14, rx: 3, fill: col }));
        else plot!.appendChild(el('rect', { x: LX, y: ly, width: 14, height: 14, rx: 3, fill: '#fff', stroke: FAINT }));
        if (kind === 'half') {
          const left = col === C1;
          plot!.appendChild(el('rect', { x: left ? LX + 1 : LX + 7, y: ly + 1, width: 6, height: 12, fill: col }));
        }
        const a = el('text', { x: LX + 20, y: ly + 7, 'font-size': 9, fill: INK }); a.textContent = t1; plot!.appendChild(a);
        const b = el('text', { x: LX + 20, y: ly + 18, 'font-size': 9, fill: INK }); b.textContent = t2; plot!.appendChild(b);
        ly += 32;
      }
      const nt = el('text', { x: LX, y: ly + 6, 'font-size': 9, fill: INK }); nt.textContent = 'white = neither vector'; plot!.appendChild(nt);
      const nt2 = el('text', { x: LX, y: ly + 18, 'font-size': 9, fill: INK }); nt2.textContent = '(100 sketch cells)'; plot!.appendChild(nt2);

      // bars
      const BY = 222;
      const xAt = (pct: number) => BX0 + (pct / 100) * (BX1 - BX0);
      const title = el('text', { x: 10, y: BY - 6, 'font-size': 10, 'font-weight': 700, fill: INK }); title.textContent = 'cells with both vectors (percent of 100)'; plot!.appendChild(title);
      const rows: Array<[string, number, string]> = [
        ['expected', exp, C1],
        ['observed', nb, BOTH],
      ];
      rows.forEach(([lab, val, col], i) => {
        const y = BY + 8 + i * 30;
        const t = el('text', { x: 10, y: y + 14, 'font-size': 9, fill: INK }); t.textContent = lab; plot!.appendChild(t);
        plot!.appendChild(el('rect', { x: BX0, y, width: BX1 - BX0, height: 20, fill: '#f3f3f6' }));
        if (val > 0) plot!.appendChild(el('rect', { x: BX0, y, width: xAt(val) - BX0, height: 20, fill: col }));
        const v = el('text', { x: BX1 + 6, y: y + 14, 'font-size': 9, 'font-weight': 700, fill: INK });
        v.textContent = (i === 0 ? val.toFixed(1) : String(val)) + ' / 100'; plot!.appendChild(v);
      });
      // axis ticks
      const AY = BY + 8 + 60;
      plot!.appendChild(el('line', { x1: BX0, y1: AY, x2: BX1, y2: AY, stroke: INK, 'stroke-width': 1 }));
      for (const tk of [0, 25, 50, 75, 100]) {
        plot!.appendChild(el('line', { x1: xAt(tk), y1: AY, x2: xAt(tk), y2: AY + 3, stroke: INK, 'stroke-width': 1 }));
        const t = el('text', { x: xAt(tk), y: AY + 13, 'text-anchor': 'middle', 'font-size': 9, fill: INK }); t.textContent = tk + '%'; plot!.appendChild(t);
      }
      // reported maximum reference line
      plot!.appendChild(el('line', { x1: xAt(50), y1: BY + 4, x2: xAt(50), y2: AY, stroke: '#c0392b', 'stroke-width': 1.5, 'stroke-dasharray': '4 3' }));
      const rt = el('text', { x: xAt(50), y: AY + 26, 'text-anchor': 'middle', 'font-size': 9, 'font-weight': 700, fill: '#c0392b' });
      rt.textContent = 'reported maximum: up to 50 percent'; plot!.appendChild(rt);

      rExp!.textContent = exp.toFixed(1) + ' of 100';
      rObs!.textContent = nb + ' of 100';

      // status
      const head = `In this sketch, vector 1 reaches ${n1} cells and vector 2 reaches ${n2} in the drawn field; ${nb} have both. The expected number under independence is ${p1}% × ${p2}% = ${exp.toFixed(1)} of 100, and the field is one random draw of it, so Resample moves the observed count around the expected one.`;
      let tail: string;
      if (p1 === 0 || p2 === 0) {
        tail = ' With one vector reaching no cell, no cell has both halves, so none can rebuild full-length otoferlin in this sketch.';
      } else if (Math.abs(exp - 50) < 1.5) {
        tail = ' That is close to the reported maximum of up to 50 percent of inner hair cells in Otof-null mice. Real transduction is not independent, so this is a way to see why coverage is capped; it is not a prediction.';
      } else if (exp > 50) {
        tail = ' That is not close to the reported maximum of up to 50 percent in the mouse study; the reach values here are made up, the sketch assumes independence, and real transduction is not independent, so it is not a prediction.';
      } else {
        tail = ' That is not close to the reported maximum of up to 50 percent in the mouse study; the reach values here are made up, the sketch assumes independence, and real transduction is not independent, so it is not a prediction.';
      }
      why!.textContent = head + tail;
    }
    [p1In, p2In].forEach((s) => s.addEventListener('input', render));
    btn.addEventListener('click', () => { draw(Math.floor(Math.random() * 2 ** 31)); render(); });
    render();
  });
</script>

<style>
  .dvc { padding: var(--ddp-space-3) var(--ddp-space-4) var(--ddp-space-4); margin: var(--ddp-space-5) 0; }
  .dvc-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem; font-weight: 600; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); margin-bottom: var(--ddp-space-3); }
  .dvc-chip { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 400; color: var(--ddp-color-muted); }
  .dvc-svg { display: block; width: 100%; max-width: 560px; margin: 0 auto; height: auto; background: #fff; border: 1px solid var(--ddp-color-line); border-radius: 6px; }
  .dvc-controls { display: grid; grid-template-columns: 1fr 1fr auto; gap: var(--ddp-space-2) var(--ddp-space-4); align-items: end; margin: var(--ddp-space-3) 0 var(--ddp-space-2); }
  .dvc-slabel { display: flex; flex-direction: column; gap: 0.1rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .dvc-slabel em { font-style: normal; font-weight: 700; color: var(--ddp-color-accent); font-family: var(--ddp-font-mono); }
  .dvc-slabel input { accent-color: var(--ddp-color-accent); }
  .dvc-btn { font: inherit; font-size: var(--ddp-text-xs); padding: 0.35rem 0.8rem; border: 1px solid var(--ddp-color-accent); background: #fff; color: var(--ddp-color-accent); border-radius: 6px; cursor: pointer; }
  .dvc-btn:hover, .dvc-btn:focus-visible { background: color-mix(in srgb, var(--ddp-color-accent) 10%, #fff); }
  .dvc-readout { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--ddp-space-2); margin: var(--ddp-space-2) 0; padding: var(--ddp-space-2) var(--ddp-space-3); background: color-mix(in srgb, var(--ddp-color-accent) 8%, transparent); border-radius: 6px; }
  .dvc-readout div { display: flex; flex-direction: column; gap: 0.1rem; }
  .dvc-readout dt { font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .dvc-readout dd { margin: 0; font-family: var(--ddp-font-mono); font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); font-weight: 700; }
  .dvc-why { margin: 0 0 var(--ddp-space-2); font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); line-height: 1.5; min-height: 6em; }
  .dvc-assume { margin: 0 0 var(--ddp-space-2); font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); line-height: 1.5; }
  .dvc-foot { margin: var(--ddp-space-3) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); border-left: 3px solid var(--ddp-color-secondary); padding-left: 0.55rem; }
  @media (max-width: 480px) {
    .dvc-controls { grid-template-columns: 1fr; }
    .dvc-readout { grid-template-columns: 1fr; }
  }
</style>
