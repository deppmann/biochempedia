---
/**
 * CellSizeSupplyLimit — the supply-and-demand size estimate of "A Measured Eukaryotic Cell".
 * A smooth spherical cell takes up a nutrient over its whole surface at no more than J
 * molecules per µm² per second and uses it at q molecules per µm³ per second throughout its
 * volume. Supply J·4πr² and demand q·4πr³/3 are plotted against radius; they cross at
 * r_max = 3J/q. The learner moves the radius cursor and the two invented rates and reads
 * area, volume, A/V = 3/r and the capacity-to-demand ratio (3J/q)/r. Every rule is a
 * statement of the lesson; nothing is measured. Self-contained vanilla-TS Astro island. Original.
 */
---

<figure class="csl card" data-cellsizesupply>
  <figcaption class="csl-head">Cell size: supply against demand<span class="csl-chip">⚙ original · interactive</span></figcaption>

  <svg class="csl-svg" viewBox="0 0 340 230" role="img" aria-label="Surface supply and volume demand of a spherical cell plotted against radius, crossing at the maximum radius" data-plot></svg>

  <div class="csl-controls">
    <label class="csl-slabel"><span>Cell radius r <em data-out="r">5</em> µm</span>
      <input type="range" data-in="r" min="1" max="30" step="0.5" value="5" />
    </label>
    <label class="csl-slabel"><span>Maximum uptake J <em data-out="j">20</em> molecules µm⁻² s⁻¹</span>
      <input type="range" data-in="j" min="5" max="30" step="1" value="20" />
    </label>
    <label class="csl-slabel"><span>Demand q <em data-out="q">6</em> molecules µm⁻³ s⁻¹</span>
      <input type="range" data-in="q" min="2" max="20" step="1" value="6" />
    </label>
  </div>

  <dl class="csl-readout">
    <div><dt>r<sub>max</sub> = 3J/q</dt><dd data-r-rmax></dd></div>
    <div><dt>A/V = 3/r</dt><dd data-r-av></dd></div>
    <div><dt>Area A = 4πr²</dt><dd data-r-a></dd></div>
    <div><dt>Volume V = 4πr³/3</dt><dd data-r-v></dd></div>
    <div><dt>Supply J × A</dt><dd data-r-sup></dd></div>
    <div><dt>Demand q × V</dt><dd data-r-dem></dd></div>
    <div class="csl-wide"><dt>Capacity to demand = (J/q) × (3/r)</dt><dd data-r-ratio></dd></div>
  </dl>
  <p class="csl-why" data-why role="status"></p>

  <p class="csl-foot">In this sketch, a smooth sphere whose whole surface takes up nutrient and nothing else limits it, supply meets demand up to r<sub>max</sub> = 3J/q. That is a scaling penalty, not a universal maximum. The rates are invented, not measurements; shape, vacuoles and biosynthetic scaling are left out.</p>
</figure>

<script>
  const NS = 'http://www.w3.org/2000/svg';
  const ACCENT = '#0e7c86', ORANGE = '#e57200', INK = '#4b4b55', FAINT = '#b9b9c2';
  function el(name: string, attrs: Record<string, string | number>): SVGElement {
    const e = document.createElementNS(NS, name);
    for (const k in attrs) e.setAttribute(k, String(attrs[k]));
    return e;
  }
  const fmt = (x: number) => Math.round(x).toLocaleString('en-US');
  const fmt1 = (x: number) => (Math.round(x * 10) / 10).toString();
  const exact = (x: number) => x.toLocaleString('en-US', { maximumFractionDigits: 1 });
  // axis ticks: exact, but compact once the numbers get long (keeps labels inside the left margin)
  const tick = (x: number) => x >= 1e6 ? (x / 1e6).toLocaleString('en-US', { maximumFractionDigits: 3 }) + 'M' : x >= 1e4 ? (x / 1e3).toLocaleString('en-US', { maximumFractionDigits: 2 }) + 'k' : exact(x);
  document.querySelectorAll<HTMLElement>('[data-cellsizesupply]').forEach((root) => {
    const plot = root.querySelector<SVGSVGElement>('[data-plot]')!;
    const inp = (s: string) => root.querySelector<HTMLInputElement>(s)!;
    const o = (s: string) => root.querySelector<HTMLElement>(s)!;
    const rIn = inp('[data-in="r"]'), jIn = inp('[data-in="j"]'), qIn = inp('[data-in="q"]');
    const rOut = o('[data-out="r"]'), jOut = o('[data-out="j"]'), qOut = o('[data-out="q"]');
    const rRmax = o('[data-r-rmax]'), rAv = o('[data-r-av]'), rA = o('[data-r-a]'), rV = o('[data-r-v]');
    const rSup = o('[data-r-sup]'), rDem = o('[data-r-dem]'), rRatio = o('[data-r-ratio]'), why = o('[data-why]');

    const X0 = 46, X1 = 326, Y0 = 20, Y1 = 188, XMAX = 30;
    const px = (r: number) => X0 + (r / XMAX) * (X1 - X0);
    function text(x: number, y: number, s: string, extra: Record<string, string | number> = {}) {
      const t = el('text', { x, y, 'font-size': 9, fill: INK, ...extra });
      t.textContent = s;
      plot.appendChild(t);
    }
    function render() {
      const r = parseFloat(rIn.value), J = parseInt(jIn.value, 10), q = parseInt(qIn.value, 10);
      const rmax = (3 * J) / q;
      const sup = (x: number) => J * 4 * Math.PI * x * x;
      const dem = (x: number) => q * (4 / 3) * Math.PI * x * x * x;
      const A = 4 * Math.PI * r * r, V = (4 / 3) * Math.PI * r * r * r;
      const ratio = rmax / r;
      const t2 = (x: number) => String(Math.round(x * 100) / 100);
      const below = r < rmax - 1e-9, at = Math.abs(r - rmax) < 1e-9;
      const shown = at ? 1 : below ? Math.max(Math.round(ratio * 100) / 100, 1.01) : Math.min(Math.round(ratio * 100) / 100, 0.99);
      const ratioTxt = String(shown);

      rOut.textContent = fmt1(r); jOut.textContent = String(J); qOut.textContent = String(q);

      // y scale: the curves up to 1.5 r_max (or the right edge), then a round top value
      const xTop = Math.min(XMAX, 1.5 * rmax);
      const raw = Math.max(sup(xTop), dem(xTop), sup(r) * 1.05, dem(r) * 1.05);
      const mag = Math.pow(10, Math.floor(Math.log10(raw)));
      const ymax = [1, 2, 2.5, 5, 10].map((m) => m * mag).find((v) => v >= raw)!;
      const py = (v: number) => Y1 - Math.min(v / ymax, 1) * (Y1 - Y0);

      plot.replaceChildren();
      plot.appendChild(el('line', { x1: X0, y1: Y0, x2: X0, y2: Y1, stroke: INK, 'stroke-width': 1 }));
      plot.appendChild(el('line', { x1: X0, y1: Y1, x2: X1, y2: Y1, stroke: INK, 'stroke-width': 1 }));
      for (const f of [0.5, 1]) {
        plot.appendChild(el('line', { x1: X0, y1: py(ymax * f), x2: X1, y2: py(ymax * f), stroke: FAINT, 'stroke-width': 0.7, 'stroke-dasharray': '2 3' }));
        text(X0 - 4, py(ymax * f) + 3, tick(ymax * f), { 'text-anchor': 'end' });
      }
      text(X0 - 4, Y1 + 3, '0', { 'text-anchor': 'end' });
      for (const x of [0, 10, 20, 30]) {
        plot.appendChild(el('line', { x1: px(x), y1: Y1, x2: px(x), y2: Y1 + 3, stroke: INK, 'stroke-width': 1 }));
        text(px(x), Y1 + 14, String(x), { 'text-anchor': 'middle' });
      }
      text((X0 + X1) / 2, Y1 + 28, 'cell radius r (µm)', { 'text-anchor': 'middle', 'font-size': 10 });
      text(2, 11, 'molecules per second (top of axis rescales)', { 'font-size': 10 });

      let cut = false;
      const path = (f: (x: number) => number) => {
        let d = '', prev = 0;
        for (let x = 0; x <= XMAX + 1e-9; x += 0.25) {
          const v = f(x);
          if (v > ymax) {
            const xe = prev + ((x - prev) * (ymax - f(prev))) / (v - f(prev));
            d += 'L' + px(xe).toFixed(1) + ' ' + Y0.toFixed(1);
            cut = true;
            break;
          }
          d += (x === 0 ? 'M' : 'L') + px(x).toFixed(1) + ' ' + py(v).toFixed(1) + ' ';
          prev = x;
        }
        return d.trim();
      };
      plot.appendChild(el('path', { d: path(sup), fill: 'none', stroke: ACCENT, 'stroke-width': 2.6 }));
      plot.appendChild(el('path', { d: path(dem), fill: 'none', stroke: ORANGE, 'stroke-width': 2.6 }));
      if (cut) text(X1 - 2, Y0 + 10, 'curves cut off at top', { 'text-anchor': 'end', 'font-style': 'italic' });

      // legend, top-left
      plot.appendChild(el('line', { x1: X0 + 8, y1: Y0 + 12, x2: X0 + 24, y2: Y0 + 12, stroke: ACCENT, 'stroke-width': 2.6 }));
      text(X0 + 28, Y0 + 15, 'supply J × 4πr²');
      plot.appendChild(el('line', { x1: X0 + 8, y1: Y0 + 25, x2: X0 + 24, y2: Y0 + 25, stroke: ORANGE, 'stroke-width': 2.6 }));
      text(X0 + 28, Y0 + 28, 'demand q × 4πr³/3');

      // r_max marker
      if (rmax <= XMAX) {
        plot.appendChild(el('line', { x1: px(rmax), y1: py(sup(rmax)), x2: px(rmax), y2: Y1, stroke: '#7a5ea8', 'stroke-width': 1.2, 'stroke-dasharray': '3 2' }));
        plot.appendChild(el('circle', { cx: px(rmax), cy: py(sup(rmax)), r: 4, fill: '#7a5ea8' }));
        const lab = 'r_max = ' + fmt1(rmax) + ' µm';
        const right = px(rmax) > X1 - 90;
        text(right ? px(rmax) - 5 : px(rmax) + 5, Y1 - 6, lab, { 'text-anchor': right ? 'end' : 'start', 'font-weight': 700, fill: '#7a5ea8' });
      } else {
        text(X1 - 2, Y1 - 6, 'r_max = ' + fmt1(rmax) + ' µm, past the right edge', { 'text-anchor': 'end', 'font-weight': 700, fill: '#7a5ea8' });
      }

      // radius cursor
      plot.appendChild(el('line', { x1: px(r), y1: Y0, x2: px(r), y2: Y1, stroke: INK, 'stroke-width': 1, 'stroke-dasharray': '1 3' }));
      plot.appendChild(el('circle', { cx: px(r), cy: py(sup(r)), r: 3.5, fill: ACCENT, stroke: '#fff', 'stroke-width': 1 }));
      plot.appendChild(el('circle', { cx: px(r), cy: py(dem(r)), r: 3.5, fill: ORANGE, stroke: '#fff', 'stroke-width': 1 }));

      rRmax.textContent = fmt1(rmax) + ' µm';
      rAv.textContent = (Math.round((3 / r) * 100) / 100) + ' µm⁻¹';
      rA.textContent = A.toLocaleString('en-US', { maximumFractionDigits: 1 }) + ' µm²';
      rV.textContent = V.toLocaleString('en-US', { maximumFractionDigits: 1 }) + ' µm³';
      rSup.textContent = fmt(sup(r)) + ' s⁻¹';
      rDem.textContent = fmt(dem(r)) + ' s⁻¹';
      rRatio.textContent = ratioTxt + ' (' + t2(rmax) + ' / ' + t2(r) + ')';

      const head = `At r = ${fmt1(r)} µm the surface can take up ${fmt(sup(r))} molecules per second and the volume uses ${fmt(dem(r))}. `;
      if (at) {
        why.textContent = head + 'Supply just meets demand: this radius is exactly r_max = 3J/q, and the ratio is 1.';
      } else if (below) {
        why.textContent = head + `Capacity is ${ratioTxt} times demand, so within these assumptions uptake meets need. Supply meets demand up to r_max = ${fmt1(rmax)} µm; raise J or lower q and r_max moves right.`;
      } else {
        why.textContent = head + `Demand now exceeds what the surface can take up (capacity is ${ratioTxt} of demand), because volume grows with r³ while area grows only with r². Past r_max = ${fmt1(rmax)} µm, uptake no longer meets this model cell’s demand.`;
      }
      if (cut) why.textContent += ' Curves that pass the top of the axis are cut off there.';
    }
    [rIn, jIn, qIn].forEach((s) => s.addEventListener('input', render));
    render();
  });
</script>

<style>
  .csl { padding: var(--ddp-space-3) var(--ddp-space-4) var(--ddp-space-4); margin: var(--ddp-space-5) 0; }
  .csl-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem; font-weight: 600; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); margin-bottom: var(--ddp-space-3); }
  .csl-chip { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 400; color: var(--ddp-color-muted); }
  .csl-svg { display: block; width: 100%; max-width: 560px; margin: 0 auto; height: auto; background: #fff; border: 1px solid var(--ddp-color-line); border-radius: 6px; }
  .csl-controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: var(--ddp-space-2) var(--ddp-space-4); margin: var(--ddp-space-3) 0 var(--ddp-space-2); }
  .csl-slabel { display: flex; flex-direction: column; gap: 0.1rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .csl-slabel em { font-style: normal; font-weight: 700; color: var(--ddp-color-accent); font-family: var(--ddp-font-mono); }
  .csl-slabel input { accent-color: var(--ddp-color-accent); width: 100%; }
  .csl-readout { display: grid; grid-template-columns: 1fr 1fr; gap: var(--ddp-space-2); margin: var(--ddp-space-2) 0; padding: var(--ddp-space-2) var(--ddp-space-3); background: color-mix(in srgb, var(--ddp-color-accent) 8%, transparent); border-radius: 6px; }
  .csl-readout div { display: flex; flex-direction: column; gap: 0.1rem; min-width: 0; }
  .csl-readout .csl-wide { grid-column: 1 / -1; }
  .csl-readout dt { font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .csl-readout dd { margin: 0; font-family: var(--ddp-font-mono); font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); font-weight: 700; overflow-wrap: anywhere; }
  .csl-why { margin: 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); line-height: 1.5; min-height: 6em; }
  .csl-foot { margin: var(--ddp-space-3) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); border-left: 3px solid var(--ddp-color-secondary); padding-left: 0.55rem; }
</style>
