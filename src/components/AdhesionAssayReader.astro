---
/**
 * AdhesionAssayReader — read the lesson's made-up 30-minute attachment assay. Choose a well;
 * the four wells are drawn as bars of retained cells out of 20,000 seeded, and the reader
 * shows the lesson's arithmetic for the chosen well: percent attached, the BSA background,
 * specific attachment, and (for the blocking-antibody well) inhibition against the isotype
 * well. Deterministic: no random sampling. Every number follows from the lesson's four counts.
 * Self-contained vanilla-TS Astro island. Original.
 */
---

<figure class="aar card" data-aar>
  <figcaption class="aar-head">Adhesion assay: read the wells<span class="aar-chip">⚙ original · interactive</span></figcaption>

  <svg class="aar-svg" viewBox="0 0 360 214" role="img" aria-label="Bar chart of cells retained in four wells after a 30-minute wash, out of 20,000 seeded" data-stage></svg>

  <fieldset class="aar-wells">
    <legend>Choose a well</legend>
    <label><input type="radio" name="aar-well" value="0" checked /> fibronectin, no antibody</label>
    <label><input type="radio" name="aar-well" value="1" /> fibronectin + isotype-control antibody</label>
    <label><input type="radio" name="aar-well" value="2" /> fibronectin + integrin-blocking antibody</label>
    <label><input type="radio" name="aar-well" value="3" /> BSA only</label>
  </fieldset>

  <table class="aar-table" aria-label="Arithmetic for the chosen well">
    <tbody data-rows></tbody>
  </table>

  <p class="aar-verdict" data-verdict role="status"></p>

  <p class="aar-foot">Subtract the BSA background from both wells, then compare the blocking well with the isotype-control well, not with the well that has no antibody. Lower attachment shows the integrin is needed, not that it touches fibronectin. The counts are made-up data.</p>
</figure>

<script>
  const NS = 'http://www.w3.org/2000/svg';
  const SEEDED = 20000;
  const BG = 1000; // BSA-only well
  type Well = { id: string; n: number; l1: string; l2: string; fill: string };
  const WELLS: Well[] = [
    { id: 'fn', n: 14000, l1: 'fibronectin', l2: 'no antibody', fill: '#0e7c86' },
    { id: 'iso', n: 13600, l1: 'fibronectin +', l2: 'isotype ctrl', fill: '#2f6f8f' },
    { id: 'blk', n: 3200, l1: 'fibronectin +', l2: 'blocking Ab', fill: '#e57200' },
    { id: 'bsa', n: 1000, l1: 'BSA only', l2: '', fill: '#8a8a96' },
  ];
  const fmt = (x: number) => x.toLocaleString('en-US');
  function el(name: string, attrs: Record<string, string | number>, text?: string): SVGElement {
    const e = document.createElementNS(NS, name);
    for (const k in attrs) e.setAttribute(k, String(attrs[k]));
    if (text !== undefined) e.textContent = text;
    return e;
  }
  document.querySelectorAll<HTMLElement>('[data-aar]').forEach((root) => {
    const stage = root.querySelector<SVGSVGElement>('[data-stage]')!;
    const rows = root.querySelector<HTMLElement>('[data-rows]')!;
    const verdict = root.querySelector<HTMLElement>('[data-verdict]')!;
    const radios = Array.from(root.querySelectorAll<HTMLInputElement>('input[type="radio"]'));
    const INK = '#4b4b55', FAINT = '#8a8a96';
    const Y0 = 160, SC = 120 / SEEDED, X0 = 52;
    const yOf = (n: number) => Y0 - n * SC;
    const iso = WELLS[1].n, blk = WELLS[2].n;
    const specIso = iso - BG, specBlk = blk - BG;
    const inhib = 1 - specBlk / specIso;

    function draw(sel: number) {
      stage.replaceChildren();
      stage.appendChild(el('text', { x: 6, y: 12, 'font-size': 9, fill: INK }, 'cells retained after the wash'));
      for (const v of [0, 10000, 20000]) {
        stage.appendChild(el('line', { x1: X0, y1: yOf(v), x2: 354, y2: yOf(v), stroke: v === 20000 ? INK : '#d9d9e0', 'stroke-width': 1, 'stroke-dasharray': v === 20000 ? '4 3' : '' }));
        stage.appendChild(el('text', { x: X0 - 4, y: yOf(v) + 3, 'font-size': 9, 'text-anchor': 'end', fill: INK }, fmt(v)));
      }
      stage.appendChild(el('text', { x: 354, y: yOf(SEEDED) - 4, 'font-size': 9, 'text-anchor': 'end', fill: INK }, '20,000 seeded per well'));
      const slot = (354 - X0) / 4, bw = 46;
      WELLS.forEach((w, i) => {
        const cx = X0 + slot * (i + 0.5), x = cx - bw / 2;
        const isSel = i === sel;
        // ghost: the specific cells the antibody removed, shown only for the blocking well
        if (isSel && i === 2) {
          stage.appendChild(el('rect', { x, y: yOf(iso), width: bw, height: yOf(blk) - yOf(iso), fill: 'none', stroke: '#e57200', 'stroke-width': 1.2, 'stroke-dasharray': '3 2' }));
          stage.appendChild(el('text', { x: cx, y: yOf(iso) + 14, 'font-size': 9, 'text-anchor': 'middle', fill: '#9a4a00' }, 'blocked vs isotype'));
        }
        if (w.id === 'bsa') {
          stage.appendChild(el('rect', { x, y: yOf(w.n), width: bw, height: Y0 - yOf(w.n), fill: '#8a8a96' }));
        } else {
          stage.appendChild(el('rect', { x, y: yOf(w.n), width: bw, height: Y0 - yOf(w.n), fill: w.fill }));
          stage.appendChild(el('rect', { x, y: yOf(BG), width: bw, height: Y0 - yOf(BG), fill: '#8a8a96' }));
        }
        if (isSel) stage.appendChild(el('rect', { x: x - 2, y: yOf(w.n) - 2, width: bw + 4, height: Y0 - yOf(w.n) + 4, fill: 'none', stroke: INK, 'stroke-width': 2 }));
        const vy = i === 2 && isSel ? yOf(w.n) - 5 : yOf(w.n) - 5;
        stage.appendChild(el('text', { x: cx, y: vy, 'font-size': 10, 'text-anchor': 'middle', 'font-weight': isSel ? 700 : 400, fill: INK }, fmt(w.n)));
        stage.appendChild(el('text', { x: cx, y: Y0 + 14, 'font-size': 9, 'text-anchor': 'middle', 'font-weight': isSel ? 700 : 400, fill: INK }, w.l1));
        if (w.l2) stage.appendChild(el('text', { x: cx, y: Y0 + 25, 'font-size': 9, 'text-anchor': 'middle', 'font-weight': isSel ? 700 : 400, fill: INK }, w.l2));
      });
      // key for the grey base
      stage.appendChild(el('rect', { x: X0, y: 200, width: 10, height: 8, fill: '#8a8a96' }));
      stage.appendChild(el('text', { x: X0 + 14, y: 207, 'font-size': 9, fill: INK }, '= background (the 1,000 cells that stick to BSA alone)'));
    }

    function render() {
      const sel = Math.max(0, radios.findIndex((r) => r.checked));
      const w = WELLS[sel];
      draw(sel);
      const pct = (w.n / SEEDED) * 100;
      const isBsa = sel === 3;
      const spec = w.n - BG;
      const r: [string, string][] = [
        ['Retained', `${fmt(w.n)} of ${fmt(SEEDED)}`],
        ['Step 1: percent attached', `${fmt(w.n)} / ${fmt(SEEDED)} = ${pct % 1 === 0 ? pct : pct.toFixed(1)}%`],
        ['Step 2: specific attachment', isBsa ? 'this well is the background' : `${fmt(w.n)} − ${fmt(BG)} = ${fmt(spec)}`],
        ['Step 3: inhibition', sel === 2 ? `1 − ${fmt(specBlk)}/${fmt(specIso)} = ${(inhib).toFixed(3)}, about ${Math.round(inhib * 100)}%` : 'only the blocking well is scored'],
      ];
      rows.replaceChildren();
      r.forEach(([k, v]) => {
        const tr = document.createElement('tr');
        const th = document.createElement('th'); th.scope = 'row'; th.textContent = k;
        const td = document.createElement('td'); td.textContent = v;
        tr.append(th, td); rows.appendChild(tr);
      });
      let v: string;
      if (sel === 0) v = '14,000 of 20,000 cells, 70%, hold on fibronectin. This well has no antibody, so it is the reference for any drop caused by adding antibody protein at all. Scoring the blocking antibody against this well would credit the 2-point antibody-protein drop to the integrin.';
      else if (sel === 1) v = 'Isotype control: an antibody of the same class with an irrelevant target. Attachment falls from 70% to 68%, so adding the antibody protein lowered it by 2 points here. This is the well to compare the blocking antibody with. Its specific attachment, 12,600, is the 100% for the inhibition.';
      else if (sel === 2) v = `Blocking antibody: 16% attached, 2,200 specific cells after the background is removed, against 12,600 in the isotype well. Inhibition is about 83%. Comparing with the no-antibody well would credit the 2-point drop to the integrin. This shows the integrin is needed for attachment, not that it touches fibronectin.`;
      else v = 'BSA only: 5% of cells stay on a protein they do not grip. These 1,000 cells stick to plastic or protein nonspecifically, so this well is the background subtracted from every other well. Viability is above 95% in every well, so lost cells were not dead cells.';
      verdict.textContent = v;
    }
    radios.forEach((r) => r.addEventListener('change', render));
    render();
  });
</script>

<style is:global>
  .aar { padding: var(--ddp-space-3) var(--ddp-space-4) var(--ddp-space-4); margin: var(--ddp-space-5) 0; }
  .aar-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem; font-weight: 600; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); margin-bottom: var(--ddp-space-3); }
  .aar-chip { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 400; color: var(--ddp-color-muted); }
  .aar-svg { display: block; width: 100%; max-width: 600px; margin: 0 auto var(--ddp-space-3); height: auto; background: #fff; border: 1px solid var(--ddp-color-line); border-radius: 6px; }
  .aar-wells { border: 1px solid var(--ddp-color-line); border-radius: 6px; margin: var(--ddp-space-3) 0 var(--ddp-space-2); padding: 0.4rem 0.7rem; display: grid; gap: 0.25rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .aar-wells legend { font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); padding: 0 0.3rem; }
  .aar-wells input { accent-color: var(--ddp-color-accent); }
  .aar-table { width: 100%; border-collapse: collapse; margin: var(--ddp-space-2) 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .aar-table th, .aar-table td { text-align: left; padding: 0.25rem 0.4rem; border-bottom: 1px solid var(--ddp-color-line); vertical-align: top; }
  .aar-table th { font-weight: 600; color: var(--ddp-color-muted); width: 38%; }
  .aar-verdict { margin: var(--ddp-space-2) 0; padding: var(--ddp-space-2) var(--ddp-space-3); background: color-mix(in srgb, var(--ddp-color-accent) 8%, transparent); border-radius: 6px; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); min-height: 5em; }
  .aar-foot { margin: var(--ddp-space-3) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); border-left: 3px solid var(--ddp-color-secondary); padding-left: 0.55rem; }
</style>
