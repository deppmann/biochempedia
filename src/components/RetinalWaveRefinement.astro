---
/**
 * RetinalWaveRefinement — switch a young mouse retina between normal retinal waves and
 * the beta2 knockout (no waves in the first postnatal week, but plenty of uncorrelated
 * firing), step through moments of activity, and see whether neighbouring ganglion
 * cells fire together and whether their axons end in a small or a broad termination
 * zone in the superior colliculus by about day 8. Every rule is a statement of the
 * spontaneous-activity lesson (McLaughlin, Torborg, Feller and O'Leary result, with its
 * hedges). Nothing is drawn as a molecule. Self-contained vanilla-TS Astro island. Original.
 */
---

<figure class="rw card" data-retwave>
  <figcaption class="rw-head">Retinal waves and map refinement<span class="rw-chip">⚙ original · interactive</span></figcaption>

  <svg class="rw-svg" viewBox="0 0 360 250" role="img" aria-label="A row of retinal ganglion cells, some firing, above the superior colliculus where the axons of three neighbouring cells end in a small or a broad zone" data-stage></svg>

  <fieldset class="rw-cond">
    <legend>The mouse, first postnatal week</legend>
    <label><input type="radio" name="rw-cond" value="normal" checked data-cond /> normal retinal waves</label>
    <label><input type="radio" name="rw-cond" value="ko" data-cond /> beta2 knockout (no normal waves, uncorrelated firing)</label>
  </fieldset>
  <div class="rw-row">
    <button type="button" class="rw-btn" data-step>Next moment</button>
    <span class="rw-count" data-count></span>
  </div>

  <p class="rw-verdict" data-verdict role="status"></p>

  <p class="rw-foot">Neighbours that fire together keep their axons together; where firing is not correlated, the termination zone stays broad. Times and sizes are in relative units and patch size is arbitrary, and the picture is a sketch of the logic, not a measurement.</p>
</figure>

<script>
  const NS = 'http://www.w3.org/2000/svg';
  function el(name: string, attrs: Record<string, string | number>, text?: string): SVGElement {
    const e = document.createElementNS(NS, name);
    for (const k in attrs) e.setAttribute(k, String(attrs[k]));
    if (text !== undefined) e.textContent = text;
    return e;
  }
  const N = 12;          // ganglion cells drawn in a row
  const WAVE = 4;        // cells in one patch of the wave
  const FOLLOW = [5, 6, 7]; // three neighbouring cells whose axons are followed
  const CYCLE = N + WAVE + 3; // wave crossing plus a stretch of silence
  // anti-clustered firing for the knockout: never two adjacent cells on, shifting each moment
  function scatter(t: number, i: number): boolean {
    if ((i + t) % 2 !== 0) return false;
    const h = Math.sin((t + 1) * 12.9898 + (i + 1) * 78.233) * 43758.5453;
    return h - Math.floor(h) > 0.2;
  }
  document.querySelectorAll<HTMLElement>('[data-retwave]').forEach((root) => {
    const stage = root.querySelector<SVGSVGElement>('[data-stage]')!;
    const verdict = root.querySelector<HTMLElement>('[data-verdict]')!;
    const count = root.querySelector<HTMLElement>('[data-count]')!;
    const conds = root.querySelectorAll<HTMLInputElement>('[data-cond]');
    let t = 3;

    const isKo = () => Array.from(conds).some((c) => c.checked && c.value === 'ko');
    function firing(ko: boolean): boolean[] {
      const f: boolean[] = [];
      if (ko) { for (let i = 0; i < N; i++) f.push(scatter(t, i)); return f; }
      const p = t % CYCLE; // front of the wave sits at cell p
      for (let i = 0; i < N; i++) f.push(i <= p && i > p - WAVE);
      return f;
    }
    function draw(ko: boolean, f: boolean[]) {
      stage.replaceChildren();
      const INK = '#4b4b55', FAINT = '#8a8a96', ACC = '#e57200', TEAL = '#0e7c86';
      const cx = (i: number) => 34 + i * 26.5;
      stage.appendChild(el('text', { x: 8, y: 14, 'font-size': 10, 'font-weight': 700, fill: INK }, 'Retina (one eye): ganglion cells in a row'));
      f.forEach((on, i) => {
        stage.appendChild(el('circle', { cx: cx(i), cy: 44, r: 9, fill: on ? ACC : '#fff', stroke: on ? ACC : FAINT, 'stroke-width': 1.5 }));
      });
      // rings on the three followed cells
      FOLLOW.forEach((i) => {
        stage.appendChild(el('circle', { cx: cx(i), cy: 44, r: 12.5, fill: 'none', stroke: TEAL, 'stroke-width': 1.5, 'stroke-dasharray': '3 2' }));
      });
      // axons to the target
      const zoneW = ko ? 150 : 30, zc = cx(6), zy = 178;
      FOLLOW.forEach((i, k) => {
        const ex = zc + (k - 1) * (zoneW / 2 - 4);
        stage.appendChild(el('line', { x1: cx(i), y1: 56, x2: ex, y2: zy, stroke: TEAL, 'stroke-width': 1.6 }));
        stage.appendChild(el('circle', { cx: ex, cy: zy, r: 3.2, fill: TEAL }));
      });
      stage.appendChild(el('rect', { x: 12, y: zy + 8, width: 336, height: 14, fill: '#d9d9e0' }));
      stage.appendChild(el('rect', { x: zc - zoneW / 2, y: zy + 4, width: zoneW, height: 22, rx: 4, fill: 'none', stroke: ko ? '#b03a2e' : TEAL, 'stroke-width': 2 }));
      stage.appendChild(el('text', { x: zc, y: zy + 42, 'font-size': 10, 'text-anchor': 'middle', 'font-weight': 700, fill: ko ? '#b03a2e' : TEAL }, ko ? 'termination zone stays broad' : 'termination zone: small and focal'));
      const H = { stroke: '#fff', 'stroke-width': 3, 'stroke-linejoin': 'round', 'paint-order': 'stroke' };
      stage.appendChild(el('text', { x: cx(6), y: 72, 'font-size': 9, 'text-anchor': 'middle', fill: TEAL, ...H }, 'three neighbouring cells followed'));
      stage.appendChild(el('text', { x: 8, y: 92, 'font-size': 9, fill: INK, ...H }, 'orange = firing in this moment, white = silent'));
      stage.appendChild(el('text', { x: 8, y: 152, 'font-size': 10, 'font-weight': 700, fill: INK, ...H }, 'Superior colliculus (midbrain visual target), by about day 8'));
      stage.appendChild(el('text', { x: 348, y: 240, 'font-size': 9, 'text-anchor': 'end', fill: FAINT }, 'sizes in relative units, not to scale'));
    }
    function render() {
      const ko = isKo();
      const f = firing(ko);
      draw(ko, f);
      const n = f.filter(Boolean).length;
      const followOn = FOLLOW.filter((i) => f[i]).length;
      count.textContent = `moment ${t - 2}`;
      let v: string;
      if (!ko) {
        v = n === 0
          ? 'A quiet stretch between waves: no ganglion cell is firing. Waves are separated by silence.'
          : `A wave is crossing the retina: ${n} neighbouring cell${n === 1 ? ' fires' : 's fire'} together while cells farther away do not fire with them. `;
        if (n > 0) v += followOn === 0 ? 'The wave has not reached the three followed cells yet.' : followOn === 3 ? 'All three followed cells are in this burst.' : 'Some of the three followed cells are in this burst.';
        v += ' Neighbours firing together keep their axons together, so by about day 8 the termination zone in the superior colliculus is small.';
      } else {
        v = `In the lesson's recordings, the cells fire at high rates (${n} of ${N} in this moment) but without correlation: neighbours do not fire together and no wave crosses the retina. Without normal waves in this window the termination zone stays broad (a knockout removes the subunit everywhere, not only in the retina); later glutamatergic waves and then vision did not remodel it. Later laboratories recorded correlated but altered waves in beta2 knockouts under some conditions, so the mutants lack normal waves rather than all waves.`;
      }
      verdict.textContent = v;
    }
    conds.forEach((c) => c.addEventListener('change', render));
    root.querySelector<HTMLButtonElement>('[data-step]')!.addEventListener('click', () => { t += 1; render(); });
    render();
  });
</script>

<style is:global>
  .rw { padding: var(--ddp-space-3) var(--ddp-space-4) var(--ddp-space-4); margin: var(--ddp-space-5) 0; }
  .rw-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem; font-weight: 600; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); margin-bottom: var(--ddp-space-3); }
  .rw-chip { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 400; color: var(--ddp-color-muted); }
  .rw-svg { display: block; width: 100%; max-width: 600px; margin: 0 auto var(--ddp-space-3); height: auto; background: #fff; border: 1px solid var(--ddp-color-line); border-radius: 6px; }
  .rw-cond { border: 1px solid var(--ddp-color-line); border-radius: 6px; margin: var(--ddp-space-3) 0 var(--ddp-space-2); padding: 0.4rem 0.7rem; display: grid; gap: 0.25rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .rw-cond legend { font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); padding: 0 0.3rem; }
  .rw-cond input { accent-color: var(--ddp-color-accent); }
  .rw-row { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem; margin: 0.35rem 0; }
  .rw-btn { border: 1px solid var(--ddp-color-line); border-radius: 5px; background: transparent; color: var(--ddp-color-ink-soft); font-size: var(--ddp-text-xs); padding: 0.3rem 0.65rem; cursor: pointer; }
  .rw-btn:focus-visible, .rw-cond input:focus-visible { outline: 2px solid var(--ddp-color-accent); outline-offset: 2px; }
  .rw-count { font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .rw-verdict { margin: var(--ddp-space-2) 0; padding: var(--ddp-space-2) var(--ddp-space-3); background: color-mix(in srgb, var(--ddp-color-accent) 8%, transparent); border-radius: 6px; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); min-height: 3em; }
  .rw-foot { margin: var(--ddp-space-3) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); border-left: 3px solid var(--ddp-color-secondary); padding-left: 0.55rem; }
</style>
