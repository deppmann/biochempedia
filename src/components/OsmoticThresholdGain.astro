---
/**
 * OsmoticThresholdGain — the lesson's illustrative regression, AVP = gain x (Posm - threshold)
 * above the threshold and no osmotically driven release at or below it, drawn as a static
 * steady-state line. Sliders for the plasma osmolality cursor, the threshold and the gain; a toggle
 * overlays the lesson's made-up persons P and Q, whose lines cross at 288 mOsm/kg. Original.
 */
---

<figure class="otg card" data-otg>
  <figcaption class="otg-head">Threshold and gain — plasma osmolality to vasopressin<span class="otg-chip">⚙ original · interactive</span></figcaption>

  <ol class="otg-loop" aria-label="Parts of the loop in this sketch">
    <li><b>Regulated variable</b><span>plasma osmolality (horizontal axis)</span></li>
    <li><b>Sensor</b><span>osmosensitive neurons of the lamina terminalis</span></li>
    <li><b>Effector</b><span>vasopressin (vertical axis); thirst is not drawn</span></li>
  </ol>

  <svg class="otg-svg" viewBox="0 0 340 235" role="img" aria-label="Plot of plasma AVP in pmol/L against plasma osmolality from 275 to 300 mOsm/kg: flat at zero up to the threshold, then rising in a straight line" data-plot></svg>

  <ul class="otg-legend" aria-label="Key">
    <li><i class="otg-sw otg-sw-line"></i>line from the sliders</li>
    <li><i class="otg-sw otg-sw-cur"></i>cursor</li>
    <li><span class="otg-tri" aria-hidden="true">▲</span> threshold</li>
    <li><span class="otg-ring" aria-hidden="true">○</span> 294 mOsm/kg reference</li>
    <li data-leg-pq hidden><i class="otg-sw otg-sw-p"></i>person P</li>
    <li data-leg-pq hidden><i class="otg-sw otg-sw-q"></i>person Q</li>
    <li data-leg-pq hidden><span class="otg-cross" aria-hidden="true">◆</span> crossing of P and Q</li>
  </ul>

  <div class="otg-controls">
    <label class="otg-slabel"><span>Plasma osmolality (cursor) <em data-out="cur">294</em> mOsm/kg</span>
      <input type="range" data-in="cur" min="275" max="300" step="1" value="294" />
    </label>
    <label class="otg-slabel"><span>Threshold <em data-out="thr">284</em> mOsm/kg</span>
      <input type="range" data-in="thr" min="278" max="290" step="1" value="284" />
    </label>
    <label class="otg-slabel"><span>Gain <em data-out="gain">0.43</em> pmol/L per mOsm/kg</span>
      <input type="range" data-in="gain" min="0.2" max="1" step="0.01" value="0.43" />
    </label>
    <label class="otg-check"><input type="checkbox" data-in="pq" /> <span>Overlay two made-up persons, P (threshold 280, gain 0.43) and Q (threshold 284, gain 0.86)</span></label>
  </div>

  <dl class="otg-readout">
    <div><dt>Excess over threshold</dt><dd data-r="excess"></dd></div>
    <div><dt>AVP at the cursor</dt><dd data-r="avp"></dd></div>
    <div class="otg-wide"><dt>Change from the 294 mOsm/kg reference</dt><dd data-r="change"></dd></div>
    <div data-pq hidden><dt>Person P at the cursor</dt><dd data-r="p"></dd></div>
    <div data-pq hidden><dt>Person Q at the cursor</dt><dd data-r="q"></dd></div>
  </dl>

  <p class="otg-why" data-why role="status"></p>

  <p class="otg-foot">Rule to keep: the threshold is where release starts and the gain is how fast it grows above it, so a “set point” is not one fixed number; below threshold the output is zero, never negative. In this sketch: a static steady-state line, no time course and no rehydration, mechanism only. The defaults, 284 mOsm/kg and 0.43 pmol/L per mOsm/kg, are illustrative averages from an endocrinology reference for healthy adults under controlled hypertonic stimulation, as the lesson says; other slider settings are not data; thresholds and slopes vary between people, and P and Q are made up.</p>
</figure>

<script>
  const NS = "http://www.w3.org/2000/svg";
  const ACCENT = "#0e7c86", ORANGE = "#e57200", INK = "#4b4b55", FAINT = "#b9b9c2", PCOL = "#7b3fa0", QCOL = "#2a6fbb";
  const MINUS = "−";
  function el(name: string, attrs: Record<string, string | number>): SVGElement {
    const e = document.createElementNS(NS, name);
    for (const k in attrs) e.setAttribute(k, String(attrs[k]));
    return e;
  }
  // All AVP values are held as integer hundredths of pmol/L: gain (hundredths) x whole mOsm/kg.
  const fmt = (cents: number) => (cents < 0 ? MINUS : "") + (Math.abs(cents) / 100).toFixed(2);
  const gfmt = (g100: number) => (g100 / 100).toFixed(2);
  const sgn = (n: number) => (n < 0 ? MINUS + Math.abs(n) : String(n));
  const release = (g100: number, thr: number, osm: number) => (osm > thr ? g100 * (osm - thr) : 0);

  document.querySelectorAll<HTMLElement>("[data-otg]").forEach((root) => {
    const plot = root.querySelector<SVGSVGElement>("[data-plot]")!;
    const inp = (n: string) => root.querySelector<HTMLInputElement>('[data-in="' + n + '"]')!;
    const curIn = inp("cur"), thrIn = inp("thr"), gainIn = inp("gain"), pqIn = inp("pq");
    const out = (n: string) => root.querySelector<HTMLElement>('[data-out="' + n + '"]')!;
    const rd = (n: string) => root.querySelector<HTMLElement>('[data-r="' + n + '"]')!;
    const why = root.querySelector<HTMLElement>("[data-why]")!;

    const X0 = 44, X1 = 324, Y0 = 22, Y1 = 188, OMIN = 275, OMAX = 300;
    const px = (o: number) => X0 + ((o - OMIN) / (OMAX - OMIN)) * (X1 - X0);

    const P = { thr: 280, g: 43 }, Q = { thr: 284, g: 86 };
    // Crossing of P and Q solved exactly in integers: g_p (x - t_p) = g_q (x - t_q).
    const crossOsm = (Q.g * Q.thr - P.g * P.thr) / (Q.g - P.g);
    const crossCents = P.g * (crossOsm - P.thr);

    function render() {
      const cur = parseInt(curIn.value, 10);
      const thr = parseInt(thrIn.value, 10);
      const g = Math.round(parseFloat(gainIn.value) * 100);
      const pq = pqIn.checked;
      out("cur").textContent = String(cur);
      out("thr").textContent = String(thr);
      out("gain").textContent = gfmt(g);
      root.querySelectorAll<HTMLElement>("[data-pq],[data-leg-pq]").forEach((e) => { e.hidden = !pq; });

      const vals = [release(g, thr, OMAX)];
      if (pq) vals.push(release(P.g, P.thr, OMAX), release(Q.g, Q.thr, OMAX));
      const peak = Math.max(...vals) / 100;
      const steps = [2, 4, 6, 8, 10, 12, 15, 20, 25];
      const ymax = steps.find((s) => s >= peak) ?? 25;
      const tick = ymax <= 2 ? 0.5 : ymax <= 4 ? 1 : ymax <= 12 ? 2 : 5;
      const py = (cents: number) => Y1 - (cents / 100 / ymax) * (Y1 - Y0);

      plot.replaceChildren();
      plot.appendChild(el("line", { x1: X0, y1: Y0, x2: X0, y2: Y1, stroke: INK, "stroke-width": 1 }));
      plot.appendChild(el("line", { x1: X0, y1: Y1, x2: X1, y2: Y1, stroke: INK, "stroke-width": 1 }));
      for (let v = 0; v <= ymax + 1e-9; v += tick) {
        const y = py(v * 100);
        if (v > 0) plot.appendChild(el("line", { x1: X0, y1: y, x2: X1, y2: y, stroke: FAINT, "stroke-width": 0.6, "stroke-dasharray": "2 3" }));
        const t = el("text", { x: X0 - 4, y: y + 3, "text-anchor": "end", "font-size": 9, fill: INK });
        t.textContent = Number.isInteger(v) ? String(v) : v.toFixed(1);
        plot.appendChild(t);
      }
      for (let o = OMIN; o <= OMAX; o += 5) {
        plot.appendChild(el("line", { x1: px(o), y1: Y1, x2: px(o), y2: Y1 + 3, stroke: INK, "stroke-width": 1 }));
        const t = el("text", { x: px(o), y: Y1 + 14, "text-anchor": "middle", "font-size": 9, fill: INK });
        t.textContent = String(o);
        plot.appendChild(t);
      }
      const xl = el("text", { x: (X0 + X1) / 2, y: Y1 + 30, "text-anchor": "middle", "font-size": 10, fill: INK });
      xl.textContent = "plasma osmolality (mOsm/kg)";
      plot.appendChild(xl);
      const yl = el("text", { x: 2, y: 11, "text-anchor": "start", "font-size": 10, fill: INK });
      yl.textContent = "AVP (pmol/L; scale adjusts)";
      plot.appendChild(yl);

      const line = (G: number, T: number) =>
        "M" + px(OMIN).toFixed(1) + " " + py(0).toFixed(1) + " L" + px(Math.max(T, OMIN)).toFixed(1) + " " + py(0).toFixed(1) +
        " L" + px(OMAX).toFixed(1) + " " + py(release(G, T, OMAX)).toFixed(1);
      if (pq) {
        plot.appendChild(el("path", { d: line(P.g, P.thr), fill: "none", stroke: PCOL, "stroke-width": 2, "stroke-dasharray": "6 3" }));
        plot.appendChild(el("path", { d: line(Q.g, Q.thr), fill: "none", stroke: QCOL, "stroke-width": 2, "stroke-dasharray": "2 2" }));
        plot.appendChild(el("path", { d: "M" + px(crossOsm) + " " + (py(crossCents) - 5) + " l5 5 l-5 5 l-5 -5 z", fill: "#222", stroke: "#fff", "stroke-width": 0.8 }));
      }
      plot.appendChild(el("path", { d: line(g, thr), fill: "none", stroke: ACCENT, "stroke-width": 2.8 }));
      // threshold marker on the axis (no text; named in the key)
      plot.appendChild(el("path", { d: "M" + px(thr) + " " + (Y1 - 1) + " l-4 -7 l8 0 z", fill: ACCENT }));
      // 294 reference point on the sliders' line
      plot.appendChild(el("circle", { cx: px(294), cy: py(release(g, thr, 294)), r: 4.5, fill: "#fff", stroke: INK, "stroke-width": 1.5 }));

      const avp = release(g, thr, cur);
      const cx = px(cur), cy = py(avp);
      plot.appendChild(el("line", { x1: cx, y1: Y0, x2: cx, y2: Y1, stroke: ORANGE, "stroke-width": 1.2, "stroke-dasharray": "3 2" }));
      if (pq) {
        plot.appendChild(el("circle", { cx, cy: py(release(P.g, P.thr, cur)), r: 3.2, fill: PCOL, stroke: "#fff", "stroke-width": 0.8 }));
        plot.appendChild(el("circle", { cx, cy: py(release(Q.g, Q.thr, cur)), r: 3.2, fill: QCOL, stroke: "#fff", "stroke-width": 0.8 }));
      }
      plot.appendChild(el("circle", { cx, cy, r: 4.6, fill: ORANGE, stroke: "#fff", "stroke-width": 1 }));
      const anchor = cx < X0 + 26 ? "start" : cx > X1 - 26 ? "end" : "middle";
      const tx = anchor === "start" ? cx + 7 : anchor === "end" ? cx - 7 : cx;
      const vt = el("text", { x: tx, y: Math.max(Y0 + 8, cy - 9), "text-anchor": anchor, "font-size": 10, "font-weight": 700, fill: ORANGE });
      vt.textContent = fmt(avp);
      plot.appendChild(vt);

      // readouts
      const ex = cur - thr;
      rd("excess").textContent = cur + " " + MINUS + " " + thr + " = " + sgn(ex) + " mOsm/kg";
      rd("avp").textContent = ex > 0 ? gfmt(g) + " × " + ex + " = " + fmt(avp) + " pmol/L" : "0 pmol/L (no osmotically driven release)";
      const ref = release(g, thr, 294);
      const delta = avp - ref;
      if (cur === 294) {
        rd("change").textContent = "none: the cursor is on the reference, " + fmt(avp) + " pmol/L";
      } else if (ex >= 0) {
        rd("change").textContent = fmt(avp) + " " + MINUS + " " + fmt(ref) + " = " + fmt(delta) + " pmol/L; check: " + gfmt(g) + " × (" + cur + " " + MINUS + " 294) = " + gfmt(g) + " × (" + sgn(cur - 294) + ") = " + fmt(g * (cur - 294)) + " pmol/L";
      } else {
        rd("change").textContent = "0 " + MINUS + " " + fmt(ref) + " = " + fmt(delta) + " pmol/L; the shortcut " + gfmt(g) + " × (" + sgn(cur - 294) + ") would give " + fmt(g * (cur - 294)) + ", which is not the change, because the line stops at the threshold";
      }

      // status sentence
      let s: string;
      if (ex < 0) {
        s = "At " + cur + " mOsm/kg, below the threshold of " + thr + ", this sketch gives no osmotically driven release (0 pmol/L). Using the formula blindly would give " + fmt(g * ex) + " pmol/L, which is impossible: the line describes release only above threshold.";
      } else if (ex === 0) {
        s = "At " + cur + " mOsm/kg, exactly at the threshold, release is just starting: " + gfmt(g) + " × 0 = 0 pmol/L.";
      } else {
        s = "At " + cur + " mOsm/kg, " + ex + " mOsm/kg above the threshold of " + thr + ", AVP = " + gfmt(g) + " × " + ex + " = " + fmt(avp) + " pmol/L. The gain is how much hormone is added per mOsm/kg above threshold.";
      }
      if (pq) {
        const pc = release(P.g, P.thr, cur), qc = release(Q.g, Q.thr, cur);
        rd("p").textContent = pc > 0 ? gfmt(P.g) + " × " + (cur - P.thr) + " = " + fmt(pc) + " pmol/L" : "0 pmol/L (at or below its threshold of 280)";
        rd("q").textContent = qc > 0 ? gfmt(Q.g) + " × " + (cur - Q.thr) + " = " + fmt(qc) + " pmol/L" : "0 pmol/L (at or below its threshold of 284)";
        let t: string;
        if (pc === 0 && qc === 0) t = "P and Q are both at or below their thresholds here, so neither shows osmotically driven release.";
        else if (pc === qc) t = "Here P and Q give the same output, " + fmt(pc) + " pmol/L, by different routes: the lines cross at " + crossOsm + " mOsm/kg.";
        else if (pc > qc) t = "P (lower threshold) releases more than Q here, " + fmt(pc) + " against " + fmt(qc) + " pmol/L; below " + crossOsm + " mOsm/kg P is higher.";
        else t = "Q (higher gain) releases more than P here, " + fmt(qc) + " against " + fmt(pc) + " pmol/L; above " + crossOsm + " mOsm/kg Q is higher.";
        s += " " + t + " At the crossing both give " + fmt(crossCents) + " pmol/L, so a set point is not one fixed number.";
      }
      why.textContent = s;
    }
    [curIn, thrIn, gainIn, pqIn].forEach((c) => c.addEventListener("input", render));
    pqIn.addEventListener("change", render);
    render();
  });
</script>

<style is:global>
  .otg { padding: var(--ddp-space-3) var(--ddp-space-4) var(--ddp-space-4); margin: var(--ddp-space-5) 0; }
  .otg-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem; font-weight: 600; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); margin-bottom: var(--ddp-space-3); }
  .otg-chip { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 400; color: var(--ddp-color-muted); }
  .otg-loop { list-style: none; margin: 0 0 var(--ddp-space-2); padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--ddp-space-2); }
  .otg-loop li { display: flex; flex-direction: column; gap: 0.1rem; padding: 0.35rem 0.5rem; font-size: var(--ddp-text-xs); line-height: 1.35; color: var(--ddp-color-ink-soft); background: color-mix(in srgb, var(--ddp-color-accent) 8%, transparent); border-radius: 6px; }
  .otg-loop b { color: var(--ddp-color-primary); }
  .otg-svg { display: block; width: 100%; max-width: 560px; margin: 0 auto; height: auto; background: #fff; border: 1px solid var(--ddp-color-line); border-radius: 6px; }
  .otg-legend { list-style: none; margin: var(--ddp-space-2) 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.2rem 0.9rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .otg-legend li[hidden] { display: none; }
  .otg-sw { display: inline-block; width: 1.4rem; height: 0; vertical-align: middle; margin-right: 0.3rem; border-top: 3px solid #0e7c86; }
  .otg-sw-cur { border-top: 2px dashed #e57200; }
  .otg-sw-p { border-top: 3px dashed #7b3fa0; }
  .otg-sw-q { border-top: 3px dotted #2a6fbb; }
  .otg-tri { color: #0e7c86; }
  .otg-cross { color: #222; }
  .otg-controls { display: grid; grid-template-columns: 1fr 1fr; gap: var(--ddp-space-2) var(--ddp-space-4); margin: var(--ddp-space-3) 0 var(--ddp-space-2); }
  .otg-slabel { display: flex; flex-direction: column; gap: 0.1rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .otg-slabel em { font-style: normal; font-weight: 700; color: var(--ddp-color-accent); font-family: var(--ddp-font-mono); }
  .otg-slabel input, .otg-check input { accent-color: var(--ddp-color-accent); }
  .otg-check { grid-column: 1 / -1; display: flex; gap: 0.5rem; align-items: flex-start; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .otg-check input { margin-top: 0.15rem; flex: none; }
  .otg-readout { display: grid; grid-template-columns: 1fr 1fr; gap: var(--ddp-space-2); margin: var(--ddp-space-2) 0; padding: var(--ddp-space-2) var(--ddp-space-3); background: color-mix(in srgb, var(--ddp-color-accent) 8%, transparent); border-radius: 6px; }
  .otg-readout div { display: flex; flex-direction: column; gap: 0.1rem; min-width: 0; }
  .otg-readout div[hidden] { display: none; }
  .otg-wide { grid-column: 1 / -1; }
  .otg-readout dt { font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .otg-readout dd { margin: 0; font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); color: var(--ddp-color-primary); font-weight: 700; overflow-wrap: anywhere; }
  .otg-why { margin: 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); line-height: 1.5; min-height: 4.5em; }
  .otg-foot { margin: var(--ddp-space-3) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); border-left: 3px solid var(--ddp-color-secondary); padding-left: 0.55rem; }
  @media (max-width: 520px) {
    .otg-loop { grid-template-columns: 1fr; }
    .otg-controls, .otg-readout { grid-template-columns: 1fr; }
  }
</style>
