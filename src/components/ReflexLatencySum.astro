---
/**
 * ReflexLatencySum — the lesson's model reflex sum. Five labelled blocks (receptor, sensory
 * neuron, integrating centre, motor neuron, effector) beside a stacked bar of model latency:
 * sensory axon time + 1.0 ms synaptic delay + motor axon time, each axon time = length / velocity.
 * A small inset reproduces the subtraction logic of a two-point velocity measurement,
 * v = difference in distance / difference in time. Illustrative numbers only. Original.
 */
---

<figure class="rl card" data-rl>
  <figcaption class="rl-head">Reflex latency as a sum of times<span class="rl-chip">⚙ original · interactive</span></figcaption>

  <svg class="rl-svg" viewBox="0 0 360 200" role="img" aria-label="Five labelled blocks of a reflex arc, receptor to effector, above a stacked bar of the model latency: sensory axon time, synaptic delay, motor axon time" data-main></svg>

  <ul class="rl-legend" aria-hidden="true">
    <li><span class="rl-sw rl-sw-s"></span>sensory axon time</li>
    <li><span class="rl-sw rl-sw-y"></span>synaptic delay</li>
    <li><span class="rl-sw rl-sw-m"></span>motor axon time</li>
  </ul>

  <div class="rl-controls">
    <label class="rl-slabel"><span>Conduction velocity, both axons <em data-out="v">50</em> m per s</span>
      <input type="range" data-in="v" min="1" max="60" step="1" value="50" />
    </label>
    <label class="rl-slabel"><span>Axon length, each <em data-out="len">1.0</em> m <small>(1.0 m is the lesson’s tall-adult path; shorter values are illustrative)</small></span>
      <input type="range" data-in="len" min="0.1" max="1" step="0.1" value="1" />
    </label>
    <label class="rl-slabel"><span>Inset: distance between stimulus points <em data-out="d">30</em> mm</span>
      <input type="range" data-in="d" min="10" max="50" step="5" value="30" />
    </label>
  </div>

  <dl class="rl-readout">
    <div><dt>Each axon: time = length / velocity</dt><dd data-r="axon"></dd></div>
    <div><dt>Total latency = sensory + synapse + motor</dt><dd data-r="total"></dd></div>
    <div><dt>Compared with the same path at 50 m per s</dt><dd data-r="ratio"></dd></div>
    <div><dt>Share of the total taken by the synapse</dt><dd data-r="share"></dd></div>
  </dl>

  <p class="rl-sub">Inset: a two-point velocity measurement (illustrative nerve at the velocity setting above, not Helmholtz’s value)</p>
  <svg class="rl-svg" viewBox="0 0 360 120" role="img" aria-label="Two timed trials, stimulating a nerve at a near point and a far point; the common delay cancels and the extra delay belongs to the extra length of nerve" data-inset></svg>
  <dl class="rl-readout">
    <div><dt>Extra delay = distance / velocity</dt><dd data-r="extra"></dd></div>
    <div><dt>Velocity from the subtraction: difference in distance / difference in time</dt><dd data-r="vback"></dd></div>
  </dl>

  <p class="rl-why" data-why role="status"></p>
  <p class="rl-assume">In this sketch: one tall adult human path, the same velocity in both axons, one synapse of 1.0 ms, illustrative numbers. This is a model sum, not a measured knee-jerk latency; it ignores the time the sense organ, the nerve-muscle junction and the muscle take. Only the direct excitatory limb of the knee jerk is monosynaptic. The inset’s numbers are illustrative, not Helmholtz’s: his frog nerve at room temperature is not a human nerve at 37 degrees C.</p>
  <p class="rl-foot">Rule to keep: time = distance / velocity for each axon, and the total is the sum of the axon times and the synaptic delay; a two-point measurement removes the delays common to both trials by subtraction.</p>
</figure>

<script>
  const NS = 'http://www.w3.org/2000/svg';
  const TEAL = '#0e7c86', ORANGE = '#e57200', INK = '#4b4b55', FAINT = '#b9b9c2', GREY = '#8a8a96';
  const SYN_S = 0.001; // the lesson's synaptic delay, 1.0 ms
  function el(name: string, attrs: Record<string, string | number>): SVGElement {
    const e = document.createElementNS(NS, name);
    for (const k in attrs) e.setAttribute(k, String(attrs[k]));
    return e;
  }
  function txt(svg: SVGSVGElement, x: number, y: number, s: string, opts: Record<string, string | number> = {}) {
    const t = el('text', Object.assign({ x, y, 'font-size': 9, fill: INK, 'text-anchor': 'middle' }, opts));
    t.textContent = s;
    svg.appendChild(t);
  }
  // time in a common unit: seconds when the total is 1 s or more, otherwise milliseconds
  function fmtT(sec: number, useSec: boolean): string {
    if (useSec) return sec.toFixed(3) + ' s';
    const ms = sec * 1000;
    return (ms < 10 ? ms.toFixed(2) : ms.toFixed(1)) + ' ms';
  }
  document.querySelectorAll<HTMLElement>('[data-rl]').forEach((root) => {
    const main = root.querySelector<SVGSVGElement>('[data-main]');
    const inset = root.querySelector<SVGSVGElement>('[data-inset]');
    const vIn = root.querySelector<HTMLInputElement>('[data-in="v"]');
    const lIn = root.querySelector<HTMLInputElement>('[data-in="len"]');
    const dIn = root.querySelector<HTMLInputElement>('[data-in="d"]');
    const vOut = root.querySelector<HTMLElement>('[data-out="v"]');
    const lOut = root.querySelector<HTMLElement>('[data-out="len"]');
    const dOut = root.querySelector<HTMLElement>('[data-out="d"]');
    const rAxon = root.querySelector<HTMLElement>('[data-r="axon"]');
    const rTotal = root.querySelector<HTMLElement>('[data-r="total"]');
    const rRatio = root.querySelector<HTMLElement>('[data-r="ratio"]');
    const rShare = root.querySelector<HTMLElement>('[data-r="share"]');
    const rExtra = root.querySelector<HTMLElement>('[data-r="extra"]');
    const rBack = root.querySelector<HTMLElement>('[data-r="vback"]');
    const why = root.querySelector<HTMLElement>('[data-why]');
    if (!main || !inset || !vIn || !lIn || !dIn || !vOut || !lOut || !dOut || !rAxon || !rTotal || !rRatio || !rShare || !rExtra || !rBack || !why) return;

    function blocks() {
      if (!main) return;
      const names: [string, string, string][] = [
        ['Receptor', 'muscle spindle', ''],
        ['Sensory', 'neuron', 'sensory axon'],
        ['Integrating', 'centre:', 'spinal cord,'],
        ['Motor', 'neuron', 'motor axon'],
        ['Effector', 'quadriceps', ''],
      ];
      const W = 63, G = 10, X0 = 2, Y = 22, H = 48;
      main.appendChild(el('defs', {}));
      names.forEach((n, i) => {
        const x = X0 + i * (W + G);
        const fill = i === 1 ? 'rgba(14,124,134,0.16)' : i === 3 ? 'rgba(229,114,0,0.16)' : i === 2 ? 'rgba(138,138,150,0.18)' : '#f6f6f8';
        const stroke = i === 1 ? TEAL : i === 3 ? ORANGE : i === 2 ? GREY : FAINT;
        main.appendChild(el('rect', { x, y: Y, width: W, height: H, rx: 4, fill, stroke, 'stroke-width': 1.3 }));
        if (i === 2) {
          txt(main, x + W / 2, Y + 12, n[0], { 'font-weight': 700 });
          txt(main, x + W / 2, Y + 23, n[1]);
          txt(main, x + W / 2, Y + 34, n[2]);
          txt(main, x + W / 2, Y + 45, '1 synapse');
        } else {
          txt(main, x + W / 2, Y + 18, n[0], { 'font-weight': 700 });
          txt(main, x + W / 2, Y + 30, n[1]);
        }
        if (i < 4) {
          const ax = x + W + 1, bx = x + W + G - 1, ay = Y + H / 2;
          main.appendChild(el('line', { x1: ax, y1: ay, x2: bx - 3, y2: ay, stroke: INK, 'stroke-width': 1.4 }));
          main.appendChild(el('path', { d: `M${bx} ${ay} L${bx - 5} ${ay - 3} L${bx - 5} ${ay + 3} Z`, fill: INK }));
        }
      });
      txt(main, 180, 12, 'the five parts of a reflex arc, labelled for the knee jerk (schematic blocks)', { 'font-size': 9, fill: GREY });
    }

    function render() {
      if (!main || !inset || !vIn || !lIn || !dIn || !vOut || !lOut || !dOut || !rAxon || !rTotal || !rRatio || !rShare || !rExtra || !rBack || !why) return;
      const v = parseFloat(vIn.value), L = parseFloat(lIn.value), dmm = parseFloat(dIn.value);
      vOut.textContent = String(v);
      lOut.textContent = L.toFixed(1);
      dOut.textContent = String(dmm);

      const tAx = L / v;
      const total = 2 * tAx + SYN_S;
      const base = 2 * (L / 50) + SYN_S; // same path at the lesson's 50 m per s
      const ratio = total / base;
      const share = SYN_S / total;
      const useSec = total >= 1;

      rAxon.textContent = `${L.toFixed(1)} m / ${v} m per s = ${tAx.toFixed(tAx < 0.1 ? 4 : 3)} s${useSec ? '' : ' = ' + fmtT(tAx, useSec)}`;
      rTotal.textContent = `${fmtT(tAx, useSec)} + ${fmtT(SYN_S, useSec)} + ${fmtT(tAx, useSec)} = ${fmtT(total, useSec)}`;
      const rs = ratio >= 10 ? ratio.toFixed(1) : ratio.toFixed(2);
      rRatio.textContent = Math.abs(ratio - 1) < 0.0005
        ? `${fmtT(total, useSec)} / ${fmtT(base, useSec)} = 1.00 (this is the 50 m per s case)`
        : `${fmtT(total, useSec)} / ${fmtT(base, useSec)} = ${rs} ${ratio > 1 ? 'times longer' : 'times as long (shorter)'}`;
      const shareStr = (share * 100).toFixed(share < 0.01 ? 2 : share < 0.1 ? 1 : 0);
      rShare.textContent = `${fmtT(SYN_S, useSec)} / ${fmtT(total, useSec)} = ${shareStr}%`;

      // ---- stacked bar and diagram
      main.replaceChildren();
      blocks();
      const BX = 10, BW = 340, BY = 112, BH = 28;
      txt(main, 180, 80, 'model latency (bar widths in proportion to time; the bar always fills the width)', { fill: GREY });
      const wS = (tAx / total) * BW, wY = (SYN_S / total) * BW;
      main.appendChild(el('rect', { x: BX, y: BY, width: wS, height: BH, fill: 'rgba(14,124,134,0.55)', stroke: TEAL, 'stroke-width': 1 }));
      main.appendChild(el('rect', { x: BX + wS, y: BY, width: Math.max(wY, 1.2), height: BH, fill: GREY, stroke: INK, 'stroke-width': 1 }));
      main.appendChild(el('rect', { x: BX + wS + wY, y: BY, width: wS, height: BH, fill: 'rgba(229,114,0,0.55)', stroke: ORANGE, 'stroke-width': 1 }));
      if (wS >= 52) {
        txt(main, BX + wS / 2, BY + 17, fmtT(tAx, useSec), { fill: '#111', 'font-weight': 700 });
        txt(main, BX + wS + wY + wS / 2, BY + 17, fmtT(tAx, useSec), { fill: '#111', 'font-weight': 700 });
      }
      // synapse marker above the bar
      main.appendChild(el('line', { x1: 180, y1: BY - 14, x2: 180, y2: BY, stroke: INK, 'stroke-width': 1 }));
      txt(main, 180, BY - 17, `synaptic delay ${fmtT(SYN_S, useSec)}`, { 'font-weight': 700 });
      // total bracket
      main.appendChild(el('line', { x1: BX, y1: BY + BH + 8, x2: BX + BW, y2: BY + BH + 8, stroke: INK, 'stroke-width': 1 }));
      main.appendChild(el('line', { x1: BX, y1: BY + BH + 5, x2: BX, y2: BY + BH + 11, stroke: INK, 'stroke-width': 1 }));
      main.appendChild(el('line', { x1: BX + BW, y1: BY + BH + 5, x2: BX + BW, y2: BY + BH + 11, stroke: INK, 'stroke-width': 1 }));
      txt(main, 180, BY + BH + 23, `total latency (model) ${fmtT(total, useSec)}`, { 'font-size': 10, 'font-weight': 700 });
      txt(main, 180, BY + BH + 36, 'sensory axon + synapse + motor axon; times in proportion', { fill: GREY });

      // ---- inset
      const dm = dmm / 1000;
      const dt = dm / v; // seconds
      const dtMs = dt * 1000;
      inset.replaceChildren();
      const bw = (ms: number) => 12 + 38 * (Math.log10(ms) + 1);
      const rows: { y: number; label: string; far: boolean }[] = [
        { y: 22, label: 'near stimulus point', far: false },
        { y: 62, label: 'far stimulus point', far: true },
      ];
      const CX = 100, CW = 80, NW = 60;
      rows.forEach((r) => {
        txt(inset, 4, r.y + 15, r.label, { 'text-anchor': 'start' });
        inset.appendChild(el('rect', { x: CX, y: r.y, width: CW, height: 26, fill: '#f0f0f3', stroke: GREY, 'stroke-width': 1 }));
        txt(inset, CX + CW / 2, r.y + 11, 'junction + muscle', {});
        txt(inset, CX + CW / 2, r.y + 21, '(same in both)', {});
        inset.appendChild(el('rect', { x: CX + CW, y: r.y, width: NW, height: 26, fill: 'rgba(14,124,134,0.4)', stroke: TEAL, 'stroke-width': 1 }));
        txt(inset, CX + CW + NW / 2, r.y + 16, 'near nerve', {});
        if (r.far) {
          const w = bw(dtMs);
          inset.appendChild(el('rect', { x: CX + CW + NW, y: r.y, width: w, height: 26, fill: 'rgba(229,114,0,0.5)', stroke: ORANGE, 'stroke-width': 1 }));
          txt(inset, CX + CW + NW, r.y + 38, `extra ${dtMs < 10 ? dtMs.toFixed(2) : dtMs.toFixed(1)} ms`, { 'text-anchor': 'start', 'font-weight': 700 });
        }
      });
      txt(inset, 180, 115, `far point is ${dmm} mm farther along the nerve; extra-delay bar width is not to scale`, { fill: GREY });
      rExtra.textContent = `${dm.toFixed(3)} m / ${v} m per s = ${dt.toPrecision(3)} s = ${dtMs.toPrecision(3)} ms`;
      rBack.textContent = `${dm.toFixed(3)} m / ${dt.toPrecision(3)} s = ${v} m per s (computed from the unrounded extra delay)`;

      // ---- status
      const parts: string[] = [];
      const cmp = Math.abs(ratio - 1) < 0.0005 ? 'the same as the 50 m per s case' : ratio > 1 ? `${rs} times longer than the same path at 50 m per s` : `${rs} times as long as the same path at 50 m per s`;
      parts.push(`With both axons at ${v} m per s and ${L.toFixed(1)} m long, each takes ${fmtT(tAx, useSec)}, and the model sum is ${fmtT(total, useSec)}, ${cmp}.`);
      if (share >= 0.5) parts.push(`The 1.0 ms synaptic delay is now ${shareStr}% of the sum, so in this model the synapse takes a large share of the time.`);
      else if (share < 0.05) parts.push(`The 1.0 ms synaptic delay is ${shareStr}% of the sum, so the axons account for almost all of it.`);
      else parts.push(`The 1.0 ms synaptic delay is ${shareStr}% of the sum.`);
      parts.push(`In the inset, ${dmm} mm more nerve at ${v} m per s adds ${dtMs.toPrecision(3)} ms, and dividing the difference in distance by the difference in time gives back ${v} m per s (illustrative numbers). Model sum, not a measured latency.`);
      why.textContent = parts.join(' ');
    }
    [vIn, lIn, dIn].forEach((s) => s.addEventListener('input', render));
    render();
  });
</script>

<style>
  .rl { padding: var(--ddp-space-3) var(--ddp-space-4) var(--ddp-space-4); margin: var(--ddp-space-5) 0; }
  .rl-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem; font-weight: 600; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); margin-bottom: var(--ddp-space-3); }
  .rl-chip { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 400; color: var(--ddp-color-muted); }
  .rl-svg { display: block; width: 100%; max-width: 560px; margin: 0 auto; height: auto; background: #fff; border: 1px solid var(--ddp-color-line); border-radius: 6px; }
  .rl-legend { display: flex; flex-wrap: wrap; gap: 0.3rem 1rem; list-style: none; margin: var(--ddp-space-2) 0 0; padding: 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); justify-content: center; }
  .rl-sw { display: inline-block; width: 0.8rem; height: 0.8rem; margin-right: 0.35rem; vertical-align: -0.1rem; border-radius: 2px; border: 1px solid #555; }
  .rl-sw-s { background: rgba(14,124,134,0.55); }
  .rl-sw-y { background: #8a8a96; }
  .rl-sw-m { background: rgba(229,114,0,0.55); }
  .rl-controls { display: grid; grid-template-columns: 1fr; gap: var(--ddp-space-2) var(--ddp-space-4); margin: var(--ddp-space-3) 0 var(--ddp-space-2); }
  @media (min-width: 640px) { .rl-controls { grid-template-columns: 1fr 1fr 1fr; } }
  .rl-slabel { display: flex; flex-direction: column; gap: 0.1rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .rl-slabel small { font-size: inherit; color: var(--ddp-color-muted); }
  .rl-slabel em { font-style: normal; font-weight: 700; color: var(--ddp-color-accent); font-family: var(--ddp-font-mono); }
  .rl-slabel input { accent-color: var(--ddp-color-accent); }
  .rl-readout { display: grid; grid-template-columns: 1fr; gap: var(--ddp-space-2); margin: var(--ddp-space-2) 0; padding: var(--ddp-space-2) var(--ddp-space-3); background: color-mix(in srgb, var(--ddp-color-accent) 8%, transparent); border-radius: 6px; }
  .rl-readout div { display: flex; flex-direction: column; gap: 0.1rem; }
  .rl-readout dt { font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .rl-readout dd { margin: 0; font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); color: var(--ddp-color-primary); font-weight: 700; overflow-wrap: anywhere; }
  .rl-sub { margin: var(--ddp-space-3) 0 var(--ddp-space-2); font-size: var(--ddp-text-xs); font-weight: 600; color: var(--ddp-color-ink-soft); }
  .rl-why { margin: var(--ddp-space-2) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); line-height: 1.5; min-height: 6em; }
  .rl-assume { margin: var(--ddp-space-2) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); line-height: 1.5; }
  .rl-foot { margin: var(--ddp-space-3) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); border-left: 3px solid var(--ddp-color-secondary); padding-left: 0.55rem; }
</style>
