---
/* The parents' door: one Biology Together activity a parent can start from this page, with its
   time, what to gather and the grown-up's part, all read from the guide's own frontmatter. Then,
   when the hop graph has later lessons on the activity's idea, where that idea is taught again.
   An activity with no later lesson in the graph shows no such block. */
import { courseHref } from '../../data/courses';
import RungList from './RungList.astro';
import { CALENDAR_LINK } from './flags';
import { word, type HomeData } from './data';

interface Props { d: HomeData }
const { d } = Astro.props;
const a = d.featured;
const together = d.lessonsIn('biology-together');
const later = a.later;
const lowerFirst = (t: string) => t.charAt(0).toLowerCase() + t.slice(1);
---

<section class="home-door" id="parents" data-door="parent" aria-labelledby="home-parent-h">
  <div class="home-parent-grid">
    <div class="home-pg-intro">
      <h2 class="home-h2" id="home-parent-h">You don’t need to know the answers</h2>
      <p class="home-story">
        Biology Together is {together} activities for children aged 5 to 10, done away from the screen with things
        from the kitchen and the yard. Each guide tells you what to gather, what to ask, and what children often
        say, so the two of you find out together.
      </p>
    </div>

    <article class="home-activity" aria-labelledby="home-act-h">
      <p class="home-act-kicker">This week’s one to try</p>
      <h3 class="home-act-t" id="home-act-h">{a.title}</h3>
      <p class="home-act-meta">About {a.minutes} minutes, {a.setting}{a.followUp && <span>, {a.followUp}</span>}</p>
      <p class="home-act-hook">{a.hook}</p>
      <figure class="home-act-fig">
        <img src={a.figure.src} width="1200" height="800" loading="lazy" alt={a.figure.alt} />
        <figcaption>The set-up, from the guide. AI-generated illustration.</figcaption>
      </figure>
      <p class="home-act-need" id="home-act-need">You will need</p>
      <ul class="home-act-list" role="list" aria-labelledby="home-act-need">
        {a.materials.map((m) => <li class={m.optional ? 'is-opt' : ''}>{m.text}{m.optional && ' (optional)'}</li>)}
      </ul>
      <p class="home-act-adult"><b>Your part.</b> {a.adult}</p>
      <p class="home-act-go">
        <a class="home-go" href={`/lessons/${a.slug}/`}>Open the activity guide</a>
        <a class="home-quiet" href={courseHref('biology-together')}>All {together} activities <span aria-hidden="true">→</span></a>
      </p>
      {a.lastWeek.slug !== a.slug && (
        <p class="home-act-last">Last week’s: <a href={`/lessons/${a.lastWeek.slug}/`}>{a.lastWeek.title}</a></p>
      )}
    </article>

    <div class="home-pg-rest">
      <p class="home-p">
        Each guide has safety notes for the adult, placed before the steps. No lesson needs an account, there are
        no ads, and no AI tutor talks to your child. AI models from more than one company check the guides. I make
        this site, and I have not yet read them all myself.
        {a.underReview && <> Part of this one is still waiting for my check, and it carries an <a href="/under-review/">Under review</a> tag.</>}
      </p>
      {CALENDAR_LINK && (
        <p class="home-p">
          <a href="/calendar/parent/">The calendar</a> puts one activity on the days that suit you, with one list of what to gather.
        </p>
      )}
      {later && (
        <div class="home-later">
          <h3 class="home-h3">Where this goes later</h3>
          <p class="home-p">
            This activity is the first lesson on one idea: {lowerFirst(later.name)}. Later courses teach the same
            idea again. If you have an older child, or you are curious yourself, this is where it goes.
          </p>
          <RungList rungs={later.rungs} label={`${later.name}, at ${word(later.rungs.length)} later ${later.rungs.length === 1 ? 'level' : 'levels'}`} />
        </div>
      )}
      <p class="home-p">
        If your child is in grade 7 or high school, their course is here too:
        <a href={courseHref('life-science')}>Life Science</a> and
        <a href={courseHref('high-school-biology')}>Biology</a>, both written to Virginia’s standards.
      </p>
    </div>
  </div>
</section>
