---
/**
 * RootHairHyphaSurface — the worked problem of the plant-nutrition lesson as a sketch.
 * A 10 mm root segment (0.5 mm across) with root hairs (0.5 mm long, 0.010 mm wide) and
 * mycorrhizal hyphae (0.004 mm wide) added; every structure a cylinder, side area
 * = pi x d x L, ends ignored; surface per volume = 4 / d. Original, self-contained.
 */
---

<figure class="rhs card" data-rhs>
  <figcaption class="rhs-head">Root hairs and fungal hyphae — how much surface do they add?<span class="rhs-chip">⚙ original · interactive</span></figcaption>

  <svg class="rhs-svg" viewBox="0 0 340 250" role="img" aria-label="Schematic of a 10 millimetre root segment with root hairs and mycorrhizal hyphae, and a bar chart of absorbing surface" data-svg></svg>

  <div class="rhs-controls">
    <label class="rhs-slabel"><span>Root hairs on the segment <em data-out="hairs">1,000</em> <small>(each 0.5 mm long, 0.010 mm wide)</small></span>
      <input type="range" data-in="hairs" min="0" max="2000" step="50" value="1000" />
    </label>
    <label class="rhs-slabel"><span>Length of attached hyphae <em data-out="hyph">1,000</em> mm <small>(each 0.004 mm wide)</small></span>
      <input type="range" data-in="hyph" min="0" max="2000" step="50" value="1000" />
    </label>
  </div>
  <div class="rhs-view" role="group" aria-label="View">
    <span class="rhs-vlabel">View:</span>
    <button type="button" class="rhs-btn" data-view="total" aria-pressed="true">total surface</button>
    <button type="button" class="rhs-btn" data-view="spv" aria-pressed="false">surface per volume (4 / d)</button>
  </div>

  <dl class="rhs-readout" data-readout></dl>
  <p class="rhs-why" data-why role="status"></p>

  <p class="rhs-assume">In this sketch: illustrative numbers, not a measured species; every structure is a cylinder; ends ignored; not to scale; drawn lines are a sample, not a count.</p>
  <p class="rhs-foot">Side area of a cylinder = π × d × L, and surface per volume of a cylinder = 4 / d, so the thinner the cylinder, the more surface per unit of material.</p>
</figure>

<script>
  const NS = 'http://www.w3.org/2000/svg';
  const ACCENT = '#0e7c86', ORANGE = '#e57200', PURPLE = '#6b4fa0', INK = '#4b4b55', FAINT = '#b9b9c2';
  const D_ROOT = 0.5, L_ROOT = 10, D_HAIR = 0.010, L_HAIR = 0.5, D_HYPH = 0.004;
  const MAX_TOTAL = Math.PI * D_ROOT * L_ROOT + 2000 * Math.PI * D_HAIR * L_HAIR + Math.PI * D_HYPH * 2000;
  function el(name: string, attrs: Record<string, string | number>): SVGElement {
    const e = document.createElementNS(NS, name);
    for (const k in attrs) e.setAttribute(k, String(attrs[k]));
    return e;
  }
  const n1 = (x: number) => x.toLocaleString('en-US', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
  const fmt = (x: number) => (x === 0 ? '0' : x < 1 ? x.toPrecision(3) : n1(x));
  const int = (x: number) => x.toLocaleString('en-US');

  document.querySelectorAll<HTMLElement>('[data-rhs]').forEach((root) => {
    const svg = root.querySelector<SVGSVGElement>('[data-svg]');
    const hairsIn = root.querySelector<HTMLInputElement>('[data-in="hairs"]');
    const hyphIn = root.querySelector<HTMLInputElement>('[data-in="hyph"]');
    const hairsOut = root.querySelector<HTMLElement>('[data-out="hairs"]');
    const hyphOut = root.querySelector<HTMLElement>('[data-out="hyph"]');
    const readout = root.querySelector<HTMLElement>('[data-readout]');
    const why = root.querySelector<HTMLElement>('[data-why]');
    const btns = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-view]'));
    if (!svg || !hairsIn || !hyphIn || !hairsOut || !hyphOut || !readout || !why || btns.length === 0) return;
    let view = 'total';

    function text(x: number, y: number, s: string, extra: Record<string, string | number> = {}) {
      const t = el('text', Object.assign({ x, y, 'font-size': 9, fill: INK }, extra));
      t.textContent = s;
      svg!.appendChild(t);
    }

    function drawAnatomy(nHairs: number, hyphLen: number) {
      const RX0 = 40, RX1 = 300, RY0 = 56, RY1 = 96;
      // zone emptied of phosphate (schematic)
      svg!.appendChild(el('rect', { x: 26, y: 30, width: 288, height: 92, rx: 18, fill: 'none', stroke: FAINT, 'stroke-width': 1.2, 'stroke-dasharray': '4 3' }));
      // hairs: a sample of lines, evenly spaced, short
      const drawnH = Math.min(40, Math.ceil(nHairs / 50));
      for (let i = 0; i < drawnH; i++) {
        const x = RX0 + 8 + ((RX1 - RX0 - 16) * (i + 0.5)) / drawnH;
        const up = i % 2 === 0;
        svg!.appendChild(el('line', { x1: x, y1: up ? RY0 : RY1, x2: x + 2, y2: up ? RY0 - 14 : RY1 + 14, stroke: ORANGE, 'stroke-width': 1 }));
      }
      // hyphae: thin wavy lines reaching past the dashed line
      const drawnY = Math.min(24, Math.ceil(hyphLen / 80));
      for (let i = 0; i < drawnY; i++) {
        const x = RX0 + 14 + ((RX1 - RX0 - 28) * (i + 0.3)) / drawnY;
        const up = i % 2 === 1;
        const y0 = up ? RY0 : RY1, dir = up ? -1 : 1, len = 40 + (i % 3) * 5;
        svg!.appendChild(el('path', { d: `M${x.toFixed(1)} ${y0} q ${6 * dir} ${dir * len * 0.4} 0 ${dir * len * 0.6} t ${-2} ${dir * len * 0.4}`, fill: 'none', stroke: PURPLE, 'stroke-width': 0.8 }));
      }
      // root block on top of hair/hypha roots
      svg!.appendChild(el('rect', { x: RX0, y: RY0, width: RX1 - RX0, height: RY1 - RY0, fill: ACCENT, rx: 3 }));
      text((RX0 + RX1) / 2, (RY0 + RY1) / 2 + 3, 'root segment: 10 mm long, 0.5 mm across', { 'text-anchor': 'middle', fill: '#fff', 'font-weight': 700 });
      text(26, 14, 'root hairs (orange) and mycorrhizal hyphae (purple)', { 'font-weight': 700 });
      text(26, 134, 'dashed line: schematic zone a root has emptied', {});
      text(26, 145, 'of slowly moving phosphate', {});
    }

    function render() {
      const nH = parseInt(hairsIn!.value, 10);
      const L = parseInt(hyphIn!.value, 10);
      hairsOut!.textContent = int(nH);
      hyphOut!.textContent = int(L);
      const aRoot = Math.PI * D_ROOT * L_ROOT;
      const aOne = Math.PI * D_HAIR * L_HAIR;
      const aHair = nH * aOne;
      const aHyph = Math.PI * D_HYPH * L;
      const total = aRoot + aHair + aHyph;
      svg!.replaceChildren();
      drawAnatomy(nH, L);

      if (view === 'total') {
        text(26, 164, 'Absorbing surface by source (mm²)', { 'font-weight': 700 });
        const X0 = 40, W = 260, Y = 172, H = 26;
        const sc = W / MAX_TOTAL;
        let x = X0;
        const parts: [number, string][] = [[aRoot, ACCENT], [aHair, ORANGE], [aHyph, PURPLE]];
        svg!.appendChild(el('rect', { x: X0, y: Y, width: W, height: H, fill: 'none', stroke: FAINT, 'stroke-width': 0.8 }));
        for (const [a, c] of parts) {
          if (a <= 0) continue;
          svg!.appendChild(el('rect', { x, y: Y, width: a * sc, height: H, fill: c }));
          x += a * sc;
        }
        text(Math.max(X0 + 70, Math.min(x, X0 + W)), Y + H + 12, 'total ' + fmt(total) + ' mm²', { 'text-anchor': 'end', 'font-weight': 700 });
        text(X0, Y + H + 26, '0', { 'text-anchor': 'middle' });
        text(X0 + W, Y + H + 26, fmt(MAX_TOTAL) + ' mm² (both sliders at maximum)', { 'text-anchor': 'end' });
      } else {
        text(26, 164, 'Surface per volume of material, 4 / d (per mm)', { 'font-weight': 700 });
        const rows: [string, number, string][] = [['root', 4 / D_ROOT, ACCENT], ['root hair', 4 / D_HAIR, ORANGE], ['hypha', 4 / D_HYPH, PURPLE]];
        rows.forEach(([name, v, c], i) => {
          const y = 172 + i * 22;
          text(26, y + 11, name, {});
          svg!.appendChild(el('rect', { x: 86, y, width: Math.max(1.5, (v / 1000) * 170), height: 16, fill: c }));
          text(86 + (v / 1000) * 170 + 5, y + 12, int(v) + ' per mm', {});
        });
      }

      if (view === 'total') {
        readout!.innerHTML =
          `<div><dt>Root, 10 mm segment</dt><dd>π × 0.5 × 10 = ${fmt(aRoot)} mm²</dd></div>` +
          `<div><dt>One hair</dt><dd>π × 0.010 × 0.5 = ${aOne.toPrecision(3)} mm²</dd></div>` +
          `<div><dt>${int(nH)} hairs</dt><dd>${int(nH)} × ${aOne.toPrecision(3)} = ${fmt(aHair)} mm²</dd></div>` +
          `<div><dt>${int(L)} mm of hyphae</dt><dd>π × 0.004 × ${int(L)} = ${fmt(aHyph)} mm²</dd></div>` +
          `<div class="rhs-tot"><dt>Total</dt><dd>${fmt(aRoot)} + ${fmt(aHair)} + ${fmt(aHyph)} = ${fmt(total)} mm²</dd></div>`;
      } else {
        readout!.innerHTML =
          `<div><dt>Root, 0.5 mm across</dt><dd>4 / 0.5 = 8 per mm</dd></div>` +
          `<div><dt>Root hair, 0.010 mm across</dt><dd>4 / 0.010 = 400 per mm</dd></div>` +
          `<div><dt>Hypha, 0.004 mm across</dt><dd>4 / 0.004 = 1,000 per mm</dd></div>`;
      }

      let s: string;
      if (view === 'spv') {
        s = 'In this sketch, the thinner the cylinder, the more surface per unit of material: 8 per mm for the root, 400 for a hair and 1,000 for a hypha, so thin hyphae give the most surface per unit of material. Slow-moving phosphate soon empties the soil right around a root, and thin hyphae reach past that emptied zone. These slider settings do not change a per-volume ratio, which depends only on width.';
      } else if (nH === 0 && L === 0) {
        s = 'In this sketch the bare root segment has ' + fmt(aRoot) + ' mm² of side surface (π × 0.5 × 10). Add root hairs or hyphae to see how much surface each adds.';
      } else {
        const bits: string[] = [];
        if (nH > 0) bits.push('the hairs add ' + fmt(aHair) + ' mm² (' + (aHair / aRoot).toFixed(2) + ' times the root’s own)');
        if (L > 0) bits.push('the hyphae add ' + fmt(aHyph) + ' mm² (' + (aHyph / aRoot).toFixed(2) + ' times the root’s own)');
        s = 'In this sketch, the root alone has ' + fmt(aRoot) + ' mm²; ' + bits.join(' and ') + ', for a total of ' + fmt(total) + ' mm². ';
        if (L > 0) s += 'Hyphae are thin, so they give the most surface per unit of material, and they reach past the zone a root has emptied of slowly moving phosphate. ';
        if (nH > 0) s += 'Hairs help with water too in some settings, but not equally everywhere: they aided water extraction by rapidly transpiring barley in drying soil, while a hairless maize mutant took up water no differently in sand or loam.';
      }
      why!.textContent = s.trim();
    }

    [hairsIn, hyphIn].forEach((i) => i.addEventListener('input', render));
    btns.forEach((b) => b.addEventListener('click', () => {
      view = b.dataset.view === 'spv' ? 'spv' : 'total';
      btns.forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
      render();
    }));
    render();
  });
</script>

<style>
  .rhs { padding: var(--ddp-space-3) var(--ddp-space-4) var(--ddp-space-4); margin: var(--ddp-space-5) 0; }
  .rhs-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem; font-weight: 600; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); margin-bottom: var(--ddp-space-3); }
  .rhs-chip { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 400; color: var(--ddp-color-muted); }
  .rhs-svg { display: block; width: 100%; max-width: 560px; margin: 0 auto; height: auto; background: #fff; border: 1px solid var(--ddp-color-line); border-radius: 6px; }
  .rhs-controls { display: grid; grid-template-columns: 1fr 1fr; gap: var(--ddp-space-2) var(--ddp-space-4); margin: var(--ddp-space-3) 0 var(--ddp-space-2); }
  .rhs-slabel { display: flex; flex-direction: column; gap: 0.1rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .rhs-slabel small { font-size: inherit; color: var(--ddp-color-muted); }
  .rhs-slabel em { font-style: normal; font-weight: 700; color: var(--ddp-color-accent); font-family: var(--ddp-font-mono); }
  .rhs-slabel input { accent-color: var(--ddp-color-accent); }
  .rhs-view { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem; margin: var(--ddp-space-2) 0; font-size: var(--ddp-text-xs); }
  .rhs-vlabel { color: var(--ddp-color-ink-soft); }
  .rhs-btn { font: inherit; padding: 0.3rem 0.7rem; border: 1px solid var(--ddp-color-line); border-radius: 999px; background: #fff; color: var(--ddp-color-ink-soft); cursor: pointer; }
  .rhs-btn[aria-pressed="true"] { background: var(--ddp-color-accent); border-color: var(--ddp-color-accent); color: #fff; }
  .rhs-btn:focus-visible { outline: 2px solid var(--ddp-color-accent); outline-offset: 2px; }
  .rhs-readout { display: grid; grid-template-columns: 1fr 1fr; gap: var(--ddp-space-2); margin: var(--ddp-space-2) 0; padding: var(--ddp-space-2) var(--ddp-space-3); background: color-mix(in srgb, var(--ddp-color-accent) 8%, transparent); border-radius: 6px; }
  .rhs-readout :global(div) { display: flex; flex-direction: column; gap: 0.1rem; min-width: 0; }
  .rhs-readout :global(.rhs-tot) { grid-column: 1 / -1; }
  .rhs-readout :global(dt) { font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .rhs-readout :global(dd) { margin: 0; font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); color: var(--ddp-color-primary); font-weight: 700; overflow-wrap: anywhere; }
  .rhs-why { margin: 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); line-height: 1.5; min-height: 4.5em; }
  .rhs-assume { margin: var(--ddp-space-2) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .rhs-foot { margin: var(--ddp-space-3) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); border-left: 3px solid var(--ddp-color-secondary); padding-left: 0.55rem; }
  @media (max-width: 520px) { .rhs-controls, .rhs-readout { grid-template-columns: 1fr; } }
</style>
