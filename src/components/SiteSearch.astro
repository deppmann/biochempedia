---
/**
 * Search across every course, or inside one. Two layers, both static, merged into ONE ranked
 * list of lessons by src/lib/lesson-search.ts (read its header for the ranking):
 *
 *  1. The small title index (/search-index.json: titles, hooks, objectives,
 *     headings, names). Fetched the first time the box is used; it answers the
 *     first keystrokes at once.
 *  2. The full text of every lesson, through Pagefind (/pagefind/, built by
 *     `npm run build` after `astro build`): the prose, the "Explain at my level"
 *     texts, the stories, the self-test, the "How we measure it" blurbs and the film
 *     transcripts. Pagefind loads a small entry file and then only the index chunks and
 *     page fragments a query needs, so a phone never downloads the whole text. If
 *     /pagefind/ is missing (for example in `astro dev` before any build) the box
 *     quietly stays a title search.
 *
 * When the text answers, the list is re-ranked once (not on every keystroke after that
 * settles). Each result is a lesson with up to three spots where the words were found,
 * labelled for where they are and linked there with the words highlighted.
 *
 * `scope` preselects a course; the chips let the reader widen it again.
 * `autofocus` is for the search page, where the box is the point of the page.
 */
interface Props {
  scope?: string;
  autofocus?: boolean;
  label?: string;
  placeholder?: string;
}
const { scope = 'all', autofocus = false, label = 'Search the lessons', placeholder = 'Try “allostery”, “Ras”, “western blot”…' } = Astro.props;
---

<div class="ss" data-site-search data-scope={scope}>
  <form class="ss-form" role="search" action="/search/" method="get">
    <label class="ss-label" for="ss-q">{label}</label>
    <div class="ss-row">
      <svg class="ss-ico" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <circle cx="10.5" cy="10.5" r="6.5" /><path d="M15.5 15.5 L21 21" />
      </svg>
      <input id="ss-q" class="ss-input" type="search" name="q" autocomplete="off" spellcheck="false"
        placeholder={placeholder} autofocus={autofocus} />
    </div>
  </form>
  <div class="ss-scope" role="group" aria-label="Where to search" hidden></div>
  <p class="ss-status" role="status" aria-live="polite"></p>
  <ol class="ss-results"></ol>
  <button type="button" class="ss-more" hidden>Show more lessons</button>
</div>

<script>
  import { browserEngine, createLessonSearch, TEXT_MIN, type LessonHit, type Ranked, type TextResult, type TitleHit } from '../lib/lesson-search';

  const esc = (s: string) => s.replace(/[&<>"]/g, (ch) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[ch]!));
  const PAGE = 12;       // lessons drawn (and their page fragments fetched) at a time
  const SETTLE = 220;    // ms after the last keystroke before the lesson text is searched

  /* One engine for the page: the index and Pagefind load once however many boxes there are. */
  const search = createLessonSearch(browserEngine());

  document.querySelectorAll<HTMLElement>('[data-site-search]').forEach((root) => {
    const input = root.querySelector<HTMLInputElement>('.ss-input')!;
    const form = root.querySelector<HTMLFormElement>('.ss-form')!;
    const scopeBox = root.querySelector<HTMLElement>('.ss-scope')!;
    const status = root.querySelector<HTMLElement>('.ss-status')!;
    const list = root.querySelector<HTMLElement>('.ss-results')!;
    const moreBtn = root.querySelector<HTMLButtonElement>('.ss-more')!;
    let scope = root.dataset.scope || 'all';
    let ready = false;

    /* State of the current query. `seq` is bumped by every new query; an answer that comes back for
       an older one is dropped. */
    let seq = 0;
    let textTimer = 0;
    let cur: {
      key: string;
      query: string;
      state: 'wait' | 'ok' | 'off';
      titles: TitleHit[];
      ranked: Ranked[];
      shown: number;
      hydrated: Map<string, LessonHit>;
    } | null = null;

    const drawScope = () => {
      const courses = search.courses();
      if (courses.length < 2) return;
      scopeBox.hidden = false;
      scopeBox.innerHTML = [{ s: 'all', t: 'All courses' }, ...courses]
        .map((c) => `<button type="button" class="ss-chip" data-scope="${esc(c.s)}" aria-pressed="${c.s === scope}">${esc(c.t)}</button>`)
        .join('');
    };
    scopeBox.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-scope]');
      if (!b) return;
      scope = b.dataset.scope!;
      drawScope();
      run();
    });

    /* The link is assembled here, not written as href="/lessons/…" in the
       template: the asset guard reads every quoted href in the built page,
       inline script included, and would take the template for a real path. */
    const link = (slug: string, hash?: string) => ['href', `"/lessons/${esc(slug)}/${hash ? `#${esc(hash)}` : ''}"`].join('=');
    const rawLink = (url: string) => ['href', `"${esc(url)}"`].join('=');
    const plural = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;

    /* A place the words were found: where it is, then the sentence around the match. */
    const spotItem = (s: LessonHit['spots'][number]) =>
      `<li class="ss-snip ss-k-${s.kind}"><a ${rawLink(s.url)}><span class="ss-snip-h">${s.kind === 'section' ? '§ ' : ''}${esc(s.label)}</span><span class="ss-snip-x">${s.excerptHtml}</span></a></li>`;

    const card = (e: Ranked, hit: LessonHit | undefined) => {
      const r = e.rec;
      const spots = hit?.spots ?? [];
      // Section headings the title index matched are listed too, unless a spot already points there.
      const taken = new Set(spots.map((s) => /#(.+)$/.exec(s.url)?.[1]).filter(Boolean));
      const plain = e.heads.filter(([, a]) => !taken.has(a)).slice(0, Math.max(0, 4 - spots.length));
      const items = [...spots.map(spotItem), ...plain.map(([t, a]) => `<li><a ${link(r.s, a)}>§ ${esc(t)}</a></li>`)];
      const partial = e.coverage < 1 ? '<p class="ss-hit-partial">Has some of your words, not all.</p>' : '';
      return `
        <li class="ss-hit">
          <a class="ss-hit-main" ${link(r.s)}>
            <span class="ss-hit-where">${esc(search.courseTitle(r.c))}${r.u ? ` · ${esc(r.u)}` : ''} · Lesson ${r.n}</span>
            <span class="ss-hit-title">${esc(r.t)}</span>
            <span class="ss-hit-hook">${esc(r.h)}</span>
          </a>
          ${partial}
          ${items.length ? `<ul class="ss-hit-heads">${items.join('')}</ul>` : ''}
        </li>`;
    };

    const render = () => {
      if (!cur) return;
      const where = scope === 'all' ? 'all courses' : search.courseTitle(scope);
      const q = cur.query;
      const shown = cur.ranked.slice(0, cur.shown);
      list.innerHTML = shown.map((e) => card(e, cur!.hydrated.get(e.slug))).join('');
      moreBtn.hidden = cur.shown >= cur.ranked.length;

      const n = cur.ranked.length;
      if (!n) {
        status.textContent = cur.state === 'wait' ? 'Searching the lesson text…'
          : cur.state === 'off' ? `No lesson in ${where} matches “${q}” by title or heading. The full-text index is not available here (it is built with the site).`
          : `No lesson in ${where} matches “${q}”. Try fewer or different words.`;
        return;
      }
      const full = cur.ranked.filter((e) => e.coverage >= 1).length;
      const none = full === 0;
      status.textContent = cur.state === 'wait' ? `In ${where}: ${plural(n, 'lesson', 'lessons')} by title or heading so far; searching the lesson text…`
        : none ? `No lesson in ${where} has every word of “${q}”. These have some of them.`
        : full < n ? `In ${where}: ${plural(full, 'lesson has', 'lessons have')} every word of “${q}”, best match first. ${n - full} more ${n - full === 1 ? 'has' : 'have'} some of the words.`
        : `In ${where}: ${plural(n, 'lesson', 'lessons')}, best match first.`;
    };

    /* Downloads the page fragments for the lessons about to be drawn (their excerpts), then draws. */
    const hydrateShown = async (my: number) => {
      if (!cur) return;
      const need = cur.ranked.slice(0, cur.shown).filter((e) => e.cand && !cur!.hydrated.has(e.slug));
      if (!need.length) { render(); return; }
      const got = await search.hydrate(need);
      if (my !== seq || !cur) return;
      for (const h of got) cur.hydrated.set(h.slug, h);
      render();
    };

    /* The lesson text through Pagefind, scoped by the course filter; ranks once it answers. */
    const searchText = async (my: number) => {
      const c = cur;
      if (!c) return;
      try {
        const res: TextResult = await search.textSearch(c.query, scope);
        if (my !== seq || cur !== c) return;
        c.state = res.state;
        c.ranked = search.rank(c.query, c.titles, res);
        c.shown = PAGE;
        c.hydrated.clear();
        await hydrateShown(my);                 // one redraw, with the excerpts in it
      } catch (err) {
        // A failed fetch must not stick: clearing the key lets the same query try again.
        console.warn('Lesson-text search failed', err);
        if (my === seq && cur === c) { c.state = 'off'; c.key = ''; render(); }
      }
    };

    moreBtn.addEventListener('click', () => {
      if (!cur) return;
      moreBtn.disabled = true;
      cur.shown += PAGE;
      hydrateShown(seq).finally(() => { moreBtn.disabled = false; });
    });

    const run = () => {
      const raw = input.value.trim();
      if (!raw) { window.clearTimeout(textTimer); seq++; cur = null; status.textContent = ''; list.innerHTML = ''; moreBtn.hidden = true; return; }
      if (!ready) return;
      const key = `${scope}|${raw}`;
      if (cur?.key === key) { render(); return; }
      const my = ++seq;                        // an answer for the old query must not land on the new one
      window.clearTimeout(textTimer);
      const titles = search.titleMatches(raw, scope);
      const textable = raw.length >= TEXT_MIN;
      cur = { key, query: raw, state: textable ? 'wait' : 'ok', titles, ranked: search.rank(raw, titles, null), shown: PAGE, hydrated: new Map() };
      render();
      if (textable) textTimer = window.setTimeout(() => searchText(my), SETTLE);
    };

    const start = () => {
      if (ready) { run(); return; }
      status.textContent = 'Loading the index…';
      search.load().then(() => {
        ready = true;
        if (scope !== 'all' && !search.courses().some((c) => c.s === scope)) scope = 'all';
        drawScope();
        status.textContent = '';
        run();
      }).catch(() => { status.textContent = 'The search index did not load. Reload the page to try again.'; });
    };

    let timer = 0;
    input.addEventListener('input', () => { window.clearTimeout(timer); timer = window.setTimeout(start, 90); });
    input.addEventListener('focus', () => { if (!ready) search.load().catch(() => {}); }, { once: true });
    // With JS the results appear in place; the form only navigates without it.
    form.addEventListener('submit', (e) => { e.preventDefault(); start(); });

    // A query in the address (/search/?q=…) runs at once.
    const preset = new URLSearchParams(location.search).get('q');
    if (preset && root === document.querySelector('[data-site-search]')) { input.value = preset; start(); }
  });
</script>

{/* Global because the chips and results are created by script. */}
<style is:global>
  .ss { margin: 0; }
  .ss-label {
    display: block;
    font-family: var(--ddp-font-mono);
    font-size: var(--ddp-text-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ddp-color-muted);
    margin-bottom: var(--ddp-space-2);
  }
  .ss-row { position: relative; max-width: 40rem; }
  .ss-ico { position: absolute; left: 0.9rem; top: 50%; transform: translateY(-50%); color: var(--ddp-color-muted); pointer-events: none; }
  .ss-input {
    width: 100%;
    box-sizing: border-box;
    min-height: 48px;
    padding: 0.6rem 1rem 0.6rem 2.7rem;
    font: inherit;
    font-size: var(--ddp-text-base);
    color: var(--ddp-color-ink);
    background: var(--ddp-color-surface);
    border: 1px solid var(--ddp-color-line);
    border-radius: 999px;
  }
  .ss-input::placeholder { color: var(--ddp-color-muted); }
  .ss-input:focus-visible { outline: 2px solid var(--ddp-color-accent); outline-offset: 2px; border-color: var(--ddp-color-accent); }
  .ss-scope { display: flex; flex-wrap: wrap; gap: var(--ddp-space-2); margin-top: var(--ddp-space-3); }
  .ss-scope[hidden] { display: none; }
  .ss-chip {
    font: inherit;
    font-size: var(--ddp-text-xs);
    font-weight: 600;
    color: var(--ddp-color-ink-soft);
    background: var(--ddp-color-surface);
    border: 1px solid var(--ddp-color-line);
    border-radius: 999px;
    padding: 0.35em 0.8em;
    min-height: 36px;
    cursor: pointer;
  }
  .ss-chip:hover { border-color: var(--ddp-color-accent); }
  .ss-chip[aria-pressed='true'] {
    color: var(--ddp-color-primary);
    border-color: var(--ddp-color-accent);
    background: color-mix(in srgb, var(--ddp-color-accent) 10%, var(--ddp-color-surface));
    font-weight: 700;
  }
  .ss-status { margin: var(--ddp-space-3) 0 0; font-size: var(--ddp-text-sm); color: var(--ddp-color-muted); min-height: 1.2em; }
  .ss-status:empty { display: none; }
  .ss-results { list-style: none; margin: var(--ddp-space-3) 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: var(--ddp-space-3); }
  .ss-results:empty { display: none; }
  .ss-hit { background: var(--ddp-color-surface); border: 1px solid var(--ddp-color-line); border-radius: var(--ddp-radius); padding: var(--ddp-space-3) var(--ddp-space-4); min-width: 0; }
  .ss-hit:hover { border-color: var(--ddp-color-accent); }
  .ss-hit-main { display: flex; flex-direction: column; gap: 0.2rem; color: inherit; text-decoration: none; }
  .ss-hit-main:hover { text-decoration: none; }
  .ss-hit-where { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); letter-spacing: 0.06em; text-transform: uppercase; color: var(--ddp-color-accent); }
  .ss-hit-title { font-family: var(--ddp-font-serif); font-weight: 600; font-size: var(--ddp-text-lg); line-height: 1.2; color: var(--ddp-color-primary); }
  .ss-hit-main:hover .ss-hit-title { text-decoration: underline; text-underline-offset: 3px; }
  .ss-hit-hook { font-size: var(--ddp-text-sm); color: var(--ddp-color-ink-soft); }
  .ss-hit-heads { list-style: none; margin: var(--ddp-space-2) 0 0; padding: var(--ddp-space-2) 0 0; border-top: 1px solid var(--ddp-color-line); display: flex; flex-direction: column; gap: 0.25rem; }
  .ss-hit-heads a { font-size: var(--ddp-text-sm); color: var(--ddp-color-ink); text-underline-offset: 3px; }
  .ss-hit-heads a:hover { color: var(--ddp-color-accent); }
  .ss-hit-partial { margin: var(--ddp-space-2) 0 0; font-size: var(--ddp-text-xs); font-style: italic; color: var(--ddp-color-muted); }
  .ss-hit-snippet { margin: var(--ddp-space-2) 0 0; font-size: var(--ddp-text-sm); line-height: 1.5; color: var(--ddp-color-ink-soft); overflow-wrap: anywhere; }
  .ss-snip a { display: flex; flex-direction: column; gap: 0.15rem; text-decoration: none; }
  .ss-snip-h { font-weight: 600; }
  /* Spots outside the lesson's main text carry a small rule so the reader sees at a glance that this is a story, a quiz question, a transcript. */
  .ss-snip:not(.ss-k-section):not(.ss-k-text) .ss-snip-h { color: var(--ddp-color-accent); }
  .ss-snip a:hover .ss-snip-h { text-decoration: underline; text-underline-offset: 3px; }
  .ss-snip-x { font-size: var(--ddp-text-sm); line-height: 1.5; color: var(--ddp-color-ink-soft); font-weight: 400; overflow-wrap: anywhere; }
  .ss mark {
    background: color-mix(in srgb, var(--ddp-color-accent) 22%, transparent);
    color: inherit;
    border-radius: 2px;
    padding: 0 0.1em;
    font-weight: 600;
  }
  .ss-more[hidden] { display: none; }
  .ss-more {
    align-self: flex-start;
    margin-top: var(--ddp-space-3);
    font: inherit;
    font-size: var(--ddp-text-sm);
    font-weight: 600;
    color: var(--ddp-color-primary);
    background: var(--ddp-color-surface);
    border: 1px solid var(--ddp-color-line);
    border-radius: 999px;
    padding: 0.5em 1.1em;
    min-height: 44px;
    cursor: pointer;
  }
  .ss-more:hover { border-color: var(--ddp-color-accent); }
  .ss-more:disabled { opacity: 0.6; cursor: progress; }
</style>
