---
/**
 * Search across every course, or inside one. Two layers, both static:
 *
 *  1. The small title index (/search-index.json: titles, hooks, objectives,
 *     headings, names). Fetched the first time the box is used; it answers the
 *     first keystrokes at once.
 *  2. The full text of every lesson, through Pagefind (/pagefind/, built by
 *     `npm run build` after `astro build`). Pagefind loads a small entry file and
 *     then only the index chunks and page fragments a query needs, so a phone
 *     never downloads the whole text. Hits show a highlighted snippet and link to
 *     the section they come from. If /pagefind/ is missing (for example in
 *     `astro dev` before any build) the box quietly stays a title search.
 *
 * Results are lessons, each with the section headings that matched, linked to
 * that section.
 *
 * `scope` preselects a course; the chips let the reader widen it again.
 * `autofocus` is for the search page, where the box is the point of the page.
 */
interface Props {
  scope?: string;
  autofocus?: boolean;
  label?: string;
  placeholder?: string;
}
const { scope = 'all', autofocus = false, label = 'Search the lessons', placeholder = 'Try “allostery”, “Ras”, “western blot”…' } = Astro.props;
---

<div class="ss" data-site-search data-scope={scope}>
  <form class="ss-form" role="search" action="/search/" method="get">
    <label class="ss-label" for="ss-q">{label}</label>
    <div class="ss-row">
      <svg class="ss-ico" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <circle cx="10.5" cy="10.5" r="6.5" /><path d="M15.5 15.5 L21 21" />
      </svg>
      <input id="ss-q" class="ss-input" type="search" name="q" autocomplete="off" spellcheck="false"
        placeholder={placeholder} autofocus={autofocus} />
    </div>
  </form>
  <div class="ss-scope" role="group" aria-label="Where to search" hidden></div>
  <p class="ss-status" role="status" aria-live="polite"></p>
  <ol class="ss-results"></ol>
  <h2 class="ss-sec" hidden>Also in the lesson text</h2>
  <ol class="ss-results ss-results-text"></ol>
  <button type="button" class="ss-more" hidden>Show more matches in the lesson text</button>
</div>

<script>
  interface Rec { s: string; c: string; n: number; t: string; u: string; k: string; h: string; x: string; g: [string, string][] }
  interface Index { courses: { s: string; t: string }[]; lessons: Rec[] }
  type Prepared = Rec & { nt: string; nh: string; nx: string; ng: string[] };
  /* The slice of Pagefind's API used here. */
  interface PfSub { title: string; url: string; excerpt: string; anchor?: { id: string }; weighted_locations?: { weight: number; balanced_score: number }[] }
  interface PfData { url: string; meta: { title?: string }; excerpt: string; sub_results: PfSub[] }
  interface Pf {
    options(o: object): Promise<void>;
    search(q: string, o?: object): Promise<{ results: { id: string; data(): Promise<PfData> }[] }>;
  }
  interface TextHit { slug: string; url: string; excerpt: string; subs: PfSub[] }

  const norm = (s: string) => s.toLowerCase().normalize('NFKD').replace(/[̀-ͯ]/g, '').replace(/[‐-―]/g, '-');
  const esc = (s: string) => s.replace(/[&<>"]/g, (ch) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[ch]!));
  /* A token matches at the start of a word ("phos" finds "phosphorylation"), so
     short queries stay precise; "mapk" still finds "Ras-to-MAPK" because a
     hyphen starts a word. */
  const hits = (hay: string, tok: string) => {
    let i = hay.indexOf(tok);
    while (i !== -1) {
      if (i === 0 || !/[a-z0-9]/.test(hay[i - 1])) return true;
      i = hay.indexOf(tok, i + 1);
    }
    return false;
  };

  let indexPromise: Promise<Index> | null = null;
  const loadIndex = (): Promise<Index> => (indexPromise ??= fetch('/search-index.json').then((r) => {
    if (!r.ok) throw new Error(String(r.status));
    return r.json() as Promise<Index>;
  }));

  /* The full-text engine, loaded the first time a query is long enough to need it.
     Resolves to null when /pagefind/ is not there (no build yet, or offline), and
     the search carries on with titles and headings alone. */
  let pfPromise: Promise<Pf | null> | null = null;
  const loadPagefind = (): Promise<Pf | null> => (pfPromise ??= (async () => {
    try {
      const url = '/pagefind/pagefind.js';
      const pf = (await import(/* @vite-ignore */ url)) as Pf;
      // Makes each result link carry ?pagefind-highlight=… so the lesson page can mark the words.
      await pf.options({ highlightParam: 'pagefind-highlight' });
      return pf;
    } catch { return null; }
  })());

  /* Pagefind needs every word of a query, and little words ("to", "a", "its") occur in
     every paragraph, which pulls snippets toward sentences that match only those. They are
     dropped, unless the query is in quotes (an exact phrase) or nothing else is left. */
  const LITTLE = new Set('a an and are as at be by for from in into is it its of on or that the this to was were with'.split(' '));
  const textQuery = (raw: string) => {
    if (raw.includes('"')) return raw;
    const words = raw.split(/\s+/).filter(Boolean);
    const kept = words.filter((w) => !LITTLE.has(w.toLowerCase()));
    return kept.length ? kept.join(' ') : raw;
  };

  const TEXT_MIN = 3;    // characters before the lesson text is searched
  const TEXT_PAGE = 12;  // lesson-text hits fetched at a time

  document.querySelectorAll<HTMLElement>('[data-site-search]').forEach((root) => {
    const input = root.querySelector<HTMLInputElement>('.ss-input')!;
    const form = root.querySelector<HTMLFormElement>('.ss-form')!;
    const scopeBox = root.querySelector<HTMLElement>('.ss-scope')!;
    const status = root.querySelector<HTMLElement>('.ss-status')!;
    const list = root.querySelector<HTMLElement>('.ss-results:not(.ss-results-text)')!;
    const textSec = root.querySelector<HTMLElement>('.ss-sec')!;
    const textList = root.querySelector<HTMLElement>('.ss-results-text')!;
    const moreBtn = root.querySelector<HTMLButtonElement>('.ss-more')!;
    let scope = root.dataset.scope || 'all';
    let prepared: Prepared[] | null = null;
    let bySlug = new Map<string, Prepared>();
    let courses: Index['courses'] = [];

    /* Title/heading matches, recomputed on every keystroke. */
    let titleOut: { r: Prepared; score: number; heads: [string, string][] }[] = [];
    /* Lesson-text matches for the current query and scope, filled in as Pagefind answers. */
    let text: { key: string; state: 'wait' | 'ok' | 'off'; handles: { data(): Promise<PfData> }[]; loaded: number; hits: Map<string, TextHit>; order: string[] } | null = null;
    let seq = 0;
    let textTimer = 0;

    const drawScope = () => {
      if (courses.length < 2) return;
      scopeBox.hidden = false;
      scopeBox.innerHTML = [{ s: 'all', t: 'All courses' }, ...courses]
        .map((c) => `<button type="button" class="ss-chip" data-scope="${esc(c.s)}" aria-pressed="${c.s === scope}">${esc(c.t)}</button>`)
        .join('');
    };
    scopeBox.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-scope]');
      if (!b) return;
      scope = b.dataset.scope!;
      drawScope();
      run();
    });

    /* The link is assembled here, not written as href="/lessons/…" in the
       template: the asset guard reads every quoted href in the built page,
       inline script included, and would take the template for a real path. */
    const link = (slug: string, hash?: string) => ['href', `"/lessons/${esc(slug)}/${hash ? `#${esc(hash)}` : ''}"`].join('=');
    const rawLink = (url: string) => ['href', `"${esc(url)}"`].join('=');
    const courseTitle = (s: string) => courses.find((c) => c.s === s)?.t ?? s;
    const plural = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;

    /* A section a text hit came from: heading, then the sentence around the match. */
    const subItem = (h: PfSub) =>
      `<li class="ss-snip"><a ${rawLink(h.url)}><span class="ss-snip-h">§ ${esc(h.title)}</span><span class="ss-snip-x">${h.excerpt}</span></a></li>`;

    const card = (r: Prepared, heads: [string, string][], th: TextHit | undefined, own: boolean) => {
      // Headings the text hit already covers are not listed twice.
      const subs = (th?.subs ?? []).filter((s) => s.anchor?.id).slice(0, 2);
      const taken = new Set(subs.map((s) => s.anchor!.id));
      const plain = heads.filter(([, a]) => !taken.has(a));
      const items = [...subs.map(subItem), ...plain.map(([t, a]) => `<li><a ${link(r.s, a)}>§ ${esc(t)}</a></li>`)];
      // A hit with no section of its own (text before the first heading) shows its snippet under the card.
      const lead = th && !subs.length && th.excerpt ? `<p class="ss-hit-snippet">${th.excerpt}</p>` : '';
      return `
        <li class="ss-hit">
          <a class="ss-hit-main" ${own && th ? rawLink(th.url) : link(r.s)}>
            <span class="ss-hit-where">${esc(courseTitle(r.c))}${r.u ? ` · ${esc(r.u)}` : ''} · Lesson ${r.n}</span>
            <span class="ss-hit-title">${esc(r.t)}</span>
            <span class="ss-hit-hook">${esc(r.h)}</span>
          </a>
          ${lead}
          ${items.length ? `<ul class="ss-hit-heads">${items.join('')}</ul>` : ''}
        </li>`;
    };

    /* Draws title hits first (they were instant), then lessons found only in the text. */
    const render = () => {
      const q = input.value.trim();
      const where = scope === 'all' ? 'all courses' : courseTitle(scope);
      const shown = titleOut.slice(0, 24);
      const shownSet = new Set(shown.map(({ r }) => r.s));
      list.innerHTML = shown.map(({ r, heads }) => card(r, heads, text?.hits.get(r.s), false)).join('');

      const textOnly = (text?.order ?? []).filter((s) => !shownSet.has(s) && bySlug.has(s));
      textList.innerHTML = textOnly.map((s) => card(bySlug.get(s)!, [], text!.hits.get(s), true)).join('');
      textSec.hidden = textOnly.length === 0 || shown.length === 0;   // the heading only separates the two lists
      moreBtn.hidden = !(text && text.state === 'ok' && text.loaded < text.handles.length);

      const parts: string[] = [];
      if (titleOut.length) parts.push(`${plural(titleOut.length, 'lesson', 'lessons')} by title or heading${titleOut.length > shown.length ? ` (first ${shown.length} shown)` : ''}`);
      if (text?.state === 'ok' && text.handles.length) parts.push(`${plural(text.handles.length, 'lesson', 'lessons')} with the words in the text`);
      if (text?.state === 'wait') parts.push('searching the lesson text…');
      if (!parts.length) {
        status.textContent = text?.state === 'off'
          ? `No lesson in ${where} matches “${q}” by title or heading. The full-text index is not available here (it is built with the site).`
          : `No lesson in ${where} matches “${q}”. Try fewer or different words.`;
      } else {
        status.textContent = `In ${where}: ${parts.join('; ')}.`;
      }
    };

    /* Lesson-text search through Pagefind, scoped by the course filter. Stale answers are dropped. */
    const loadMore = async (my: number) => {
      if (!text || text.state !== 'ok') return;
      const next = text.handles.slice(text.loaded, text.loaded + TEXT_PAGE);
      text.loaded += next.length;
      const datas = await Promise.all(next.map((h) => h.data()));
      if (my !== seq || !text) return;
      for (const d of datas) {
        const slug = /\/lessons\/([^/?#]+)/.exec(d.url)?.[1];
        if (!slug || text.hits.has(slug)) continue;
        // Pagefind lists a page's sections in reading order. The best one goes first: the section whose
        // snippet holds the most different query words, then the one where rare words weigh most.
        const stem = (m: string) => m.replace(/<\/?mark>/g, '').toLowerCase().replace(/[’']s$/, '').replace(/[^a-z0-9]+$/, '').replace(/s$/, '');
        const distinct = (h: PfSub) => new Set((h.excerpt.match(/<mark>.*?<\/mark>/g) ?? []).map(stem)).size;
        const strength = (h: PfSub) => (h.weighted_locations ?? []).reduce((a, l) => a + l.balanced_score * l.weight, 0);
        const subs = [...d.sub_results].sort((a, b) => distinct(b) - distinct(a) || strength(b) - strength(a));
        text.hits.set(slug, { slug, url: d.url, excerpt: d.excerpt, subs });
        text.order.push(slug);
      }
      render();
    };
    const searchText = async (raw: string, forScope: string, key: string) => {
      const my = ++seq;
      text = { key, state: 'wait', handles: [], loaded: 0, hits: new Map(), order: [] };
      render();
      const pf = await loadPagefind();
      if (my !== seq) return;
      if (!pf) { text.state = 'off'; render(); return; }
      try {
        const res = await pf.search(textQuery(raw), forScope === 'all' ? {} : { filters: { course: forScope } });
        if (my !== seq) return;
        text.handles = res.results;
        text.state = 'ok';
        await loadMore(my);
        render();
      } catch (err) {
        // A failed fetch must not stick: clearing the key lets the same query try again.
        console.warn('Lesson-text search failed', err);
        if (my === seq && text) { text.state = 'off'; text.key = ''; render(); }
      }
    };
    moreBtn.addEventListener('click', () => { moreBtn.disabled = true; loadMore(seq).finally(() => { moreBtn.disabled = false; }); });

    const run = () => {
      const q = norm(input.value).trim();
      if (!q) { window.clearTimeout(textTimer); seq++; text = null; titleOut = []; status.textContent = ''; list.innerHTML = ''; textList.innerHTML = ''; textSec.hidden = true; moreBtn.hidden = true; return; }
      if (!prepared) return;
      const toks = q.split(/\s+/).filter(Boolean);
      const out: typeof titleOut = [];
      for (const r of prepared) {
        if (scope !== 'all' && r.c !== scope) continue;
        let score = 0;
        let all = true;
        const heads = new Set<number>();
        for (const tok of toks) {
          let s = 0;
          if (hits(r.nt, tok)) s += 10;
          r.ng.forEach((g, i) => { if (hits(g, tok)) { s += 4; heads.add(i); } });
          if (hits(r.nh, tok)) s += 3;
          if (hits(r.nx, tok)) s += 2;
          if (s === 0) { all = false; break; }
          score += s;
        }
        if (!all) continue;
        // The whole phrase in the title is the best answer there is.
        if (toks.length > 1 && r.nt.includes(q)) score += 15;
        out.push({ r, score, heads: [...heads].slice(0, 3).map((i) => r.g[i]) });
      }
      out.sort((a, b) => b.score - a.score || a.r.c.localeCompare(b.r.c) || a.r.n - b.r.n);
      titleOut = out;

      // The lesson text is searched once the query has settled; a changed query or scope starts over.
      const key = `${scope}|${input.value.trim()}`;
      if (q.length < TEXT_MIN) { window.clearTimeout(textTimer); seq++; text = null; render(); return; }
      if (text?.key === key) { render(); return; }
      seq++;                                   // an answer for the old query must not land on the new one
      text = { key, state: 'wait', handles: [], loaded: 0, hits: new Map(), order: [] };
      render();
      window.clearTimeout(textTimer);
      textTimer = window.setTimeout(() => searchText(input.value.trim(), scope, key), 220);
    };

    const start = () => {
      if (prepared) { run(); return; }
      status.textContent = 'Loading the index…';
      loadIndex().then((idx: Index) => {
        courses = idx.courses;
        if (scope !== 'all' && !courses.some((c) => c.s === scope)) scope = 'all';
        prepared = idx.lessons.map((r: Rec) => ({ ...r, nt: norm(r.t), nh: norm(`${r.h} ${r.k} ${r.u}`), nx: norm(r.x), ng: r.g.map((g: [string, string]) => norm(g[0])) }));
        bySlug = new Map(prepared.map((r) => [r.s, r]));
        drawScope();
        status.textContent = '';
        run();
      }).catch(() => { status.textContent = 'The search index did not load. Reload the page to try again.'; });
    };

    let timer = 0;
    input.addEventListener('input', () => { window.clearTimeout(timer); timer = window.setTimeout(start, 90); });
    input.addEventListener('focus', () => { if (!prepared) loadIndex().catch(() => {}); }, { once: true });
    // With JS the results appear in place; the form only navigates without it.
    form.addEventListener('submit', (e) => { e.preventDefault(); start(); });

    // A query in the address (/search/?q=…) runs at once.
    const preset = new URLSearchParams(location.search).get('q');
    if (preset && root === document.querySelector('[data-site-search]')) { input.value = preset; start(); }
  });
</script>

{/* Global because the chips and results are created by script. */}
<style is:global>
  .ss { margin: 0; }
  .ss-label {
    display: block;
    font-family: var(--ddp-font-mono);
    font-size: var(--ddp-text-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ddp-color-muted);
    margin-bottom: var(--ddp-space-2);
  }
  .ss-row { position: relative; max-width: 40rem; }
  .ss-ico { position: absolute; left: 0.9rem; top: 50%; transform: translateY(-50%); color: var(--ddp-color-muted); pointer-events: none; }
  .ss-input {
    width: 100%;
    box-sizing: border-box;
    min-height: 48px;
    padding: 0.6rem 1rem 0.6rem 2.7rem;
    font: inherit;
    font-size: var(--ddp-text-base);
    color: var(--ddp-color-ink);
    background: var(--ddp-color-surface);
    border: 1px solid var(--ddp-color-line);
    border-radius: 999px;
  }
  .ss-input::placeholder { color: var(--ddp-color-muted); }
  .ss-input:focus-visible { outline: 2px solid var(--ddp-color-accent); outline-offset: 2px; border-color: var(--ddp-color-accent); }
  .ss-scope { display: flex; flex-wrap: wrap; gap: var(--ddp-space-2); margin-top: var(--ddp-space-3); }
  .ss-scope[hidden] { display: none; }
  .ss-chip {
    font: inherit;
    font-size: var(--ddp-text-xs);
    font-weight: 600;
    color: var(--ddp-color-ink-soft);
    background: var(--ddp-color-surface);
    border: 1px solid var(--ddp-color-line);
    border-radius: 999px;
    padding: 0.35em 0.8em;
    min-height: 36px;
    cursor: pointer;
  }
  .ss-chip:hover { border-color: var(--ddp-color-accent); }
  .ss-chip[aria-pressed='true'] {
    color: var(--ddp-color-primary);
    border-color: var(--ddp-color-accent);
    background: color-mix(in srgb, var(--ddp-color-accent) 10%, var(--ddp-color-surface));
    font-weight: 700;
  }
  .ss-status { margin: var(--ddp-space-3) 0 0; font-size: var(--ddp-text-sm); color: var(--ddp-color-muted); min-height: 1.2em; }
  .ss-status:empty { display: none; }
  .ss-results { list-style: none; margin: var(--ddp-space-3) 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: var(--ddp-space-3); }
  .ss-results:empty { display: none; }
  .ss-hit { background: var(--ddp-color-surface); border: 1px solid var(--ddp-color-line); border-radius: var(--ddp-radius); padding: var(--ddp-space-3) var(--ddp-space-4); min-width: 0; }
  .ss-hit:hover { border-color: var(--ddp-color-accent); }
  .ss-hit-main { display: flex; flex-direction: column; gap: 0.2rem; color: inherit; text-decoration: none; }
  .ss-hit-main:hover { text-decoration: none; }
  .ss-hit-where { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); letter-spacing: 0.06em; text-transform: uppercase; color: var(--ddp-color-accent); }
  .ss-hit-title { font-family: var(--ddp-font-serif); font-weight: 600; font-size: var(--ddp-text-lg); line-height: 1.2; color: var(--ddp-color-primary); }
  .ss-hit-main:hover .ss-hit-title { text-decoration: underline; text-underline-offset: 3px; }
  .ss-hit-hook { font-size: var(--ddp-text-sm); color: var(--ddp-color-ink-soft); }
  .ss-hit-heads { list-style: none; margin: var(--ddp-space-2) 0 0; padding: var(--ddp-space-2) 0 0; border-top: 1px solid var(--ddp-color-line); display: flex; flex-direction: column; gap: 0.25rem; }
  .ss-hit-heads a { font-size: var(--ddp-text-sm); color: var(--ddp-color-ink); text-underline-offset: 3px; }
  .ss-hit-heads a:hover { color: var(--ddp-color-accent); }
  .ss-hit-snippet { margin: var(--ddp-space-2) 0 0; font-size: var(--ddp-text-sm); line-height: 1.5; color: var(--ddp-color-ink-soft); overflow-wrap: anywhere; }
  .ss-snip a { display: flex; flex-direction: column; gap: 0.15rem; text-decoration: none; }
  .ss-snip-h { font-weight: 600; }
  .ss-snip a:hover .ss-snip-h { text-decoration: underline; text-underline-offset: 3px; }
  .ss-snip-x { font-size: var(--ddp-text-sm); line-height: 1.5; color: var(--ddp-color-ink-soft); font-weight: 400; overflow-wrap: anywhere; }
  .ss mark {
    background: color-mix(in srgb, var(--ddp-color-accent) 22%, transparent);
    color: inherit;
    border-radius: 2px;
    padding: 0 0.1em;
    font-weight: 600;
  }
  .ss-sec { margin: var(--ddp-space-5) 0 0; font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); letter-spacing: 0.12em; text-transform: uppercase; font-weight: 600; color: var(--ddp-color-muted); }
  .ss-sec[hidden], .ss-more[hidden] { display: none; }
  .ss-more {
    align-self: flex-start;
    margin-top: var(--ddp-space-3);
    font: inherit;
    font-size: var(--ddp-text-sm);
    font-weight: 600;
    color: var(--ddp-color-primary);
    background: var(--ddp-color-surface);
    border: 1px solid var(--ddp-color-line);
    border-radius: 999px;
    padding: 0.5em 1.1em;
    min-height: 44px;
    cursor: pointer;
  }
  .ss-more:hover { border-color: var(--ddp-color-accent); }
  .ss-more:disabled { opacity: 0.6; cursor: progress; }
</style>
