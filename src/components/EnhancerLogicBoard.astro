---
/**
 * EnhancerLogicBoard — switch factors on at three enhancer elements (A, B, C) and open or
 * close the chromatin at the promoter, and read the relative transcription of the gene.
 * Every number is a liver-cell value from the worked problem in the eukaryotic-regulation
 * lesson (promoter alone = 1). A closed promoter is drawn as blocked, because the lesson says
 * a nucleosome on a promoter generally blocks the proteins that start transcription.
 * A sketch of the logic, not a quantitative model. Original, self-contained vanilla-TS island.
 */
---

<figure class="elb card" data-elb>
  <figcaption class="elb-head">Enhancer logic board: combinations and open chromatin<span class="elb-chip">⚙ original · interactive</span></figcaption>

  <svg class="elb-svg" viewBox="0 0 360 230" role="img" aria-label="A stretch of DNA with enhancer elements A, B and C on the left and a promoter on the right, and a bar showing relative transcription" data-stage></svg>

  <fieldset class="elb-set">
    <legend>Factors bound at the enhancer</legend>
    <label><input type="checkbox" data-in="A" /> factor on element A</label>
    <label><input type="checkbox" data-in="B" checked /> factor on element B</label>
    <label><input type="checkbox" data-in="C" checked /> factor on element C</label>
  </fieldset>
  <fieldset class="elb-set elb-chrom">
    <legend>Chromatin at the promoter</legend>
    <label><input type="radio" name="elb-chrom" data-chrom="open" checked /> open (no nucleosome on the promoter)</label>
    <label><input type="radio" name="elb-chrom" data-chrom="closed" /> closed (a nucleosome on the promoter)</label>
  </fieldset>

  <p class="elb-verdict" data-verdict role="status"></p>
  <p class="elb-test" data-test></p>

  <p class="elb-foot">Rule to keep: the enhancer works as a committee, so B and C together give far more than either alone, and packed DNA is hard to read. This is a sketch of the logic using the lesson’s liver numbers, not a prediction for any real gene.</p>
</figure>

<script>
  const NS = 'http://www.w3.org/2000/svg';
  function el(name: string, attrs: Record<string, string | number>, text?: string): SVGElement {
    const e = document.createElementNS(NS, name);
    for (const k in attrs) e.setAttribute(k, String(attrs[k]));
    if (text !== undefined) e.textContent = text;
    return e;
  }
  // Liver column of the lesson's worked problem, promoter alone = 1. Key = elements with a factor bound.
  const VALUE: Record<string, number | null> = {
    '': 1, 'A': null, 'B': 5, 'C': 2, 'AB': 30, 'AC': 4, 'BC': 90, 'ABC': 100,
  };
  const COL: Record<string, string> = { A: '#7a5ea8', B: '#0e7c86', C: '#e57200' };
  const INK = '#4b4b55', FAINT = '#8a8a96';
  document.querySelectorAll<HTMLElement>('[data-elb]').forEach((root) => {
    const stage = root.querySelector<SVGSVGElement>('[data-stage]')!;
    const verdict = root.querySelector<HTMLElement>('[data-verdict]')!;
    const test = root.querySelector<HTMLElement>('[data-test]')!;
    const inp = (k: string) => root.querySelector<HTMLInputElement>(`[data-in="${k}"]`)!;
    const closedBtn = root.querySelector<HTMLInputElement>('[data-chrom="closed"]')!;
    const openBtn = root.querySelector<HTMLInputElement>('[data-chrom="open"]')!;
    const xOf = (v: number) => 40 + (280 * Math.log10(v)) / 2;

    function draw(on: Record<string, boolean>, closed: boolean, value: number | null, key: string) {
      stage.replaceChildren();
      const dnaY = 100;
      stage.appendChild(el('line', { x1: 10, y1: dnaY, x2: 350, y2: dnaY, stroke: INK, 'stroke-width': 2 }));
      // enhancer elements
      const xs: Record<string, number> = { A: 24, B: 76, C: 128 };
      (['A', 'B', 'C'] as const).forEach((k) => {
        const x = xs[k];
        stage.appendChild(el('rect', { x, y: dnaY - 9, width: 40, height: 18, rx: 3, fill: COL[k], opacity: on[k] ? 1 : 0.35 }));
        stage.appendChild(el('text', { x: x + 20, y: dnaY + 4, 'font-size': 10, 'text-anchor': 'middle', 'font-weight': 700, fill: '#fff' }, k));
        if (on[k]) {
          stage.appendChild(el('circle', { cx: x + 20, cy: dnaY - 24, r: 11, fill: COL[k] }));
          stage.appendChild(el('text', { x: x + 20, y: dnaY - 21, 'font-size': 9, 'text-anchor': 'middle', 'font-weight': 700, fill: '#fff' }, 'TF'));
        } else {
          stage.appendChild(el('text', { x: x + 20, y: dnaY + 24, 'font-size': 9, 'text-anchor': 'middle', fill: FAINT }, 'empty'));
        }
      });
      stage.appendChild(el('text', { x: 24, y: 28, 'font-size': 9, fill: INK }, 'enhancer (elements A, B, C)'));
      // promoter and gene
      stage.appendChild(el('rect', { x: 258, y: dnaY - 9, width: 44, height: 18, rx: 3, fill: '#4b4b55' }));
      stage.appendChild(el('text', { x: 280, y: dnaY + 4, 'font-size': 9, 'text-anchor': 'middle', 'font-weight': 700, fill: '#fff' }, 'promoter'));
      stage.appendChild(el('rect', { x: 306, y: dnaY - 9, width: 40, height: 18, rx: 3, fill: '#fff', stroke: INK, 'stroke-width': 1.2 }));
      stage.appendChild(el('text', { x: 326, y: dnaY + 4, 'font-size': 9, 'text-anchor': 'middle', fill: INK }, 'gene'));
      // nucleosome on promoter when closed
      if (closed) {
        stage.appendChild(el('rect', { x: 255, y: dnaY - 30, width: 50, height: 60, rx: 22, fill: '#d9d9e0', stroke: FAINT, 'stroke-width': 1.5, opacity: 0.5 }));
        stage.appendChild(el('text', { x: 280, y: dnaY - 36, 'font-size': 9, 'text-anchor': 'middle', fill: INK }, 'nucleosome'));
        stage.appendChild(el('text', { x: 280, y: dnaY + 25, 'font-size': 9, 'text-anchor': 'middle', fill: INK }, 'promoter covered'));
      }
      // Mediator loop when open and at least one factor is bound
      const nOn = key.length;
      if (!closed && nOn > 0) {
        const bound = (['A', 'B', 'C'] as const).filter((k) => on[k]);
        const x1 = xs[bound[bound.length - 1]] + 20;
        stage.appendChild(el('path', { d: `M ${x1} ${dnaY - 36} C ${x1 + 20} ${dnaY - 82}, 255 ${dnaY - 82}, 275 ${dnaY - 10}`, fill: 'none', stroke: INK, 'stroke-width': 1.5, 'stroke-dasharray': '3 3' }));
        stage.appendChild(el('text', { x: 190, y: 14, 'font-size': 9, 'text-anchor': 'middle', fill: INK }, 'coactivators + Mediator bridge to the promoter'));
      }
      // bar on a log scale: relative units, promoter alone = 1
      const by = 170;
      stage.appendChild(el('text', { x: 40, y: 150, 'font-size': 9, fill: INK }, 'relative transcription (log scale, promoter alone = 1)'));
      stage.appendChild(el('rect', { x: 40, y: by, width: 280, height: 16, fill: '#f1f1f5', stroke: '#d9d9e0' }));
      if (value !== null && !closed) {
        stage.appendChild(el('rect', { x: 40, y: by, width: Math.max(2, xOf(value) - 40), height: 16, fill: '#0e7c86' }));
      }
      [1, 10, 100].forEach((t) => {
        stage.appendChild(el('line', { x1: xOf(t), y1: by + 16, x2: xOf(t), y2: by + 21, stroke: INK }));
        stage.appendChild(el('text', { x: xOf(t), y: by + 32, 'font-size': 9, 'text-anchor': 'middle', fill: INK }, String(t)));
      });
      const label = closed ? 'no value in this sketch' : value === null ? 'not measured' : `${value} (${value}× the promoter alone)`;
      stage.appendChild(el('text', { x: 320, y: 222, 'font-size': 10, 'text-anchor': 'end', 'font-weight': 700, fill: closed ? '#b00020' : '#0e7c86' }, label));
    }

    function render() {
      const on = { A: inp('A').checked, B: inp('B').checked, C: inp('C').checked };
      const key = (['A', 'B', 'C'] as const).filter((k) => on[k]).join('');
      const closed = closedBtn.checked;
      const value = VALUE[key];
      draw(on, closed, value, key);
      const names = key.length === 3 ? 'A, B and C' : key.split('').join(' and ');
      let v: string;
      if (closed) {
        v = 'The promoter is wrapped in a nucleosome. A nucleosome on a promoter generally blocks the proteins that start transcription, so this sketch gives no transcription value for a closed promoter (the lesson gives no number)'
          + (key ? `, even with ${key.length === 1 ? 'a factor' : 'factors'} on ${names}. The lesson’s numbers come from reporter constructs, so this sketch does not model how bound factors recruit enzymes that modify chromatin.` : '.');
      } else if (key === '') {
        v = 'No factor is bound at the enhancer. The promoter alone gives the baseline, set to 1.';
      } else if (key === 'A') {
        v = 'Element A alone was not measured in the lesson’s table, so no value is shown. In liver cells A was dispensable: deleting it left 95 of 100.';
      } else if (key === 'B') {
        v = 'B alone gives 5: it is necessary (removing it from the full region drops 100 to 4) but not sufficient.';
      } else if (key === 'C') {
        v = 'C alone gives 2. Removing C from the full region drops 100 to 30.';
      } else if (key === 'BC') {
        v = 'B and C together give 90, 90% of the full region. They work together, as expected if factors on both must be present at once. This is the minimal liver enhancer.';
      } else if (key === 'ABC') {
        v = 'All three give 100. Adding A to B and C changes little (90 to 100): A is dispensable in liver.';
      } else if (key === 'AB') {
        v = 'A and B give 30, the value for the region with C deleted: a fall from 100. Without C the activity falls about 3.3-fold.';
      } else {
        v = 'A and C give 4, the value for the region with B deleted: a 25-fold fall from 100. B is necessary.';
      }
      verdict.textContent = v;
      if (!closed && key === 'BC') {
        test.textContent = 'The lesson’s check for B + C: if their effects added you would expect about 6 (1 + 4 + 1), if they multiplied about 10 (5 × 2); the measured value is 90.';
        test.hidden = false;
      } else {
        test.textContent = '';
        test.hidden = true;
      }
    }
    ['A', 'B', 'C'].forEach((k) => inp(k).addEventListener('change', render));
    openBtn.addEventListener('change', render);
    closedBtn.addEventListener('change', render);
    render();
  });
</script>

<style is:global>
  .elb { padding: var(--ddp-space-3) var(--ddp-space-4) var(--ddp-space-4); margin: var(--ddp-space-5) 0; }
  .elb-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem; font-weight: 600; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); margin-bottom: var(--ddp-space-3); }
  .elb-chip { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 400; color: var(--ddp-color-muted); }
  .elb-svg { display: block; width: 100%; max-width: 600px; margin: 0 auto var(--ddp-space-3); height: auto; background: #fff; border: 1px solid var(--ddp-color-line); border-radius: 6px; }
  .elb-set { border: 1px solid var(--ddp-color-line); border-radius: 6px; margin: var(--ddp-space-2) 0; padding: 0.4rem 0.7rem; display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 0.2rem 1rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .elb-chrom { grid-template-columns: 1fr 1fr; }
  .elb-set legend { font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); padding: 0 0.3rem; }
  .elb-set input { accent-color: var(--ddp-color-accent); }
  .elb-set input:focus-visible { outline: 2px solid var(--ddp-color-accent); outline-offset: 2px; }
  .elb-verdict { margin: var(--ddp-space-2) 0; padding: var(--ddp-space-2) var(--ddp-space-3); background: color-mix(in srgb, var(--ddp-color-accent) 8%, transparent); border-radius: 6px; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); min-height: 3em; }
  .elb-test { margin: var(--ddp-space-2) 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .elb-foot { margin: var(--ddp-space-3) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); border-left: 3px solid var(--ddp-color-secondary); padding-left: 0.55rem; }
  @media (max-width: 520px) { .elb-set, .elb-chrom { grid-template-columns: 1fr; } }
</style>
