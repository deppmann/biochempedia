---
/**
 * GtpaseTimer — a GTPase is a switch with a timer built in. The learner sets how fast
 * the GEF loads GTP and how much a GAP speeds the cutting of GTP, and sees the fraction
 * of the GTPase that is on and how long one molecule stays on (1 / k(cut)). A "break the
 * timer" switch stands for a mutant or analogue that cannot cut GTP. Original.
 */
---

<figure class="gt card" data-gtpase>
  <figcaption class="gt-head">GTPase switch — the timer<span class="gt-chip">⚙ original · interactive</span></figcaption>

  <svg class="gt-svg" viewBox="0 0 340 250" role="img" aria-label="Forty GTPase molecules shown as on or off, a bar for the fraction on, and a bar for how long one molecule stays on" data-plot></svg>

  <div class="gt-controls">
    <label class="gt-slabel"><span>GEF: loading rate <em data-out="gef">2</em> <small>(× the unaided cutting rate)</small></span>
      <input type="range" data-in="gef" min="0" max="10" step="0.5" value="2" />
    </label>
    <label class="gt-slabel"><span>GAP: speeds cutting <em data-out="gap">1</em>-fold <small>(1 = no GAP)</small></span>
      <input type="range" data-in="gap" min="0" max="5" step="1" value="0" />
    </label>
    <label class="gt-check"><input type="checkbox" data-in="broken" /> <span>Break the timer: GTP cannot be cut</span></label>
  </div>

  <dl class="gt-readout">
    <div><dt>Fraction on (sketch)</dt><dd data-r-frac>—</dd></div>
    <div><dt>One molecule stays on</dt><dd data-r-time>—</dd></div>
  </dl>
  <p class="gt-why" data-why role="status"></p>

  <p class="gt-foot">The off step sets the duration: the GEF turns the switch on, and how fast GTP is cut decides how long it stays on. The picture is a sketch of the logic. Only the 20 s example (an illustrative round number for a G alpha subunit) and the 40-fold speed-up (the lesson’s lower bound for RGS4 and GAIP on Gi alpha-1) come from the lesson.</p>
</figure>

<script>
  const NS = 'http://www.w3.org/2000/svg';
  const ACCENT = '#0e7c86', ORANGE = '#e57200', INK = '#4b4b55', FAINT = '#b9b9c2';
  const GAPS = [1, 2, 5, 10, 20, 40];
  const T0 = 20; // seconds: the lesson's illustrative G alpha, k(cut) = 0.05 per second
  function el(name: string, attrs: Record<string, string | number>): SVGElement {
    const e = document.createElementNS(NS, name);
    for (const k in attrs) e.setAttribute(k, String(attrs[k]));
    return e;
  }
  function fmtT(t: number): string {
    if (t >= 10) return t.toFixed(0) + ' s';
    if (t >= 1) return t.toFixed(1) + ' s';
    return t.toFixed(2) + ' s';
  }
  document.querySelectorAll<HTMLElement>('[data-gtpase]').forEach((root) => {
    const plot = root.querySelector<SVGSVGElement>('[data-plot]')!;
    const q = (s: string) => root.querySelector<HTMLInputElement>(s)!;
    const o = (s: string) => root.querySelector<HTMLElement>(s)!;
    const gefIn = q('[data-in="gef"]'), gapIn = q('[data-in="gap"]'), brokenIn = q('[data-in="broken"]');
    const gefOut = o('[data-out="gef"]'), gapOut = o('[data-out="gap"]');
    const rFrac = o('[data-r-frac]'), rTime = o('[data-r-time]'), why = o('[data-why]');
    const txt = (x: number, y: number, s: string, extra: Record<string, string | number> = {}) => {
      const t = el('text', { x, y, 'font-size': 10, fill: INK, ...extra }); t.textContent = s; plot.appendChild(t);
    };

    function render() {
      const g = parseFloat(gefIn.value);
      const gap = GAPS[parseInt(gapIn.value, 10)];
      const broken = brokenIn.checked;
      gapIn.disabled = broken;
      gefOut.textContent = g.toFixed(1);
      gapOut.textContent = broken ? '—' : String(gap);
      // two-state sketch: loading rate g (units of the unaided cutting rate), cutting rate = gap
      const frac = g === 0 ? 0 : broken ? 1 : g / (g + gap);
      const tOn = T0 / gap;

      plot.replaceChildren();
      txt(8, 14, 'Forty copies (dark = on, holding GTP; open = off, holding GDP)', { 'font-size': 9 });
      const nOn = Math.round(frac * 40);
      for (let i = 0; i < 40; i++) {
        const cx = 20 + (i % 20) * 15.5, cy = 32 + Math.floor(i / 20) * 18;
        const on = i < nOn;
        plot.appendChild(el('circle', { cx, cy, r: 6, fill: on ? ACCENT : '#fff', stroke: ACCENT, 'stroke-width': 1.4 }));
      }
      // fraction-on bar
      txt(8, 88, 'Fraction on', { 'font-weight': 700 });
      plot.appendChild(el('rect', { x: 8, y: 94, width: 324, height: 16, fill: '#fff', stroke: INK, 'stroke-width': 1 }));
      plot.appendChild(el('rect', { x: 8, y: 94, width: 324 * frac, height: 16, fill: ACCENT }));
      txt(8, 124, '0%', { 'font-size': 9 });
      txt(332, 124, '100%', { 'font-size': 9, 'text-anchor': 'end' });
      // time-on bar, log scale 0.1 s .. 100 s
      txt(8, 150, 'How long one molecule stays on (log scale, seconds)', { 'font-weight': 700 });
      const LMIN = -1, LMAX = 2, X0 = 8, X1 = 332;
      const px = (t: number) => X0 + ((Math.log10(t) - LMIN) / (LMAX - LMIN)) * (X1 - X0);
      plot.appendChild(el('rect', { x: X0, y: 156, width: X1 - X0, height: 16, fill: '#fff', stroke: INK, 'stroke-width': 1 }));
      for (const t of [0.1, 1, 10, 100]) {
        plot.appendChild(el('line', { x1: px(t), y1: 172, x2: px(t), y2: 177, stroke: INK, 'stroke-width': 1 }));
        txt(px(t), 189, String(t), { 'font-size': 9, 'text-anchor': t === 0.1 ? 'start' : t === 100 ? 'end' : 'middle' });
      }
      if (broken) {
        plot.appendChild(el('rect', { x: X0, y: 156, width: X1 - X0, height: 16, fill: ORANGE }));
        txt(X1 - 6, 168, 'no end: it cannot cut GTP', { 'font-size': 9, 'text-anchor': 'end', fill: '#fff', 'font-weight': 700 });
      } else {
        plot.appendChild(el('rect', { x: X0, y: 156, width: px(tOn) - X0, height: 16, fill: ORANGE }));
        plot.appendChild(el('circle', { cx: px(tOn), cy: 164, r: 4, fill: ORANGE }));
      }
      // reference mark: unaided switch, 20 s
      plot.appendChild(el('line', { x1: px(T0), y1: 152, x2: px(T0), y2: 176, stroke: INK, 'stroke-width': 1, 'stroke-dasharray': '3 2' }));
      txt(px(T0) - 3, 205, 'no GAP: 20 s (illustrative G alpha value)', { 'font-size': 9, 'text-anchor': 'end' });
      plot.appendChild(el('line', { x1: px(T0) - 1, y1: 198, x2: px(T0), y2: 177, stroke: INK, 'stroke-width': 0.7 }));
      txt(8, 232, 'Time on = 1 / k(cut). The hormone and receptor do not appear in it.', { 'font-size': 9 });

      rFrac.textContent = Math.round(frac * 100) + '%';
      rTime.textContent = broken ? 'no end' : fmtT(tOn);

      let msg: string;
      if (g === 0) {
        msg = 'With no GEF activity nothing loads GTP, so none of the switch is on. The timer never starts, because nothing turned the switch on.';
      } else if (broken) {
        msg = 'The GTP cannot be cut, so the off step is gone and the timer is broken. A molecule that is loaded stays on, as with the G protein held by an uncuttable GTP analogue or cholera-toxin Gs. (Ras G12V ignores its GAP and stays on far longer than normal.) The GAP has nothing to speed, and with the GEF above zero, changing it changes nothing. In this sketch the whole switch ends up on.';
      } else if (gap === 1) {
        msg = `With no GAP the G protein cuts its own GTP slowly, so one molecule stays on for about ${fmtT(tOn)} (the lesson's illustrative G alpha value). The GEF only sets how often it is turned on. In this sketch, about ${Math.round(frac * 100)}% is on at a time.`;
      } else {
        msg = `The GAP makes cutting ${gap}-fold faster, so one molecule stays on for only about ${fmtT(tOn)} instead of ${T0} s. The GEF is unchanged, so more of the switch is off. In this sketch, about ${Math.round(frac * 100)}% is on. The off step sets the duration.`;
      }
      why.textContent = msg;
    }
    [gefIn, gapIn, brokenIn].forEach((s) => s.addEventListener('input', render));
    render();
  });
</script>

<style is:global>
  .gt { padding: var(--ddp-space-3) var(--ddp-space-4) var(--ddp-space-4); margin: var(--ddp-space-5) 0; }
  .gt-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem; font-weight: 600; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); margin-bottom: var(--ddp-space-3); }
  .gt-chip { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 400; color: var(--ddp-color-muted); }
  .gt-svg { display: block; width: 100%; max-width: 560px; margin: 0 auto; height: auto; background: #fff; border: 1px solid var(--ddp-color-line); border-radius: 6px; }
  .gt-controls { display: grid; grid-template-columns: 1fr 1fr; gap: var(--ddp-space-2) var(--ddp-space-4); margin: var(--ddp-space-3) 0 var(--ddp-space-2); }
  .gt-slabel { display: flex; flex-direction: column; gap: 0.1rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .gt-slabel small { font-size: inherit; color: var(--ddp-color-muted); }
  .gt-slabel em { font-style: normal; font-weight: 700; color: var(--ddp-color-accent); font-family: var(--ddp-font-mono); }
  .gt-slabel input { accent-color: var(--ddp-color-accent); }
  .gt-check { grid-column: 1 / -1; display: flex; align-items: center; gap: 0.5rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .gt-check input { accent-color: var(--ddp-color-accent); width: 1.1rem; height: 1.1rem; }
  .gt-readout { display: grid; grid-template-columns: 1fr 1fr; gap: var(--ddp-space-2); margin: var(--ddp-space-2) 0; padding: var(--ddp-space-2) var(--ddp-space-3); background: color-mix(in srgb, var(--ddp-color-accent) 8%, transparent); border-radius: 6px; }
  .gt-readout div { display: flex; flex-direction: column; gap: 0.1rem; }
  .gt-readout dt { font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .gt-readout dd { margin: 0; font-family: var(--ddp-font-mono); font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); font-weight: 700; }
  .gt-why { margin: 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); line-height: 1.5; min-height: 6em; }
  .gt-foot { margin: var(--ddp-space-3) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); border-left: 3px solid var(--ddp-color-secondary); padding-left: 0.55rem; }
  @media (max-width: 480px) { .gt-controls { grid-template-columns: 1fr; } }
</style>
