---
/**
 * ActivityCompetitionNmj — two motor axons share one muscle fiber at one endplate. The learner
 * sets how active axon B is relative to axon A, or blocks part or all of the junction with
 * alpha-bungarotoxin, and sees which input keeps the receptor sites. The one rule, from the
 * synapse-elimination lesson: a site is removed when it is less active than sites near it, not
 * simply when it is silent. Blocking part of the junction leaves a silent patch beside active
 * sites (lost); blocking the whole junction leaves nothing less active than a neighbour (kept).
 * Relative units only; a sketch of the logic, not to scale. Labelled blocks only. Original.
 */
const uid = 'ac' + Math.random().toString(36).slice(2, 8);
---

<figure class="ac card" data-acnmj>
  <figcaption class="ac-head">Two axons, one muscle fiber: who keeps the sites?<span class="ac-chip">⚙ original · interactive</span></figcaption>

  <svg class="ac-svg" viewBox="0 0 360 230" role="img" aria-label="A row of ten receptor sites at one neuromuscular junction, shown at the start and weeks later, each covered by axon A or axon B" data-stage></svg>

  <fieldset class="ac-ctl">
    <legend>Alpha-bungarotoxin on the junction</legend>
    <label><input type="radio" name={uid + "-block"} value="none" checked /> none</label>
    <label><input type="radio" name={uid + "-block"} value="part" /> part of the junction</label>
    <label><input type="radio" name={uid + "-block"} value="whole" /> the whole junction</label>
  </fieldset>

  <div class="ac-ctl ac-slide">
    <label for={uid + "-act"}>Activity of axon B relative to axon A</label>
    <input id={uid + "-act"} type="range" min="0" max="10" step="1" value="3" data-act />
    <output class="ac-out" data-out for={uid + "-act"}></output>
  </div>

  <p class="ac-verdict" data-verdict role="status"></p>

  <p class="ac-foot">Rule to keep: a synapse is removed when it is less active than synapses near it, not simply when it is silent, so silencing part of a junction removes that part and silencing all of it removes nothing. This is a sketch of the logic in relative units, not to scale.</p>
</figure>

<script>
  const NS = 'http://www.w3.org/2000/svg';
  const N = 10;
  // Who holds each site at the start. The lesson says the outcome could not be predicted from the
  // starting areas, so the start is simply a mixed junction.
  const START: ('A' | 'B')[] = ['A', 'B', 'A', 'B', 'B', 'A', 'A', 'B', 'A', 'B'];
  const PATCH = [3, 4, 5];
  const COL = { A: '#0e7c86', B: '#e57200' };
  const INK = '#4b4b55', FAINT = '#8a8a96';
  function el(name: string, attrs: Record<string, string | number>, text?: string): SVGElement {
    const e = document.createElementNS(NS, name);
    for (const k in attrs) e.setAttribute(k, String(attrs[k]));
    if (text !== undefined) e.textContent = text;
    return e;
  }
  document.querySelectorAll<HTMLElement>('[data-acnmj]').forEach((root) => {
    const stage = root.querySelector<SVGSVGElement>('[data-stage]')!;
    const act = root.querySelector<HTMLInputElement>('[data-act]')!;
    const out = root.querySelector<HTMLElement>('[data-out]')!;
    const verdict = root.querySelector<HTMLElement>('[data-verdict]')!;
    const radios = Array.from(root.querySelectorAll<HTMLInputElement>('input[type="radio"]'));
    const mode = () => radios.find((r) => r.checked)!.value as 'none' | 'part' | 'whole';

    function model(m: 'none' | 'part' | 'whole', v: number) {
      const blocked = START.map((_, i) => m === 'whole' || (m === 'part' && PATCH.includes(i)));
      const rate = { A: 5, B: v };
      // activity at a site: silent if its receptors are blocked, else its axon's activity
      const level = START.map((who, i) => (blocked[i] ? 0 : rate[who]));
      const top = Math.max(...level);
      // a site is lost if it is less active than the busiest site near it (all sites share one junction)
      const lost = level.map((l) => l < top);
      const after: ('A' | 'B' | null)[] = START.map((who, i) => {
        if (!lost[i]) return who;
        if (blocked[i]) return null; // receptors lost, terminal withdrawn, nothing to take over
        return who === 'A' ? 'B' : 'A'; // the other axon spreads into the vacated site
      });
      return { blocked, lost, after, top };
    }

    function draw(m: 'none' | 'part' | 'whole', r: ReturnType<typeof model>) {
      stage.replaceChildren();
      const w = 30, gap = 3, x0 = (360 - (N * w + (N - 1) * gap)) / 2;
      const X = (i: number) => x0 + i * (w + gap);
      // legend
      stage.appendChild(el('rect', { x: 12, y: 8, width: 10, height: 10, rx: 2, fill: COL.A }));
      stage.appendChild(el('text', { x: 26, y: 17, 'font-size': 10, fill: INK }, 'axon A'));
      stage.appendChild(el('rect', { x: 76, y: 8, width: 10, height: 10, rx: 2, fill: COL.B }));
      stage.appendChild(el('text', { x: 90, y: 17, 'font-size': 10, fill: INK }, 'axon B'));
      stage.appendChild(el('rect', { x: 140, y: 8, width: 10, height: 10, rx: 2, fill: '#4b4b55' }));
      stage.appendChild(el('text', { x: 154, y: 17, 'font-size': 10, fill: INK }, 'receptors blocked by toxin'));
      stage.appendChild(el('rect', { x: 292, y: 8, width: 10, height: 10, rx: 2, fill: '#fff', stroke: FAINT, 'stroke-dasharray': '2 2' }));
      stage.appendChild(el('text', { x: 306, y: 17, 'font-size': 10, fill: INK }, 'lost'));

      const row = (y: number, label: string, who: ('A' | 'B' | null)[], start: boolean) => {
        stage.appendChild(el('text', { x: 180, y, 'font-size': 10, 'font-weight': 700, 'text-anchor': 'middle', fill: INK }, label));
        who.forEach((a, i) => {
          const x = X(i), ty = y + 8, ry = y + 34;
          const tox = r.blocked[i] && (start || a !== null);
          if (a === null) {
            stage.appendChild(el('rect', { x, y: ty, width: w, height: 24, rx: 4, fill: '#fff', stroke: FAINT, 'stroke-dasharray': '3 3' }));
            stage.appendChild(el('rect', { x, y: ry, width: w, height: 10, rx: 2, fill: '#fff', stroke: FAINT, 'stroke-dasharray': '3 3' }));
            return;
          }
          stage.appendChild(el('rect', { x, y: ty, width: w, height: 24, rx: 4, fill: COL[a] }));
          stage.appendChild(el('text', { x: x + w / 2, y: ty + 16, 'font-size': 11, 'font-weight': 700, 'text-anchor': 'middle', fill: '#fff' }, a));
          stage.appendChild(el('rect', { x, y: ry, width: w, height: 10, rx: 2, fill: tox ? '#4b4b55' : '#c9c9d2' }));
        });
      };
      row(40, 'start: both axons contact the one endplate', START, true);
      stage.appendChild(el('text', { x: 180, y: 112, 'font-size': 14, 'text-anchor': 'middle', fill: INK }, '↓'));
      row(122, 'weeks later (in this sketch)', r.after, false);

      // the blocked patch marker
      if (m !== 'none') {
        const idx = r.blocked.map((b, i) => (b ? i : -1)).filter((i) => i >= 0);
        const a = X(idx[0]), b = X(idx[idx.length - 1]) + w;
        stage.appendChild(el('line', { x1: a, y1: 90, x2: b, y2: 90, stroke: '#4b4b55', 'stroke-width': 2 }));
        stage.appendChild(el('text', { x: (a + b) / 2, y: 103, 'font-size': 10, 'text-anchor': 'middle', fill: INK }, m === 'whole' ? 'toxin over all receptors' : 'toxin over this patch'));
      }
      // summary count
      const cA = r.after.filter((s) => s === 'A').length, cB = r.after.filter((s) => s === 'B').length;
      stage.appendChild(el('text', { x: 180, y: 192, 'font-size': 10, 'text-anchor': 'middle', fill: INK }, `sites held at the end: axon A ${cA}, axon B ${cB}, lost ${N - cA - cB} (of ${N}, relative units)`));
      stage.appendChild(el('text', { x: 180, y: 210, 'font-size': 10, 'text-anchor': 'middle', fill: FAINT }, 'coloured block: axon terminal; grey bar: receptors under it'));
    }

    function render() {
      const m = mode(), v = Number(act.value);
      const slideOff = m === 'whole';
      act.disabled = slideOff;
      out.textContent = slideOff ? 'not used: every site is silent' : v === 5 ? 'B equal to A' : v < 5 ? (v === 0 ? 'B silent, A active' : 'B quieter than A') : 'B busier than A';
      act.setAttribute('aria-valuetext', out.textContent);
      const r = model(m, v);
      draw(m, r);
      let s: string;
      if (m === 'whole') {
        s = 'Toxin covers every receptor, so every site is equally silent. No site is less active than a neighbour, so nothing marks a loser and no synapse is removed. Blocking the whole junction did not cause elimination.';
      } else {
        const parts: string[] = [];
        if (m === 'part') parts.push('Toxin covers a patch, so those receptors are silent while the sites beside them stay active. The silent patch is the less active part: receptors are lost there and the terminal withdraws from it, long-lasting.');
        if (v === 5) parts.push(m === 'part'
          ? 'In this sketch, outside the patch the two axons are equally active, so nothing else is removed.'
          : 'The two axons are equally active, so this sketch has no rule that marks a loser and shows no change. The lesson does not say what equal activity does in a real junction; it reports only that the outcome could not be predicted from the starting areas.');
        else {
          const loser = v < 5 ? 'B' : 'A', winner = v < 5 ? 'A' : 'B';
          const quiet = v === 0 ? ' Axon B is silent while A is active: the loser is the input that is less active than its neighbour.' : '';
          parts.push(`${m === 'part' ? 'In this sketch, combining the two rules, outside the patch the' : 'In this sketch the'} less active axon ${loser} loses its sites and axon ${winner} typically takes over the ones it leaves; in the time-lapse of two competitors this was the usual outcome, not the only one.${quiet}`);
        }
        s = parts.join(' ');
      }
      verdict.textContent = s;
    }
    act.addEventListener('input', render);
    radios.forEach((r) => r.addEventListener('change', render));
    render();
  });
</script>

<style is:global>
  .ac { padding: var(--ddp-space-3) var(--ddp-space-4) var(--ddp-space-4); margin: var(--ddp-space-5) 0; }
  .ac-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem; font-weight: 600; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); margin-bottom: var(--ddp-space-3); }
  .ac-chip { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 400; color: var(--ddp-color-muted); }
  .ac-svg { display: block; width: 100%; max-width: 600px; margin: 0 auto var(--ddp-space-3); height: auto; background: #fff; border: 1px solid var(--ddp-color-line); border-radius: 6px; }
  .ac-ctl { border: 1px solid var(--ddp-color-line); border-radius: 6px; margin: var(--ddp-space-2) 0; padding: 0.4rem 0.7rem; display: flex; flex-wrap: wrap; gap: 0.2rem 1rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .ac-ctl legend { font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); padding: 0 0.3rem; }
  .ac-ctl input { accent-color: var(--ddp-color-accent); }
  .ac-slide { align-items: center; }
  .ac-slide input[type="range"] { flex: 1 1 8rem; min-width: 8rem; }
  .ac-out { font-family: var(--ddp-font-mono); color: var(--ddp-color-primary); min-width: 12em; }
  .ac-ctl input:focus-visible { outline: 2px solid var(--ddp-color-accent); outline-offset: 2px; }
  .ac-verdict { margin: var(--ddp-space-2) 0; padding: var(--ddp-space-2) var(--ddp-space-3); background: color-mix(in srgb, var(--ddp-color-accent) 8%, transparent); border-radius: 6px; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); min-height: 3em; }
  .ac-foot { margin: var(--ddp-space-3) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); border-left: 3px solid var(--ddp-color-secondary); padding-left: 0.55rem; }
</style>
