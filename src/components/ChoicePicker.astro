---
interface Props { label: string; groupLabel: string; fullWidth?: boolean }
const { label, groupLabel, fullWidth = false } = Astro.props;
---
<details class:list={['stem-picker', { 'full-width': fullWidth }]}>
  <summary><span class="sr-only">{groupLabel}: </span><span data-choice-label>{label}</span></summary>
  <div class="stem-options" role="group" aria-label={groupLabel}><slot /></div>
</details>
<script>
  document.querySelectorAll<HTMLDetailsElement>('.stem-picker').forEach(picker => {
    const summary = picker.querySelector('summary')!;
    const options = picker.querySelector('.stem-options')!;
    picker.addEventListener('keydown', event => {
      if (event.key === 'Escape' && picker.open) {
        picker.open = false;
        summary.focus();
      }
      if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp') return;
      event.preventDefault();
      picker.open = true;
      const buttons = Array.from(options.querySelectorAll<HTMLButtonElement>('button:not([hidden])'));
      const index = buttons.findIndex(button => button === document.activeElement);
      const step = event.key === 'ArrowDown' ? 1 : -1;
      const next = index < 0 ? (step > 0 ? 0 : buttons.length - 1) : (index + step + buttons.length) % buttons.length;
      buttons[next]?.focus();
    });
    document.addEventListener('pointerdown', event => {
      if (!event.composedPath().includes(picker)) picker.open = false;
    });
    // Some browsers blur the summary without focusing the pressed button.
    // Wait for focus to actually land outside so its click can complete.
    document.addEventListener('focusin', event => {
      if (!event.composedPath().includes(picker)) picker.open = false;
    });
  });
</script>
<style>
    .stem-picker { position:relative; display:inline-flex; }
    .stem-picker summary::after { content:''; position:absolute; right:.9rem; top:44%; width:.4rem; height:.4rem; border:solid var(--ddp-color-muted); border-width:0 1.5px 1.5px 0; transform:rotate(45deg); pointer-events:none; }
    .stem-picker summary::-webkit-details-marker { display:none; }
    .stem-picker[open] summary { border-color:var(--ddp-color-accent); }
    .stem-picker[open] summary::after { transform:rotate(225deg); top:49%; }
    .stem-options { position:absolute; z-index:5; inset:calc(100% + .35rem) auto auto 0; min-width:max(100%,10rem); max-height:min(18rem,45vh); overflow-y:auto; overscroll-behavior:contain; padding:.3rem; background:var(--ddp-color-surface); border:1px solid var(--ddp-color-line); border-radius:8px; box-shadow:0 6px 18px rgb(0 0 0 / .14); }
    .stem-options :global(button) { display:flex; justify-content:space-between; gap:1rem; width:100%; text-align:left; padding:.65rem .75rem; border:0; border-radius:5px; background:transparent; color:var(--ddp-color-ink); font:inherit; font-size:var(--ddp-text-sm); cursor:pointer; }
    .stem-options :global(button:hover), .stem-options :global(button:focus-visible), .stem-options :global(button[aria-pressed="true"]) { background:var(--ddp-color-accent-soft); }
    .stem-options :global(button[aria-pressed="true"])::after { content:'✓'; color:var(--ddp-color-accent); }
    .stem-picker summary:focus-visible { outline:2px solid var(--ddp-color-accent); outline-offset:2px; }
    .stem-picker summary { display:flex; align-items:center; list-style:none; box-sizing:border-box; cursor:pointer; min-height:44px; background:var(--ddp-color-surface); color:var(--ddp-color-ink); border:1px solid var(--ddp-color-line); border-radius:var(--ddp-radius-sm,8px); font:inherit; font-size:var(--ddp-text-sm); padding:.5rem 2.25rem .5rem .85rem; }
    .stem-picker.full-width { display:block; width:100%; margin-block:.75rem; }
    .full-width .stem-options { inset-inline:0; min-width:0; }
</style>
