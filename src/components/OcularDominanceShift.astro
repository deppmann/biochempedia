---
/**
 * OcularDominanceShift — choose which eyes are closed (none, one, both) and when (inside or
 * after the sensitive period) and read the ocular-dominance histogram on the seven-group
 * scale, recorded in the left hemisphere of a kitten whose right eye is the one closed.
 * Rules, all from the ocular-dominance lesson: one-eye closure inside the window leaves few
 * cells the closed eye can drive and moves the histogram to the open eye (group 7 here);
 * the same closure in an adult cat leaves the cortex looking normal; closing both eyes for
 * the same weeks does far less harm to each eye's share (many cells still respond to each
 * eye, a share abnormal or unresponsive). Cell counts are illustrative relative units.
 * Self-contained vanilla-TS Astro island. Original.
 */
---

<figure class="od card" data-ocdom>
  <figcaption class="od-head">Ocular dominance: close an eye, read the histogram<span class="od-chip">⚙ original · interactive</span></figcaption>

  <svg class="od-svg" viewBox="0 0 360 214" role="img" aria-label="Ocular-dominance histogram on the seven-group scale for the chosen closure" data-plot></svg>

  <div class="od-controls">
    <fieldset class="od-field">
      <legend>Which eyes are closed</legend>
      <label><input type="radio" name="od-eyes" value="none" checked /> neither</label>
      <label><input type="radio" name="od-eyes" value="one" /> one eye (the right)</label>
      <label><input type="radio" name="od-eyes" value="both" /> both eyes</label>
    </fieldset>
    <fieldset class="od-field">
      <legend>When the closure happens</legend>
      <label><input type="radio" name="od-age" value="in" checked /> inside the sensitive period (kitten)</label>
      <label><input type="radio" name="od-age" value="out" /> after it (adult cat)</label>
    </fieldset>
  </div>

  <p class="od-verdict" data-verdict role="status"></p>

  <p class="od-foot">The closed eye loses cortical cells mainly to the open eye's advantage and, in the lesson's data, little once the window has passed; closing both eyes removes that advantage. Bar heights are relative units, a sketch of the logic rather than measured counts.</p>
</figure>

<script>
  const NS = 'http://www.w3.org/2000/svg';
  type Eyes = 'none' | 'one' | 'both';
  type Age = 'in' | 'out';
  // Illustrative relative units (percent of cells recorded), groups 1..7, left hemisphere.
  const NORMAL = [12, 20, 22, 18, 14, 9, 5]; // hump, leaning to the contralateral side
  const ONE_IN = [1, 2, 3, 6, 12, 26, 50];   // shifted to the open (ipsilateral) eye
  const BOTH_IN = [12, 12, 12, 12, 12, 12, 12]; // drawn flat: the lesson gives no shape, only that many cells still respond to each eye
  const BOTH_ABN = 14;                         // a share abnormal or unresponsive
  const GROUP_NOTE = ['contra only', '', '', 'equal', '', '', 'ipsi only'];
  function el(name: string, attrs: Record<string, string | number>, text?: string): SVGElement {
    const e = document.createElementNS(NS, name);
    for (const k in attrs) e.setAttribute(k, String(attrs[k]));
    if (text !== undefined) e.textContent = text;
    return e;
  }
  document.querySelectorAll<HTMLElement>('[data-ocdom]').forEach((root) => {
    const plot = root.querySelector<SVGSVGElement>('[data-plot]')!;
    const verdict = root.querySelector<HTMLElement>('[data-verdict]')!;
    const val = (name: string) => root.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`)!.value;

    function draw(bars: number[] | null, abn: number) {
      plot.replaceChildren();
      const INK = '#4b4b55', FAINT = '#5a5a66';
      const x0 = 40, y0 = 150, w = 34, gap = 6, hMax = 110, scale = hMax / 50;
      plot.appendChild(el('text', { x: 10, y: 14, 'font-size': 9, fill: INK }, 'cells (relative units)'));
      plot.appendChild(el('text', { x: 350, y: 14, 'font-size': 9, 'text-anchor': 'end', fill: INK }, 'recorded in the left hemisphere'));
      plot.appendChild(el('line', { x1: x0 - 4, y1: y0, x2: 350, y2: y0, stroke: INK, 'stroke-width': 1 }));
      if (!bars) {
        plot.appendChild(el('text', { x: 195, y: 90, 'font-size': 11, 'text-anchor': 'middle', fill: INK }, 'no histogram drawn for this case'));
      }
      (bars || []).forEach((v, i) => {
        const x = x0 + i * (w + gap), h = v * scale;
        const colour = i === 6 ? '#e57200' : i === 0 ? '#0e7c86' : '#7a7a88';
        plot.appendChild(el('rect', { x, y: y0 - h, width: w, height: h, rx: 2, fill: colour, }));
        plot.appendChild(el('text', { x: x + w / 2, y: y0 + 13, 'font-size': 10, 'text-anchor': 'middle', 'font-weight': 700, fill: INK }, String(i + 1)));
        if (GROUP_NOTE[i]) plot.appendChild(el('text', { x: x + w / 2, y: y0 + 25, 'font-size': 9, 'text-anchor': 'middle', fill: INK }, GROUP_NOTE[i]));
      });
      plot.appendChild(el('text', { x: x0, y: y0 + 42, 'font-size': 9, fill: INK }, 'ocular-dominance group (1 = contralateral eye only,'));
      plot.appendChild(el('text', { x: x0, y: y0 + 54, 'font-size': 9, fill: INK }, '7 = ipsilateral eye only)'));
      if (abn > 0) {
        plot.appendChild(el('rect', { x: 250, y: 22, width: 96, height: 18, rx: 3, fill: '#fff', stroke: FAINT, 'stroke-dasharray': '3 2' }));
        plot.appendChild(el('rect', { x: 256, y: 26, width: 10, height: 10, fill: '#b04a4a' }));
        plot.appendChild(el('text', { x: 272, y: 35, 'font-size': 9, fill: INK }, 'abnormal share'));
      }
    }
    function render() {
      const eyes = val('od-eyes') as Eyes, age = val('od-age') as Age;
      let bars: number[] | null = NORMAL, abn = 0, v: string;
      if (eyes === 'none') {
        v = 'Neither eye is closed. In a normal cat most cells sit in the middle groups, and the hump leans toward the contralateral side.';
      } else if (eyes === 'one' && age === 'in') {
        bars = ONE_IN;
        v = 'One eye closed during the sensitive period (a few days to weeks in a kitten): few cells can be driven by the closed right eye, so the histogram moves toward the open eye, group 7. The closed eye lost cells mainly to the open eye\'s advantage.';
      } else if (eyes === 'one') {
        v = 'One eye closed in an adult cat, even for months: the cortex looks normal. The same closure does little once the window has passed, and that does not mean the adult cortex cannot change in any way.';
      } else if (age === 'in') {
        bars = BOTH_IN; abn = BOTH_ABN;
        v = 'Both eyes closed for the same weeks: many cells still respond to each eye, though a share are abnormal or unresponsive. Neither eye has an advantage, so there is far less imbalance than after closing one eye. Disuse alone would have predicted a large loss. Equal bar heights are a sketch; the lesson gives no shape.';
      } else {
        bars = null;
        v = 'Both eyes closed after the sensitive period: The lesson gives no result for this case, so no histogram is drawn.';
      }
      draw(bars, abn);
      verdict.textContent = v;
    }
    root.querySelectorAll('input').forEach((i) => i.addEventListener('change', render));
    render();
  });
</script>

<style is:global>
  .od { padding: var(--ddp-space-3) var(--ddp-space-4) var(--ddp-space-4); margin: var(--ddp-space-5) 0; }
  .od-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem; font-weight: 600; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); margin-bottom: var(--ddp-space-3); }
  .od-chip { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 400; color: var(--ddp-color-muted); }
  .od-svg { display: block; width: 100%; max-width: 600px; margin: 0 auto var(--ddp-space-3); height: auto; background: #fff; border: 1px solid var(--ddp-color-line); border-radius: 6px; }
  .od-controls { display: grid; grid-template-columns: 1fr 1fr; gap: var(--ddp-space-3); }
  .od-field { border: 1px solid var(--ddp-color-line); border-radius: 6px; margin: 0; padding: 0.4rem 0.7rem; display: flex; flex-direction: column; gap: 0.2rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .od-field legend { font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); padding: 0 0.3rem; }
  .od-field input { accent-color: var(--ddp-color-accent); }
  .od-verdict { margin: var(--ddp-space-3) 0 var(--ddp-space-2); padding: var(--ddp-space-2) var(--ddp-space-3); background: color-mix(in srgb, var(--ddp-color-accent) 8%, transparent); border-radius: 6px; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); min-height: 4.5em; }
  .od-foot { margin: var(--ddp-space-3) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); border-left: 3px solid var(--ddp-color-secondary); padding-left: 0.55rem; }
  @media (max-width: 520px) { .od-controls { grid-template-columns: 1fr; } }
</style>
