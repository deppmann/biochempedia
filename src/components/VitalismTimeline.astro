---
/**
 * VitalismTimeline — the 70-year retreat of the vital force. The textbook opens by granting that
 * life is chemistry; this island shows that the grant was won slowly, one synthesis at a time.
 * Click along the row from 1828 to 1897 and watch a three-row checklist fill in: where life was
 * taken out (making a molecule, its starting materials, a whole process) and how we know it was
 * gone. The teaching point lives in the gaps: Wöhler's urea did NOT kill vitalism — his cyanate
 * came from blood and horn — and even after Buchner one hatch stayed open until 1969.
 * Self-contained vanilla-TS Astro island. Original.
 */
---

<figure class="vtl card" data-vitaltimeline>
  <figcaption class="vtl-head">The 70-year retreat of the vital force<span class="vtl-chip">⚙ original · interactive</span></figcaption>

  <svg class="vtl-svg" viewBox="0 0 460 84" role="img" aria-label="Timeline drawn to scale from 1828 to 1897: 17 years from Wöhler to Kolbe, 9 more to Berthelot, then a 43-year gap to Buchner. Use the buttons below to step through it." data-svg></svg>

  <div class="vtl-nodes" data-nodes role="group" aria-label="Choose a synthesis to view"></div>

  {/* Static dots match Wöhler (the first node) so the panel reads right before JS runs. */}
  <div class="vtl-out">
    <span class="vtl-out-label">Life taken out of:</span>
    <ul class="vtl-out-list">
      <li><span class="vtl-dot" aria-hidden="true" data-out="0" data-state="yes"></span><span>making a molecule</span><em class="vtl-out-word" data-out-word="0">yes</em></li>
      <li><span class="vtl-dot" aria-hidden="true" data-out="1" data-state="no"></span><span>its starting materials</span><em class="vtl-out-word" data-out-word="1">no</em></li>
      <li><span class="vtl-dot" aria-hidden="true" data-out="2" data-state="no"></span><span>a whole process</span><em class="vtl-out-word" data-out-word="2">no</em></li>
    </ul>
  </div>

  <div class="vtl-detail" role="status">
    <div class="vtl-d-head">
      <span class="vtl-d-year" data-year>1828</span>
      <span class="vtl-d-who" data-who>Friedrich Wöhler</span>
    </div>
    <p class="vtl-d-made" data-made></p>
    <div class="vtl-d-grid">
      <div class="vtl-d-cell vtl-proof">
        <span class="vtl-d-cell-tag">How we know it is gone</span>
        <span class="vtl-d-cell-txt" data-proof></span>
      </div>
      <div class="vtl-d-cell vtl-remaining">
        <span class="vtl-d-cell-tag">Escape hatch left</span>
        <span class="vtl-d-cell-txt" data-remaining></span>
      </div>
    </div>
  </div>

  <p class="vtl-foot">Vitalism was not refuted in one afternoon. It was a fighting retreat across seventy years — each synthesis pried the vital force out of one more hiding place, until Buchner's cell-free ferment left it nowhere to stand in the chemistry of the cell. Once you grant that life is chemistry, the rest of biochemistry becomes possible: you can lift the machinery out of the cell and study it one reaction at a time.</p>
</figure>

<script>
  const ACCENT = '#0e7c86', NAVY = '#232d4b', ORANGE = '#e57200', FAINT = '#b9b9c2', INK = '#4b4b55';
  const SVGNS = 'http://www.w3.org/2000/svg';
  function el(name: string, attrs: Record<string, string | number>): SVGElement {
    const e = document.createElementNS(SVGNS, name);
    for (const k in attrs) e.setAttribute(k, String(attrs[k]));
    return e;
  }
  type Out = 'yes' | 'partial' | 'no';
  // out = [making a molecule, its starting materials, a whole process]
  type Node = { year: string; who: string; made: string; out: Out[]; proof: string; remaining: string };
  // Strings are trusted, static HTML (only <strong>/<em>), written for innerHTML.
  const NODES: Node[] = [
    {
      year: '1828', who: 'Friedrich Wöhler',
      made: 'Evaporated a solution meant to hold ammonium cyanate and got <strong>urea</strong> crystals, with no kidney in the room.',
      out: ['yes', 'no', 'no'],
      proof: 'No organism in the flask — but the cyanate was made from blood, horn and hoof.',
      remaining: '"Your cyanate came from blood and horn." Most chemists, Berzelius included, read it as isomerism, not a refutation.',
    },
    {
      year: '1845', who: 'Hermann Kolbe',
      made: 'Built <strong>acetic acid</strong> up from carbon disulfide (charcoal plus sulfur), finishing with a battery, not a cell.',
      out: ['yes', 'yes', 'no'],
      proof: 'Started from charcoal and sulfur, counted as elements (charcoal is usually from wood); finished with a battery.',
      remaining: '"A process still needs a living cell."',
    },
    {
      year: '1854', who: 'Marcellin Berthelot',
      made: 'Rejoined glycerol and fatty acids into <strong>fats</strong> by reversible ester-bond chemistry, the same equilibrium rules as the mineral world.',
      out: ['yes', 'partial', 'no'],
      proof: 'Life out of the joining step; the glycerol and fatty acids still came from natural fat.',
      remaining: '"Your parts came from fat" (answered in principle by Kolbe). And the process hatch is still open: Pasteur’s stand.',
    },
    {
      year: '1897', who: 'Eduard Buchner',
      made: 'Yeast ground with sand and pressed gave a juice with almost no cells; sugar added to it <strong>fermented</strong>. He named the agent zymase.',
      out: ['yes', 'yes', 'yes'],
      proof: 'A sterile filter that holds back every cell, and chloroform, an antiseptic: it still fermented. (Warming could not decide.)',
      remaining: '"The zymase was made by yeast." Closed in 1969 by building an enzyme (ribonuclease A) from amino acids with no cell.',
    },
  ];

  // Time axis drawn to scale, so the long wait before Buchner is visible at a glance.
  const Y0 = 1824, Y1 = 1901, AX0 = 24, AX1 = 436;
  const xOf = (yr: number) => AX0 + ((yr - Y0) / (Y1 - Y0)) * (AX1 - AX0);
  const XS = NODES.map((n) => xOf(parseInt(n.year, 10)));

  function draw(svg: SVGElement, sel: number) {
    while (svg.firstChild) svg.removeChild(svg.firstChild);
    const y = 38;
    // baseline track with faint decade ticks
    svg.appendChild(el('line', { x1: AX0, y1: y, x2: AX1, y2: y, stroke: FAINT, 'stroke-width': 3, 'stroke-linecap': 'round' }));
    for (let d = 1830; d <= 1900; d += 10) {
      svg.appendChild(el('line', { x1: xOf(d), y1: y + 5, x2: xOf(d), y2: y + 9, stroke: FAINT, 'stroke-width': 1.2 }));
    }
    // progress line up to the selected node
    svg.appendChild(el('line', { x1: XS[0], y1: y, x2: XS[sel], y2: y, stroke: ACCENT, 'stroke-width': 3, 'stroke-linecap': 'round' }));
    // gap brackets: how many years each retreat took
    for (let i = 1; i < NODES.length; i++) {
      const a = XS[i - 1], b = XS[i], gy = y + 22;
      const yrs = parseInt(NODES[i].year, 10) - parseInt(NODES[i - 1].year, 10);
      const done = i <= sel;
      svg.appendChild(el('path', { d: `M${a + 4} ${gy - 4} V${gy} H${b - 4} V${gy - 4}`, fill: 'none', stroke: done ? ACCENT : FAINT, 'stroke-width': 1.2 }));
      const t = el('text', { x: (a + b) / 2, y: gy + 14, 'text-anchor': 'middle', fill: done ? INK : '#8a8a93', 'font-size': 12, 'font-family': 'Inter, system-ui, sans-serif' });
      t.textContent = `${yrs} yr`;
      svg.appendChild(t);
    }
    NODES.forEach((node, i) => {
      const active = i === sel;
      const r = active ? 10 : 7;
      svg.appendChild(el('circle', { cx: XS[i], cy: y, r, fill: active ? ORANGE : (i < sel ? ACCENT : '#fff'), stroke: active ? ORANGE : (i <= sel ? ACCENT : FAINT), 'stroke-width': 2 }));
      // 1845 and 1854 sit close together: nudge their labels apart so they never touch
      const dx = i === 1 ? -8 : i === 2 ? 8 : 0;
      const yr = el('text', { x: XS[i] + dx, y: y - 17, 'text-anchor': 'middle', fill: active ? NAVY : INK, 'font-size': active ? 15 : 13, 'font-weight': active ? 700 : 500, 'font-family': 'ui-monospace, SFMono-Regular, Menlo, monospace' });
      yr.textContent = node.year; svg.appendChild(yr);
    });
  }

  document.querySelectorAll<HTMLElement>('[data-vitaltimeline]').forEach((root) => {
    const svg = root.querySelector('[data-svg]') as unknown as SVGElement;
    const dotEls = Array.from(root.querySelectorAll<HTMLElement>('[data-out]'));
    const wordEls = Array.from(root.querySelectorAll<HTMLElement>('[data-out-word]'));
    const yearEl = root.querySelector<HTMLElement>('[data-year]')!;
    const whoEl = root.querySelector<HTMLElement>('[data-who]')!;
    const madeEl = root.querySelector<HTMLElement>('[data-made]')!;
    const proofEl = root.querySelector<HTMLElement>('[data-proof]')!;
    const remainingEl = root.querySelector<HTMLElement>('[data-remaining]')!;
    const nodesWrap = root.querySelector<HTMLElement>('[data-nodes]')!;
    let sel = 0;
    // Keyboard- and screen-reader-accessible controls (the SVG click is a visual shortcut).
    NODES.forEach((n, i) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'vtl-node-btn';
      b.setAttribute('data-node-btn', String(i));
      b.innerHTML = `<b>${n.year}</b><span>${n.who.split(' ').slice(-1)[0]}</span>`;
      b.addEventListener('click', () => { sel = i; render(); });
      nodesWrap.appendChild(b);
    });
    const nodeBtns = Array.from(nodesWrap.querySelectorAll<HTMLButtonElement>('[data-node-btn]'));
    function render() {
      const node = NODES[sel];
      nodeBtns.forEach((b, i) => b.setAttribute('aria-pressed', String(i === sel)));
      const WORD: Record<Out, string> = { yes: 'yes', partial: 'partly', no: 'no' };
      node.out.forEach((o, i) => {
        if (dotEls[i]) dotEls[i].setAttribute('data-state', o);
        if (wordEls[i]) wordEls[i].textContent = WORD[o];
      });
      yearEl.textContent = node.year;
      whoEl.textContent = node.who;
      madeEl.innerHTML = node.made;
      proofEl.innerHTML = node.proof;
      remainingEl.innerHTML = node.remaining;
      draw(svg, sel);
    }
    svg.addEventListener('click', (ev: MouseEvent) => {
      const rect = svg.getBoundingClientRect();
      const fx = ((ev.clientX - rect.left) / rect.width) * 460;
      let best = 0, bestD = Infinity;
      XS.forEach((cx, i) => { const d = Math.abs(cx - fx); if (d < bestD) { bestD = d; best = i; } });
      sel = best; render();
    });
    render();
  });
</script>

<style is:global>
  .vtl { padding: var(--ddp-space-3) var(--ddp-space-4) var(--ddp-space-4); margin: var(--ddp-space-5) 0; }
  .vtl-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem; font-weight: 600; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); margin-bottom: var(--ddp-space-2); }
  .vtl-chip { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 400; color: var(--ddp-color-muted); }
  .vtl-svg { width: 100%; height: auto; display: block; background: color-mix(in srgb, var(--ddp-color-accent) 5%, #fff); border: 1px solid var(--ddp-color-line); border-radius: 8px; margin-bottom: var(--ddp-space-3); cursor: pointer; }
  .vtl-nodes { display: flex; flex-wrap: wrap; gap: 0.3rem; margin-bottom: var(--ddp-space-3); }
  .vtl-node-btn { display: flex; flex-direction: column; align-items: center; gap: 0.05rem; flex: 1; min-width: 64px; font-family: inherit; border: 1px solid var(--ddp-color-line); background: #fff; color: var(--ddp-color-ink-soft); border-radius: 6px; padding: 0.3rem 0.4rem; cursor: pointer; }
  .vtl-node-btn b { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); }
  .vtl-node-btn span { font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .vtl-node-btn:hover { border-color: var(--ddp-color-accent); }
  .vtl-node-btn:focus-visible { outline: 2px solid var(--ddp-color-accent); outline-offset: 2px; }
  .vtl-node-btn[aria-pressed='true'] { border-color: var(--ddp-color-accent); background: color-mix(in srgb, var(--ddp-color-accent) 12%, #fff); }
  .vtl-node-btn[aria-pressed='true'] b { color: var(--ddp-color-accent); }
  .vtl-out { margin-bottom: var(--ddp-space-3); }
  .vtl-out-label { display: block; font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); margin-bottom: var(--ddp-space-1); }
  .vtl-out-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.25rem; }
  .vtl-out-list li { display: flex; align-items: center; gap: 0.5rem; font-size: var(--ddp-text-sm); color: var(--ddp-color-ink-soft); margin: 0; }
  .vtl-dot { flex: none; width: 14px; height: 14px; border-radius: 50%; border: 2px solid var(--ddp-color-accent); background: #fff; }
  .vtl-dot[data-state='yes'] { background: var(--ddp-color-accent); }
  .vtl-dot[data-state='partial'] { background: linear-gradient(90deg, var(--ddp-color-accent) 50%, #fff 50%); }
  .vtl-out-word { margin-left: auto; font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-style: normal; color: var(--ddp-color-muted); }
  .vtl .vtl-d-cell-txt strong, .vtl .vtl-d-made strong { color: var(--ddp-color-primary); }
  .vtl-detail { border: 1px solid var(--ddp-color-line); border-radius: var(--ddp-radius-sm); padding: var(--ddp-space-3); margin-bottom: var(--ddp-space-3); }
  .vtl-d-head { display: flex; align-items: baseline; gap: 0.5rem; margin-bottom: var(--ddp-space-2); }
  .vtl-d-year { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-lg); font-weight: 700; color: var(--ddp-color-secondary-ink); }
  .vtl-d-who { font-size: var(--ddp-text-lg); font-weight: 700; color: var(--ddp-color-primary); }
  .vtl .vtl-d-made { margin: 0 0 var(--ddp-space-3); font-size: var(--ddp-text-sm); color: var(--ddp-color-ink-soft); line-height: 1.5; }
  .vtl-d-grid { display: grid; grid-template-columns: 1fr; gap: var(--ddp-space-2); }
  @media (min-width: 560px) { .vtl-d-grid { grid-template-columns: 1fr 1fr; } }
  .vtl-d-cell { border-radius: 6px; padding: var(--ddp-space-2) var(--ddp-space-3); display: flex; flex-direction: column; gap: 0.25rem; }
  .vtl-proof { background: color-mix(in srgb, var(--ddp-color-accent) 8%, transparent); border-left: 3px solid var(--ddp-color-accent); }
  .vtl-remaining { background: color-mix(in srgb, var(--ddp-color-secondary) 8%, transparent); border-left: 3px solid var(--ddp-color-secondary); }
  .vtl-d-cell-tag { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); text-transform: uppercase; letter-spacing: 0.04em; color: var(--ddp-color-muted); }
  .vtl-d-cell-txt { font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); line-height: 1.5; }
  .vtl .vtl-foot { margin: var(--ddp-space-3) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); border-left: 3px solid var(--ddp-color-secondary); padding-left: 0.55rem; }
</style>
