---
/**
 * ReafferenceCancelMeter — one head turn, three conditions. A canal afferent's modulation is
 * drawn the same in all three; a central vestibular-only neuron's modulation is
 * sensitivity x peak head velocity, with the lesson's made-up sensitivities (passive 2.0,
 * matched active 0.2, mismatched: moving back toward 2.0, drawn as a range). Original.
 */
---

<figure class="rcm card" data-rcm>
  <figcaption class="rcm-head">Cancelling your own head turn, conditionally<span class="rcm-chip">⚙ original · interactive</span></figcaption>

  <svg class="rcm-svg" viewBox="0 0 340 332" role="img" aria-label="Three stacked plots against relative time: a schematic head-turn velocity profile, a canal afferent's modulation, and a central vestibular-only neuron's modulation" data-plot></svg>

  <div class="rcm-controls">
    <label class="rcm-slabel"><span>Peak head velocity <em data-out-v>20</em> deg/s</span>
      <input type="range" data-in-v min="5" max="40" step="1" value="20" />
    </label>
    <fieldset class="rcm-set">
      <legend>Condition</legend>
      <label class="rcm-opt"><input type="radio" name="rcm-cond" value="passive" checked /> Passive turn</label>
      <label class="rcm-opt"><input type="radio" name="rcm-cond" value="matched" /> Active turn, neck feedback matches the prediction</label>
      <label class="rcm-opt"><input type="radio" name="rcm-cond" value="mismatch" /> Active turn, neck feedback made to mismatch</label>
    </fieldset>
  </div>

  <dl class="rcm-readout">
    <div><dt>Canal afferent modulation</dt><dd data-r-aff>drawn the same in all conditions</dd></div>
    <div><dt>Central sensitivity (spikes/s per deg/s)</dt><dd data-r-s>2.0</dd></div>
    <div><dt>Central modulation (spikes/s)</dt><dd data-r-mod>40</dd></div>
    <div><dt>Percent cancelled = 1 − S<sub>active</sub>/S<sub>passive</sub></dt><dd data-r-pct>0</dd></div>
  </dl>
  <p class="rcm-arith" data-arith></p>
  <p class="rcm-why" data-why role="status"></p>

  <p class="rcm-assume">In this sketch: linear sensitivity (modulation = sensitivity × peak head velocity), relative timing, other velocities scaled by this sketch, and the afferent drawn in relative units because the lesson gives it no value. The numbers are the lesson’s made-up illustration, not data. The cancellation rule is from Roy and Cullen (2004), vestibular-only neurons in four alert macaques.</p>
  <p class="rcm-foot">Rule to keep: in the neurons tested, cancellation needed neck feedback that matched the motor-command prediction. It is not the periphery switching off, it does not locate the comparator, it is not shown for every vestibular neuron, and it is not unconditional.</p>
</figure>

<script>
  const NS = 'http://www.w3.org/2000/svg';
  const ACCENT = '#0e7c86', ORANGE = '#e57200', INK = '#4b4b55', FAINT = '#9a9aa6', GREY = '#6b6b78';
  function el(name: string, attrs: Record<string, string | number>): SVGElement {
    const e = document.createElementNS(NS, name);
    for (const k in attrs) e.setAttribute(k, String(attrs[k]));
    return e;
  }
  const S_PASSIVE = 2.0, S_MATCHED = 0.2;
  type Cond = 'passive' | 'matched' | 'mismatch';

  document.querySelectorAll<HTMLElement>('[data-rcm]').forEach((root) => {
    const plot = root.querySelector<SVGSVGElement>('[data-plot]');
    const vIn = root.querySelector<HTMLInputElement>('[data-in-v]');
    const vOut = root.querySelector<HTMLElement>('[data-out-v]');
    const rAff = root.querySelector<HTMLElement>('[data-r-aff]');
    const rS = root.querySelector<HTMLElement>('[data-r-s]');
    const rMod = root.querySelector<HTMLElement>('[data-r-mod]');
    const rPct = root.querySelector<HTMLElement>('[data-r-pct]');
    const arith = root.querySelector<HTMLElement>('[data-arith]');
    const why = root.querySelector<HTMLElement>('[data-why]');
    const radios = Array.from(root.querySelectorAll<HTMLInputElement>('input[name="rcm-cond"]'));
    if (!plot || !vIn || !vOut || !rAff || !rS || !rMod || !rPct || !arith || !why || radios.length !== 3) return;

    const X0 = 44, X1 = 326, N = 60;
    const px = (t: number) => X0 + t * (X1 - X0);
    const prof = (t: number) => Math.sin(Math.PI * t); // schematic bell-shaped speed profile
    // panel A (head velocity, 0..40 deg/s), B (afferent, relative), C (central, 0..80 spikes/s)
    const A_TOP = 24, A_BASE = 94, B_TOP = 126, B_BASE = 172, C_TOP = 206, C_BASE = 286;
    const ya = (v: number) => A_BASE - (v / 40) * (A_BASE - A_TOP);
    const yb = (a: number) => B_BASE - a * (B_BASE - B_TOP);
    const yc = (m: number) => C_BASE - (m / 80) * (C_BASE - C_TOP);

    function txt(x: number, y: number, s: string, opts: Record<string, string | number> = {}) {
      const t = el('text', { x, y, 'font-size': 10, fill: INK, ...opts });
      t.textContent = s;
      plot!.appendChild(t);
    }
    function path(fn: (t: number) => number, yf: (v: number) => number, extra: Record<string, string | number>) {
      let d = '';
      for (let i = 0; i <= N; i++) { const t = i / N; d += (i ? 'L' : 'M') + px(t).toFixed(1) + ' ' + yf(fn(t)).toFixed(1) + ' '; }
      plot!.appendChild(el('path', { d: d.trim(), fill: 'none', ...extra }));
    }
    function axes(top: number, base: number, ticks: Array<[number, string]>, yf: (v: number) => number) {
      plot!.appendChild(el('line', { x1: X0, y1: top, x2: X0, y2: base, stroke: INK, 'stroke-width': 1 }));
      plot!.appendChild(el('line', { x1: X0, y1: base, x2: X1, y2: base, stroke: INK, 'stroke-width': 1 }));
      for (const [v, lab] of ticks) {
        if (v > 0) plot!.appendChild(el('line', { x1: X0, y1: yf(v), x2: X1, y2: yf(v), stroke: '#d4d4da', 'stroke-width': 0.7, 'stroke-dasharray': '2 3' }));
        txt(X0 - 4, yf(v) + 3, lab, { 'text-anchor': 'end', 'font-size': 9 });
      }
    }

    function render() {
      const V = parseInt(vIn!.value, 10);
      const cond = (radios.find((r) => r.checked)?.value ?? 'passive') as Cond;
      vOut!.textContent = String(V);
      plot!.replaceChildren();

      // Panel A: the head turn (same in every condition)
      txt(X0, 14, 'Head turn: velocity (deg/s), same in all 3', { 'font-weight': 700 });
      axes(A_TOP, A_BASE, [[0, '0'], [20, '20'], [40, '40']], ya);
      path((t) => V * prof(t), ya, { stroke: GREY, 'stroke-width': 2.4 });

      // Panel B: canal afferent, drawn the same in all three conditions
      txt(X0, 118, 'Canal afferent: modulation (relative units)', { 'font-weight': 700 });
      axes(B_TOP, B_BASE, [[0, '0']], (a) => yb(a));
      path((t) => (V / 40) * prof(t), (a) => yb(a), { stroke: ACCENT, 'stroke-width': 2.4 });

      // Panel C: central vestibular-only neuron
      txt(X0, 198, 'Central vestibular-only neuron (spikes/s)', { 'font-weight': 700 });
      axes(C_TOP, C_BASE, [[0, '0'], [40, '40'], [80, '80']], yc);
      const sPassive = S_PASSIVE * V, sMatched = S_MATCHED * V;
      // passive reference, dashed, under the condition's own trace
      if (cond !== 'passive') path((t) => sPassive * prof(t), yc, { stroke: FAINT, 'stroke-width': 1.6, 'stroke-dasharray': '4 3' });
      if (cond === 'mismatch') {
        // shaded range between S = 0.2 and S = 2.0, not a fixed value
        let d = '';
        for (let i = 0; i <= N; i++) { const t = i / N; d += (i ? 'L' : 'M') + px(t).toFixed(1) + ' ' + yc(sPassive * prof(t)).toFixed(1) + ' '; }
        for (let i = N; i >= 0; i--) { const t = i / N; d += 'L' + px(t).toFixed(1) + ' ' + yc(sMatched * prof(t)).toFixed(1) + ' '; }
        plot!.appendChild(el('path', { d: d + 'Z', fill: ORANGE, 'fill-opacity': 0.18, stroke: 'none' }));
        path((t) => sMatched * prof(t), yc, { stroke: ORANGE, 'stroke-width': 1.6, 'stroke-dasharray': '2 2' });
        // arrow at the peak from S = 0.2 toward S = 2.0
        const ax = px(0.5), ay0 = yc(sMatched) - 3, ay1 = yc(sPassive) + 7;
        if (ay0 - ay1 > 2) {
          plot!.appendChild(el('line', { x1: ax, y1: ay0, x2: ax, y2: ay1, stroke: ORANGE, 'stroke-width': 2 }));
          plot!.appendChild(el('path', { d: `M${ax - 4} ${ay1 + 6} L${ax} ${ay1} L${ax + 4} ${ay1 + 6}`, fill: 'none', stroke: ORANGE, 'stroke-width': 2 }));
        }
      } else {
        path((t) => (cond === 'passive' ? sPassive : sMatched) * prof(t), yc, { stroke: ACCENT, 'stroke-width': 2.6 });
      }
      txt((X0 + X1) / 2, 301, 'time (relative units, not to scale)', { 'text-anchor': 'middle', 'font-size': 9 });
      // legend row (fixed place, below the plot)
      const LY = 318;
      plot!.appendChild(el('line', { x1: X0, y1: LY - 3, x2: X0 + 16, y2: LY - 3, stroke: ACCENT, 'stroke-width': 2.6 }));
      txt(X0 + 20, LY, cond === 'mismatch' ? 'canal afferent' : 'this condition', { 'font-size': 9 });
      if (cond !== 'passive') {
        const gx = 200;
        plot!.appendChild(el('line', { x1: gx, y1: LY - 3, x2: gx + 16, y2: LY - 3, stroke: FAINT, 'stroke-width': 1.6, 'stroke-dasharray': '4 3' }));
        txt(gx + 20, LY, 'passive reference', { 'font-size': 9 });
      }
      if (cond === 'mismatch') {
        plot!.appendChild(el('rect', { x: X0, y: LY + 5, width: 16, height: 8, fill: ORANGE, 'fill-opacity': 0.3 }));
        txt(X0 + 20, LY + 12, 'range: S from 0.2 toward 2.0', { 'font-size': 9 });
      }

      // readouts
      rAff!.textContent = 'drawn the same in all conditions';
      if (cond === 'passive') {
        rS!.textContent = S_PASSIVE.toFixed(1);
        rMod!.textContent = String(sPassive);
        rPct!.textContent = '0 (reference)';
        arith!.textContent = `${S_PASSIVE.toFixed(1)} × ${V} deg/s = ${sPassive} spikes/s`;
        why!.textContent = `Passive turn: the head is moved for the animal. In the lesson’s made-up numbers, sensitivity 2.0 spikes/s per deg/s at ${V} deg/s gives ${sPassive} spikes/s of modulation in the central neuron${V === 20 ? ', the 40 spikes/s of its illustration' : ''}. The canal afferents respond to an active turn as they do to a passive one (Cullen and Minor, 2002), so the sketch draws their trace the same in the other two conditions.`;
      } else if (cond === 'matched') {
        rS!.textContent = S_MATCHED.toFixed(1);
        rMod!.textContent = String(sMatched.toFixed(1)).replace(/\.0$/, '');
        rPct!.textContent = '90';
        arith!.textContent = `${S_MATCHED.toFixed(1)} × ${V} deg/s = ${sMatched.toFixed(1).replace(/\.0$/, '')} spikes/s; 1 − 0.2/2.0 = 0.90, so 90 percent cancelled at any velocity in this linear sketch`;
        why!.textContent = `Active turn with matching neck feedback: sensitivity 0.2, so ${sMatched.toFixed(1).replace(/\.0$/, '')} spikes/s, 90 percent cancelled. The canal afferents respond to the active turn as they do to a passive one (Cullen and Minor, 2002), so the periphery has not switched off; in the neurons tested, cancellation required neck proprioceptive activation that matched the feedback expected from the motor command.`;
      } else {
        rS!.textContent = '0.2 toward 2.0';
        rMod!.textContent = `${sMatched.toFixed(1).replace(/\.0$/, '')} up toward ${sPassive}`;
        rPct!.textContent = '90 down toward 0 (a range)';
        arith!.textContent = `S between 0.2 and 2.0: ${sMatched.toFixed(1).replace(/\.0$/, '')} up toward ${sPassive} spikes/s; no single value is given`;
        why!.textContent = 'Active turn with neck feedback made to mismatch the prediction: the cancellation failed in the neurons tested, and sensitivity is expected to climb back toward 2.0. The lesson gives no fixed value, so the sketch shows a range (and an arrow once the peak is large enough to draw it). The afferents respond to this active turn as to a passive one here too. Cancellation is conditional, not unconditional.';
      }
    }
    vIn.addEventListener('input', render);
    radios.forEach((r) => r.addEventListener('change', render));
    render();
  });
</script>

<style>
  .rcm { padding: var(--ddp-space-3) var(--ddp-space-4) var(--ddp-space-4); margin: var(--ddp-space-5) 0; }
  .rcm-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem; font-weight: 600; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); margin-bottom: var(--ddp-space-3); }
  .rcm-chip { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 400; color: var(--ddp-color-muted); }
  .rcm-svg { display: block; width: 100%; max-width: 560px; margin: 0 auto; height: auto; background: #fff; border: 1px solid var(--ddp-color-line); border-radius: 6px; }
  .rcm-controls { display: grid; grid-template-columns: 1fr 1fr; gap: var(--ddp-space-2) var(--ddp-space-4); margin: var(--ddp-space-3) 0 var(--ddp-space-2); align-items: start; }
  @media (max-width: 560px) { .rcm-controls { grid-template-columns: 1fr; } }
  .rcm-slabel { display: flex; flex-direction: column; gap: 0.1rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .rcm-slabel em { font-style: normal; font-weight: 700; color: var(--ddp-color-accent); font-family: var(--ddp-font-mono); }
  .rcm-slabel input { accent-color: var(--ddp-color-accent); }
  .rcm-set { border: 1px solid var(--ddp-color-line); border-radius: 6px; margin: 0; padding: 0.3rem 0.6rem 0.4rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .rcm-set legend { padding: 0 0.3rem; font-weight: 600; }
  .rcm-opt { display: flex; gap: 0.4rem; align-items: baseline; margin: 0.15rem 0; }
  .rcm-opt input { accent-color: var(--ddp-color-accent); }
  .rcm-readout { display: grid; grid-template-columns: 1fr 1fr; gap: var(--ddp-space-2); margin: var(--ddp-space-2) 0; padding: var(--ddp-space-2) var(--ddp-space-3); background: color-mix(in srgb, var(--ddp-color-accent) 8%, transparent); border-radius: 6px; }
  .rcm-readout div { display: flex; flex-direction: column; gap: 0.1rem; }
  .rcm-readout dt { font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .rcm-readout dd { margin: 0; font-family: var(--ddp-font-mono); font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); font-weight: 700; }
  .rcm-arith { margin: 0 0 var(--ddp-space-2); font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .rcm-why { margin: 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); line-height: 1.5; min-height: 6em; }
  .rcm-assume { margin: var(--ddp-space-2) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); line-height: 1.5; }
  .rcm-foot { margin: var(--ddp-space-3) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); border-left: 3px solid var(--ddp-color-secondary); padding-left: 0.55rem; }
</style>
