---
/**
 * CueReliabilityWeigher — two Gaussian likelihoods for bar height (vision, touch) and their
 * inverse-variance combination, with the weights shown as bars. Numbers follow the worked problem
 * of the lesson "Combining Senses and Predicting Them". Self-contained vanilla-TS Astro island.
 */
---

<figure class="cr card" data-cueweigher>
  <figcaption class="cr-head">Weighing two cues by reliability<span class="cr-chip">⚙ original · interactive</span></figcaption>

  <svg class="cr-svg" viewBox="0 0 340 300" role="img" aria-label="Two Gaussian curves for bar height, one from vision and one from touch, and the narrower combined curve, with two bars showing the weight given to each sense" data-plot></svg>

  <div class="cr-controls">
    <label class="cr-slabel"><span>Vision SD <em data-out="sv">2.0</em> mm <small>(raising it = blur)</small></span>
      <input type="range" data-in="sv" min="1" max="10" step="0.1" value="2" />
    </label>
    <label class="cr-slabel"><span>Touch SD <em data-out="sh">4.0</em> mm</span>
      <input type="range" data-in="sh" min="1" max="10" step="0.1" value="4" />
    </label>
    <label class="cr-slabel"><span>Touch estimate <em data-out="th">54.0</em> mm <small>(vision says 50 mm)</small></span>
      <input type="range" data-in="th" min="44" max="60" step="0.5" value="54" />
    </label>
  </div>

  <dl class="cr-readout">
    <div><dt>Variances σ<sub>V</sub>², σ<sub>H</sub>²</dt><dd data-r="var"></dd></div>
    <div><dt>Precisions 1/σ² (per mm²)</dt><dd data-r="prec"></dd></div>
    <div><dt>Weights w<sub>V</sub>, w<sub>H</sub></dt><dd data-r="w"></dd></div>
    <div><dt>Combined estimate</dt><dd data-r="est"></dd></div>
    <div><dt>Combined variance σ<sub>V</sub>²σ<sub>H</sub>²/(σ<sub>V</sub>²+σ<sub>H</sub>²)</dt><dd data-r="cvar"></dd></div>
    <div><dt>Combined SD (smaller single SD)</dt><dd data-r="csd"></dd></div>
    <div class="cr-wide"><dt>Check w<sub>V</sub>²σ<sub>V</sub>² + w<sub>H</sub>²σ<sub>H</sub>²</dt><dd data-r="check"></dd></div>
  </dl>

  <p class="cr-why" data-why role="status"></p>

  <p class="cr-assume"><b>In this sketch:</b> independent, unbiased Gaussian estimates of one bar height on one trial, a uniform prior, illustrative numbers (vision 50 mm). The curves are computed from the equations, not recorded.</p>
  <ul class="cr-refuse">
    <li>It does not say vision always wins: dominance follows reliability, as in the blur reversal.</li>
    <li>It does not locate the weighting in the brain, and does not show that every pair of cues combines this way.</li>
    <li>It does not show that superior colliculus enhancement implements these equations; the recording papers do not settle that.</li>
  </ul>

  <p class="cr-foot">Rule to keep: each cue is weighted by its precision (1/variance) over the sum of the precisions, and the combined variance is lower than either cue’s alone. The behavioural test was Ernst and Banks (2002): four observers, one task, a fit to behaviour.</p>
</figure>

<script>
  const NS = 'http://www.w3.org/2000/svg';
  const TEAL = '#0e7c86', ORANGE = '#e57200', DARK = '#2b2b36', INK = '#4b4b55', FAINT = '#b9b9c2';
  function el(name: string, attrs: Record<string, string | number>): SVGElement {
    const e = document.createElementNS(NS, name);
    for (const k in attrs) e.setAttribute(k, String(attrs[k]));
    return e;
  }
  function txt(x: number, y: number, s: string, extra: Record<string, string | number> = {}): SVGElement {
    const t = el('text', Object.assign({ x, y, 'font-size': 9, fill: INK }, extra));
    t.textContent = s;
    return t;
  }
  document.querySelectorAll<HTMLElement>('[data-cueweigher]').forEach((root) => {
    const plot = root.querySelector<SVGSVGElement>('[data-plot]');
    const why = root.querySelector<HTMLElement>('[data-why]');
    const svIn = root.querySelector<HTMLInputElement>('[data-in="sv"]');
    const shIn = root.querySelector<HTMLInputElement>('[data-in="sh"]');
    const thIn = root.querySelector<HTMLInputElement>('[data-in="th"]');
    const svOut = root.querySelector<HTMLElement>('[data-out="sv"]');
    const shOut = root.querySelector<HTMLElement>('[data-out="sh"]');
    const thOut = root.querySelector<HTMLElement>('[data-out="th"]');
    if (!plot || !why || !svIn || !shIn || !thIn || !svOut || !shOut || !thOut) return;
    const rd: Record<string, HTMLElement> = {};
    for (const k of ['var', 'prec', 'w', 'est', 'cvar', 'csd', 'check']) {
      const e = root.querySelector<HTMLElement>('[data-r="' + k + '"]');
      if (!e) return;
      rd[k] = e;
    }

    const VIS = 50;                       // vision's estimate is fixed at 50 mm
    const XMIN = 25, XMAX = 80, YMAX = 0.6;
    const X0 = 40, X1 = 326, Y0 = 24, Y1 = 170;
    const px = (v: number) => X0 + ((v - XMIN) / (XMAX - XMIN)) * (X1 - X0);
    const py = (d: number) => Y1 - (Math.min(d, YMAX) / YMAX) * (Y1 - Y0);
    const pdf = (x: number, m: number, s: number) => Math.exp(-0.5 * ((x - m) / s) ** 2) / (s * Math.sqrt(2 * Math.PI));
    function curve(m: number, s: number, close: boolean): string {
      let d = '';
      for (let x = XMIN; x <= XMAX + 1e-9; x += 0.5) d += (x === XMIN ? 'M' : 'L') + px(x).toFixed(1) + ' ' + py(pdf(x, m, s)).toFixed(1) + ' ';
      if (close) d += 'L' + px(XMAX).toFixed(1) + ' ' + Y1 + ' L' + px(XMIN).toFixed(1) + ' ' + Y1 + ' Z';
      return d.trim();
    }

    function render() {
      const sv = parseFloat(svIn!.value), sh = parseFloat(shIn!.value), th = parseFloat(thIn!.value);
      const vV = sv * sv, vH = sh * sh;
      const pV = 1 / vV, pH = 1 / vH;
      const wV = pV / (pV + pH), wH = 1 - wV;
      const est = wV * VIS + wH * th;
      const cvar = (vV * vH) / (vV + vH);
      const csd = Math.sqrt(cvar);
      const aV = wV * wV * vV, aH = wH * wH * vH;
      const smaller = Math.min(sv, sh);

      svOut!.textContent = sv.toFixed(1);
      shOut!.textContent = sh.toFixed(1);
      thOut!.textContent = th.toFixed(1);
      rd.var.textContent = vV.toFixed(2) + ' and ' + vH.toFixed(2) + ' mm²';
      rd.prec.textContent = pV.toFixed(4) + ' and ' + pH.toFixed(4);
      rd.w.textContent = wV.toFixed(2) + ' and ' + wH.toFixed(2);
      rd.est.textContent = wV.toFixed(2) + ' × 50 + ' + wH.toFixed(2) + ' × ' + th.toFixed(1) + ' = ' + est.toFixed(2) + ' mm (from unrounded weights)';
      rd.cvar.textContent = cvar.toFixed(2) + ' mm²';
      rd.csd.textContent = csd.toFixed(3) + ' mm (' + smaller.toFixed(1) + ' mm)';
      rd.check.textContent = aV.toFixed(2) + ' + ' + aH.toFixed(2) + ' = ' + (aV + aH).toFixed(2) + ' mm²';

      plot!.replaceChildren();
      // axes and grid
      plot!.appendChild(el('line', { x1: X0, y1: Y0, x2: X0, y2: Y1, stroke: INK, 'stroke-width': 1 }));
      plot!.appendChild(el('line', { x1: X0, y1: Y1, x2: X1, y2: Y1, stroke: INK, 'stroke-width': 1 }));
      for (const d of [0.2, 0.4, 0.6]) {
        plot!.appendChild(el('line', { x1: X0, y1: py(d), x2: X1, y2: py(d), stroke: FAINT, 'stroke-width': 0.6, 'stroke-dasharray': '2 3' }));
        plot!.appendChild(txt(X0 - 4, py(d) + 3, d.toFixed(1), { 'text-anchor': 'end' }));
      }
      plot!.appendChild(txt(X0 - 4, Y1 + 3, '0', { 'text-anchor': 'end' }));
      for (const v of [30, 40, 50, 60, 70, 80]) {
        plot!.appendChild(el('line', { x1: px(v), y1: Y1, x2: px(v), y2: Y1 + 3, stroke: INK, 'stroke-width': 1 }));
        plot!.appendChild(txt(px(v), Y1 + 13, String(v), { 'text-anchor': 'middle' }));
      }
      plot!.appendChild(txt((X0 + X1) / 2, Y1 + 27, 'bar height (mm)', { 'text-anchor': 'middle', 'font-size': 10 }));
      plot!.appendChild(txt(X0 - 2, Y0 - 9, 'probability density of the estimate (per mm)', { 'font-size': 10 }));

      // curves: vision, touch, combined
      plot!.appendChild(el('path', { d: curve(est, csd, true), fill: DARK, 'fill-opacity': 0.08, stroke: 'none' }));
      plot!.appendChild(el('path', { d: curve(VIS, sv, false), fill: 'none', stroke: TEAL, 'stroke-width': 2 }));
      plot!.appendChild(el('path', { d: curve(th, sh, false), fill: 'none', stroke: ORANGE, 'stroke-width': 2 }));
      plot!.appendChild(el('path', { d: curve(est, csd, false), fill: 'none', stroke: DARK, 'stroke-width': 2.8 }));
      // means as triangles on the axis
      const tri = (v: number, c: string) => el('path', { d: 'M' + (px(v) - 4).toFixed(1) + ' ' + (Y1 + 0.5) + ' L' + (px(v) + 4).toFixed(1) + ' ' + (Y1 + 0.5) + ' L' + px(v).toFixed(1) + ' ' + (Y1 - 7) + ' Z', fill: c, stroke: '#fff', 'stroke-width': 0.6 });
      plot!.appendChild(tri(VIS, TEAL));
      plot!.appendChild(tri(th, ORANGE));
      plot!.appendChild(tri(est, DARK));

      // legend
      const LY = 230;
      const items: [number, string, string][] = [[40, TEAL, 'vision, 50 mm'], [133, ORANGE, 'touch'], [188, DARK, 'combined (dark)']];
      for (const [x, c, label] of items) {
        plot!.appendChild(el('line', { x1: x, y1: LY - 3, x2: x + 14, y2: LY - 3, stroke: c, 'stroke-width': 2.6 }));
        plot!.appendChild(txt(x + 18, LY, label));
      }

      // weight bars
      const BX = 60, BW = 160;
      plot!.appendChild(txt(40, 250, 'weight given to each sense (the two sum to 1)', { 'font-size': 10 }));
      const bar = (y: number, w: number, c: string, name: string) => {
        plot!.appendChild(txt(BX - 4, y + 10, name, { 'text-anchor': 'end' }));
        plot!.appendChild(el('rect', { x: BX, y, width: BW, height: 14, fill: '#fff', stroke: FAINT, 'stroke-width': 1 }));
        plot!.appendChild(el('rect', { x: BX, y, width: Math.max(0.5, w * BW), height: 14, fill: c }));
        plot!.appendChild(txt(BX + BW + 8, y + 10, name + ' = ' + w.toFixed(2), { 'font-size': 10 }));
      };
      bar(258, wV, TEAL, 'w_V');
      bar(278, wH, ORANGE, 'w_H');

      const cmp = Math.abs(sv - sh) < 1e-9
        ? 'The two SDs are equal, so each sense gets weight 0.50.'
        : wV > wH
          ? 'Vision has the smaller variance here, so it gets the larger weight (' + wV.toFixed(2) + ') and the combined estimate sits nearer 50 mm.'
          : 'Touch has the smaller variance here, so it gets the larger weight (' + wH.toFixed(2) + ') and the combined estimate sits nearer the touch estimate: the blur reversal in miniature.';
      why!.textContent = cmp + ' Weights follow the ratio of variances, so they depend on reliability, not on which sense it is. The combined SD, ' + csd.toFixed(2) + ' mm, is below the smaller single SD, ' + smaller.toFixed(1) + ' mm. In this sketch, with independent Gaussian noise, a second cue always lowers the variance.';
    }
    [svIn, shIn, thIn].forEach((s) => s.addEventListener('input', render));
    render();
  });
</script>

<style>
  .cr { padding: var(--ddp-space-3) var(--ddp-space-4) var(--ddp-space-4); margin: var(--ddp-space-5) 0; }
  .cr-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem; font-weight: 600; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); margin-bottom: var(--ddp-space-3); }
  .cr-chip { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 400; color: var(--ddp-color-muted); }
  .cr-svg { display: block; width: 100%; max-width: 560px; margin: 0 auto; height: auto; background: #fff; border: 1px solid var(--ddp-color-line); border-radius: 6px; }
  .cr-controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: var(--ddp-space-2) var(--ddp-space-4); margin: var(--ddp-space-3) 0 var(--ddp-space-2); }
  .cr-slabel { display: flex; flex-direction: column; gap: 0.1rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .cr-slabel small { font-size: inherit; color: var(--ddp-color-muted); }
  .cr-slabel em { font-style: normal; font-weight: 700; color: var(--ddp-color-accent); font-family: var(--ddp-font-mono); }
  .cr-slabel input { accent-color: var(--ddp-color-accent); }
  .cr-readout { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: var(--ddp-space-2); margin: var(--ddp-space-2) 0; padding: var(--ddp-space-2) var(--ddp-space-3); background: color-mix(in srgb, var(--ddp-color-accent) 8%, transparent); border-radius: 6px; }
  .cr-readout div { display: flex; flex-direction: column; gap: 0.1rem; min-width: 0; }
  .cr-readout dt { font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .cr-readout dd { margin: 0; font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); color: var(--ddp-color-primary); font-weight: 700; overflow-wrap: anywhere; }
  .cr-why { margin: 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); line-height: 1.5; min-height: 6em; }
  .cr-assume { margin: var(--ddp-space-2) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); line-height: 1.5; }
  .cr-refuse { margin: var(--ddp-space-1) 0 0; padding-left: 1.1rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); line-height: 1.5; }
  .cr-foot { margin: var(--ddp-space-3) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); border-left: 3px solid var(--ddp-color-secondary); padding-left: 0.55rem; }
</style>
