---
/**
 * PurificationSimulator — walk a crude lysate through five purification steps and
 * watch the purification table fill while a simulated SDS-PAGE gel cleans up to a
 * single band. The numbers match the lecture table (specific activity climbs
 * 10 → 30 → 90 → 1,100 → 30,000; ~3,000-fold; yield 100% → 36%), so the table and
 * the gel tell the same story. Self-contained Astro island: vanilla TS, no props.
 */
---

<figure class="psim card" data-psim>
  <figcaption class="psim-head">
    Purification simulator
    <span class="psim-chip">run each step</span>
  </figcaption>

  <div class="psim-steps" data-steps></div>
  <p class="psim-callout" data-callout role="status">Run the purification one step at a time — click the highlighted <b>▶ button</b> to advance. Watch the table and gel update as specific activity climbs and contaminants drop away.</p>

  <div class="psim-grid">
    <div class="psim-tablewrap">
      <table class="psim-table">
        <thead>
          <tr><th>Step</th><th>Protein<br/>(mg)</th><th>Activity<br/>(units)</th><th>Sp. act.<br/>(u/mg)</th><th>Yield<br/>(%)</th><th>Fold</th></tr>
        </thead>
        <tbody data-tbody></tbody>
      </table>
      <p class="psim-summary" data-summary aria-live="polite"></p>
    </div>

    <div class="psim-gelwrap">
      <div class="psim-gel-title">Simulated SDS-PAGE <span class="psim-gel-sub">(small proteins run farther)</span></div>
      <svg class="psim-gel" viewBox="0 0 320 324" role="img" aria-label="Simulated SDS-PAGE gel; lanes fill in as purification steps run, contaminant bands fading until a single target band remains" data-gel></svg>
    </div>
  </div>

  <div class="psim-btns">
    <button type="button" data-reset>Reset experiment</button>
  </div>
</figure>

<script>
  const NS = 'http://www.w3.org/2000/svg';
  const TEAL = '#0e7c86', NAVY = '#232d4b', GOLD = '#D4A843';

  type Band = { mw: number; intensity: number; target?: boolean };
  type Step = { name: string; tp: number; ta: number; principle: string; bands: Band[] };

  const STEPS: Step[] = [
    {
      name: '1 · Crude homogenate', tp: 10000, ta: 100000,
      principle: 'Break the cells open and spin out debris. Everything is here — every protein in the cell, your target lost in the crowd. Specific activity starts at its lowest.',
      bands: [[205,.45],[150,.4],[120,.45],[97,.55],[80,.5],[66,.6],[55,.5],[48,.45],[36,.65,true],[30,.55],[24,.5],[19,.45],[14,.45]].map(b => ({ mw: b[0] as number, intensity: b[1] as number, target: b[2] as boolean })),
    },
    {
      name: '2 · Salting-out', tp: 3000, ta: 90000,
      principle: 'Ammonium sulfate drops proteins out of solution at different salt concentrations. A well-chosen cut leaves many contaminants behind, then dialysis removes the salt.',
      bands: [[150,.3],[97,.4],[66,.5],[55,.4],[48,.4],[36,.8,true],[30,.4],[24,.35],[19,.3]].map(b => ({ mw: b[0] as number, intensity: b[1] as number, target: b[2] as boolean })),
    },
    {
      name: '3 · Ion-exchange', tp: 900, ta: 81000,
      principle: 'Bind by charge on a DEAE (anion) resin at pH above the target’s pI, then elute with a rising salt gradient. A bigger jump in purity.',
      bands: [[97,.25],[66,.35],[48,.3],[36,.9,true],[30,.3],[19,.25]].map(b => ({ mw: b[0] as number, intensity: b[1] as number, target: b[2] as boolean })),
    },
    {
      name: '4 · Gel filtration', tp: 60, ta: 66000,
      principle: 'Separate by size — and remember, large proteins elute first. Specific activity is now in the thousands; only a few contaminants remain.',
      bands: [[66,.25],[36,.95,true],[30,.2]].map(b => ({ mw: b[0] as number, intensity: b[1] as number, target: b[2] as boolean })),
    },
    {
      name: '5 · Affinity', tp: 1.2, ta: 36000,
      principle: 'A bead carrying NADH grabs only your dehydrogenase; everything else flows through. Elute with free NADH. The largest single jump — down to essentially one band.',
      bands: [[66,.1],[36,1.0,true]].map(b => ({ mw: b[0] as number, intensity: b[1] as number, target: b[2] as boolean })),
    },
  ];
  const LADDER = [205, 116, 97, 66, 45, 31, 21, 14];
  const SA0 = STEPS[0].ta / STEPS[0].tp;

  function el(name: string, attrs: Record<string, string | number>) {
    const e = document.createElementNS(NS, name);
    for (const k in attrs) e.setAttribute(k, String(attrs[k]));
    return e;
  }
  function fmt(n: number) {
    if (n >= 1000) return Math.round(n).toLocaleString('en-US');
    if (n >= 10) return Math.round(n).toString();
    return n.toFixed(n < 1 ? 2 : 1);
  }

  document.querySelectorAll<HTMLElement>('[data-psim]').forEach((root) => {
    const stepsBar = root.querySelector<HTMLElement>('[data-steps]')!;
    const callout = root.querySelector<HTMLElement>('[data-callout]')!;
    const tbody = root.querySelector<HTMLElement>('[data-tbody]')!;
    const summary = root.querySelector<HTMLElement>('[data-summary]')!;
    const gel = root.querySelector<SVGSVGElement>('[data-gel]')!;
    const resetBtn = root.querySelector<HTMLButtonElement>('[data-reset]')!;
    let done = 0; // how many steps have been run

    // build step buttons — only the NEXT step is ever enabled, so the order is obvious
    const stepBtns: HTMLButtonElement[] = [];
    STEPS.forEach((s, i) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'psim-step';
      b.addEventListener('click', () => {
        if (i !== done) return; // disabled anyway; guard for safety
        done = i + 1;
        callout.textContent = s.principle;
        render(true);
        // this button just disabled itself; keep keyboard users on the next action
        (stepBtns[done] ?? resetBtn).focus();
      });
      stepBtns.push(b);
      stepsBar.appendChild(b);
    });

    // Paint each step button's state so the click order is self-evident.
    function paintSteps() {
      stepBtns.forEach((b, i) => {
        const s = STEPS[i];
        const isDone = i < done, isNext = i === done;
        b.classList.toggle('is-done', isDone);
        b.classList.toggle('is-next', isNext);
        b.classList.toggle('is-locked', i > done);
        b.disabled = !isNext;
        b.textContent = (isDone ? '✓ ' : isNext ? '▶ ' : '') + s.name;
      });
    }

    // MW (log) → y on the gel
    const GT = 40, GB = 292, MWMAX = 240, MWMIN = 12;
    const yOf = (mw: number) => GT + (Math.log(MWMAX) - Math.log(mw)) / (Math.log(MWMAX) - Math.log(MWMIN)) * (GB - GT);
    const laneX = [58, 108, 156, 204, 252, 300]; // marker lane + 5 step lanes
    const HALF = 18;
    // SVG text never below ~9 px on screen, whatever width the gel renders at
    let fs = (n: number) => n;
    function text(x: number, y: number, str: string, size: number, fill: string, anchor = 'middle', parent: Element = gel) {
      const t = el('text', { x, y, 'text-anchor': anchor, 'font-size': fs(size), fill });
      t.textContent = str; parent.appendChild(t); return t;
    }

    function renderGel(animateNew: boolean) {
      const k = (gel.getBoundingClientRect().width || 320) / 320;
      fs = (n: number) => Math.max(n, 9 / k);
      gel.replaceChildren();
      // marker (ladder) lane: gray reference bands with their sizes
      gel.appendChild(el('rect', { x: laneX[0] - HALF, y: GT - 4, width: HALF * 2, height: GB - GT + 8, fill: '#f3f1ea', stroke: '#e6e3db', 'stroke-width': 1, rx: 2 }));
      LADDER.forEach((mw) => {
        const y = yOf(mw);
        gel.appendChild(el('rect', { x: laneX[0] - HALF + 3, y: y - 1.5, width: HALF * 2 - 6, height: 3, rx: 1, fill: '#9a9aa3' }));
        text(laneX[0] - HALF - 4, y + 3, String(mw), 9, NAVY, 'end');
      });
      text(laneX[0] - HALF - 4, GT - 10, 'kDa', 9, NAVY, 'end');
      text(laneX[0], GB + 18, 'M', 10, NAVY);
      // step lanes
      STEPS.forEach((s, i) => {
        const cx = laneX[i + 1];
        const run = i < done;
        gel.appendChild(el('rect', { x: cx - HALF, y: GT - 4, width: HALF * 2, height: GB - GT + 8, fill: run ? '#f3f1ea' : '#faf9f6', stroke: '#e6e3db', 'stroke-width': 1, rx: 2 }));
        text(cx, GB + 18, String(i + 1), 10, run ? NAVY : '#8a8a93');
        if (!run) return;
        const lane = el('g', { class: animateNew && i === done - 1 ? 'psim-lane-new' : '' });
        for (const band of s.bands) {
          const y = yOf(band.mw);
          // equal protein is loaded per lane, so the target band DARKENS as it becomes a bigger share
          lane.appendChild(el('rect', {
            x: cx - HALF + 2, y: y - 2.4, width: HALF * 2 - 4, height: 4.8, rx: 1.5,
            fill: band.target ? TEAL : NAVY, opacity: band.target ? Math.max(0.55, band.intensity).toFixed(2) : Math.max(0.12, band.intensity).toFixed(2),
          }));
          if (band.target) lane.appendChild(el('rect', { x: cx - HALF + 0.5, y: y - 3.8, width: HALF * 2 - 1, height: 7.6, rx: 2, fill: 'none', stroke: GOLD, 'stroke-width': 1.3 }));
        }
        gel.appendChild(lane);
      });
      // target legend
      text(laneX[5] + HALF, GT - 14, '■ target (LDH subunit, ~36 kDa)', 9, TEAL, 'end');
    }

    function renderTable() {
      tbody.replaceChildren();
      for (let i = 0; i < done; i++) {
        const s = STEPS[i];
        const sa = s.ta / s.tp, yld = s.ta / STEPS[0].ta * 100, fold = sa / SA0;
        const tr = document.createElement('tr');
        if (i === done - 1) tr.className = 'psim-active';
        tr.innerHTML = `<td>${s.name}</td><td>${fmt(s.tp)}</td><td>${fmt(s.ta)}</td>`
          + `<td><b>${fmt(sa)}</b></td><td>${Math.round(yld)}</td><td>${fmt(fold)}×</td>`;
        tbody.appendChild(tr);
      }
      // say what the step just did, in words, under the table
      if (done === 0) { summary.textContent = ''; return; }
      const cur = STEPS[done - 1];
      const sa = cur.ta / cur.tp;
      if (done === 1) {
        summary.innerHTML = `<b>Starting point:</b> ${fmt(cur.ta)} units of activity spread through ${fmt(cur.tp)} mg of protein, so specific activity is just <b>${fmt(sa)} u/mg</b>.`;
        return;
      }
      const prev = STEPS[done - 2];
      const saPrev = prev.ta / prev.tp;
      const kept = cur.ta / prev.ta * 100;
      const stepLine = `<b>This step:</b> specific activity ${fmt(saPrev)} → <b>${fmt(sa)} u/mg</b> (${fmt(sa / saPrev)}× purer), keeping ${Math.round(kept)}% of the activity.`;
      if (done === STEPS.length) {
        const fold = sa / SA0, yld = cur.ta / STEPS[0].ta * 100;
        summary.innerHTML = `${stepLine}<br><b>Overall: ${fmt(fold)}× purification</b> at ${Math.round(yld)}% yield. `
          + `Total protein and activity both fell, but specific activity rose every step. That single teal band is your enzyme, essentially alone.`;
      } else {
        summary.innerHTML = stepLine;
      }
    }

    function render(animateNew = false) { renderTable(); renderGel(animateNew); paintSteps(); }

    resetBtn.addEventListener('click', () => {
      done = 0;
      callout.innerHTML = 'Run the purification one step at a time — click the highlighted <b>▶ button</b> to advance. Watch the table and gel update as specific activity climbs and contaminants drop away.';
      render();
      stepBtns[0].focus();
    });
    new ResizeObserver(() => renderGel(false)).observe(gel);
    render();
  });
</script>

<style is:global>
  /* Selectors are anchored under .psim so the lesson's `.prose-col p` rule cannot override them. */
  .psim { padding: var(--ddp-space-3) var(--ddp-space-4) var(--ddp-space-4); margin: var(--ddp-space-5) 0; }
  .psim .psim-head {
    display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem;
    font-weight: 600; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); margin-bottom: var(--ddp-space-2);
  }
  .psim .psim-chip { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 400; color: var(--ddp-color-muted); }
  .psim .psim-steps { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: var(--ddp-space-2); }
  .psim .psim-step {
    font-size: var(--ddp-text-xs); font-family: inherit; cursor: pointer;
    border: 1px solid var(--ddp-color-line); background: #fff; color: var(--ddp-color-ink-soft);
    border-radius: 5px; padding: 0.32rem 0.6rem;
  }
  .psim .psim-step:hover:not(:disabled) { border-color: var(--ddp-color-accent); color: var(--ddp-color-primary); }
  .psim .psim-step.is-next {
    border-color: var(--ddp-color-accent);
    background: color-mix(in srgb, var(--ddp-color-accent) 12%, #fff);
    color: var(--ddp-color-primary); font-weight: 700;
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--ddp-color-accent) 22%, transparent);
  }
  .psim .psim-step.is-done { color: var(--ddp-color-accent); border-style: dashed; }
  .psim .psim-step.is-locked { opacity: 0.45; }
  .psim .psim-step:disabled { cursor: default; }
  .psim .psim-step:focus-visible, .psim .psim-btns button:focus-visible { outline: 2px solid var(--ddp-color-accent); outline-offset: 2px; }
  .psim .psim-callout {
    margin: 0 0 var(--ddp-space-3); font-size: var(--ddp-text-sm); color: var(--ddp-color-ink);
    border-left: 3px solid var(--ddp-color-secondary); padding-left: 0.55rem; min-height: 3em; line-height: 1.5;
  }
  .psim .psim-grid { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); gap: var(--ddp-space-4); align-items: start; }
  .psim .psim-tablewrap { min-width: 0; overflow-x: auto; }
  .psim .psim-gelwrap { min-width: 0; }
  .psim .psim-table { width: 100%; border-collapse: collapse; font-size: var(--ddp-text-xs); font-variant-numeric: tabular-nums; }
  .psim .psim-table th, .psim .psim-table td { border-bottom: 1px solid var(--ddp-color-line); padding: 0.3rem 0.3rem; text-align: right; }
  .psim .psim-table th:first-child, .psim .psim-table td:first-child { text-align: left; padding-left: 0; }
  .psim .psim-table td:not(:first-child) { white-space: nowrap; }
  .psim .psim-table thead th { color: var(--ddp-color-muted); font-weight: 600; vertical-align: bottom; }
  .psim .psim-table tbody tr.psim-active { background: color-mix(in srgb, var(--ddp-color-accent) 9%, transparent); }
  .psim .psim-table tbody tr td b { color: var(--ddp-color-primary); }
  .psim .psim-summary { margin: var(--ddp-space-2) 0 0; font-size: var(--ddp-text-sm); color: var(--ddp-color-ink); line-height: 1.5; }
  .psim .psim-gel-title { font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); margin-bottom: 0.3rem; }
  .psim .psim-gel-sub { color: var(--ddp-color-muted); }
  .psim .psim-gel { display: block; width: 100%; max-width: 360px; height: auto; background: #fff; border: 1px solid var(--ddp-color-line); border-radius: 6px; }
  .psim .psim-lane-new { animation: psim-lane-in 0.6s ease-out both; }
  @keyframes psim-lane-in { from { opacity: 0; transform: translateY(-8px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .psim .psim-lane-new { animation: none; } }
  .psim .psim-btns { margin-top: var(--ddp-space-3); }
  .psim .psim-btns button {
    font-size: var(--ddp-text-xs); font-family: inherit; cursor: pointer;
    border: 1px solid var(--ddp-color-line); background: #fff; color: var(--ddp-color-ink-soft);
    border-radius: 5px; padding: 0.3rem 0.6rem;
  }
  .psim .psim-btns button:hover { border-color: var(--ddp-color-accent); color: var(--ddp-color-primary); }
  @media (max-width: 640px) {
    .psim .psim-grid { grid-template-columns: 1fr; }
  }
</style>
