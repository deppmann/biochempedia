---
/**
 * ZSchemeHighway — the energy-landscape companion to the light-reactions chapter. Most diagrams
 * of photosynthesis draw the thylakoid membrane as plumbing; this island redraws it as the thing
 * that actually matters: a reduction-potential ladder. The vertical axis is E (volts), so the path
 * literally traces a 'Z' — two photon-driven UPHILL boosts (P680→P680*, P700→P700*) separated by
 * a DOWNHILL slide of electron carriers. Fire photons one at a time and watch the electron climb,
 * fall, split water, fill the lumen with H+, release O2, and finally reduce NADP+ to NADPH. State
 * advances synchronously on each click (every counter is inspectable in the DOM); the electron
 * marker then glides along the path with requestAnimationFrame (instant under reduced motion).
 * "Break PSII" lets the student watch PSI starve once the electrons from water stop. Original.
 */
---

<figure class="zsh card" data-zsh>
  <figcaption class="zsh-head">The Z-scheme as an energy ladder<span class="zsh-chip">⚙ original · interactive</span></figcaption>

  <div class="zsh-scroll" tabindex="0" aria-label="Z-scheme diagram (scrolls sideways on narrow screens)">
    <svg class="zsh-svg" viewBox="0 0 760 420" role="img" aria-label="Z-scheme diagram: electron carriers plotted by reduction potential. Two photon-driven upstrokes, at P680 and P700, are separated by a downhill run through plastoquinone, cytochrome b6f and plastocyanin, ending at NADP+." data-svg></svg>
  </div>
  <p class="zsh-swipe" aria-hidden="true">← swipe to see the whole Z →</p>

  <div class="zsh-controls">
    <button type="button" data-fire="psii">⚡ Fire photon at PSII (680 nm)</button>
    <button type="button" data-fire="psi">⚡ Fire photon at PSI (700 nm)</button>
    <button type="button" data-break aria-pressed="false" class="zsh-break">Break PSII</button>
    <button type="button" data-reset class="zsh-reset">Reset</button>
  </div>

  <p class="zsh-stage" data-stage role="status"></p>

  <div class="zsh-counters" aria-live="polite">
    <div class="zsh-counter"><span class="zsh-c-name">Photons absorbed</span><span class="zsh-c-v" data-c="photons">0</span></div>
    <div class="zsh-counter"><span class="zsh-c-name">e⁻ pulled from water</span><span class="zsh-c-v" data-c="electrons">0</span></div>
    <div class="zsh-counter"><span class="zsh-c-name">H⁺ in lumen</span><span class="zsh-c-v" data-c="protons">0</span></div>
    <div class="zsh-counter"><span class="zsh-c-name">O₂ released</span><span class="zsh-c-v" data-c="o2">0</span></div>
    <div class="zsh-counter"><span class="zsh-c-name">NADPH made</span><span class="zsh-c-v" data-c="nadph">0</span></div>
  </div>

  <p class="zsh-net" data-net></p>

  <div class="zsh-misc">
    <strong>Energy is not the electron.</strong> Hundreds of antenna pigments hand the photon's
    <em>energy</em> inward by resonance — like a struck tuning fork setting the next one ringing — and not
    one of them loses an electron. Only at the reaction center (P680, P700) does a real electron actually
    leave the chlorophyll and enter the chain. That single hand-off, energy → charge separation, is the
    whole point of the antenna.
  </div>

  <p class="zsh-foot">Read the Z left to right and the story is honest about its bookkeeping: light pays
  twice. The first photon pries an electron off water — the only molecule on Earth's surface stubborn
  enough that it takes a roughly +1.2 V oxidant (P680⁺) to do it — and the electron slides downhill, pumping
  protons into the lumen as it goes. The second photon lifts that same electron a second time, high
  enough to finally reduce NADP⁺. Two uphill boosts, one downhill valley between them; out the back come
  O₂, a proton gradient, and the NADPH that the Calvin cycle will spend. No light, no climb, no sugar.</p>
</figure>

<script>
  const ACCENT = '#0e7c86', NAVY = '#232d4b', ORANGE = '#e57200', GOLD = '#D4A843', GOLD_INK = '#7f6315', FAINT = '#b9b9c2', INK = '#4b4b55';
  const SVGNS = 'http://www.w3.org/2000/svg';
  function el(name: string, attrs: Record<string, string | number>): SVGElement {
    const e = document.createElementNS(SVGNS, name);
    for (const k in attrs) e.setAttribute(k, String(attrs[k]));
    return e;
  }

  // Plot geometry: x left→right, y maps reduction potential E (volts) to pixels.
  // E_LO reaches +1.3 V so P680 (~+1.2 V, the most positive carrier) sits ON the axis, not below it.
  const X0 = 70, X1 = 730, Y_TOP = 30, Y_BOT = 360;
  const E_HI = -1.4, E_LO = 1.3; // volts at top / bottom of the axis
  function ey(E: number): number {
    return Y_TOP + (E - E_HI) / (E_LO - E_HI) * (Y_BOT - Y_TOP);
  }

  // ly/anchor/lx: optional label placement where the default (below, centered) would collide.
  type ZNode = { id: string; label: string; cofactor: string; E: number; x: number; psi: boolean; ly?: number; lx?: number; anchor?: string };
  // x positions hand-placed so the chain marches left→right and the trace is a literal Z.
  const NODES: ZNode[] = [
    { id: 'h2o',   label: 'H₂O (OEC)',          cofactor: 'Manganese cluster', E: 0.82,  x: 105, psi: false, ly: -14 },
    { id: 'p680',  label: 'P680',                 cofactor: 'Reaction-center Chl a', E: 1.20,  x: 150, psi: false },
    { id: 'p680s', label: 'P680*',                cofactor: 'Excited P680', E: -0.80, x: 150, psi: false },
    { id: 'pheo',  label: 'Pheophytin',           cofactor: 'Pheo a', E: -0.55, x: 205, psi: false },
    { id: 'qa',    label: 'QA',                    cofactor: 'Bound plastoquinone', E: -0.13, x: 250, psi: false },
    { id: 'qb',    label: 'QB → PQ pool',         cofactor: 'Plastoquinone', E: 0.00,  x: 300, psi: false },
    { id: 'b6f',   label: 'Cytochrome b₆f',       cofactor: 'Fe–S + cyt b/f (Q-cycle)', E: 0.20,  x: 355, psi: false },
    { id: 'pc',    label: 'Plastocyanin',         cofactor: 'Cu protein', E: 0.37,  x: 410, psi: false },
    { id: 'p700',  label: 'P700',                 cofactor: 'Reaction-center Chl a', E: 0.43,  x: 460, psi: true },
    { id: 'p700s', label: 'P700*',                cofactor: 'Excited P700', E: -1.30, x: 460, psi: true },
    { id: 'a0',    label: 'A₀',                    cofactor: 'Chl a acceptor', E: -1.05, x: 510, psi: true },
    { id: 'a1',    label: 'A₁',                    cofactor: 'Phylloquinone', E: -0.75, x: 555, psi: true },
    { id: 'fd',    label: 'Ferredoxin',           cofactor: 'Soluble Fe–S', E: -0.42, x: 610, psi: true },
    { id: 'fnr',   label: 'FNR',                   cofactor: 'FAD flavoenzyme', E: -0.37, x: 665, psi: true },
    { id: 'nadph', label: 'NADP⁺ → NADPH',        cofactor: 'Final electron acceptor', E: -0.32, x: 720, psi: true, ly: -14, lx: 746, anchor: 'end' },
  ];
  const IDX: Record<string, number> = {};
  NODES.forEach((n, i) => { IDX[n.id] = i; });

  // The two legs an electron can run. PSII: water → P680 → P680* → … → plastocyanin (parked).
  // PSI: plastocyanin → P700 → P700* → … → NADP⁺.
  const PSII_PATH = [0, 1, 2, 3, 4, 5, 6, 7];
  const PSI_PATH = [7, 8, 9, 10, 11, 12, 13, 14];

  // Tank geometry (lumen H⁺ reservoir, drawn in the empty space under the chain).
  const TANK = { x: 250, y: 330, w: 130, h: 34 };
  const TANK_FULL = 12; // 12 H⁺ (one O₂'s worth of electrons) fills it visually

  type State = { photons: number; psii: number; psi: number; electrons: number; protons: number; o2: number; nadph: number; parked: number; broken: boolean };
  function fresh(broken = false): State { return { photons: 0, psii: 0, psi: 0, electrons: 0, protons: 0, o2: 0, nadph: 0, parked: 0, broken }; }

  function drawStatic(svg: SVGElement): void {
    while (svg.firstChild) svg.removeChild(svg.firstChild);

    const defs = el('defs', {});
    // Arrowhead drawn pointing along +x so orient="auto" turns it to follow the (upward) photon leg.
    const m = el('marker', { id: 'zsh-up', markerWidth: 4, markerHeight: 4, refX: 3, refY: 2, orient: 'auto' });
    m.appendChild(el('path', { d: 'M0,0 L4,2 L0,4 Z', fill: GOLD }));
    defs.appendChild(m);
    const m2 = el('marker', { id: 'zsh-dn', markerWidth: 7, markerHeight: 7, refX: 5, refY: 3.5, orient: 'auto' });
    m2.appendChild(el('path', { d: 'M0,0 L7,3.5 L0,7 Z', fill: ACCENT }));
    defs.appendChild(m2);
    svg.appendChild(defs);

    // axis + gridlines
    svg.appendChild(el('line', { x1: X0, y1: Y_TOP, x2: X0, y2: Y_BOT, stroke: INK, 'stroke-width': 1.5 }));
    const ticks = [1.0, 0.5, 0.0, -0.5, -1.0];
    for (const t of ticks) {
      const y = ey(t);
      svg.appendChild(el('line', { x1: X0, y1: y, x2: X1, y2: y, stroke: FAINT, 'stroke-width': 0.6, 'stroke-dasharray': '3 4' }));
      const lab = el('text', { x: X0 - 8, y: y + 4, 'text-anchor': 'end', fill: INK, 'font-size': 11, 'font-family': 'monospace' });
      lab.textContent = (t > 0 ? '+' : '') + t.toFixed(1);
      svg.appendChild(lab);
    }
    const axTitle = el('text', { x: 16, y: (Y_TOP + Y_BOT) / 2, fill: NAVY, 'font-size': 12, 'font-weight': 700, 'text-anchor': 'middle', transform: `rotate(-90 16 ${(Y_TOP + Y_BOT) / 2})` });
    axTitle.textContent = 'Reduction potential E (V)';
    svg.appendChild(axTitle);
    const hint = el('text', { x: X0 + 6, y: Y_TOP - 14, fill: ACCENT, 'font-size': 11, 'font-weight': 600 });
    hint.textContent = '↑ more negative E = higher-energy electron';
    svg.appendChild(hint);

    // lumen tank under the chain, fed by the Q-cycle at cytochrome b6f (and by water splitting)
    const b6f = NODES[IDX['b6f']];
    svg.appendChild(el('line', { x1: b6f.x - 10, y1: ey(b6f.E) + 28, x2: b6f.x - 10, y2: TANK.y - 4, stroke: ACCENT, 'stroke-width': 1.5, 'stroke-dasharray': '3 3', 'marker-end': 'url(#zsh-dn)' }));
    const qc = el('text', { x: b6f.x - 16, y: TANK.y - 16, 'text-anchor': 'end', fill: ACCENT, 'font-size': 10, 'font-weight': 600 });
    qc.textContent = 'Q-cycle pumps H⁺';
    svg.appendChild(qc);
    svg.appendChild(el('rect', { x: TANK.x, y: TANK.y, width: TANK.w, height: TANK.h, rx: 5, fill: '#fff', stroke: NAVY, 'stroke-width': 1.5 }));
    svg.appendChild(el('rect', { x: TANK.x + 1, y: TANK.y + TANK.h - 1, width: TANK.w - 2, height: 0, rx: 4, fill: ACCENT, opacity: 0.55, 'data-tank': '1' }));
    const tlab = el('text', { x: TANK.x + TANK.w / 2, y: TANK.y + TANK.h + 16, 'text-anchor': 'middle', fill: NAVY, 'font-size': 10.5, 'font-weight': 600 });
    tlab.textContent = 'lumen H⁺ (water splitting + Q-cycle)';
    svg.appendChild(tlab);

    // photon arrows at the two reaction centers (the uphill boosts)
    boost(svg, IDX['p680'], IDX['p680s'], '680 nm');
    boost(svg, IDX['p700'], IDX['p700s'], '700 nm');

    // connective path (the Z), drawn faint under the nodes; each segment is tagged so a run can light it
    for (let i = 0; i < NODES.length - 1; i++) {
      const a = NODES[i], b = NODES[i + 1];
      if ((a.id === 'p680' && b.id === 'p680s') || (a.id === 'p700' && b.id === 'p700s')) continue;
      svg.appendChild(el('line', { x1: a.x, y1: ey(a.E), x2: b.x, y2: ey(b.E), stroke: FAINT, 'stroke-width': 2, 'data-seg': i }));
    }

    // nodes
    for (const n of NODES) {
      const cy = ey(n.E);
      const isRC = n.id === 'p680' || n.id === 'p700' || n.id === 'p680s' || n.id === 'p700s';
      svg.appendChild(el('circle', { cx: n.x, cy, r: isRC ? 9 : 7, fill: '#fff', stroke: n.psi ? ACCENT : NAVY, 'stroke-width': isRC ? 3 : 2, 'data-dot': n.id }));
      const ly = n.ly ?? (n.E < -0.5 ? -14 : 21);
      const tx = el('text', { x: n.lx ?? n.x, y: cy + ly, 'text-anchor': n.anchor ?? 'middle', fill: INK, 'font-size': 10.5, 'font-weight': isRC ? 700 : 400, 'data-lab': n.id });
      tx.textContent = n.label;
      svg.appendChild(tx);
    }

    // photosystem tags so the two halves are named on the plot
    const t1 = el('text', { x: 150, y: ey(-0.8) - 30, 'text-anchor': 'middle', fill: NAVY, 'font-size': 11, 'font-weight': 700 }); t1.textContent = 'PSII'; svg.appendChild(t1);
    const t2 = el('text', { x: 460, y: ey(-1.3) - 30, 'text-anchor': 'middle', fill: ACCENT, 'font-size': 11, 'font-weight': 700 }); t2.textContent = 'PSI'; svg.appendChild(t2);

    // "PSII broken" badge (hidden until toggled)
    const bx = el('g', { 'data-broken-badge': '1', opacity: 0 });
    bx.appendChild(el('line', { x1: 136, y1: ey(1.2) - 14, x2: 164, y2: ey(1.2) + 14, stroke: '#c0392b', 'stroke-width': 3 }));
    bx.appendChild(el('line', { x1: 164, y1: ey(1.2) - 14, x2: 136, y2: ey(1.2) + 14, stroke: '#c0392b', 'stroke-width': 3 }));
    svg.appendChild(bx);

    // moving electron marker (hidden until it has a position)
    svg.appendChild(el('circle', { cx: -20, cy: -20, r: 6.5, fill: ORANGE, stroke: '#fff', 'stroke-width': 1.5, 'data-electron': '1' }));
  }

  function boost(svg: SVGElement, fromIdx: number, toIdx: number, nm: string): void {
    const a = NODES[fromIdx], b = NODES[toIdx];
    // stop the shaft short of the excited node so the arrowhead lands on the ring, not under it
    svg.appendChild(el('line', { x1: a.x, y1: ey(a.E) - 10, x2: b.x, y2: ey(b.E) + 14, stroke: GOLD, 'stroke-width': 3, 'marker-end': 'url(#zsh-up)', 'data-boost': fromIdx }));
    const t = el('text', { x: a.x - 8, y: (ey(a.E) + ey(b.E)) / 2, 'text-anchor': 'end', fill: GOLD_INK, 'font-size': 10.5, 'font-weight': 700 });
    t.textContent = 'hν ' + nm;
    svg.appendChild(t);
  }

  const reduceMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-zsh]').forEach((root) => {
    const svg = root.querySelector('[data-svg]') as unknown as SVGElement;
    const firePSII = root.querySelector<HTMLButtonElement>('[data-fire="psii"]')!;
    const firePSI = root.querySelector<HTMLButtonElement>('[data-fire="psi"]')!;
    const breakB = root.querySelector<HTMLButtonElement>('[data-break]')!;
    const resetB = root.querySelector<HTMLButtonElement>('[data-reset]')!;
    const stageEl = root.querySelector<HTMLElement>('[data-stage]')!;
    const netEl = root.querySelector<HTMLElement>('[data-net]')!;
    const cPhotons = root.querySelector<HTMLElement>('[data-c="photons"]')!;
    const cElectrons = root.querySelector<HTMLElement>('[data-c="electrons"]')!;
    const cProtons = root.querySelector<HTMLElement>('[data-c="protons"]')!;
    const cO2 = root.querySelector<HTMLElement>('[data-c="o2"]')!;
    const cNadph = root.querySelector<HTMLElement>('[data-c="nadph"]')!;

    drawStatic(svg);
    const dot = svg.querySelector('[data-electron]') as unknown as SVGElement;
    const tank = svg.querySelector('[data-tank]') as unknown as SVGElement;
    const badge = svg.querySelector('[data-broken-badge]') as unknown as SVGElement;
    const scroller = root.querySelector<HTMLElement>('.zsh-scroll')!;
    let st = fresh();
    let raf = 0;

    // On a phone the plot scrolls sideways; bring the half of the Z that is about to run into view.
    function follow(path: number[]): void {
      if (scroller.scrollWidth <= scroller.clientWidth + 2) return;
      const xs = path.map((i) => NODES[i].x);
      const mid = (Math.min(...xs) + Math.max(...xs)) / 2 / 760 * scroller.scrollWidth;
      scroller.scrollTo({ left: mid - scroller.clientWidth / 2, behavior: reduceMotion() ? 'auto' : 'smooth' });
    }

    function place(x: number, y: number): void { dot.setAttribute('cx', String(x)); dot.setAttribute('cy', String(y)); }

    function clearTrail(): void {
      svg.querySelectorAll('[data-seg]').forEach((l) => { l.setAttribute('stroke', FAINT); l.setAttribute('stroke-width', '2'); });
    }
    function lightSeg(i: number): void {
      const l = svg.querySelector(`[data-seg="${i}"]`);
      if (l) { l.setAttribute('stroke', ORANGE); l.setAttribute('stroke-width', '3'); }
    }

    // Glide the electron marker node-to-node along `path`, lighting each segment it crosses.
    function run(path: number[]): void {
      cancelAnimationFrame(raf);
      clearTrail();
      follow(path);
      const pts = path.map((i) => [NODES[i].x, ey(NODES[i].E)]);
      if (reduceMotion()) {
        for (let k = 0; k < path.length - 1; k++) lightSeg(path[k]);
        const last = pts[pts.length - 1]; place(last[0], last[1]);
        return;
      }
      const lens = pts.slice(1).map((p, k) => Math.hypot(p[0] - pts[k][0], p[1] - pts[k][1]));
      const total = lens.reduce((a, b) => a + b, 0);
      const dur = Math.min(1500, Math.max(700, total * 1.6));
      const t0 = performance.now();
      const ease = (t: number) => (t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2);
      const step = (now: number) => {
        const t = Math.min(1, (now - t0) / dur);
        let d = ease(t) * total, k = 0;
        while (k < lens.length - 1 && d > lens[k]) { d -= lens[k]; lightSeg(path[k]); k++; }
        const f = lens[k] ? Math.min(1, d / lens[k]) : 1;
        place(pts[k][0] + (pts[k + 1][0] - pts[k][0]) * f, pts[k][1] + (pts[k + 1][1] - pts[k][1]) * f);
        if (t < 1) raf = requestAnimationFrame(step); else lightSeg(path[k]);
      };
      raf = requestAnimationFrame(step);
    }

    function fillTank(): void {
      const maxH = TANK.h - 2;
      const h = Math.min(maxH, st.protons * (maxH / TANK_FULL));
      tank.setAttribute('height', String(h));
      tank.setAttribute('y', String(TANK.y + TANK.h - 1 - h));
    }

    function renderCounters(): void {
      cPhotons.textContent = String(st.photons);
      cElectrons.textContent = String(st.electrons);
      cProtons.textContent = String(st.protons);
      cO2.textContent = String(st.o2);
      cNadph.textContent = String(st.nadph);
      firePSII.disabled = st.broken;
      // PSI needs an electron waiting at plastocyanin — except in "Break PSII" mode, where firing it
      // anyway is the experiment: the student watches PSI starve.
      firePSI.disabled = !st.broken && st.parked === 0;
      firePSI.title = firePSI.disabled ? 'No electron is waiting at plastocyanin yet — fire PSII first.' : '';
      breakB.setAttribute('aria-pressed', String(st.broken));
      breakB.textContent = st.broken ? 'Repair PSII' : 'Break PSII';
      badge.setAttribute('opacity', st.broken ? '1' : '0');
      fillTank();
    }

    const waiting = () => st.parked === 1 ? '1 e⁻ waits at plastocyanin' : `${st.parked} e⁻ wait at plastocyanin`;

    // One PSII firing: lift P680→P680*, slide the electron down to plastocyanin.
    // 4 PSII photons split 2 H2O → 1 O2 + 4 H+ (into the lumen) + 4 e-.
    // The b6f Q-cycle pumps ~2 extra H+ per electron (~4 per pair), so 3 H+ land in the lumen per electron.
    function runPSII(): void {
      if (st.broken) return;
      st.photons += 1;
      st.psii += 1;
      st.electrons += 1;
      st.parked += 1;
      st.protons += 3;
      if (st.psii % 4 === 0) st.o2 += 1;
      renderCounters();
      run(PSII_PATH);
      stageEl.textContent =
        'PSII fires: the 680-nm photon lifts P680 to P680* (the big upstroke on the left). '
        + 'The excited electron jumps to pheophytin and slides DOWNHILL — QA → QB → cytochrome b₆f → plastocyanin — '
        + 'and the Q-cycle at b₆f pumps H⁺ into the lumen on the way. P680⁺, left behind, is the strongest oxidant in biology and rips a '
        + 'replacement electron off water. The electron now waits at plastocyanin: fire PSI to lift it again.';
      netEl.textContent =
        st.psii % 4 === 0
          ? `Net so far: ${st.psii} PSII photons have split ${st.o2 * 2} H₂O → ${st.o2} O₂; ${st.protons} H⁺ banked in the lumen; ${waiting()}.`
          : `Net so far: ${st.psii} PSII photon(s), ${st.protons} H⁺ in the lumen, ${waiting()}. ${4 - (st.psii % 4)} more PSII photon(s) until the next O₂ (water gives up 4 e⁻ per O₂).`;
    }

    // One PSI firing: takes the electron waiting at plastocyanin, lifts P700→P700*, slides to NADP+.
    // One photon per electron at PSI; 2 e- (so 2 PSI photons) → 1 NADPH.
    function runPSI(): void {
      if (st.parked === 0) {
        if (!st.broken) return;
        // Break-PSII experiment: PSI absorbs, but nothing refills P700⁺.
        st.photons += 1;
        renderCounters();
        cancelAnimationFrame(raf);
        clearTrail();
        place(NODES[IDX['p700']].x, ey(NODES[IDX['p700']].E));
        stageEl.textContent =
          'PSI absorbs the photon — but P700⁺ has no electron coming to refill it. With PSII broken, nothing pulls '
          + 'electrons off water, so plastocyanin stays empty and the chain has starved: no new O₂, no new H⁺, no new NADPH. '
          + 'PSI working alone cannot run linear flow. (Press "Repair PSII" to restart the supply.)';
        netEl.textContent = `Net so far: ${st.photons} photons absorbed, but the last one did no chemistry. O₂ stuck at ${st.o2}, NADPH stuck at ${st.nadph}.`;
        return;
      }
      st.photons += 1;
      st.psi += 1;
      st.parked -= 1;
      if (st.psi % 2 === 0) st.nadph += 1;
      renderCounters();
      run(PSI_PATH);
      stageEl.textContent =
        'PSI fires: the 700-nm photon lifts P700 to P700* (the second, even higher upstroke). '
        + 'From P700* the electron passes A₀ → A₁ → ferredoxin → FNR and finally reduces NADP⁺. '
        + 'P700⁺ is refilled by the electron plastocyanin was holding — closing the gap between the two photosystems. '
        + 'NADP⁺ takes two electrons, so two PSI firings make one NADPH.';
      const next = st.psi % 2 === 1 ? ' One more PSI electron completes the next NADPH.' : '';
      const refill = st.parked > 0 ? ` ${waiting()} — fire PSI again.` : st.broken ? ' Plastocyanin is now empty, and with PSII broken nothing will refill it.' : ' Plastocyanin is empty — fire PSII to reload it.';
      netEl.textContent =
        `Net so far: ${st.photons} photons absorbed, ${st.protons} H⁺ in the lumen, ${st.o2} O₂ released, ${st.nadph} NADPH made.` + next + refill;
    }

    function toggleBreak(): void {
      st.broken = !st.broken;
      renderCounters();
      stageEl.textContent = st.broken
        ? 'PSII is broken (red ✕): no photon can lift P680, so no electrons are pulled off water. '
          + (st.parked > 0 ? `PSI can still use the ${st.parked} electron(s) already waiting at plastocyanin — then keep firing PSI and watch what happens.` : 'Fire PSI and watch what happens with nothing arriving from water.')
        : 'PSII is repaired. Water can supply electrons again — fire PSII to reload plastocyanin.';
    }

    function reset(): void {
      cancelAnimationFrame(raf);
      clearTrail();
      st = fresh();
      place(-20, -20);
      renderCounters();
      stageEl.textContent =
        'Each carrier sits at its reduction potential: higher on the plot = a more negative E = a higher-energy electron. '
        + 'Two photons each push an electron uphill; between and after them it slides downhill — a literal Z. '
        + 'Fire a photon at PSII to start an electron on its journey from water.';
      netEl.textContent = 'Net so far: nothing fired yet. Water is intact, the lumen is empty, no NADPH.';
    }

    firePSII.addEventListener('click', runPSII);
    firePSI.addEventListener('click', runPSI);
    breakB.addEventListener('click', toggleBreak);
    resetB.addEventListener('click', reset);
    reset();
  });
</script>

