---
/**
 * BreederResponseSketch — the breeder's equation, R = h² × S, as three stacked trait curves
 * on one millimetre axis: the starting population (mean 9.40 mm), the survivors who breed,
 * and the predicted offspring. The learner moves the survivors' mean and the heritability.
 * S (survivors minus start) is read within one generation; R (h² × S) is the predicted
 * change across generations. Numbers and rules are the lesson's worked problem; the curve
 * widths are a sketch, not to scale. Self-contained vanilla-TS Astro island. Original.
 */
---

<figure class="brs card" data-breedersketch>
  <figcaption class="brs-head">Breeder’s equation: survivors and their offspring<span class="brs-chip">⚙ original · interactive</span></figcaption>

  <svg class="brs-svg" viewBox="0 0 340 250" role="img" aria-label="Three beak-depth curves on one millimetre axis: the starting population, the survivors that breed, and the predicted offspring" data-plot></svg>

  <div class="brs-controls">
    <label class="brs-slabel"><span>Survivors’ mean beak depth <em data-out="sv">9.80</em> mm</span>
      <input type="range" data-in="sv" min="8.80" max="10.00" step="0.05" value="9.80" />
    </label>
    <label class="brs-slabel"><span>Narrow-sense heritability h² <em data-out="h2">0.60</em></span>
      <input type="range" data-in="h2" min="0" max="1" step="0.05" value="0.60" />
    </label>
  </div>

  <dl class="brs-readout">
    <div><dt>S, within one generation</dt><dd data-r-s></dd></div>
    <div><dt>R = h² × S, across generations</dt><dd data-r-r></dd></div>
    <div><dt>Predicted offspring mean</dt><dd data-r-off></dd></div>
    <div><dt>Check: R ÷ S</dt><dd data-r-chk></dd></div>
  </dl>
  <p class="brs-why" data-why role="status"></p>

  <p class="brs-assume">In this sketch: an additive model, no correlated trait under selection, and offspring reared in the same environment as their parents. Curve widths are drawn as a sketch, not to scale. The numbers are illustrative, not the Grants’.</p>
  <p class="brs-foot">S happens within a generation and R across generations; only R is evolution, and the prediction is only a prediction until offspring are measured.</p>
</figure>

<script>
  const NS = 'http://www.w3.org/2000/svg';
  const START = 9.4;
  const INK = '#4b4b55', FAINT = '#b9b9c2', GREY = '#8a8a95', ORANGE = '#e57200', ACCENT = '#0e7c86';
  function el(name: string, attrs: Record<string, string | number>): SVGElement {
    const e = document.createElementNS(NS, name);
    for (const k in attrs) e.setAttribute(k, String(attrs[k]));
    return e;
  }
  const fix = (v: number) => (Math.abs(v) < 0.005 ? 0 : v);
  const f2 = (v: number) => fix(v).toFixed(2);
  const sgn = (v: number) => (fix(v) > 0 ? '+' : '') + f2(v);

  document.querySelectorAll<HTMLElement>('[data-breedersketch]').forEach((root) => {
    const plot = root.querySelector<SVGSVGElement>('[data-plot]')!;
    const o = (s: string) => root.querySelector<HTMLElement>(s)!;
    const svIn = root.querySelector<HTMLInputElement>('[data-in="sv"]')!;
    const h2In = root.querySelector<HTMLInputElement>('[data-in="h2"]')!;
    const svOut = o('[data-out="sv"]'), h2Out = o('[data-out="h2"]');
    const rS = o('[data-r-s]'), rR = o('[data-r-r]'), rOff = o('[data-r-off]'), rChk = o('[data-r-chk]'), why = o('[data-why]');

    const X0 = 22, X1 = 326, MMIN = 8.0, MMAX = 10.8, SD = 0.25;
    const px = (m: number) => X0 + ((m - MMIN) / (MMAX - MMIN)) * (X1 - X0);
    const LANE = 58, TOP = 6, PEAK = 34;
    const base = (i: number) => TOP + LANE * (i + 1) - 2;
    const AXY = TOP + LANE * 3;

    function bell(i: number, mean: number, color: string): void {
      const y0 = base(i);
      let d = 'M' + px(MMIN).toFixed(1) + ' ' + y0;
      for (let m = MMIN; m <= MMAX + 1e-9; m += 0.02) {
        const h = PEAK * Math.exp(-((m - mean) ** 2) / (2 * SD * SD));
        d += ' L' + px(m).toFixed(1) + ' ' + (y0 - h).toFixed(1);
      }
      d += ' L' + px(MMAX).toFixed(1) + ' ' + y0 + ' Z';
      plot.appendChild(el('path', { d, fill: color, 'fill-opacity': 0.25, stroke: color, 'stroke-width': 1.8 }));
      plot.appendChild(el('line', { x1: px(mean), y1: y0 - PEAK - 2, x2: px(mean), y2: y0, stroke: color, 'stroke-width': 1.6 }));
    }
    function txt(x: number, y: number, s: string, color: string, bold = false): void {
      const t = el('text', { x, y, 'font-size': 9, fill: color, 'font-weight': bold ? 700 : 400, stroke: '#fff', 'stroke-width': 3, 'stroke-linejoin': 'round', 'paint-order': 'stroke' });
      t.textContent = s;
      plot.appendChild(t);
    }
    function arrow(i: number, from: number, to: number, color: string): void {
      if (Math.abs(to - from) < 0.005) return;
      const y = TOP + LANE * i + 17, a = px(from), b = px(to), dir = b > a ? 1 : -1;
      plot.appendChild(el('line', { x1: a, y1: y, x2: b - dir * 4, y2: y, stroke: color, 'stroke-width': 1.6 }));
      plot.appendChild(el('polygon', { points: `${b},${y} ${b - dir * 6},${y - 3} ${b - dir * 6},${y + 3}`, fill: color }));
    }

    function render() {
      const sv = Math.round(parseFloat(svIn.value) * 100) / 100;
      const h2 = Math.round(parseFloat(h2In.value) * 100) / 100;
      const S = Math.round((sv - START) * 100) / 100;
      const Rraw = h2 * S;
      const R = Math.sign(Rraw) * Math.round(Math.abs(Rraw) * 100 + 1e-9) / 100;
      const off = Math.round((START + R) * 100) / 100;

      svOut.textContent = sv.toFixed(2);
      h2Out.textContent = h2.toFixed(2);
      rS.textContent = sgn(S) + ' mm';
      rR.textContent = sgn(R) + ' mm';
      rOff.textContent = off.toFixed(2) + ' mm';
      rChk.textContent = Math.abs(S) < 0.005 ? 'undefined (S = 0)' : (R / S).toFixed(2);

      plot.replaceChildren();
      // axis, ticks, labels
      plot.appendChild(el('line', { x1: X0, y1: AXY, x2: X1, y2: AXY, stroke: INK, 'stroke-width': 1 }));
      for (let m = 8.0; m <= 10.81; m += 0.4) {
        plot.appendChild(el('line', { x1: px(m), y1: AXY, x2: px(m), y2: AXY + 3, stroke: INK, 'stroke-width': 1 }));
        const t = el('text', { x: px(m), y: AXY + 14, 'text-anchor': 'middle', 'font-size': 9, fill: INK });
        t.textContent = m.toFixed(1);
        plot.appendChild(t);
      }
      const xl = el('text', { x: (X0 + X1) / 2, y: AXY + 28, 'text-anchor': 'middle', 'font-size': 10, fill: INK });
      xl.textContent = 'beak depth (mm); curve widths are a sketch, not to scale';
      plot.appendChild(xl);
      // lane separators
      for (const i of [1, 2]) plot.appendChild(el('line', { x1: X0, y1: TOP + LANE * i - 1, x2: X1, y2: TOP + LANE * i - 1, stroke: '#e3e3e8', 'stroke-width': 1 }));
      // guide lines: starting mean through all lanes; survivors' mean faint in the offspring lane
      plot.appendChild(el('line', { x1: px(START), y1: TOP, x2: px(START), y2: AXY, stroke: GREY, 'stroke-width': 1, 'stroke-dasharray': '3 3' }));
      if (Math.abs(S) >= 0.005) {
        plot.appendChild(el('line', { x1: px(sv), y1: TOP + LANE * 2, x2: px(sv), y2: AXY, stroke: ORANGE, 'stroke-width': 1, 'stroke-dasharray': '2 3' }));
      }
      // curves
      bell(0, START, GREY);
      bell(1, sv, ORANGE);
      bell(2, off, ACCENT);
      // arrows
      arrow(1, START, sv, ORANGE);
      arrow(2, START, off, ACCENT);
      // lane labels (fixed positions, in the header band of each lane)
      txt(X0 + 2, TOP + 9, 'Starting population, mean 9.40 mm', INK, true);
      txt(X0 + 2, TOP + LANE + 9, `Survivors that breed, mean ${sv.toFixed(2)} mm (S = ${sgn(S)} mm)`, ORANGE, true);
      txt(X0 + 2, TOP + LANE * 2 + 9, `Predicted offspring, mean ${off.toFixed(2)} mm (R = ${sgn(R)} mm)`, ACCENT, true);

      const survivorsWord = S > 0 ? 'deeper' : 'shallower';
      if (Math.abs(S) < 0.005 && h2 < 0.005) {
        why.textContent = 'The survivors’ mean equals the starting mean, so S = 0, and h² is also 0. R = 0 either way: the predicted offspring match the population before the drought.';
      } else if (Math.abs(S) < 0.005) {
        why.textContent = 'The survivors’ mean equals the starting mean, so S = 0. R = 0 whatever h² is, and the predicted offspring look like the starting population.';
      } else if (h2 < 0.005) {
        why.textContent = `Selection happened within this generation: the survivors’ beaks are ${survivorsWord} than the starting mean, S = ${sgn(S)} mm. But h² = 0, so R = 0 however strong the selection: the survivors’ children are predicted to look like the population before the drought.`;
      } else {
        const lead = S > 0
          ? `Survivors have ${survivorsWord} beaks than the starting mean: S = ${sgn(S)} mm, selection within one generation.`
          : `Survivors have ${survivorsWord} beaks than the starting mean: S = ${sgn(S)} mm, selection within one generation, here in the opposite direction.`;
        const share = h2 > 0.995
          ? ' With h² = 1 the predicted offspring match the survivors’ mean exactly.'
          : ` R = h² × S, so h² = ${h2.toFixed(2)} sets how much of S carries to the offspring.`;
        why.textContent = `${lead} R = ${h2.toFixed(2)} × ${sgn(S)} = ${sgn(R)} mm, so the predicted offspring mean is ${off.toFixed(2)} mm.${share} This is a prediction; measured offspring would test it.`;
      }
    }
    [svIn, h2In].forEach((s) => s.addEventListener('input', render));
    render();
  });
</script>

<style>
  .brs { padding: var(--ddp-space-3) var(--ddp-space-4) var(--ddp-space-4); margin: var(--ddp-space-5) 0; }
  .brs-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem; font-weight: 600; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); margin-bottom: var(--ddp-space-3); }
  .brs-chip { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 400; color: var(--ddp-color-muted); }
  .brs-svg { display: block; width: 100%; max-width: 560px; margin: 0 auto; height: auto; background: #fff; border: 1px solid var(--ddp-color-line); border-radius: 6px; }
  .brs-controls { display: grid; grid-template-columns: 1fr 1fr; gap: var(--ddp-space-2) var(--ddp-space-4); margin: var(--ddp-space-3) 0 var(--ddp-space-2); }
  .brs-slabel { display: flex; flex-direction: column; gap: 0.1rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .brs-slabel em { font-style: normal; font-weight: 700; color: var(--ddp-color-accent); font-family: var(--ddp-font-mono); }
  .brs-slabel input { accent-color: var(--ddp-color-accent); }
  .brs-readout { display: grid; grid-template-columns: 1fr 1fr; gap: var(--ddp-space-2); margin: var(--ddp-space-2) 0; padding: var(--ddp-space-2) var(--ddp-space-3); background: color-mix(in srgb, var(--ddp-color-accent) 8%, transparent); border-radius: 6px; }
  .brs-readout div { display: flex; flex-direction: column; gap: 0.1rem; }
  .brs-readout dt { font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .brs-readout dd { margin: 0; font-family: var(--ddp-font-mono); font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); font-weight: 700; }
  .brs-why { margin: 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); line-height: 1.5; min-height: 6em; }
  .brs-assume { margin: var(--ddp-space-2) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); line-height: 1.5; }
  .brs-foot { margin: var(--ddp-space-2) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); border-left: 3px solid var(--ddp-color-secondary); padding-left: 0.55rem; }
  @media (max-width: 480px) { .brs-controls { grid-template-columns: 1fr; } }
</style>
