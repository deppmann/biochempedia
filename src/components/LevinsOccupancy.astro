---
/**
 * LevinsOccupancy — the Levins patch-occupancy model, dp/dt = c p (1 - p) - e p.
 * 100 identical, equally reachable patches, each occupied or empty. The deterministic
 * curve (teal) is drawn beside one random run of the same rules (orange); a year slider
 * shows the patches at that year. Original, self-contained vanilla-TS island.
 */
---

<figure class="lv card" data-levins>
  <figcaption class="lv-head">Levins model — 100 patches, colonization against extinction<span class="lv-chip">⚙ original · interactive</span></figcaption>

  <div class="lv-panels">
    <svg class="lv-grid" viewBox="0 0 200 232" role="img" aria-label="A ten by ten grid of habitat patches, each filled if occupied or empty" data-grid></svg>
    <svg class="lv-plot" viewBox="0 0 340 232" role="img" aria-label="Occupied fraction p against years: a deterministic curve and one random run" data-plot></svg>
  </div>

  <div class="lv-controls">
    <label class="lv-slabel"><span>Colonization c <em data-out="c">0.40</em> per year</span>
      <input type="range" data-in="c" min="0.05" max="0.8" step="0.05" value="0.4" />
    </label>
    <label class="lv-slabel"><span>Extinction e <em data-out="e">0.10</em> per year</span>
      <input type="range" data-in="e" min="0.05" max="0.8" step="0.05" value="0.1" />
    </label>
    <label class="lv-slabel"><span>Show patches at year <em data-out="y">10</em></span>
      <input type="range" data-in="y" min="0" max="20" step="1" value="10" />
    </label>
    <button type="button" class="lv-btn" data-resample>Resample</button>
  </div>

  <dl class="lv-readout">
    <div><dt>Equilibrium p* = 1 − e/c</dt><dd data-r-pstar>0.75</dd></div>
    <div><dt>Expected p at this year</dt><dd data-r-exp>—</dd></div>
    <div><dt>Observed (this run)</dt><dd data-r-obs>—</dd></div>
    <div><dt>Colonizations in the year: expected | observed</dt><dd data-r-col>—</dd></div>
    <div><dt>Extinctions in the year: expected | observed</dt><dd data-r-ext>—</dd></div>
  </dl>
  <p class="lv-why" data-why role="status"></p>

  <p class="lv-assume"><strong>In this sketch:</strong> 100 identical patches, all equally reachable from every other, constant c and e, no rescue effect; the run starts with 75 patches occupied, and the random run is one draw (Resample for another). Rates apply in 0.05-year steps (a sketch choice); expected and observed counts differ by chance, since this is one random draw.</p>
  <p class="lv-foot">Keep the rule: occupancy settles at p* = 1 − e/c only when c is greater than e; patches keep changing state even when the fraction does not.</p>
</figure>

<script>
  const NS = 'http://www.w3.org/2000/svg';
  const ACCENT = '#0e7c86', ORANGE = '#e57200', INK = '#4b4b55', FAINT = '#b9b9c2';
  function el(name: string, attrs: Record<string, string | number>): SVGElement {
    const e = document.createElementNS(NS, name);
    for (const k in attrs) e.setAttribute(k, String(attrs[k]));
    return e;
  }
  function rng(seed: number) {
    let a = seed >>> 0;
    return () => { a = (a + 0x6d2b79f5) >>> 0; let t = a; t = Math.imul(t ^ (t >>> 15), t | 1); t ^= t + Math.imul(t ^ (t >>> 7), t | 61); return ((t ^ (t >>> 14)) >>> 0) / 4294967296; };
  }
  const N = 100, YEARS = 20, DT = 0.05, SPY = 20, P0 = 0.75;

  document.querySelectorAll<HTMLElement>('[data-levins]').forEach((root) => {
    const grid = root.querySelector<SVGSVGElement>('[data-grid]')!;
    const plot = root.querySelector<SVGSVGElement>('[data-plot]')!;
    const inp = (k: string) => root.querySelector<HTMLInputElement>(`[data-in="${k}"]`)!;
    const outp = (k: string) => root.querySelector<HTMLElement>(`[data-out="${k}"]`)!;
    const o = (s: string) => root.querySelector<HTMLElement>(s)!;
    const cIn = inp('c'), eIn = inp('e'), yIn = inp('y');
    const rPstar = o('[data-r-pstar]'), rExp = o('[data-r-exp]'), rObs = o('[data-r-obs]'), rCol = o('[data-r-col]'), rExt = o('[data-r-ext]'), why = o('[data-why]');
    const btn = root.querySelector<HTMLButtonElement>('[data-resample]')!;

    let seed = 20240718;
    // random run: state snapshots per year, event counts per year
    let snaps: boolean[][] = [], colEv: number[] = [], extEv: number[] = [];
    let runC = -1, runE = -1;

    function simulate(c: number, e: number) {
      const r = rng(seed);
      let s: boolean[] = Array.from({ length: N }, (_, i) => i < Math.round(P0 * N));
      for (let i = N - 1; i > 0; i--) { const j = Math.floor(r() * (i + 1)); [s[i], s[j]] = [s[j], s[i]]; }
      snaps = [s.slice()]; colEv = [0]; extEv = [0];
      let col = 0, ext = 0;
      for (let step = 1; step <= YEARS * SPY; step++) {
        const p = s.filter(Boolean).length / N;
        const next = s.slice();
        for (let i = 0; i < N; i++) {
          if (s[i]) { if (r() < e * DT) { next[i] = false; ext++; } }
          else if (r() < c * p * DT) { next[i] = true; col++; }
        }
        s = next;
        if (step % SPY === 0) { snaps.push(s.slice()); colEv.push(col); extEv.push(ext); col = 0; ext = 0; }
      }
      runC = c; runE = e;
    }

    // deterministic: RK4 on dp/dt = c p (1-p) - e p; also integrates the two terms per year
    function deterministic(c: number, e: number) {
      const f = (p: number) => c * p * (1 - p) - e * p;
      const h = 0.01, per = Math.round(1 / h);
      const p: number[] = [P0]; const col: number[] = [0], ext: number[] = [0];
      let x = P0;
      for (let yr = 1; yr <= YEARS; yr++) {
        let cs = 0, es = 0;
        for (let k = 0; k < per; k++) {
          cs += c * x * (1 - x) * h; es += e * x * h;
          const k1 = f(x), k2 = f(x + 0.5 * h * k1), k3 = f(x + 0.5 * h * k2), k4 = f(x + h * k3);
          x += (h / 6) * (k1 + 2 * k2 + 2 * k3 + k4);
        }
        p.push(x); col.push(cs * N); ext.push(es * N);
      }
      return { p, col, ext };
    }

    const GX = 10, GY = 22, CELL = 18;
    const PX0 = 40, PX1 = 326, PY0 = 22, PY1 = 190;
    const px = (t: number) => PX0 + (t / YEARS) * (PX1 - PX0);
    const py = (v: number) => PY1 - v * (PY1 - PY0);
    function txt(svg: SVGElement, x: number, y: number, s: string, extra: Record<string, string | number> = {}) {
      const t = el('text', { x, y, 'font-size': 10, fill: INK, ...extra }); t.textContent = s; svg.appendChild(t);
    }

    function render() {
      const ci = Math.round(parseFloat(cIn.value) * 100), ei = Math.round(parseFloat(eIn.value) * 100);
      const c = ci / 100, e = ei / 100, yr = parseInt(yIn.value, 10);
      outp('c').textContent = c.toFixed(2); outp('e').textContent = e.toFixed(2); outp('y').textContent = String(yr);
      if (c !== runC || e !== runE) simulate(c, e);
      const det = deterministic(c, e);
      const pstar = ci > ei ? 1 - e / c : 0;
      const s = snaps[yr];
      const nOcc = s.filter(Boolean).length;
      const expP = det.p[yr];

      // patches
      grid.replaceChildren();
      txt(grid, 100, 14, `Year ${yr}: ${nOcc} of 100 occupied`, { 'text-anchor': 'middle' });
      for (let i = 0; i < N; i++) {
        const gx = GX + (i % 10) * CELL, gy = GY + Math.floor(i / 10) * CELL;
        grid.appendChild(el('rect', { x: gx, y: gy, width: CELL - 2, height: CELL - 2, rx: 2, fill: s[i] ? ACCENT : '#fff', stroke: s[i] ? ACCENT : FAINT, 'stroke-width': 1 }));
      }
      txt(grid, 100, GY + 10 * CELL + 14, 'filled = occupied, open = empty', { 'text-anchor': 'middle', 'font-size': 9 });
      txt(grid, 100, GY + 10 * CELL + 27, 'which patches are filled keeps changing', { 'text-anchor': 'middle', 'font-size': 9 });

      // plot
      plot.replaceChildren();
      plot.appendChild(el('line', { x1: PX0, y1: PY0, x2: PX0, y2: PY1, stroke: INK, 'stroke-width': 1 }));
      plot.appendChild(el('line', { x1: PX0, y1: PY1, x2: PX1, y2: PY1, stroke: INK, 'stroke-width': 1 }));
      for (const v of [0, 0.5, 1]) {
        plot.appendChild(el('line', { x1: PX0, y1: py(v), x2: PX1, y2: py(v), stroke: FAINT, 'stroke-width': 0.6, 'stroke-dasharray': '2 3' }));
        txt(plot, PX0 - 4, py(v) + 3, v.toFixed(1), { 'text-anchor': 'end', 'font-size': 9 });
      }
      for (const t of [0, 5, 10, 15, 20]) {
        plot.appendChild(el('line', { x1: px(t), y1: PY1, x2: px(t), y2: PY1 + 3, stroke: INK, 'stroke-width': 1 }));
        txt(plot, px(t), PY1 + 14, String(t), { 'text-anchor': 'middle', 'font-size': 9 });
      }
      txt(plot, (PX0 + PX1) / 2, PY1 + 28, 'time (years)', { 'text-anchor': 'middle' });
      txt(plot, PX0 - 2, PY0 - 8, 'occupied fraction p', { 'text-anchor': 'start' });
      if (pstar > 0) {
        plot.appendChild(el('line', { x1: PX0, y1: py(pstar), x2: PX1, y2: py(pstar), stroke: INK, 'stroke-width': 1, 'stroke-dasharray': '5 3' }));
      }
      let d = '';
      for (let t = 0; t <= YEARS; t++) d += (t ? 'L' : 'M') + px(t).toFixed(1) + ' ' + py(det.p[t]).toFixed(1) + ' ';
      plot.appendChild(el('path', { d: d.trim(), fill: 'none', stroke: ACCENT, 'stroke-width': 2.6 }));
      let d2 = '';
      for (let t = 0; t <= YEARS; t++) d2 += (t ? 'L' : 'M') + px(t).toFixed(1) + ' ' + py(snaps[t].filter(Boolean).length / N).toFixed(1) + ' ';
      plot.appendChild(el('path', { d: d2.trim(), fill: 'none', stroke: ORANGE, 'stroke-width': 1.8 }));
      plot.appendChild(el('line', { x1: px(yr), y1: PY0, x2: px(yr), y2: PY1, stroke: INK, 'stroke-width': 1, 'stroke-dasharray': '2 2' }));
      plot.appendChild(el('circle', { cx: px(yr), cy: py(expP), r: 4, fill: ACCENT }));
      plot.appendChild(el('circle', { cx: px(yr), cy: py(nOcc / N), r: 4, fill: ORANGE }));
      // legend under title row, right-aligned in the top margin
      plot.appendChild(el('line', { x1: 150, y1: 6, x2: 166, y2: 6, stroke: ACCENT, 'stroke-width': 2.6 }));
      txt(plot, 170, 9, 'expected', { 'font-size': 9 });
      plot.appendChild(el('line', { x1: 220, y1: 6, x2: 236, y2: 6, stroke: ORANGE, 'stroke-width': 1.8 }));
      txt(plot, 240, 9, 'one random run', { 'font-size': 9 });
      if (pstar > 0) {
        plot.appendChild(el('line', { x1: 150, y1: 17, x2: 166, y2: 17, stroke: INK, 'stroke-width': 1, 'stroke-dasharray': '5 3' }));
        txt(plot, 170, 20, `p* = ${pstar.toFixed(2)}`, { 'font-size': 9 });
      }

      // readouts
      rPstar.textContent = pstar.toFixed(2) + (ci > ei ? '' : ' (reported as 0)');
      rExp.textContent = expP.toFixed(2);
      rObs.textContent = `${nOcc} of 100 = ${(nOcc / N).toFixed(2)}`;
      if (yr === 0) { rCol.textContent = '—'; rExt.textContent = '—'; }
      else {
        rCol.textContent = `${det.col[yr].toFixed(1)} | ${colEv[yr]}`;
        rExt.textContent = `${det.ext[yr].toFixed(1)} | ${extEv[yr]}`;
      }

      // status
      let msg: string;
      if (ci > ei) {
        msg = `Here c = ${c.toFixed(2)} is greater than e = ${e.toFixed(2)}, so p* = 1 − ${e.toFixed(2)}/${c.toFixed(2)} = ${pstar.toFixed(2)}: about ${Math.round(pstar * 100)} patches in 100 are occupied at equilibrium. `;
        msg += yr === 0
          ? 'At year 0, 75 patches are occupied.'
          : `At year ${yr} the model gives ${expP.toFixed(2)} and this run has ${nOcc} of 100; in the year just ended ${extEv[yr]} occupied patches lost their populations and ${colEv[yr]} empty patches were colonized, so which patches are filled keeps changing.`;
      } else if (ci === ei) {
        msg = `Here c = e = ${c.toFixed(2)}, so p* = 1 − e/c = 0 and the network is lost, but slowly: the equation becomes dp/dt = −${c.toFixed(2)} p², and from 0.75 the model gives ${expP.toFixed(2)} at year ${yr}. Patches are still occupied for years, which does not show the region is persisting.`;
      } else {
        msg = `Here e = ${e.toFixed(2)} is greater than c = ${c.toFixed(2)}, so 1 − e/c is negative; a positive equilibrium needs c greater than e. The only equilibrium is p* = 0, and occupied patches dwindle over the years (model ${expP.toFixed(2)} at year ${yr}).`;
      }
      why.textContent = msg;
    }

    [cIn, eIn, yIn].forEach((x) => x.addEventListener('input', render));
    btn.addEventListener('click', () => { seed = Math.floor(Math.random() * 4294967296); runC = -1; render(); });
    render();
  });
</script>

<style>
  .lv { padding: var(--ddp-space-3) var(--ddp-space-4) var(--ddp-space-4); margin: var(--ddp-space-5) 0; }
  .lv-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem; font-weight: 600; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); margin-bottom: var(--ddp-space-3); }
  .lv-chip { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 400; color: var(--ddp-color-muted); }
  .lv-panels { display: grid; grid-template-columns: 1fr; gap: var(--ddp-space-2); }
  @media (min-width: 640px) { .lv-panels { grid-template-columns: 200px 1fr; align-items: start; } }
  .lv-grid, .lv-plot { display: block; width: 100%; height: auto; background: #fff; border: 1px solid var(--ddp-color-line); border-radius: 6px; }
  .lv-grid { max-width: 240px; margin: 0 auto; }
  .lv-plot { max-width: 560px; margin: 0 auto; }
  .lv-controls { display: grid; grid-template-columns: 1fr 1fr; gap: var(--ddp-space-2) var(--ddp-space-4); margin: var(--ddp-space-3) 0 var(--ddp-space-2); align-items: end; }
  @media (max-width: 520px) { .lv-controls { grid-template-columns: 1fr; } }
  .lv-slabel { display: flex; flex-direction: column; gap: 0.1rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .lv-slabel em { font-style: normal; font-weight: 700; color: var(--ddp-color-accent); font-family: var(--ddp-font-mono); }
  .lv-slabel input { accent-color: var(--ddp-color-accent); }
  .lv-btn { justify-self: start; font: inherit; font-size: var(--ddp-text-xs); font-weight: 600; padding: 0.35rem 0.9rem; border-radius: 6px; border: 1px solid var(--ddp-color-accent); background: #fff; color: var(--ddp-color-accent); cursor: pointer; }
  .lv-btn:hover, .lv-btn:focus-visible { background: var(--ddp-color-accent); color: #fff; }
  .lv-readout { display: grid; grid-template-columns: 1fr 1fr; gap: var(--ddp-space-2); margin: var(--ddp-space-2) 0; padding: var(--ddp-space-2) var(--ddp-space-3); background: color-mix(in srgb, var(--ddp-color-accent) 8%, transparent); border-radius: 6px; }
  @media (max-width: 520px) { .lv-readout { grid-template-columns: 1fr; } }
  .lv-readout div { display: flex; flex-direction: column; gap: 0.1rem; }
  .lv-readout dt { font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .lv-readout dd { margin: 0; font-family: var(--ddp-font-mono); font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); font-weight: 700; }
  .lv-why { margin: 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); line-height: 1.5; min-height: 5em; }
  .lv-assume { margin: var(--ddp-space-2) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .lv-foot { margin: var(--ddp-space-3) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); border-left: 3px solid var(--ddp-color-secondary); padding-left: 0.55rem; }
</style>
