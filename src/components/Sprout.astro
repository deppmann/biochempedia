---
/**
 * A plant that is one stage taller for each rung of the ladder: a seed for the first stage,
 * a flower for the last. Drawn in the engraving style of the lesson icons (navy line, gold
 * accent) and used beside the stage names on the homepage and /courses/. Decorative only.
 * It sways a little; the sway is off under reduced motion.
 */
interface Props {
  /** 0-based stage. */
  step: number;
  /** How many stages there are; the last one flowers. */
  total: number;
  /** Rendered height in px. */
  size?: number;
}
const { step, total, size = 32 } = Astro.props;
const last = step >= total - 1;
const h = 9 + step * (20.8 / Math.max(1, total - 1));
const top = 37 - h;
const bend = step % 2 ? 1.6 : -1.6;
const r = (n: number) => Math.round(n * 10) / 10;
const leaves = Array.from({ length: step }, (_, i) => {
  const y = r(33 - i * ((h - 6) / Math.max(1, step)));
  const s = i % 2 ? -1 : 1;
  return `M14 ${y} c${3 * s} -5 ${7 * s} -4 ${8.5 * s} -3 c${-1.5 * s} 3 ${-5 * s} 4.5 ${-8.5 * s} 3 Z`;
});
const petals = [0, 72, 144, 216, 288].map((a) => {
  const t = ((a - 90) * Math.PI) / 180;
  return { x: r(14 + 3.9 * Math.cos(t)), y: r(top + 3.9 * Math.sin(t)) };
});
---

<svg class="sprout" viewBox="0 0 28 40" width={Math.round(size * 0.7)} height={size} aria-hidden="true" focusable="false" style={`--sway-delay:${(step * -0.7).toFixed(1)}s`}>
  <path class="soil" d="M4 37.5 H24" />
  <g class="plant">
    {step === 0 ? (
      <>
        <path d="M15.5 31.5 q-0.5 -6 4.5 -8" />
        <ellipse class="gold" cx="14" cy="33.6" rx="5" ry="3.3" transform="rotate(-18 14 33.6)" />
      </>
    ) : (
      <>
        <path d={`M14 37.5 Q${14 + bend} ${r(37 - h / 2)} 14 ${r(top)}`} />
        {leaves.map((d) => <path d={d} />)}
        {last
          ? <>{petals.map((p) => <circle class="petal" cx={p.x} cy={p.y} r="2.1" />)}<circle class="gold" cx="14" cy={r(top)} r="2.3" /></>
          : <circle class="gold" cx="14" cy={r(top)} r="1.7" />}
      </>
    )}
  </g>
</svg>

<style>
  .sprout { flex: none; overflow: visible; color: var(--ddp-color-primary); fill: none; stroke: currentColor; stroke-width: 1.4; stroke-linecap: round; stroke-linejoin: round; }
  .soil { opacity: 0.45; }
  .gold { fill: var(--ddp-color-secondary); stroke: none; }
  .petal { fill: var(--ddp-color-surface); }
  .plant { transform-box: view-box; transform-origin: 14px 37px; animation: sproutSway 5.5s ease-in-out var(--sway-delay, 0s) infinite alternate; }
  @keyframes sproutSway { from { transform: rotate(-3.5deg); } to { transform: rotate(3.5deg); } }
  @media (prefers-reduced-motion: reduce) { .plant { animation: none; } }
</style>
