---
/**
 * OneHitTwoHits — a gain acts through one altered copy; loss of an off-step usually needs
 * both copies gone. The learner picks a gene class (an on-step such as Ras, an off-step such
 * as neurofibromin) and sets each of two copies to normal or altered. One lamp shows whether
 * that step of the pathway is stuck on. Every rule is a statement of the oncogenes lesson,
 * including its "usually" and the exceptions it names (shown as a note, not as controls).
 * Labelled blocks only; no molecular structures. Self-contained vanilla-TS Astro island. Original.
 */
---

<figure class="oh card" data-onehit>
  <figcaption class="oh-head">One hit or two: when does the switch stick?<span class="oh-chip">⚙ original · interactive</span></figcaption>

  <svg class="oh-svg" viewBox="0 0 360 190" role="img" aria-label="Two labelled copies of a gene feeding one step of a pathway, and a lamp that lights when the step is stuck on" data-stage></svg>

  <div class="oh-controls">
    <label class="oh-field">Gene class
      <select data-cls>
        <option value="on">On-step, e.g. Ras (oncogene)</option>
        <option value="off">Off-step, e.g. neurofibromin, the GAP for Ras (tumour suppressor)</option>
      </select>
    </label>
    <label class="oh-field">Copy 1
      <select data-c1></select>
    </label>
    <label class="oh-field">Copy 2
      <select data-c2></select>
    </label>
  </div>

  <p class="oh-verdict" data-verdict role="status"></p>

  <p class="oh-exc"><strong>Exceptions the lesson names.</strong> A broken protein can still act through one copy if it gets in the way: the laboratory tool Ras S17N stays in its GDP form and ties up the exchange factor that normal Ras needs, and many p53 missense mutants poison the tetramer they form with normal subunits, so they behave as dominant negatives. Two-hit behaviour holds only when one copy gives enough protein, and that does not always hold: PTEN shows dosage effects in mice. The lamp here follows the usual rule only.</p>

  <p class="oh-foot">Rule to keep: one altered copy of an on-step is enough, while an off-step usually has to lose both copies. In this sketch the lamp shows one step stuck on, not a tumour, because one stuck switch is seldom enough for a tumour.</p>
</figure>

<script>
  const NS = 'http://www.w3.org/2000/svg';
  type Cls = 'on' | 'off';
  function el(name: string, attrs: Record<string, string | number>, text?: string): SVGElement {
    const e = document.createElementNS(NS, name);
    for (const k in attrs) e.setAttribute(k, String(attrs[k]));
    if (text !== undefined) e.textContent = text;
    return e;
  }
  const OPTS: Record<Cls, [string, string][]> = {
    on: [['normal', 'normal Ras'], ['mut', 'altered: Ras G12V (cannot hydrolyse GTP)']],
    off: [['normal', 'normal neurofibromin'], ['mut', 'lost: no working GAP from this copy']],
  };
  document.querySelectorAll<HTMLElement>('[data-onehit]').forEach((root) => {
    const stage = root.querySelector<SVGSVGElement>('[data-stage]')!;
    const cls = root.querySelector<HTMLSelectElement>('[data-cls]')!;
    const c1 = root.querySelector<HTMLSelectElement>('[data-c1]')!;
    const c2 = root.querySelector<HTMLSelectElement>('[data-c2]')!;
    const verdict = root.querySelector<HTMLElement>('[data-verdict]')!;
    const INK = '#4b4b55', FAINT = '#8a8a96', TEAL = '#0e7c86', ORANGE = '#e57200', AMBER = '#d4a017';

    function fillOpts() {
      const k = cls.value as Cls;
      for (const s of [c1, c2]) {
        const keep = s.value || 'normal';
        s.replaceChildren();
        for (const [v, t] of OPTS[k]) {
          const o = document.createElement('option'); o.value = v; o.textContent = t; s.appendChild(o);
        }
        s.value = keep;
      }
    }
    function decide(k: Cls, a: boolean, b: boolean) {
      const n = (a ? 1 : 0) + (b ? 1 : 0);
      const stuck = k === 'on' ? n >= 1 : n === 2;
      let msg: string;
      if (k === 'on') {
        msg = n === 0
          ? 'Both copies are normal, so the switch goes on and off as it should and the lamp stays dark.'
          : n === 1
          ? 'One altered copy is enough. The altered protein signals without being told to, and the normal protein from the other copy cannot stop it. A gain of function is dominant: it shows even when the other copy is normal.'
          : 'Both copies are altered and the switch is stuck on. One altered copy would already have been enough, because a gain of function is dominant.';
      } else {
        msg = n === 0
          ? 'Both copies are normal, so the off-step works and the lamp stays dark.'
          : n === 1
          ? 'One lost copy leaves the lamp dark. One good copy usually makes enough protein to do the job, so the off-step still works. This cell is one hit from losing it.'
          : 'Both copies are lost, so the off-step fails. For neurofibromin, the GAP for Ras, that leaves Ras in its GTP form for longer. Loss of an off-step usually needs both copies gone: two hits.';
      }
      return { stuck, msg };
    }
    function draw(k: Cls, a: boolean, b: boolean, stuck: boolean) {
      stage.replaceChildren();
      const protein = (x: number, mut: boolean, label: string) => {
        stage.appendChild(el('text', { x: x + 55, y: 16, 'font-size': 10, 'text-anchor': 'middle', 'font-weight': 700, fill: INK }, label));
        stage.appendChild(el('rect', { x, y: 24, width: 110, height: 52, rx: 6, fill: '#fff', stroke: mut ? ORANGE : TEAL, 'stroke-width': 2, 'stroke-dasharray': mut && k === 'off' ? '5 3' : '0' }));
        const t1 = k === 'on' ? (mut ? 'Ras G12V' : 'Ras') : (mut ? 'no working GAP' : 'neurofibromin');
        const t2 = k === 'on' ? (mut ? 'altered' : 'normal') : (mut ? 'copy lost' : 'normal');
        stage.appendChild(el('text', { x: x + 55, y: 47, 'font-size': 11, 'text-anchor': 'middle', 'font-weight': 700, fill: mut ? ORANGE : TEAL }, t1));
        stage.appendChild(el('text', { x: x + 55, y: 64, 'font-size': 10, 'text-anchor': 'middle', fill: INK }, t2));
      };
      protein(40, a, 'Copy 1');
      protein(210, b, 'Copy 2');
      // arrows down to the step
      for (const x of [95, 265]) stage.appendChild(el('path', { d: `M${x} 78 L180 112`, stroke: FAINT, 'stroke-width': 1.5, fill: 'none' }));
      stage.appendChild(el('rect', { x: 100, y: 112, width: 160, height: 30, rx: 6, fill: '#e9e9ee' }));
      stage.appendChild(el('text', { x: 180, y: 132, 'font-size': 10, 'text-anchor': 'middle', 'font-weight': 700, fill: INK }, k === 'on' ? 'on-step of the pathway' : 'off-step of the pathway'));
      // lamp
      stage.appendChild(el('line', { x1: 180, y1: 142, x2: 180, y2: 150, stroke: FAINT, 'stroke-width': 1.5 }));
      stage.appendChild(el('circle', { cx: 180, cy: 164, r: 13, fill: stuck ? AMBER : '#fff', stroke: stuck ? AMBER : FAINT, 'stroke-width': 2 }));
      if (stuck) for (let i = 0; i < 8; i++) {
        const ang = (i * Math.PI) / 4;
        stage.appendChild(el('line', { x1: 180 + 17 * Math.cos(ang), y1: 164 + 17 * Math.sin(ang), x2: 180 + 22 * Math.cos(ang), y2: 164 + 22 * Math.sin(ang), stroke: AMBER, 'stroke-width': 2 }));
      }
      stage.appendChild(el('text', { x: 206, y: 168, 'font-size': 11, 'font-weight': 700, fill: stuck ? '#8a6200' : INK }, stuck ? 'stuck on' : 'not stuck on'));
    }
    function render() {
      const k = cls.value as Cls;
      const a = c1.value === 'mut', b = c2.value === 'mut';
      const { stuck, msg } = decide(k, a, b);
      draw(k, a, b, stuck);
      verdict.textContent = msg;
    }
    cls.addEventListener('change', () => { fillOpts(); render(); });
    c1.addEventListener('change', render);
    c2.addEventListener('change', render);
    fillOpts();
    render();
  });
</script>

<style is:global>
  .oh { padding: var(--ddp-space-3) var(--ddp-space-4) var(--ddp-space-4); margin: var(--ddp-space-5) 0; }
  .oh-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem; font-weight: 600; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); margin-bottom: var(--ddp-space-3); }
  .oh-chip { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 400; color: var(--ddp-color-muted); }
  .oh-svg { display: block; width: 100%; max-width: 600px; margin: 0 auto var(--ddp-space-3); height: auto; background: #fff; border: 1px solid var(--ddp-color-line); border-radius: 6px; }
  .oh-controls { display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem 1rem; }
  .oh-field { display: flex; flex-direction: column; gap: 0.2rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .oh-field:first-child { grid-column: 1 / -1; }
  .oh-field select { font-size: var(--ddp-text-xs); padding: 0.3rem 0.4rem; border: 1px solid var(--ddp-color-line); border-radius: 5px; background: #fff; color: var(--ddp-color-ink-soft); max-width: 100%; }
  .oh-field select:focus-visible { outline: 2px solid var(--ddp-color-accent); outline-offset: 2px; }
  .oh-verdict { margin: var(--ddp-space-3) 0 var(--ddp-space-2); padding: var(--ddp-space-2) var(--ddp-space-3); background: color-mix(in srgb, var(--ddp-color-accent) 8%, transparent); border-radius: 6px; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); min-height: 3em; }
  .oh-exc { margin: var(--ddp-space-2) 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); line-height: 1.5; }
  .oh-foot { margin: var(--ddp-space-3) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); border-left: 3px solid var(--ddp-color-secondary); padding-left: 0.55rem; }
  @media (max-width: 520px) { .oh-controls { grid-template-columns: 1fr; } }
</style>
