---
import type { Lesson } from '../schema';

interface Props {
  lesson: Lesson;
}
const { lesson } = Astro.props;

const rcsb = lesson.structures.filter((s) => s.source === 'rcsb');
const pubchem = lesson.structures.filter((s) => s.source === 'pubchem');
const phet = lesson.simulations.filter((s) => s.type === 'phet');
const local = lesson.simulations.filter((s) => s.type === 'local');

// The figures claim has to answer for EVERY raster collection, not just
// `images`. Lecture slides are raster too, and every lesson currently ships
// `images: []` — so keying the message off `images` alone told the reader
// there was nothing to fact-check on 27 lessons that carry 305 slides between
// them.
const slideCount = lesson.lectureSlides.length;
const flaggedSlides = lesson.lectureSlides.filter((s) => s.aiNote).length;
// Scientist portraits are raster too (illustrated, engraved-style, from the
// book's profile set) — the same claim once ignored them the way it ignored
// slides, telling `vitalism` readers the lesson had "no raster figures" while
// the page rendered four portrait PNGs.
const portraitCount = lesson.scientists.filter((s) => s.photo).length;
// Many structure notes open with "PDB 1HKG · …" or "CID 1176 · …", which repeated the ID printed
// just before it. Drop that echo; keep the rest of the note verbatim.
const idEcho = (prefix: string) => (s: { id: string; note?: string | null }) =>
  (s.note ?? '').replace(new RegExp(`^${prefix}\\s*${s.id}\\s*(·\\s*)?`, 'i'), '').trim();
const rcsbNote = idEcho('PDB');
const pubchemNote = idEcho('CID');
---

{/* Rendered inside the "Sources & Integrity" dialog, whose header already
    names the panel. It used to be a collapsed <details> with its own heading,
    so opening the dialog showed an empty box and a second "tap to open". */}
<section class="sources" aria-label="Sources and integrity">
  <p class="sources-intro">
    Every structure, slide, simulation, and clip on this page is listed below with
    the source it came from. None of the 3D structures is drawn by hand or by AI:
    each one loads by accession ID from RCSB&nbsp;PDB or PubChem. This panel is
    generated from the lesson's own data file, so what it lists is what the page loads.
  </p>

  <div class="sources-grid">
    {lesson.structures.length > 0 && (
      <div class="src-block">
        <h3>Molecular structures <span class="verified-chip">live data</span></h3>
        <ul>
          {rcsb.map((s) => (
            <li>
              <strong>{s.label}</strong> — RCSB PDB
              <a href={`https://www.rcsb.org/structure/${s.id}`} target="_blank" rel="noopener"><code>{s.id}</code></a>
              <span class="src-meta"> · coordinates CC0{ rcsbNote(s) ? ` · ${rcsbNote(s)}` : '' }</span>
            </li>
          ))}
          {pubchem.map((s) => (
            <li>
              <strong>{s.label}</strong> — PubChem
              <a href={`https://pubchem.ncbi.nlm.nih.gov/compound/${s.id}`} target="_blank" rel="noopener"><code>CID {s.id}</code></a>
              <span class="src-meta">{ pubchemNote(s) ? ` · ${pubchemNote(s)}` : '' }</span>
            </li>
          ))}
        </ul>
      </div>
    )}

    {lesson.simulations.length > 0 && (
      <div class="src-block">
        <h3>Simulations</h3>
        <ul>
          {phet.map((s) => (
            <li>
              <strong>{s.title}</strong>
              <span class="src-meta"> · {s.attribution}</span>
            </li>
          ))}
          {local.map((s) => (
            <li>
              <strong>{s.title}</strong>
              <span class="src-meta"> · {s.attribution}</span>
            </li>
          ))}
        </ul>
      </div>
    )}

    {(lesson.videos.length > 0 || lesson.podcast) && (
      <div class="src-block">
        <h3>Media (embedded, not rehosted)</h3>
        <ul>
          {lesson.podcast && (
            <li>
              <strong>{lesson.podcast.title ?? 'Podcast'}</strong> — Spotify
              <a href={lesson.podcast.url} target="_blank" rel="noopener">↗</a>
              <span class="src-meta">{ lesson.podcast.note ? ` · ${lesson.podcast.note}` : '' }</span>
            </li>
          )}
          {lesson.videos.map((v) => (
            <li>
              <strong>{v.title}</strong> — YouTube
              <a href={`https://www.youtube.com/watch?v=${v.youtubeId}`} target="_blank" rel="noopener"><code>{v.youtubeId}</code></a>
              <span class="src-meta"> · {v.sourceNote}</span>
            </li>
          ))}
        </ul>
      </div>
    )}

    {lesson.scientists.length > 0 && (
      <div class="src-block">
        <h3>Scientist profiles &amp; quotes</h3>
        <ul>
          {lesson.scientists.map((s) => (
            <li><strong>{s.name}</strong> <span class="src-meta">— {s.profileSourceAnchor}</span></li>
          ))}
        </ul>
        <p class="src-meta">
          Quotes are verbatim from the cited source. Profile text adapted from <em>The Molecule Hunters</em> (authors' IP).
          {portraitCount > 0 && ` The ${portraitCount === 1 ? 'portrait is an' : `${portraitCount} portraits are`} `}
          {portraitCount > 0 && <span class="ai-flag">AI-generated</span>}
          {portraitCount > 0 && ` engraving-style illustration${portraitCount === 1 ? '' : 's'} from the book's profiles — artistic depictions of each scientist, never photographs.`}
        </p>
      </div>
    )}

    {lesson.lectureSlides.length > 0 && (
      <div class="src-block">
        <h3>Lecture slides</h3>
        <ul>
          {lesson.lectureSlides.map((s) => (
            <li>
              <strong>{s.title}</strong>
              <span class="src-meta"> · {s.source} · {s.credit} · reviewed by {s.reviewedBy}</span>
            </li>
          ))}
        </ul>
        <p class="src-meta">Instructor's own slides; screened for accuracy and to exclude reproduced publisher figures.</p>
      </div>
    )}

    <div class="src-block">
      <h3>Images &amp; figures</h3>
      {lesson.images.length === 0 && slideCount === 0 && portraitCount === 0 ? (
        <p class="src-meta">
          This lesson carries <strong>no raster figures</strong>. Every structure is
          rendered live from RCSB&nbsp;PDB or PubChem, and every plot is drawn from
          its equation in the browser.
        </p>
      ) : lesson.images.length === 0 ? (
        <p class="src-meta">
          This lesson carries <strong>no standalone raster figures</strong> beyond
          the ones itemized in this panel:
          {slideCount > 0 && ` its ${slideCount} lecture slides (each listed above with its deck, its credit, and the person who screened it for accuracy and copyright)`}
          {slideCount > 0 && portraitCount > 0 && ' and'}
          {portraitCount > 0 && ` its ${portraitCount} scientist portrait${portraitCount === 1 ? '' : 's'} (AI-generated illustrations from the book's profiles, disclosed under Scientist profiles & quotes)`}.
          {flaggedSlides > 0 && ` ${flaggedSlides} slide${flaggedSlides === 1 ? ' carries' : 's carry'} a caption flagging a known illustration artifact.`}
          {' '}Every 3D structure is rendered live from an accession ID.
        </p>
      ) : (
        <ul>
          {lesson.images.map((img) => (
            <li>
              <strong>{img.alt}</strong>
              {img.aiGenerated ? (
                <span class="src-meta"> · <span class="ai-flag">AI-generated</span> · fact-checked by {img.factCheckedBy}</span>
              ) : (
                <span class="src-meta"> · {img.credit}</span>
              )}
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>

  <p class="integrity-statement">
    <span class="verified-chip">integrity</span>
    <span>
      {slideCount > 0 && 'Two different things are checked here, and they are worth telling apart. '}
      <strong>Machines check the mechanics.</strong> The build confirms that every
      local file exists, that every question's answer key points at a real choice,
      and that any AI-generated scientific figure names the person who checked it;
      a weekly job re-resolves every accession ID against its database.
      {portraitCount > 0 && ' The scientist portraits are AI-generated artwork, labeled as such above. They depict the person and carry no science, and nothing on this site asks you to trust a picture of a face.'}
      {slideCount > 0 && (
        <>
          {' '}<strong>A person checks the science.</strong> Prof.&nbsp;Deppmann cleared
          each lecture slide for accuracy and for copyright, and his name is on every
          one of them in the list above.
        </>
      )}
      {' '}Questions are original; MCAT-style items are written for this site and are
      not real AAMC questions. Banned sources (the Tymoczko textbook, publisher
      decks, copyrighted figures) are not used.
    </span>
  </p>
</section>

<style>
  .sources {
    display: block;
  }
  .sources-intro {
    margin: 0;
    color: var(--ddp-color-ink-soft);
    max-width: var(--ddp-maxw);
  }
  .sources-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--ddp-space-6);
    margin: var(--ddp-space-6) 0;
  }
  .src-block h3 {
    font-size: var(--ddp-text-base);
    margin: 0 0 var(--ddp-space-2);
    display: flex;
    align-items: center;
    gap: var(--ddp-space-2);
  }
  .src-block ul {
    margin: 0;
    padding-left: 1.1rem;
    list-style: disc; /* restated: Tailwind's preflight removes it */
    font-size: var(--ddp-text-sm);
  }
  .src-block li::marker {
    color: var(--ddp-color-muted);
  }
  .src-block li {
    margin-bottom: var(--ddp-space-2);
  }
  .src-block code {
    font-size: 0.85em;
  }
  .src-meta {
    color: var(--ddp-color-muted);
    font-size: var(--ddp-text-xs);
  }
  .ai-flag {
    color: var(--ddp-color-caution);
    background: var(--ddp-color-caution-soft);
    border-radius: 4px;
    padding: 0 0.3em;
    font-weight: 600;
  }
  .integrity-statement {
    font-size: var(--ddp-text-sm);
    color: var(--ddp-color-ink-soft);
    background: var(--ddp-color-accent-soft);
    border-radius: var(--ddp-radius);
    padding: var(--ddp-space-4) var(--ddp-space-6);
    display: flex;
    gap: var(--ddp-space-3);
    align-items: flex-start;
    margin: 0;
  }
  .integrity-statement .verified-chip {
    flex: none;
    margin-top: 0.15em;
  }
  @media (max-width: 560px) {
    .integrity-statement {
      flex-direction: column;
      padding: var(--ddp-space-4);
    }
  }
</style>
