---
/**
 * LessonShare — "Share with your class" (2026-11-10).
 *
 * A fold beside the lesson title. Open, it shows a QR code for the lesson's address, large enough
 * to scan from the back of a room when the page is projected, with the address printed under it
 * for anyone who would rather type.
 *
 * The code is drawn when the site is built (src/lib/qr.ts) and sits in the page as a plain SVG:
 * no outside service, no script, and it works with JavaScript off because the fold is a
 * <details>. The panel is laid over the page, so opening it moves nothing.
 *
 * The code always holds the public address (https://biochemistrypedia.com/lessons/<slug>/),
 * also on a local preview. The printed address leaves off "https://" and the last "/"; the
 * site sends that address on to the full one.
 */
import { qrSvg } from '../lib/qr';

interface Props {
  slug: string;
  /** Ages 5–10 activity guides are read by the adult, so there is no class to share with. */
  activity?: boolean;
}
const { slug, activity = false } = Astro.props;
const site = Astro.site ?? new URL('https://biochemistrypedia.com');
const url = new URL(`/lessons/${slug}/`, site).href;
const short = `${site.host}/lessons/${slug}`;
const qr = qrSvg(url);
---
<details class="share" data-pagefind-ignore>
  <summary>
    <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><path fill="currentColor" d="M1 1h6v6H1zm2 2v2h2V3zM9 1h6v6H9zm2 2v2h2V3zM1 9h6v6H1zm2 2v2h2v-2zM9 9h2v2H9zm4 0h2v2h-2zm-2 2h2v2h-2zm-2 2h2v2H9zm4 0h2v2h-2z" /></svg>
    {activity ? 'Share this activity' : 'Share with your class'}
  </summary>
  <div class="share-panel">
    <svg class="share-qr" viewBox={`0 0 ${qr.size} ${qr.size}`} role="img" aria-label={`QR code for ${short}`} shape-rendering="crispEdges">
      <rect width={qr.size} height={qr.size} fill="#fff" />
      <path d={qr.path} fill="#000" />
    </svg>
    <p class="share-url">{site.host}/lessons/<wbr /><span class="share-slug">{slug}</span></p>
    <p class="share-note">
      {activity
        ? 'Point a phone camera at the code to open this activity. No account is needed.'
        : 'Point a phone camera at the code to open this lesson. Students need no account.'}
    </p>
  </div>
</details>

<style>
  .share { position: relative; flex: none; }
  .share > summary {
    display: inline-flex; align-items: center; gap: 0.5em; min-height: 40px; padding: 0.55em 1.1em;
    list-style: none; white-space: nowrap; cursor: pointer;
    font: 600 var(--ddp-text-sm)/1 var(--ddp-font-sans); color: var(--ddp-color-primary);
    background: var(--ddp-color-surface); border: 1px solid var(--ddp-color-line); border-radius: 999px;
  }
  .share > summary::-webkit-details-marker { display: none; }
  .share > summary:hover, .share[open] > summary { border-color: var(--ddp-color-accent); color: var(--ddp-color-accent); }
  .share > summary:focus-visible { outline: 2px solid var(--ddp-color-accent); outline-offset: 2px; }
  .share > summary svg { flex: none; }
  /* Laid over the page so the header keeps its height. Always black on white, in dark mode too:
     a phone camera reads that best. As wide as the screen allows, and short enough that the code,
     the address and the note all show on one screen when the page is at its top. */
  .share-panel {
    position: absolute; z-index: 40; top: calc(100% + 0.5rem); right: 0;
    width: max(15rem, min(34rem, calc(100vw - 3rem), calc(100vh - 21rem)));
    padding: var(--ddp-space-3) var(--ddp-space-3) var(--ddp-space-4);
    background: #fff; color: #1f2430; text-align: center;
    border: 1px solid #c9ced8; border-radius: 12px; box-shadow: 0 16px 48px rgba(10, 16, 30, 0.28);
  }
  .share-qr { display: block; width: 100%; height: auto; }
  .share-url { margin: 0; font: 700 clamp(1rem, 0.8rem + 1vw, 1.35rem)/1.3 var(--ddp-font-mono); color: #111; overflow-wrap: anywhere; }
  /* The address breaks after "/lessons/" first, and inside the lesson's name only when it must. */
  .share-slug { display: inline-block; max-width: 100%; }
  .share-note { margin: var(--ddp-space-2) 0 0; font-size: var(--ddp-text-sm); line-height: 1.4; color: #4a5160; }
  @media (max-width: 820px) {
    .share { margin-bottom: var(--ddp-space-3); }
    .share-panel { right: auto; left: 0; }
  }
  @media print {
    .share:not([open]) { display: none; }
    .share-panel { position: static; box-shadow: none; }
  }
</style>
