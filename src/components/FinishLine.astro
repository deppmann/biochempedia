---
/**
 * "Finish line" at the end of a lesson: Test yourself / Play it / Next, plus a
 * Previous link. Fully server-rendered (the quiz button reuses the page's
 * existing [data-open="lb-quiz"] dialog opener).
 */
import { LESSON_GAMES, gameHref, unitReviewFor, unitReviewHref } from '../data/lesson-games';

interface Nav { slug: string; title: string; hook: string; n: number }
interface Props {
  slug: string;
  qCount: number;
  prev?: Nav;
  next?: Nav;
}
const { slug, qCount, prev, next } = Astro.props;
const games = LESSON_GAMES[slug] ?? [];
const main = games[0];
const more = games.slice(1);
const review = unitReviewFor(slug);
---

<section class="finish" aria-labelledby="finish-h">
  <h2 class="fl-label" id="finish-h"><span>Finish line</span></h2>
  <div class="fl-grid">
    {qCount > 0 && (
      <div class="fl-card fl-test">
        <p class="fl-kicker">Test yourself</p>
        <p class="fl-title">{qCount} {qCount === 1 ? 'question' : 'questions'}</p>
        <p class="fl-blurb">Practice and MCAT-style, with explained answers.</p>
        <button type="button" class="fl-go" data-open="lb-quiz">Start the quiz →</button>
      </div>
    )}
    {main && (
      <div class="fl-card fl-play">
        <p class="fl-kicker">Play it · about {main.minutes} min</p>
        <p class="fl-title">{main.title}</p>
        <p class="fl-blurb">{main.blurb}</p>
        <a class="fl-go" href={gameHref(main, slug)}>Play →</a>
      </div>
    )}
    {next ? (
      <div class="fl-card fl-next">
        <p class="fl-kicker">Next · Lesson {next.n}</p>
        <p class="fl-title">{next.title}</p>
        <p class="fl-blurb">{next.hook}</p>
        <a class="fl-go" href={`/lessons/${next.slug}/`}>Continue →</a>
      </div>
    ) : (
      <div class="fl-card fl-next">
        <p class="fl-kicker">That's the last lesson</p>
        <p class="fl-title">Back to all lessons</p>
        <p class="fl-blurb">Pick another topic, or revisit one you want to firm up.</p>
        <a class="fl-go" href="/#lessons">All lessons →</a>
      </div>
    )}
  </div>

  {review && (
    <div class="fl-unit">
      <div class="fl-unit-text">
        <p class="fl-kicker">Unit review · {review.unit}</p>
        <p class="fl-title">MCAT Gauntlet: {review.unit}</p>
        <p class="fl-blurb">15 timed questions across {review.covers}. Three lives.</p>
      </div>
      <a class="fl-go" href={unitReviewHref(review.id, slug)}>Start the unit review →</a>
    </div>
  )}

  {more.length > 0 && (
    <p class="fl-also">
      Also in the arcade for this lesson:{' '}
      {more.map((g, i) => (<>{i > 0 ? ', ' : ''}<a href={gameHref(g, slug)}>{g.title}</a></>))}
    </p>
  )}
  {prev && (
    <p class="fl-prev"><a href={`/lessons/${prev.slug}/`}>← Lesson {prev.n} · {prev.title}</a></p>
  )}
</section>

<style>
  .finish { margin-top: var(--ddp-space-12); }
  .fl-label {
    display: flex; align-items: center; gap: var(--ddp-space-3);
    margin: 0 0 var(--ddp-space-4);
    font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 500;
    letter-spacing: 0.08em; text-transform: uppercase; color: var(--ddp-color-muted);
  }
  .fl-label::after { content: ''; flex: 1; height: 1px; background: var(--ddp-color-line); }
  .fl-grid {
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--ddp-space-3); align-items: stretch;
  }
  @media (max-width: 760px) { .fl-grid { grid-template-columns: 1fr; } }
  .fl-card {
    display: flex; flex-direction: column;
    padding: var(--ddp-space-4);
    border: 1px solid var(--ddp-color-line); border-radius: var(--ddp-radius-sm, 8px);
    background: var(--ddp-color-surface); color: var(--ddp-color-ink);
  }
  .fl-card p { margin: 0; }
  .fl-kicker {
    font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs);
    letter-spacing: 0.06em; text-transform: uppercase; color: var(--ddp-color-muted);
  }
  .fl-title { margin-top: var(--ddp-space-2) !important; font-weight: 700; font-size: var(--ddp-text-lg, 1.125rem); line-height: 1.25; }
  .fl-blurb { margin-top: var(--ddp-space-2) !important; font-size: var(--ddp-text-sm); line-height: 1.45; color: var(--ddp-color-ink-soft); flex: 1; }
  .fl-go {
    margin-top: var(--ddp-space-4); align-self: flex-start;
    display: inline-flex; align-items: center; min-height: 44px; padding: 0.5em 1em;
    font: inherit; font-size: var(--ddp-text-sm); font-weight: 700; text-decoration: none; cursor: pointer;
    color: var(--ddp-color-ink); background: transparent;
    border: 1.5px solid var(--ddp-color-ink-soft); border-radius: 999px;
  }
  .fl-go:hover { border-color: var(--ddp-color-accent); }

  .fl-play {
    background: color-mix(in srgb, var(--ddp-color-secondary) 22%, var(--ddp-color-surface));
    border-color: color-mix(in srgb, var(--ddp-color-secondary) 55%, var(--ddp-color-surface));
  }
  .fl-play .fl-kicker { color: var(--ddp-color-secondary-ink); }
  .fl-play .fl-blurb { color: var(--ddp-color-ink); }
  .fl-play .fl-go { background: var(--ddp-color-secondary); border-color: var(--ddp-color-secondary); color: #1d2433; }
  .fl-play .fl-go:hover { filter: brightness(1.06); }

  /* Fixed brand navy (not --ddp-color-primary, which flips to pale in dark mode)
     so the white text always has ~10:1+ contrast. */
  .fl-next { background: var(--color-navy); border-color: var(--color-navy); color: #fff; }
  .fl-next .fl-kicker { color: #c9d3ec; }
  .fl-next .fl-blurb { color: #e6ebf7; }
  .fl-next .fl-go { background: #fff; border-color: #fff; color: var(--color-navy); }
  .fl-next .fl-go:hover { background: #e6ebf7; }

  /* Unit review: a full-width, quiet band under the three cards. */
  .fl-unit {
    display: flex; align-items: center; justify-content: space-between; gap: var(--ddp-space-4);
    margin-top: var(--ddp-space-3); padding: var(--ddp-space-4);
    border: 1px solid color-mix(in srgb, var(--ddp-color-accent) 35%, var(--ddp-color-line));
    border-radius: var(--ddp-radius-sm, 8px);
    background: color-mix(in srgb, var(--ddp-color-accent) 8%, var(--ddp-color-surface));
    color: var(--ddp-color-ink);
  }
  .fl-unit p { margin: 0; }
  .fl-unit .fl-blurb { flex: none; }
  .fl-unit .fl-go { margin-top: 0; flex: none; }
  @media (max-width: 760px) {
    .fl-unit { flex-direction: column; align-items: stretch; }
    .fl-unit .fl-go { margin-top: var(--ddp-space-2); align-self: flex-start; }
  }

  .fl-also, .fl-prev { margin: var(--ddp-space-3) 0 0; font-size: var(--ddp-text-sm); color: var(--ddp-color-ink-soft); }
  .fl-also a, .fl-prev a { color: var(--ddp-color-ink); font-weight: 600; text-underline-offset: 2px; }
  .fl-also a:hover, .fl-prev a:hover { color: var(--ddp-color-accent); }
  @media (prefers-color-scheme: dark) {
    .fl-next { border-color: color-mix(in srgb, #fff 28%, var(--color-navy)); }
  }
</style>
