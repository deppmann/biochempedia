---
/**
 * MuscleLengthVelocity — "Length, load and power". The isometric force F0 available at a
 * sarcomere length caps the load a muscle can move; against any smaller load Hill's
 * hyperbola, v = b (F0 - F) / (F + a), sets the shortening speed, and external power
 * P = F x v peaks at an intermediate load. A model muscle with frog length landmarks (plateau
 * 2.05 to 2.20 µm, straight descending limb to zero at 3.65 µm, the lesson's worked problem).
 * Self-contained vanilla-TS Astro island. Original.
 */
---

<figure class="mlv card" data-mlv>
  <figcaption class="mlv-head">Length, load and power<span class="mlv-chip">⚙ original · interactive</span></figcaption>

  <p class="mlv-tag">Model muscle with frog length landmarks; not human data.</p>

  <svg class="mlv-svg" viewBox="0 0 340 342" role="img" aria-label="Three plots for a model muscle: isometric force against sarcomere length, shortening speed against load, and power against load, with the current length and load marked" data-plot></svg>

  <p class="mlv-legend" aria-hidden="true">
    <span><i class="mlv-sw mlv-sw-load"></i>current load</span>
    <span><i class="mlv-sw mlv-sw-best"></i>best load (most power)</span>
    <span><i class="mlv-sw mlv-sw-zone"></i>load above F₀</span>
  </p>

  <div class="mlv-controls">
    <label class="mlv-slabel"><span>Sarcomere length <em data-out="len">3.00</em> µm</span>
      <input type="range" data-in="len" min="2.05" max="3.65" step="0.05" value="3" />
    </label>
    <label class="mlv-slabel"><span>Load F <em data-out="load">20</em> N</span>
      <input type="range" data-in="load" min="0" max="100" step="1" value="20" />
    </label>
    <label class="mlv-slabel"><span>Curvature a/F₀ <em data-out="q">0.25</em></span>
      <input type="range" data-in="q" min="0.15" max="0.45" step="0.01" value="0.25" />
    </label>
    <label class="mlv-slabel"><span>Maximal speed v<sub>max</sub> <em data-out="vmax">0.40</em> m per s</span>
      <input type="range" data-in="vmax" min="0.2" max="0.6" step="0.01" value="0.4" />
    </label>
  </div>

  <dl class="mlv-readout">
    <div><dt>Active isometric force F₀ at this length</dt><dd data-r="f0">44.83 N</dd></div>
    <div><dt>Constants a and b</dt><dd data-r="ab">—</dd></div>
    <div><dt>Shortening speed at this load</dt><dd data-r="v">—</dd></div>
    <div><dt>External power at this load</dt><dd data-r="p">—</dd></div>
    <div><dt>Best load</dt><dd data-r="best">—</dd></div>
    <div><dt>Peak power at the best load</dt><dd data-r="peak">—</dd></div>
  </dl>

  <p class="mlv-why" data-why role="status">—</p>

  <p class="mlv-assume"><strong>Assumptions, made up for this sketch (not measured):</strong> a model fibre bundle that holds 100 N on the plateau, 2.05 to 2.20 µm; a straight descending limb from full force at 2.20 µm to zero at 3.65 µm (the frog length landmarks); the fall in force at lengths shorter than 2.05 µm (interference, not modelled); a/F₀ and v<sub>max</sub> are the same at every length; quasi-steady shortening at one length with constant activation and temperature. The values are illustrative, not human constants; a/F₀ (0.25) and v<sub>max</sub> (0.40 m per s) are model values, as are the slider ranges around them; not from Hill’s paper. Rule used: F₀ = 100 N × min(1, (3.65 − L) / 1.45), a = (a/F₀) F₀, b = v<sub>max</sub> (a/F₀), v = b (F₀ − F) / (F + a), P = F × v, best load = F₀ (√(q² + q) − q) with q = a/F₀.</p>

  <p class="mlv-foot">Rule to keep: the sarcomere length sets the isometric force F₀ the muscle can hold; against any load below F₀ Hill’s hyperbola sets the speed; power F × v is zero at zero load and at F₀ and peaks at a load in between, whose fraction of F₀ depends on the curvature.</p>
</figure>

<script>
  const NS = 'http://www.w3.org/2000/svg';
  const ACCENT = '#0e7c86', ORANGE = '#e57200', INK = '#4b4b55', GREY = '#6b6b75', ZONE = '#f6dcdc';
  function el(name: string, attrs: Record<string, string | number>): SVGElement {
    const e = document.createElementNS(NS, name);
    for (const k in attrs) e.setAttribute(k, String(attrs[k]));
    return e;
  }
  function txt(x: number, y: number, s: string, extra: Record<string, string | number> = {}): SVGElement {
    const t = el('text', Object.assign({ x, y, 'font-size': 9, fill: INK }, extra));
    t.textContent = s;
    return t;
  }

  document.querySelectorAll<HTMLElement>('[data-mlv]').forEach((root) => {
    const plot = root.querySelector<SVGSVGElement>('[data-plot]');
    const why = root.querySelector<HTMLElement>('[data-why]');
    const inp = (k: string) => root.querySelector<HTMLInputElement>('[data-in="' + k + '"]');
    const out = (k: string) => root.querySelector<HTMLElement>('[data-out="' + k + '"]');
    const rd = (k: string) => root.querySelector<HTMLElement>('[data-r="' + k + '"]');
    const lenIn = inp('len'), loadIn = inp('load'), qIn = inp('q'), vmIn = inp('vmax');
    const lenOut = out('len'), loadOut = out('load'), qOut = out('q'), vmOut = out('vmax');
    const rF0 = rd('f0'), rAB = rd('ab'), rV = rd('v'), rP = rd('p'), rBest = rd('best'), rPeak = rd('peak');
    if (!plot || !why || !lenIn || !loadIn || !qIn || !vmIn || !lenOut || !loadOut || !qOut || !vmOut || !rF0 || !rAB || !rV || !rP || !rBest || !rPeak) return;

    const X0 = 44, X1 = 326;
    const LMIN = 2.05, LMAX = 3.65, PLAT = 2.2, FMAX = 100, VMAX_AX = 0.6, PMAX_AX = 8;
    // panel A: F0 against length; B: speed against load; C: power against load
    const A = { y0: 22, y1: 78 }, B = { y0: 132, y1: 200 }, C = { y0: 242, y1: 310 };
    const lx = (L: number) => X0 + ((L - LMIN) / (LMAX - LMIN)) * (X1 - X0);
    const fx = (F: number) => X0 + (F / FMAX) * (X1 - X0);
    const yA = (f: number) => A.y1 - (f / FMAX) * (A.y1 - A.y0);
    const yB = (v: number) => B.y1 - (v / VMAX_AX) * (B.y1 - B.y0);
    const yC = (p: number) => C.y1 - (p / PMAX_AX) * (C.y1 - C.y0);
    const f2 = (x: number) => x.toFixed(2);
    const f3 = (x: number) => x.toFixed(3);

    function axes(P: { y0: number; y1: number }, yTicks: [number, string, (v: number) => number][]) {
      plot!.appendChild(el('line', { x1: X0, y1: P.y0, x2: X0, y2: P.y1, stroke: INK, 'stroke-width': 1 }));
      plot!.appendChild(el('line', { x1: X0, y1: P.y1, x2: X1, y2: P.y1, stroke: INK, 'stroke-width': 1 }));
      for (const [v, label, map] of yTicks) {
        const y = map(v);
        plot!.appendChild(el('line', { x1: X0 - 3, y1: y, x2: X0, y2: y, stroke: INK, 'stroke-width': 1 }));
        plot!.appendChild(txt(X0 - 5, y + 3, label, { 'text-anchor': 'end' }));
      }
    }
    function loadTicks(P: { y0: number; y1: number }, ty: number) {
      for (const F of [0, 25, 50, 75, 100]) {
        plot!.appendChild(el('line', { x1: fx(F), y1: P.y1, x2: fx(F), y2: P.y1 + 3, stroke: INK, 'stroke-width': 1 }));
        plot!.appendChild(txt(fx(F), ty, String(F), { 'text-anchor': F === 0 ? 'start' : F === 100 ? 'end' : 'middle' }));
      }
    }

    function render() {
      const L = Math.round(parseFloat(lenIn!.value) * 100) / 100;
      const F = parseFloat(loadIn!.value);
      const q = parseFloat(qIn!.value);
      const vmax = parseFloat(vmIn!.value);
      lenOut!.textContent = f2(L);
      loadOut!.textContent = String(F);
      qOut!.textContent = f2(q);
      vmOut!.textContent = f2(vmax);

      const frac = Math.min(1, (LMAX - L) / (LMAX - PLAT));
      const F0 = FMAX * Math.max(0, frac);
      const zero = F0 < 0.005;
      const a = q * F0, b = vmax * q;
      const vOf = (load: number) => (b * (F0 - load)) / (load + a);
      const fstar = Math.sqrt(q * q + q) - q;
      const Fb = fstar * F0;
      const vb = zero ? 0 : vOf(Fb), Ppk = Fb * vb;
      const exceeds = !zero && F > F0 + 1e-6;
      const equals = zero ? F === 0 : Math.abs(F - F0) <= 1e-6;
      const v = zero || exceeds || equals ? 0 : vOf(F);
      const P = F * v;

      plot!.replaceChildren();

      // ---- Panel A: F0 against length
      plot!.appendChild(txt(4, 11, 'Active F₀ at this length (short lengths not modelled)', { 'font-weight': 700 }));
      plot!.appendChild(el('rect', { x: lx(LMIN), y: A.y0, width: lx(PLAT) - lx(LMIN), height: A.y1 - A.y0, fill: '#e3f1f2' }));
      axes(A, [[0, '0', yA], [50, '50', yA], [100, '100 N', yA]]);
      plot!.appendChild(el('path', { d: `M${lx(LMIN)} ${yA(100)} L${lx(PLAT)} ${yA(100)} L${lx(LMAX)} ${yA(0)}`, fill: 'none', stroke: ACCENT, 'stroke-width': 2.4 }));
      for (const [Lt, lab, anc] of [[2.05, '2.05', 'start'], [2.5, '2.5', 'middle'], [3, '3.0', 'middle'], [3.65, '3.65', 'end']] as [number, string, string][]) {
        plot!.appendChild(el('line', { x1: lx(Lt), y1: A.y1, x2: lx(Lt), y2: A.y1 + 3, stroke: INK, 'stroke-width': 1 }));
        plot!.appendChild(txt(lx(Lt), A.y1 + 13, lab, { 'text-anchor': anc }));
      }
      plot!.appendChild(txt((X0 + X1) / 2, A.y1 + 25, 'sarcomere length L (µm); plateau shaded', { 'text-anchor': 'middle' }));
      plot!.appendChild(el('line', { x1: lx(L), y1: yA(F0), x2: lx(L), y2: A.y1, stroke: ORANGE, 'stroke-width': 1.2, 'stroke-dasharray': '3 2' }));
      plot!.appendChild(el('circle', { cx: lx(L), cy: yA(F0), r: 4, fill: ORANGE }));

      // ---- Panel B: speed against load
      plot!.appendChild(txt(4, 124, 'Speed v against load F (m per s)', { 'font-weight': 700 }));
      axes(B, [[0, '0', yB], [0.3, '0.3', yB], [0.6, '0.6', yB]]);
      loadTicks(B, B.y1 + 13);
      // ---- Panel C: power against load
      plot!.appendChild(txt(4, 234, 'Power P = F × v against load F (W)', { 'font-weight': 700 }));
      axes(C, [[0, '0', yC], [4, '4', yC], [8, '8', yC]]);
      loadTicks(C, C.y1 + 13);
      plot!.appendChild(txt((X0 + X1) / 2, C.y1 + 25, 'load F (N)', { 'text-anchor': 'middle' }));

      // shaded zone for loads above F0
      const zx = zero ? X0 : fx(F0);
      if (zx < X1 - 0.5) {
        for (const P2 of [B, C]) {
          plot!.appendChild(el('rect', { x: zx, y: P2.y0, width: X1 - zx, height: P2.y1 - P2.y0, fill: ZONE }));
        }
        if (X1 - zx >= 84) plot!.appendChild(txt(zx + 4, B.y0 + 14, 'no shortening', { 'text-anchor': 'start' }));
      }
      // re-draw axes lines over the zone
      for (const P2 of [B, C]) {
        plot!.appendChild(el('line', { x1: X0, y1: P2.y1, x2: X1, y2: P2.y1, stroke: INK, 'stroke-width': 1 }));
      }

      if (!zero) {
        let dv = '', dp = '';
        const n = 100;
        for (let i = 0; i <= n; i++) {
          const load = (F0 * i) / n;
          const vv = vOf(load);
          dv += (i === 0 ? 'M' : 'L') + fx(load).toFixed(1) + ' ' + yB(vv).toFixed(1) + ' ';
          dp += (i === 0 ? 'M' : 'L') + fx(load).toFixed(1) + ' ' + yC(load * vv).toFixed(1) + ' ';
        }
        plot!.appendChild(el('path', { d: dv.trim(), fill: 'none', stroke: ACCENT, 'stroke-width': 2.4 }));
        plot!.appendChild(el('path', { d: dp.trim(), fill: 'none', stroke: ACCENT, 'stroke-width': 2.4 }));
        // best load
        for (const [P2, yy, val] of [[B, yB, vb], [C, yC, Ppk]] as [{ y0: number; y1: number }, (x: number) => number, number][]) {
          plot!.appendChild(el('line', { x1: fx(Fb), y1: yy(val), x2: fx(Fb), y2: P2.y1, stroke: GREY, 'stroke-width': 1.1, 'stroke-dasharray': '1.5 2.5' }));
          plot!.appendChild(el('circle', { cx: fx(Fb), cy: yy(val), r: 3.6, fill: '#fff', stroke: GREY, 'stroke-width': 1.6 }));
        }
      }
      // current load
      for (const [P2, yy, val] of [[B, yB, v], [C, yC, P]] as [{ y0: number; y1: number }, (x: number) => number, number][]) {
        plot!.appendChild(el('line', { x1: fx(F), y1: P2.y0, x2: fx(F), y2: P2.y1, stroke: ORANGE, 'stroke-width': 1.2, 'stroke-dasharray': '3 2' }));
        const held = zero || exceeds || equals;
        plot!.appendChild(el('circle', { cx: fx(F), cy: yy(val), r: 4, fill: held ? '#fff' : ORANGE, stroke: ORANGE, 'stroke-width': 1.6 }));
      }

      // ---- Readouts
      rF0!.textContent = f2(F0) + ' N';
      rAB!.textContent = zero ? 'not defined (F₀ = 0)' : `a = ${f2(a)} N, b = ${f3(b)} m per s`;
      rV!.textContent = zero || exceeds ? 'none: not shortening' : f3(v) + ' m per s';
      rP!.textContent = zero || exceeds ? 'none: not shortening' : f2(P) + ' W';
      rBest!.textContent = zero ? 'none (F₀ = 0)' : `${f2(Fb)} N (${f2(fstar)} of F₀)`;
      rPeak!.textContent = zero ? 'none (F₀ = 0)' : f2(Ppk) + ' W';

      // ---- Status
      const lenPhrase = L <= PLAT + 1e-9
        ? 'on the plateau, where this model muscle holds its full 100 N'
        : `${Math.round(frac * 100)} percent of the plateau force, on the descending limb`;
      let msg: string;
      if (zero) {
        msg = `In this sketch, F₀ is zero at ${f2(L)} µm, where the straight descending limb reaches zero (the frog fibres’ extrapolated zero near 3.65 µm), so there is no active isometric force to set a speed or power and none is plotted.`;
      } else if (exceeds) {
        msg = `In this sketch, load exceeds isometric force: no shortening (the active muscle lengthens: an eccentric contraction). F₀ at ${f2(L)} µm is ${f2(F0)} N and the load is ${F} N; this sketch does not model the speed of lengthening.`;
      } else if (equals) {
        msg = `In this sketch, the load equals F₀ (${f2(F0)} N at ${f2(L)} µm), so the muscle is isometric: speed is zero and external power is zero. The best load for power is ${f2(Fb)} N.`;
      } else if (F === 0) {
        msg = `In this sketch, with no load the muscle shortens at its maximal speed, vmax = ${f3(vmax)} m per s, and external power is zero because power is force times speed. F₀ at ${f2(L)} µm is ${f2(F0)} N, ${lenPhrase}; the best load is ${f2(Fb)} N.`;
      } else {
        const rel = Math.abs(F - Fb) <= 0.005 * Math.max(F0, 1)
          ? 'The load is at the best load.'
          : F < Fb
            ? 'The load is below the best load: a somewhat heavier load (up to the best load) would lower speed but raise power.'
            : 'The load is above the best load: a heavier load would lower both speed and power.';
        msg = `In this sketch, F₀ at ${f2(L)} µm is ${f2(F0)} N, ${lenPhrase}. Against ${F} N the muscle shortens at ${f3(v)} m per s and delivers ${f2(P)} W, ${Math.round((P / Ppk) * 100)} percent of the peak of ${f2(Ppk)} W at the best load of ${f2(Fb)} N (${f2(fstar)} of F₀ when a/F₀ = ${f2(q)}; the fraction depends on the curvature). ${rel}`;
      }
      why!.textContent = msg;
    }

    [lenIn, loadIn, qIn, vmIn].forEach((s) => s.addEventListener('input', render));
    render();
  });
</script>

<style is:global>
  .mlv { padding: var(--ddp-space-3) var(--ddp-space-4) var(--ddp-space-4); margin: var(--ddp-space-5) 0; }
  .mlv-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem; font-weight: 600; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); margin-bottom: var(--ddp-space-2); }
  .mlv-chip { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 400; color: var(--ddp-color-muted); }
  .mlv-tag { margin: 0 0 var(--ddp-space-2); font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .mlv-svg { display: block; width: 100%; max-width: 560px; margin: 0 auto; height: auto; background: #fff; border: 1px solid var(--ddp-color-line); border-radius: 6px; }
  .mlv-legend { display: flex; flex-wrap: wrap; gap: 0.2rem 0.9rem; margin: var(--ddp-space-2) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .mlv-legend span { display: inline-flex; align-items: center; gap: 0.3rem; }
  .mlv-sw { display: inline-block; width: 0.9rem; height: 0.6rem; border-radius: 2px; }
  .mlv-sw-load { border-left: 2px dashed #e57200; border-radius: 0; width: 0.2rem; height: 0.8rem; }
  .mlv-sw-best { border: 2px solid #6b6b75; border-radius: 50%; width: 0.6rem; height: 0.6rem; background: #fff; }
  .mlv-sw-zone { background: #f6dcdc; border: 1px solid #e3b9b9; }
  .mlv-controls { display: grid; grid-template-columns: 1fr 1fr; gap: var(--ddp-space-2) var(--ddp-space-4); margin: var(--ddp-space-3) 0 var(--ddp-space-2); }
  .mlv-slabel { display: flex; flex-direction: column; gap: 0.1rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .mlv-slabel em { font-style: normal; font-weight: 700; color: var(--ddp-color-accent); font-family: var(--ddp-font-mono); }
  .mlv-slabel input { accent-color: var(--ddp-color-accent); width: 100%; }
  .mlv-readout { display: grid; grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); gap: var(--ddp-space-2); margin: var(--ddp-space-2) 0; padding: var(--ddp-space-2) var(--ddp-space-3); background: color-mix(in srgb, var(--ddp-color-accent) 8%, transparent); border-radius: 6px; }
  .mlv-readout div { display: flex; flex-direction: column; gap: 0.1rem; min-width: 0; }
  .mlv-readout dt { font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .mlv-readout dd { margin: 0; font-family: var(--ddp-font-mono); font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); font-weight: 700; overflow-wrap: anywhere; }
  .mlv-why { margin: 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); line-height: 1.5; min-height: 6em; }
  .mlv-assume { margin: var(--ddp-space-3) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); line-height: 1.5; }
  .mlv-foot { margin: var(--ddp-space-3) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); border-left: 3px solid var(--ddp-color-secondary); padding-left: 0.55rem; }
  @media (max-width: 520px) { .mlv-controls { grid-template-columns: 1fr; } }
</style>
