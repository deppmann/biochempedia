---
/**
 * BrownianMotion — the molecular basis of "things in water are never still." A
 * crowd of fast, invisible-scale water molecules ricochets around the box and
 * batters a larger tracer particle, whose center of mass therefore performs a
 * random walk (the jittering trail). Sliders for temperature and particle size
 * make the Einstein–Stokes intuition tangible: warmer water jiggles harder, and
 * a bigger particle averages out more kicks and drifts more slowly (D ∝ T/r).
 * Canvas animation; respects prefers-reduced-motion. Self-contained vanilla-TS
 * Astro island, no deps. Original, computed live.
 */
---

<figure class="bm card" data-brownian>
  <figcaption class="bm-head">Brownian motion — water never sits still<span class="bm-chip">⚙ original · interactive</span></figcaption>

  <canvas class="bm-canvas" width="600" height="360" data-canvas role="img" aria-label="A large tracer particle performing a random walk as it is struck by many small water molecules"></canvas>

  <div class="bm-controls">
    <label class="bm-slabel">Temperature <em data-out="temp">warm</em>
      <input type="range" data-in="temp" min="20" max="160" step="5" value="70" />
    </label>
    <label class="bm-slabel">Tracer size <em data-out="size">medium</em>
      <input type="range" data-in="size" min="5" max="20" step="1" value="10" />
    </label>
    <div class="bm-btns">
      <button type="button" data-toggle>❚❚ pause</button>
      <button type="button" data-reset>↺ reset trail</button>
      <label class="bm-check"><input type="checkbox" data-hidewater /> hide the water (Brown's view)</label>
    </div>
  </div>

  <dl class="bm-readout">
    <div><dt>Diffusion speed, D ∝ T/r <span class="bm-dt-sub">(vs. default)</span></dt><dd data-r-d>—</dd></div>
    <div><dt>Path traveled</dt><dd data-r-path>—</dd></div>
    <div><dt>Net distance from start</dt><dd data-r-net>—</dd></div>
  </dl>
  <p class="bm-why"><span>The big particle is never pushed by a hand — only by lopsided volleys of water molecules (each hit flashes dark). It travels a long, wandering path yet ends up only a short way from the start (the + mark): that is a random walk.</span> <span data-why aria-live="polite">Warm it up or shrink it and the walk speeds up.</span></p>

  <p class="bm-foot">Einstein's 1905 insight: the jitter you can see in a microscope is direct evidence of molecules you cannot. Diffusion is just this random walk, summed over billions of particles.</p>
</figure>

<script>
  type V = { x: number; y: number; vx: number; vy: number; hit?: number };
  document.querySelectorAll<HTMLElement>('[data-brownian]').forEach((root) => {
    const canvas = root.querySelector<HTMLCanvasElement>('[data-canvas]')!;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    // Logical drawing size stays 600×360; the backing store is scaled for crisp retina rendering.
    const W = 600, H = 360;
    const dpr = Math.min(2, window.devicePixelRatio || 1);
    canvas.width = W * dpr; canvas.height = H * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    const tempIn = root.querySelector<HTMLInputElement>('[data-in="temp"]')!;
    const sizeIn = root.querySelector<HTMLInputElement>('[data-in="size"]')!;
    const tempOut = root.querySelector<HTMLElement>('[data-out="temp"]')!;
    const sizeOut = root.querySelector<HTMLElement>('[data-out="size"]')!;
    const toggleBtn = root.querySelector<HTMLButtonElement>('[data-toggle]')!;
    const resetBtn = root.querySelector<HTMLButtonElement>('[data-reset]')!;
    const hideWater = root.querySelector<HTMLInputElement>('[data-hidewater]')!;
    const rD = root.querySelector<HTMLElement>('[data-r-d]')!;
    const rPath = root.querySelector<HTMLElement>('[data-r-path]')!;
    const rNet = root.querySelector<HTMLElement>('[data-r-net]')!;
    const why = root.querySelector<HTMLElement>('[data-why]')!;
    const ACCENT = '#0e7c86', NAVY = '#232d4b', WATER = 'rgba(43,111,176,0.5)', HIT = 'rgba(35,45,75,0.95)', GOLD = '212,168,67';
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const N = 110, WR = 2.4; // water "molecules" (a stand-in: real water has ~10^22 per mL)
    const mols: V[] = [];
    // Molecular speeds scale as √T (kinetic energy ∝ T); T is relative to the default setting.
    const Trel = () => parseInt(tempIn.value, 10) / 70;
    const rad = () => parseInt(sizeIn.value, 10);
    function seed() {
      mols.length = 0;
      for (let i = 0; i < N; i++) {
        const ang = Math.random() * Math.PI * 2, sp = 0.7 + Math.random() * 1.5;
        mols.push({ x: 6 + Math.random() * (W - 12), y: 6 + Math.random() * (H - 12), vx: Math.cos(ang) * sp, vy: Math.sin(ang) * sp, hit: 0 });
      }
    }
    let tracer: V = { x: W / 2, y: H / 2, vx: 0, vy: 0 };
    let trail: Array<[number, number]> = [];
    let origin: [number, number] = [W / 2, H / 2];
    let pathLen = 0;
    let running = true, raf = 0;
    let touched = false; // has the student moved a slider yet?

    function reset() {
      tracer = { x: W / 2, y: H / 2, vx: 0, vy: 0 };
      trail = [[W / 2, H / 2]];
      origin = [W / 2, H / 2];
      pathLen = 0;
      readouts();
    }

    function readouts() {
      const dx = tracer.x - origin[0], dy = tracer.y - origin[1];
      const net = Math.hypot(dx, dy);
      rPath.textContent = Math.round(pathLen).toLocaleString('en-US') + ' px';
      rNet.textContent = Math.round(net).toLocaleString('en-US') + ' px' + (pathLen > 50 ? ` (${Math.round((100 * net) / pathLen)}% of path)` : '');
    }

    function labels() {
      const t = parseInt(tempIn.value, 10);
      const tw = t < 45 ? 'cold' : t < 95 ? 'warm' : 'hot';
      tempOut.textContent = tw;
      const s = rad();
      const sw = s <= 8 ? 'small' : s <= 14 ? 'medium' : 'large';
      sizeOut.textContent = sw;
      const D = Trel() / (s / 10); // T / r, normalized to 1 at defaults
      rD.textContent = D.toFixed(2) + '×';
      tempIn.setAttribute('aria-valuetext', tw);
      sizeIn.setAttribute('aria-valuetext', `${sw} tracer`);
      if (touched) {
        why.textContent = D > 1.15
          ? `${tw[0].toUpperCase() + tw.slice(1)} water, ${sw} tracer: D is ${D.toFixed(1)}× the default, so the walk spreads faster — harder kicks, or a smaller particle that the water drags on less.`
          : D < 0.87
            ? `${tw[0].toUpperCase() + tw.slice(1)} water, ${sw} tracer: D is only ${D.toFixed(2)}× the default. Gentler kicks, or a bigger particle that the water drags on more, so the walk slows.`
            : `${tw[0].toUpperCase() + tw.slice(1)} water, ${sw} tracer: D is about the default.`;
      }
    }

    function step() {
      const sc = Math.sqrt(Trel());
      const r = rad();
      // water molecules: straight-line flight, bounce off the walls and off the tracer
      for (const m of mols) {
        m.x += m.vx * sc; m.y += m.vy * sc;
        if (m.x < WR || m.x > W - WR) m.vx *= -1;
        if (m.y < WR || m.y > H - WR) m.vy *= -1;
        m.x = Math.max(WR, Math.min(W - WR, m.x));
        m.y = Math.max(WR, Math.min(H - WR, m.y));
        const dx = m.x - tracer.x, dy = m.y - tracer.y, d = Math.hypot(dx, dy), min = r + WR;
        if (d < min && d > 0.001) {
          const nx = dx / d, ny = dy / d;
          const vn = m.vx * nx + m.vy * ny;
          if (vn < 0) {
            // reflect the molecule and hand the tracer a small impulse along the line of impact
            m.vx -= 2 * vn * nx; m.vy -= 2 * vn * ny;
            const imp = 0.05 * sc * vn * (10 / r) * (10 / r);
            tracer.vx += imp * nx; tracer.vy += imp * ny;
            m.hit = 10;
          }
          m.x = tracer.x + nx * min; m.y = tracer.y + ny * min;
        }
        if (m.hit) m.hit--;
      }
      // The few drawn molecules stand in for trillions: the rest of the bombardment is a random
      // kick whose variance ∝ T/r, so the walk's diffusion coefficient scales as D ∝ T/r.
      const kick = 1.8 * Math.sqrt(Trel() * (10 / r));
      tracer.vx += (Math.random() - 0.5) * kick;
      tracer.vy += (Math.random() - 0.5) * kick;
      tracer.vx *= 0.86; tracer.vy *= 0.86; // viscous damping
      const px = tracer.x, py = tracer.y;
      tracer.x += tracer.vx; tracer.y += tracer.vy;
      const m = r + 2;
      if (tracer.x < m || tracer.x > W - m) { tracer.vx *= -0.7; tracer.x = Math.max(m, Math.min(W - m, tracer.x)); }
      if (tracer.y < m || tracer.y > H - m) { tracer.vy *= -0.7; tracer.y = Math.max(m, Math.min(H - m, tracer.y)); }
      pathLen += Math.hypot(tracer.x - px, tracer.y - py);
      trail.push([tracer.x, tracer.y]);
      if (trail.length > 420) trail.shift();
    }

    function draw() {
      const c = ctx!;
      c.clearRect(0, 0, W, H);
      c.fillStyle = '#f5fbfc'; c.fillRect(0, 0, W, H);
      if (!hideWater.checked) {
        for (const mol of mols) {
          c.fillStyle = mol.hit ? HIT : WATER;
          c.beginPath(); c.arc(mol.x, mol.y, mol.hit ? 3 : WR, 0, Math.PI * 2); c.fill();
        }
      }
      // start marker
      c.strokeStyle = 'rgba(35,45,75,0.55)'; c.lineWidth = 1.2;
      c.beginPath(); c.moveTo(origin[0] - 5, origin[1]); c.lineTo(origin[0] + 5, origin[1]); c.moveTo(origin[0], origin[1] - 5); c.lineTo(origin[0], origin[1] + 5); c.stroke();
      // trail, fading with age so the most recent steps read clearly
      c.lineWidth = 1.6; c.lineJoin = 'round'; c.lineCap = 'round';
      const n = trail.length, CH = 30;
      for (let s0 = 0; s0 < n - 1; s0 += CH) {
        const s1 = Math.min(n - 1, s0 + CH);
        const age = 1 - s1 / (n - 1);
        c.strokeStyle = `rgba(${GOLD},${(0.25 + 0.75 * (1 - age)).toFixed(2)})`;
        c.beginPath(); c.moveTo(trail[s0][0], trail[s0][1]);
        for (let i = s0 + 1; i <= s1; i++) c.lineTo(trail[i][0], trail[i][1]);
        c.stroke();
      }
      // tracer
      const r = rad();
      c.fillStyle = ACCENT; c.beginPath(); c.arc(tracer.x, tracer.y, r, 0, Math.PI * 2); c.fill();
      c.strokeStyle = NAVY; c.lineWidth = 1.5; c.stroke();
    }

    let onScreen = true, frame = 0;
    function loop() {
      if (!running || !onScreen || document.hidden) return;
      step(); draw();
      if (++frame % 6 === 0) readouts(); // text updates ~10×/s, not every frame
      raf = requestAnimationFrame(loop);
    }
    function resume() { if (running && onScreen && !document.hidden && !reduce) { cancelAnimationFrame(raf); loop(); } }

    const onSlider = () => { touched = true; labels(); if (!running) draw(); };
    tempIn.addEventListener('input', onSlider);
    sizeIn.addEventListener('input', onSlider);
    hideWater.addEventListener('change', draw);
    toggleBtn.addEventListener('click', () => {
      running = !running;
      toggleBtn.textContent = running ? '❚❚ pause' : '▶ play';
      toggleBtn.setAttribute('aria-pressed', String(!running));
      cancelAnimationFrame(raf);
      if (running) loop();
    });
    resetBtn.addEventListener('click', () => { reset(); draw(); });

    // Don't burn CPU/battery animating when scrolled offscreen or the tab is hidden.
    if ('IntersectionObserver' in window) {
      new IntersectionObserver((entries) => { onScreen = entries[0].isIntersecting; resume(); }, { threshold: 0.01 }).observe(root);
    }
    document.addEventListener('visibilitychange', resume);

    seed(); reset(); labels();
    if (reduce) {
      // draw a static sample random walk so the idea reads without animation
      running = false; toggleBtn.textContent = '▶ play';
      for (let i = 0; i < 300; i++) step();
      for (const mol of mols) mol.hit = 0;
      readouts(); draw();
    } else {
      draw(); loop();
    }
  });
</script>

<style>
  .bm { padding: var(--ddp-space-3) var(--ddp-space-4) var(--ddp-space-4); margin: var(--ddp-space-5) 0; }
  .bm-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem; font-weight: 600; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); margin-bottom: var(--ddp-space-3); }
  .bm-chip { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 400; color: var(--ddp-color-muted); }
  .bm-canvas { width: 100%; height: auto; display: block; border: 1px solid var(--ddp-color-line); border-radius: 6px; background: #f5fbfc; }
  .bm-controls { display: grid; grid-template-columns: 1fr 1fr; gap: var(--ddp-space-2) var(--ddp-space-4); margin: var(--ddp-space-3) 0 var(--ddp-space-2); align-items: end; }
  @media (min-width: 640px) { .bm-controls { grid-template-columns: 1fr 1fr auto; } }
  .bm-slabel { display: flex; flex-direction: column; gap: 0.1rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .bm-slabel em { font-style: normal; font-weight: 700; color: var(--ddp-color-accent); font-family: var(--ddp-font-mono); }
  .bm-slabel input { accent-color: var(--ddp-color-accent); width: 100%; }
  .bm-btns { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem; grid-column: 1 / -1; }
  @media (min-width: 640px) { .bm-btns { grid-column: auto; } }
  .bm-btns button { font-family: inherit; font-size: var(--ddp-text-xs); border: 1px solid var(--ddp-color-line); background: #fff; color: var(--ddp-color-ink-soft); border-radius: 5px; padding: 0.3rem 0.55rem; cursor: pointer; }
  .bm-btns button:focus-visible, .bm-slabel input:focus-visible, .bm-check input:focus-visible { outline: 2px solid var(--ddp-color-accent); outline-offset: 2px; }
  .bm-btns button:hover { border-color: var(--ddp-color-accent); color: var(--ddp-color-primary); }
  .bm-check { display: flex; align-items: center; gap: 0.3rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .bm-check input { accent-color: var(--ddp-color-accent); }
  .bm-readout { display: grid; grid-template-columns: repeat(auto-fit, minmax(8.5rem, 1fr)); gap: var(--ddp-space-2); margin: var(--ddp-space-2) 0; padding: var(--ddp-space-2) var(--ddp-space-3); background: color-mix(in srgb, var(--ddp-color-accent) 8%, transparent); border-radius: 6px; }
  .bm-readout div { display: flex; flex-direction: column; gap: 0.1rem; }
  .bm-readout dt { font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .bm-dt-sub { opacity: 0.8; }
  .bm-readout dd { margin: 0; font-family: var(--ddp-font-mono); font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); font-weight: 700; }
  .bm-why { margin: 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); line-height: 1.5; min-height: 4.5em; }
  .bm-foot { margin: var(--ddp-space-3) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); border-left: 3px solid var(--ddp-color-secondary); padding-left: 0.55rem; }
</style>
