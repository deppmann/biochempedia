---
/**
 * PotassiumClearanceEk — extracellular potassium after intense firing and the E_K it
 * implies. [K+]o(t) = 3 + (peak - 3) x exp(-t/tau); E_K = 61.5 mV x log10([K+]o / 140)
 * (the lesson's 37 C form, [K+]i fixed at 140 mM). Self-contained vanilla-TS Astro
 * island. Original.
 */
---

<figure class="pce card" data-pce>
  <figcaption class="pce-head"><span>Potassium clearance — what a pile-up does to E<sub>K</sub></span><span class="pce-chip">⚙ original · interactive</span></figcaption>

  <svg class="pce-svg" viewBox="0 0 340 290" role="img" aria-label="Two stacked plots against time after intense firing ends: extracellular potassium falling from a peak back to 3 millimolar, and the potassium equilibrium potential computed from it, with a movable time cursor" data-plot></svg>

  <div class="pce-controls">
    <label class="pce-slabel"><span>Peak [K<sup>+</sup>]<sub>o</sub> when firing ends (illustrative) <em data-out="peak">12</em> mM</span>
      <input type="range" data-in="peak" min="3" max="20" step="0.5" value="12" />
    </label>
    <label class="pce-slabel"><span>Clearance time constant τ (illustrative) <em data-out="tau">2.0</em> s</span>
      <input type="range" data-in="tau" min="0.5" max="5" step="0.1" value="2" />
    </label>
    <label class="pce-slabel pce-wide"><span>Time cursor: seconds after firing ends <em data-out="t">0.0</em> s</span>
      <input type="range" data-in="t" min="0" max="10" step="0.1" value="0" />
    </label>
  </div>

  <dl class="pce-readout">
    <div><dt>[K<sup>+</sup>]<sub>o</sub> at the cursor</dt><dd data-r-k>12.0 mM</dd></div>
    <div><dt>E<sub>K</sub> at the cursor</dt><dd data-r-ek>−65.6 mV</dd></div>
    <div><dt>E<sub>K</sub> at rest, 3 mM</dt><dd data-r-rest>−102.6 mV</dd></div>
    <div><dt>E<sub>K</sub> at the peak</dt><dd data-r-peak>−65.6 mV</dd></div>
    <div><dt>Shift at the peak</dt><dd data-r-shift>+37.0 mV</dd></div>
    <div><dt>Excess [K<sup>+</sup>]<sub>o</sub> left at the cursor</dt><dd data-r-left>100%</dd></div>
  </dl>
  <p class="pce-math" data-r-math></p>
  <p class="pce-why" data-why role="status"></p>

  <p class="pce-assume">In this sketch (illustrative values from the lesson’s worked problem): potassium alone, [K<sup>+</sup>]<sub>i</sub> fixed at 140 mM, rest 3 mM, 37 °C, one exponential return to 3 mM with an illustrative τ (not a measured value).</p>
  <p class="pce-foot">Rule to keep: any fourfold rise in [K<sup>+</sup>]<sub>o</sub> shifts E<sub>K</sub> by 61.5 × log<sub>10</sub>(4) = 37.0 mV, whatever [K<sup>+</sup>]<sub>i</sub> is. The 1.85 s and 1.13 s of Tyurikova and colleagues are decays of an astrocyte current, not this τ.</p>
</figure>

<script>
  const NS = 'http://www.w3.org/2000/svg';
  const ACCENT = '#0e7c86', ORANGE = '#e57200', INK = '#4b4b55', FAINT = '#b9b9c2';
  const REST = 3, KI = 140, S = 61.5, TMAX = 10;
  const ek = (ko: number) => S * Math.log10(ko / KI);
  const fmt = (v: number) => (v < 0 ? '−' : '+') + Math.abs(v).toFixed(1);
  const neg = (v: number) => (v < 0 ? '−' : '') + Math.abs(v).toFixed(1);
  function el(name: string, attrs: Record<string, string | number>): SVGElement {
    const e = document.createElementNS(NS, name);
    for (const k in attrs) e.setAttribute(k, String(attrs[k]));
    return e;
  }
  document.querySelectorAll<HTMLElement>('[data-pce]').forEach((root) => {
    const plot = root.querySelector<SVGSVGElement>('[data-plot]')!;
    const q = (s: string) => root.querySelector<HTMLInputElement>(s)!;
    const o = (s: string) => root.querySelector<HTMLElement>(s)!;
    const peakIn = q('[data-in="peak"]'), tauIn = q('[data-in="tau"]'), tIn = q('[data-in="t"]');
    const peakOut = o('[data-out="peak"]'), tauOut = o('[data-out="tau"]'), tOut = o('[data-out="t"]');
    const rK = o('[data-r-k]'), rEk = o('[data-r-ek]'), rRest = o('[data-r-rest]'), rPeak = o('[data-r-peak]');
    const rShift = o('[data-r-shift]'), rLeft = o('[data-r-left]'), rMath = o('[data-r-math]'), why = o('[data-why]');

    const X0 = 46, X1 = 326;
    const A0 = 16, A1 = 106;   // top plot [K+]o: 0..20 mM
    const B0 = 140, B1 = 230;  // bottom plot E_K: -115..-45 mV
    const KMAX = 20, EMIN = -115, EMAX = -45;
    const px = (t: number) => X0 + (t / TMAX) * (X1 - X0);
    const pa = (k: number) => A1 - (k / KMAX) * (A1 - A0);
    const pb = (e: number) => B1 - ((e - EMIN) / (EMAX - EMIN)) * (B1 - B0);
    const text = (x: number, y: number, s: string, anchor: string, extra: Record<string, string | number> = {}) => {
      const t = el('text', { x, y, 'text-anchor': anchor, 'font-size': 9, fill: INK, ...extra }); t.textContent = s; plot.appendChild(t);
    };
    function path(f: (t: number) => number, py: (v: number) => number, stroke: string) {
      let d = '';
      for (let i = 0; i <= 100; i++) { const t = (i / 100) * TMAX; d += (i ? 'L' : 'M') + px(t).toFixed(1) + ' ' + py(f(t)).toFixed(1) + ' '; }
      plot.appendChild(el('path', { d: d.trim(), fill: 'none', stroke, 'stroke-width': 2.6 }));
    }
    function render() {
      const peak = parseFloat(peakIn.value), tau = parseFloat(tauIn.value), t = parseFloat(tIn.value);
      peakOut.textContent = peak.toFixed(peak % 1 ? 1 : 0); tauOut.textContent = tau.toFixed(1); tOut.textContent = t.toFixed(1);
      const ko = (tt: number) => REST + (peak - REST) * Math.exp(-tt / tau);
      const eRest = ek(REST), ePeak = ek(peak), kt = ko(t), et = ek(kt);
      const left = peak > REST ? Math.exp(-t / tau) * 100 : 0;
      const tTen = tau * Math.LN10;

      plot.replaceChildren();
      // axes
      for (const [y0, y1] of [[A0, A1], [B0, B1]]) {
        plot.appendChild(el('line', { x1: X0, y1: y0, x2: X0, y2: y1, stroke: INK, 'stroke-width': 1 }));
        plot.appendChild(el('line', { x1: X0, y1: y1, x2: X1, y2: y1, stroke: INK, 'stroke-width': 1 }));
      }
      for (const k of [0, 5, 10, 15, 20]) { text(X0 - 4, pa(k) + 3, String(k), 'end'); }
      for (const e of [-110, -90, -70, -50]) {
        plot.appendChild(el('line', { x1: X0, y1: pb(e), x2: X0 - 3, y2: pb(e), stroke: INK, 'stroke-width': 1 }));
        text(X0 - 5, pb(e) + 3, String(e).replace('-', '−'), 'end');
      }
      for (let s = 0; s <= TMAX; s += 2) {
        plot.appendChild(el('line', { x1: px(s), y1: B1, x2: px(s), y2: B1 + 3, stroke: INK, 'stroke-width': 1 }));
        text(px(s), B1 + 13, String(s), 'middle');
      }
      text((X0 + X1) / 2, B1 + 28, 'time after intense firing ends (s)', 'middle', { 'font-size': 10 });
      text(X0 - 2, A0 - 5, '[K⁺]ₒ (mM)', 'start', { 'font-size': 10 });
      text(X0 - 2, B0 - 5, 'E_K (mV)', 'start', { 'font-size': 10 });

      // rest lines
      plot.appendChild(el('line', { x1: X0, y1: pa(REST), x2: X1, y2: pa(REST), stroke: FAINT, 'stroke-width': 1, 'stroke-dasharray': '4 3' }));
      text(X1, pa(REST) + 11, 'rest 3 mM', 'end');
      plot.appendChild(el('line', { x1: X0, y1: pb(eRest), x2: X1, y2: pb(eRest), stroke: FAINT, 'stroke-width': 1, 'stroke-dasharray': '4 3' }));
      text(X1, pb(eRest) + 11, 'rest −102.6 mV', 'end');

      path(ko, pa, ACCENT);
      path((tt) => ek(ko(tt)), pb, ACCENT);

      // 10% of the excess marker
      if (peak > REST && tTen <= TMAX) {
        const kx = ko(tTen);
        plot.appendChild(el('path', { d: `M${px(tTen)} ${pa(kx) - 5} l5 5 l-5 5 l-5 -5 z`, fill: 'none', stroke: ORANGE, 'stroke-width': 1.5 }));
        plot.appendChild(el('path', { d: `M${px(tTen)} ${pb(ek(kx)) - 5} l5 5 l-5 5 l-5 -5 z`, fill: 'none', stroke: ORANGE, 'stroke-width': 1.5 }));
      }
      // cursor
      plot.appendChild(el('line', { x1: px(t), y1: A0, x2: px(t), y2: B1, stroke: ORANGE, 'stroke-width': 1.2, 'stroke-dasharray': '3 2' }));
      plot.appendChild(el('circle', { cx: px(t), cy: pa(kt), r: 4, fill: ORANGE }));
      plot.appendChild(el('circle', { cx: px(t), cy: pb(et), r: 4, fill: ORANGE }));

      rK.textContent = kt.toFixed(1) + ' mM';
      rEk.textContent = neg(et) + ' mV';
      rRest.textContent = neg(eRest) + ' mV';
      rPeak.textContent = neg(ePeak) + ' mV';
      rShift.textContent = fmt(ePeak - eRest) + ' mV';
      rLeft.textContent = left.toFixed(0) + '%';
      const ratio = peak / REST;
      rMath.textContent = peak > REST
        ? `At the cursor: [K⁺]ₒ = 3 + (${peak} − 3) × e^(−${t.toFixed(1)}/${tau.toFixed(1)}) = ${kt.toFixed(2)} mM; E_K = 61.5 × log₁₀(${kt.toFixed(2)}/140) = ${neg(et)} mV. Peak: ${ratio.toFixed(2)}-fold over rest, so 61.5 × log₁₀(${ratio.toFixed(2)}) = ${fmt(ePeak - eRest)} mV. Ten percent of the excess is left at τ × ln 10 = ${tTen.toFixed(1)} s${tTen > TMAX ? ' (past the 10 s axis)' : ' (orange diamonds)'}. Any fourfold rise, for example 3 to 12 mM, shifts E_K by 61.5 × log₁₀(4) = +37.0 mV.`
        : `Peak equals rest (3 mM): the ratio is 1, log₁₀(1) = 0, so there is no rise and no shift, and E_K stays at 61.5 × log₁₀(3/140) = −102.6 mV. Any fourfold rise, for example 3 to 12 mM, shifts E_K by 61.5 × log₁₀(4) = +37.0 mV.`;

      let msg: string;
      if (peak <= REST) {
        msg = 'No pile-up, so no shift: E_K stays at its resting value in this sketch.';
      } else if (left > 99.5) {
        msg = `Just after firing ends, outside potassium is ${peak.toFixed(1)} mM instead of 3 mM and E_K sits ${fmt(ePeak - eRest)} mV more positive than at rest. `;
      } else if (left < 0.5) {
        msg = 'By now the excess is essentially gone and E_K is back near its resting value in this sketch. ';
      } else {
        msg = `${left.toFixed(0)}% of the excess potassium is still outside, and E_K is ${Math.abs(et - eRest).toFixed(1)} mV more positive than at rest. `;
      }
      if (peak > REST) msg += 'A real neuron’s resting potential moves less than E_K, because other ions contribute, but it moves the same way, toward threshold. This sketch uses one illustrative decay for clearance as a whole; spatial buffering (Kir4.1, gap junctions) and net Na/K ATPase uptake are distinct mechanisms, which it does not separate.';
      why.textContent = msg.trim();
    }
    [peakIn, tauIn, tIn].forEach((s) => s.addEventListener('input', render));
    render();
  });
</script>

<style>
  .pce { padding: var(--ddp-space-3) var(--ddp-space-4) var(--ddp-space-4); margin: var(--ddp-space-5) 0; }
  .pce-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem; font-weight: 600; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); margin-bottom: var(--ddp-space-3); }
  .pce-chip { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 400; color: var(--ddp-color-muted); }
  .pce-svg { display: block; width: 100%; max-width: 560px; margin: 0 auto; height: auto; background: #fff; border: 1px solid var(--ddp-color-line); border-radius: 6px; }
  .pce-controls { display: grid; grid-template-columns: 1fr 1fr; gap: var(--ddp-space-2) var(--ddp-space-4); margin: var(--ddp-space-3) 0 var(--ddp-space-2); }
  .pce-wide { grid-column: 1 / -1; }
  .pce-slabel { display: flex; flex-direction: column; gap: 0.1rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .pce-slabel em { font-style: normal; font-weight: 700; color: var(--ddp-color-accent); font-family: var(--ddp-font-mono); }
  .pce-slabel input { accent-color: var(--ddp-color-accent); }
  .pce-readout { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--ddp-space-2); margin: var(--ddp-space-2) 0; padding: var(--ddp-space-2) var(--ddp-space-3); background: color-mix(in srgb, var(--ddp-color-accent) 8%, transparent); border-radius: 6px; }
  .pce-readout div { display: flex; flex-direction: column; gap: 0.1rem; }
  .pce-readout dt { font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .pce-readout dd { margin: 0; font-family: var(--ddp-font-mono); font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); font-weight: 700; }
  .pce-math { margin: 0 0 var(--ddp-space-2); font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); line-height: 1.5; min-height: 7em; overflow-wrap: anywhere; }
  .pce-why { margin: 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); line-height: 1.5; min-height: 6em; }
  .pce-assume { margin: var(--ddp-space-2) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .pce-foot { margin: var(--ddp-space-2) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); border-left: 3px solid var(--ddp-color-secondary); padding-left: 0.55rem; }
  @media (max-width: 480px) { .pce-controls { grid-template-columns: 1fr; } .pce-readout { grid-template-columns: 1fr 1fr; } }
</style>
