---
/**
 * DriverLineSpecificity — a count board for one made-up driver-line validation.
 * Three blocks of dots (one dot = one cell): labelled but marker-negative, labelled
 * and marker-positive (the overlap), and marker-positive but not labelled. Specificity
 * (overlap / all labelled) and efficiency (overlap / all marker-positive) are computed
 * separately from the same overlap. Counts are made up; no random sampling. Original.
 */
---

<figure class="dls card" data-dls>
  <figcaption class="dls-head">Driver line: specificity and efficiency<span class="dls-chip">⚙ original · interactive</span></figcaption>

  <svg class="dls-svg" viewBox="0 0 340 222" role="img" aria-label="Three blocks of dots: cells labelled by the line but marker-negative, cells both labelled and marker-positive, and marker-positive cells not labelled" data-board></svg>

  <div class="dls-controls">
    <label class="dls-slabel"><span>Labelled cells <em data-out="lab">200</em></span>
      <input type="range" data-in="lab" min="50" max="300" step="5" value="200" />
    </label>
    <label class="dls-slabel"><span>Of those, marker-positive (overlap) <em data-out="ov">180</em></span>
      <input type="range" data-in="ov" min="0" max="200" step="5" value="180" />
    </label>
    <label class="dls-slabel"><span>All marker-positive cells in the sections <em data-out="mk">300</em></span>
      <input type="range" data-in="mk" min="180" max="500" step="5" value="300" />
    </label>
  </div>

  <div class="dls-presets">
    <button type="button" class="dls-btn" data-preset="200,180,300">Lesson example: 200, 180, 300</button>
    <button type="button" class="dls-btn" data-preset="150,120,240">Practice case: 150, 120, 240</button>
    <button type="button" class="dls-btn" data-preset="200,200,200">Equal case: 200, 200, 200</button>
  </div>

  <dl class="dls-readout">
    <div><dt>Specificity = labelled and marker-positive / all labelled</dt><dd data-r-spec>180 / 200 = 90%</dd></div>
    <div><dt>Efficiency = labelled and marker-positive / all marker-positive</dt><dd data-r-eff>180 / 300 = 60%</dd></div>
  </dl>

  <p class="dls-why" data-why role="status"></p>
  <p class="dls-fixed">Reading: a line can be good for imaging the right cells and weak for an ablation, because losing part of a population (60% in the lesson’s example) and seeing no deficit does not show the population is unneeded. A CreER label records expression at the time of induction, so the same driver induced at two ages can capture two populations (TrkC-CreER at E12.5 versus P5, Bai et al., 2015).</p>
  <p class="dls-sketch">In this sketch: made-up counts of cells in sections, with in situ hybridization as the reference for “marker-positive”; these are not cells in an animal, and no cluster count and no physiology follows from these two numbers.</p>

  <p class="dls-foot">Specificity and efficiency share the same numerator, the labelled and marker-positive cells, but divide by different totals, so a line can score high on one and low on the other.</p>
</figure>

<script>
  const NS = 'http://www.w3.org/2000/svg';
  const INK = '#4b4b55', GREY = '#8d8d99', ACCENT = '#0e7c86', ORANGE = '#e57200';
  function el(name: string, attrs: Record<string, string | number>): SVGElement {
    const e = document.createElementNS(NS, name);
    for (const k in attrs) e.setAttribute(k, String(attrs[k]));
    return e;
  }
  function txt(x: number, y: number, s: string, opts: Record<string, string | number> = {}): SVGElement {
    const t = el('text', Object.assign({ x, y, 'text-anchor': 'middle', 'font-size': 10.5, fill: INK }, opts));
    t.textContent = s;
    return t;
  }
  const pct = (v: number) => (Math.round(v * 1000) / 10).toString() + '%';

  document.querySelectorAll<HTMLElement>('[data-dls]').forEach((root) => {
    const board = root.querySelector<SVGSVGElement>('[data-board]');
    const labIn = root.querySelector<HTMLInputElement>('[data-in="lab"]');
    const ovIn = root.querySelector<HTMLInputElement>('[data-in="ov"]');
    const mkIn = root.querySelector<HTMLInputElement>('[data-in="mk"]');
    const labOut = root.querySelector<HTMLElement>('[data-out="lab"]');
    const ovOut = root.querySelector<HTMLElement>('[data-out="ov"]');
    const mkOut = root.querySelector<HTMLElement>('[data-out="mk"]');
    const rSpec = root.querySelector<HTMLElement>('[data-r-spec]');
    const rEff = root.querySelector<HTMLElement>('[data-r-eff]');
    const why = root.querySelector<HTMLElement>('[data-why]');
    if (!board || !labIn || !ovIn || !mkIn || !labOut || !ovOut || !mkOut || !rSpec || !rEff || !why) return;

    const COLS = 20, PITCH = 4.5, TOP = 68;
    const BX = [10, 120, 230]; // block left edges, each 100 wide

    function block(i: number, n: number, color: string) {
      if (!board) return;
      for (let k = 0; k < n; k++) {
        const c = k % COLS, r = Math.floor(k / COLS);
        board.appendChild(el('rect', { x: BX[i] + c * PITCH + 1, y: TOP + r * PITCH, width: 3.2, height: 3.2, fill: color }));
      }
    }
    function bracket(x1: number, x2: number, y: number, up: boolean, label: string, color: string) {
      if (!board) return;
      const d = up ? 5 : -5;
      board.appendChild(el('path', { d: `M${x1} ${y + d} V${y} H${x2} V${y + d}`, fill: 'none', stroke: color, 'stroke-width': 1.5 }));
      board.appendChild(txt((x1 + x2) / 2, up ? y - 4 : y + 13, label, { fill: color, 'font-weight': 700 }));
    }

    function render() {
      if (!board || !labIn || !ovIn || !mkIn) return;
      let lab = parseInt(labIn.value, 10);
      let ov = parseInt(ovIn.value, 10);
      let mk = parseInt(mkIn.value, 10);
      // The overlap can never exceed either total.
      ov = Math.min(ov, lab);
      ovIn.max = String(lab);
      mk = Math.max(mk, ov);
      mkIn.min = String(ov);
      ovIn.value = String(ov);
      mkIn.value = String(mk);
      labOut!.textContent = String(lab);
      ovOut!.textContent = String(ov);
      mkOut!.textContent = String(mk);

      const labOnly = lab - ov, mkOnly = mk - ov;
      board.replaceChildren();

      bracket(BX[0] + 2, BX[1] + 98, 24, true, `Labelled by the line: ${lab}`, ORANGE);
      const titles: string[][] = [['Labelled,', 'marker-negative'], ['Labelled and', 'marker-positive'], ['Marker-positive,', 'not labelled']];
      const counts = [labOnly, ov, mkOnly];
      const colors = [ORANGE, ACCENT, GREY];
      for (let i = 0; i < 3; i++) {
        const cx = BX[i] + 50;
        board.appendChild(txt(cx, 36, titles[i][0], { fill: colors[i], 'font-weight': 700 }));
        board.appendChild(txt(cx, 48, titles[i][1], { fill: colors[i], 'font-weight': 700 }));
        board.appendChild(txt(cx, 62, String(counts[i]) + (counts[i] === 1 ? ' cell' : ' cells'), { fill: INK }));
        block(i, counts[i], colors[i]);
      }
      bracket(BX[1] + 2, BX[2] + 98, 191, false, `Marker-positive in the sections: ${mk}`, GREY);
      board.appendChild(txt(170, 216, 'one square = one cell; counts are made up', { 'font-size': 10, fill: INK }));

      const specTxt = `${ov} / ${lab} = ${pct(ov / lab)}`;
      const effTxt = mk > 0 ? `${ov} / ${mk} = ${pct(ov / mk)}` : `${ov} / ${mk}: undefined (no marker-positive cells)`;
      rSpec!.textContent = specTxt;
      rEff!.textContent = effTxt;

      let s: string;
      if (mk === 0) {
        s = `No cell is marker-positive, so efficiency has nothing to divide by. Specificity is ${specTxt}: all ${lab} labelled cells are marker-negative.`;
      } else if (ov === 0) {
        s = `No labelled cell is marker-positive: specificity and efficiency are both 0%. The line labels ${lab} marker-negative cells and misses all ${mk} marker-positive ones.`;
      } else if (lab === mk && ov === lab) {
        s = `Every labelled cell is marker-positive and every marker-positive cell is labelled, so specificity and efficiency are both 100%. They coincide here only because the overlap equals both totals.`;
      } else if (lab === mk) {
        s = `The two totals are both ${lab}, so specificity and efficiency are equal (${pct(ov / lab)}) while the line still labels ${labOnly} marker-negative cells and misses ${mkOnly} marker-positive ones. Equal values do not make them the same quantity.`;
      } else if (ov / lab > ov / mk) {
        s = `Specificity (${pct(ov / lab)}) is higher than efficiency (${pct(ov / mk)}): ${ov} of the ${lab} labelled cells are on target, but ${mkOnly} of the ${mk} marker-positive cells are not labelled. If the labelled cells were killed, ${pct(ov / mk)} of the marker-positive cells in these sections would be lost; as in the lesson’s 60% example, seeing no deficit then would not show the population is unneeded.`;
      } else {
        s = `Efficiency (${pct(ov / mk)}) is higher than specificity (${pct(ov / lab)}): the line reaches ${ov} of the ${mk} marker-positive cells, but ${labOnly} of its ${lab} labelled cells are marker-negative. Same numerator, different denominators.`;
      }
      why!.textContent = s;
    }

    [labIn, ovIn, mkIn].forEach((x) => x.addEventListener('input', render));
    root.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach((b) => {
      b.addEventListener('click', () => {
        const p = (b.getAttribute('data-preset') || '').split(',').map((v) => parseInt(v, 10));
        if (p.length !== 3 || p.some((v) => isNaN(v))) return;
        // set the loosest bounds first so each value is accepted
        ovIn.max = '300'; mkIn.min = '0';
        labIn.value = String(p[0]); ovIn.value = String(p[1]); mkIn.value = String(p[2]);
        render();
      });
    });
    render();
  });
</script>

<style>
  .dls { padding: var(--ddp-space-3) var(--ddp-space-4) var(--ddp-space-4); margin: var(--ddp-space-5) 0; }
  .dls-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem; font-weight: 600; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); margin-bottom: var(--ddp-space-3); }
  .dls-chip { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 400; color: var(--ddp-color-muted); }
  .dls-svg { display: block; width: 100%; max-width: 560px; margin: 0 auto; height: auto; background: #fff; border: 1px solid var(--ddp-color-line); border-radius: 6px; }
  .dls-controls { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: var(--ddp-space-2) var(--ddp-space-4); margin: var(--ddp-space-3) 0 var(--ddp-space-2); }
  .dls-slabel { display: flex; flex-direction: column; gap: 0.1rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .dls-slabel em { font-style: normal; font-weight: 700; color: var(--ddp-color-accent); font-family: var(--ddp-font-mono); }
  .dls-slabel input { accent-color: var(--ddp-color-accent); }
  .dls-presets { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: var(--ddp-space-2) 0; }
  .dls-btn { font: inherit; font-size: var(--ddp-text-xs); padding: 0.3rem 0.6rem; border: 1px solid var(--ddp-color-line); border-radius: 6px; background: #fff; color: var(--ddp-color-ink-soft); cursor: pointer; }
  .dls-btn:hover, .dls-btn:focus-visible { border-color: var(--ddp-color-accent); color: var(--ddp-color-primary); }
  .dls-readout { display: grid; grid-template-columns: 1fr 1fr; gap: var(--ddp-space-2); margin: var(--ddp-space-2) 0; padding: var(--ddp-space-2) var(--ddp-space-3); background: color-mix(in srgb, var(--ddp-color-accent) 8%, transparent); border-radius: 6px; }
  .dls-readout div { display: flex; flex-direction: column; gap: 0.1rem; }
  .dls-readout dt { font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .dls-readout dd { margin: 0; font-family: var(--ddp-font-mono); font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); font-weight: 700; overflow-wrap: anywhere; }
  .dls-why { margin: 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); line-height: 1.5; min-height: 4.5em; }
  .dls-fixed, .dls-sketch { margin: var(--ddp-space-2) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); line-height: 1.5; }
  .dls-sketch { color: var(--ddp-color-muted); }
  .dls-foot { margin: var(--ddp-space-3) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); border-left: 3px solid var(--ddp-color-secondary); padding-left: 0.55rem; }
  @media (max-width: 560px) { .dls-controls, .dls-readout { grid-template-columns: 1fr; } }
</style>
