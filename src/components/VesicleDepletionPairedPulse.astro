---
/**
 * VesicleDepletionPairedPulse — the lesson's simplest depletion model as a sketch.
 * EPSC_n = F x S x (1 - F)^(n-1) x i, with i = 10 pA. Bars for a train of pulses; the vesicle
 * pool is drawn as a block of dots emptied pulse by pulse. Original.
 */
---

<figure class="vd card" data-vdp>
  <figcaption class="vd-head">Depletion and the paired-pulse ratio — EPSC bars from a vesicle pool<span class="vd-chip">⚙ original · interactive</span></figcaption>

  <svg class="vd-svg" viewBox="0 0 340 316" role="img" aria-label="Bars of the EPSC for each pulse in a train, computed from the simplest depletion model, above a block of dots showing the releasable vesicle pool being emptied pulse by pulse" data-plot></svg>

  <div class="vd-controls">
    <label class="vd-slabel"><span>Release fraction F <em data-out="f">0.40</em></span>
      <input type="range" data-in="f" min="0.05" max="0.9" step="0.05" value="0.4" />
    </label>
    <label class="vd-slabel"><span>Releasable pool S <em data-out="s">100</em> vesicles</span>
      <input type="range" data-in="s" min="50" max="200" step="10" value="100" />
    </label>
    <label class="vd-slabel"><span>Pulses shown <em data-out="n">4</em></span>
      <input type="range" data-in="n" min="2" max="10" step="1" value="4" />
    </label>
  </div>

  <dl class="vd-readout">
    <div><dt>EPSC1 = F × S × i</dt><dd data-r-1>—</dd></div>
    <div><dt>Pool left after pulse 1</dt><dd data-r-pool>—</dd></div>
    <div><dt>EPSC2 = F × pool × i</dt><dd data-r-2>—</dd></div>
    <div><dt>Ratio EPSC2 / EPSC1</dt><dd data-r-ppr>—</dd></div>
  </dl>
  <p class="vd-why" data-why role="status">—</p>

  <p class="vd-assume">In this sketch: the simplest depletion model, no refilling between pulses, no facilitation, a fixed release fraction F and a fixed current per vesicle (i = 10 pA); pulses 3 onward simply apply the same rule again, the lesson works only a pair; the F and S ranges are teaching ranges and all values are teaching values, vesicle numbers are averages, and the dots are rounded to whole vesicles.</p>
  <p class="vd-foot">Rule to keep: in this model the ratio EPSC2 / EPSC1 equals 1 − F whatever the pool size, so a measured 0.60 (for F = 0.40) is what 40% depletion would give but does not prove depletion.</p>
</figure>

<script>
  const NS = 'http://www.w3.org/2000/svg';
  const ACCENT = '#0e7c86', ORANGE = '#e57200', INK = '#4b4b55', FAINT = '#b9b9c2';
  const I_PA = 10, YMAX = 2000;

  function el(name: string, attrs: Record<string, string | number>): SVGElement {
    const e = document.createElementNS(NS, name);
    for (const k in attrs) e.setAttribute(k, String(attrs[k]));
    return e;
  }
  const fmt = (x: number) => String(Math.round(x * 10) / 10);

  document.querySelectorAll<HTMLElement>('[data-vdp]').forEach((root) => {
    const plot = root.querySelector<SVGSVGElement>('[data-plot]')!;
    const o = (s: string) => root.querySelector<HTMLElement>(s)!;
    const inp = (k: string) => root.querySelector<HTMLInputElement>(`[data-in="${k}"]`)!;
    const fIn = inp('f'), sIn = inp('s'), nIn = inp('n');
    const fOut = o('[data-out="f"]'), sOut = o('[data-out="s"]'), nOut = o('[data-out="n"]');
    const r1 = o('[data-r-1]'), rPool = o('[data-r-pool]'), r2 = o('[data-r-2]'), rPpr = o('[data-r-ppr]');
    const why = o('[data-why]');

    const X0 = 40, X1 = 330, Y0 = 34, Y1 = 150;
    const py = (v: number) => Y1 - (v / YMAX) * (Y1 - Y0);

    function draw(): void {
      const F = parseFloat(fIn.value), S = parseFloat(sIn.value), N = parseInt(nIn.value, 10);
      fOut.textContent = F.toFixed(2); sOut.textContent = String(S); nOut.textContent = String(N);
      const epsc = (n: number) => F * S * Math.pow(1 - F, n - 1) * I_PA;
      const pool = (n: number) => S * Math.pow(1 - F, n); // vesicles left after pulse n
      const e1 = epsc(1), e2 = epsc(2), ratio = e2 / e1;

      plot.replaceChildren();
      const t = (x: number, y: number, s: string, extra: Record<string, string | number> = {}) => {
        const e = el('text', { x, y, 'font-size': 9, fill: INK, ...extra }); e.textContent = s; plot.appendChild(e);
      };
      // axes
      plot.appendChild(el('line', { x1: X0, y1: Y0, x2: X0, y2: Y1, stroke: INK, 'stroke-width': 1 }));
      plot.appendChild(el('line', { x1: X0, y1: Y1, x2: X1, y2: Y1, stroke: INK, 'stroke-width': 1 }));
      for (const v of [0, 500, 1000, 1500, 2000]) {
        plot.appendChild(el('line', { x1: X0, y1: py(v), x2: X1, y2: py(v), stroke: FAINT, 'stroke-width': 0.6, 'stroke-dasharray': '2 3' }));
        t(X0 - 4, py(v) + 3, String(v), { 'text-anchor': 'end' });
      }
      t(X0 - 2, Y0 - 18, 'EPSC (pA), fixed axis', { 'text-anchor': 'start' });
      t((X0 + X1) / 2, Y1 + 24, 'pulse number in the train', { 'text-anchor': 'middle', 'font-size': 10 });
      // EPSC1 reference line
      plot.appendChild(el('line', { x1: X0, y1: py(e1), x2: X1, y2: py(e1), stroke: ORANGE, 'stroke-width': 1, 'stroke-dasharray': '4 3' }));
      // bars
      const slot = (X1 - X0) / 10, bw = slot * 0.62;
      for (let n = 1; n <= N; n++) {
        const v = epsc(n), cx = X0 + slot * (n - 0.5), h = Math.max(1, Y1 - py(v));
        plot.appendChild(el('rect', { x: cx - bw / 2, y: Y1 - h, width: bw, height: h, fill: ACCENT, 'fill-opacity': n <= 2 ? 1 : 0.55 }));
        t(cx, Y1 + 12, String(n), { 'text-anchor': 'middle', 'font-weight': 700 });
        const ly = Math.max(Y0 + 8, Y1 - h - 3);
        t(cx, ly, fmt(v), { 'text-anchor': 'middle', 'font-size': 9 });
      }
      t(X1, Y0 - 18, 'dashed line: EPSC1', { 'text-anchor': 'end', fill: ORANGE });

      // pool block of dots
      const PY = 204;
      t(X0 - 2, PY - 10, `Releasable pool after pulse ${N}: ${fmt(pool(N))} of ${S} vesicles left`, { 'text-anchor': 'start' });
      const cols = 25, dx = (X1 - X0) / cols, dy = 8.5, rad = 3;
      const cum = (n: number) => Math.round(S * (1 - Math.pow(1 - F, n))); // released after n pulses
      for (let k = 0; k < S; k++) {
        let pulse = 0;
        for (let n = 1; n <= N; n++) { if (k < cum(n)) { pulse = n; break; } }
        const cx = X0 + dx * (k % cols) + dx / 2, cy = PY + dy * Math.floor(k / cols);
        if (pulse === 0) plot.appendChild(el('circle', { cx, cy, r: rad, fill: ACCENT }));
        else plot.appendChild(el('circle', { cx, cy, r: rad, fill: ORANGE, 'fill-opacity': Math.max(0.2, 1 - (pulse - 1) * 0.1), stroke: ORANGE, 'stroke-width': 0.6 }));
      }
      const LY = PY + dy * 8 + 8;
      plot.appendChild(el('circle', { cx: X0 + 4, cy: LY - 3, r: rad, fill: ACCENT }));
      t(X0 + 11, LY, 'still releasable');
      plot.appendChild(el('circle', { cx: X0 + 100, cy: LY - 3, r: rad, fill: ORANGE }));
      t(X0 + 107, LY, 'released by a pulse (darker = earlier pulse)');

      // readouts
      r1.textContent = `${F.toFixed(2)} × ${S} × ${I_PA} pA = ${fmt(e1)} pA`;
      rPool.textContent = `${S} × (1 − ${F.toFixed(2)}) = ${fmt(pool(1))} vesicles`;
      r2.textContent = `${F.toFixed(2)} × ${fmt(pool(1))} × ${I_PA} pA = ${fmt(e2)} pA`;
      rPpr.textContent = `${fmt(e2)} / ${fmt(e1)} = ${ratio.toFixed(2)} (= 1 − F); ${Math.round(F * 100)}% depression`;

      // status
      const parts: string[] = [];
      parts.push(`In this sketch, with F = ${F.toFixed(2)}, each pulse releases ${Math.round(F * 100)}% of the vesicles still in a pool of ${S}, so each EPSC is ${(1 - F).toFixed(2)} times the one before. EPSC1 is ${fmt(e1)} pA, ${fmt(pool(1))} vesicles are left, EPSC2 is ${fmt(e2)} pA, and the ratio is ${ratio.toFixed(2)}, a ${Math.round(F * 100)}% depression.`);
      if (F <= 0.051) parts.push(`With so small a fraction released, the pool hardly empties and the ratio stays near 1, but it never reaches it.`);
      else if (F >= 0.899) parts.push(`With nine tenths of the pool released by the first pulse, almost nothing is left for the second.`);
      if (S !== 100 && Math.abs(F - 0.4) < 0.001) parts.push(`S changes every bar by the same factor but not the ratio.`);
      parts.push(`In this model a ratio above 1 cannot occur. Facilitation is a different process: at the mouse synapses Jackman and colleagues tested, synaptotagmin 7 was needed for it and reads residual Ca2+ (see the lesson). A measured ratio of ${ratio.toFixed(2)} would not prove depletion, since other processes can give the same number, and at many synapses simple depletion cannot explain depression.`);
      why.textContent = parts.join(' ');
    }
    [fIn, sIn, nIn].forEach((x) => x.addEventListener('input', draw));
    draw();
  });
</script>

<style is:global>
  .vd { padding: var(--ddp-space-3) var(--ddp-space-4) var(--ddp-space-4); margin: var(--ddp-space-5) 0; }
  .vd-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem; font-weight: 600; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); margin-bottom: var(--ddp-space-3); }
  .vd-chip { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 400; color: var(--ddp-color-muted); }
  .vd-svg { display: block; width: 100%; max-width: 560px; margin: 0 auto; height: auto; background: #fff; border: 1px solid var(--ddp-color-line); border-radius: 6px; }
  .vd-controls { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: var(--ddp-space-2) var(--ddp-space-4); margin: var(--ddp-space-3) 0 var(--ddp-space-2); }
  .vd-slabel { display: flex; flex-direction: column; gap: 0.1rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .vd-slabel em { font-style: normal; font-weight: 700; color: var(--ddp-color-accent); font-family: var(--ddp-font-mono); }
  .vd-slabel input { accent-color: var(--ddp-color-accent); }
  .vd-readout { display: grid; grid-template-columns: 1fr 1fr; gap: var(--ddp-space-2); margin: var(--ddp-space-2) 0; padding: var(--ddp-space-2) var(--ddp-space-3); background: color-mix(in srgb, var(--ddp-color-accent) 8%, transparent); border-radius: 6px; }
  .vd-readout div { display: flex; flex-direction: column; gap: 0.1rem; min-width: 0; }
  .vd-readout dt { font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .vd-readout dd { margin: 0; font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); color: var(--ddp-color-primary); font-weight: 700; overflow-wrap: anywhere; }
  .vd-why { margin: 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); line-height: 1.5; min-height: 6em; }
  .vd-assume { margin: var(--ddp-space-2) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .vd-foot { margin: var(--ddp-space-2) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); border-left: 3px solid var(--ddp-color-secondary); padding-left: 0.55rem; }
  @media (max-width: 480px) { .vd-controls { grid-template-columns: 1fr; } .vd-readout { grid-template-columns: 1fr; } }
</style>
