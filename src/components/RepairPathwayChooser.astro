---
/**
 * RepairPathwayChooser — pick a kind of DNA damage and see which repair system handles it.
 * Mismatch -> mismatch repair; damaged base -> base excision repair; bulky lesion ->
 * nucleotide excision repair; double-strand break -> end joining or homologous recombination,
 * depending on the cell-cycle phase (no sister chromatid in G1). Every rule is a statement of
 * the dna-repair-and-recombination lesson; the one calculation (mismatch repair lowers the
 * error rate a thousandfold) uses the lesson's own round numbers. Labelled blocks only.
 * Self-contained vanilla-TS Astro island. Original.
 */
---

<figure class="rpc card" data-repairchooser>
  <figcaption class="rpc-head">Repair pathway chooser: match the damage to the fix<span class="rpc-chip">⚙ original · interactive</span></figcaption>

  <svg class="rpc-svg" viewBox="0 0 360 222" role="img" aria-label="The steps of the repair pathway that handles the chosen damage, the template it uses, and for a double-strand break the cell-cycle phases in which each route acts" data-stage></svg>

  <fieldset class="rpc-set">
    <legend>Kind of damage</legend>
    <label><input type="radio" name="rpc-damage" value="mismatch" checked /> mismatch (two normal bases paired wrongly)</label>
    <label><input type="radio" name="rpc-damage" value="base" /> damaged base (e.g. uracil, 8-oxoguanine)</label>
    <label><input type="radio" name="rpc-damage" value="bulky" /> bulky lesion (e.g. UV dimer)</label>
    <label><input type="radio" name="rpc-damage" value="dsb" /> double-strand break</label>
  </fieldset>

  <div class="rpc-breakctl" data-breakctl>
    <fieldset class="rpc-set rpc-inline">
      <legend>Cell-cycle phase (breaks only)</legend>
      <label><input type="radio" name="rpc-phase" value="G1" checked data-bk /> G1</label>
      <label><input type="radio" name="rpc-phase" value="S" data-bk /> S</label>
      <label><input type="radio" name="rpc-phase" value="G2" data-bk /> G2</label>
    </fieldset>
    <fieldset class="rpc-set rpc-inline">
      <legend>Route to follow (breaks only)</legend>
      <label><input type="radio" name="rpc-route" value="NHEJ" checked data-bk /> end joining</label>
      <label><input type="radio" name="rpc-route" value="HR" data-bk data-hr /> <span data-hrlabel>homologous recombination</span></label>
    </fieldset>
  </div>

  <p class="rpc-verdict" data-verdict role="status"></p>
  <ul class="rpc-list" data-list></ul>

  <p class="rpc-foot">Match the repair to the damage: one helix strand is damaged, so cut it out and copy the partner; a break through both strands leaves no partner, so join the ends or splice from the sister. This is a sketch of the logic, not a timeline.</p>
</figure>

<script>
  const NS = "http://www.w3.org/2000/svg";
  type Damage = "mismatch" | "base" | "bulky" | "dsb";
  type Route = "NHEJ" | "HR";
  type Pathway = { name: string; fill: string; steps: string[][]; template: string };

  // The lesson's round numbers for the worked problem (illustration, not measured).
  const POL = 1e-5, PROOF = 1e-2, MMR = 1e-3, GENOME = 6.4e9;
  const pw = (x: number) => `10^${Math.round(Math.log10(x))}`;

  const PATHWAYS: Record<string, Pathway> = {
    mismatch: {
      name: "Mismatch repair", fill: "#7a5ea8", template: "the old (template) strand of the same duplex",
      steps: [["In E. coli,", "MutS binds", "the mismatch"], ["MutL joins;", "MutH nicks", "the unmethylated", "strand (GATC)"], ["the new strand", "is removed", "past the", "mismatch"], ["polymerase", "and ligase", "fill in"]],
    },
    base: {
      name: "Base excision repair", fill: "#0e7c86", template: "the partner strand of the same duplex",
      steps: [["glycosylase", "flips the base", "out, cuts it", "from its sugar"], ["AP", "endonuclease", "cuts the", "backbone"], ["polymerase", "inserts the", "correct", "nucleotide"], ["ligase", "seals", "the nick"]],
    },
    bulky: {
      name: "Nucleotide excision repair", fill: "#a24f00", template: "the partner strand of the same duplex",
      steps: [["senses the", "helix", "distortion"], ["cuts the", "strand on", "both sides"], ["a short", "oligo-", "nucleotide", "is removed"], ["polymerase", "fills the", "gap"], ["ligase", "seals"]],
    },
    NHEJ: {
      name: "Non-homologous end joining", fill: "#2f6f8f", template: "none: the ends are joined directly",
      steps: [["Ku ring", "binds each", "end"], ["DNA-PKcs", "is", "recruited"], ["Artemis and", "polymerases", "trim or fill", "ends that", "do not fit"], ["XRCC4 with", "ligase IV", "joins them"]],
    },
    HR: {
      name: "Homologous recombination", fill: "#8a2f4a", template: "best template: the sister chromatid (the identical copy made in replication)",
      steps: [["resection", "leaves 3′", "single-strand", "tails"], ["Rad51 coats", "the tail and", "invades the", "duplex (D-loop)"], ["the 3′ end", "primes synthesis", "copying what", "was lost"], ["Holliday", "junctions are", "dissolved or", "cut"]],
    },
  };

  function el(name: string, attrs: Record<string, string | number>, text?: string): SVGElement {
    const e = document.createElementNS(NS, name);
    for (const k in attrs) e.setAttribute(k, String(attrs[k]));
    if (text !== undefined) e.textContent = text;
    return e;
  }

  document.querySelectorAll<HTMLElement>("[data-repairchooser]").forEach((root) => {
    const stage = root.querySelector<SVGSVGElement>("[data-stage]")!;
    const verdict = root.querySelector<HTMLElement>("[data-verdict]")!;
    const list = root.querySelector<HTMLElement>("[data-list]")!;
    const breakctl = root.querySelector<HTMLElement>("[data-breakctl]")!;
    const radios = (n: string) => Array.from(root.querySelectorAll<HTMLInputElement>(`input[name="${n}"]`));
    const val = (n: string) => radios(n).find((r) => r.checked)!.value;
    const hrRadio = root.querySelector<HTMLInputElement>("input[data-hr]")!;
    const INK = "#4b4b55", FAINT = "#8a8a96";
    const DAMAGE_NAMES: Record<Damage, string> = { mismatch: "mismatch", base: "damaged base", bulky: "bulky lesion", dsb: "double-strand break" };

    function drawSteps(p: Pathway, damage: Damage) {
      stage.appendChild(el("text", { x: 8, y: 14, "font-size": 10, "font-weight": 700, fill: INK }, `damage: ${DAMAGE_NAMES[damage]}`));
      stage.appendChild(el("text", { x: 352, y: 14, "font-size": 10, "font-weight": 700, "text-anchor": "end", fill: p.fill }, p.name));
      const n = p.steps.length, gap = 10, w = (344 - gap * (n - 1)) / n, y = 24, h = 72;
      p.steps.forEach((lines, i) => {
        const x = 8 + i * (w + gap);
        stage.appendChild(el("rect", { x, y, width: w, height: h, rx: 5, fill: p.fill }));
        stage.appendChild(el("text", { x: x + 4, y: y + 11, "font-size": 9, "font-weight": 700, fill: "#fff" }, `${i + 1}`));
        const top = y + h / 2 - ((lines.length - 1) * 11) / 2 + 3;
        lines.forEach((t, j) => stage.appendChild(el("text", { x: x + w / 2, y: top + j * 11, "font-size": 9, "text-anchor": "middle", fill: "#fff" }, t)));
        if (i < n - 1) stage.appendChild(el("text", { x: x + w + gap / 2, y: y + h / 2 + 4, "font-size": 11, "text-anchor": "middle", fill: INK }, "›"));
      });
      stage.appendChild(el("text", { x: 8, y: 114, "font-size": 9, fill: INK }, "template for the new DNA:"));
      stage.appendChild(el("rect", { x: 8, y: 119, width: 344, height: 20, rx: 4, fill: "#fff", stroke: p.fill, "stroke-width": 1.5 }));
      stage.appendChild(el("text", { x: 180, y: 133, "font-size": 9, "text-anchor": "middle", "font-weight": 700, fill: p.fill }, p.template));
    }

    function drawPhases(isDsb: boolean, phase: string, route: Route) {
      if (!isDsb) {
        stage.appendChild(el("text", { x: 180, y: 190, "font-size": 9, "text-anchor": "middle", fill: INK }, "Cell-cycle phase is set only for breaks in this sketch."));
        return;
      }
      stage.appendChild(el("text", { x: 8, y: 156, "font-size": 9, fill: INK }, "cell cycle: where each route acts"));
      ["G1", "S", "G2"].forEach((ph, i) => {
        const x = 8 + i * 116, on = ph === phase;
        stage.appendChild(el("rect", { x, y: 161, width: 112, height: 20, rx: 4, fill: on ? "#e6eef2" : "#fff", stroke: on ? "#1d3d4d" : FAINT, "stroke-width": on ? 2.5 : 1 }));
        stage.appendChild(el("text", { x: x + 56, y: 175, "font-size": 10, "text-anchor": "middle", "font-weight": on ? 700 : 400, fill: INK }, on ? `${ph} (your cell)` : ph));
      });
      const hrOn = phase !== "G1";
      stage.appendChild(el("rect", { x: 8, y: 186, width: 344, height: 14, rx: 3, fill: route === "NHEJ" ? PATHWAYS.NHEJ.fill : "#c9dbe4", opacity: 1 }));
      stage.appendChild(el("text", { x: 180, y: 196, "font-size": 9, "text-anchor": "middle", fill: route === "NHEJ" ? "#fff" : INK }, "end joining: throughout the cell cycle"));
      stage.appendChild(el("rect", { x: 124, y: 204, width: 228, height: 14, rx: 3, fill: route === "HR" ? PATHWAYS.HR.fill : "#e6c9d2", opacity: 1 }));
      stage.appendChild(el("text", { x: 238, y: 214, "font-size": 9, "text-anchor": "middle", fill: route === "HR" ? "#fff" : INK }, "recombination: mainly S and G2 (sister)"));
      if (!hrOn) stage.appendChild(el("text", { x: 118, y: 214, "font-size": 9, "text-anchor": "end", fill: INK }, "no sister yet"));
    }

    function render() {
      const damage = val("rpc-damage") as Damage;
      const isDsb = damage === "dsb";
      const phase = val("rpc-phase");
      // In G1 there is no sister chromatid, so recombination from the sister is off the table.
      hrRadio.disabled = !isDsb;
      root.querySelector<HTMLElement>("[data-hrlabel]")!.textContent = phase === "G1" ? "homologous recombination (unlikely: no sister yet)" : "homologous recombination";
      radios("rpc-phase").forEach((r) => { r.disabled = !isDsb; });
      radios("rpc-route")[0].disabled = !isDsb;
      breakctl.classList.toggle("rpc-off", !isDsb);
      const route = val("rpc-route") as Route;
      const key = isDsb ? route : damage;
      const p = PATHWAYS[key];

      stage.replaceChildren();
      drawSteps(p, damage);
      drawPhases(isDsb, phase, route);

      let v = "", out: string[] = [];
      if (damage === "mismatch") {
        v = "Two normal bases are paired wrongly and neither is damaged, so the cell corrects the one on the new strand, because the template was right before the polymerase arrived. That is mismatch repair. E. coli finds the new strand by its unmethylated GATC sites; eukaryotes appear to read strand breaks instead.";
        const afterProof = POL * PROOF, final = afterProof * MMR;
        out = [
          `Typical outcome: the new strand is corrected from the template, so a copying error is usually removed rather than inherited.`,
          `With the lesson’s round numbers (chosen for illustration, not measured) the error rate falls from ${pw(afterProof)} to ${pw(final)} per base pair, which is ${Math.round(afterProof / final)}-fold; for 6.4 x 10^9 bp that is ${(GENOME * afterProof).toFixed(0)} errors per genome without mismatch repair and ${(GENOME * final).toFixed(2)} with it.`,
        ];
      } else if (damage === "base") {
        v = "A small, non-bulky base lesion such as uracil, 8-oxoguanine or an AP site is handled by base excision repair: a glycosylase specific for that base removes just that one base and the partner strand guides the refill. O6-methylguanine is the exception here, since MGMT reverses it in place and is used up by doing so.";
        out = [
          "Typical outcome: the wrong base is removed and the correct nucleotide inserted; the human uracil system rebuilt from four purified proteins filled a one-nucleotide patch.",
        ];
      } else if (damage === "bulky") {
        v = "A bulky lesion such as a UV dimer or a 6-4 photoproduct bends the helix. Nucleotide excision repair senses the distortion, not the chemistry, and cuts out a short stretch of the damaged strand. Humans lack photolyase, so skin cells cannot reverse UV dimers with light and use this route.";
        out = [
          "Typical outcome: a short oligonucleotide is removed and the gap refilled from the partner strand: about 12 to 13 nucleotides in E. coli, 27 to 29 in a human cell-free system.",
        ];
      } else if (phase === "G1" && route === "HR") {
        v = "In G1 the chromosome has not been replicated, so there is no sister chromatid to serve as a template and homologous recombination is unlikely. End joining needs no template and acts throughout the cell cycle, so it is available.";
        out = [
          "If recombination did go ahead, the information lost at the break would be copied from its template. When both ends engage the template, the two Holliday junctions are dissolved, giving no crossover, or cut, giving a crossover or not depending on which strands are cut.",
        ];
      } else if (phase === "G1") {
        v = "In G1 the chromosome has not been replicated, so there is no sister chromatid to serve as a template. End joining needs no template and acts throughout the cell cycle, so it is available and joins the ends.";
        out = [
          "Typical outcome: the ends are rejoined. If they had to be processed, a few bases may be gained or lost at the joint, but clean, compatible ends are often rejoined exactly.",
        ];
      } else if (route === "NHEJ") {
        v = `In ${phase} a sister chromatid is present or being made, but end joining still works because it acts throughout the cell cycle. The lesson does not say how often a cell takes this route rather than recombination.`;
        out = [
          "Typical outcome: the ends are rejoined without a template. If they had to be processed, a few bases may be gained or lost at the joint, but clean, compatible ends are often rejoined exactly.",
        ];
      } else {
        v = `In ${phase} the sister chromatid, the identical copy made during replication, is the best template, so homologous recombination acts mainly in S and G2. It splices in the lost information, as you would splice a matching length of rope into a cut one. End joining remains open in this phase too.`;
        out = [
          "Typical outcome: the information lost at the break is copied from the sister. When both ends engage the template, the two Holliday junctions are dissolved, giving no crossover, or cut, giving a crossover or not depending on which strands are cut.",
        ];
      }
      verdict.textContent = v;
      list.replaceChildren();
      out.forEach((t) => { const li = document.createElement("li"); li.textContent = t; list.appendChild(li); });
    }
    root.querySelectorAll("input").forEach((i) => i.addEventListener("change", render));
    render();
  });
</script>

<style is:global>
  .rpc { padding: var(--ddp-space-3) var(--ddp-space-4) var(--ddp-space-4); margin: var(--ddp-space-5) 0; }
  .rpc-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem; font-weight: 600; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); margin-bottom: var(--ddp-space-3); }
  .rpc-chip { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 400; color: var(--ddp-color-muted); }
  .rpc-svg { display: block; width: 100%; max-width: 600px; margin: 0 auto var(--ddp-space-3); height: auto; background: #fff; border: 1px solid var(--ddp-color-line); border-radius: 6px; }
  .rpc-set { border: 1px solid var(--ddp-color-line); border-radius: 6px; margin: var(--ddp-space-2) 0; padding: 0.4rem 0.7rem; display: grid; grid-template-columns: 1fr 1fr; gap: 0.2rem 1rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .rpc-set legend { font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); padding: 0 0.3rem; }
  .rpc-set input { accent-color: var(--ddp-color-accent); }
  .rpc-breakctl { display: grid; grid-template-columns: 1fr 1fr; gap: 0 0.7rem; }
  .rpc-inline { grid-template-columns: 1fr; }
  .rpc-off { opacity: 0.5; }
  .rpc-verdict { margin: var(--ddp-space-2) 0; padding: var(--ddp-space-2) var(--ddp-space-3); background: color-mix(in srgb, var(--ddp-color-accent) 8%, transparent); border-radius: 6px; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); min-height: 3em; }
  .rpc-list { margin: 0; padding-left: 1.1rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); line-height: 1.5; }
  .rpc-foot { margin: var(--ddp-space-3) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); border-left: 3px solid var(--ddp-color-secondary); padding-left: 0.55rem; }
  @media (max-width: 520px) { .rpc-set, .rpc-breakctl { grid-template-columns: 1fr; } }
</style>
