---
/**
 * SplicingBuilder — the imagined four-exon gene of the rna-processing lesson. The learner
 * switches three splicing outcomes (skip exon 2, skip exon 3, keep intron 1) and sees the
 * mature mRNA that results: its length, the change in coding length, and whether the
 * downstream reading frame survives. The only rule is the lesson's: the frame is kept if
 * the change in coding length is a multiple of three. Every number comes from the worked
 * problem (exons 150, 87, 100, 400; introns 900, 1,500, 2,000). Labelled blocks only.
 * Self-contained vanilla-TS Astro island. Original.
 */
---

<figure class="sb card" data-splicingbuilder>
  <figcaption class="sb-head">Splicing builder: what does the mature mRNA look like?<span class="sb-chip">⚙ original · interactive</span></figcaption>

  <svg class="sb-svg" viewBox="0 0 360 230" role="img" aria-label="Top: the pre-mRNA of a four-exon gene with three introns. Bottom: the mature mRNA that results from the splicing outcomes you choose, drawn to scale" data-stage></svg>

  <fieldset class="sb-ctl">
    <legend>What the spliceosome does</legend>
    <label><input type="checkbox" data-in="s2" /> exon 2 is skipped (87 nt)</label>
    <label><input type="checkbox" data-in="s3" /> exon 3 is skipped (100 nt)</label>
    <label><input type="checkbox" data-in="r1" /> intron 1 is retained (900 nt)</label>
  </fieldset>

  <dl class="sb-read" data-read></dl>
  <p class="sb-verdict" data-verdict role="status"></p>

  <p class="sb-foot">Rule to keep: the downstream frame is kept only if the change in coding length is a multiple of three. This is a sketch of the logic for an imagined gene, not a prediction for a real one; the sequence decides whether a stop codon appears.</p>
</figure>

<script>
  const NS = 'http://www.w3.org/2000/svg';
  const EXON = { e1: 150, e2: 87, e3: 100, e4: 400 };
  const INTRON = { i1: 900, i2: 1500, i3: 2000 };
  const INK = '#4b4b55', FAINT = '#8a8a96', BLUE = '#0e7c86', ORANGE = '#e57200', GREY = '#b9b9c4';
  const fmt = (n: number) => n.toLocaleString('en-US');
  function el(name: string, attrs: Record<string, string | number>, text?: string): SVGElement {
    const e = document.createElementNS(NS, name);
    for (const k in attrs) e.setAttribute(k, String(attrs[k]));
    if (text !== undefined) e.textContent = text;
    return e;
  }

  document.querySelectorAll<HTMLElement>('[data-splicingbuilder]').forEach((root) => {
    const stage = root.querySelector<SVGSVGElement>('[data-stage]')!;
    const read = root.querySelector<HTMLElement>('[data-read]')!;
    const verdict = root.querySelector<HTMLElement>('[data-verdict]')!;
    const inp = (k: string) => root.querySelector<HTMLInputElement>(`[data-in="${k}"]`)!;

    type Seg = { label: string; len: number; kind: 'exon' | 'intron'; shifted: boolean };

    function render() {
      const s2 = inp('s2').checked, s3 = inp('s3').checked, r1 = inp('r1').checked;

      // build the mature mRNA in order, tracking the running change in coding length
      const segs: Seg[] = [];
      let cum = 0;
      segs.push({ label: '1', len: EXON.e1, kind: 'exon', shifted: false });
      if (r1) { segs.push({ label: 'i1', len: INTRON.i1, kind: 'intron', shifted: cum % 3 !== 0 }); cum += INTRON.i1; }
      if (!s2) segs.push({ label: '2', len: EXON.e2, kind: 'exon', shifted: cum % 3 !== 0 }); else cum -= EXON.e2;
      if (!s3) segs.push({ label: '3', len: EXON.e3, kind: 'exon', shifted: cum % 3 !== 0 }); else cum -= EXON.e3;
      segs.push({ label: '4', len: EXON.e4, kind: 'exon', shifted: cum % 3 !== 0 });
      const change = cum;
      const total = segs.reduce((a, s) => a + s.len, 0);
      const rem = Math.abs(change) % 3;
      const kept = rem === 0;

      // ---- drawing ----
      stage.replaceChildren();
      stage.appendChild(el('text', { x: 8, y: 14, 'font-size': 10, 'font-weight': 700, fill: INK }, 'pre-mRNA: 5,137 nt (lengths not to scale)'));
      const pre: [string, string, number, number][] = [
        ['exon', '1', 44, EXON.e1], ['intron', 'intron 1', 54, INTRON.i1], ['exon', '2', 36, EXON.e2],
        ['intron', 'intron 2', 54, INTRON.i2], ['exon', '3', 36, EXON.e3], ['intron', 'intron 3', 54, INTRON.i3], ['exon', '4', 64, EXON.e4],
      ];
      let x = 10;
      pre.forEach(([kind, lab, w, n]) => {
        const skipped = (lab === '2' && s2) || (lab === '3' && s3);
        const kept1 = lab === 'intron 1' && r1;
        if (kind === 'exon') {
          stage.appendChild(el('rect', { x, y: 24, width: w, height: 26, rx: 3, fill: skipped ? '#fff' : BLUE, stroke: skipped ? FAINT : BLUE, 'stroke-width': 1.2, 'stroke-dasharray': skipped ? '3 2' : '0' }));
          stage.appendChild(el('text', { x: x + w / 2, y: 41, 'font-size': 10, 'text-anchor': 'middle', 'font-weight': 700, fill: skipped ? INK : '#fff' }, 'exon ' + lab));
        } else {
          stage.appendChild(el('rect', { x, y: 33, width: w, height: 8, rx: 2, fill: kept1 ? ORANGE : '#fff', stroke: kept1 ? ORANGE : FAINT, 'stroke-width': 1.2 }));
          stage.appendChild(el('text', { x: x + w / 2, y: 66, 'font-size': 9, 'text-anchor': 'middle', fill: kept1 ? ORANGE : INK, 'font-weight': kept1 ? 700 : 400 }, lab));
        }
        stage.appendChild(el('text', { x: x + w / 2, y: kind === 'exon' ? 62 : 76, 'font-size': 9, 'text-anchor': 'middle', fill: INK }, fmt(n) + ' nt'));
        x += w;
      });
      // start codon marker on exon 1
      stage.appendChild(el('text', { x: 10, y: 90, 'font-size': 9, fill: INK }, 'Exon 1: 60 nt of 5′ UTR, then 90 coding nt from the AUG.'));
      stage.appendChild(el('text', { x: 10, y: 101, 'font-size': 9, fill: INK }, 'Exon 4 holds the stop codon and the 3′ UTR.'));

      // mature mRNA, drawn to scale
      stage.appendChild(el('text', { x: 8, y: 124, 'font-size': 10, 'font-weight': 700, fill: INK }, 'mature mRNA: ' + fmt(total) + ' nt (drawn to scale, cap and tail ignored)'));
      const scale = 327 / 1637;
      let mx = 16;
      segs.forEach((s) => {
        const w = Math.max(s.len * scale, 2);
        const fill = s.kind === 'intron' ? ORANGE : s.shifted ? '#c0392b' : BLUE;
        stage.appendChild(el('rect', { x: mx, y: 132, width: w, height: 28, rx: 2, fill, stroke: '#fff', 'stroke-width': 1 }));
        if (w >= 16) stage.appendChild(el('text', { x: mx + w / 2, y: 150, 'font-size': 10, 'text-anchor': 'middle', 'font-weight': 700, fill: '#fff' }, s.kind === 'intron' ? 'intron 1' : s.label));
        stage.appendChild(el('text', { x: mx + w / 2, y: 174, 'font-size': 9, 'text-anchor': 'middle', fill: INK }, String(s.len)));
        mx += w;
      });
      // legend
      const lg: [string, string][] = [[BLUE, 'original frame'], ['#c0392b', 'shifted frame'], [ORANGE, 'retained intron']];
      lg.forEach(([c, t], i) => {
        const lx = 10 + i * 95;
        stage.appendChild(el('rect', { x: lx, y: 188, width: 10, height: 10, rx: 2, fill: c }));
        stage.appendChild(el('text', { x: lx + 14, y: 197, 'font-size': 9, fill: INK }, t));
      });
      stage.appendChild(el('text', { x: 10, y: 218, 'font-size': 10, 'font-weight': 700, fill: kept ? BLUE : '#c0392b' }, kept ? (r1 ? 'frame kept (by the rule)' : 'frame kept') : 'frame shifts'));
      stage.appendChild(el('text', { x: 130, y: 218, 'font-size': 9, fill: INK }, 'change in coding length: ' + (change > 0 ? '+' : change < 0 ? '−' : '') + fmt(Math.abs(change)) + ' nt'));

      // ---- readout ----
      const terms = segs.map((s) => s.len).join(' + ');
      const sign = change > 0 ? '+' : change < 0 ? '−' : '';
      read.innerHTML =
        `<div><dt>Length</dt><dd>${terms}${segs.length > 1 ? ' = ' : ''}${fmt(total)} nt</dd></div>` +
        `<div><dt>Change in coding length</dt><dd>${sign}${fmt(Math.abs(change))} nt</dd></div>` +
        `<div><dt>Change as a multiple of 3</dt><dd>${change === 0 ? '0 = 3 × 0' : (() => { const q = Math.trunc(change / 3), r = change - 3 * q; return `${sign}${fmt(Math.abs(change))} = 3 × ${q < 0 ? '(−' + fmt(-q) + ')' : fmt(q)} ${r < 0 ? '−' : '+'} ${Math.abs(r)}`.replace('= 3 × ', '= 3 × ').replace(/ \+ 0$/, ''); })()}</dd></div>`;

      // ---- status sentence ----
      let v: string;
      if (change === 0 && !s2 && !s3 && !r1) {
        v = 'All three introns are removed and the four exons joined: 737 nucleotides. Nothing in the coding length has changed, so the frame is the one the gene encodes.';
      } else {
        const what: string[] = [];
        if (s2) what.push('exon 2 is skipped (−87)');
        if (s3) what.push('exon 3 is skipped (−100)');
        if (r1) what.push('intron 1 is kept (+900)');
        v = `${what.join(', ')}, so the mRNA is ${fmt(total)} nucleotides and the coding length changes by ${sign}${fmt(Math.abs(change))}. `;
        if (kept) {
          const codons = Math.abs(change) / 3;
          v += r1 ? `By the lesson’s rule, ${fmt(Math.abs(change))} = 3 × ${fmt(codons)} leaves the downstream frame in register. ` : `${fmt(Math.abs(change))} = 3 × ${fmt(codons)}, so the downstream frame is kept. `;
          if (change < 0) v += `The protein lacks ${fmt(codons)} amino acids, assuming the new junction does not make a stop codon.`;
          else v += `In this sketch the rule is applied to the retained intron; whether its 900 nucleotides hold a stop codon needs the sequence.`;
        } else {
          v += `${fmt(Math.abs(change))} = 3 × ${fmt(Math.floor(Math.abs(change) / 3))} + ${rem}, not a multiple of three, so the frame shifts downstream and a premature stop codon is likely, though not certain without the sequence. `;
          if (!r1 && s3 && !s2) v += 'In mammalian cells, a premature stop in the last exon usually escapes nonsense-mediated decay that depends on exon junctions, so a truncated protein could be made.';
        }
        if (r1) v += ' RNAs that keep an intron are often held in the nucleus or degraded.';
      }
      verdict.textContent = v.charAt(0).toUpperCase() + v.slice(1);
    }
    ['s2', 's3', 'r1'].forEach((k) => inp(k).addEventListener('change', render));
    render();
  });
</script>

<style is:global>
  .sb { padding: var(--ddp-space-3) var(--ddp-space-4) var(--ddp-space-4); margin: var(--ddp-space-5) 0; }
  .sb-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem; font-weight: 600; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); margin-bottom: var(--ddp-space-3); }
  .sb-chip { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 400; color: var(--ddp-color-muted); }
  .sb-svg { display: block; width: 100%; max-width: 600px; margin: 0 auto var(--ddp-space-3); height: auto; background: #fff; border: 1px solid var(--ddp-color-line); border-radius: 6px; }
  .sb-ctl { border: 1px solid var(--ddp-color-line); border-radius: 6px; margin: var(--ddp-space-3) 0 var(--ddp-space-2); padding: 0.4rem 0.7rem; display: grid; grid-template-columns: 1fr; gap: 0.25rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .sb-ctl legend { font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); padding: 0 0.3rem; }
  .sb-ctl input { accent-color: var(--ddp-color-accent); }
  .sb-ctl input:focus-visible { outline: 2px solid var(--ddp-color-accent); outline-offset: 2px; }
  .sb-read { margin: var(--ddp-space-2) 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .sb-read > div { display: flex; flex-wrap: wrap; gap: 0.4rem; padding: 0.15rem 0; border-bottom: 1px solid var(--ddp-color-line); }
  .sb-read dt { color: var(--ddp-color-muted); min-width: 12em; }
  .sb-read dd { margin: 0; font-family: var(--ddp-font-mono); }
  .sb-verdict { margin: var(--ddp-space-2) 0; padding: var(--ddp-space-2) var(--ddp-space-3); background: color-mix(in srgb, var(--ddp-color-accent) 8%, transparent); border-radius: 6px; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); min-height: 3em; }
  .sb-foot { margin: var(--ddp-space-3) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); border-left: 3px solid var(--ddp-color-secondary); padding-left: 0.55rem; }
</style>
