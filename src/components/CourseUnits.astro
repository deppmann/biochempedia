---
/**
 * A course's lessons as cards, grouped into its units, with a sticky row of
 * unit chips that filters them. Every course page uses this, so the courses
 * share one look. The Metabolism Arcade banner and the unit-review link are
 * biochemistry's own extras and appear only where their data names a unit.
 */
import LessonIcon from './LessonIcon.astro';
import { unitsFor, type Course } from '../data/courses';
import { unitReviewByUnit, unitReviewHref } from '../data/lesson-games';

interface Props {
  course: Course;
  lessons: any[];
}
const { course, lessons } = Astro.props;
const units = unitsFor(course, lessons);

/* An authored hook is printed whole. Only the fallback (the summary's first
   sentence) is clamped to two lines by CSS. */
const hookFor = (l: any) => l.data.hook ?? l.data.summary.split(/(?<=[.?!])\s+/)[0];
/* Units whose pathways the Metabolism Arcade plays. */
const ARCADE_UNITS = course.slug === 'biochemistry' ? new Set(['Central Metabolism', 'Fuels, Fat & Nitrogen']) : new Set<string>();
const plural = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;
/* What a card counts: only the things the lesson has. */
const metaFor = (l: any) => {
  const d = l.data;
  const films = (d.explainer ? 1 : 0) + d.films.length;
  return [
    d.structures.length > 0 && plural(d.structures.length, 'structure', 'structures'),
    films > 0 && plural(films, 'film', 'films'),
    d.simulations.length > 0 && plural(d.simulations.length, 'simulation', 'simulations'),
    plural(d.practiceQuestions.length + d.mcatQuestions.length, 'question', 'questions'),
    d.estMinutes && `~${d.estMinutes} min`,
  ].filter(Boolean) as string[];
};
---

<nav class="unit-filter" aria-label="Filter lessons by unit">
  <button type="button" data-unit="all" aria-pressed="true">All</button>
  {units.map((u) => (
    <button type="button" data-unit={u.name} aria-pressed="false">{u.name}</button>
  ))}
</nav>

{units.map((u, ui) => (
  <section class="unit" data-unit-section={u.name}>
    <h2 class="unit-h">Unit {ui + 1} · {u.name}</h2>
    {ARCADE_UNITS.has(u.name) && (
      <a class="unit-play" href="/play">
        <span class="unit-play-ico" aria-hidden="true">▶</span>
        <span><strong>Play these pathways.</strong> Wire the cell, run the regulators through a fast, and diagnose a broken enzyme in the Metabolism Arcade.</span>
        <span class="unit-play-arrow" aria-hidden="true">→</span>
      </a>
    )}
    <ul class="lesson-list">
      {u.entries.map(({ l, n }) => (
        <li>
          <a href={`/lessons/${l.data.slug}/`} class="lesson-card" data-lesson-card={l.data.slug}>
            <span class="lc-order" aria-hidden="true">{n}</span>
            <span class="lc-ico"><LessonIcon slug={l.data.slug} /></span>
            <span class="lc-body">
              {/* The course name is the page's title; a chapter label that repeats it is trimmed. */}
              <span class="lc-chapter">{l.data.courseChapter.replace(`${course.title} · `, '')}</span>
              <span class="lc-title">{l.data.title}{l.data.draft && <span class="lc-draft">draft</span>}<span class="lc-done" data-done-badge hidden>✓ done</span></span>
              <span class={`lc-summary${l.data.hook ? ' is-hook' : ''}`}>{hookFor(l)}</span>
              {/* Each figure is its own nowrap span, so a wrap falls between
                  items and never splits "6 / questions". */}
              <span class="lc-meta">
                {l.data.ladder?.sol.map((c: string) => <span class="lc-sol">SOL {c}</span>)}
                {metaFor(l).map((m, i) => <>{i > 0 && ' · '}<span>{m}</span></>)}
              </span>
            </span>
          </a>
        </li>
      ))}
    </ul>
    {unitReviewByUnit(u.name) && course.slug === 'biochemistry' && (
      <p class="unit-review">
        Finished the unit? <a href={unitReviewHref(unitReviewByUnit(u.name)!.id)}>Take the unit review →</a>
      </p>
    )}
  </section>
))}

<script>
  import { load, onChange } from '../lib/progress';

  // Done ticks from this device's progress (src/lib/progress.ts); hidden without it.
  onChange(() => {
    const lessons = load().lessons;
    document.querySelectorAll<HTMLElement>('[data-lesson-card]').forEach((card) => {
      const badge = card.querySelector<HTMLElement>('[data-done-badge]');
      if (badge) badge.hidden = !lessons[card.getAttribute('data-lesson-card')!]?.d;
    });
  });
</script>

<script>
  // Unit filter. "All" restores everything; a unit chip shows only that unit.
  const filter = document.querySelector('.unit-filter');
  if (filter) {
    const chips = Array.from(filter.querySelectorAll<HTMLButtonElement>('button[data-unit]'));
    const sections = Array.from(document.querySelectorAll<HTMLElement>('[data-unit-section]'));
    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const pick = chip.getAttribute('data-unit')!;
        chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
        sections.forEach((s) => (s.hidden = pick !== 'all' && s.getAttribute('data-unit-section') !== pick));
      });
    });
  }
</script>

<style>
  .lc-done { margin-left: 0.5em; font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 700; color: var(--ddp-color-verified); white-space: nowrap; }
  .lc-done[hidden] { display: none; }
  .unit-play {
    display: flex;
    align-items: center;
    gap: var(--ddp-space-3);
    margin: 0 0 var(--ddp-space-3);
    padding: var(--ddp-space-3) var(--ddp-space-4);
    border-radius: var(--ddp-radius, 10px);
    font-size: var(--ddp-text-sm);
    color: var(--ddp-color-ink);
    text-decoration: none;
    background: color-mix(in srgb, var(--ddp-color-secondary, #e0b452) 14%, var(--ddp-color-surface));
    border: 1px solid color-mix(in srgb, var(--ddp-color-secondary, #e0b452) 45%, var(--ddp-color-line));
  }
  .unit-play:hover { border-color: var(--ddp-color-secondary, #e0b452); text-decoration: none; }
  .unit-play-ico, .unit-play-arrow { color: var(--ddp-color-ink); font-weight: 700; }
  .unit-play-arrow { margin-left: auto; }
  .unit-review {
    margin: var(--ddp-space-3) 0 0;
    font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs);
    letter-spacing: 0.06em; text-transform: uppercase; color: var(--ddp-color-muted);
  }
  .unit-review a { color: var(--ddp-color-ink); font-weight: 600; text-underline-offset: 3px; }
  .unit-review a:hover { color: var(--ddp-color-accent); }

  /* Unit filter: one sticky row of chips. Filtering is enhancement — with no
     JS every unit stays visible and the chips are inert. */
  .unit-filter {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    flex-wrap: wrap;
    gap: var(--ddp-space-2);
    padding: var(--ddp-space-3) 0;
    margin-bottom: var(--ddp-space-2);
    background: var(--ddp-color-bg);
    border-bottom: 1px solid var(--ddp-color-line);
  }
  .unit-filter button {
    font: inherit;
    font-size: var(--ddp-text-xs);
    font-weight: 600;
    color: var(--ddp-color-ink-soft);
    background: var(--ddp-color-surface);
    border: 1px solid var(--ddp-color-line);
    border-radius: 999px;
    padding: 0.35em 0.8em;
    min-height: 36px;
    cursor: pointer;
  }
  .unit-filter button:hover { border-color: var(--ddp-color-accent); }
  .unit-filter button[aria-pressed='true'] {
    color: var(--ddp-color-primary);
    border-color: var(--ddp-color-accent);
    background: color-mix(in srgb, var(--ddp-color-accent) 10%, var(--ddp-color-surface));
    font-weight: 700;
  }
  /* A course with many long unit names: let the chips scroll sideways on a
     phone instead of stacking into a wall above the first card. */
  @media (max-width: 720px) {
    .unit-filter { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: thin; }
    .unit-filter button { flex: none; white-space: nowrap; }
  }
  .unit { margin-bottom: var(--ddp-space-6); }
  .unit[hidden] { display: none; }
  .unit-h {
    display: flex;
    align-items: center;
    gap: var(--ddp-space-3);
    font-family: var(--ddp-font-mono);
    font-size: var(--ddp-text-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ddp-color-muted);
    margin: var(--ddp-space-6) 0 var(--ddp-space-3);
  }
  .unit-h::after { content: ''; flex: 1; height: 1px; background: var(--ddp-color-line); }

  .lesson-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--ddp-space-4);
  }
  .lesson-card {
    position: relative;
    overflow: hidden;
    /* Fill the grid cell so cards in one row share a bottom edge. */
    height: 100%;
    box-sizing: border-box;
    display: flex;
    gap: var(--ddp-space-4);
    align-items: flex-start;
    padding: var(--ddp-space-4) var(--ddp-space-5);
    background: var(--ddp-color-surface);
    border: 1px solid var(--ddp-color-line);
    border-radius: var(--ddp-radius);
    text-decoration: none;
    color: inherit;
    transition: transform 0.14s ease, box-shadow 0.14s ease;
  }
  .lesson-card::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: var(--ddp-color-secondary);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 0.22s ease;
  }
  .lesson-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--ddp-shadow);
    text-decoration: none;
  }
  .lesson-card:hover::before { transform: scaleY(1); }
  /* Reading-order number in the card's corner: blue-on-light, reversed in dark mode. */
  .lc-order {
    position: absolute;
    top: var(--ddp-space-3);
    right: var(--ddp-space-3);
    z-index: 1;
    min-width: 1.55rem;
    height: 1.55rem;
    padding: 0 0.4rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--ddp-font-mono);
    font-size: var(--ddp-text-xs);
    font-weight: 700;
    line-height: 1;
    border-radius: 999px;
    color: var(--ddp-color-primary);
    background: color-mix(in srgb, var(--ddp-color-primary) 9%, #fff);
    border: 1px solid color-mix(in srgb, var(--ddp-color-primary) 22%, transparent);
  }
  @media (prefers-color-scheme: dark) {
    .lc-order {
      color: var(--ddp-color-ink);
      background: color-mix(in srgb, var(--ddp-color-ink) 12%, transparent);
      border-color: color-mix(in srgb, var(--ddp-color-ink) 32%, transparent);
    }
  }
  .lc-ico { flex: none; line-height: 0; margin-top: 2px; }
  .lc-body {
    min-width: 0;
    padding-right: 1.4rem; /* clear the corner order-number badge */
  }
  .lc-chapter {
    display: block;
    font-family: var(--ddp-font-mono);
    font-size: var(--ddp-text-xs);
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--ddp-color-accent);
    margin-bottom: var(--ddp-space-1);
  }
  .lc-title {
    display: block;
    font-family: var(--ddp-font-serif);
    font-weight: 600;
    font-size: var(--ddp-text-lg);
    color: var(--ddp-color-primary);
    line-height: 1.2;
    margin-bottom: var(--ddp-space-2);
  }
  .lc-draft {
    margin-left: 0.5rem; font-family: var(--ddp-font-mono); font-size: 0.65rem; font-weight: 600;
    letter-spacing: 0.06em; text-transform: uppercase; color: var(--ddp-color-muted);
    border: 1px solid var(--ddp-color-line); border-radius: 3px; padding: 0.05rem 0.35rem; vertical-align: middle;
  }
  /* The fallback (first sentence of the summary) is clamped to two lines.
     An approved hook is printed whole: at card width the clamp was cutting
     every one of them mid-phrase ("Water's own…"). */
  .lc-summary {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    color: var(--ddp-color-ink-soft);
    font-size: var(--ddp-text-sm);
    margin-bottom: var(--ddp-space-2);
  }
  .lc-summary.is-hook {
    display: block;
    -webkit-line-clamp: unset;
    overflow: visible;
  }
  .lc-meta {
    display: block;
    font-family: var(--ddp-font-mono);
    font-size: var(--ddp-text-xs);
    color: var(--ddp-color-muted);
  }
  .lc-meta span { white-space: nowrap; }
  .lc-meta .lc-sol {
    display: inline-block; margin: 0 0.4rem 0.2rem 0; padding: 0 0.45rem;
    font-weight: 600; color: var(--ddp-color-primary);
    border: 1px solid color-mix(in srgb, var(--ddp-color-accent) 45%, var(--ddp-color-line));
    border-radius: 999px;
    background: color-mix(in srgb, var(--ddp-color-accent) 8%, var(--ddp-color-surface));
  }
  @media (prefers-reduced-motion: reduce) {
    .lesson-card, .lesson-card::before { transition: none; }
  }
</style>
