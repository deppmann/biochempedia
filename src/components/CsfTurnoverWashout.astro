---
/**
 * CsfTurnoverWashout — the one-way CSF route beside the washout of a time-zero marker.
 * Turnover = Q/V, tau = V/Q, fraction left = exp(-t/tau), from the lesson's teaching values
 * (Q 500 mL/day, V 150 mL). A toggle blocks the cerebral aqueduct: lateral and third
 * ventricles swell (not to scale), the fourth does not, and the one-compartment curve stops
 * applying. Self-contained vanilla-TS Astro island. Original.
 */
---

<figure class="ctw card" data-ctw>
  <figcaption class="ctw-head">CSF turnover — why replacing a volume does not empty it<span class="ctw-chip">⚙ original · interactive</span></figcaption>

  <svg class="ctw-svg" viewBox="0 0 340 202" role="img" aria-label="Schematic of the one-way route of cerebrospinal fluid: lateral ventricles, interventricular foramina, third ventricle, cerebral aqueduct, fourth ventricle, apertures, subarachnoid space, then exit by arachnoid granulations and other routes" data-map></svg>
  <svg class="ctw-svg" viewBox="0 0 340 196" role="img" aria-label="Plot of the fraction of a time-zero marker left in the CSF against time, exp of minus t over tau" data-plot></svg>

  <div class="ctw-controls">
    <label class="ctw-slabel"><span>Secretion rate Q <em data-out="q">500</em> mL/day</span>
      <input type="range" data-in="q" min="300" max="700" step="10" value="500" />
    </label>
    <label class="ctw-slabel"><span>CSF volume V <em data-out="v">150</em> mL</span>
      <input type="range" data-in="v" min="100" max="200" step="5" value="150" />
    </label>
    <label class="ctw-slabel ctw-wide"><span>Time since the marker was present <em data-out="t">7.2</em> h</span>
      <input type="range" data-in="t" min="0" max="24" step="0.1" value="7.2" />
    </label>
    <label class="ctw-check ctw-wide"><input type="checkbox" data-in="block" /> <span>Block the cerebral aqueduct (secretion continues)</span></label>
  </div>

  <div class="ctw-presets" role="group" aria-label="Set values from the lesson">
    <button type="button" class="ctw-btn" data-preset="lesson">Lesson values (500 mL/day, 150 mL)</button>
    <button type="button" class="ctw-btn" data-preset="tau">Set t = τ</button>
    <button type="button" class="ctw-btn" data-preset="3tau">Set t = 3τ</button>
    <button type="button" class="ctw-btn" data-preset="zero">Set t = 0</button>
  </div>

  <dl class="ctw-readout">
    <div><dt>Turnover rate Q / V</dt><dd data-r-turn>—</dd></div>
    <div><dt>Volume-to-flow time τ = V / Q</dt><dd data-r-tau>—</dd></div>
    <div><dt>Check in mL/min</dt><dd data-r-min>—</dd></div>
    <div><dt>Fraction of the time-zero marker left</dt><dd data-r-frac>—</dd></div>
  </dl>
  <p class="ctw-why" data-why role="status">—</p>
  <p class="ctw-assume">In this sketch: the lesson’s conventional adult teaching values (500 mL/day, 150 mL) are the starting point; the sliders vary them and are not measurements from one person; one well-mixed compartment; outflow equals secretion, so the volume is steady; the marker is present at time zero and none is added afterwards. The ventricles are drawn as a schematic, not to scale.</p>

  <p class="ctw-foot">Turnover = Q / V; τ = V / Q; fraction of an initial marker left = exp(−t / τ): after one full volume of fluid has been made, 36.8 percent of the marker is still there. Block the aqueduct and fluid made upstream has no exit, so this one-compartment rule stops applying.</p>
</figure>

<script>
  const NS = 'http://www.w3.org/2000/svg';
  const ACCENT = '#0e7c86', ORANGE = '#e57200', INK = '#4b4b55', FAINT = '#b9b9c2', RED = '#b3261e';
  function el(name: string, attrs: Record<string, string | number>): SVGElement {
    const e = document.createElementNS(NS, name);
    for (const k in attrs) e.setAttribute(k, String(attrs[k]));
    return e;
  }
  function txt(parent: SVGElement, attrs: Record<string, string | number>, s: string) {
    const t = el('text', attrs); t.textContent = s; parent.appendChild(t); return t;
  }
  document.querySelectorAll<HTMLElement>('[data-ctw]').forEach((root) => {
    const map = root.querySelector<SVGSVGElement>('[data-map]')!;
    const plot = root.querySelector<SVGSVGElement>('[data-plot]')!;
    const inp = (n: string) => root.querySelector<HTMLInputElement>('[data-in="' + n + '"]')!;
    const out = (n: string) => root.querySelector<HTMLElement>('[data-out="' + n + '"]')!;
    const qIn = inp('q'), vIn = inp('v'), tIn = inp('t'), blockIn = inp('block');
    const qOut = out('q'), vOut = out('v'), tOut = out('t');
    const rTurn = root.querySelector<HTMLElement>('[data-r-turn]')!;
    const rTau = root.querySelector<HTMLElement>('[data-r-tau]')!;
    const rMin = root.querySelector<HTMLElement>('[data-r-min]')!;
    const rFrac = root.querySelector<HTMLElement>('[data-r-frac]')!;
    const why = root.querySelector<HTMLElement>('[data-why]')!;

    const trim = (x: number, d: number) => String(Number(x.toFixed(d)));
    const pct = (f: number) => (f < 0.0005 ? 'under 0.1%' : (f * 100).toFixed(1) + '%');

    // ---------- schematic ----------
    function box(x: number, y: number, w: number, h: number, lines: string[], fill: string, stroke: string) {
      map.appendChild(el('rect', { x, y, width: w, height: h, rx: 5, fill, stroke, 'stroke-width': 1.4 }));
      const mid = y + h / 2 - ((lines.length - 1) * 11) / 2 + 3;
      lines.forEach((l, i) => txt(map, { x: x + w / 2, y: mid + i * 11, 'text-anchor': 'middle', 'font-size': 9, fill: INK }, l));
    }
    function arrow(x1: number, y1: number, x2: number, y2: number, col: string, dash = '') {
      const a: Record<string, string | number> = { x1, y1, x2, y2, stroke: col, 'stroke-width': 1.8 };
      if (dash) a['stroke-dasharray'] = dash;
      map.appendChild(el('line', a));
      const ang = Math.atan2(y2 - y1, x2 - x1), s = 6;
      const p1 = [x2 - s * Math.cos(ang - 0.45), y2 - s * Math.sin(ang - 0.45)];
      const p2 = [x2 - s * Math.cos(ang + 0.45), y2 - s * Math.sin(ang + 0.45)];
      map.appendChild(el('path', { d: `M${p1[0]} ${p1[1]} L${x2} ${y2} L${p2[0]} ${p2[1]}`, fill: 'none', stroke: col, 'stroke-width': 1.8 }));
    }
    function drawMap(block: boolean) {
      map.replaceChildren();
      const base = '#e6f3f4', swell = '#f9dcb8';
      const LC = 32, TC = 170, FC = 308, YC = 48;
      const bw = (b: boolean) => (b ? 62 : 52), bh = (b: boolean) => (b ? 64 : 44);
      const sw = block;
      box(LC - bw(sw) / 2, YC - bh(sw) / 2, bw(sw), bh(sw), ['Lateral', 'ventricles'], sw ? swell : base, sw ? ORANGE : ACCENT);
      box(TC - bw(sw) / 2, YC - bh(sw) / 2, bw(sw), bh(sw), ['Third', 'ventricle'], sw ? swell : base, sw ? ORANGE : ACCENT);
      box(FC - 26, YC - 22, 52, 44, ['Fourth', 'ventricle'], base, ACCENT);
      // foramina
      arrow(LC + bw(sw) / 2 + 2, YC, TC - bw(sw) / 2 - 2, YC, ACCENT);
      txt(map, { x: (LC + TC) / 2, y: YC + 22, 'text-anchor': 'middle', 'font-size': 9, fill: INK }, 'interventricular');
      txt(map, { x: (LC + TC) / 2, y: YC + 33, 'text-anchor': 'middle', 'font-size': 9, fill: INK }, 'foramina');
      // aqueduct
      const ax1 = TC + bw(sw) / 2 + 2, ax2 = FC - 28, am = (ax1 + ax2) / 2;
      arrow(ax1, YC, ax2, YC, block ? FAINT : ACCENT, block ? '3 3' : '');
      txt(map, { x: am, y: YC + 22, 'text-anchor': 'middle', 'font-size': 9, fill: INK }, 'cerebral');
      txt(map, { x: am, y: YC + 33, 'text-anchor': 'middle', 'font-size': 9, fill: INK }, 'aqueduct');
      if (block) {
        map.appendChild(el('line', { x1: am - 6, y1: YC - 10, x2: am + 6, y2: YC + 10, stroke: RED, 'stroke-width': 3 }));
        map.appendChild(el('line', { x1: am + 6, y1: YC - 10, x2: am - 6, y2: YC + 10, stroke: RED, 'stroke-width': 3 }));
        txt(map, { x: am, y: YC - 16, 'text-anchor': 'middle', 'font-size': 9, 'font-weight': 700, fill: RED }, 'blocked');
        txt(map, { x: LC, y: YC + 46, 'text-anchor': 'middle', 'font-size': 9, 'font-weight': 700, fill: ORANGE }, 'enlarged');
        txt(map, { x: TC, y: YC + 46, 'text-anchor': 'middle', 'font-size': 9, 'font-weight': 700, fill: ORANGE }, 'enlarged');
        txt(map, { x: FC, y: YC - 28, 'text-anchor': 'middle', 'font-size': 9, 'font-weight': 700, fill: INK }, 'not enlarged');
      }
      // apertures down to subarachnoid
      arrow(FC, YC + 24, FC, 116, ACCENT);
      txt(map, { x: FC - 6, y: 98, 'text-anchor': 'end', 'font-size': 9, fill: INK }, 'median and');
      txt(map, { x: FC - 6, y: 109, 'text-anchor': 'end', 'font-size': 9, fill: INK }, 'lateral apertures');
      box(236, 118, 100, 40, ['Subarachnoid', 'space'], base, ACCENT);
      // exit
      arrow(234, 138, 152, 138, ACCENT);
      box(4, 118, 146, 50, ['Exit: arachnoid granulations', 'into the venous sinuses,', 'and other routes'], '#fff', ACCENT);
      txt(map, { x: 4, y: 184, 'font-size': 9, fill: INK }, 'The choroid plexus, the main source but not the only one,');
      txt(map, { x: 4, y: 196, 'font-size': 9, fill: INK }, 'makes CSF in each ventricle. Schematic, not to scale.');
    }

    // ---------- plot ----------
    const X0 = 46, X1 = 326, Y0 = 24, Y1 = 150, TMAX = 24;
    const px = (t: number) => X0 + (t / TMAX) * (X1 - X0);
    const py = (f: number) => Y1 - f * (Y1 - Y0);

    function drawPlot(tau: number, t: number, block: boolean) {
      plot.replaceChildren();
      plot.appendChild(el('line', { x1: X0, y1: Y0, x2: X0, y2: Y1, stroke: INK, 'stroke-width': 1 }));
      plot.appendChild(el('line', { x1: X0, y1: Y1, x2: X1, y2: Y1, stroke: INK, 'stroke-width': 1 }));
      for (const p of [0, 50, 100]) {
        plot.appendChild(el('line', { x1: X0 - 3, y1: py(p / 100), x2: X0, y2: py(p / 100), stroke: INK, 'stroke-width': 1 }));
        txt(plot, { x: X0 - 5, y: py(p / 100) + 3, 'text-anchor': 'end', 'font-size': 9, fill: INK }, p + '%');
      }
      txt(plot, { x: 2, y: 10, 'font-size': 9, fill: INK }, 'time-zero marker left (% of its starting amount)');
      for (const h of [0, 6, 12, 18, 24]) {
        plot.appendChild(el('line', { x1: px(h), y1: Y1, x2: px(h), y2: Y1 + 3, stroke: INK, 'stroke-width': 1 }));
        txt(plot, { x: px(h), y: Y1 + 13, 'text-anchor': h === 0 ? 'start' : h === 24 ? 'end' : 'middle', 'font-size': 9, fill: INK }, String(h));
      }
      txt(plot, { x: (X0 + X1) / 2, y: Y1 + 28, 'text-anchor': 'middle', 'font-size': 10, fill: INK }, 'time t (hours)');
      txt(plot, { x: (X0 + X1) / 2, y: Y1 + 42, 'text-anchor': 'middle', 'font-size': 9, fill: INK }, block ? 'greyed: one-compartment rule does not apply' : 'curve: exp(−t / τ), in this sketch');

      // tau and 36.8% guides (not drawn while the aqueduct is blocked)
      if (!block) {
        const e1 = Math.exp(-1);
        plot.appendChild(el('line', { x1: px(tau), y1: Y0, x2: px(tau), y2: Y1, stroke: ORANGE, 'stroke-width': 1.1, 'stroke-dasharray': '4 3' }));
        plot.appendChild(el('line', { x1: X0, y1: py(e1), x2: X1, y2: py(e1), stroke: ORANGE, 'stroke-width': 1.1, 'stroke-dasharray': '4 3' }));
        txt(plot, { x: px(tau) + (tau > 16 ? -4 : 4), y: Y0 + 10, 'text-anchor': tau > 16 ? 'end' : 'start', 'font-size': 9, fill: ORANGE, 'font-weight': 700 }, 'τ = ' + trim(tau, 2) + ' h');
        txt(plot, { x: X1 - 2, y: py(e1) + 12, 'text-anchor': 'end', 'font-size': 9, fill: ORANGE, 'font-weight': 700 }, '36.8% at t = τ');
      }

      let d = '';
      for (let i = 0; i <= 120; i++) { const tt = (i / 120) * TMAX; d += (i ? 'L' : 'M') + px(tt).toFixed(1) + ' ' + py(Math.exp(-tt / tau)).toFixed(1) + ' '; }
      plot.appendChild(el('path', { d: d.trim(), fill: 'none', stroke: block ? FAINT : ACCENT, 'stroke-width': block ? 2 : 2.6, 'stroke-dasharray': block ? '5 4' : '' }));

      if (block) {
        plot.appendChild(el('rect', { x: 96, y: 52, width: 192, height: 40, rx: 4, fill: '#fff', stroke: RED, 'stroke-width': 1 }));
        txt(plot, { x: 192, y: 66, 'text-anchor': 'middle', 'font-size': 9, 'font-weight': 700, fill: RED }, 'Aqueduct blocked: outflow no longer');
        txt(plot, { x: 192, y: 78, 'text-anchor': 'middle', 'font-size': 9, 'font-weight': 700, fill: RED }, 'equals secretion, so this curve');
        txt(plot, { x: 192, y: 90 - 0, 'text-anchor': 'middle', 'font-size': 9, 'font-weight': 700, fill: RED }, 'does not apply');
      } else {
        const f = Math.exp(-t / tau);
        plot.appendChild(el('line', { x1: px(t), y1: Y1, x2: px(t), y2: py(f), stroke: INK, 'stroke-width': 1, 'stroke-dasharray': '2 2' }));
        plot.appendChild(el('line', { x1: X0, y1: py(f), x2: px(t), y2: py(f), stroke: INK, 'stroke-width': 1, 'stroke-dasharray': '2 2' }));
        plot.appendChild(el('circle', { cx: px(t), cy: py(f), r: 5, fill: '#fff', stroke: INK, 'stroke-width': 2 }));
      }
    }

    function render() {
      const Q = parseFloat(qIn.value), V = parseFloat(vIn.value), t = parseFloat(tIn.value), block = blockIn.checked;
      qOut.textContent = String(Q); vOut.textContent = String(V); tOut.textContent = trim(t, 1);
      const turn = Q / V, tauDay = V / Q, tauH = tauDay * 24, perMin = Q / 1440, minutes = V / perMin;
      const f = Math.exp(-t / tauH), r = t / tauH;

      drawMap(block);
      drawPlot(tauH, t, block);

      if (block) {
        rMin.textContent = 'not applied while the aqueduct is blocked';
        rTurn.textContent = 'not applied while the aqueduct is blocked';
        rTau.textContent = 'not applied while the aqueduct is blocked';
        rFrac.textContent = 'not given: no exit upstream';
      } else {
        rMin.textContent = `${Q} ÷ 1,440 = ${perMin.toFixed(3)} mL/min; ${V} ÷ ${perMin.toFixed(3)} = ${Math.round(minutes)} min = ${trim(minutes / 60, 2)} h`;
        rTurn.textContent = `${Q} mL/day ÷ ${V} mL = ${turn.toFixed(2)} per day`;
        rTau.textContent = `${V} ÷ ${Q} = ${trim(tauDay, 3)} day = ${trim(tauDay, 3)} × 24 = ${trim(tauH, 2)} h`;
        rFrac.textContent = `exp(−${trim(t, 1)} / ${trim(tauH, 2)}) = exp(−${trim(r, 2)}) = ${pct(f)}`;
      }

      let s: string;
      if (block) {
        s = 'Aqueduct blocked while secretion continues: fluid made in the lateral and third ventricles has no exit, so those ventricles enlarge (drawn not to scale); the fourth ventricle, downstream of the block, does not. Outflow no longer equals secretion, so the one-compartment washout curve is greyed and this sketch gives no marker fraction.';
      } else {
        const made = r; // volumes of fluid made so far = Q t / V = t / tau
        s = `Fluid runs one way from the lateral ventricles to the subarachnoid space and out. With Q = ${Q} mL/day and V = ${V} mL, τ is ${trim(tauH, 2)} h (${turn.toFixed(2)} turnovers a day). `;
        if (t === 0) s += 'At t = 0 the whole time-zero marker (100%) is present. ';
        else if (Math.abs(r - 1) < 0.015) s += `At t = ${trim(t, 1)} h, one full volume of fluid has been made, yet ${pct(f)} of the marker is still there: replacing a volume does not empty it. `;
        else if (Math.abs(r - 3) < 0.03) s += `At t = ${trim(t, 1)} h, three volumes have been made and about ${pct(f)} of the marker is still there: smaller, not gone. `;
        else s += `At t = ${trim(t, 1)} h, ${trim(made, 2)} volume${Math.abs(made - 1) < 0.005 ? '' : 's'} of fluid ${Math.abs(made - 1) < 0.005 ? 'has' : 'have'} been made and ${pct(f)} of the marker is still there. `;
        s += 'Outflow equals secretion, so the volume stays steady and the one-compartment rule applies.';
      }
      why.textContent = s;
    }

    [qIn, vIn, tIn, blockIn].forEach((c) => c.addEventListener('input', render));
    root.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach((b) => b.addEventListener('click', () => {
      const p = b.getAttribute('data-preset');
      if (p === 'lesson') { qIn.value = '500'; vIn.value = '150'; tIn.value = '7.2'; blockIn.checked = false; }
      else {
        const tauH = (parseFloat(vIn.value) / parseFloat(qIn.value)) * 24;
        tIn.value = p === 'tau' ? String(Math.min(24, tauH)) : p === '3tau' ? String(Math.min(24, 3 * tauH)) : '0';
      }
      render();
    }));
    render();
  });
</script>

<style>
  .ctw { padding: var(--ddp-space-3) var(--ddp-space-4) var(--ddp-space-4); margin: var(--ddp-space-5) 0; }
  .ctw-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem; font-weight: 600; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); margin-bottom: var(--ddp-space-3); }
  .ctw-chip { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 400; color: var(--ddp-color-muted); }
  .ctw-svg { display: block; width: 100%; max-width: 560px; margin: 0 auto var(--ddp-space-2); height: auto; background: #fff; border: 1px solid var(--ddp-color-line); border-radius: 6px; }
  .ctw-controls { display: grid; grid-template-columns: 1fr 1fr; gap: var(--ddp-space-2) var(--ddp-space-4); margin: var(--ddp-space-3) 0 var(--ddp-space-2); }
  .ctw-wide { grid-column: 1 / -1; }
  .ctw-slabel { display: flex; flex-direction: column; gap: 0.1rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .ctw-slabel em { font-style: normal; font-weight: 700; color: var(--ddp-color-accent); font-family: var(--ddp-font-mono); }
  .ctw-slabel input { accent-color: var(--ddp-color-accent); }
  .ctw-check { display: flex; align-items: center; gap: 0.45rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .ctw-check input { accent-color: var(--ddp-color-accent); }
  .ctw-presets { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: var(--ddp-space-2) 0; }
  .ctw-btn { font: inherit; font-size: var(--ddp-text-xs); padding: 0.3rem 0.6rem; border: 1px solid var(--ddp-color-line); border-radius: 6px; background: #fff; color: var(--ddp-color-primary); cursor: pointer; }
  .ctw-btn:hover, .ctw-btn:focus-visible { border-color: var(--ddp-color-accent); outline: 2px solid var(--ddp-color-accent); outline-offset: 1px; }
  .ctw-readout { display: grid; grid-template-columns: 1fr; gap: var(--ddp-space-2); margin: var(--ddp-space-2) 0; padding: var(--ddp-space-2) var(--ddp-space-3); background: color-mix(in srgb, var(--ddp-color-accent) 8%, transparent); border-radius: 6px; }
  .ctw-readout div { display: flex; flex-direction: column; gap: 0.1rem; }
  .ctw-readout dt { font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .ctw-readout dd { margin: 0; font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); color: var(--ddp-color-primary); font-weight: 700; overflow-wrap: anywhere; }
  .ctw-why { margin: 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); line-height: 1.5; min-height: 7em; }
  .ctw-assume { margin: var(--ddp-space-2) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .ctw-foot { margin: var(--ddp-space-3) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); border-left: 3px solid var(--ddp-color-secondary); padding-left: 0.55rem; }
  @media (max-width: 480px) { .ctw-controls { grid-template-columns: 1fr; } }
</style>
