---
/**
 * HersheyChaseTracer — label the phage with sulfur-35 (protein) or phosphorus-32 (DNA),
 * let it attach to E. coli, blend, and see where the label goes. Each of 100 counted label
 * units is an independent draw: into the fluid with the lesson's summary fraction (about 75%
 * of the sulfur, about 15% of the phosphorus) or left with the cells. The observed split is
 * shown beside the expected one, and Resample redraws it. The progeny panel states the
 * lesson's two figures as bounds (under 1% of parental sulfur; 30% or more of parental
 * phosphorus), not as sampled values. Labelled blocks and dots only. Self-contained vanilla-TS
 * Astro island. Original.
 */
---

<figure class="hct card" data-hct>
  <figcaption class="hct-head">Hershey-Chase tracer: where does each label end up after blending?<span class="hct-chip">⚙ original · interactive</span></figcaption>

  <svg class="hct-svg" viewBox="0 0 360 290" role="img" aria-label="Two tubes after centrifugation: the cell pellet and the fluid with the sheared-off phage coats, with dots for the label counted in each, and a bar for the label found in progeny phage" data-plot></svg>

  <fieldset class="hct-field">
    <legend>Label the phage with</legend>
    <label><input type="radio" name="hct-label" value="S" data-label checked /> sulfur-35 (marks protein)</label>
    <label><input type="radio" name="hct-label" value="P" data-label /> phosphorus-32 (marks mostly DNA)</label>
  </fieldset>
  <div class="hct-btns">
    <button type="button" class="hct-btn hct-go" data-blend>Blend and spin</button>
    <button type="button" class="hct-btn" data-resample>Resample</button>
  </div>

  <dl class="hct-readout">
    <div><dt>in the fluid, simulated</dt><dd data-obs>–</dd></div>
    <div><dt>in the fluid, expected (about)</dt><dd data-exp>–</dd></div>
    <div><dt>with the cells, simulated</dt><dd data-cells>–</dd></div>
  </dl>

  <p class="hct-verdict" data-verdict role="status"></p>

  <p class="hct-foot">Counts vary by chance in this sketch. Rule to keep: say "most" and "about". Blending stripped about 75% of the sulfur but only about 15% of the phosphorus, a quarter of the sulfur stayed with the cells, and the result does not prove that no protein entered. This is a sketch of the logic: each dot is one counted unit of label, drawn at random.</p>
</figure>

<script>
  const NS = 'http://www.w3.org/2000/svg';
  const ORANGE = '#e57200', TEAL = '#0e7c86', INK = '#4b4b55', FAINT = '#8a8a96', GRID = '#d9d9e0';
  const N = 100;
  type Lab = 'S' | 'P';
  const INFO: Record<Lab, { name: string; color: string; pFluid: number }> = {
    S: { name: 'sulfur-35', color: ORANGE, pFluid: 0.75 },
    P: { name: 'phosphorus-32', color: TEAL, pFluid: 0.15 },
  };
  function el(name: string, attrs: Record<string, string | number>, text?: string): SVGElement {
    const e = document.createElementNS(NS, name);
    for (const k in attrs) e.setAttribute(k, String(attrs[k]));
    if (text !== undefined) e.textContent = text;
    return e;
  }
  document.querySelectorAll<HTMLElement>('[data-hct]').forEach((root) => {
    const plot = root.querySelector<SVGSVGElement>('[data-plot]')!;
    const obsEl = root.querySelector<HTMLElement>('[data-obs]')!;
    const expEl = root.querySelector<HTMLElement>('[data-exp]')!;
    const cellsEl = root.querySelector<HTMLElement>('[data-cells]')!;
    const verdict = root.querySelector<HTMLElement>('[data-verdict]')!;
    const blendBtn = root.querySelector<HTMLButtonElement>('[data-blend]')!;
    const radios = root.querySelectorAll<HTMLInputElement>('[data-label]');
    let blended = false;
    let moved: boolean[] = [];

    function label(): Lab { return (Array.from(radios).find((r) => r.checked)?.value as Lab) || 'S'; }
    function draw() {
      const lab = label(), info = INFO[lab];
      const nFluid = blended ? moved.filter(Boolean).length : 0;
      const nCells = N - nFluid;
      plot.replaceChildren();
      const tube = (x: number, title: string, sub: string) => {
        plot.appendChild(el('rect', { x, y: 34, width: 150, height: 132, rx: 8, fill: '#fff', stroke: FAINT, 'stroke-width': 1.5 }));
        plot.appendChild(el('text', { x: x + 75, y: 16, 'font-size': 11, 'font-weight': 700, 'text-anchor': 'middle', fill: INK }, title));
        plot.appendChild(el('text', { x: x + 75, y: 28, 'font-size': 9, 'text-anchor': 'middle', fill: INK }, sub));
      };
      tube(20, 'Pellet: E. coli cells', blended ? 'spun to the bottom' : 'phage attached, not yet blended');
      tube(190, 'Fluid: coats shed by blending', blended ? 'stays above the pellet' : 'nothing sheared off yet');
      const dot = (x0: number, i: number, bottom: number) => {
        const cx = x0 + 22 + (i % 10) * 12.5, cy = bottom - 14 - Math.floor(i / 10) * 12;
        plot.appendChild(el('circle', { cx, cy, r: 4.5, fill: info.color }));
      };
      for (let i = 0; i < nCells; i++) dot(20, i, 164);
      for (let i = 0; i < nFluid; i++) dot(190, i, 164);
      plot.appendChild(el('text', { x: 95, y: 182, 'font-size': 10, 'text-anchor': 'middle', 'font-weight': 700, fill: info.color }, `${nCells} of ${N} label units`));
      plot.appendChild(el('text', { x: 265, y: 182, 'font-size': 10, 'text-anchor': 'middle', 'font-weight': 700, fill: info.color }, `${nFluid} of ${N} label units`));
      plot.appendChild(el('text', { x: 180, y: 198, 'font-size': 9, 'text-anchor': 'middle', fill: INK }, `each dot = one unit of ${info.name} in this sketch, not a measured count`));
      // progeny panel: the lesson's two figures as bounds
      plot.appendChild(el('line', { x1: 20, y1: 210, x2: 340, y2: 210, stroke: GRID }));
      plot.appendChild(el('text', { x: 20, y: 226, 'font-size': 10, 'font-weight': 700, fill: INK }, 'Parental label found in progeny phage'));
      const bx = 20, bw = 300;
      plot.appendChild(el('rect', { x: bx, y: 236, width: bw, height: 16, fill: '#fff', stroke: GRID }));
      for (const f of [0.25, 0.5, 0.75]) plot.appendChild(el('line', { x1: bx + f * bw, y1: 236, x2: bx + f * bw, y2: 252, stroke: GRID }));
      plot.appendChild(el('text', { x: bx, y: 264, 'font-size': 9, fill: INK }, '0%'));
      plot.appendChild(el('text', { x: bx + bw, y: 264, 'font-size': 9, 'text-anchor': 'end', fill: INK }, '100%'));
      if (blended) {
        if (lab === 'S') {
          plot.appendChild(el('rect', { x: bx, y: 236, width: 3, height: 16, fill: info.color }));
          plot.appendChild(el('text', { x: bx + 10, y: 248, 'font-size': 10, 'font-weight': 700, fill: info.color }, 'less than 1% of the parental sulfur'));
        } else {
          plot.appendChild(el('rect', { x: bx, y: 236, width: 0.3 * bw, height: 16, fill: info.color }));
          plot.appendChild(el('rect', { x: bx + 0.3 * bw, y: 236, width: 0.7 * bw, height: 16, fill: info.color, opacity: 0.18 }));
          plot.appendChild(el('text', { x: bx + 6, y: 248, 'font-size': 10, 'font-weight': 700, fill: '#fff' }, '30% or more'));
          plot.appendChild(el('text', { x: bx + 0.3 * bw + 8, y: 248, 'font-size': 9, fill: INK }, 'of the parental phosphorus'));
        }
      } else {
        plot.appendChild(el('text', { x: bx + bw / 2, y: 248, 'font-size': 9, 'text-anchor': 'middle', fill: INK }, 'blend and spin first'));
      }
      plot.appendChild(el('text', { x: 180, y: 282, 'font-size': 9, 'text-anchor': 'middle', fill: INK }, blended ? 'the blended cells still produced phage · not to scale' : 'not to scale · a sketch of the logic'));
    }
    function sample() {
      const p = INFO[label()].pFluid;
      moved = Array.from({ length: N }, () => Math.random() < p);
    }
    function render() {
      const lab = label(), info = INFO[lab];
      const nFluid = blended ? moved.filter(Boolean).length : 0;
      draw();
      blendBtn.textContent = blended ? 'Unblend (start over)' : 'Blend and spin';
      root.querySelector<HTMLButtonElement>('[data-resample]')!.disabled = !blended;
      if (!blended) {
        obsEl.textContent = expEl.textContent = cellsEl.textContent = '–';
        verdict.textContent = `${lab === 'S' ? 'The sulfur-35 marks the protein coat. DNA has none.' : 'The phosphorus-32 marks mostly DNA, in its backbone. Protein has little.'} The labelled phage have attached to the E. coli. In this sketch all the label starts with the cells. Press Blend and spin to shear off what is attached.`;
        return;
      }
      obsEl.textContent = `${nFluid} of ${N}`;
      expEl.textContent = `${Math.round(info.pFluid * N)} of ${N}`;
      cellsEl.textContent = `${N - nFluid} of ${N}`;
      verdict.textContent = lab === 'S'
        ? `Most of the sulfur-35 (about 75% in the summary result) came off into the fluid with the coats; a quarter stayed with the cells, so say most, not all. The stripped cells still produced phage, and the progeny carried less than 1% of the parental sulfur.`
        : `Most of the phosphorus-32 (about 85%) stayed with the cells, so the label travelled with the cells, which fits DNA entering them. The stripped cells still produced phage, and the progeny carried 30% or more of the parental phosphorus. Whether non-DNA material free of sulfur entered was left undetermined.`;
    }
    blendBtn.addEventListener('click', () => { blended = !blended; if (blended) sample(); render(); });
    root.querySelector<HTMLButtonElement>('[data-resample]')!.addEventListener('click', () => { sample(); render(); });
    radios.forEach((r) => r.addEventListener('change', () => { blended = false; render(); }));
    render();
  });
</script>

<style is:global>
  .hct { padding: var(--ddp-space-3) var(--ddp-space-4) var(--ddp-space-4); margin: var(--ddp-space-5) 0; }
  .hct-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem; font-weight: 600; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); margin-bottom: var(--ddp-space-3); }
  .hct-chip { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 400; color: var(--ddp-color-muted); }
  .hct-svg { display: block; width: 100%; max-width: 600px; margin: 0 auto var(--ddp-space-3); height: auto; background: #fff; border: 1px solid var(--ddp-color-line); border-radius: 6px; }
  .hct-field { border: 1px solid var(--ddp-color-line); border-radius: 6px; margin: var(--ddp-space-2) 0; padding: 0.4rem 0.7rem; display: flex; flex-wrap: wrap; gap: 0.2rem 1.2rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .hct-field legend { font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); padding: 0 0.3rem; }
  .hct-field input { accent-color: var(--ddp-color-accent); }
  .hct-btns { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: var(--ddp-space-2) 0; }
  .hct-btn { border: 1px solid var(--ddp-color-line); border-radius: 5px; background: transparent; color: var(--ddp-color-ink-soft); font-size: var(--ddp-text-xs); padding: 0.3rem 0.65rem; cursor: pointer; }
  .hct-btn.hct-go { background: var(--ddp-color-accent); border-color: var(--ddp-color-accent); color: #fff; font-weight: 600; }
  .hct-btn:disabled { opacity: 0.45; cursor: default; }
  .hct-btn:focus-visible, .hct-field input:focus-visible { outline: 2px solid var(--ddp-color-accent); outline-offset: 2px; }
  .hct-readout { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.4rem; margin: var(--ddp-space-2) 0; }
  .hct-readout div { border: 1px solid var(--ddp-color-line); border-radius: 6px; padding: 0.3rem 0.5rem; }
  .hct-readout dt { font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .hct-readout dd { margin: 0; font-weight: 600; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); }
  .hct-verdict { margin: var(--ddp-space-2) 0; padding: var(--ddp-space-2) var(--ddp-space-3); background: color-mix(in srgb, var(--ddp-color-accent) 8%, transparent); border-radius: 6px; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); min-height: 3em; }
  .hct-foot { margin: var(--ddp-space-3) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); border-left: 3px solid var(--ddp-color-secondary); padding-left: 0.55rem; }
  @media (max-width: 520px) { .hct-readout { grid-template-columns: 1fr; } }
</style>
