---
/**
 * NondisjunctionGametes — follow chromosome 21 through one father's spermatocyte and choose
 * where the error happens: nowhere, at meiosis I (the homologues 21a and 21b stay together)
 * or at meiosis II (the sisters of one 21 stay together). The four sperm are drawn with their
 * copies of chromosome 21, then each is paired with a normal egg (one chromosome 21) to give
 * the zygote. Every rule is a statement of the chromosome-changes worked problem, part 1.
 * Nothing is sampled, so there is no scatter: the outcome follows from the rule.
 * Self-contained vanilla-TS Astro island. Original.
 */
---

<figure class="ndg card" data-ndg>
  <figcaption class="ndg-head">Nondisjunction: which gametes, which zygotes<span class="ndg-chip">⚙ original · interactive</span></figcaption>

  <fieldset class="ndg-ctl">
    <legend>Where does chromosome 21 fail to separate in this one spermatocyte?</legend>
    <label><input type="radio" name="ndg-where" value="none" checked /> nowhere (normal)</label>
    <label><input type="radio" name="ndg-where" value="m1" /> at meiosis I</label>
    <label><input type="radio" name="ndg-where" value="m2" /> at meiosis II</label>
  </fieldset>

  <svg class="ndg-svg" viewBox="0 0 360 262" role="img" aria-label="One spermatocyte gives four sperm with their copies of chromosome 21; each sperm joins a normal egg to give a zygote" data-stage></svg>

  <div class="ndg-tally" data-tally></div>

  <p class="ndg-verdict" data-verdict role="status"></p>

  <p class="ndg-foot">A missed separation leaves one cell with two copies and another with none. Meiosis I error: two disomic and two nullisomic sperm. Meiosis II error: one disomic, one nullisomic and two normal. This is a sketch of the logic for one chromosome, with one error and all four products recovered.</p>
</figure>

<script>
  const NS = 'http://www.w3.org/2000/svg';
  type Where = 'none' | 'm1' | 'm2';
  // Each sperm is a list of chromatids of chromosome 21: 'a' from homologue 21a, 'b' from 21b.
  const SPERM: Record<Where, string[][]> = {
    none: [['a'], ['a'], ['b'], ['b']],
    m1: [['a', 'b'], ['a', 'b'], [], []],
    m2: [['a', 'a'], [], ['b'], ['b']],
  };
  const COL: Record<string, string> = { a: '#0e7c86', b: '#e57200', e: '#7a5ea8' };
  const INK = '#4b4b55', FAINT = '#8a8a96';
  function el(name: string, attrs: Record<string, string | number>, text?: string): SVGElement {
    const e = document.createElementNS(NS, name);
    for (const k in attrs) e.setAttribute(k, String(attrs[k]));
    if (text !== undefined) e.textContent = text;
    return e;
  }
  function gameteName(n: number) { return n === 1 ? 'normal (n)' : n === 2 ? 'disomic (n + 1)' : 'nullisomic (n − 1)'; }
  function zygoteName(n: number) { return n === 2 ? 'normal' : n === 3 ? 'trisomic' : 'monosomic'; }
  document.querySelectorAll<HTMLElement>('[data-ndg]').forEach((root) => {
    const stage = root.querySelector<SVGSVGElement>('[data-stage]')!;
    const tally = root.querySelector<HTMLElement>('[data-tally]')!;
    const verdict = root.querySelector<HTMLElement>('[data-verdict]')!;
    const radios = root.querySelectorAll<HTMLInputElement>('input[name="ndg-where"]');
    function chroms(g: SVGElement, cx: number, y: number, list: string[]) {
      const w = 7, gap = 3, total = list.length * w + (list.length - 1) * gap;
      list.forEach((k, i) => g.appendChild(el('rect', { x: cx - total / 2 + i * (w + gap), y, width: w, height: 20, rx: 3, fill: COL[k] })));
    }
    function render() {
      const where = (Array.from(radios).find((r) => r.checked)?.value ?? 'none') as Where;
      const sperm = SPERM[where];
      stage.replaceChildren();
      stage.appendChild(el('text', { x: 8, y: 14, 'font-size': 10, 'font-weight': 700, fill: INK }, 'Father: one spermatocyte, homologues 21a and 21b'));
      stage.appendChild(el('rect', { x: 150, y: 20, width: 7, height: 20, rx: 3, fill: COL.a }));
      stage.appendChild(el('rect', { x: 160, y: 20, width: 7, height: 20, rx: 3, fill: COL.a }));
      stage.appendChild(el('rect', { x: 193, y: 20, width: 7, height: 20, rx: 3, fill: COL.b }));
      stage.appendChild(el('rect', { x: 203, y: 20, width: 7, height: 20, rx: 3, fill: COL.b }));
      stage.appendChild(el('text', { x: 130, y: 34, 'font-size': 9, 'text-anchor': 'end', fill: INK }, '21a'));
      stage.appendChild(el('text', { x: 230, y: 34, 'font-size': 9, fill: INK }, '21b'));
      const note = where === 'none' ? 'meiosis I and II both normal'
        : where === 'm1' ? 'meiosis I: 21a and 21b go to the same cell'
        : 'meiosis II: the sisters of 21a stay together';
      stage.appendChild(el('text', { x: 180, y: 56, 'font-size': 10, 'text-anchor': 'middle', 'font-weight': 700, fill: where === 'none' ? '#0e7c86' : '#b3261e' }, note));
      stage.appendChild(el('text', { x: 8, y: 80, 'font-size': 9, fill: INK }, 'Four sperm'));
      stage.appendChild(el('text', { x: 8, y: 180, 'font-size': 9, fill: INK }, 'Zygotes after a normal egg (purple: its one 21)'));
      const xs = [48, 136, 224, 312];
      sperm.forEach((list, i) => {
        const cx = xs[i], n = list.length;
        const bad = n !== 1;
        stage.appendChild(el('rect', { x: cx - 40, y: 86, width: 80, height: 56, rx: 7, fill: '#fff', stroke: bad ? '#b3261e' : FAINT, 'stroke-width': bad ? 1.8 : 1 }));
        if (n === 0) stage.appendChild(el('text', { x: cx, y: 108, 'font-size': 9, 'text-anchor': 'middle', fill: FAINT }, 'no 21'));
        else chroms(stage, cx, 92, list);
        stage.appendChild(el('text', { x: cx, y: 128, 'font-size': 9, 'text-anchor': 'middle', fill: INK }, `${n} cop${n === 1 ? 'y' : 'ies'} of 21`));
        stage.appendChild(el('text', { x: cx, y: 138, 'font-size': 9, 'text-anchor': 'middle', 'font-weight': 700, fill: bad ? '#b3261e' : '#0e7c86' }, gameteName(n).split(' ')[0]));
        // arrow to zygote
        stage.appendChild(el('line', { x1: cx, y1: 144, x2: cx, y2: 166, stroke: FAINT, 'stroke-width': 1, 'stroke-dasharray': '3 3' }));
        const z = n + 1, zbad = z !== 2;
        stage.appendChild(el('rect', { x: cx - 40, y: 188, width: 80, height: 62, rx: 7, fill: '#fff', stroke: zbad ? '#b3261e' : FAINT, 'stroke-width': zbad ? 1.8 : 1 }));
        chroms(stage, cx, 194, [...list, 'e']);
        stage.appendChild(el('text', { x: cx, y: 230, 'font-size': 9, 'text-anchor': 'middle', 'font-weight': 700, fill: zbad ? '#b3261e' : '#0e7c86' }, zygoteName(z)));
        stage.appendChild(el('text', { x: cx, y: 242, 'font-size': 9, 'text-anchor': 'middle', fill: INK }, `${z} × 21`));
      });
      // tally
      const count = (f: (n: number) => boolean) => sperm.filter((l) => f(l.length)).length;
      const nd = count((n) => n === 2), nu = count((n) => n === 0), nn = count((n) => n === 1);
      tally.textContent = `Sperm: ${nn} normal, ${nd} disomic (n + 1), ${nu} nullisomic (n − 1). Zygotes: ${nn} normal, ${nd} trisomic, ${nu} monosomic. Total ${nn + nd + nu} = 4.`;
      let v: string;
      if (where === 'none') v = 'No error: all four sperm carry one chromosome 21, two from each homologue, so a normal egg gives a normal zygote with two copies each time.';
      else if (where === 'm1') v = 'Error at meiosis I: 21a and 21b go to the same secondary spermatocyte, and meiosis II then runs normally. That cell gives two disomic sperm, one chromatid of each homologue. The other cell had no 21, so two nullisomic sperm. With a normal egg: two trisomic and two monosomic zygotes, and none normal.';
      else v = 'Error at meiosis II: meiosis I is normal. In the cell with 21a the sisters fail to part, giving one sperm with two copies of 21a and one with none. The other cell divides normally, so two normal sperm. With a normal egg: one trisomic, one monosomic and two normal zygotes.';
      verdict.textContent = v;
    }
    radios.forEach((r) => r.addEventListener('change', render));
    render();
  });
</script>

<style is:global>
  .ndg { padding: var(--ddp-space-3) var(--ddp-space-4) var(--ddp-space-4); margin: var(--ddp-space-5) 0; }
  .ndg-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem; font-weight: 600; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); margin-bottom: var(--ddp-space-3); }
  .ndg-chip { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 400; color: var(--ddp-color-muted); }
  .ndg-ctl { border: 1px solid var(--ddp-color-line); border-radius: 6px; margin: 0 0 var(--ddp-space-3); padding: 0.4rem 0.7rem; display: flex; flex-wrap: wrap; gap: 0.2rem 1.2rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .ndg-ctl legend { font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); padding: 0 0.3rem; }
  .ndg-ctl input { accent-color: var(--ddp-color-accent); }
  .ndg-svg { display: block; width: 100%; max-width: 600px; margin: 0 auto var(--ddp-space-3); height: auto; background: #fff; border: 1px solid var(--ddp-color-line); border-radius: 6px; }
  .ndg-tally { font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); margin: 0 0 var(--ddp-space-2); }
  .ndg-verdict { margin: var(--ddp-space-2) 0; padding: var(--ddp-space-2) var(--ddp-space-3); background: color-mix(in srgb, var(--ddp-color-accent) 8%, transparent); border-radius: 6px; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); min-height: 3em; }
  .ndg-foot { margin: var(--ddp-space-3) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); border-left: 3px solid var(--ddp-color-secondary); padding-left: 0.55rem; }
</style>
