---
/**
 * SignalLengthDecoder — a part that arrives late can time a signal. ERK switches on
 * the c-fos gene; the c-Fos protein appears after a delay and is quickly destroyed
 * unless ERK is still active, in which case it is protected and builds up. Two
 * traces share one time axis. Time and level are relative units: the lesson gives
 * no times, so this is a sketch of the logic. Self-contained vanilla-TS island. Original.
 */
---

<figure class="sld card" data-sld>
  <figcaption class="sld-head">A late part reads signal length — ERK and c-Fos<span class="sld-chip">⚙ original · interactive</span></figcaption>

  <svg class="sld-svg" viewBox="0 0 340 262" role="img" aria-label="Two traces on one time axis: ERK activity as a block of chosen length, and c-Fos protein, which appears after a delay and builds up only if ERK is still on" data-plot></svg>

  <div class="sld-controls">
    <label class="sld-slabel"><span>How long ERK stays on <em data-out="dur">70</em> <small>(relative time)</small></span>
      <input type="range" data-in="dur" min="5" max="90" step="1" value="70" />
    </label>
    <label class="sld-slabel"><span>Delay before c-Fos appears <em data-out="delay">30</em> <small>(relative time)</small></span>
      <input type="range" data-in="delay" min="10" max="60" step="1" value="30" />
    </label>
  </div>

  <p class="sld-why" data-why role="status"></p>

  <p class="sld-foot">The rule to keep: c-Fos is made late and destroyed fast, and it is kept only if ERK is still active when it appears, so the cell reads a long signal as c-Fos that builds up. This was shown for c-Fos in fibroblasts; do not assume every long signal is read this way. The lesson gives no times, so both axes are relative units and the picture is a sketch of the logic. The dashed line is an arbitrary marker, and the rates are invented. In this sketch, protection lasts only while ERK is on, so c-Fos falls again when ERK goes off; the lesson does not say how fast.</p>
</figure>

<script>
  const NS = 'http://www.w3.org/2000/svg';
  const ACCENT = '#0e7c86', ORANGE = '#e57200', INK = '#4b4b55', FAINT = '#b9b9c2';
  function el(name: string, attrs: Record<string, string | number>): SVGElement {
    const e = document.createElementNS(NS, name);
    for (const k in attrs) e.setAttribute(k, String(attrs[k]));
    return e;
  }
  document.querySelectorAll<HTMLElement>('[data-sld]').forEach((root) => {
    const plot = root.querySelector<SVGSVGElement>('[data-plot]')!;
    const durIn = root.querySelector<HTMLInputElement>('[data-in="dur"]')!;
    const delIn = root.querySelector<HTMLInputElement>('[data-in="delay"]')!;
    const durOut = root.querySelector<HTMLElement>('[data-out="dur"]')!;
    const delOut = root.querySelector<HTMLElement>('[data-out="delay"]')!;
    const why = root.querySelector<HTMLElement>('[data-why]')!;

    const T0 = 5, TMAX = 130, X0 = 44, X1 = 328;
    const px = (t: number) => X0 + (t / TMAX) * (X1 - X0);
    // ERK panel
    const EY0 = 30, EY1 = 88;
    // c-Fos panel
    const FY0 = 118, FY1 = 218, FMAX = 3;
    const fy = (v: number) => FY1 - Math.min(v, FMAX) / FMAX * (FY1 - FY0);
    // sketch constants (relative units)
    const MAKE = 0.04, SLOW = 0.01, FAST = 0.4, LONG_LEVEL = 1;

    function text(x: number, y: number, s: string, o: Record<string, string | number> = {}) {
      const t = el('text', { x, y, 'font-size': 9, fill: INK, ...o }); t.textContent = s; plot.appendChild(t);
    }
    function render() {
      const dur = parseInt(durIn.value, 10);
      const delay = parseInt(delIn.value, 10);
      durOut.textContent = String(dur);
      delOut.textContent = String(delay);
      const tOff = T0 + dur, tApp = T0 + delay;
      const erk = (t: number) => (t >= T0 && t < tOff ? 1 : 0);

      // c-Fos: made from the ERK signal of `delay` earlier; destroyed fast unless ERK is on now
      const pts: [number, number][] = [];
      let c = 0, peak = 0, atOff = 0;
      for (let t = 0; t <= TMAX; t += 0.5) {
        c += 0.5 * (MAKE * erk(t - delay) - (erk(t) ? SLOW : FAST) * c);
        if (c < 0) c = 0;
        if (c > peak) peak = c;
        if (Math.abs(t - tOff) < 0.25) atOff = c;
        pts.push([t, c]);
      }

      plot.replaceChildren();
      // ERK panel
      text(X0 - 2, 14, 'ERK activity', { 'font-weight': 700 });
      plot.appendChild(el('line', { x1: X0, y1: EY0, x2: X0, y2: EY1, stroke: INK, 'stroke-width': 1 }));
      plot.appendChild(el('line', { x1: X0, y1: EY1, x2: X1, y2: EY1, stroke: INK, 'stroke-width': 1 }));
      text(X0 - 4, EY0 + 4, 'on', { 'text-anchor': 'end' });
      text(X0 - 4, EY1, 'off', { 'text-anchor': 'end' });
      plot.appendChild(el('path', { d: `M${px(0)} ${EY1} L${px(T0)} ${EY1} L${px(T0)} ${EY0} L${px(Math.min(tOff, TMAX))} ${EY0} L${px(Math.min(tOff, TMAX))} ${EY1} L${px(TMAX)} ${EY1}`, fill: 'none', stroke: ORANGE, 'stroke-width': 2.6 }));
      plot.appendChild(el('rect', { x: px(T0), y: EY0, width: px(tOff) - px(T0), height: EY1 - EY0, fill: ORANGE, opacity: 0.15 }));
      // c-Fos panel
      text(X0 - 2, 108, 'c-Fos protein (relative units)', { 'font-weight': 700 });
      plot.appendChild(el('line', { x1: X0, y1: FY0, x2: X0, y2: FY1, stroke: INK, 'stroke-width': 1 }));
      plot.appendChild(el('line', { x1: X0, y1: FY1, x2: X1, y2: FY1, stroke: INK, 'stroke-width': 1 }));
      plot.appendChild(el('line', { x1: X0, y1: fy(LONG_LEVEL), x2: X1, y2: fy(LONG_LEVEL), stroke: FAINT, 'stroke-width': 0.8, 'stroke-dasharray': '2 3' }));
      text(X1, fy(LONG_LEVEL) - 3, 'a built-up level', { 'text-anchor': 'end', fill: '#6b6b75' });
      let d = '';
      pts.forEach(([t, v], i) => { d += (i ? 'L' : 'M') + px(t).toFixed(1) + ' ' + fy(v).toFixed(1) + ' '; });
      plot.appendChild(el('path', { d: d.trim(), fill: 'none', stroke: ACCENT, 'stroke-width': 2.6 }));
      // guides across both panels
      for (const [ya, yb] of [[EY0 - 4, EY1], [114, FY1]]) plot.appendChild(el('line', { x1: px(tApp), y1: ya, x2: px(tApp), y2: yb, stroke: ACCENT, 'stroke-width': 1.2, 'stroke-dasharray': '3 3' }));
      text(px(tApp) + 4 > X1 - 70 ? px(tApp) - 4 : px(tApp) + 4, EY1 + 8, 'c-Fos appears', { fill: ACCENT, 'font-weight': 700, 'text-anchor': px(tApp) + 4 > X1 - 70 ? 'end' : 'start' });
      // shared time axis
      plot.appendChild(el('line', { x1: X0, y1: 232, x2: X1, y2: 232, stroke: INK, 'stroke-width': 1 }));
      for (let t = 0; t <= TMAX; t += 20) {
        plot.appendChild(el('line', { x1: px(t), y1: 232, x2: px(t), y2: 236, stroke: INK, 'stroke-width': 1 }));
        text(px(t), 246, String(t), { 'text-anchor': 'middle' });
      }
      text((X0 + X1) / 2, 258, 'time (relative units, not to scale)', { 'text-anchor': 'middle' });

      const onAtApp = erk(tApp) === 1;
      const long = onAtApp && peak >= LONG_LEVEL;
      let s: string;
      if (long) {
        s = `ERK was still on when c-Fos appeared, so the c-Fos was protected and built up. The cell reads this as a long signal.`;
      } else if (onAtApp) {
        s = `ERK was still on when c-Fos appeared, so c-Fos was protected, but ERK switched off before c-Fos reached the marked level. In this sketch it does not build up; a longer signal would.`;
      } else {
        s = `ERK was already off when c-Fos appeared, so c-Fos was made and then quickly lost. The cell reads this as a brief signal.`;
      }
      why.textContent = s + (long ? ' In this sketch, protection lasts only while ERK is on, so c-Fos falls again when ERK goes off; the lesson does not say how fast.' : '');
    }
    [durIn, delIn].forEach((s) => s.addEventListener('input', render));
    render();
  });
</script>

<style>
  .sld { padding: var(--ddp-space-3) var(--ddp-space-4) var(--ddp-space-4); margin: var(--ddp-space-5) 0; }
  .sld-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem; font-weight: 600; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); margin-bottom: var(--ddp-space-3); }
  .sld-chip { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 400; color: var(--ddp-color-muted); }
  .sld-svg { display: block; width: 100%; max-width: 560px; margin: 0 auto; height: auto; background: #fff; border: 1px solid var(--ddp-color-line); border-radius: 6px; }
  .sld-controls { display: grid; grid-template-columns: 1fr 1fr; gap: var(--ddp-space-2) var(--ddp-space-4); margin: var(--ddp-space-3) 0 var(--ddp-space-2); }
  .sld-slabel { display: flex; flex-direction: column; gap: 0.1rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .sld-slabel small { font-size: inherit; color: var(--ddp-color-muted); }
  .sld-slabel em { font-style: normal; font-weight: 700; color: var(--ddp-color-accent); font-family: var(--ddp-font-mono); }
  .sld-slabel input { accent-color: var(--ddp-color-accent); }
  .sld-why { margin: var(--ddp-space-2) 0 0; padding: var(--ddp-space-2) var(--ddp-space-3); background: color-mix(in srgb, var(--ddp-color-accent) 8%, transparent); border-radius: 6px; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); line-height: 1.5; min-height: 4.5em; }
  .sld-foot { margin: var(--ddp-space-3) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); border-left: 3px solid var(--ddp-color-secondary); padding-left: 0.55rem; }
  @media (max-width: 520px) { .sld-controls { grid-template-columns: 1fr; } }
</style>
