---
/**
 * PermeabilityCliff — makes selective permeability tangible as an energy balance,
 * not a sieve. Click a molecule to watch it cross (or bounce off) the bilayer; each
 * test drops a point onto a log-scale permeability plot spanning ~12 orders of
 * magnitude, so the student builds the cliff between small-nonpolar species (top)
 * and ions (bottom). A desolvation-cost slider acts only on charged species and
 * shows that a small change in the energy of shedding water moves permeability by
 * orders of magnitude; an aquaporin toggle gives water its one channel exception
 * while still excluding ions. Self-contained vanilla-TS Astro island, no deps.
 * Teaching-grade logP values, not lab measurements. Original, computed live.
 */
---

<figure class="pc card" data-permeability-cliff>
  <figcaption class="pc-head">The permeability cliff<span class="pc-chip">⚙ original · interactive</span></figcaption>

  <p class="pc-lead">Click a molecule to test it. It will try to cross the bilayer, and its permeability lands on the plot.</p>
  <div class="pc-chiprow" role="group" aria-label="Pick a molecule to test">
    <!-- chips injected by script -->
  </div>
  <p class="pc-legend" aria-hidden="true"><span style="--pc-c:#2e8b57">gas</span><span style="--pc-c:#2b6fb0">water</span><span style="--pc-c:#e57200">small polar</span><span style="--pc-c:#7a4fbf">aromatic</span><span style="--pc-c:#c0392b">charged</span></p>

  <div class="pc-grid">
    <section class="pc-col">
      <svg class="pc-svg" viewBox="0 0 320 220" role="img" aria-label="A lipid bilayer with a molecule attempting to cross from the top water layer to the bottom" data-stage></svg>
      <p class="pc-info" data-info role="status">Pick a molecule above and watch it try to cross.</p>
      <p class="pc-rate" data-rate>crossing rate: —</p>
    </section>

    <section class="pc-col">
      <svg class="pc-svg" viewBox="0 0 320 262" role="img" aria-label="Permeability coefficient on a log scale; each molecule you test adds a point in its own column" data-plot></svg>
      <p class="pc-info">Each molecule you test lands in its own column, fastest on the left. Test them all and the cliff opens up: every gridline down is 100× slower.</p>
    </section>
  </div>

  <div class="pc-controls">
    <label class="pc-slabel"><span>Desolvation cost (water debt): <em data-desolv-out>—</em> kJ/mol <span class="pc-hint" data-desolv-note>(select a charged species)</span></span>
      <input type="range" data-desolv min="0" max="90" step="5" value="60" disabled />
    </label>
    <label class="pc-check">
      <input type="checkbox" data-aqp /> add an aquaporin (water channel)
    </label>
  </div>

  <p class="pc-foot">Selective permeability is an energy balance, not a sieve. The same desolvation logic returns in the K⁺ selectivity filter — where Na⁺, too small to be paid back by eight carbonyl oxygens, owes a water debt the channel will not refund.</p>
</figure>

<script>
  const NS = 'http://www.w3.org/2000/svg';
  const LINE = '#c9d6d5', PRIMARY = '#17252a', INK = '#4b4b55';
  const KLASS_COLOR: Record<string, string> = {
    gas: '#2e8b57', water: '#2b6fb0', 'small-polar': '#e57200', aromatic: '#7a4fbf', ion: '#c0392b',
  };
  function el(name: string, attrs: Record<string, string | number>): SVGElement {
    const e = document.createElementNS(NS, name);
    for (const k in attrs) e.setAttribute(k, String(attrs[k]));
    return e;
  }
  type Klass = 'gas' | 'small-polar' | 'water' | 'ion' | 'aromatic';
  type Mol = { id: string; label: string; klass: Klass; logP: number; dGdesolv: number; rule: string };
  const MOLECULES: Mol[] = [
    { id: 'o2', label: 'O₂', klass: 'gas', logP: 0.5, dGdesolv: 0, rule: 'Small and nonpolar — a free pass straight through the core.' },
    { id: 'co2', label: 'CO₂', klass: 'gas', logP: 0.5, dGdesolv: 0, rule: 'Small and nonpolar — crosses freely, no water shell to shed.' },
    { id: 'h2o', label: 'H₂O', klass: 'water', logP: -2.5, dGdesolv: 0, rule: 'Tiny and only weakly polar — slips through slowly on its own.' },
    { id: 'etoh', label: 'ethanol', klass: 'small-polar', logP: -3.0, dGdesolv: 0, rule: 'Small polar — partly greasy, so it crosses, just not fast.' },
    { id: 'urea', label: 'urea', klass: 'small-polar', logP: -6, dGdesolv: 0, rule: 'Polar and hydrogen-bonding — pays a real price to cross.' },
    { id: 'glycerol', label: 'glycerol', klass: 'small-polar', logP: -6.5, dGdesolv: 0, rule: 'Three hydroxyls clinging to water — slow going.' },
    { id: 'glucose', label: 'glucose', klass: 'small-polar', logP: -8, dGdesolv: 0, rule: 'Large and heavily hydroxylated — needs a transporter in practice.' },
    { id: 'indole', label: 'indole', klass: 'aromatic', logP: -2, dGdesolv: 0, rule: 'The aromatic ring with no charge — crosses easily.' },
    { id: 'trp', label: 'tryptophan', klass: 'aromatic', logP: -7, dGdesolv: 50, rule: 'Same ring as indole, but charged groups stall it. Charge is the toll.' },
    { id: 'cl', label: 'Cl⁻', klass: 'ion', logP: -8.5, dGdesolv: 55, rule: 'Charged — wrapped in water it must shed. The core repels it.' },
    { id: 'k', label: 'K⁺', klass: 'ion', logP: -10, dGdesolv: 60, rule: 'Charged — bounces off the core; needs a channel to cross.' },
    { id: 'na', label: 'Na⁺', klass: 'ion', logP: -12, dGdesolv: 80, rule: 'The biggest water debt of all — essentially blocked.' },
  ];
  const R = 8.314, T = 310; // J/mol/K, body temperature
  const LOGP_MIN = -12, LOGP_MAX = 1;

  document.querySelectorAll<HTMLElement>('[data-permeability-cliff]').forEach((root) => {
    const chiprow = root.querySelector<HTMLElement>('.pc-chiprow')!;
    const stage = root.querySelector<SVGSVGElement>('[data-stage]')!;
    const plot = root.querySelector<SVGSVGElement>('[data-plot]')!;
    const info = root.querySelector<HTMLElement>('[data-info]')!;
    const rateOut = root.querySelector<HTMLElement>('[data-rate]')!;
    const desolv = root.querySelector<HTMLInputElement>('[data-desolv]')!;
    const desolvOut = root.querySelector<HTMLElement>('[data-desolv-out]')!;
    const desolvNote = root.querySelector<HTMLElement>('[data-desolv-note]')!;
    const aqp = root.querySelector<HTMLInputElement>('[data-aqp]')!;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let selected: Mol | null = null;
    const tested = new Map<string, { mol: Mol; effLogP: number }>();
    let animId = 0;

    function effectiveLogP(mol: Mol): number {
      let lp = mol.logP;
      // desolvation slider acts only on charged species
      if (mol.dGdesolv > 0) {
        const dGextra = (parseFloat(desolv.value) - mol.dGdesolv) * 1000; // J/mol
        lp = mol.logP - dGextra / (2.303 * R * T);
      }
      // aquaporin acts only on water
      if (mol.id === 'h2o' && aqp.checked) lp += 1.8;
      return lp;
    }

    // ---- chips ----
    MOLECULES.forEach((mol) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'pc-chipbtn';
      b.textContent = mol.label;
      b.setAttribute('data-chip', mol.id);
      b.setAttribute('aria-pressed', 'false');
      b.style.setProperty('--pc-c', KLASS_COLOR[mol.klass]);
      b.addEventListener('click', () => select(mol));
      chiprow.appendChild(b);
    });

    // Type scale: the SVGs shrink with their column; scale text up as they narrow.
    let k = 1;
    const fs = (n: number) => +(n * k).toFixed(1);
    function txt(svg: SVGSVGElement, x: number, y: number, str: string, size: number, fill: string, extra: Record<string, string | number> = {}) {
      const t = el('text', { x, y, 'font-size': fs(size), fill, ...extra }); t.textContent = str; svg.appendChild(t); return t;
    }

    // ---- bilayer stage ----
    const X_LANE = 174; // the molecule's path runs in the gap between two lipids
    function drawStage() {
      stage.replaceChildren();
      stage.appendChild(el('rect', { x: 0, y: 0, width: 320, height: 76, fill: '#eef5f6' }));
      stage.appendChild(el('rect', { x: 0, y: 144, width: 320, height: 76, fill: '#eef5f6' }));
      stage.appendChild(el('rect', { x: 0, y: 76, width: 320, height: 68, fill: '#fbf7ee' }));
      // lipids: head + two tails per leaflet, tails meeting at the midplane
      for (let i = 0; i < 12; i++) {
        const x = 20 + i * 28;
        for (const top of [true, false]) {
          const hy = top ? 72 : 148, dir = top ? 1 : -1;
          for (const off of [-2.6, 2.6]) stage.appendChild(el('line', { x1: x + off, y1: hy + dir * 4, x2: x + off, y2: 110 - dir * 1.5, stroke: PRIMARY, 'stroke-width': 1.4, opacity: 0.45 }));
          stage.appendChild(el('circle', { cx: x, cy: hy, r: 5.5, fill: PRIMARY }));
        }
      }
      txt(stage, 6, 110 + fs(9) * 0.35, 'oily core', 9, INK, { opacity: 0.85 });
      txt(stage, 6, 8 + fs(9), 'water (outside)', 9, INK, { opacity: 0.85 });
      txt(stage, 6, 214, 'water (inside)', 9, INK, { opacity: 0.85 });
    }

    const ease = (p: number) => (p < 0.5 ? 2 * p * p : 1 - Math.pow(-2 * p + 2, 2) / 2);
    function animateCrossing(mol: Mol) {
      cancelAnimationFrame(animId);
      drawStage();
      const lp = effectiveLogP(mol);
      const crosses = lp > -7.5; // ions / blocked species below this bounce off the core
      const puck = el('g', {}) as SVGGElement;
      const r = mol.label.length > 4 ? 15 : 12;
      const dot = el('circle', { cx: 0, cy: 0, r, fill: KLASS_COLOR[mol.klass], stroke: '#fff', 'stroke-width': 2 });
      const t = el('text', { x: 0, y: 3.2, 'text-anchor': 'middle', 'font-size': mol.label.length > 6 ? 7 : 9, fill: '#fff', 'font-weight': 700 }); t.textContent = mol.label;
      puck.appendChild(dot); puck.appendChild(t);
      stage.appendChild(puck);
      const X = X_LANE, yStart = 26, yEnd = 196, yCore = 104;
      const verdict = (ok: boolean) => txt(stage, X + r + 6, (ok ? yEnd : yStart) + fs(9.5) * 0.35, ok ? 'crossed ✓' : 'bounced back ✗', 9.5, ok ? '#1f6b43' : '#a02c20', { 'font-weight': 700 });
      if (reduceMotion) {
        puck.setAttribute('transform', `translate(${X},${crosses ? yEnd : yStart})`);
        verdict(crosses);
        return;
      }
      // duration: fast for high logP, slow for low
      const frac = (lp - LOGP_MIN) / (LOGP_MAX - LOGP_MIN); // 0..1
      const dur = 1700 - Math.max(0, Math.min(1, frac)) * 1300; // 400..1700 ms
      let start = 0;
      function step(ts: number) {
        if (!start) start = ts;
        const p = Math.min(1, (ts - start) / dur);
        let y: number;
        if (crosses) {
          y = yStart + ease(p) * (yEnd - yStart);
        } else {
          // descend into the head groups, stall at the edge of the core, then get pushed back out
          if (p < 0.5) y = yStart + ease(p / 0.5) * (yCore - 14 - yStart);
          else y = yCore - 14 - ease((p - 0.5) / 0.5) * (yCore - 14 - yStart);
        }
        puck.setAttribute('transform', `translate(${X},${y.toFixed(1)})`);
        if (p < 1) animId = requestAnimationFrame(step);
        else verdict(crosses);
      }
      animId = requestAnimationFrame(step);
    }

    // ---- log plot ----
    // Every molecule has its own column, ordered by its baseline permeability, so the
    // cliff appears as a staircase however the student clicks.
    const SLOT = [...MOLECULES].sort((a, b) => b.logP - a.logP).map((m) => m.id);
    const PL = 52, PR = 312, PT = 26, PB = 196;
    function logPToY(lp: number): number {
      const c = Math.max(LOGP_MIN, Math.min(LOGP_MAX, lp));
      return PT + ((LOGP_MAX - c) / (LOGP_MAX - LOGP_MIN)) * (PB - PT);
    }
    function drawPlot() {
      plot.replaceChildren();
      plot.appendChild(el('line', { x1: PL, y1: PT - 4, x2: PL, y2: PB + 2, stroke: INK, 'stroke-width': 1 }));
      txt(plot, 14, (PT + PB) / 2, 'permeability, log₁₀ P (cm/s)', 9, INK, { 'text-anchor': 'middle', transform: `rotate(-90 14 ${(PT + PB) / 2})` });
      for (let d = LOGP_MAX - 1; d >= LOGP_MIN; d -= 2) {
        const y = logPToY(d);
        plot.appendChild(el('line', { x1: PL, y1: y, x2: PR, y2: y, stroke: LINE, 'stroke-width': 0.7 }));
        txt(plot, PL - 4, y + fs(8.5) * 0.35, String(d), 8.5, INK, { 'text-anchor': 'end' });
      }
      txt(plot, PR, PT - 10, 'faster ↑', 8.5, INK, { 'text-anchor': 'end', opacity: 0.8 });
      if (!tested.size) txt(plot, (PL + PR) / 2, (PT + PB) / 2, 'test a molecule to add a point', 9.5, INK, { 'text-anchor': 'middle', opacity: 0.6 });
      const colW = (PR - PL - 16) / (SLOT.length - 1);
      // categorical x axis: one slanted label per column, dark once that molecule is tested
      plot.appendChild(el('line', { x1: PL, y1: PB + 2, x2: PR, y2: PB + 2, stroke: INK, 'stroke-width': 1 }));
      SLOT.forEach((id, i) => {
        const m = MOLECULES.find((mm) => mm.id === id)!;
        const x = PL + 8 + i * colW, on = tested.has(id);
        txt(plot, x + 2, PB + 8 + fs(8) * 0.5, m.label, 8, on ? PRIMARY : '#9a9aa3', { 'text-anchor': 'end', transform: `rotate(-50 ${x + 2} ${PB + 8 + fs(8) * 0.5})`, 'font-weight': on ? 700 : 400 });
      });
      tested.forEach(({ mol, effLogP }) => {
        const x = PL + 8 + SLOT.indexOf(mol.id) * colW;
        const y = logPToY(effLogP);
        const sel = selected && selected.id === mol.id;
        plot.appendChild(el('circle', { cx: x, cy: y, r: sel ? 6.5 : 5, fill: KLASS_COLOR[mol.klass], stroke: sel ? PRIMARY : '#fff', 'stroke-width': sel ? 1.6 : 1 }));
        plot.appendChild(el('line', { x1: x, y1: y + 6, x2: x, y2: PB + 2, stroke: KLASS_COLOR[mol.klass], 'stroke-width': 1, opacity: 0.35 }));
      });
    }

    const SUP: Record<string, string> = { '-': '⁻', '0': '⁰', '1': '¹', '2': '²', '3': '³', '4': '⁴', '5': '⁵', '6': '⁶', '7': '⁷', '8': '⁸', '9': '⁹' };
    function fmtRel(rel: number): string {
      if (rel >= 0.01) return rel.toFixed(2);
      let e = Math.floor(Math.log10(rel)), m = rel / Math.pow(10, e);
      if (Math.round(m) >= 10) { m /= 10; e += 1; }
      return `${m.toFixed(0)} × 10${String(e).split('').map((ch) => SUP[ch] ?? ch).join('')}`;
    }
    function updateRate() {
      if (!selected) { rateOut.textContent = 'crossing rate: —'; return; }
      const lp = effectiveLogP(selected);
      // relative to the fastest molecule TESTED so far
      let maxLp = lp, fastest = selected.label;
      tested.forEach(({ mol, effLogP }) => { if (effLogP > maxLp) { maxLp = effLogP; fastest = mol.label; } });
      rateOut.textContent = maxLp === lp
        ? `crossing rate: the fastest you have tested so far`
        : `crossing rate: ${fmtRel(Math.pow(10, lp - maxLp))} times as fast as ${fastest}`;
    }

    function select(mol: Mol) {
      selected = mol;
      root.querySelectorAll<HTMLButtonElement>('[data-chip]').forEach((b) =>
        b.setAttribute('aria-pressed', String(b.getAttribute('data-chip') === mol.id)));
      // enable/disable desolvation slider
      const charged = mol.dGdesolv > 0;
      desolv.disabled = !charged;
      desolvNote.textContent = charged ? '(drag to change this ion’s water debt)' : '(select a charged species)';
      if (charged) { desolv.value = String(mol.dGdesolv); }
      desolvOut.textContent = charged ? desolv.value : '—';
      info.textContent = mol.rule + (mol.id === 'h2o' && aqp.checked ? ' With an aquaporin open, water now races through — ions still cannot.' : '');
      const eff = effectiveLogP(mol);
      tested.set(mol.id, { mol, effLogP: eff });
      animateCrossing(mol);
      drawPlot();
      updateRate();
    }

    desolv.addEventListener('input', () => {
      if (!selected || selected.dGdesolv === 0) return;
      desolvOut.textContent = desolv.value;
      const eff = effectiveLogP(selected);
      tested.set(selected.id, { mol: selected, effLogP: eff });
      info.textContent = `${selected.label}: water debt ${desolv.value} kJ/mol → log P ${eff.toFixed(1)}. A few kJ/mol moves permeability by orders of magnitude.`;
      animateCrossing(selected);
      drawPlot();
      updateRate();
    });
    aqp.addEventListener('change', () => {
      // re-test water if it has been tested, and refresh selection text
      if (tested.has('h2o')) {
        const water = MOLECULES.find((m) => m.id === 'h2o')!;
        tested.set('h2o', { mol: water, effLogP: effectiveLogP(water) });
        drawPlot();
      }
      if (selected && selected.id === 'h2o') select(selected);
    });

    const fit = () => { const w = plot.getBoundingClientRect().width || 320; const nk = Math.min(1.5, Math.max(1, 380 / w)); if (Math.abs(nk - k) > 0.02) { k = nk; drawPlot(); if (!selected) drawStage(); } };
    if ('ResizeObserver' in window) new ResizeObserver(fit).observe(plot);
    drawStage();
    drawPlot();
    fit();
  });
</script>

<style is:global>
  .pc { padding: var(--ddp-space-3) var(--ddp-space-4) var(--ddp-space-4); margin: var(--ddp-space-5) 0; }
  .pc .pc-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem; font-weight: 600; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); margin-bottom: var(--ddp-space-2); }
  .pc .pc-chip { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 400; color: var(--ddp-color-muted); }
  .pc .pc-chiprow { display: flex; flex-wrap: wrap; gap: 0.3rem; margin-bottom: var(--ddp-space-3); }
  .pc .pc-chipbtn { font-family: inherit; font-size: var(--ddp-text-xs); border: 1px solid var(--ddp-color-line); background: #fff; color: var(--ddp-color-ink-soft); border-radius: 999px; padding: 0.22rem 0.6rem; cursor: pointer; border-left: 3px solid var(--pc-c, #888); }
  .pc .pc-chipbtn:hover { border-color: var(--pc-c, var(--ddp-color-accent)); color: var(--ddp-color-primary); }
  .pc .pc-chipbtn[aria-pressed='true'] { background: color-mix(in srgb, var(--pc-c, var(--ddp-color-accent)) 16%, #fff); color: var(--ddp-color-primary); font-weight: 700; border-color: var(--pc-c, var(--ddp-color-accent)); }
  .pc .pc-grid { display: grid; grid-template-columns: 1fr; gap: var(--ddp-space-3); }
  @media (min-width: 640px) { .pc .pc-grid { grid-template-columns: 1fr 1fr; } }
  .pc .pc-svg { width: 100%; height: auto; background: #fff; border: 1px solid var(--ddp-color-line); border-radius: 6px; }
  .pc .pc-info { margin: var(--ddp-space-1) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); line-height: 1.45; min-height: 2.4em; }
  .pc .pc-rate { margin: 0.2rem 0 0; font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); color: var(--ddp-color-primary); font-weight: 700; }
  .pc .pc-controls { display: flex; flex-wrap: wrap; align-items: center; gap: var(--ddp-space-2) var(--ddp-space-4); margin: var(--ddp-space-3) 0 var(--ddp-space-2); }
  .pc .pc-slabel { display: flex; flex-direction: column; gap: 0.15rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); flex: 1 1 240px; }
  .pc .pc-slabel em { font-style: normal; font-weight: 700; color: var(--ddp-color-accent); font-family: var(--ddp-font-mono); }
  .pc .pc-slabel input { accent-color: var(--ddp-color-accent); }
  .pc .pc-slabel input:disabled { opacity: 0.4; }
  .pc .pc-hint { color: var(--ddp-color-muted); }
  .pc .pc-check { display: flex; align-items: center; gap: 0.35rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .pc .pc-check input { accent-color: var(--ddp-color-accent); }
  .pc .pc-lead { margin: 0 0 var(--ddp-space-2); font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .pc .pc-legend { display: flex; flex-wrap: wrap; gap: 0.2rem 0.8rem; margin: calc(-1 * var(--ddp-space-2)) 0 var(--ddp-space-3); font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .pc .pc-legend span::before { content: ''; display: inline-block; width: 0.6em; height: 0.6em; border-radius: 50%; background: var(--pc-c); margin-right: 0.3em; vertical-align: 0.05em; }
  .pc .pc-chipbtn:focus-visible { outline: 2px solid var(--ddp-color-accent); outline-offset: 2px; }
  .pc .pc-svg { display: block; }
  .pc .pc-foot { margin: var(--ddp-space-3) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); border-left: 3px solid var(--ddp-color-secondary); padding-left: 0.55rem; }
</style>
