---
/**
 * MigrationThenSampling — one generation of the lesson's worked problem. Step 1: residents
 * (allele frequency 0.60) are mixed with immigrants (0.20), a deterministic weighted average
 * p = (1 - m)(0.60) + m(0.20). Step 2: the offspring are formed by randomly sampling 2N gene
 * copies, repeated many times; a histogram shows where the offspring frequencies fall, with the
 * expected mean p and expected standard deviation sqrt(p(1 - p)/2N) marked beside the observed.
 * Neutral Wright-Fisher sketch; no selection. Self-contained vanilla-TS Astro island. Original.
 */
---

<figure class="mts card" data-mts>
  <figcaption class="mts-head">One generation: migration, then sampling<span class="mts-chip">⚙ original · interactive</span></figcaption>

  <svg class="mts-svg" viewBox="0 0 360 336" role="img" aria-label="Top: a breeding pool of residents and immigrants mixed to give a frequency p. Bottom: a histogram of offspring allele frequencies from repeated random samples of 2N gene copies, with the expected mean and standard deviation marked" data-plot></svg>

  <div class="mts-controls">
    <label class="mts-slabel"><span>Immigrants in the breeding pool, m <em data-out="m">0.10</em></span>
      <input type="range" data-in="m" min="0" max="0.5" step="0.05" value="0.1" />
    </label>
    <fieldset class="mts-nset">
      <legend>Offspring number N (diploid, so 2N gene copies)</legend>
      <label><input type="radio" name="mts-n" value="10" /> 10</label>
      <label><input type="radio" name="mts-n" value="25" /> 25</label>
      <label><input type="radio" name="mts-n" value="50" /> 50</label>
      <label><input type="radio" name="mts-n" value="100" checked /> 100</label>
      <label><input type="radio" name="mts-n" value="200" /> 200</label>
    </fieldset>
    <button type="button" class="mts-btn" data-resample>Resample</button>
  </div>

  <table class="mts-table">
    <caption class="mts-cap">Expected from the rules, beside observed in this run of <span data-trials>500</span> resamples</caption>
    <thead><tr><th scope="col"></th><th scope="col">Expected</th><th scope="col">Observed</th></tr></thead>
    <tbody>
      <tr><th scope="row">Mean offspring frequency</th><td data-e-mean></td><td data-o-mean></td></tr>
      <tr><th scope="row">Standard deviation</th><td data-e-sd></td><td data-o-sd></td></tr>
      <tr><th scope="row">Copies of the allele out of 2N</th><td data-e-copies></td><td data-o-copies></td></tr>
    </tbody>
  </table>
  <p class="mts-calc" data-calc></p>

  <p class="mts-why" data-why role="status"></p>

  <p class="mts-assume"><strong>In this sketch:</strong> one generation; neutral Wright-Fisher, with 2N gene copies drawn at random from the mixed pool; no selection, no mutation, no further migration during sampling; resident 0.60 and immigrant 0.20 are the lesson’s illustrative numbers. m (0 to 0.5) and N (10 to 200) are free settings here; the lesson works m = 0.10 with N = 100 and N = 10. 500 resamples is this sketch’s choice; the lesson says “many times”.</p>
  <p class="mts-foot">Migration moves the mean, deterministically; drift spreads the outcomes around it, in neither direction, and the spread shrinks as the number of gene copies grows. This is a sketch of the logic, not a prediction for a real population.</p>
</figure>

<script>
  const NS = 'http://www.w3.org/2000/svg';
  const ACCENT = '#0e7c86', ORANGE = '#e57200', INK = '#4b4b55', FAINT = '#b9b9c2', PALE = '#d6ecee';
  const P_RES = 0.6, P_IMM = 0.2, TRIALS = 500;
  const BIN: Record<number, number> = { 10: 0.05, 25: 0.04, 50: 0.02, 100: 0.025, 200: 0.025 };
  const MINUS = '−';
  function el(name: string, attrs: Record<string, string | number>): SVGElement {
    const e = document.createElementNS(NS, name);
    for (const k in attrs) e.setAttribute(k, String(attrs[k]));
    return e;
  }
  function txt(parent: SVGElement, x: number, y: number, s: string, opts: Record<string, string | number> = {}) {
    const t = el('text', { x, y, 'font-size': 10.5, fill: INK, ...opts });
    t.textContent = s;
    parent.appendChild(t);
  }
  const f2 = (x: number) => x.toFixed(2);
  const f3 = (x: number) => x.toFixed(3);
  const sgn = (x: number) => (Math.abs(x) < 1e-9 ? '0.00' : (x < 0 ? MINUS : '+') + Math.abs(x).toFixed(2));
  const trim = (x: number) => String(Number(x.toFixed(2)));

  document.querySelectorAll<HTMLElement>('[data-mts]').forEach((root) => {
    const plot = root.querySelector<SVGSVGElement>('[data-plot]')!;
    const mIn = root.querySelector<HTMLInputElement>('[data-in="m"]')!;
    const mOut = root.querySelector<HTMLElement>('[data-out="m"]')!;
    const nIns = Array.from(root.querySelectorAll<HTMLInputElement>('input[name="mts-n"]'));
    const o = (s: string) => root.querySelector<HTMLElement>(s)!;
    const eMean = o('[data-e-mean]'), oMean = o('[data-o-mean]'), eSd = o('[data-e-sd]'), oSd = o('[data-o-sd]');
    const eCopies = o('[data-e-copies]'), oCopies = o('[data-o-copies]');
    const calc = o('[data-calc]'), why = o('[data-why]');
    (o('[data-trials]')).textContent = String(TRIALS);

    let freqs: number[] = []; // one offspring frequency per resample, in copies/2N
    let sampledKey = '';

    const getN = () => parseInt((nIns.find((r) => r.checked) ?? nIns[3]).value, 10);
    const getM = () => Math.round(parseFloat(mIn.value) * 100) / 100;

    function resample(p: number, n: number) {
      const copies = 2 * n;
      freqs = [];
      for (let t = 0; t < TRIALS; t++) {
        let c = 0;
        for (let i = 0; i < copies; i++) if (Math.random() < p) c++;
        freqs.push(c / copies);
      }
      sampledKey = `${p.toFixed(4)}|${n}`;
    }

    // plot geometry
    const X0 = 34, X1 = 346, W = X1 - X0;
    const HY0 = 176, HY1 = 290;
    const px = (f: number) => X0 + f * W;

    function render(forceSample: boolean) {
      const m = getM();
      const n = getN();
      const copies = 2 * n;
      const p = (1 - m) * P_RES + m * P_IMM;
      const shift = p - P_RES;
      const sdE = Math.sqrt((p * (1 - p)) / copies);
      mOut.textContent = f2(m);
      if (forceSample || sampledKey !== `${p.toFixed(4)}|${n}`) resample(p, n);

      const mean = freqs.reduce((a, b) => a + b, 0) / freqs.length;
      const sdO = Math.sqrt(freqs.reduce((a, b) => a + (b - mean) * (b - mean), 0) / freqs.length);

      plot.replaceChildren();

      // ---- Step 1: the breeding pool
      txt(plot, X0, 12, 'Step 1 · migration mixes the pool', { 'font-weight': 700 });
      const wRes = (1 - m) * W, wImm = m * W;
      plot.appendChild(el('rect', { x: X0, y: 20, width: wRes, height: 22, fill: PALE, stroke: INK, 'stroke-width': 0.8 }));
      plot.appendChild(el('rect', { x: X0, y: 20, width: wRes * P_RES, height: 22, fill: ACCENT }));
      if (m > 0) {
        plot.appendChild(el('rect', { x: X0 + wRes, y: 20, width: wImm, height: 22, fill: '#fbe3cc', stroke: INK, 'stroke-width': 0.8 }));
        plot.appendChild(el('rect', { x: X0 + wRes, y: 20, width: wImm * P_IMM, height: 22, fill: ORANGE }));
      }
      txt(plot, X0, 55, `residents ${f2(1 - m)} · allele ${f2(P_RES)} (shaded = the allele)`);
      txt(plot, X1, 67, m > 0 ? `immigrants m = ${f2(m)} · allele frequency ${f2(P_IMM)}` : 'immigrants m = 0.00 · none arrive', { 'text-anchor': 'end' });

      txt(plot, X0, 82, 'frequency after mixing, p');
      plot.appendChild(el('rect', { x: X0, y: 87, width: W, height: 20, fill: '#fff', stroke: INK, 'stroke-width': 0.8 }));
      plot.appendChild(el('rect', { x: X0, y: 87, width: W * p, height: 20, fill: ACCENT }));
      plot.appendChild(el('line', { x1: px(P_RES), y1: 84, x2: px(P_RES), y2: 111, stroke: INK, 'stroke-width': 1, 'stroke-dasharray': '3 2' }));
      txt(plot, X1, 82, `dashed: resident ${f2(P_RES)}`, { 'text-anchor': 'end' });
      txt(plot, X0, 123, `p = ${f2(p)} · shift ${sgn(shift)}, same every time`, { 'font-weight': 700, fill: ORANGE });

      // ---- Step 2: histogram
      txt(plot, X0, 138, `Step 2 · sample ${copies} gene copies, ${TRIALS} times`, { 'font-weight': 700 });
      const w = BIN[n];
      const nb = Math.round(1 / w) + 1;
      const counts = new Array(nb).fill(0);
      for (const f of freqs) counts[Math.min(nb - 1, Math.floor(f / w + 0.5 + 1e-9))]++;
      const cmax = Math.max(...counts, 1);
      const py = (c: number) => HY1 - (c / cmax) * (HY1 - HY0 - 4);

      // expected ± 1 SD band
      const lo = Math.max(0, p - sdE), hi = Math.min(1, p + sdE);
      plot.appendChild(el('rect', { x: px(lo), y: HY0, width: px(hi) - px(lo), height: HY1 - HY0, fill: ORANGE, 'fill-opacity': 0.14 }));

      counts.forEach((c, i) => {
        if (c === 0) return;
        plot.appendChild(el('rect', { x: px(Math.max(0, (i - 0.5) * w)) + 0.4, y: py(c), width: Math.max(0.6, (px(Math.min(1, (i + 0.5) * w)) - px(Math.max(0, (i - 0.5) * w))) - 0.8), height: HY1 - py(c), fill: ACCENT, 'fill-opacity': 0.85 }));
      });

      // axes
      plot.appendChild(el('line', { x1: X0, y1: HY0, x2: X0, y2: HY1, stroke: INK, 'stroke-width': 1 }));
      plot.appendChild(el('line', { x1: X0, y1: HY1, x2: X1, y2: HY1, stroke: INK, 'stroke-width': 1 }));
      for (const f of [0, 0.2, 0.4, 0.6, 0.8, 1]) {
        plot.appendChild(el('line', { x1: px(f), y1: HY1, x2: px(f), y2: HY1 + 3, stroke: INK, 'stroke-width': 1 }));
        txt(plot, px(f), HY1 + 13, f2(f), { 'text-anchor': 'middle' });
      }
      txt(plot, X0 - 4, HY0 + 8, String(cmax), { 'text-anchor': 'end' });
      txt(plot, (X0 + X1) / 2, HY1 + 25, 'offspring allele frequency (copies / 2N)', { 'text-anchor': 'middle' });

      // markers
      if (m > 0) {
        plot.appendChild(el('line', { x1: px(P_RES), y1: 159, x2: px(P_RES), y2: HY1, stroke: INK, 'stroke-width': 1, 'stroke-dasharray': '3 2' }));
        txt(plot, px(P_RES) + 3, 157, `resident ${f2(P_RES)}`);
        plot.appendChild(el('line', { x1: px(p), y1: 169, x2: px(p), y2: HY1, stroke: ORANGE, 'stroke-width': 2 }));
        txt(plot, px(p) - 3, 168, `expected p = ${f2(p)}`, { 'text-anchor': 'end', fill: ORANGE, 'font-weight': 700 });
      } else {
        plot.appendChild(el('line', { x1: px(p), y1: 159, x2: px(p), y2: HY1, stroke: ORANGE, 'stroke-width': 2 }));
        txt(plot, px(p) - 4, 157, `expected p = ${f2(p)} (no shift)`, { 'text-anchor': 'end', fill: ORANGE, 'font-weight': 700 });
      }

      // legend row
      plot.appendChild(el('rect', { x: X0, y: 319, width: 9, height: 9, fill: ACCENT, 'fill-opacity': 0.85 }));
      txt(plot, X0 + 13, 327, 'resamples (count)');
      plot.appendChild(el('line', { x1: X0 + 108, y1: 323.5, x2: X0 + 120, y2: 323.5, stroke: ORANGE, 'stroke-width': 2 }));
      txt(plot, X0 + 124, 327, 'expected mean');
      plot.appendChild(el('rect', { x: X0 + 206, y: 319, width: 12, height: 9, fill: ORANGE, 'fill-opacity': 0.14, stroke: ORANGE, 'stroke-width': 0.5 }));
      txt(plot, X0 + 222, 327, 'expected ±1 SD');

      // ---- readouts
      eMean.textContent = f3(p);
      oMean.textContent = f3(mean);
      eSd.textContent = f3(sdE);
      oSd.textContent = f3(sdO);
      eCopies.textContent = `${trim(copies * p)} (${copies} × ${f2(p)})`;
      oCopies.textContent = trim(mean * copies);
      calc.textContent = `p = (1 ${MINUS} ${f2(m)}) × ${f2(P_RES)} + ${f2(m)} × ${f2(P_IMM)} = ${f2(p)}.   SD = √(${f2(p)} × ${f2(1 - p)} / ${copies}) = ${f3(sdE)}.`;

      const migrationSentence = m === 0
        ? `With no immigrants (m = 0) there is no shift: p stays at ${f2(P_RES)}.`
        : `Migration moved the frequency from ${f2(P_RES)} to ${f2(p)}, a shift of ${sgn(shift)} that would happen the same way every time.`;
      const driftSentence = `Sampling ${copies} gene copies then scatters the offspring around ${f2(p)} with a standard deviation of about ${f3(sdE)}, with no push in either direction: the observed mean is ${f3(mean)}, close to ${f3(p)} but not necessarily equal, because ${TRIALS} resamples are themselves a sample.`;
      const nSentence = n <= 25
        ? ' A small N gives a wide spread.'
        : n >= 100
          ? ' A larger N gives a narrower spread, though not zero.'
          : '';
      why.textContent = `${migrationSentence} ${driftSentence}${nSentence}`;
    }

    mIn.addEventListener('input', () => render(false));
    nIns.forEach((r) => r.addEventListener('change', () => render(false)));
    o('[data-resample]').addEventListener('click', () => render(true));
    render(true);
  });
</script>

<style>
  .mts { padding: var(--ddp-space-3) var(--ddp-space-4) var(--ddp-space-4); margin: var(--ddp-space-5) 0; }
  .mts-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem; font-weight: 600; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); margin-bottom: var(--ddp-space-3); }
  .mts-chip { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 400; color: var(--ddp-color-muted); }
  .mts-svg { display: block; width: 100%; max-width: 560px; margin: 0 auto; height: auto; background: #fff; border: 1px solid var(--ddp-color-line); border-radius: 6px; }
  .mts-controls { display: flex; flex-wrap: wrap; align-items: flex-end; gap: var(--ddp-space-2) var(--ddp-space-4); margin: var(--ddp-space-3) 0 var(--ddp-space-2); }
  .mts-slabel { display: flex; flex-direction: column; gap: 0.1rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); flex: 1 1 14rem; }
  .mts-slabel em { font-style: normal; font-weight: 700; color: var(--ddp-color-accent); font-family: var(--ddp-font-mono); }
  .mts-slabel input { accent-color: var(--ddp-color-accent); }
  .mts-nset { border: 0; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.2rem 0.8rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); flex: 1 1 14rem; }
  .mts-nset legend { padding: 0; margin-bottom: 0.15rem; }
  .mts-nset label { display: inline-flex; align-items: center; gap: 0.25rem; }
  .mts-nset input { accent-color: var(--ddp-color-accent); }
  .mts-btn { font: inherit; font-size: var(--ddp-text-xs); font-weight: 600; padding: 0.4rem 0.9rem; border: 1px solid var(--ddp-color-accent); background: var(--ddp-color-accent); color: #fff; border-radius: 6px; cursor: pointer; }
  .mts-btn:hover { filter: brightness(1.08); }
  .mts-btn:focus-visible, .mts-slabel input:focus-visible, .mts-nset input:focus-visible { outline: 2px solid var(--ddp-color-secondary); outline-offset: 2px; }
  .mts-table { width: 100%; border-collapse: collapse; margin: var(--ddp-space-2) 0; font-size: var(--ddp-text-xs); background: color-mix(in srgb, var(--ddp-color-accent) 8%, transparent); border-radius: 6px; }
  .mts-cap { caption-side: top; text-align: left; color: var(--ddp-color-muted); padding: 0 0 0.25rem; }
  .mts-table th, .mts-table td { text-align: left; padding: 0.25rem 0.5rem; font-weight: 400; color: var(--ddp-color-ink-soft); }
  .mts-table thead th { font-weight: 600; color: var(--ddp-color-primary); }
  .mts-table td { font-family: var(--ddp-font-mono); font-weight: 700; color: var(--ddp-color-primary); }
  .mts-calc { margin: 0 0 var(--ddp-space-2); font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); overflow-wrap: anywhere; }
  .mts-why { margin: 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); line-height: 1.5; min-height: 6em; }
  .mts-assume { margin: var(--ddp-space-2) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .mts-foot { margin: var(--ddp-space-3) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); border-left: 3px solid var(--ddp-color-secondary); padding-left: 0.55rem; }
  @media (max-width: 480px) { .mts-why { min-height: 11em; } }
</style>
