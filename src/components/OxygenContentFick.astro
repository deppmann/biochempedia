---
/**
 * OxygenContentFick — oxygen content of arterial and mixed venous blood from the lesson's
 * equation, content = (1.34 x hemoglobin x saturation) + (0.003 x PO2), and oxygen use from
 * the Fick principle, use = cardiac output x (arterial content - venous content).
 * Original. Self-contained vanilla-TS Astro island. No dissociation curve is drawn: the
 * lesson gives no equation for it.
 */
---

<figure class="ofk card" data-ofk>
  <figcaption class="ofk-head">Oxygen content and the Fick principle<span class="ofk-chip">⚙ original · interactive</span></figcaption>

  <svg class="ofk-svg" viewBox="0 0 360 256" role="img" aria-label="Two stacked bars of arterial and mixed venous oxygen content in mL per dL, each split into hemoglobin-bound and dissolved oxygen, and a column of oxygen delivered per minute split into used and unused" data-plot></svg>

  <div class="ofk-controls">
    <label class="ofk-slabel"><span>Hemoglobin <em data-out="hb">15</em> g per dL</span>
      <input type="range" data-in="hb" min="0" max="20" step="1" value="15" />
    </label>
    <label class="ofk-slabel"><span>Mixed venous saturation <em data-out="sv">75</em>%</span>
      <input type="range" data-in="sv" min="40" max="95" step="1" value="75" />
    </label>
    <label class="ofk-slabel"><span>Cardiac output <em data-out="co">5.0</em> L per min</span>
      <input type="range" data-in="co" min="2.5" max="10" step="0.5" value="5" />
    </label>
  </div>

  <dl class="ofk-readout">
    <div><dt>Arterial (saturation 98%, PO2 100 mmHg)</dt><dd data-r-art></dd></div>
    <div><dt>Mixed venous (PO2 40 mmHg)</dt><dd data-r-ven></dd></div>
    <div><dt>Difference, and share used</dt><dd data-r-diff></dd></div>
    <div><dt>Delivery (cardiac output x arterial content)</dt><dd data-r-del></dd></div>
    <div><dt>Oxygen use (Fick principle)</dt><dd data-r-use></dd></div>
    <div><dt>Dissolved share of arterial content</dt><dd data-r-dis></dd></div>
  </dl>

  <p class="ofk-why" data-why role="status"></p>

  <p class="ofk-assume"><strong>In this sketch:</strong> an illustrative adult human at rest, steady state, 1.34 mL O2 per g of fully saturated hemoglobin (a common working value; the theoretical figure is near 1.39), 0.003 mL per dL per mmHg dissolved, arterial saturation 98% and PO2 100 mmHg, and venous PO2 held at 40 mmHg whatever the venous saturation. Slider settings other than the worked values are not claims about any person.</p>

  <p class="ofk-foot">Oxygen content is bound plus dissolved, and oxygen use is cardiac output times the arterial-venous difference. Lower pH or more carbon dioxide (the Bohr effect) shifts the curve right, and higher temperature and more BPG are separate effects that also raise P50; at the same PO2 the blood then holds less oxygen. No curve is drawn because the lesson gives no equation for it.</p>
</figure>

<script>
  const NS = 'http://www.w3.org/2000/svg';
  const ACCENT = '#0e7c86', ORANGE = '#e57200', INK = '#4b4b55', FAINT = '#b9b9c2', PALE = '#d9ecee';
  function el(name: string, attrs: Record<string, string | number>): SVGElement {
    const e = document.createElementNS(NS, name);
    for (const k in attrs) e.setAttribute(k, String(attrs[k]));
    return e;
  }
  const r2 = (x: number) => Math.round((x + 1e-9) * 100) / 100;
  const f2 = (x: number) => r2(x).toFixed(2);
  const thousands = (x: number) => Math.round(x).toLocaleString('en-US');

  const KBIND = 1.34, KDIS = 0.003, SAT_A = 0.98, PO2_A = 100, PO2_V = 40;

  document.querySelectorAll<HTMLElement>('[data-ofk]').forEach((root) => {
    const plot = root.querySelector<SVGSVGElement>('[data-plot]');
    const hbIn = root.querySelector<HTMLInputElement>('[data-in="hb"]');
    const svIn = root.querySelector<HTMLInputElement>('[data-in="sv"]');
    const coIn = root.querySelector<HTMLInputElement>('[data-in="co"]');
    const hbOut = root.querySelector<HTMLElement>('[data-out="hb"]');
    const svOut = root.querySelector<HTMLElement>('[data-out="sv"]');
    const coOut = root.querySelector<HTMLElement>('[data-out="co"]');
    const rArt = root.querySelector<HTMLElement>('[data-r-art]');
    const rVen = root.querySelector<HTMLElement>('[data-r-ven]');
    const rDiff = root.querySelector<HTMLElement>('[data-r-diff]');
    const rDel = root.querySelector<HTMLElement>('[data-r-del]');
    const rUse = root.querySelector<HTMLElement>('[data-r-use]');
    const rDis = root.querySelector<HTMLElement>('[data-r-dis]');
    const why = root.querySelector<HTMLElement>('[data-why]');
    if (!plot || !hbIn || !svIn || !coIn || !hbOut || !svOut || !coOut || !rArt || !rVen || !rDiff || !rDel || !rUse || !rDis || !why) return;
    const svg = plot;

    const Y0 = 36, Y1 = 196, CMAX = 28, DMAX = 2800; // top and bottom of plot; scale maxima
    const yc = (v: number) => Y1 - (v / CMAX) * (Y1 - Y0);
    const yd = (v: number) => Y1 - (v / DMAX) * (Y1 - Y0);

    function text(x: number, y: number, s: string, opts: Record<string, string | number> = {}) {
      const t = el('text', Object.assign({ x, y, 'font-size': 9, fill: INK, 'text-anchor': 'middle' }, opts));
      t.textContent = s;
      svg.appendChild(t);
    }

    function render() {
      const hb = parseFloat(hbIn!.value);
      const sv = parseInt(svIn!.value, 10);
      const co = parseFloat(coIn!.value);
      hbOut!.textContent = String(hb);
      svOut!.textContent = String(sv);
      coOut!.textContent = co.toFixed(1);

      const aBound = r2(KBIND * hb * SAT_A), aDis = r2(KDIS * PO2_A), aTot = r2(aBound + aDis);
      const vBound = r2(KBIND * hb * (sv / 100)), vDis = r2(KDIS * PO2_V), vTot = r2(vBound + vDis);
      const diff = r2(aTot - vTot);
      const extr = (diff / aTot) * 100;
      const dl = co * 10; // dL per min
      const delivery = dl * aTot, use = dl * diff;
      const disShare = (aDis / aTot) * 100;
      const extrTxt = extr >= 10 ? Math.round(extr) + '%' : extr.toFixed(1) + '%';

      svg.replaceChildren();
      // axes
      svg.appendChild(el('line', { x1: 44, y1: Y0, x2: 44, y2: Y1, stroke: INK, 'stroke-width': 1 }));
      svg.appendChild(el('line', { x1: 44, y1: Y1, x2: 200, y2: Y1, stroke: INK, 'stroke-width': 1 }));
      for (const v of [0, 5, 10, 15, 20, 25]) {
        svg.appendChild(el('line', { x1: 44, y1: yc(v), x2: 200, y2: yc(v), stroke: FAINT, 'stroke-width': 0.6, 'stroke-dasharray': '2 3' }));
        text(40, yc(v) + 3, String(v), { 'text-anchor': 'end' });
      }
      text(4, 14, 'mL O2 per dL of blood', { 'text-anchor': 'start', 'font-weight': 700 });
      text(268, 14, 'mL O2 per min', { 'font-weight': 700 });

      // stacked bars
      const bars: [number, number, number, number, string, string, string][] = [
        [52, aBound, aDis, aTot, 'arterial', hb === 0 ? 'no hemoglobin' : 'sat 98%', 'PO2 100'],
        [132, vBound, vDis, vTot, 'mixed venous', hb === 0 ? 'no hemoglobin' : 'sat ' + sv + '%', 'PO2 40'],
      ];
      for (const [x, b, d, tot, name, l1, l2] of bars) {
        const hBound = (b / CMAX) * (Y1 - Y0);
        const hDis = Math.max((d / CMAX) * (Y1 - Y0), 2);
        if (hBound > 0) svg.appendChild(el('rect', { x, y: Y1 - hBound, width: 60, height: hBound, fill: ACCENT }));
        svg.appendChild(el('rect', { x, y: Y1 - hBound - hDis, width: 60, height: hDis, fill: ORANGE }));
        if (hBound > 22) text(x + 30, Y1 - hBound / 2 + 3, f2(b), { fill: '#fff', 'font-weight': 700 });
        text(x + 30, Y1 - hBound - hDis - 4, f2(tot), { 'font-weight': 700 });
        text(x + 30, 209, name);
        text(x + 30, 220, l1);
        text(x + 30, 231, l2);
      }

      // delivery column
      const cx = 240, cw = 56;
      if (use > 0) svg.appendChild(el('rect', { x: cx, y: yd(use), width: cw, height: Y1 - yd(use), fill: ACCENT }));
      svg.appendChild(el('rect', { x: cx, y: yd(delivery), width: cw, height: Math.max(yd(use) - yd(delivery), 0.5), fill: PALE, stroke: ACCENT, 'stroke-width': 1 }));
      svg.appendChild(el('line', { x1: cx - 4, y1: Y1, x2: cx + cw + 4, y2: Y1, stroke: INK, 'stroke-width': 1 }));
      text(cx + cw / 2, yd(delivery) - 4, thousands(delivery), { 'font-weight': 700 });
      text(cx + cw / 2, 209, 'delivered');
      text(cx + cw / 2, 220, 'used + returned');
      text(cx + cw / 2, 231, co.toFixed(1) + ' L per min');
      // right-hand labels
      const usedMid = (yd(use) + Y1) / 2, retMid = (yd(use) + yd(delivery)) / 2;
      if (Y1 - yd(use) > 12) text(cx + cw + 4, usedMid + 3, 'used ' + thousands(use), { 'text-anchor': 'start', 'font-weight': 700, fill: ACCENT });
      if (yd(use) - yd(delivery) > 12) text(cx + cw + 4, retMid + 3, 'back ' + thousands(delivery - use), { 'text-anchor': 'start' });

      // legend
      svg.appendChild(el('rect', { x: 52, y: 242, width: 9, height: 9, fill: ACCENT }));
      text(65, 250, 'bound to hemoglobin', { 'text-anchor': 'start' });
      svg.appendChild(el('rect', { x: 170, y: 242, width: 9, height: 9, fill: ORANGE }));
      text(183, 250, 'dissolved', { 'text-anchor': 'start' });
      svg.appendChild(el('rect', { x: 240, y: 242, width: 9, height: 9, fill: PALE, stroke: ACCENT, 'stroke-width': 1 }));
      text(253, 250, 'not used', { 'text-anchor': 'start' });

      // readouts, with the arithmetic
      rArt!.textContent = `${KBIND} x ${hb} x 0.98 = ${f2(aBound)} bound + 0.003 x ${PO2_A} = ${f2(aDis)} dissolved = ${f2(aTot)} mL per dL`;
      rVen!.textContent = `${KBIND} x ${hb} x ${(sv / 100).toFixed(2)} = ${f2(vBound)} bound + 0.003 x ${PO2_V} = ${f2(vDis)} dissolved = ${f2(vTot)} mL per dL`;
      rDiff!.textContent = `${f2(aTot)} - ${f2(vTot)} = ${f2(diff)} mL per dL; ${f2(diff)} / ${f2(aTot)} = ${extrTxt}`;
      rDel!.textContent = `${co.toFixed(1)} L per min = ${dl} dL per min; ${dl} x ${f2(aTot)} = ${thousands(delivery)} mL per min`;
      rUse!.textContent = `${dl} x ${f2(diff)} = ${thousands(use)} mL per min`;
      rDis!.textContent = `${f2(aDis)} / ${f2(aTot)} = ${disShare.toFixed(1)}%`;

      // status
      let s: string;
      if (hb === 0) {
        s = `With no hemoglobin the blood is plasma alone: ${f2(aDis)} mL per dL, which is ${r2(aDis * 10).toFixed(0)} mL per L (the lesson’s “about 3 mL”), against about ${thousands(r2(KBIND * 15 * SAT_A + aDis) * 10)} mL per L at 15 g per dL. All of it is dissolved (${disShare.toFixed(0)}%), and the venous saturation setting has no effect because there is nothing to saturate. In this sketch the venous PO2 of 40 mmHg still leaves only ${f2(vDis)} mL per dL dissolved, so the difference is small and so is the oxygen use.`;
      } else {
        const unused = 100 - extr;
        s = `In this sketch the tissues take ${f2(diff)} of the ${f2(aTot)} mL per dL offered (${extrTxt}), so ${unused >= 10 ? Math.round(unused) : unused.toFixed(1)}% of the oxygen comes back unused, and at ${co.toFixed(1)} L per min the body uses ${thousands(use)} mL per min. Only ${disShare.toFixed(1)}% of the arterial content is dissolved.`;
        if (hb === 15 && sv === 75 && co === 5) {
          s += ' These are the lesson’s worked values: three-quarters of the oxygen comes back unused. That venous reserve sits on the steep part of the curve, so tissues can draw on it in exercise.';
        } else if (sv > 85 || sv < 60) {
          s += ' The lesson’s resting venous value is 75% at 40 mmHg; this setting only exercises the arithmetic, and is a saturation and PO2 pair that is not a point on the lesson’s curve, so it is not a claim about any person.';
        } else {
          s += ' The lesson’s resting values are hemoglobin 15 g per dL, venous saturation 75% and cardiac output 5.0 L per min.';
        }
      }
      why!.textContent = s;
    }
    [hbIn, svIn, coIn].forEach((s) => s.addEventListener('input', render));
    render();
  });
</script>

<style>
  .ofk { padding: var(--ddp-space-3) var(--ddp-space-4) var(--ddp-space-4); margin: var(--ddp-space-5) 0; }
  .ofk-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem; font-weight: 600; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); margin-bottom: var(--ddp-space-3); }
  .ofk-chip { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 400; color: var(--ddp-color-muted); }
  .ofk-svg { display: block; width: 100%; max-width: 560px; margin: 0 auto; height: auto; background: #fff; border: 1px solid var(--ddp-color-line); border-radius: 6px; }
  .ofk-controls { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--ddp-space-2) var(--ddp-space-4); margin: var(--ddp-space-3) 0 var(--ddp-space-2); }
  .ofk-slabel { display: flex; flex-direction: column; gap: 0.1rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .ofk-slabel em { font-style: normal; font-weight: 700; color: var(--ddp-color-accent); font-family: var(--ddp-font-mono); }
  .ofk-slabel input { accent-color: var(--ddp-color-accent); width: 100%; }
  .ofk-readout { display: grid; grid-template-columns: 1fr; gap: var(--ddp-space-2); margin: var(--ddp-space-2) 0; padding: var(--ddp-space-2) var(--ddp-space-3); background: color-mix(in srgb, var(--ddp-color-accent) 8%, transparent); border-radius: 6px; }
  .ofk-readout div { display: flex; flex-direction: column; gap: 0.1rem; }
  .ofk-readout dt { font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .ofk-readout dd { margin: 0; font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); color: var(--ddp-color-primary); font-weight: 700; overflow-wrap: anywhere; }
  .ofk-why { margin: 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); line-height: 1.5; min-height: 4.5em; }
  .ofk-assume { margin: var(--ddp-space-2) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); }
  .ofk-foot { margin: var(--ddp-space-3) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); border-left: 3px solid var(--ddp-color-secondary); padding-left: 0.55rem; }
  @media (max-width: 560px) { .ofk-controls { grid-template-columns: 1fr; } }
</style>
