---
/**
 * CholesterolFeedback — the regulation companion to the cholesterol-synthesis step map. The
 * PathwayExplorer walks acetyl-CoA to sterol; this island runs the feedback loop around the
 * committed enzyme, HMG-CoA reductase. Slide the cell's cholesterol and toggle a statin, FH or a PCSK9 antibody, and watch
 * the ER gauge (SCAP / SREBP-2), the enzyme, the LDL receptors, and blood LDL respond — including the
 * counterintuitive payoff: a statin lowers blood cholesterol mostly by making the cell put MORE
 * LDL receptors on its surface, not just by blocking synthesis. Vanilla-TS Astro island. Original.
 */
---

<figure class="chf card" data-cholfb>
  <figcaption class="chf-head">The cholesterol thermostat — SCAP, SREBP-2 and the statin<span class="chf-chip">⚙ original · interactive</span></figcaption>

  <label class="chf-slabel">
    <span class="chf-slabel-row">Cholesterol supply (LDL in blood + diet): <em data-out="chol">high</em></span>
    <input type="range" data-in="chol" min="0" max="100" step="5" value="70" aria-valuetext="high, above the set point" />
    <span class="chf-scale" aria-hidden="true"><span>low</span><span class="chf-scale-mid">set point</span><span>high</span></span>
  </label>

  <div class="chf-toggles">
    <label class="chf-toggle"><input type="checkbox" data-in="statin" /> Statin (blocks HMG-CoA reductase)</label>
    <label class="chf-toggle"><input type="checkbox" data-in="fh" /> No working LDL receptors (FH)</label>
    <label class="chf-toggle"><input type="checkbox" data-in="pcsk9" /> PCSK9 antibody</label>
  </div>

  <div class="chf-states">
    <div class="chf-state is-off" data-s-gauge><span class="chf-s-name">ER cholesterol (the gauge)</span><span class="chf-s-v" data-gauge>high</span></div>
    <div class="chf-state is-off" data-s-srebp><span class="chf-s-name">SCAP / SREBP-2 (reads the gauge)</span><span class="chf-s-v" data-srebp>SCAP held by Insig in ER</span></div>
    <div class="chf-state is-off" data-s-enz><span class="chf-s-name">HMG-CoA reductase (make)</span><span class="chf-s-v" data-enz>low (synthesis off)</span></div>
    <div class="chf-state is-off" data-s-ldlr><span class="chf-s-name">LDL receptors on surface (import)</span><span class="chf-s-v" data-ldlr>low</span></div>
    <div class="chf-state is-off" data-s-blood><span class="chf-s-name">Blood LDL</span><span class="chf-s-v" data-blood>rising ↑</span></div>
  </div>
  <p class="chf-why" data-why role="status">ER cholesterol is above the set point: SCAP is held by Insig in the ER, so SREBP-2 is never cut free, the reductase is shut down and degraded, and LDL receptors are sparse. With few receptors clearing it, blood LDL drifts up — the state a high-cholesterol diet pushes you toward. Tick the statin box to see what the drug changes.</p>

  <p class="chf-foot">One ER gauge (SCAP reading ER cholesterol) sets both supply lines: the reductase that makes cholesterol and the LDL receptor that imports it. HMG-CoA reductase is the committed, rate-limiting step, so the cell guards it four ways — SREBP-2-driven transcription, translational control, AMPK phosphorylation, and sterol-triggered degradation — and a statin adds a fifth, a competitive block. The clinical twist lives in the loop: when a statin starves the cell of cholesterol, the gauge reads low and the cell floods its surface with LDL receptors. Those receptors pull LDL out of the blood — which is how a synthesis inhibitor ends up lowering the number on your lab report. Tick the FH box and that second step disappears.</p>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('[data-cholfb]').forEach((root) => {
    const cholIn = root.querySelector<HTMLInputElement>('[data-in="chol"]')!;
    const cholOut = root.querySelector<HTMLElement>('[data-out="chol"]')!;
    const statinIn = root.querySelector<HTMLInputElement>('[data-in="statin"]')!;
    const fhIn = root.querySelector<HTMLInputElement>('[data-in="fh"]')!;
    const pcskIn = root.querySelector<HTMLInputElement>('[data-in="pcsk9"]')!;
    const gauge = root.querySelector<HTMLElement>('[data-gauge]')!;
    const srebp = root.querySelector<HTMLElement>('[data-srebp]')!;
    const enz = root.querySelector<HTMLElement>('[data-enz]')!;
    const ldlr = root.querySelector<HTMLElement>('[data-ldlr]')!;
    const blood = root.querySelector<HTMLElement>('[data-blood]')!;
    const sGauge = root.querySelector<HTMLElement>('[data-s-gauge]')!;
    const sSrebp = root.querySelector<HTMLElement>('[data-s-srebp]')!;
    const sEnz = root.querySelector<HTMLElement>('[data-s-enz]')!;
    const sLdlr = root.querySelector<HTMLElement>('[data-s-ldlr]')!;
    const sBlood = root.querySelector<HTMLElement>('[data-s-blood]')!;
    const why = root.querySelector<HTMLElement>('[data-why]')!;
    function set(elm: HTMLElement, good: boolean) { elm.classList.toggle('is-on', good); elm.classList.toggle('is-off', !good); }
    function render() {
      const chol = parseInt(cholIn.value, 10);
      const statin = statinIn.checked;
      const fh = fhIn.checked;
      const pcsk9 = pcskIn.checked;
      // what reaches the ER gauge: with no working receptors LDL can't get in, so the gauge reads low however high the supply
      let eff = chol;
      if (fh) eff = Math.min(eff, 35);
      // a statin blocks synthesis, so the gauge always drops below the set point (100 - 55 = 45 < 50)
      if (statin) eff = Math.max(0, eff - 55);
      // the set point is 50: the supply label and the gauge agree when receptors work and no drug is on
      const level = chol >= 50 ? (chol >= 70 ? 'high' : 'slightly high') : (chol < 30 ? 'low' : 'slightly low');
      cholOut.textContent = level;
      cholIn.setAttribute('aria-valuetext', `${level}, ${chol >= 50 ? 'above' : 'below'} the set point`);
      const srebpActive = eff < 50;
      gauge.textContent = srebpActive ? 'low' : 'high';
      srebp.textContent = srebpActive ? 'SCAP free → SREBP-2 cut, to nucleus' : 'SCAP held by Insig in ER';
      // enzyme: transcription up when SREBP-2 active; statin blocks catalysis regardless
      enz.textContent = statin
        ? (srebpActive ? 'more made, but BLOCKED by statin' : 'low, and blocked by statin')
        : fh
          ? 'high (synthesis keeps running)'
          : (srebpActive ? 'high (synthesis ON)' : 'low (synthesis off)');
      // PCSK9 antibody: fewer receptors destroyed, so more reach the surface (only if they work)
      const pcskHelps = pcsk9 && !fh;
      ldlr.textContent = fh
        ? 'ordered, but none work'
        : srebpActive
          ? (pcsk9 ? 'HIGHEST (PCSK9 blocked)' : 'HIGH')
          : (pcsk9 ? 'more survive (PCSK9 blocked)' : 'low');
      const clearing = !fh && (srebpActive || pcskHelps);
      blood.textContent = fh
        ? (statin ? 'high, barely falls' : 'high, cleared slowly')
        : (clearing ? 'falling ↓' : 'rising ↑');
      // sEnz lit only when the enzyme is actually producing sterol (SREBP-2 on AND not statin-blocked)
      set(sGauge, srebpActive);
      set(sEnz, srebpActive && !statin);
      set(sSrebp, srebpActive);
      set(sLdlr, !fh && (srebpActive || pcskHelps));
      set(sBlood, clearing);
      const pcskNote = pcsk9
        ? (fh
          ? ' Blocking PCSK9 cannot help here: there are no working receptors for it to spare.'
          : srebpActive
            ? ' SREBP-2 also raised PCSK9, which destroys some receptors; blocking it keeps more of them.'
            : '')
        : '';
      let text: string;
      if (fh) {
        text = statin
          ? 'The statin still blocks synthesis, but its main LDL-lowering step, more working receptors, is missing, so blood LDL barely falls.'
          : 'No LDL gets in, so ER cholesterol reads low however much LDL is in the blood: SREBP-2 stays on and synthesis keeps running, as in Brown and Goldstein’s skin cells. The gauge calls for receptors that cannot work, so blood LDL stays high.';
      } else if (statin) {
        text = 'Statin on: synthesis is blocked, so ER cholesterol falls even with supply coming in. SCAP escapes Insig, SREBP-2 is cut free, the cell carpets its surface with LDL receptors, and they vacuum LDL out of the blood — blood LDL falls. The receptor surge, not the blocked enzyme alone, is the real cholesterol-lowering mechanism.';
      } else if (srebpActive) {
        text = 'ER cholesterol is below the set point: SCAP escorts SREBP-2 to the Golgi, it is cut free, travels to the nucleus and switches on both HMG-CoA reductase (make more) and the LDL receptor (import more). The cell refills its cholesterol, and blood LDL drops as receptors clear it.';
      } else {
        text = pcsk9
          ? 'ER cholesterol is above the set point, so SCAP is held by Insig and the reductase stays low. But with PCSK9 blocked, fewer receptors are destroyed, more of them return to the surface, and blood LDL falls.'
          : 'ER cholesterol is above the set point: SCAP is held by Insig in the ER, so SREBP-2 is never cut free, the reductase is shut down and degraded, and LDL receptors are sparse. With few receptors clearing it, blood LDL drifts up — the state a high-cholesterol diet pushes you toward. Tick the statin box to see what the drug changes.';
      }
      why.textContent = text + pcskNote;
    }
    cholIn.addEventListener('input', render);
    statinIn.addEventListener('change', render);
    fhIn.addEventListener('change', render);
    pcskIn.addEventListener('change', render);
    render();
  });
</script>

<style>
  .chf { padding: var(--ddp-space-3) var(--ddp-space-4) var(--ddp-space-4); margin: var(--ddp-space-5) 0; }
  .chf-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem; font-weight: 600; font-size: var(--ddp-text-sm); color: var(--ddp-color-primary); margin-bottom: var(--ddp-space-2); }
  .chf-chip { font-family: var(--ddp-font-mono); font-size: var(--ddp-text-xs); font-weight: 400; color: var(--ddp-color-muted); }
  .chf-slabel-row { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.35rem; }
  .chf-scale { position: relative; display: flex; justify-content: space-between; font-size: 0.7rem; color: var(--ddp-color-muted); }
  .chf-scale-mid { position: absolute; left: 50%; transform: translateX(-50%); white-space: nowrap; }
  .chf-scale-mid::before { content: '▲ '; color: var(--ddp-color-accent); }
  .chf-slabel { display: flex; flex-direction: column; gap: 0.2rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); margin-bottom: var(--ddp-space-2); }
  .chf-slabel em { font-style: normal; font-weight: 700; color: var(--ddp-color-accent); font-family: var(--ddp-font-mono); }
  .chf-slabel input { accent-color: var(--ddp-color-accent); width: 100%; margin: 0.2rem 0 0; }
  .chf-toggles { display: flex; flex-wrap: wrap; gap: 0 var(--ddp-space-4); }
  .chf-toggle { display: flex; align-items: center; gap: 0.4rem; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); margin-bottom: var(--ddp-space-3); cursor: pointer; }
  .chf-toggle input { accent-color: var(--ddp-color-accent); }
  .chf-states { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--ddp-space-2); margin-bottom: var(--ddp-space-3); }
  @media (min-width: 620px) { .chf-states { grid-template-columns: repeat(5, 1fr); } }
  .chf-state { border: 1px solid var(--ddp-color-line); border-left: 3px solid var(--ddp-color-muted); border-radius: 6px; padding: var(--ddp-space-2) var(--ddp-space-3); display: flex; flex-direction: column; gap: 0.15rem; }
  .chf-state.is-on { border-left-color: var(--ddp-color-accent); background: color-mix(in srgb, var(--ddp-color-accent) 10%, #fff); }
  .chf-state.is-off { opacity: 0.62; }
  .chf-s-name { font-size: var(--ddp-text-xs); color: var(--ddp-color-muted); }
  .chf-s-v { font-size: var(--ddp-text-sm); font-weight: 700; color: var(--ddp-color-primary); }
  .chf-why { margin: 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); line-height: 1.5; min-height: 4em; padding: var(--ddp-space-2) var(--ddp-space-3); background: color-mix(in srgb, var(--ddp-color-accent) 8%, transparent); border-radius: 6px; }
  .chf-foot { margin: var(--ddp-space-3) 0 0; font-size: var(--ddp-text-xs); color: var(--ddp-color-ink-soft); border-left: 3px solid var(--ddp-color-secondary); padding-left: 0.55rem; }
</style>
