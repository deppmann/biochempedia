# build output
dist/
.output/

# dependencies
node_modules

# vendored Mol* viewer (regenerated from node_modules by `npm run sync:molstar`)
public/vendor/

# astro
.astro/

# env / secrets
.env
.env.*
!.env.example

# os / editor / local tooling
.DS_Store
*.log
.vscode/
.idea/
.claude/
# local secrets for `wrangler dev`
.dev.vars

# speech-to-text transcript cache written by the film pipeline
explainers/_pipeline/stt/

# Local wrangler dev state (local D1 database for teacher classes)
.wrangler/

# Listen: paragraph text lists written by the build, and Kokoro clips before upload to R2
.listen/
listen-audio/
# Local playback test copies of Listen clips; never commit them (the site serves them from R2)
public/listen/

# Python bytecode
__pycache__/
*.pyc

# Films are served from R2 (media-manifest.json records each one); the repository keeps their
# posters, captions, scripts and scenes. scripts/fetch-media.mjs downloads a film when a tool needs it.
public/explainers/**/*.mp4

# Side Hops audio is served from R2 too (media-manifest.json); scripts/side-hops/import-kit.mjs puts a copy here for upload.
public/side-hops/*.mp3

# Hop graph fills: digests, prompts and readers' answers before they are merged (scripts/topic-graph)
.graph-staging/
