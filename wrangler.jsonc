{
  // Cloudflare Workers config. The site is static (Astro output in dist/); the
  // worker script runs first ONLY for media paths, to answer HTTP range requests
  // (Safari will not play video without them). Everything else is served straight
  // from the static assets, as before this file existed.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "biochempedia",
  "compatibility_date": "2026-07-03",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/explainers/*", "/slides/*/audio/*", "/api/*", "/g/*"]
  },
  // Film files also live in this R2 bucket under the same paths they have on the site
  // (uploaded with `node scripts/upload-media.mjs`). The worker serves them from here and
  // falls back to the static assets, so a file may be in either place.
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "biochempedia-media" }],
  // Teacher classes (worker/api.js): teachers, classes, nickname-only students and their
  // lesson answers. Schema in migrations/; apply with
  // `npx wrangler d1 migrations apply biochempedia-classes --remote`.
  "d1_databases": [{ "binding": "CLASSES", "database_name": "biochempedia-classes", "database_id": "9f3ecb19-8241-4bb3-9c23-eccd8467ce98", "migrations_dir": "migrations" }],
  // Optional: set RESEND_API_KEY as a secret (`npx wrangler secret put RESEND_API_KEY`) to turn on
  // email verification and password-reset links. Without it, teachers use a recovery code.
  "vars": {
    "MAIL_FROM": "Biochemistrypedia <classes@biochemistrypedia.com>",
    // Curiosity router (worker/curious.js, POST /api/curious). OFF by default. To turn it on, set
    // the ANTHROPIC_API_KEY secret (`npx wrangler secret put ANTHROPIC_API_KEY`) and change
    // ROUTER_ENABLED to "1". To turn it off in one step, set ROUTER_ENABLED back to "0" and deploy
    // (or delete the secret). Setup and cost: docs/expansion/mission-2026-10/CURIOSITY_ROUTER.md.
    // ROUTER_MOCK is for local tests only (canned answers, no API call); never set it here.
    "ROUTER_ENABLED": "1",
    "ROUTER_DAILY_CAP_USD": "0.50",
    "ROUTER_MONTHLY_CAP_USD": "5",
    "ROUTER_IP_PER_MIN": "10",
    "ROUTER_IP_PER_DAY": "50",
    "ROUTER_GLOBAL_PER_MIN": "30",
    // "1" stores the text of questions (router_queries, 30 days). Off by default; keep it off for a
    // site children use. The box's "your question is not stored" line follows this switch.
    "ROUTER_LOG_QUERIES": "0"
  },
  "observability": { "enabled": true }
}
