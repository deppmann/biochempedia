{
  // Cloudflare Workers config. The site is static (Astro output in dist/); the
  // worker script runs first only for the paths in run_worker_first: media (HTTP range
  // requests, which Safari needs to play video, and files kept in R2), the API, and
  // group pages. Everything else is served straight from the static assets.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "biochempedia",
  "compatibility_date": "2026-07-03",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/explainers/*", "/api/*", "/g/*", "/listen/*"]
  },
  // Film files also live in this R2 bucket under the same paths they have on the site
  // (uploaded with `node scripts/upload-media.mjs`). The worker serves them from here and
  // falls back to the static assets, so a file may be in either place.
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "biochempedia-media" }],
  // Teacher classes (worker/api.js): teachers, classes, nickname-only students and their
  // lesson answers. Schema in migrations/; apply with
  // `npx wrangler d1 migrations apply biochempedia-classes --remote`.
  "d1_databases": [{ "binding": "CLASSES", "database_name": "biochempedia-classes", "database_id": "9f3ecb19-8241-4bb3-9c23-eccd8467ce98", "migrations_dir": "migrations" }],
  // Optional: set RESEND_API_KEY as a secret (`npx wrangler secret put RESEND_API_KEY`) to turn on
  // email verification and password-reset links. Without it, teachers use a recovery code.
  "vars": {
    "MAIL_FROM": "Biochemistrypedia <classes@biochemistrypedia.com>",
    // Curiosity router (worker/curious.js, POST /api/curious). Currently ON: it needs both
    // ROUTER_ENABLED "1" and the ANTHROPIC_API_KEY secret (`npx wrangler secret put ANTHROPIC_API_KEY`).
    // To turn it off in one step, set ROUTER_ENABLED to "0" and deploy (or delete the secret).
    // Setup and cost notes are in Chris's private working notes, not this repository.
    // ROUTER_MOCK is for local tests only (canned answers, no API call); never set it here.
    "ROUTER_ENABLED": "1",
    "ROUTER_DAILY_CAP_USD": "0.50",
    "ROUTER_MONTHLY_CAP_USD": "5",
    "ROUTER_IP_PER_MIN": "10",
    "ROUTER_IP_PER_DAY": "50",
    "ROUTER_GLOBAL_PER_MIN": "30",
    // "1" stores the text of questions (router_queries, 30 days). Off by default; keep it off for a
    // site children use. The box's "your question is not stored" line follows this switch.
    "ROUTER_LOG_QUERIES": "0",
    // Study helpers for learner accounts (worker/helper.js, /api/help/*): "explain this another way",
    // feedback on a claim-evidence-reasoning answer, and flashcards from highlights. Same
    // ANTHROPIC_API_KEY secret as the router, with separate caps. Needs HELPER_ENABLED "1" AND the
    // helper_budget table (migrations/0008_study_helpers.sql); until both, GET /api/help is a 503 and
    // no control shows. To turn them off in one step, set HELPER_ENABLED to "0" and deploy.
    // HELPER_MOCK is for local tests only (canned answers, no API call); never set it here.
    "HELPER_ENABLED": "0",
    "HELPER_DAILY_CAP_USD": "1.50",
    "HELPER_MONTHLY_CAP_USD": "15",
    "HELPER_EXPLAIN_PER_DAY": "20",
    "HELPER_FEEDBACK_PER_DAY": "10",
    "HELPER_CARDS_PER_DAY": "5",
    "HELPER_AGAIN_PER_LESSON": "3",
    "HELPER_IP_PER_MIN": "10",
    "HELPER_IP_PER_DAY": "80",
    "HELPER_GLOBAL_PER_MIN": "30",
    "HELPER_EFFORT": "low"
  },
  "observability": { "enabled": true }
}
